// C = max(A, 0), elementwise over an M×N matrix (K must equal N). Exercises a per-thread branch that writes a
// register in one arm only.
//
// Run: gpu/gen.sh gpu/examples/relu.rac

import Gpu

namespace Relu {
  open Gpu
  open Cuda

  def G : Group := Group.cta(256)
  def D : Group := Group.diverged(256)

  def kernel : Kernel :=
    Gpu.tiledKernel("relu16", DType.f32, 16, Eq.refl(Bool.true),
      fun (l: Lifetime)(e: Ctx(l, Relu.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, Relu.G) => {
        match Gpu.gload(e, k.a, k.row, k.col) returning Ctx(l, Relu.G) with
        | Pair.mk e x => {
          match Gpu.reg(e, x) returning Ctx(l, Relu.G) with
          | Pair.mk e out => {
            let negative := fun (m: Lifetime)(e: Ctx(m, Relu.D))(s: Unit): Pair(Ctx(m, Relu.D), Unit) =>
              Pair.mk(Gpu.set(e, out, Gpu.zero(DType.f32)), s)
            let otherwise := fun (m: Lifetime)(e: Ctx(m, Relu.D))(s: Unit): Pair(Ctx(m, Relu.D), Unit) => Pair.mk(e, s)
            match Gpu.branch(e, Gpu.lt(x, Gpu.zero(DType.f32)), Unit.unit, negative, otherwise) returning Ctx(l, Relu.G) with
            | Pair.mk e s => {
              match Gpu.get(e, out) returning Ctx(l, Relu.G) with
              | Pair.mk e v => Gpu.gstore(e, k.c, c, v)
            }
          }
        }
      })
}

{ Cuda.kernel(Relu.kernel) }
