// Persistent GEMM on sm_100a: C (f32) = A · Bᵀ as in tinygemm.rac, but each CTA (one per SM) loops over the 128×128
// tiles of C the schedule gives it, and tensor memory holds two accumulators, so storing one tile overlaps the MMAs of
// the next.
//
// Warp 0 elects a thread that streams the K slices of every tile into a six-stage ring with TMA. Warp 1 elects a thread
// that, per tile, takes a free accumulator, issues the tile's MMAs into it (releasing each stage by tcgen05.commit) and
// commits it. Warps 2 and 3 idle. Warps 4 to 7, an aligned warpgroup, wait for each accumulator, store its tile and
// hand the buffer back.
//
// Run: gpu/gen.sh gpu/examples/persistent_gemm.rac

import Gpu

namespace PGemm {
  open Gpu
  open Cuda

  def boxA : TmaSpec := TmaSpec.mk(64, 128)
  def boxB : TmaSpec := TmaSpec.mk(64, 128)
  def ring : RingCfg := RingCfg.mk(6, PGemm.boxA, PGemm.boxB)

  def Cta : Group := Group.cta(256)
  def Wg0 : Group := Group.warps(0, 4)
  def Wg1 : Group := Group.warps(4, 4)
  def Load : Group := Group.warps(0, 1)
  def Rest : Group := Group.warps(1, 3)
  def Issue : Group := Group.warps(1, 1)
  def Idle : Group := Group.warps(2, 2)
  def One : Group := Group.lane

  def Gemm (l: Lifetime) : Type { scope = l } := TmaGemm(l, PGemm.boxA, PGemm.boxB)

  // What the issuer's role hands back: its side of the stage ring and of the accumulator ring, finished.
  def IssuerDone (r: Lifetime)(q: Lifetime) : Type { kind = lin, scope = union(r, q) } := Pair(ConsumerDone(r), AccProducerDone(q))

  // The producer: for every tile, fill one stage per K slice; then wait for every stage to be released.
  def producer {l: Lifetime}{L: Lifetime}{r: Lifetime}(g: PGemm.Gemm(l))(sched: Sched(L, 128))(ring: Ring(r, PGemm.ring))
      (steps: Val(l, Grain.uniform, DType.u32))(p: Producer(r))(m: Lifetime)(e: Ctx(m, PGemm.Load))
      : Pair(Ctx(m, PGemm.Load), ProducerDone(r)) :=
    Gpu.elect(e, ProducerDone(r), fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, PGemm.One)): Pair(Ctx(j, PGemm.One), ProducerDone(r)) => {
      let tile := fun (n: Lifetime)(t: TileAt(n, 128))(e: Ctx(n, PGemm.One))(p: ProducerAt(r, j)): Pair(Ctx(n, PGemm.One), ProducerAt(r, j)) => {
        let step := fun (s: Lifetime)(i: Val(s, Grain.uniform, DType.u32))(e: Ctx(s, PGemm.One))(p: ProducerAt(r, j))
            : Pair(Ctx(s, PGemm.One), ProducerAt(r, j)) => {
          let (e, slot) := Gpu.acquire(e, ring, p)
          Gpu.fill(e, ring, slot, g.a, Gpu.mulC(i, 64), Gpu.tileRow0(t), g.b, Gpu.mulC(i, 64), Gpu.tileCol0(t))
        }
        Gpu.loopPeeled(e, steps, Gpu.fixedProducerAt(r, j), p, step, step)
      }
      let (e, p) := Gpu.takeProducer(e, w, ring, p)
      let (e, p) := Gpu.forTiles(e, sched, Gpu.fixedProducerAt(r, j), p, tile)
      Gpu.finishProducer(e, ring, p)
    })

  // The MMA issuer: for every tile, take a free accumulator, accumulate every stage into it, releasing each stage when
  // its MMAs complete, and commit it to the epilogue; then wait until the epilogue has read every accumulator.
  def issuer {l: Lifetime}{L: Lifetime}{r: Lifetime}{q: Lifetime}(sched: Sched(L, 128))(ring: Ring(r, PGemm.ring))(accs: AccRing(q, 128))
      (steps: Val(l, Grain.uniform, DType.u32))(c: Consumer(r))(ap: AccProducer(q))(m: Lifetime)(e: Ctx(m, PGemm.Issue))
      : Pair(Ctx(m, PGemm.Issue), PGemm.IssuerDone(r, q)) :=
    Gpu.elect(e, PGemm.IssuerDone(r, q), fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, PGemm.One)): Pair(Ctx(j, PGemm.One), PGemm.IssuerDone(r, q)) => {
      let first := fun (s: Lifetime)(i: Val(s, Grain.uniform, DType.u32))(e: Ctx(s, PGemm.One))(st: Pair(ConsumerAt(r, j), AccFree(q, j)))
          : Pair(Ctx(s, PGemm.One), Pair(ConsumerAt(r, j), AccFilling(q, j))) => {
        let (c, acc) := st
        let (e, rd) := Gpu.await(e, ring, c)
        let (e, (used, acc)) := Gpu.mmaFirstInto(e, w, ring, rd, accs, acc)
        let (e, c) := Gpu.releaseByMma(e, w, ring, used)
        (e, (c, acc))
      }
      let rest := fun (s: Lifetime)(i: Val(s, Grain.uniform, DType.u32))(e: Ctx(s, PGemm.One))(st: Pair(ConsumerAt(r, j), AccFilling(q, j)))
          : Pair(Ctx(s, PGemm.One), Pair(ConsumerAt(r, j), AccFilling(q, j))) => {
        let (c, acc) := st
        let (e, rd) := Gpu.await(e, ring, c)
        let (e, (used, acc)) := Gpu.mmaNextInto(e, w, ring, rd, accs, acc)
        let (e, c) := Gpu.releaseByMma(e, w, ring, used)
        (e, (c, acc))
      }
      let tile := fun (n: Lifetime)(t: TileAt(n, 128))(e: Ctx(n, PGemm.One))(st: Pair(ConsumerAt(r, j), AccProducerAt(q, j)))
          : Pair(Ctx(n, PGemm.One), Pair(ConsumerAt(r, j), AccProducerAt(q, j))) => {
        let (c, ap) := st
        let (e, acc) := Gpu.acquireAcc(e, accs, ap)
        let (e, (c, acc)) := Gpu.loopPeeled(e, steps,
          Gpu.fixedPair(Gpu.fixedConsumerAt(r, j), Gpu.fixedAccFilling(q, j)), (c, acc), first, rest)
        let (e, ap) := Gpu.commitAcc(e, w, accs, acc)
        (e, (c, ap))
      }
      let (e, c) := Gpu.takeConsumer(e, w, ring, c)
      let (e, ap) := Gpu.takeAccProducer(e, w, accs, ap)
      let (e, (c, ap)) := Gpu.forTiles(e, sched,
        Gpu.fixedPair(Gpu.fixedConsumerAt(r, j), Gpu.fixedAccProducerAt(q, j)), (c, ap), tile)
      let (e, apDone) := Gpu.finishAccProducer(e, accs, ap)
      (e, (Gpu.finishConsumer(c), apDone))
    })

  // The epilogue: for every tile, wait for its accumulator, store the tile, and hand the buffer back.
  def epilogue {l: Lifetime}{L: Lifetime}{q: Lifetime}(g: PGemm.Gemm(l))(sched: Sched(L, 128))(own: SchedOwn(L, 128))
      (accs: AccRing(q, 128))(ac: AccConsumer(q))(m: Lifetime)(e: Ctx(m, PGemm.Wg1)): Pair(Ctx(m, PGemm.Wg1), AccConsumerDone(q)) := {
    let tile := fun (n: Lifetime)(t: TileAt(n, 128))(o: TileOwn(n, 128))(e: Ctx(n, PGemm.Wg1))(c: AccConsumerAt(q, m, 4))
        : Pair(Ctx(n, PGemm.Wg1), AccConsumerAt(q, m, 4)) => {
      let (e, full) := Gpu.awaitAcc(e, accs, c)
      let (e, full) := Gpu.storeTile(e, accs, full, t, o, g.c)
      Gpu.releaseAcc(e, accs, full)
    }
    let (e, c) := Gpu.takeAccConsumer(e, accs, ac)
    let (e, c) := Gpu.forOwnedTiles(e, sched, own, Gpu.fixedAccConsumerAt(q, m, 4), c, tile)
    (e, Gpu.finishAccConsumer(c))
  }

  def roles {l: Lifetime}{r: Lifetime}{q: Lifetime}(g: PGemm.Gemm(l))(sched: Sched(l, 128))(own: SchedOwn(l, 128))
      (ring: Ring(r, PGemm.ring))(accs: AccRing(q, 128))(steps: Val(l, Grain.uniform, DType.u32))(p: Producer(r))(c: Consumer(r))
      (ap: AccProducer(q))(ac: AccConsumer(q))(e: Ctx(l, PGemm.Cta))
      : Pair(Ctx(l, PGemm.Cta), Pair(Pair(ProducerDone(r), ConsumerDone(r)), Pair(AccProducerDone(q), AccConsumerDone(q)))) := {
    let idle := fun (m: Lifetime)(e: Ctx(m, PGemm.Idle)): Pair(Ctx(m, PGemm.Idle), Unit) => (e, Unit.unit)
    let rest := fun (m: Lifetime)(e: Ctx(m, PGemm.Rest)): Pair(Ctx(m, PGemm.Rest), Pair(PGemm.IssuerDone(r, q), Unit)) =>
      Gpu.split(e, 1, PGemm.IssuerDone(r, q), Unit, fun (n: Lifetime)(e: Ctx(n, PGemm.Issue)): Pair(Ctx(n, PGemm.Issue), PGemm.IssuerDone(r, q)) =>
        PGemm.issuer(sched, ring, accs, steps, c, ap, n, e), idle)
    let wg0 := fun (m: Lifetime)(e: Ctx(m, PGemm.Wg0)): Pair(Ctx(m, PGemm.Wg0), Pair(ProducerDone(r), Pair(PGemm.IssuerDone(r, q), Unit))) =>
      Gpu.split(e, 1, ProducerDone(r), Pair(PGemm.IssuerDone(r, q), Unit),
        fun (n: Lifetime)(e: Ctx(n, PGemm.Load)): Pair(Ctx(n, PGemm.Load), ProducerDone(r)) => PGemm.producer(g, sched, ring, steps, p, n, e), rest)
    let wg1 := fun (m: Lifetime)(e: Ctx(m, PGemm.Wg1)): Pair(Ctx(m, PGemm.Wg1), AccConsumerDone(q)) => PGemm.epilogue(g, sched, own, accs, ac, m, e)
    let (e, ((pd, ((cd, apd), u)), acd)) :=
      Gpu.split(e, 4, Pair(ProducerDone(r), Pair(PGemm.IssuerDone(r, q), Unit)), AccConsumerDone(q), wg0, wg1)
    (e, ((pd, cd), (apd, acd)))
  }

  def kernel : Program :=
    Gpu.tmaGemmPersistentKernel("persistent_gemm", PGemm.boxA, PGemm.boxB,
      fun (l: Lifetime)(e: Ctx(l, PGemm.Cta))(g: PGemm.Gemm(l))(sched: Sched(l, 128))(own: SchedOwn(l, 128))(permit: TmemPermit(l))
          : Ctx(l, PGemm.Cta) => {
        let steps := Gpu.ceilDivC(g.k, 64)
        let body := fun (a: Lifetime)(t: Tmem(a, 256))(acc: Acc(a, AccState.empty))(e: Ctx(l, PGemm.Cta))
            : Pair(Ctx(l, PGemm.Cta), Pair(Acc(a, AccState.empty), Unit)) => {
          let accRing := fun (q: Lifetime)(accs: AccRing(q, 128))(ap: AccProducer(q))(ac: AccConsumer(q))(e: Ctx(l, PGemm.Cta))
              : Pair(Ctx(l, PGemm.Cta), Pair(Pair(AccProducerDone(q), AccConsumerDone(q)), Unit)) => {
            let stages := fun (r: Lifetime)(ring: Ring(r, PGemm.ring))(p: Producer(r))(c: Consumer(r))(e: Ctx(l, PGemm.Cta))
                : Pair(Ctx(l, PGemm.Cta), Pair(Pair(ProducerDone(r), ConsumerDone(r)), Pair(AccProducerDone(q), AccConsumerDone(q)))) =>
              PGemm.roles(g, sched, own, ring, accs, steps, p, c, ap, ac, e)
            let (e, accsDone) := Gpu.withRing(e, PGemm.ring, Pair(AccProducerDone(q), AccConsumerDone(q)), stages)
            (e, (accsDone, Unit.unit))
          }
          Gpu.withAccRing(e, t, acc, 2, 128, Unit, accRing)
        }
        let (e, u) := Gpu.withTmem(e, permit, 256, AccState.empty, Unit, body)
        e
      })
}

{ Gpu.render(PGemm.kernel) }
