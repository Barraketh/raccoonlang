// SIMT tiled SGEMM: C = A·B, one 16×16 block of C per CTA of 256 threads. Each K step stages a 16×16 tile of A and
// one of B in shared memory, then every thread accumulates its dot product from them.
//
// Run: gpu/gen.sh gpu/examples/gemm.rac

import Gpu

namespace Gemm {
  open Gpu
  open Cuda

  // The whole CTA, converged.
  def G : Group := Group.cta(256)

  // Authority over the two shared tiles.
  def Tiles (a: Lifetime)(b: Lifetime)(s: TileState) : Type { kind = lin, scope = union(a, b) } :=
    Pair(Tile(a, DType.f32, 256, s), Tile(b, DType.f32, 256, s))

  // What one K step returns: its emitter, and both tiles empty again.
  def Step (m: Lifetime)(a: Lifetime)(b: Lifetime) : Type { kind = lin, scope = union(m, union(a, b)) } :=
    Pair(Ctx(m, Gemm.G), Gemm.Tiles(a, b, TileState.empty))

  def Out (l: Lifetime) : Type { kind = lin, scope = l } := Pair(Ctx(l, Gemm.G), Val(l, Grain.thread, DType.f32))

  // sum + Σ As[ty][j] · Bs[j][tx] for the next `count` values of j, unrolled.
  def dot {l: Lifetime}{a: Lifetime}{b: Lifetime}{r: Lifetime}{q: Lifetime}{L: Lifetime}
      (count: Nat)(j: Nat)(e: Ctx(l, Gemm.G))(sa: Smem(a, DType.f32, 256))(ra: SRead(a, r, DType.f32, 256))
      (sb: Smem(b, DType.f32, 256))(rb: SRead(b, q, DType.f32, 256))(tx: Val(L, Grain.thread, DType.u32))
      (ty: Val(L, Grain.thread, DType.u32))(sum: Val(l, Grain.thread, DType.f32)): Gemm.Out(l) decreases structural(count) := {
    match count returning Gemm.Out(l) with
    | Nat.zero => (e, sum)
    | Nat.succ c => {
      let (e, x) := Gpu.sread(e, sa, ra, Gpu.add(Gpu.mulC(ty, 16), Gpu.lit(j)))
      let (e, y) := Gpu.sread(e, sb, rb, Gpu.add(Gpu.mulC(Gpu.lit(j), 16), tx))
      Gemm.dot(c, Nat.succ(j), e, sa, ra, sb, rb, tx, ty, Gpu.fma(x, y, sum))
    }
  }

  // One K step: stage both tiles, wait, accumulate, and wait again before the next step overwrites them.
  def step {a: Lifetime}{b: Lifetime}{L: Lifetime}(k: Launch(L, DType.f32, 16))(sa: Smem(a, DType.f32, 256))
      (sb: Smem(b, DType.f32, 256))(acc: Reg(L, DType.f32))
      (m: Lifetime)(kt: Val(m, Grain.uniform, DType.u32))(e: Ctx(m, Gemm.G))(st: Gemm.Tiles(a, b, TileState.empty))
      : Gemm.Step(m, a, b) := {
    let (ta, tb) := st
    let (e, x) := Gpu.gload(e, k.a, k.row, Gpu.add(Gpu.mulC(kt, 16), k.tx))
    let (e, ta) := Gpu.storeMine(e, sa, ta, x)
    let (e, y) := Gpu.gload(e, k.b, Gpu.add(Gpu.mulC(kt, 16), k.ty), k.col)
    let (e, tb) := Gpu.storeMine(e, sb, tb, y)
    let (e, (ta, tb)) := Gpu.sync2(e, ta, tb)
    let accumulate := fun (r: Lifetime)(ra: SRead(a, r, DType.f32, 256))(e: Ctx(m, Gemm.G))
        : Pair(Ctx(m, Gemm.G), Tile(b, DType.f32, 256, TileState.reading)) => {
      let inner := fun (q: Lifetime)(rb: SRead(b, q, DType.f32, 256))(e: Ctx(m, Gemm.G)): Pair(Ctx(m, Gemm.G), Unit) => {
        let (e, sum0) := Gpu.get(e, acc)
        let (e, sum) := Gemm.dot(16, 0, e, sa, ra, sb, rb, k.tx, k.ty, sum0)
        (Gpu.set(e, acc, sum), Unit.unit)
      }
      let (e, (tb, done)) := Gpu.reads(e, tb, inner)
      (e, tb)
    }
    let (e, (ta, tb)) := Gpu.reads(e, ta, accumulate)
    Gpu.sync2(e, ta, tb)
  }

  def kernel : Program :=
    Gpu.tiledKernel("sgemm16", DType.f32, 16,
      fun (l: Lifetime)(e: Ctx(l, Gemm.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, Gemm.G) =>
        Gpu.shared(e, DType.f32, 256,
          fun (a: Lifetime)(sa: Smem(a, DType.f32, 256))(ta: Tile(a, DType.f32, 256, TileState.empty))(e: Ctx(l, Gemm.G)): Ctx(l, Gemm.G) =>
            Gpu.shared(e, DType.f32, 256,
              fun (b: Lifetime)(sb: Smem(b, DType.f32, 256))(tb: Tile(b, DType.f32, 256, TileState.empty))(e: Ctx(l, Gemm.G)): Ctx(l, Gemm.G) => {
                let (e, acc) := Gpu.reg(e, Gpu.zero(DType.f32))
                let steps := Gpu.ceilDivC(k.k, 16)
                let body := fun (m: Lifetime)(kt: Val(m, Grain.uniform, DType.u32))(e: Ctx(m, Gemm.G))(st: Gemm.Tiles(a, b, TileState.empty))
                    : Gemm.Step(m, a, b) => Gemm.step(k, sa, sb, acc, m, kt, e, st)
                let (e, (ta, tb)) := Gpu.loop(e, steps, Gpu.fixedPair(Gpu.fixedTile(a, DType.f32, 256, TileState.empty),
                  Gpu.fixedTile(b, DType.f32, 256, TileState.empty)), (ta, tb), body)
                let _ := Gpu.release(ta)
                let _ := Gpu.release(tb)
                let (e, v) := Gpu.get(e, acc)
                Gpu.gstore(e, k.c, c, v)
              })))
}

{ Gpu.render(Gemm.kernel) }
