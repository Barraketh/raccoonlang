// Lemmas about the checkers' traversals: a walk that collects messages and finds none visited every expression or
// statement with nothing to report. Each checker's soundness proof (the other files here) instantiates them with its
// own step.

import Check
import Spec

namespace Fold {
  open Cuda

  // No messages.
  def Empty (found: List(String)): Prop := Eq(List(String), found, List.nil(String))

  // A step that never takes a message away: when its result is empty, so was the list it was given.
  def Keeps (A: Type)(f: List(String) -> A -> List(String)): Prop :=
    (found: List(String)) -> (x: A) -> Fold.Empty(f(found, x)) -> Fold.Empty(found)

  def consNotEmpty (m: String)(found: List(String))(h: Fold.Empty(List.cons(m, found))): False := {
    match h returning False with
  }

  // ---- Messages -----------------------------------------------------------------------------------------------------

  def revOntoAcc (found: List(String))(acc: List(String))(h: Fold.Empty(Check.revOnto(found, acc))): Fold.Empty(acc) decreases structural(found) := {
    match found returning Fold.Empty(acc) with
    | List.nil => h
    | List.cons m more => False.elim(Fold.consNotEmpty(m, acc, Fold.revOntoAcc(more, List.cons(m, acc), h)), Fold.Empty(acc))
  }

  // Reporting in program order loses no message.
  def inOrder (found: List(String))(h: Fold.Empty(Check.inOrder(found))): Fold.Empty(found) := {
    match found returning Fold.Empty(found) with
    | List.nil => Eq.refl(List.nil(String))
    | List.cons m more => False.elim(Fold.consNotEmpty(m, List.nil(String), Fold.revOntoAcc(more, List.cons(m, List.nil(String)), h)),
      Fold.Empty(List.cons(m, more)))
  }

  // `unless` adds a message exactly when its condition fails.
  def unlessOk (found: List(String))(ok: Bool)(message: Unit -> String)(h: Fold.Empty(Check.unless(found, ok, message)))
      : Eq(Bool, ok, Bool.true) := {
    match ok returning Eq(Bool, ok, Bool.true) with
    | Bool.true => Eq.refl(Bool.true)
    | Bool.false => False.elim(Fold.consNotEmpty(message(Unit.unit), found, h), Eq(Bool, Bool.false, Bool.true))
  }

  def unlessFound (found: List(String))(ok: Bool)(message: Unit -> String)(h: Fold.Empty(Check.unless(found, ok, message)))
      : Fold.Empty(found) := {
    match ok returning Fold.Empty(found) with
    | Bool.true => h
    | Bool.false => False.elim(Fold.consNotEmpty(message(Unit.unit), found, h), Fold.Empty(found))
  }

  // ---- Lists --------------------------------------------------------------------------------------------------------

  def memAppendLeft (A: Type)(x: A)(xs: List(A))(ys: List(A))(h: Spec.Mem(A, x, xs)): Spec.Mem(A, x, List.append(xs, ys)) decreases structural(xs) := {
    match h returning Spec.Mem(A, x, List.append(xs, ys)) with
    | Spec.Mem.here rest => Spec.Mem.here(x, List.append(rest, ys))
    | Spec.Mem.there y rest m => Spec.Mem.there(y, List.append(rest, ys), Fold.memAppendLeft(A, x, rest, ys, m))
  }

  def memAppendRight (A: Type)(x: A)(xs: List(A))(ys: List(A))(h: Spec.Mem(A, x, ys)): Spec.Mem(A, x, List.append(xs, ys)) decreases structural(xs) := {
    match xs returning Spec.Mem(A, x, List.append(xs, ys)) with
    | List.nil => h
    | List.cons y rest => Spec.Mem.there(y, List.append(rest, ys), Fold.memAppendRight(A, x, rest, ys, h))
  }

  def foldlAcc (A: Type)(xs: List(A))(acc: List(String))(f: List(String) -> A -> List(String))(keeps: Fold.Keeps(A, f))
      (h: Fold.Empty(List.foldl(xs, List(String), acc, f))): Fold.Empty(acc) decreases structural(xs) := {
    match xs returning Fold.Empty(acc) with
    | List.nil => h
    | List.cons x more => keeps(acc, x, Fold.foldlAcc(A, more, f(acc, x), f, keeps, h))
  }

  // A fold that found nothing found nothing at each element.
  def foldlAt (A: Type)(y: A)(xs: List(A))(mem: Spec.Mem(A, y, xs))(acc: List(String))(f: List(String) -> A -> List(String))
      (keeps: Fold.Keeps(A, f))(h: Fold.Empty(List.foldl(xs, List(String), acc, f))): Fold.Empty(f(List.nil(String), y)) decreases structural(xs) := {
    match mem returning Fold.Empty(f(List.nil(String), y)) with
    | Spec.Mem.here rest => {
      let here := Fold.foldlAcc(A, rest, f(acc, y), f, keeps, h)
      match keeps(acc, y, here) returning Fold.Empty(f(List.nil(String), y)) with
      | Eq.refl z => here
    }
    | Spec.Mem.there x rest m => Fold.foldlAt(A, y, rest, m, f(acc, x), f, keeps, h)
  }

  // ---- Expressions --------------------------------------------------------------------------------------------------

  // An expression fold that found nothing found nothing at its root.
  def exprFoldHere (x: Expr)(acc: List(String))(f: List(String) -> Expr -> List(String))(keeps: Fold.Keeps(Expr, f))
      (h: Fold.Empty(Check.exprFold(List(String), x, acc, f))): Fold.Empty(f(acc, x)) decreases structural(x) := {
    let here := f(acc, x)
    match x returning Fold.Empty(f(acc, x)) with
    | Expr.var id => h
    | Expr.lit value => h
    | Expr.lit64 value => h
    | Expr.zero t => h
    | Expr.param n => h
    | Expr.special b => h
    | Expr.bin op a b => {
      let afterA := keeps(Check.exprFold(List(String), a, here, f), b, Fold.exprFoldHere(b, Check.exprFold(List(String), a, here, f), f, keeps, h))
      keeps(here, a, Fold.exprFoldHere(a, here, f, keeps, afterA))
    }
    | Expr.max a b => {
      let afterA := keeps(Check.exprFold(List(String), a, here, f), b, Fold.exprFoldHere(b, Check.exprFold(List(String), a, here, f), f, keeps, h))
      keeps(here, a, Fold.exprFoldHere(a, here, f, keeps, afterA))
    }
    | Expr.fma a b c => {
      let afterA := Check.exprFold(List(String), a, here, f)
      let afterB := keeps(Check.exprFold(List(String), b, afterA, f), c, Fold.exprFoldHere(c, Check.exprFold(List(String), b, afterA, f), f, keeps, h))
      let beforeB := keeps(afterA, b, Fold.exprFoldHere(b, afterA, f, keeps, afterB))
      keeps(here, a, Fold.exprFoldHere(a, here, f, keeps, beforeB))
    }
    | Expr.select c t e => {
      let afterC := Check.exprFold(List(String), c, here, f)
      let afterT := keeps(Check.exprFold(List(String), t, afterC, f), e, Fold.exprFoldHere(e, Check.exprFold(List(String), t, afterC, f), f, keeps, h))
      let beforeT := keeps(afterC, t, Fold.exprFoldHere(t, afterC, f, keeps, afterT))
      keeps(here, c, Fold.exprFoldHere(c, here, f, keeps, beforeT))
    }
    | Expr.index base i => {
      let afterBase := keeps(Check.exprFold(List(String), base, here, f), i, Fold.exprFoldHere(i, Check.exprFold(List(String), base, here, f), f, keeps, h))
      keeps(here, base, Fold.exprFoldHere(base, here, f, keeps, afterBase))
    }
    | Expr.cast t a => keeps(here, a, Fold.exprFoldHere(a, here, f, keeps, h))
    | Expr.sharedAddr offset => h
    | Expr.sharedPtr t offset => h
    | Expr.paramAddr n => h
  }

  def exprFoldAcc (x: Expr)(acc: List(String))(f: List(String) -> Expr -> List(String))(keeps: Fold.Keeps(Expr, f))
      (h: Fold.Empty(Check.exprFold(List(String), x, acc, f))): Fold.Empty(acc) :=
    keeps(acc, x, Fold.exprFoldHere(x, acc, f, keeps, h))

  // An expression fold that found nothing found nothing at each subexpression.
  def exprFoldAt (y: Expr)(x: Expr)(sub: Spec.SubExpr(y, x))(acc: List(String))(f: List(String) -> Expr -> List(String))
      (keeps: Fold.Keeps(Expr, f))(h: Fold.Empty(Check.exprFold(List(String), x, acc, f))): Fold.Empty(f(List.nil(String), y)) decreases structural(x) := {
    let here := f(acc, x)
    match sub returning Fold.Empty(f(List.nil(String), y)) with
    | Spec.SubExpr.here => {
      let atRoot := Fold.exprFoldHere(y, acc, f, keeps, h)
      match keeps(acc, y, atRoot) returning Fold.Empty(f(List.nil(String), y)) with
      | Eq.refl z => atRoot
    }
    | Spec.SubExpr.binA op a b s => Fold.exprFoldAt(y, a, s, here, f, keeps, Fold.exprFoldAcc(b, Check.exprFold(List(String), a, here, f), f, keeps, h))
    | Spec.SubExpr.binB op a b s => Fold.exprFoldAt(y, b, s, Check.exprFold(List(String), a, here, f), f, keeps, h)
    | Spec.SubExpr.maxA a b s => Fold.exprFoldAt(y, a, s, here, f, keeps, Fold.exprFoldAcc(b, Check.exprFold(List(String), a, here, f), f, keeps, h))
    | Spec.SubExpr.maxB a b s => Fold.exprFoldAt(y, b, s, Check.exprFold(List(String), a, here, f), f, keeps, h)
    | Spec.SubExpr.fmaA a b c s => {
      let afterA := Check.exprFold(List(String), a, here, f)
      let beforeC := Fold.exprFoldAcc(c, Check.exprFold(List(String), b, afterA, f), f, keeps, h)
      Fold.exprFoldAt(y, a, s, here, f, keeps, Fold.exprFoldAcc(b, afterA, f, keeps, beforeC))
    }
    | Spec.SubExpr.fmaB a b c s => {
      let afterA := Check.exprFold(List(String), a, here, f)
      Fold.exprFoldAt(y, b, s, afterA, f, keeps, Fold.exprFoldAcc(c, Check.exprFold(List(String), b, afterA, f), f, keeps, h))
    }
    | Spec.SubExpr.fmaC a b c s => Fold.exprFoldAt(y, c, s, Check.exprFold(List(String), b, Check.exprFold(List(String), a, here, f), f), f, keeps, h)
    | Spec.SubExpr.selectC c t e s => {
      let afterC := Check.exprFold(List(String), c, here, f)
      let beforeE := Fold.exprFoldAcc(e, Check.exprFold(List(String), t, afterC, f), f, keeps, h)
      Fold.exprFoldAt(y, c, s, here, f, keeps, Fold.exprFoldAcc(t, afterC, f, keeps, beforeE))
    }
    | Spec.SubExpr.selectT c t e s => {
      let afterC := Check.exprFold(List(String), c, here, f)
      Fold.exprFoldAt(y, t, s, afterC, f, keeps, Fold.exprFoldAcc(e, Check.exprFold(List(String), t, afterC, f), f, keeps, h))
    }
    | Spec.SubExpr.selectF c t e s => Fold.exprFoldAt(y, e, s, Check.exprFold(List(String), t, Check.exprFold(List(String), c, here, f), f), f, keeps, h)
    | Spec.SubExpr.indexBase base i s =>
      Fold.exprFoldAt(y, base, s, here, f, keeps, Fold.exprFoldAcc(i, Check.exprFold(List(String), base, here, f), f, keeps, h))
    | Spec.SubExpr.indexI base i s => Fold.exprFoldAt(y, i, s, Check.exprFold(List(String), base, here, f), f, keeps, h)
    | Spec.SubExpr.cast t a s => Fold.exprFoldAt(y, a, s, here, f, keeps, h)
  }

  // ---- Statements ---------------------------------------------------------------------------------------------------

  // `stmtExprs`'s step over an asm operand list.
  def operandStep (f: List(String) -> Expr -> List(String)): List(String) -> Operand -> List(String) :=
    fun (b: List(String))(o: Operand): List(String) => Check.exprFold(List(String), o.e, b, f)

  def operandKeeps (f: List(String) -> Expr -> List(String))(keeps: Fold.Keeps(Expr, f)): Fold.Keeps(Operand, Fold.operandStep(f)) :=
    fun (b: List(String))(o: Operand)(h: Fold.Empty(Check.exprFold(List(String), o.e, b, f))): Fold.Empty(b) => Fold.exprFoldAcc(o.e, b, f, keeps, h)

  def stmtExprsAcc (s: Stmt)(acc: List(String))(f: List(String) -> Expr -> List(String))(keeps: Fold.Keeps(Expr, f))
      (h: Fold.Empty(Check.stmtExprs(List(String), s, acc, f))): Fold.Empty(acc) := {
    let each := fun (a: List(String))(x: Expr): List(String) => Check.exprFold(List(String), x, a, f)
    match s returning Fold.Empty(acc) with
    | Stmt.decl t id init => Fold.exprFoldAcc(init, acc, f, keeps, h)
    | Stmt.declMut t id init => Fold.exprFoldAcc(init, acc, f, keeps, h)
    | Stmt.declOut t id => h
    | Stmt.assign id value => Fold.exprFoldAcc(value, acc, f, keeps, h)
    | Stmt.store base i value => {
      let beforeValue := Fold.exprFoldAcc(value, each(each(acc, base), i), f, keeps, h)
      Fold.exprFoldAcc(base, acc, f, keeps, Fold.exprFoldAcc(i, each(acc, base), f, keeps, beforeValue))
    }
    | Stmt.shared t id size => h
    | Stmt.forLoop id start count body => Fold.exprFoldAcc(start, acc, f, keeps, Fold.exprFoldAcc(count, each(acc, start), f, keeps, h))
    | Stmt.forStride id start stop step body => {
      let beforeStep := Fold.exprFoldAcc(step, each(each(acc, start), stop), f, keeps, h)
      Fold.exprFoldAcc(start, acc, f, keeps, Fold.exprFoldAcc(stop, each(acc, start), f, keeps, beforeStep))
    }
    | Stmt.ifElse c yes no => Fold.exprFoldAcc(c, acc, f, keeps, h)
    | Stmt.scoped body => h
    | Stmt.sync => h
    | Stmt.syncWarp => h
    | Stmt.asm template outs ins => {
      let step := Fold.operandStep(f)
      let beforeIns := Fold.foldlAcc(Operand, ins, List.foldl(outs, List(String), acc, step), step, Fold.operandKeeps(f, keeps), h)
      Fold.foldlAcc(Operand, outs, acc, step, Fold.operandKeeps(f, keeps), beforeIns)
    }
    | Stmt.instr i => {
      let step := Fold.operandStep(f)
      let a := Cuda.asmOf(i)
      let beforeIns := Fold.foldlAcc(Operand, a.ins, List.foldl(a.outs, List(String), acc, step), step, Fold.operandKeeps(f, keeps), h)
      Fold.foldlAcc(Operand, a.outs, acc, step, Fold.operandKeeps(f, keeps), beforeIns)
    }
    | Stmt.error message => h
  }

  // A statement's expression fold that found nothing found nothing at each of its expressions.
  def stmtExprsAt (y: Expr)(s: Stmt)(own: Spec.OwnExpr(y, s))(acc: List(String))(f: List(String) -> Expr -> List(String))
      (keeps: Fold.Keeps(Expr, f))(h: Fold.Empty(Check.stmtExprs(List(String), s, acc, f))): Fold.Empty(f(List.nil(String), y)) := {
    let each := fun (a: List(String))(x: Expr): List(String) => Check.exprFold(List(String), x, a, f)
    let step := Fold.operandStep(f)
    match own returning Fold.Empty(f(List.nil(String), y)) with
    | Spec.OwnExpr.decl t id init sub => Fold.exprFoldAt(y, init, sub, acc, f, keeps, h)
    | Spec.OwnExpr.declMut t id init sub => Fold.exprFoldAt(y, init, sub, acc, f, keeps, h)
    | Spec.OwnExpr.assign id value sub => Fold.exprFoldAt(y, value, sub, acc, f, keeps, h)
    | Spec.OwnExpr.storeBase base i value sub => {
      let beforeValue := Fold.exprFoldAcc(value, each(each(acc, base), i), f, keeps, h)
      Fold.exprFoldAt(y, base, sub, acc, f, keeps, Fold.exprFoldAcc(i, each(acc, base), f, keeps, beforeValue))
    }
    | Spec.OwnExpr.storeIndex base i value sub =>
      Fold.exprFoldAt(y, i, sub, each(acc, base), f, keeps, Fold.exprFoldAcc(value, each(each(acc, base), i), f, keeps, h))
    | Spec.OwnExpr.storeValue base i value sub => Fold.exprFoldAt(y, value, sub, each(each(acc, base), i), f, keeps, h)
    | Spec.OwnExpr.forStart id start count body sub =>
      Fold.exprFoldAt(y, start, sub, acc, f, keeps, Fold.exprFoldAcc(count, each(acc, start), f, keeps, h))
    | Spec.OwnExpr.forCount id start count body sub => Fold.exprFoldAt(y, count, sub, each(acc, start), f, keeps, h)
    | Spec.OwnExpr.strideStart id start stop step body sub => {
      let beforeStep := Fold.exprFoldAcc(step, each(each(acc, start), stop), f, keeps, h)
      Fold.exprFoldAt(y, start, sub, acc, f, keeps, Fold.exprFoldAcc(stop, each(acc, start), f, keeps, beforeStep))
    }
    | Spec.OwnExpr.strideStop id start stop step body sub =>
      Fold.exprFoldAt(y, stop, sub, each(acc, start), f, keeps, Fold.exprFoldAcc(step, each(each(acc, start), stop), f, keeps, h))
    | Spec.OwnExpr.strideStep id start stop step body sub => Fold.exprFoldAt(y, step, sub, each(each(acc, start), stop), f, keeps, h)
    | Spec.OwnExpr.cond c yes no sub => Fold.exprFoldAt(y, c, sub, acc, f, keeps, h)
    | Spec.OwnExpr.asmOut template outs ins o mem sub => {
      let beforeIns := Fold.foldlAcc(Operand, ins, List.foldl(outs, List(String), acc, step), step, Fold.operandKeeps(f, keeps), h)
      Fold.exprFoldAt(y, o.e, sub, List.nil(String), f, keeps, Fold.foldlAt(Operand, o, outs, mem, acc, step, Fold.operandKeeps(f, keeps), beforeIns))
    }
    | Spec.OwnExpr.asmIn template outs ins o mem sub => {
      let atO := Fold.foldlAt(Operand, o, ins, mem, List.foldl(outs, List(String), acc, step), step, Fold.operandKeeps(f, keeps), h)
      Fold.exprFoldAt(y, o.e, sub, List.nil(String), f, keeps, atO)
    }
    | Spec.OwnExpr.instrOut i o mem sub => {
      let a := Cuda.asmOf(i)
      let beforeIns := Fold.foldlAcc(Operand, a.ins, List.foldl(a.outs, List(String), acc, step), step, Fold.operandKeeps(f, keeps), h)
      Fold.exprFoldAt(y, o.e, sub, List.nil(String), f, keeps, Fold.foldlAt(Operand, o, a.outs, mem, acc, step, Fold.operandKeeps(f, keeps), beforeIns))
    }
    | Spec.OwnExpr.instrIn i o mem sub => {
      let a := Cuda.asmOf(i)
      let atO := Fold.foldlAt(Operand, o, a.ins, mem, List.foldl(a.outs, List(String), acc, step), step, Fold.operandKeeps(f, keeps), h)
      Fold.exprFoldAt(y, o.e, sub, List.nil(String), f, keeps, atO)
    }
  }

  // ---- Blocks -------------------------------------------------------------------------------------------------------

  mutual {
    // A statement fold that found nothing found nothing at the statement itself.
    def stmtFoldHere (s: Stmt)(acc: List(String))(g: List(String) -> Stmt -> List(String))(keeps: Fold.Keeps(Stmt, g))
        (h: Fold.Empty(Check.stmtFold(List(String), s, acc, g))): Fold.Empty(g(acc, s)) decreases structural(s) := {
      let here := g(acc, s)
      match s returning Fold.Empty(g(acc, s)) with
      | Stmt.decl t id init => h
      | Stmt.declMut t id init => h
      | Stmt.declOut t id => h
      | Stmt.assign id value => h
      | Stmt.store base i value => h
      | Stmt.shared t id size => h
      | Stmt.forLoop id start count body => Fold.blockFoldAcc(body, here, g, keeps, h)
      | Stmt.forStride id start stop step body => Fold.blockFoldAcc(body, here, g, keeps, h)
      | Stmt.ifElse c yes no => Fold.blockFoldAcc(yes, here, g, keeps, Fold.blockFoldAcc(no, Check.blockFold(List(String), yes, here, g), g, keeps, h))
      | Stmt.scoped body => Fold.blockFoldAcc(body, here, g, keeps, h)
      | Stmt.sync => h
      | Stmt.syncWarp => h
      | Stmt.asm template outs ins => h
      | Stmt.instr i => h
      | Stmt.error message => h
    }

    def blockFoldAcc (b: Block)(acc: List(String))(g: List(String) -> Stmt -> List(String))(keeps: Fold.Keeps(Stmt, g))
        (h: Fold.Empty(Check.blockFold(List(String), b, acc, g))): Fold.Empty(acc) decreases structural(b) := {
      match b returning Fold.Empty(acc) with
      | Block.done => h
      | Block.seq s more =>
        keeps(acc, s, Fold.stmtFoldHere(s, acc, g, keeps, Fold.blockFoldAcc(more, Check.stmtFold(List(String), s, acc, g), g, keeps, h)))
    }
  }

  mutual {
    // A statement fold that found nothing found nothing at each statement in it.
    def stmtFoldAt (y: Stmt)(s: Stmt)(occ: Spec.InStmt(y, s))(acc: List(String))(g: List(String) -> Stmt -> List(String))
        (keeps: Fold.Keeps(Stmt, g))(h: Fold.Empty(Check.stmtFold(List(String), s, acc, g))): Fold.Empty(g(List.nil(String), y)) decreases structural(s) := {
      let here := g(acc, s)
      match occ returning Fold.Empty(g(List.nil(String), y)) with
      | Spec.InStmt.here => {
        let atRoot := Fold.stmtFoldHere(y, acc, g, keeps, h)
        match keeps(acc, y, atRoot) returning Fold.Empty(g(List.nil(String), y)) with
        | Eq.refl z => atRoot
      }
      | Spec.InStmt.forLoop id start count body inner => Fold.blockFoldAt(y, body, inner, here, g, keeps, h)
      | Spec.InStmt.forStride id start stop step body inner => Fold.blockFoldAt(y, body, inner, here, g, keeps, h)
      | Spec.InStmt.ifYes c yes no inner =>
        Fold.blockFoldAt(y, yes, inner, here, g, keeps, Fold.blockFoldAcc(no, Check.blockFold(List(String), yes, here, g), g, keeps, h))
      | Spec.InStmt.ifNo c yes no inner => Fold.blockFoldAt(y, no, inner, Check.blockFold(List(String), yes, here, g), g, keeps, h)
      | Spec.InStmt.scoped body inner => Fold.blockFoldAt(y, body, inner, here, g, keeps, h)
    }

    def blockFoldAt (y: Stmt)(b: Block)(occ: Spec.InBlock(y, b))(acc: List(String))(g: List(String) -> Stmt -> List(String))
        (keeps: Fold.Keeps(Stmt, g))(h: Fold.Empty(Check.blockFold(List(String), b, acc, g))): Fold.Empty(g(List.nil(String), y)) decreases structural(b) := {
      match occ returning Fold.Empty(g(List.nil(String), y)) with
      | Spec.InBlock.head s rest inner =>
        Fold.stmtFoldAt(y, s, inner, acc, g, keeps, Fold.blockFoldAcc(rest, Check.stmtFold(List(String), s, acc, g), g, keeps, h))
      | Spec.InBlock.tail s rest inner => Fold.blockFoldAt(y, rest, inner, Check.stmtFold(List(String), s, acc, g), g, keeps, h)
    }
  }

  // `blockExprs`'s step over statements.
  def stmtStep (f: List(String) -> Expr -> List(String)): List(String) -> Stmt -> List(String) :=
    fun (a: List(String))(s: Stmt): List(String) => Check.stmtExprs(List(String), s, a, f)

  def stmtKeeps (f: List(String) -> Expr -> List(String))(keeps: Fold.Keeps(Expr, f)): Fold.Keeps(Stmt, Fold.stmtStep(f)) :=
    fun (a: List(String))(s: Stmt)(h: Fold.Empty(Check.stmtExprs(List(String), s, a, f))): Fold.Empty(a) => Fold.stmtExprsAcc(s, a, f, keeps, h)

  def blockExprsAcc (b: Block)(acc: List(String))(f: List(String) -> Expr -> List(String))(keeps: Fold.Keeps(Expr, f))
      (h: Fold.Empty(Check.blockExprs(List(String), b, acc, f))): Fold.Empty(acc) :=
    Fold.blockFoldAcc(b, acc, Fold.stmtStep(f), Fold.stmtKeeps(f, keeps), h)

  // A block's expression fold that found nothing found nothing at each expression in it.
  def blockExprsAt (y: Expr)(b: Block)(occ: Spec.ExprIn(y, b))(acc: List(String))(f: List(String) -> Expr -> List(String))
      (keeps: Fold.Keeps(Expr, f))(h: Fold.Empty(Check.blockExprs(List(String), b, acc, f))): Fold.Empty(f(List.nil(String), y)) := {
    match occ returning Fold.Empty(f(List.nil(String), y)) with
    | Spec.ExprIn.mk s stmt own =>
      Fold.stmtExprsAt(y, s, own, List.nil(String), f, keeps, Fold.blockFoldAt(s, b, stmt, acc, Fold.stmtStep(f), Fold.stmtKeeps(f, keeps), h))
  }

  // ---- The launcher -------------------------------------------------------------------------------------------------

  // `hostExprs`'s step over expressions.
  def exprStep (f: List(String) -> Expr -> List(String)): List(String) -> Expr -> List(String) :=
    fun (a: List(String))(x: Expr): List(String) => Check.exprFold(List(String), x, a, f)

  def exprKeeps (f: List(String) -> Expr -> List(String))(keeps: Fold.Keeps(Expr, f)): Fold.Keeps(Expr, Fold.exprStep(f)) :=
    fun (a: List(String))(x: Expr)(h: Fold.Empty(Check.exprFold(List(String), x, a, f))): Fold.Empty(a) => Fold.exprFoldAcc(x, a, f, keeps, h)

  def hostExprsAcc (host: Option(Launcher))(acc: List(String))(f: List(String) -> Expr -> List(String))(keeps: Fold.Keeps(Expr, f))
      (h: Fold.Empty(Check.hostExprs(List(String), host, acc, f))): Fold.Empty(acc) := {
    match host returning Fold.Empty(acc) with
    | Option.none => h
    | Option.some l => Fold.foldlAcc(Expr, Check.hostExprList(l), acc, Fold.exprStep(f), Fold.exprKeeps(f, keeps), h)
  }

  def gridMem (root: Expr)(g: Grid)(h: Spec.GridExpr(root, g)): Spec.Mem(Expr, root, Check.gridExprs(g)) := {
    match h returning Spec.Mem(Expr, root, Check.gridExprs(g)) with
    | Spec.GridExpr.blocksX y => Spec.Mem.here(root, List.cons(y, List.nil(Expr)))
    | Spec.GridExpr.blocksY x => Spec.Mem.there(x, List.cons(root, List.nil(Expr)), Spec.Mem.here(root, List.nil(Expr)))
    | Spec.GridExpr.persistent => Spec.Mem.here(root, List.nil(Expr))
    | Spec.GridExpr.pairsX y => Spec.Mem.here(root, List.cons(y, List.nil(Expr)))
    | Spec.GridExpr.pairsY x => Spec.Mem.there(x, List.cons(root, List.nil(Expr)), Spec.Mem.here(root, List.nil(Expr)))
    | Spec.GridExpr.persistentPairs => Spec.Mem.here(root, List.nil(Expr))
  }

  // Every expression a launcher evaluates is in `hostExprList`.
  def hostRootMem (l: Launcher)(root: Expr)(h: Spec.HostRoot(l, root)): Spec.Mem(Expr, root, Check.hostExprList(l)) := {
    match h returning Spec.Mem(Expr, root, Check.hostExprList(l)) with
    | Spec.HostRoot.require m => Fold.memAppendLeft(Expr, root, l.requires, Check.gridExprs(l.grid), m)
    | Spec.HostRoot.grid m => Fold.memAppendRight(Expr, root, l.requires, Check.gridExprs(l.grid), Fold.gridMem(root, l.grid, m))
  }

  // A fold over a launcher's expressions that found nothing found nothing at each of them.
  def launcherExprsAt (l: Launcher)(y: Expr)(occ: Spec.LauncherExpr(l, y))(acc: List(String))(f: List(String) -> Expr -> List(String))
      (keeps: Fold.Keeps(Expr, f))(h: Fold.Empty(List.foldl(Check.hostExprList(l), List(String), acc, Fold.exprStep(f)))): Fold.Empty(f(List.nil(String), y)) := {
    match occ returning Fold.Empty(f(List.nil(String), y)) with
    | Spec.LauncherExpr.mk root evaluated sub => {
      let atRoot := Fold.foldlAt(Expr, root, Check.hostExprList(l), Fold.hostRootMem(l, root, evaluated), acc, Fold.exprStep(f), Fold.exprKeeps(f, keeps), h)
      Fold.exprFoldAt(y, root, sub, List.nil(String), f, keeps, atRoot)
    }
  }

  def hostExprsAt (k: Kernel)(y: Expr)(occ: Spec.HostExpr(k, y))(acc: List(String))(f: List(String) -> Expr -> List(String))
      (keeps: Fold.Keeps(Expr, f))(h: Fold.Empty(Check.hostExprs(List(String), k.launcher, acc, f))): Fold.Empty(f(List.nil(String), y)) := {
    match occ returning Fold.Empty(f(List.nil(String), y)) with
    | Spec.HostExpr.mk l launched inLauncher => {
      match launched returning Fold.Empty(f(List.nil(String), y)) with
      | Eq.refl host => Fold.launcherExprsAt(l, y, inLauncher, acc, f, keeps, h)
    }
  }

  // ---- Program order ------------------------------------------------------------------------------------------------

  def foldlAppend (A: Type)(B: Type)(xs: List(A))(ys: List(A))(acc: B)(f: B -> A -> B)
      : Eq(B, List.foldl(List.append(xs, ys), B, acc, f), List.foldl(ys, B, List.foldl(xs, B, acc, f), f)) decreases structural(xs) := {
    match xs returning Eq(B, List.foldl(List.append(xs, ys), B, acc, f), List.foldl(ys, B, List.foldl(xs, B, acc, f), f)) with
    | List.nil => Eq.refl(List.foldl(ys, B, acc, f))
    | List.cons x more => Fold.foldlAppend(A, B, more, ys, f(acc, x), f)
  }

  mutual {
    // A statement fold is a fold over the statement and those in its blocks, in program order.
    def stmtFusion (A: Type)(s: Stmt)(acc: A)(f: A -> Stmt -> A)
        : Eq(A, Check.stmtFold(A, s, acc, f), List.foldl(Spec.inner(s), A, f(acc, s), f)) decreases structural(s) := {
      let here := f(acc, s)
      match s returning Eq(A, Check.stmtFold(A, s, acc, f), List.foldl(Spec.inner(s), A, f(acc, s), f)) with
      | Stmt.decl t id init => Eq.refl(here)
      | Stmt.declMut t id init => Eq.refl(here)
      | Stmt.declOut t id => Eq.refl(here)
      | Stmt.assign id value => Eq.refl(here)
      | Stmt.store base i value => Eq.refl(here)
      | Stmt.shared t id size => Eq.refl(here)
      | Stmt.forLoop id start count body => Fold.blockFusion(A, body, here, f)
      | Stmt.forStride id start stop step body => Fold.blockFusion(A, body, here, f)
      | Stmt.ifElse c yes no => {
        let yesFold := Check.blockFold(A, yes, here, f)
        let noFlat := fun (a: A): A => List.foldl(Spec.statements(no), A, a, f)
        let both := Eq.trans(Fold.blockFusion(A, no, yesFold, f), congrArg(Fold.blockFusion(A, yes, here, f), A, noFlat))
        Eq.trans(both, Eq.symm(Fold.foldlAppend(Stmt, A, Spec.statements(yes), Spec.statements(no), here, f)))
      }
      | Stmt.scoped body => Fold.blockFusion(A, body, here, f)
      | Stmt.sync => Eq.refl(here)
      | Stmt.syncWarp => Eq.refl(here)
      | Stmt.asm template outs ins => Eq.refl(here)
      | Stmt.instr i => Eq.refl(here)
      | Stmt.error message => Eq.refl(here)
    }

    // A block fold is a fold over its statements in program order.
    def blockFusion (A: Type)(b: Block)(acc: A)(f: A -> Stmt -> A)
        : Eq(A, Check.blockFold(A, b, acc, f), List.foldl(Spec.statements(b), A, acc, f)) decreases structural(b) := {
      match b returning Eq(A, Check.blockFold(A, b, acc, f), List.foldl(Spec.statements(b), A, acc, f)) with
      | Block.done => Eq.refl(acc)
      | Block.seq s more => {
        let restFlat := fun (a: A): A => List.foldl(Spec.statements(more), A, a, f)
        let both := Eq.trans(Fold.blockFusion(A, more, Check.stmtFold(A, s, acc, f), f), congrArg(Fold.stmtFusion(A, s, acc, f), A, restFlat))
        Eq.trans(both, Eq.symm(Fold.foldlAppend(Stmt, A, Spec.inner(s), Spec.statements(more), f(acc, s), f)))
      }
    }
  }

  mutual {
    // A statement in the blocks of `s` is among the statements `Spec.inner` lists.
    def innerMem (x: Stmt)(s: Stmt)(occ: Spec.InStmt(x, s)): Spec.Mem(Stmt, x, List.cons(s, Spec.inner(s))) decreases structural(s) := {
      match occ returning Spec.Mem(Stmt, x, List.cons(s, Spec.inner(s))) with
      | Spec.InStmt.here => Spec.Mem.here(x, Spec.inner(x))
      | Spec.InStmt.forLoop id start count body inside => Spec.Mem.there(s, Spec.statements(body), Fold.blockMem(x, body, inside))
      | Spec.InStmt.forStride id start stop step body inside => Spec.Mem.there(s, Spec.statements(body), Fold.blockMem(x, body, inside))
      | Spec.InStmt.ifYes c yes no inside => Spec.Mem.there(s, List.append(Spec.statements(yes), Spec.statements(no)),
        Fold.memAppendLeft(Stmt, x, Spec.statements(yes), Spec.statements(no), Fold.blockMem(x, yes, inside)))
      | Spec.InStmt.ifNo c yes no inside => Spec.Mem.there(s, List.append(Spec.statements(yes), Spec.statements(no)),
        Fold.memAppendRight(Stmt, x, Spec.statements(yes), Spec.statements(no), Fold.blockMem(x, no, inside)))
      | Spec.InStmt.scoped body inside => Spec.Mem.there(s, Spec.statements(body), Fold.blockMem(x, body, inside))
    }

    // A statement in `b` is among its statements in program order.
    def blockMem (x: Stmt)(b: Block)(occ: Spec.InBlock(x, b)): Spec.Mem(Stmt, x, Spec.statements(b)) decreases structural(b) := {
      match occ returning Spec.Mem(Stmt, x, Spec.statements(b)) with
      | Spec.InBlock.head s rest inside =>
        Fold.memAppendLeft(Stmt, x, List.cons(s, Spec.inner(s)), Spec.statements(rest), Fold.innerMem(x, s, inside))
      | Spec.InBlock.tail s rest inside =>
        Fold.memAppendRight(Stmt, x, List.cons(s, Spec.inner(s)), Spec.statements(rest), Fold.blockMem(x, rest, inside))
    }
  }
}
