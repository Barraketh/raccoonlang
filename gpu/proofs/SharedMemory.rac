// The shared-memory checker is sound (I2): a kernel it finds nothing in has a dynamic buffer that fits an SM, a
// launcher if it has a buffer, no static array beside one, and every constant offset into the buffer inside it.

import proofs.Fold

namespace SharedMemory {
  open Cuda

  def staticMessage (id: Nat): Unit -> String :=
    fun (u: Unit): String => Text.cat3("static shared array ", Cuda.name(id), " in a kernel with dynamic shared memory")

  def offsetMessage (bytes: Nat)(offset: Nat): Unit -> String :=
    fun (u: Unit): String => Text.cat3("dynamic shared memory at byte ", Text.nat(offset), Text.cat3(", outside the kernel's ", Text.nat(bytes), " bytes"))

  def staticKeeps (bytes: Nat): Fold.Keeps(Stmt, Check.staticStep(bytes)) :=
    fun (found: List(String))(s: Stmt)(h: Fold.Empty(Check.staticStep(bytes)(found, s))): Fold.Empty(found) => {
      match s returning Fold.Empty(found) with
      | Stmt.decl t id init => h
      | Stmt.declMut t id init => h
      | Stmt.declOut t id => h
      | Stmt.assign id value => h
      | Stmt.store base i value => h
      | Stmt.shared t id size => Fold.unlessFound(found, Bool.not(Nat.blt(0, bytes)), SharedMemory.staticMessage(id), h)
      | Stmt.forLoop id start count body => h
      | Stmt.forStride id start stop step body => h
      | Stmt.ifElse c yes no => h
      | Stmt.scoped body => h
      | Stmt.sync => h
      | Stmt.syncWarp => h
      | Stmt.asm template outs ins => h
      | Stmt.instr i => h
      | Stmt.error message => h
    }

  def offsetKeeps (bytes: Nat): Fold.Keeps(Expr, Check.offsetStep(bytes)) :=
    fun (found: List(String))(x: Expr)(h: Fold.Empty(Check.offsetStep(bytes)(found, x))): Fold.Empty(found) => {
      match x returning Fold.Empty(found) with
      | Expr.var id => h
      | Expr.lit value => h
      | Expr.lit64 value => h
      | Expr.zero t => h
      | Expr.param n => h
      | Expr.special b => h
      | Expr.bin op a b => h
      | Expr.max a b => h
      | Expr.fma a b c => h
      | Expr.select c t f => h
      | Expr.index base i => h
      | Expr.cast t a => h
      | Expr.sharedAddr offset => Fold.unlessFound(found, Nat.blt(offset, bytes), SharedMemory.offsetMessage(bytes, offset), h)
      | Expr.sharedPtr t offset => Fold.unlessFound(found, Nat.blt(offset, bytes), SharedMemory.offsetMessage(bytes, offset), h)
      | Expr.paramAddr n => h
    }

  // A size that is not positive is zero.
  def notPositive (n: Nat)(h: Eq(Bool, Bool.not(Nat.blt(0, n)), Bool.true)): Eq(Nat, n, 0) := {
    match n returning Eq(Nat, n, 0) with
    | Nat.zero => Eq.refl(0)
    | Nat.succ m => False.elim(Bool.falseNeTrue(h), Eq(Nat, Nat.succ(m), 0))
  }

  def orNot (a: Bool)(b: Bool)(h: Eq(Bool, Bool.or(Bool.not(a), b), Bool.true))(ha: Eq(Bool, a, Bool.true)): Eq(Bool, b, Bool.true) := {
    match a returning Eq(Bool, b, Bool.true) with
    | Bool.true => h
    | Bool.false => False.elim(Bool.falseNeTrue(ha), Eq(Bool, b, Bool.true))
  }

  def someNotNone (o: Option(Launcher))(h: Eq(Bool, Option.isSome(o), Bool.true)): Not(Eq(Option(Launcher), o, Option.none(Launcher))) := {
    match o returning Not(Eq(Option(Launcher), o, Option.none(Launcher))) with
    | Option.none => False.elim(Bool.falseNeTrue(h), Not(Eq(Option(Launcher), Option.none(Launcher), Option.none(Launcher))))
    | Option.some l => fun (e: Eq(Option(Launcher), Option.some(l), Option.none(Launcher))): False => {
      match e returning False with
    }
  }

  def sound (k: Kernel)(h: Eq(List(String), Check.sharedMemory(k), List.nil(String))): Spec.SharedMemory(k) := {
    let bytes := k.dynamicShared
    let size := Check.sharedSize(bytes, Option.isSome(k.launcher))
    let statics := Check.blockFold(List(String), k.body, size, Check.staticStep(bytes))
    let all := Fold.inOrder(Check.blockExprs(List(String), k.body, statics, Check.offsetStep(bytes)), h)
    let staticsOk := Fold.blockExprsAcc(k.body, statics, Check.offsetStep(bytes), SharedMemory.offsetKeeps(bytes), all)
    let sizeOk := Fold.blockFoldAcc(k.body, size, Check.staticStep(bytes), SharedMemory.staticKeeps(bytes), staticsOk)
    let fitsMessage := fun (u: Unit): String =>
      Text.cat3(Text.nat(bytes), " bytes of dynamic shared memory, more than sm_100a's ", Text.nat(Check.maxDynamicShared))
    let fits := Check.unless(List.nil(String), Nat.ble(bytes, Check.maxDynamicShared), fitsMessage)
    let askedMessage := fun (u: Unit): String => Text.cat(Text.nat(bytes), " bytes of dynamic shared memory, and no launcher to ask for them")
    let dynamic := Nat.blt(0, bytes)
    let asked := Fold.unlessOk(fits, Bool.or(Bool.not(dynamic), Option.isSome(k.launcher)), askedMessage, sizeOk)
    let fitsOk := Fold.unlessOk(List.nil(String), Nat.ble(bytes, Check.maxDynamicShared), fitsMessage,
      Fold.unlessFound(fits, Bool.or(Bool.not(dynamic), Option.isSome(k.launcher)), askedMessage, sizeOk))
    let launched := fun (positive: Nat.lt(0, bytes)): Not(Eq(Option(Launcher), k.launcher, Option.none(Launcher))) =>
      SharedMemory.someNotNone(k.launcher, SharedMemory.orNot(dynamic, Option.isSome(k.launcher), asked, positive))
    let noStatic := fun (t: DType)(id: Nat)(n: Nat)(occ: Spec.InBlock(Stmt.shared(t, id, n), k.body)): Eq(Nat, bytes, 0) => {
      let here := Fold.blockFoldAt(Stmt.shared(t, id, n), k.body, occ, size, Check.staticStep(bytes), SharedMemory.staticKeeps(bytes), staticsOk)
      SharedMemory.notPositive(bytes, Fold.unlessOk(List.nil(String), Bool.not(dynamic), SharedMemory.staticMessage(id), here))
    }
    let inside := fun (offset: Nat)(occ: Spec.SharedAt(k.body, offset)): Nat.lt(offset, bytes) => {
      match occ returning Nat.lt(offset, bytes) with
      | Spec.SharedAt.addr inBody => {
        let here := Fold.blockExprsAt(Expr.sharedAddr(offset), k.body, inBody, statics, Check.offsetStep(bytes), SharedMemory.offsetKeeps(bytes), all)
        Fold.unlessOk(List.nil(String), Nat.blt(offset, bytes), SharedMemory.offsetMessage(bytes, offset), here)
      }
      | Spec.SharedAt.ptr t inBody => {
        let here := Fold.blockExprsAt(Expr.sharedPtr(t, offset), k.body, inBody, statics, Check.offsetStep(bytes), SharedMemory.offsetKeeps(bytes), all)
        Fold.unlessOk(List.nil(String), Nat.blt(offset, bytes), SharedMemory.offsetMessage(bytes, offset), here)
      }
    }
    Spec.SharedMemory.mk(k, fitsOk, launched, noStatic, inside)
  }
}
