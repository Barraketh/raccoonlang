// The scoping checker is sound (I1): in a kernel it finds nothing in, each statement uses only variables in scope
// where it stands, no two statements declare one id, and the launcher evaluates nothing only the device can.
// The walk carries the set of variables in scope (`visible`), which holds only variables of the spec's scope
// (`Within`), and the set of those declared so far (`seen`), which only grows.

import proofs.Fold
import proofs.NatSet

namespace Scoping {
  open Cuda
  open Check.{Scan, NatSet}

  // `v` holds only variables of `vars`.
  def Within (v: NatSet)(vars: List(Nat)): Prop := (id: Nat) -> Eq(Bool, Check.NatSet.member(v, id), Bool.true) -> Spec.Mem(Nat, id, vars)

  def withinEmpty : Scoping.Within(NatSet.empty, List.nil(Nat)) :=
    fun (id: Nat)(h: Eq(Bool, Check.NatSet.member(NatSet.empty, id), Bool.true)): Spec.Mem(Nat, id, List.nil(Nat)) =>
      False.elim(Bool.falseNeTrue(h), Spec.Mem(Nat, id, List.nil(Nat)))

  def withinInsert (v: NatSet)(vars: List(Nat))(id: Nat)(w: Scoping.Within(v, vars)): Scoping.Within(Check.NatSet.insert(v, id), List.cons(id, vars)) :=
    fun (n: Nat)(h: Eq(Bool, Check.NatSet.member(Check.NatSet.insert(v, id), n), Bool.true)): Spec.Mem(Nat, n, List.cons(id, vars)) => {
      match NatSets.fromInsert(v, id, n, h) returning Spec.Mem(Nat, n, List.cons(id, vars)) with
      | Or.inl same => {
        match same returning Spec.Mem(Nat, n, List.cons(id, vars)) with
        | Eq.refl z => Spec.Mem.here(z, vars)
      }
      | Or.inr before => Spec.Mem.there(id, vars, w(n, before))
    }

  // What a statement declares is in scope after it.
  def withinAfter (v: NatSet)(vars: List(Nat))(s: Stmt)(w: Scoping.Within(v, vars)): Scoping.Within(Check.after(v, s), List.append(Spec.declaredBy(s), vars)) := {
    match s returning Scoping.Within(Check.after(v, s), List.append(Spec.declaredBy(s), vars)) with
    | Stmt.decl t id init => Scoping.withinInsert(v, vars, id, w)
    | Stmt.declMut t id init => Scoping.withinInsert(v, vars, id, w)
    | Stmt.declOut t id => Scoping.withinInsert(v, vars, id, w)
    | Stmt.assign id value => w
    | Stmt.store base i value => w
    | Stmt.shared t id size => Scoping.withinInsert(v, vars, id, w)
    | Stmt.forLoop id start count body => w
    | Stmt.forStride id start stop step body => w
    | Stmt.ifElse c yes no => w
    | Stmt.scoped body => w
    | Stmt.sync => w
    | Stmt.syncWarp => w
    | Stmt.instr i => w
    | Stmt.error message => w
  }

  // ---- Steps --------------------------------------------------------------------------------------------------------

  def useKeeps (v: NatSet)(seen: NatSet): Fold.Keeps(Expr, Check.useStep(v, seen)) :=
    fun (found: List(String))(x: Expr)(h: Fold.Empty(Check.useStep(v, seen)(found, x))): Fold.Empty(found) => {
      match x returning Fold.Empty(found) with
      | Expr.var id => Fold.unlessFound(found, Check.NatSet.member(v, id), Check.unscoped(seen, id), h)
      | Expr.lit value => h
      | Expr.lit64 value => h
      | Expr.zero t => h
      | Expr.param n => h
      | Expr.special b => h
      | Expr.bin op a b => h
      | Expr.max a b => h
      | Expr.fma a b c => h
      | Expr.select c t f => h
      | Expr.index base i => h
      | Expr.cast t a => h
      | Expr.sharedAddr offset => h
      | Expr.sharedPtr t offset => h
      | Expr.paramAddr n => h
    }

  def declaredAcc (seen: NatSet)(found: List(String))(id: Nat)(isSeen: Bool)(h: Fold.Empty(Check.declaration(seen, found, id, isSeen).found)): Fold.Empty(found) := {
    match isSeen returning Fold.Empty(found) with
    | Bool.true => False.elim(Fold.consNotEmpty(Text.cat(Cuda.name(id), " declared twice"), found, h), Fold.Empty(found))
    | Bool.false => h
  }

  def declaredFresh (seen: NatSet)(found: List(String))(id: Nat)(isSeen: Bool)(h: Fold.Empty(Check.declaration(seen, found, id, isSeen).found))
      : Eq(Bool, isSeen, Bool.false) := {
    match isSeen returning Eq(Bool, isSeen, Bool.false) with
    | Bool.true => False.elim(Fold.consNotEmpty(Text.cat(Cuda.name(id), " declared twice"), found, h), Eq(Bool, Bool.true, Bool.false))
    | Bool.false => Eq.refl(Bool.false)
  }

  def declaredSeen (seen: NatSet)(found: List(String))(id: Nat)(isSeen: Bool)(n: Nat)(h: Eq(Bool, Check.NatSet.member(seen, n), Bool.true))
      : Eq(Bool, Check.NatSet.member(Check.declaration(seen, found, id, isSeen).seen, n), Bool.true) := {
    match isSeen returning Eq(Bool, Check.NatSet.member(Check.declaration(seen, found, id, isSeen).seen, n), Bool.true) with
    | Bool.true => h
    | Bool.false => NatSets.kept(seen, id, n, h)
  }

  def declaredHas (seen: NatSet)(found: List(String))(id: Nat)(isSeen: Bool)(fresh: Eq(Bool, isSeen, Bool.false))
      : Eq(Bool, Check.NatSet.member(Check.declaration(seen, found, id, isSeen).seen, id), Bool.true) := {
    match fresh returning Eq(Bool, Check.NatSet.member(Check.declaration(seen, found, id, isSeen).seen, id), Bool.true) with
    | Eq.refl z => NatSets.inserted(seen, id)
  }

  // The scan after statement `s`'s own expressions, as `Check.scopeStmt` names it.
  def used (v: NatSet)(s: Stmt)(st: Scan): Scan := Scan.mk(st.seen, Check.stmtExprs(List(String), s, st.found, Check.useStep(v, st.seen)))

  // ---- The walk found nothing before -------------------------------------------------------------------------------

  mutual {
    // A statement's walk that found nothing found nothing in its own expressions.
    def ownFound (v: NatSet)(s: Stmt)(st: Scan)(h: Fold.Empty(Check.scopeStmt(v, s, st).found)): Fold.Empty(Scoping.used(v, s, st).found) decreases structural(s) := {
      let u := Scoping.used(v, s, st)
      match s returning Fold.Empty(Scoping.used(v, s, st).found) with
      | Stmt.decl t id init => Scoping.declaredAcc(st.seen, u.found, id, Check.NatSet.member(st.seen, id), h)
      | Stmt.declMut t id init => Scoping.declaredAcc(st.seen, u.found, id, Check.NatSet.member(st.seen, id), h)
      | Stmt.declOut t id => Scoping.declaredAcc(st.seen, u.found, id, Check.NatSet.member(st.seen, id), h)
      | Stmt.assign id value => Fold.unlessFound(u.found, Check.NatSet.member(v, id), Check.unscoped(st.seen, id), h)
      | Stmt.store base i value => h
      | Stmt.shared t id size => Scoping.declaredAcc(st.seen, u.found, id, Check.NatSet.member(st.seen, id), h)
      | Stmt.forLoop id start count body =>
        Scoping.declaredAcc(st.seen, u.found, id, Check.NatSet.member(st.seen, id), Scoping.blockAcc(Check.NatSet.insert(v, id), body, Check.declare(u, id), h))
      | Stmt.forStride id start stop step body =>
        Scoping.declaredAcc(st.seen, u.found, id, Check.NatSet.member(st.seen, id), Scoping.blockAcc(Check.NatSet.insert(v, id), body, Check.declare(u, id), h))
      | Stmt.ifElse c yes no => Scoping.blockAcc(v, yes, u, Scoping.blockAcc(v, no, Check.scopeBlock(v, yes, u), h))
      | Stmt.scoped body => Scoping.blockAcc(v, body, u, h)
      | Stmt.sync => h
      | Stmt.syncWarp => h
      | Stmt.instr i => h
      | Stmt.error message => h
    }

    def blockAcc (v: NatSet)(b: Block)(st: Scan)(h: Fold.Empty(Check.scopeBlock(v, b, st).found)): Fold.Empty(st.found) decreases structural(b) := {
      match b returning Fold.Empty(st.found) with
      | Block.done => h
      | Block.seq s more => {
        let own := Scoping.ownFound(v, s, st, Scoping.blockAcc(Check.after(v, s), more, Check.scopeStmt(v, s, st), h))
        Fold.stmtExprsAcc(s, st.found, Check.useStep(v, st.seen), Scoping.useKeeps(v, st.seen), own)
      }
    }
  }

  def stmtAcc (v: NatSet)(s: Stmt)(st: Scan)(h: Fold.Empty(Check.scopeStmt(v, s, st).found)): Fold.Empty(st.found) :=
    Fold.stmtExprsAcc(s, st.found, Check.useStep(v, st.seen), Scoping.useKeeps(v, st.seen), Scoping.ownFound(v, s, st, h))

  // ---- Declared ids stay seen ---------------------------------------------------------------------------------------

  mutual {
    def stmtSeen (v: NatSet)(s: Stmt)(st: Scan)(n: Nat)(h: Eq(Bool, Check.NatSet.member(st.seen, n), Bool.true))
        : Eq(Bool, Check.NatSet.member(Check.scopeStmt(v, s, st).seen, n), Bool.true) decreases structural(s) := {
      let u := Scoping.used(v, s, st)
      match s returning Eq(Bool, Check.NatSet.member(Check.scopeStmt(v, s, st).seen, n), Bool.true) with
      | Stmt.decl t id init => Scoping.declaredSeen(st.seen, u.found, id, Check.NatSet.member(st.seen, id), n, h)
      | Stmt.declMut t id init => Scoping.declaredSeen(st.seen, u.found, id, Check.NatSet.member(st.seen, id), n, h)
      | Stmt.declOut t id => Scoping.declaredSeen(st.seen, u.found, id, Check.NatSet.member(st.seen, id), n, h)
      | Stmt.assign id value => h
      | Stmt.store base i value => h
      | Stmt.shared t id size => Scoping.declaredSeen(st.seen, u.found, id, Check.NatSet.member(st.seen, id), n, h)
      | Stmt.forLoop id start count body =>
        Scoping.blockSeen(Check.NatSet.insert(v, id), body, Check.declare(u, id), n, Scoping.declaredSeen(st.seen, u.found, id, Check.NatSet.member(st.seen, id), n, h))
      | Stmt.forStride id start stop step body =>
        Scoping.blockSeen(Check.NatSet.insert(v, id), body, Check.declare(u, id), n, Scoping.declaredSeen(st.seen, u.found, id, Check.NatSet.member(st.seen, id), n, h))
      | Stmt.ifElse c yes no => Scoping.blockSeen(v, no, Check.scopeBlock(v, yes, u), n, Scoping.blockSeen(v, yes, u, n, h))
      | Stmt.scoped body => Scoping.blockSeen(v, body, u, n, h)
      | Stmt.sync => h
      | Stmt.syncWarp => h
      | Stmt.instr i => h
      | Stmt.error message => h
    }

    def blockSeen (v: NatSet)(b: Block)(st: Scan)(n: Nat)(h: Eq(Bool, Check.NatSet.member(st.seen, n), Bool.true))
        : Eq(Bool, Check.NatSet.member(Check.scopeBlock(v, b, st).seen, n), Bool.true) decreases structural(b) := {
      match b returning Eq(Bool, Check.NatSet.member(Check.scopeBlock(v, b, st).seen, n), Bool.true) with
      | Block.done => h
      | Block.seq s more => Scoping.blockSeen(Check.after(v, s), more, Check.scopeStmt(v, s, st), n, Scoping.stmtSeen(v, s, st, n, h))
    }
  }

  // ---- Uses are in scope --------------------------------------------------------------------------------------------

  mutual {
    def stmtInScope (x: Stmt)(visible: List(Nat))(vars: List(Nat))(s: Stmt)(occ: Spec.StmtScope(x, visible, vars, s))(v: NatSet)(w: Scoping.Within(v, vars))
        (st: Scan)(h: Fold.Empty(Check.scopeStmt(v, s, st).found)): (id: Nat) -> Spec.Uses(id, x) -> Spec.Mem(Nat, id, visible) decreases structural(s) := {
      let u := Scoping.used(v, s, st)
      match occ returning (id: Nat) -> Spec.Uses(id, x) -> Spec.Mem(Nat, id, visible) with
      | Spec.StmtScope.here => fun (id: Nat)(use: Spec.Uses(id, x)): Spec.Mem(Nat, id, visible) => {
        match use returning Spec.Mem(Nat, id, visible) with
        | Spec.Uses.expr y own => {
          let atUse := Fold.stmtExprsAt(Expr.var(id), x, own, st.found, Check.useStep(v, st.seen), Scoping.useKeeps(v, st.seen), Scoping.ownFound(v, x, st, h))
          w(id, Fold.unlessOk(List.nil(String), Check.NatSet.member(v, id), Check.unscoped(st.seen, id), atUse))
        }
        | Spec.Uses.target value => w(id, Fold.unlessOk(Scoping.used(v, x, st).found, Check.NatSet.member(v, id), Check.unscoped(st.seen, id), h))
      }
      | Spec.StmtScope.forLoop outer id start count body inner =>
        Scoping.blockInScope(x, visible, List.cons(id, vars), body, inner, Check.NatSet.insert(v, id), Scoping.withinInsert(v, vars, id, w), Check.declare(u, id), h)
      | Spec.StmtScope.forStride outer id start stop step body inner =>
        Scoping.blockInScope(x, visible, List.cons(id, vars), body, inner, Check.NatSet.insert(v, id), Scoping.withinInsert(v, vars, id, w), Check.declare(u, id), h)
      | Spec.StmtScope.ifYes outer c yes no inner =>
        Scoping.blockInScope(x, visible, vars, yes, inner, v, w, u, Scoping.blockAcc(v, no, Check.scopeBlock(v, yes, u), h))
      | Spec.StmtScope.ifNo outer c yes no inner => Scoping.blockInScope(x, visible, vars, no, inner, v, w, Check.scopeBlock(v, yes, u), h)
      | Spec.StmtScope.scoped outer body inner => Scoping.blockInScope(x, visible, vars, body, inner, v, w, u, h)
    }

    def blockInScope (x: Stmt)(visible: List(Nat))(vars: List(Nat))(b: Block)(occ: Spec.BlockScope(x, visible, vars, b))(v: NatSet)(w: Scoping.Within(v, vars))
        (st: Scan)(h: Fold.Empty(Check.scopeBlock(v, b, st).found)): (id: Nat) -> Spec.Uses(id, x) -> Spec.Mem(Nat, id, visible) decreases structural(b) := {
      match occ returning (id: Nat) -> Spec.Uses(id, x) -> Spec.Mem(Nat, id, visible) with
      | Spec.BlockScope.head outer s rest inner =>
        Scoping.stmtInScope(x, visible, vars, s, inner, v, w, st, Scoping.blockAcc(Check.after(v, s), rest, Check.scopeStmt(v, s, st), h))
      | Spec.BlockScope.tail outer s rest inner =>
        Scoping.blockInScope(x, visible, List.append(Spec.declaredBy(s), vars), rest, inner, Check.after(v, s), Scoping.withinAfter(v, vars, s, w),
          Check.scopeStmt(v, s, st), h)
    }
  }

  // ---- No id is declared twice --------------------------------------------------------------------------------------

  def memSplit (A: Type)(x: A)(xs: List(A))(ys: List(A))(m: Spec.Mem(A, x, List.append(xs, ys)))
      : Or(Spec.Mem(A, x, xs), Spec.Mem(A, x, ys)) decreases structural(xs) := {
    match xs returning Or(Spec.Mem(A, x, xs), Spec.Mem(A, x, ys)) with
    | List.nil => Or.inr(Spec.Mem(A, x, List.nil(A)), m)
    | List.cons z more => {
      match m returning Or(Spec.Mem(A, x, List.cons(z, more)), Spec.Mem(A, x, ys)) with
      | Spec.Mem.here rest => Or.inl(Spec.Mem(A, x, ys), Spec.Mem.here(x, more))
      | Spec.Mem.there y rest inRest => {
        match Scoping.memSplit(A, x, more, ys, inRest) returning Or(Spec.Mem(A, x, List.cons(z, more)), Spec.Mem(A, x, ys)) with
        | Or.inl inMore => Or.inl(Spec.Mem(A, x, ys), Spec.Mem.there(z, more, inMore))
        | Or.inr inYs => Or.inr(Spec.Mem(A, x, List.cons(z, more)), inYs)
      }
    }
  }

  // Two places in `xs ++ ys`: both in `xs`, both in `ys`, or one in each.
  def beforeSplit (A: Type)(x: A)(y: A)(xs: List(A))(ys: List(A))(b: Spec.Before(A, x, y, List.append(xs, ys)))
      : Or(Spec.Before(A, x, y, xs), Or(Spec.Before(A, x, y, ys), And(Spec.Mem(A, x, xs), Spec.Mem(A, y, ys)))) decreases structural(xs) := {
    let Split := fun (front: List(A)): Prop => Or(Spec.Before(A, x, y, front), Or(Spec.Before(A, x, y, ys), And(Spec.Mem(A, x, front), Spec.Mem(A, y, ys))))
    match xs returning Split(xs) with
    | List.nil => Or.inr(Spec.Before(A, x, y, List.nil(A)), Or.inl(And(Spec.Mem(A, x, List.nil(A)), Spec.Mem(A, y, ys)), b))
    | List.cons z more => {
      match b returning Split(List.cons(z, more)) with
      | Spec.Before.here rest later => {
        match Scoping.memSplit(A, y, more, ys, later) returning Split(List.cons(x, more)) with
        | Or.inl inMore => Or.inl(Or(Spec.Before(A, x, y, ys), And(Spec.Mem(A, x, List.cons(x, more)), Spec.Mem(A, y, ys))), Spec.Before.here(x, more, inMore))
        | Or.inr inYs => Or.inr(Spec.Before(A, x, y, List.cons(x, more)), Or.inr(Spec.Before(A, x, y, ys), And.intro(Spec.Mem.here(x, more), inYs)))
      }
      | Spec.Before.there w rest inRest => {
        match Scoping.beforeSplit(A, x, y, more, ys, inRest) returning Split(List.cons(z, more)) with
        | Or.inl inMore => Or.inl(Or(Spec.Before(A, x, y, ys), And(Spec.Mem(A, x, List.cons(z, more)), Spec.Mem(A, y, ys))), Spec.Before.there(z, more, inMore))
        | Or.inr rest2 => {
          match rest2 returning Split(List.cons(z, more)) with
          | Or.inl inYs => Or.inr(Spec.Before(A, x, y, List.cons(z, more)), Or.inl(And(Spec.Mem(A, x, List.cons(z, more)), Spec.Mem(A, y, ys)), inYs))
          | Or.inr across => Or.inr(Spec.Before(A, x, y, List.cons(z, more)), Or.inr(Spec.Before(A, x, y, ys),
            And.intro(Spec.Mem.there(z, more, across.left), across.right)))
        }
      }
    }
  }

  // A statement of `b`, in or after its first statement.
  def blockCases (y: Stmt)(s: Stmt)(rest: Block)(m: Spec.Mem(Stmt, y, Spec.statements(Block.seq(s, rest))))(P: Prop)
      (inFirst: Spec.Mem(Stmt, y, List.cons(s, Spec.inner(s))) -> P)(inRest: Spec.Mem(Stmt, y, Spec.statements(rest)) -> P): P := {
    match m returning P with
    | Spec.Mem.here more => inFirst(Spec.Mem.here(y, Spec.inner(y)))
    | Spec.Mem.there z more inMore => {
      match Scoping.memSplit(Stmt, y, Spec.inner(s), Spec.statements(rest), inMore) returning P with
      | Or.inl inInner => inFirst(Spec.Mem.there(s, Spec.inner(s), inInner))
      | Or.inr inLater => inRest(inLater)
    }
  }

  // A statement that declares `id` finds it fresh, and leaves it seen.
  def bindsFresh (id: Nat)(s: Stmt)(bind: Spec.Binds(id, s))(v: NatSet)(st: Scan)(h: Fold.Empty(Check.scopeStmt(v, s, st).found))
      : Eq(Bool, Check.NatSet.member(st.seen, id), Bool.false) := {
    let u := Scoping.used(v, s, st)
    let fresh := fun (e: Fold.Empty(Check.declare(u, id).found)): Eq(Bool, Check.NatSet.member(st.seen, id), Bool.false) =>
      Scoping.declaredFresh(st.seen, u.found, id, Check.NatSet.member(st.seen, id), e)
    match bind returning Eq(Bool, Check.NatSet.member(st.seen, id), Bool.false) with
    | Spec.Binds.decl t init => fresh(h)
    | Spec.Binds.declMut t init => fresh(h)
    | Spec.Binds.declOut t => fresh(h)
    | Spec.Binds.shared t size => fresh(h)
    | Spec.Binds.forLoop start count body => fresh(Scoping.blockAcc(Check.NatSet.insert(v, id), body, Check.declare(u, id), h))
    | Spec.Binds.forStride start stop step body => fresh(Scoping.blockAcc(Check.NatSet.insert(v, id), body, Check.declare(u, id), h))
  }

  def bindsSeen (id: Nat)(s: Stmt)(bind: Spec.Binds(id, s))(v: NatSet)(st: Scan)(h: Fold.Empty(Check.scopeStmt(v, s, st).found))
      : Eq(Bool, Check.NatSet.member(Check.scopeStmt(v, s, st).seen, id), Bool.true) := {
    let u := Scoping.used(v, s, st)
    let has := Scoping.declaredHas(st.seen, u.found, id, Check.NatSet.member(st.seen, id), Scoping.bindsFresh(id, s, bind, v, st, h))
    match bind returning Eq(Bool, Check.NatSet.member(Check.scopeStmt(v, s, st).seen, id), Bool.true) with
    | Spec.Binds.decl t init => has
    | Spec.Binds.declMut t init => has
    | Spec.Binds.declOut t => has
    | Spec.Binds.shared t size => has
    | Spec.Binds.forLoop start count body => Scoping.blockSeen(Check.NatSet.insert(v, id), body, Check.declare(u, id), id, has)
    | Spec.Binds.forStride start stop step body => Scoping.blockSeen(Check.NatSet.insert(v, id), body, Check.declare(u, id), id, has)
  }

  def nothingInside (y: Stmt)(m: Spec.Mem(Stmt, y, List.nil(Stmt)))(P: Prop): P := {
    match m returning P with
  }

  mutual {
    // After a statement, an id a statement in it declares is seen.
    def seenAfterStmt (y: Stmt)(s: Stmt)(m: Spec.Mem(Stmt, y, List.cons(s, Spec.inner(s))))(id: Nat)(bind: Spec.Binds(id, y))(v: NatSet)(st: Scan)
        (h: Fold.Empty(Check.scopeStmt(v, s, st).found)): Eq(Bool, Check.NatSet.member(Check.scopeStmt(v, s, st).seen, id), Bool.true) decreases structural(s) := {
      let goal := Eq(Bool, Check.NatSet.member(Check.scopeStmt(v, s, st).seen, id), Bool.true)
      let u := Scoping.used(v, s, st)
      match m returning goal with
      | Spec.Mem.here more => Scoping.bindsSeen(id, y, bind, v, st, h)
      | Spec.Mem.there z more inner => {
        match s returning goal with
        | Stmt.decl t n init => Scoping.nothingInside(y, inner, goal)
        | Stmt.declMut t n init => Scoping.nothingInside(y, inner, goal)
        | Stmt.declOut t n => Scoping.nothingInside(y, inner, goal)
        | Stmt.assign n value => Scoping.nothingInside(y, inner, goal)
        | Stmt.store base i value => Scoping.nothingInside(y, inner, goal)
        | Stmt.shared t n size => Scoping.nothingInside(y, inner, goal)
        | Stmt.forLoop n start count body => Scoping.seenAfterBlock(y, body, inner, id, bind, Check.NatSet.insert(v, n), Check.declare(u, n), h)
        | Stmt.forStride n start stop step body => Scoping.seenAfterBlock(y, body, inner, id, bind, Check.NatSet.insert(v, n), Check.declare(u, n), h)
        | Stmt.ifElse c yes no => {
          match Scoping.memSplit(Stmt, y, Spec.statements(yes), Spec.statements(no), inner) returning goal with
          | Or.inl inYes => {
            let yesOk := Scoping.blockAcc(v, no, Check.scopeBlock(v, yes, u), h)
            Scoping.blockSeen(v, no, Check.scopeBlock(v, yes, u), id, Scoping.seenAfterBlock(y, yes, inYes, id, bind, v, u, yesOk))
          }
          | Or.inr inNo => Scoping.seenAfterBlock(y, no, inNo, id, bind, v, Check.scopeBlock(v, yes, u), h)
        }
        | Stmt.scoped body => Scoping.seenAfterBlock(y, body, inner, id, bind, v, u, h)
        | Stmt.sync => Scoping.nothingInside(y, inner, goal)
        | Stmt.syncWarp => Scoping.nothingInside(y, inner, goal)
        | Stmt.instr i => Scoping.nothingInside(y, inner, goal)
        | Stmt.error message => Scoping.nothingInside(y, inner, goal)
      }
    }

    def seenAfterBlock (y: Stmt)(b: Block)(m: Spec.Mem(Stmt, y, Spec.statements(b)))(id: Nat)(bind: Spec.Binds(id, y))(v: NatSet)(st: Scan)
        (h: Fold.Empty(Check.scopeBlock(v, b, st).found)): Eq(Bool, Check.NatSet.member(Check.scopeBlock(v, b, st).seen, id), Bool.true) decreases structural(b) := {
      let goal := Eq(Bool, Check.NatSet.member(Check.scopeBlock(v, b, st).seen, id), Bool.true)
      match b returning goal with
      | Block.done => Scoping.nothingInside(y, m, goal)
      | Block.seq s rest => {
        let first := Check.scopeStmt(v, s, st)
        Scoping.blockCases(y, s, rest, m, goal,
          fun (inFirst: Spec.Mem(Stmt, y, List.cons(s, Spec.inner(s)))): goal =>
            Scoping.blockSeen(Check.after(v, s), rest, first, id,
              Scoping.seenAfterStmt(y, s, inFirst, id, bind, v, st, Scoping.blockAcc(Check.after(v, s), rest, first, h))),
          fun (inRest: Spec.Mem(Stmt, y, Spec.statements(rest))): goal =>
            Scoping.seenAfterBlock(y, rest, inRest, id, bind, Check.after(v, s), first, h))
      }
    }
  }

  mutual {
    // A statement in `s` does not declare an id seen before `s`.
    def freshStmt (y: Stmt)(s: Stmt)(m: Spec.Mem(Stmt, y, List.cons(s, Spec.inner(s))))(id: Nat)(bind: Spec.Binds(id, y))(v: NatSet)(st: Scan)
        (seen: Eq(Bool, Check.NatSet.member(st.seen, id), Bool.true))(h: Fold.Empty(Check.scopeStmt(v, s, st).found)): False decreases structural(s) := {
      let u := Scoping.used(v, s, st)
      match m returning False with
      | Spec.Mem.here more => Bool.falseNeTrue(Eq.trans(Eq.symm(Scoping.bindsFresh(id, y, bind, v, st, h)), seen))
      | Spec.Mem.there z more inner => {
        match s returning False with
        | Stmt.decl t n init => Scoping.nothingInside(y, inner, False)
        | Stmt.declMut t n init => Scoping.nothingInside(y, inner, False)
        | Stmt.declOut t n => Scoping.nothingInside(y, inner, False)
        | Stmt.assign n value => Scoping.nothingInside(y, inner, False)
        | Stmt.store base i value => Scoping.nothingInside(y, inner, False)
        | Stmt.shared t n size => Scoping.nothingInside(y, inner, False)
        | Stmt.forLoop n start count body => Scoping.freshBlock(y, body, inner, id, bind, Check.NatSet.insert(v, n), Check.declare(u, n),
          Scoping.declaredSeen(st.seen, u.found, n, Check.NatSet.member(st.seen, n), id, seen), h)
        | Stmt.forStride n start stop step body => Scoping.freshBlock(y, body, inner, id, bind, Check.NatSet.insert(v, n), Check.declare(u, n),
          Scoping.declaredSeen(st.seen, u.found, n, Check.NatSet.member(st.seen, n), id, seen), h)
        | Stmt.ifElse c yes no => {
          match Scoping.memSplit(Stmt, y, Spec.statements(yes), Spec.statements(no), inner) returning False with
          | Or.inl inYes => Scoping.freshBlock(y, yes, inYes, id, bind, v, u, seen, Scoping.blockAcc(v, no, Check.scopeBlock(v, yes, u), h))
          | Or.inr inNo => Scoping.freshBlock(y, no, inNo, id, bind, v, Check.scopeBlock(v, yes, u), Scoping.blockSeen(v, yes, u, id, seen), h)
        }
        | Stmt.scoped body => Scoping.freshBlock(y, body, inner, id, bind, v, u, seen, h)
        | Stmt.sync => Scoping.nothingInside(y, inner, False)
        | Stmt.syncWarp => Scoping.nothingInside(y, inner, False)
        | Stmt.instr i => Scoping.nothingInside(y, inner, False)
        | Stmt.error message => Scoping.nothingInside(y, inner, False)
      }
    }

    def freshBlock (y: Stmt)(b: Block)(m: Spec.Mem(Stmt, y, Spec.statements(b)))(id: Nat)(bind: Spec.Binds(id, y))(v: NatSet)(st: Scan)
        (seen: Eq(Bool, Check.NatSet.member(st.seen, id), Bool.true))(h: Fold.Empty(Check.scopeBlock(v, b, st).found)): False decreases structural(b) := {
      match b returning False with
      | Block.done => Scoping.nothingInside(y, m, False)
      | Block.seq s rest => {
        let first := Check.scopeStmt(v, s, st)
        Scoping.blockCases(y, s, rest, m, False,
          fun (inFirst: Spec.Mem(Stmt, y, List.cons(s, Spec.inner(s)))): False =>
            Scoping.freshStmt(y, s, inFirst, id, bind, v, st, seen, Scoping.blockAcc(Check.after(v, s), rest, first, h)),
          fun (inRest: Spec.Mem(Stmt, y, Spec.statements(rest))): False =>
            Scoping.freshBlock(y, rest, inRest, id, bind, Check.after(v, s), first, Scoping.stmtSeen(v, s, st, id, seen), h))
      }
    }
  }

  def nothingBefore (x: Stmt)(y: Stmt)(b: Spec.Before(Stmt, x, y, List.nil(Stmt))): False := {
    match b returning False with
  }

  mutual {
    // No two statements in `s` declare one id.
    def distinctStmt (x: Stmt)(y: Stmt)(s: Stmt)(before: Spec.Before(Stmt, x, y, List.cons(s, Spec.inner(s))))(id: Nat)(bindX: Spec.Binds(id, x))
        (bindY: Spec.Binds(id, y))(v: NatSet)(st: Scan)(h: Fold.Empty(Check.scopeStmt(v, s, st).found)): False decreases structural(s) := {
      let u := Scoping.used(v, s, st)
      match before returning False with
      | Spec.Before.here more later => {
        let fresh := Scoping.bindsFresh(id, x, bindX, v, st, h)
        let has := Scoping.declaredHas(st.seen, u.found, id, Check.NatSet.member(st.seen, id), fresh)
        match bindX returning False with
        | Spec.Binds.decl t init => Scoping.nothingInside(y, later, False)
        | Spec.Binds.declMut t init => Scoping.nothingInside(y, later, False)
        | Spec.Binds.declOut t => Scoping.nothingInside(y, later, False)
        | Spec.Binds.shared t size => Scoping.nothingInside(y, later, False)
        | Spec.Binds.forLoop start count body => Scoping.freshBlock(y, body, later, id, bindY, Check.NatSet.insert(v, id), Check.declare(u, id), has, h)
        | Spec.Binds.forStride start stop step body => Scoping.freshBlock(y, body, later, id, bindY, Check.NatSet.insert(v, id), Check.declare(u, id), has, h)
      }
      | Spec.Before.there z more inner => {
        match s returning False with
        | Stmt.decl t n init => Scoping.nothingBefore(x, y, inner)
        | Stmt.declMut t n init => Scoping.nothingBefore(x, y, inner)
        | Stmt.declOut t n => Scoping.nothingBefore(x, y, inner)
        | Stmt.assign n value => Scoping.nothingBefore(x, y, inner)
        | Stmt.store base i value => Scoping.nothingBefore(x, y, inner)
        | Stmt.shared t n size => Scoping.nothingBefore(x, y, inner)
        | Stmt.forLoop n start count body => Scoping.distinctBlock(x, y, body, inner, id, bindX, bindY, Check.NatSet.insert(v, n), Check.declare(u, n), h)
        | Stmt.forStride n start stop step body => Scoping.distinctBlock(x, y, body, inner, id, bindX, bindY, Check.NatSet.insert(v, n), Check.declare(u, n), h)
        | Stmt.ifElse c yes no => {
          let afterYes := Check.scopeBlock(v, yes, u)
          let yesOk := Scoping.blockAcc(v, no, afterYes, h)
          match Scoping.beforeSplit(Stmt, x, y, Spec.statements(yes), Spec.statements(no), inner) returning False with
          | Or.inl inYes => Scoping.distinctBlock(x, y, yes, inYes, id, bindX, bindY, v, u, yesOk)
          | Or.inr later => {
            match later returning False with
            | Or.inl inNo => Scoping.distinctBlock(x, y, no, inNo, id, bindX, bindY, v, afterYes, h)
            | Or.inr across =>
              Scoping.freshBlock(y, no, across.right, id, bindY, v, afterYes, Scoping.seenAfterBlock(x, yes, across.left, id, bindX, v, u, yesOk), h)
          }
        }
        | Stmt.scoped body => Scoping.distinctBlock(x, y, body, inner, id, bindX, bindY, v, u, h)
        | Stmt.sync => Scoping.nothingBefore(x, y, inner)
        | Stmt.syncWarp => Scoping.nothingBefore(x, y, inner)
        | Stmt.instr i => Scoping.nothingBefore(x, y, inner)
        | Stmt.error message => Scoping.nothingBefore(x, y, inner)
      }
    }

    def distinctBlock (x: Stmt)(y: Stmt)(b: Block)(before: Spec.Before(Stmt, x, y, Spec.statements(b)))(id: Nat)(bindX: Spec.Binds(id, x))
        (bindY: Spec.Binds(id, y))(v: NatSet)(st: Scan)(h: Fold.Empty(Check.scopeBlock(v, b, st).found)): False decreases structural(b) := {
      match b returning False with
      | Block.done => Scoping.nothingBefore(x, y, before)
      | Block.seq s rest => {
        let first := Check.scopeStmt(v, s, st)
        let firstOk := Scoping.blockAcc(Check.after(v, s), rest, first, h)
        let laterFresh := fun (inRest: Spec.Mem(Stmt, y, Spec.statements(rest)))(inFirst: Spec.Mem(Stmt, x, List.cons(s, Spec.inner(s)))): False =>
          Scoping.freshBlock(y, rest, inRest, id, bindY, Check.after(v, s), first, Scoping.seenAfterStmt(x, s, inFirst, id, bindX, v, st, firstOk), h)
        match before returning False with
        | Spec.Before.here more later => {
          match Scoping.memSplit(Stmt, y, Spec.inner(s), Spec.statements(rest), later) returning False with
          | Or.inl inInner => Scoping.distinctStmt(x, y, x, Spec.Before.here(x, Spec.inner(x), inInner), id, bindX, bindY, v, st, firstOk)
          | Or.inr inRest => laterFresh(inRest, Spec.Mem.here(x, Spec.inner(x)))
        }
        | Spec.Before.there z more inMore => {
          match Scoping.beforeSplit(Stmt, x, y, Spec.inner(s), Spec.statements(rest), inMore) returning False with
          | Or.inl inInner => Scoping.distinctStmt(x, y, s, Spec.Before.there(s, Spec.inner(s), inInner), id, bindX, bindY, v, st, firstOk)
          | Or.inr later => {
            match later returning False with
            | Or.inl inRest => Scoping.distinctBlock(x, y, rest, inRest, id, bindX, bindY, Check.after(v, s), first, h)
            | Or.inr across => laterFresh(across.right, Spec.Mem.there(s, Spec.inner(s), across.left))
          }
        }
      }
    }
  }

  // ---- The launcher -------------------------------------------------------------------------------------------------

  def hostKeeps (found: List(String))(x: Expr)(h: Fold.Empty(Check.hostUse(found, x))): Fold.Empty(found) := {
    match x returning Fold.Empty(found) with
    | Expr.var id => False.elim(Fold.consNotEmpty(Text.cat3("launcher: ", Cuda.name(id), " is not a host variable"), found, h), Fold.Empty(found))
    | Expr.lit value => h
    | Expr.lit64 value => h
    | Expr.zero t => h
    | Expr.param n => h
    | Expr.special b => False.elim(Fold.consNotEmpty("launcher: a thread, block or grid index is not a host value", found, h), Fold.Empty(found))
    | Expr.bin op a b => h
    | Expr.max a b => h
    | Expr.fma a b c => h
    | Expr.select c t f => h
    | Expr.index base i => False.elim(Fold.consNotEmpty("launcher: an array element is device memory, not a host value", found, h), Fold.Empty(found))
    | Expr.cast t a => h
    | Expr.sharedAddr offset => False.elim(Fold.consNotEmpty("launcher: dynamic shared memory is not host memory", found, h), Fold.Empty(found))
    | Expr.sharedPtr t offset => False.elim(Fold.consNotEmpty("launcher: dynamic shared memory is not host memory", found, h), Fold.Empty(found))
    | Expr.paramAddr n => h
  }

  def deviceOnly (x: Expr)(d: Spec.DeviceOnly(x))(h: Fold.Empty(Check.hostUse(List.nil(String), x))): False := {
    match d returning False with
    | Spec.DeviceOnly.var id => Fold.consNotEmpty(Text.cat3("launcher: ", Cuda.name(id), " is not a host variable"), List.nil(String), h)
    | Spec.DeviceOnly.special b => Fold.consNotEmpty("launcher: a thread, block or grid index is not a host value", List.nil(String), h)
    | Spec.DeviceOnly.element base i => Fold.consNotEmpty("launcher: an array element is device memory, not a host value", List.nil(String), h)
    | Spec.DeviceOnly.sharedAddr offset => Fold.consNotEmpty("launcher: dynamic shared memory is not host memory", List.nil(String), h)
    | Spec.DeviceOnly.sharedPtr t offset => Fold.consNotEmpty("launcher: dynamic shared memory is not host memory", List.nil(String), h)
  }

  // ---- The theorem --------------------------------------------------------------------------------------------------

  def sound (k: Kernel)(h: Eq(List(String), Check.scoping(k), List.nil(String))): Spec.Scoping(k) := {
    let start := Scan.mk(NatSet.empty, List.nil(String))
    let body := Check.scopeBlock(NatSet.empty, k.body, start)
    let all := Fold.inOrder(Check.hostExprs(List(String), k.launcher, body.found, Check.hostUse), h)
    let bodyOk := Fold.hostExprsAcc(k.launcher, body.found, Check.hostUse, Scoping.hostKeeps, all)
    let inScope := fun (x: Stmt)(visible: List(Nat))(occ: Spec.BlockScope(x, visible, List.nil(Nat), k.body))(id: Nat)(use: Spec.Uses(id, x))
        : Spec.Mem(Nat, id, visible) =>
      Scoping.blockInScope(x, visible, List.nil(Nat), k.body, occ, NatSet.empty, Scoping.withinEmpty, start, bodyOk)(id, use)
    let once := fun (x: Stmt)(y: Stmt)(id: Nat)(before: Spec.Before(Stmt, x, y, Spec.statements(k.body)))(bindX: Spec.Binds(id, x))(bindY: Spec.Binds(id, y)): False =>
      Scoping.distinctBlock(x, y, k.body, before, id, bindX, bindY, NatSet.empty, start, bodyOk)
    let host := fun (x: Expr)(occ: Spec.HostExpr(k, x))(d: Spec.DeviceOnly(x)): False =>
      Scoping.deviceOnly(x, d, Fold.hostExprsAt(k, x, occ, body.found, Check.hostUse, Scoping.hostKeeps, all))
    Spec.Scoping.mk(k, inScope, once, host)
  }
}
