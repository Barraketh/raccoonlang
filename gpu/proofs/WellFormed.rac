// The whole certificate: a kernel `Gpu.render` prints (`Check.WellFormed`) has no generation error and keeps I1 to I6
// as far as its AST shows them (`Spec.WellFormed`).

import proofs.Errors
import proofs.Scoping
import proofs.SharedMemory
import proofs.Barriers
import proofs.Literals
import proofs.Names
import proofs.Launcher

namespace WellFormed {
  open Cuda

  def sound (k: Kernel)(ok: Check.WellFormed(k)): Spec.WellFormed(k) := {
    match ok returning Spec.WellFormed(k) with
    | Check.Clean.mk noErrors scoped sharedOk barriersOk literalsOk namesOk launcherOk =>
      And.intro(Errors.sound(k, noErrors), And.intro(Scoping.sound(k, scoped), And.intro(SharedMemory.sound(k, sharedOk),
        And.intro(Barriers.sound(k, barriersOk), And.intro(Literals.sound(k, literalsOk), And.intro(Names.sound(k, namesOk), Launch.sound(k, launcherOk)))))))
  }
}
