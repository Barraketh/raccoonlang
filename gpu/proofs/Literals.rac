// The literal checker is sound (I4): a kernel it finds nothing in prints every 32-bit literal below 2^32 and every
// 64-bit literal below 2^64, and every instruction in range.

import proofs.Fold
import proofs.Lib

namespace Literals {
  open Cuda

  // `Nat.blt` is `Nat.lt`'s test. On two variables its definition unfolds; applied to a literal above the unfolding
  // limit it would not, so the proofs below instantiate this lemma instead of converting.
  def bltIsLt (n: Nat)(m: Nat): Eq(Bool, Nat.blt(n, m), Nat.ble(Nat.succ(n), m)) := Eq.refl(Nat.blt(n, m))

  def u32Ok (found: List(String))(what: String)(n: Nat)(h: Fold.Empty(Check.u32Printed(found, what, n))): Nat.lt(n, Cuda.u32Limit) :=
    Eq.trans(Eq.symm(Literals.bltIsLt(n, Cuda.u32Limit)),
      Fold.unlessOk(found, Nat.blt(n, Cuda.u32Limit), fun (u: Unit): String => Text.cat3(what, Text.nat(n), " does not fit 32 bits"), h))

  def u32Found (found: List(String))(what: String)(n: Nat)(h: Fold.Empty(Check.u32Printed(found, what, n))): Fold.Empty(found) :=
    Fold.unlessFound(found, Nat.blt(n, Cuda.u32Limit), fun (u: Unit): String => Text.cat3(what, Text.nat(n), " does not fit 32 bits"), h)

  def u64Ok (found: List(String))(n: Nat)(h: Fold.Empty(Check.u64Printed(found, n))): Nat.lt(n, Spec.u64Limit) :=
    Eq.trans(Eq.symm(Literals.bltIsLt(n, Check.u64Limit)),
      Fold.unlessOk(found, Nat.blt(n, Check.u64Limit), fun (u: Unit): String => Text.cat3("64-bit literal ", Text.nat(n), " does not fit 64 bits"), h))

  def u64Found (found: List(String))(n: Nat)(h: Fold.Empty(Check.u64Printed(found, n))): Fold.Empty(found) :=
    Fold.unlessFound(found, Nat.blt(n, Check.u64Limit), fun (u: Unit): String => Text.cat3("64-bit literal ", Text.nat(n), " does not fit 64 bits"), h)

  def keeps (found: List(String))(x: Expr)(h: Fold.Empty(Check.literalStep(found, x))): Fold.Empty(found) := {
    match x returning Fold.Empty(found) with
    | Expr.var id => h
    | Expr.lit value => Literals.u32Found(found, "32-bit literal ", value, h)
    | Expr.lit64 value => Literals.u64Found(found, value, h)
    | Expr.zero t => h
    | Expr.param n => h
    | Expr.special b => h
    | Expr.bin op a b => h
    | Expr.max a b => h
    | Expr.fma a b c => h
    | Expr.select c t f => h
    | Expr.index base i => h
    | Expr.cast t a => h
    | Expr.sharedAddr offset => h
    | Expr.sharedPtr t offset => h
    | Expr.paramAddr n => h
  }

  def boxKeeps (found: List(String))(m: MapEncoding)(h: Fold.Empty(Check.boxStep(found, m))): Fold.Empty(found) := {
    let width := Text.cat3("launcher: ", m.param, "'s box width ")
    Literals.u32Found(found, width, m.inner, Literals.u32Found(Check.u32Printed(found, width, m.inner), Text.cat3("launcher: ", m.param, "'s box height "), m.outer, h))
  }

  def sizesAcc (host: Option(Launcher))(found: List(String))(h: Fold.Empty(Check.launcherSizes(host, found))): Fold.Empty(found) := {
    match host returning Fold.Empty(found) with
    | Option.none => h
    | Option.some l => {
      let block := Check.u32Printed(found, "launcher: a block of ", l.block)
      Literals.u32Found(found, "launcher: a block of ", l.block, Fold.foldlAcc(MapEncoding, l.maps, block, Check.boxStep, Literals.boxKeeps, h))
    }
  }

  // What the launcher's sizes found nothing wrong with, when the kernel has launcher `l`.
  def sizesBlock (host: Option(Launcher))(l: Launcher)(launched: Eq(Option(Launcher), host, Option.some(l)))(found: List(String))
      (h: Fold.Empty(Check.launcherSizes(host, found))): Fold.Empty(Check.u32Printed(found, "launcher: a block of ", l.block)) := {
    match launched returning Fold.Empty(Check.u32Printed(found, "launcher: a block of ", l.block)) with
    | Eq.refl z => Fold.foldlAcc(MapEncoding, l.maps, Check.u32Printed(found, "launcher: a block of ", l.block), Check.boxStep, Literals.boxKeeps, h)
  }

  def sizesBox (host: Option(Launcher))(l: Launcher)(launched: Eq(Option(Launcher), host, Option.some(l)))(m: MapEncoding)
      (encoded: Spec.Mem(MapEncoding, m, l.maps))(found: List(String))(h: Fold.Empty(Check.launcherSizes(host, found)))
      : Fold.Empty(Check.boxStep(List.nil(String), m)) := {
    match launched returning Fold.Empty(Check.boxStep(List.nil(String), m)) with
    | Eq.refl z =>
      Fold.foldlAt(MapEncoding, m, l.maps, encoded, Check.u32Printed(found, "launcher: a block of ", l.block), Check.boxStep, Literals.boxKeeps, h)
  }

  // ---- Instruction ranges -------------------------------------------------------------------------------------------

  def rangeKeeps : Fold.Keeps(Stmt, Check.rangeStep) :=
    fun (found: List(String))(s: Stmt)(h: Fold.Empty(Check.rangeStep(found, s))): Fold.Empty(found) => {
      match s returning Fold.Empty(found) with
      | Stmt.instr i => Fold.unlessFound(found, Check.inRange(i), fun (u: Unit): String => Check.rangeMessage(i), h)
      | _ => h
    }

  def smemDescFits (d: SmemDesc)(h: Eq(Bool, Check.smemDescFits(d), Bool.true)): Spec.SmemDescFits(d) := {
    let rest := Lib.andRight(Nat.blt(d.lbo, 262144), Bool.and(Nat.isZero(Nat.mod(d.lbo, 16)), Nat.blt(d.step, 8192)), h)
    And.intro(Lib.bltSound(d.lbo, 262144, Lib.andLeft(Nat.blt(d.lbo, 262144), Bool.and(Nat.isZero(Nat.mod(d.lbo, 16)), Nat.blt(d.step, 8192)), h)),
      And.intro(Lib.isZeroSound(Nat.mod(d.lbo, 16), Lib.andLeft(Nat.isZero(Nat.mod(d.lbo, 16)), Nat.blt(d.step, 8192), rest)),
        Lib.bltSound(d.step, 8192, Lib.andRight(Nat.isZero(Nat.mod(d.lbo, 16)), Nat.blt(d.step, 8192), rest))))
  }

  def instrDescFits (d: InstrDesc)(h: Eq(Bool, Check.instrDescFits(d), Bool.true)): Spec.InstrDescFits(d) := {
    let mOk := Bool.and(Nat.blt(d.m, 512), Nat.isZero(Nat.mod(d.m, 16)))
    let nOk := Bool.and(Nat.blt(d.n, 512), Nat.isZero(Nat.mod(d.n, 8)))
    let m := Lib.andLeft(mOk, nOk, h)
    let n := Lib.andRight(mOk, nOk, h)
    And.intro(
      And.intro(Lib.bltSound(d.m, 512, Lib.andLeft(Nat.blt(d.m, 512), Nat.isZero(Nat.mod(d.m, 16)), m)),
        Lib.isZeroSound(Nat.mod(d.m, 16), Lib.andRight(Nat.blt(d.m, 512), Nat.isZero(Nat.mod(d.m, 16)), m))),
      And.intro(Lib.bltSound(d.n, 512, Lib.andLeft(Nat.blt(d.n, 512), Nat.isZero(Nat.mod(d.n, 8)), n)),
        Lib.isZeroSound(Nat.mod(d.n, 8), Lib.andRight(Nat.blt(d.n, 512), Nat.isZero(Nat.mod(d.n, 8)), n))))
  }

  def mmaAFits (a: MmaA)(h: Eq(Bool, Check.mmaAFits(a), Bool.true)): Spec.MmaAFits(a) := {
    match a returning Spec.MmaAFits(a) with
    | MmaA.smem desc => Literals.smemDescFits(desc, h)
    | MmaA.tmem addr => True.intro
  }

  def maskFits (multicast: Option(Nat))(h: Eq(Bool, Check.maskFits(multicast), Bool.true)): Spec.MaskFits(multicast) := {
    match multicast returning Spec.MaskFits(multicast) with
    | Option.none => True.intro
    | Option.some mask => Lib.bltSound(mask, 65536, h)
  }

  // What `Check.inRange` accepts is in range.
  def inRange (i: Instr)(h: Eq(Bool, Check.inRange(i), Bool.true)): Spec.InRange(i) := {
    match i returning Spec.InRange(i) with
    | Instr.mma g acc a b idesc accumulate => {
      let descs := Bool.and(Check.smemDescFits(b), Check.instrDescFits(idesc))
      let rest := Lib.andRight(Check.mmaAFits(a), descs, h)
      And.intro(Literals.mmaAFits(a, Lib.andLeft(Check.mmaAFits(a), descs, h)),
        And.intro(Literals.smemDescFits(b, Lib.andLeft(Check.smemDescFits(b), Check.instrDescFits(idesc), rest)),
          Literals.instrDescFits(idesc, Lib.andRight(Check.smemDescFits(b), Check.instrDescFits(idesc), rest))))
    }
    | Instr.tcCommit g bar multicast => Literals.maskFits(multicast, h)
    | Instr.tmemLoad shape dst taddr => Lib.countInSound(Check.tmemCounts, List.length(dst), h)
    | Instr.tmemStore shape w taddr values => Lib.countInSound(Check.tmemCounts, List.length(values), h)
    | Instr.shfl d a lane => Lib.bltSound(lane, 32, h)
    | Instr.setMaxNReg change count => {
      let upper := Bool.and(Nat.ble(count, 256), Nat.isZero(Nat.mod(count, 8)))
      let rest := Lib.andRight(Nat.ble(24, count), upper, h)
      And.intro(Lib.andLeft(Nat.ble(24, count), upper, h), And.intro(Lib.andLeft(Nat.ble(count, 256), Nat.isZero(Nat.mod(count, 8)), rest),
        Lib.isZeroSound(Nat.mod(count, 8), Lib.andRight(Nat.ble(count, 256), Nat.isZero(Nat.mod(count, 8)), rest))))
    }
    | Instr.movF32 d bits => Lib.bltSound(bits, Cuda.u32Limit, h)
    | Instr.stShared addr values => Lib.countInSound(List.cons(2, List.cons(4, List.nil(Nat))), List.length(values), h)
    | _ => True.intro
  }

  def sound (k: Kernel)(h: Eq(List(String), Check.literals(k), List.nil(String))): Spec.Literals(k) := {
    let ranges := Check.blockFold(List(String), k.body, List.nil(String), Check.rangeStep)
    let body := Check.blockExprs(List(String), k.body, ranges, Check.literalStep)
    let exprs := Check.hostExprs(List(String), k.launcher, body, Check.literalStep)
    let sizes := Fold.inOrder(Check.launcherSizes(k.launcher, exprs), h)
    let exprsOk := Literals.sizesAcc(k.launcher, exprs, sizes)
    let bodyOk := Fold.hostExprsAcc(k.launcher, body, Check.literalStep, Literals.keeps, exprsOk)
    let u32 := fun (n: Nat)(occ: Spec.Lit32(k, n)): Nat.lt(n, Cuda.u32Limit) => {
      match occ returning Nat.lt(n, Cuda.u32Limit) with
      | Spec.Lit32.body inBody =>
        Literals.u32Ok(List.nil(String), "32-bit literal ", n,
          Fold.blockExprsAt(Expr.lit(n), k.body, inBody, ranges, Check.literalStep, Literals.keeps, bodyOk))
      | Spec.Lit32.host inHost =>
        Literals.u32Ok(List.nil(String), "32-bit literal ", n, Fold.hostExprsAt(k, Expr.lit(n), inHost, body, Check.literalStep, Literals.keeps, exprsOk))
      | Spec.Lit32.block l launched size => {
        match size returning Nat.lt(n, Cuda.u32Limit) with
        | Eq.refl z => Literals.u32Ok(exprs, "launcher: a block of ", l.block, Literals.sizesBlock(k.launcher, l, launched, exprs, sizes))
      }
      | Spec.Lit32.boxInner l launched m encoded size => {
        let width := Text.cat3("launcher: ", m.param, "'s box width ")
        let box := Literals.sizesBox(k.launcher, l, launched, m, encoded, exprs, sizes)
        let inner := Literals.u32Found(Check.u32Printed(List.nil(String), width, m.inner), Text.cat3("launcher: ", m.param, "'s box height "), m.outer, box)
        match size returning Nat.lt(n, Cuda.u32Limit) with
        | Eq.refl z => Literals.u32Ok(List.nil(String), width, m.inner, inner)
      }
      | Spec.Lit32.boxOuter l launched m encoded size => {
        let width := Text.cat3("launcher: ", m.param, "'s box width ")
        let box := Literals.sizesBox(k.launcher, l, launched, m, encoded, exprs, sizes)
        match size returning Nat.lt(n, Cuda.u32Limit) with
        | Eq.refl z => Literals.u32Ok(Check.u32Printed(List.nil(String), width, m.inner), Text.cat3("launcher: ", m.param, "'s box height "), m.outer, box)
      }
    }
    let u64 := fun (n: Nat)(occ: Spec.Lit64(k, n)): Nat.lt(n, Spec.u64Limit) => {
      match occ returning Nat.lt(n, Spec.u64Limit) with
      | Spec.Lit64.body inBody =>
        Literals.u64Ok(List.nil(String), n, Fold.blockExprsAt(Expr.lit64(n), k.body, inBody, ranges, Check.literalStep, Literals.keeps, bodyOk))
      | Spec.Lit64.host inHost =>
        Literals.u64Ok(List.nil(String), n, Fold.hostExprsAt(k, Expr.lit64(n), inHost, body, Check.literalStep, Literals.keeps, exprsOk))
    }
    let rangesOk := Fold.blockExprsAcc(k.body, ranges, Check.literalStep, Literals.keeps, bodyOk)
    let inRange := fun (i: Instr)(occ: Spec.InBlock(Stmt.instr(i), k.body)): Spec.InRange(i) => {
      let at := Fold.blockFoldAt(Stmt.instr(i), k.body, occ, List.nil(String), Check.rangeStep, Literals.rangeKeeps, rangesOk)
      Literals.inRange(i, Fold.unlessOk(List.nil(String), Check.inRange(i), fun (u: Unit): String => Check.rangeMessage(i), at))
    }
    Spec.Literals.mk(k, u32, u64, inRange)
  }
}
