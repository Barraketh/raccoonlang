// The name checker is sound (I5): a kernel it finds nothing in has a chosen name, its parameters' and its launcher's
// names are chosen, none the kernel's and none declared twice in its function, and each function's expressions name
// only its parameters.

import proofs.Fold
import proofs.Lib

namespace Names {
  open Cuda

  // The checker's messages, which the lemmas below must restate to name the lists they reason about.
  def identMessage (what: String)(name: String): Unit -> String := fun (u: Unit): String => Text.cat3(what, name, " is not a C identifier")

  def printerMessage (what: String)(name: String): Unit -> String := fun (u: Unit): String => Text.cat3(what, name, " is a name the printer declares")

  def kernelMessage (what: String)(name: String): Unit -> String := fun (u: Unit): String => Text.cat3(what, name, " is the kernel's name")

  def twiceMessage (what: String)(name: String): Unit -> String := fun (u: Unit): String => Text.cat3(what, name, " is declared twice")

  def useMessage (what: String)(name: String): Unit -> String := fun (u: Unit): String => Text.cat3(what, name, " is not a parameter")

  // ---- Characters and identifiers -----------------------------------------------------------------------------------

  def identStartSound (c: Char)(h: Eq(Bool, Check.identStart(c), Bool.true)): Spec.IdentStart(c) := {
    let v := c.value
    let upper := Bool.and(Nat.ble(65, v), Nat.ble(v, 90))
    let lower := Bool.and(Nat.ble(97, v), Nat.ble(v, 122))
    let letterOrUnderscore := Or(And(Nat.le(97, v), Nat.le(v, 122)), Eq(Nat, v, 95))
    match Lib.orCases(upper, Bool.or(lower, Nat.beq(v, 95)), h) returning Spec.IdentStart(c) with
    | Or.inl isUpper =>
      Or.inl(letterOrUnderscore, And.intro(Lib.andLeft(Nat.ble(65, v), Nat.ble(v, 90), isUpper), Lib.andRight(Nat.ble(65, v), Nat.ble(v, 90), isUpper)))
    | Or.inr rest => {
      match Lib.orCases(lower, Nat.beq(v, 95), rest) returning Spec.IdentStart(c) with
      | Or.inl isLower => Or.inr(And(Nat.le(65, v), Nat.le(v, 90)), Or.inl(Eq(Nat, v, 95),
        And.intro(Lib.andLeft(Nat.ble(97, v), Nat.ble(v, 122), isLower), Lib.andRight(Nat.ble(97, v), Nat.ble(v, 122), isLower))))
      | Or.inr isUnderscore => Or.inr(And(Nat.le(65, v), Nat.le(v, 90)), Or.inr(And(Nat.le(97, v), Nat.le(v, 122)), Lib.beqSound(v, 95, isUnderscore)))
    }
  }

  def digitSound (c: Char)(h: Eq(Bool, Check.isDigit(c), Bool.true)): Spec.Digit(c) :=
    And.intro(Lib.andLeft(Nat.ble(48, c.value), Nat.ble(c.value, 57), h), Lib.andRight(Nat.ble(48, c.value), Nat.ble(c.value, 57), h))

  def digitComplete (c: Char)(d: Spec.Digit(c)): Eq(Bool, Check.isDigit(c), Bool.true) := {
    match d returning Eq(Bool, Check.isDigit(c), Bool.true) with
    | And.intro low high => Lib.andIntro(Nat.ble(48, c.value), Nat.ble(c.value, 57), low, high)
  }

  def identRestSound (c: Char)(h: Eq(Bool, Check.identRest(c), Bool.true)): Or(Spec.IdentStart(c), Spec.Digit(c)) := {
    match Lib.orCases(Check.identStart(c), Check.isDigit(c), h) returning Or(Spec.IdentStart(c), Spec.Digit(c)) with
    | Or.inl start => Or.inl(Spec.Digit(c), Names.identStartSound(c, start))
    | Or.inr digit => Or.inr(Spec.IdentStart(c), Names.digitSound(c, digit))
  }

  def isIdentSound (name: String)(h: Eq(Bool, Check.isIdent(name), Bool.true)): Spec.CIdent(name) := {
    match name.data returning Spec.CIdent(name) with
    | List.nil => False.elim(Bool.falseNeTrue(h), Spec.CIdent(name))
    | List.cons c more => {
      let continued := fun (d: Char)(m: Spec.Mem(Char, d, more)): Or(Spec.IdentStart(d), Spec.Digit(d)) =>
        Names.identRestSound(d, Lib.allMem(Char, more, Check.identRest, Lib.andRight(Check.identStart(c), List.all(more, Check.identRest), h), d, m))
      let start := Names.identStartSound(c, Lib.andLeft(Check.identStart(c), List.all(more, Check.identRest), h))
      Spec.CIdent.mk(name, c, more, Eq.refl(List.cons(c, more)), start, continued)
    }
  }

  // `Check.printerName` finds every name the printer declares.
  def printerNameComplete (name: String)(p: Spec.PrinterName(name)): Eq(Bool, Check.printerName(name), Bool.true) := {
    let others := Bool.or(Check.startsWith(name.data, "gpu_".data), Check.mentions(Check.printerLocals, name))
    match p returning Eq(Bool, Check.printerName(name), Bool.true) with
    | Spec.PrinterName.variable d ds spelled digits => {
      match spelled returning Eq(Bool, Check.printerName(name), Bool.true) with
      | Eq.refl z => {
        let each := fun (e: Char)(m: Spec.Mem(Char, e, List.cons(d, ds))): Eq(Bool, Check.isDigit(e), Bool.true) => Names.digitComplete(e, digits(e, m))
        let allDigits := Lib.allIntro(Char, List.cons(d, ds), Check.isDigit, each)
        Lib.orLeft(Check.variableName(name.data), others, allDigits)
      }
    }
    | Spec.PrinterName.prefixed rest spelled => {
      match spelled returning Eq(Bool, Check.printerName(name), Bool.true) with
      | Eq.refl z => Lib.orRight(Check.variableName(name.data), others,
        Lib.orLeft(Check.startsWith(name.data, "gpu_".data), Check.mentions(Check.printerLocals, name), Eq.refl(Bool.true)))
    }
    | Spec.PrinterName.local m => Lib.orRight(Check.variableName(name.data), others,
      Lib.orRight(Check.startsWith(name.data, "gpu_".data), Check.mentions(Check.printerLocals, name), Lib.mentionsComplete(Check.printerLocals, name, m)))
  }

  def notPrinter (name: String)(h: Eq(Bool, Bool.not(Check.printerName(name)), Bool.true)): Not(Spec.PrinterName(name)) :=
    fun (p: Spec.PrinterName(name)): False => Lib.notBoth(Check.printerName(name), h, Names.printerNameComplete(name, p))

  // ---- Chosen names -------------------------------------------------------------------------------------------------

  def chosenAcc (found: List(String))(kernel: String)(what: String)(name: String)(h: Fold.Empty(Check.chosenName(found, kernel, what, name)))
      : Fold.Empty(found) := {
    let ident := Check.unless(found, Check.isIdent(name), Names.identMessage(what, name))
    let own := Check.unless(ident, Bool.not(Check.printerName(name)), Names.printerMessage(what, name))
    let ownOk := Fold.unlessFound(own, Bool.not(Check.same(name, kernel)), Names.kernelMessage(what, name), h)
    Fold.unlessFound(found, Check.isIdent(name), Names.identMessage(what, name),
      Fold.unlessFound(ident, Bool.not(Check.printerName(name)), Names.printerMessage(what, name), ownOk))
  }

  // What `Check.chosenName` finding nothing means.
  def chosen (found: List(String))(kernel: String)(what: String)(name: String)(h: Fold.Empty(Check.chosenName(found, kernel, what, name)))
      : And(Spec.Chosen(name), Not(Eq(String, name, kernel))) := {
    let ident := Check.unless(found, Check.isIdent(name), Names.identMessage(what, name))
    let own := Check.unless(ident, Bool.not(Check.printerName(name)), Names.printerMessage(what, name))
    let ownOk := Fold.unlessFound(own, Bool.not(Check.same(name, kernel)), Names.kernelMessage(what, name), h)
    let identOk := Fold.unlessFound(ident, Bool.not(Check.printerName(name)), Names.printerMessage(what, name), ownOk)
    let isIdent := Names.isIdentSound(name, Fold.unlessOk(found, Check.isIdent(name), Names.identMessage(what, name), identOk))
    let notPrinter := Names.notPrinter(name, Fold.unlessOk(ident, Bool.not(Check.printerName(name)), Names.printerMessage(what, name), ownOk))
    And.intro(Spec.Chosen.mk(isIdent, notPrinter), Lib.notSame(name, kernel, Fold.unlessOk(own, Bool.not(Check.same(name, kernel)), Names.kernelMessage(what, name), h)))
  }

  // ---- Declared names -----------------------------------------------------------------------------------------------

  def declaredAcc (found: List(String))(kernel: String)(what: String)(before: List(String))(names: List(String))
      (h: Fold.Empty(Check.declaredAfter(found, kernel, what, before, names))): Fold.Empty(found) decreases structural(names) := {
    match names returning Fold.Empty(found) with
    | List.nil => h
    | List.cons name more => {
      let chosen := Check.chosenName(found, kernel, what, name)
      let once := Check.unless(chosen, Bool.not(Check.mentions(before, name)), Names.twiceMessage(what, name))
      let onceOk := Names.declaredAcc(once, kernel, what, List.cons(name, before), more, h)
      Names.chosenAcc(found, kernel, what, name, Fold.unlessFound(chosen, Bool.not(Check.mentions(before, name)), Names.twiceMessage(what, name), onceOk))
    }
  }

  // Each declared name is chosen, and not the kernel's.
  def declaredChosen (n: String)(names: List(String))(mem: Spec.Mem(String, n, names))(found: List(String))(kernel: String)(what: String)
      (before: List(String))(h: Fold.Empty(Check.declaredAfter(found, kernel, what, before, names)))
      : And(Spec.Chosen(n), Not(Eq(String, n, kernel))) decreases structural(names) := {
    match mem returning And(Spec.Chosen(n), Not(Eq(String, n, kernel))) with
    | Spec.Mem.here more => {
      let chosen := Check.chosenName(found, kernel, what, n)
      let once := Check.unless(chosen, Bool.not(Check.mentions(before, n)), Names.twiceMessage(what, n))
      let onceOk := Names.declaredAcc(once, kernel, what, List.cons(n, before), more, h)
      Names.chosen(found, kernel, what, n, Fold.unlessFound(chosen, Bool.not(Check.mentions(before, n)), Names.twiceMessage(what, n), onceOk))
    }
    | Spec.Mem.there name more inMore => {
      let once := Check.unless(Check.chosenName(found, kernel, what, name), Bool.not(Check.mentions(before, name)), Names.twiceMessage(what, name))
      Names.declaredChosen(n, more, inMore, once, kernel, what, List.cons(name, before), h)
    }
  }

  // A name declared before `names` is not among them.
  def declaredFresh (n: String)(names: List(String))(inNames: Spec.Mem(String, n, names))(found: List(String))(kernel: String)(what: String)
      (before: List(String))(inBefore: Spec.Mem(String, n, before))(h: Fold.Empty(Check.declaredAfter(found, kernel, what, before, names)))
      : False decreases structural(names) := {
    match inNames returning False with
    | Spec.Mem.here more => {
      let chosen := Check.chosenName(found, kernel, what, n)
      let once := Check.unless(chosen, Bool.not(Check.mentions(before, n)), Names.twiceMessage(what, n))
      let fresh := Fold.unlessOk(chosen, Bool.not(Check.mentions(before, n)), Names.twiceMessage(what, n),
        Names.declaredAcc(once, kernel, what, List.cons(n, before), more, h))
      Lib.notBoth(Check.mentions(before, n), fresh, Lib.mentionsComplete(before, n, inBefore))
    }
    | Spec.Mem.there name more inMore => {
      let once := Check.unless(Check.chosenName(found, kernel, what, name), Bool.not(Check.mentions(before, name)), Names.twiceMessage(what, name))
      Names.declaredFresh(n, more, inMore, once, kernel, what, List.cons(name, before), Spec.Mem.there(name, before, inBefore), h)
    }
  }

  def declaredOnce (n: String)(names: List(String))(twice: Spec.Twice(String, n, names))(found: List(String))(kernel: String)(what: String)
      (before: List(String))(h: Fold.Empty(Check.declaredAfter(found, kernel, what, before, names))): False decreases structural(names) := {
    match twice returning False with
    | Spec.Twice.here more again => {
      let once := Check.unless(Check.chosenName(found, kernel, what, n), Bool.not(Check.mentions(before, n)), Names.twiceMessage(what, n))
      Names.declaredFresh(n, more, again, once, kernel, what, List.cons(n, before), Spec.Mem.here(n, before), h)
    }
    | Spec.Twice.there name more inMore => {
      let once := Check.unless(Check.chosenName(found, kernel, what, name), Bool.not(Check.mentions(before, name)), Names.twiceMessage(what, name))
      Names.declaredOnce(n, more, inMore, once, kernel, what, List.cons(name, before), h)
    }
  }

  // What `Check.declaredNames` finding nothing means.
  def declared (found: List(String))(kernel: String)(what: String)(names: List(String))(h: Fold.Empty(Check.declaredNames(found, kernel, what, names)))
      : Spec.Declared(kernel, names) := {
    let chosen := fun (n: String)(m: Spec.Mem(String, n, names)): Spec.Chosen(n) =>
      Names.declaredChosen(n, names, m, found, kernel, what, List.nil(String), h).left
    let notKernel := fun (n: String)(m: Spec.Mem(String, n, names)): Not(Eq(String, n, kernel)) =>
      Names.declaredChosen(n, names, m, found, kernel, what, List.nil(String), h).right
    let once := fun (n: String): Not(Spec.Twice(String, n, names)) =>
      fun (twice: Spec.Twice(String, n, names)): False => Names.declaredOnce(n, names, twice, found, kernel, what, List.nil(String), h)
    Spec.Declared.mk(kernel, names, chosen, notKernel, once)
  }

  // ---- Parameters named in expressions ------------------------------------------------------------------------------

  def usesKeeps (declared: List(String))(what: String): Fold.Keeps(Expr, Check.paramUses(declared, what)) :=
    fun (found: List(String))(x: Expr)(h: Fold.Empty(Check.paramUses(declared, what)(found, x))): Fold.Empty(found) => {
      match x returning Fold.Empty(found) with
      | Expr.var id => h
      | Expr.lit value => h
      | Expr.lit64 value => h
      | Expr.zero t => h
      | Expr.param n => Fold.unlessFound(found, Check.mentions(declared, n), Names.useMessage(what, n), h)
      | Expr.special b => h
      | Expr.bin op a b => h
      | Expr.max a b => h
      | Expr.fma a b c => h
      | Expr.select c t f => h
      | Expr.index base i => h
      | Expr.cast t a => h
      | Expr.sharedAddr offset => h
      | Expr.sharedPtr t offset => h
      | Expr.paramAddr n => Fold.unlessFound(found, Check.mentions(declared, n), Names.useMessage(what, n), h)
    }

  // A parameter a use step found nothing wrong with is declared.
  def useDeclared (declared: List(String))(what: String)(n: String)
      (h: Fold.Empty(Check.unless(List.nil(String), Check.mentions(declared, n), Names.useMessage(what, n))))
      : Spec.Mem(String, n, declared) :=
    Lib.mentionsSound(declared, n, Fold.unlessOk(List.nil(String), Check.mentions(declared, n), Names.useMessage(what, n), h))

  // ---- The launcher -------------------------------------------------------------------------------------------------

  def launcherAcc (host: Option(Launcher))(kernel: String)(found: List(String))(h: Fold.Empty(Check.launcherNames(host, kernel, found))): Fold.Empty(found) := {
    match host returning Fold.Empty(found) with
    | Option.none => h
    | Option.some l => {
      let hostParams := Spec.paramNames(l.params)
      let hostNames := List.append(hostParams, Spec.mapNames(l.maps))
      let declaredOk := Fold.hostExprsAcc(Option.some(l), Check.declaredNames(found, kernel, "launcher: name ", hostNames), Check.paramUses(hostParams, "launcher: "),
        Names.usesKeeps(hostParams, "launcher: "), h)
      Names.declaredAcc(found, kernel, "launcher: name ", List.nil(String), hostNames, declaredOk)
    }
  }

  def launcher (host: Option(Launcher))(l: Launcher)(launched: Eq(Option(Launcher), host, Option.some(l)))(kernel: String)(found: List(String))
      (h: Fold.Empty(Check.launcherNames(host, kernel, found))): Spec.LauncherNames(kernel, l) := {
    let hostParams := Spec.paramNames(l.params)
    let hostNames := List.append(hostParams, Spec.mapNames(l.maps))
    let names := Check.declaredNames(found, kernel, "launcher: name ", hostNames)
    let uses := Check.paramUses(hostParams, "launcher: ")
    match launched returning Spec.LauncherNames(kernel, l) with
    | Eq.refl z => {
      let namesOk := Fold.hostExprsAcc(Option.some(l), names, uses, Names.usesKeeps(hostParams, "launcher: "), h)
      let declared := Names.declared(found, kernel, "launcher: name ", hostNames, namesOk)
      let value := fun (n: String)(occ: Spec.LauncherExpr(l, Expr.param(n))): Spec.Mem(String, n, hostParams) =>
        Names.useDeclared(hostParams, "launcher: ", n, Fold.launcherExprsAt(l, Expr.param(n), occ, names, uses, Names.usesKeeps(hostParams, "launcher: "), h))
      let address := fun (n: String)(occ: Spec.LauncherExpr(l, Expr.paramAddr(n))): Spec.Mem(String, n, hostParams) =>
        Names.useDeclared(hostParams, "launcher: ", n, Fold.launcherExprsAt(l, Expr.paramAddr(n), occ, names, uses, Names.usesKeeps(hostParams, "launcher: "), h))
      Spec.LauncherNames.mk(l, declared, value, address)
    }
  }

  // ---- The theorem --------------------------------------------------------------------------------------------------

  def sound (k: Kernel)(h: Eq(List(String), Check.names(k), List.nil(String))): Spec.Names(k) := {
    let name := k.name
    let ident := Check.unless(List.nil(String), Check.isIdent(name), Names.identMessage("kernel name ", name))
    let kernelName := Check.unless(ident, Bool.not(Check.printerName(name)), Names.printerMessage("kernel name ", name))
    let params := Spec.paramNames(k.params)
    let declared := Check.declaredNames(kernelName, name, "parameter ", params)
    let uses := Check.paramUses(params, "kernel: ")
    let used := Check.blockExprs(List(String), k.body, declared, uses)
    let all := Fold.inOrder(Check.launcherNames(k.launcher, name, used), h)
    let usedOk := Names.launcherAcc(k.launcher, name, used, all)
    let declaredOk := Fold.blockExprsAcc(k.body, declared, uses, Names.usesKeeps(params, "kernel: "), usedOk)
    let kernelNameOk := Names.declaredAcc(kernelName, name, "parameter ", List.nil(String), params, declaredOk)
    let identOk := Fold.unlessFound(ident, Bool.not(Check.printerName(name)), Names.printerMessage("kernel name ", name), kernelNameOk)
    let chosen := Spec.Chosen.mk(Names.isIdentSound(name, Fold.unlessOk(List.nil(String), Check.isIdent(name), Names.identMessage("kernel name ", name), identOk)),
      Names.notPrinter(name, Fold.unlessOk(ident, Bool.not(Check.printerName(name)), Names.printerMessage("kernel name ", name), kernelNameOk)))
    let value := fun (n: String)(occ: Spec.ExprIn(Expr.param(n), k.body)): Spec.Mem(String, n, params) =>
      Names.useDeclared(params, "kernel: ", n, Fold.blockExprsAt(Expr.param(n), k.body, occ, declared, uses, Names.usesKeeps(params, "kernel: "), usedOk))
    let address := fun (n: String)(occ: Spec.ExprIn(Expr.paramAddr(n), k.body)): Spec.Mem(String, n, params) =>
      Names.useDeclared(params, "kernel: ", n, Fold.blockExprsAt(Expr.paramAddr(n), k.body, occ, declared, uses, Names.usesKeeps(params, "kernel: "), usedOk))
    let launcher := fun (l: Launcher)(launched: Eq(Option(Launcher), k.launcher, Option.some(l))): Spec.LauncherNames(name, l) =>
      Names.launcher(k.launcher, l, launched, name, used, all)
    Spec.Names.mk(k, chosen, Names.declared(kernelName, name, "parameter ", params, declaredOk), value, address, launcher)
  }
}
