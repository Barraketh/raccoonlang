// A small CUDA C++ AST and its printer. It knows nothing about safety: the cores (`gpu/Gpu.rac` and
// `gpu/encoding/Core.rac`) are the only producers of kernels, and this file only renders what it is given.

import Text

namespace Cuda {
  inductive DType : Type
   | u32 : DType
   | u64 : DType
   | f32 : DType
   | bf16 : DType
   | bool : DType

  // Every value of a `u32` is below it.
  def u32Limit : Nat := 4294967296

  inductive Builtin : Type
   | threadX : Builtin
   | blockX : Builtin
   | blockY : Builtin
   | gridX : Builtin
   | warp : Builtin
   | lane : Builtin

  inductive BinOp : Type
   | add : BinOp
   | sub : BinOp
   | mul : BinOp
   | div : BinOp
   | rem : BinOp
   | lt : BinOp
   | eq : BinOp
   | land : BinOp
   | shl : BinOp
   | shr : BinOp
   | bor : BinOp
   | band : BinOp
   | bxor : BinOp

  inductive Expr : Type
   | var (id: Nat) : Expr
   | lit (value: Nat) : Expr
   | lit64 (value: Nat) : Expr
   | zero (t: DType) : Expr
   | param (name: String) : Expr
   | special (b: Builtin) : Expr
   | bin (op: BinOp)(a: Expr)(b: Expr) : Expr
   | max (a: Expr)(b: Expr) : Expr
   | fma (a: Expr)(b: Expr)(c: Expr) : Expr
   | select (c: Expr)(t: Expr)(f: Expr) : Expr
   | index (base: Expr)(i: Expr) : Expr
   | cast (t: DType)(e: Expr) : Expr
   | sharedAddr (offset: Nat) : Expr
   | sharedPtr (t: DType)(offset: Nat) : Expr
   | paramAddr (name: String) : Expr

  // An inline-assembly operand: its constraint, such as "r", "l" or "=f", and its expression.
  struct Operand : Type
   | mk (constraint: String)(e: Expr) : Operand

  // ---- PTX instructions --------------------------------------------------------------------------------------------
  //
  // The PTX instructions gpu/encoding's core emits (`Instr`): operands are expressions, a result is the variable it
  // writes, and qualifiers are fields. Each prints as one inline-assembly statement (`Cuda.asmOf`). Sections are of
  // the PTX ISA 9.4.

  // How many CTAs a tensor-core instruction spans (`.cta_group`): one CTA, or a CTA pair.
  inductive CtaGroup : Type
   | one : CtaGroup
   | two : CtaGroup

  // The threads an mbarrier operation synchronizes with directly (its `.scope`, §9.7.15.16): the CTA's, the default,
  // or the cluster's.
  inductive BarrierScope : Type
   | cta : BarrierScope
   | cluster : BarrierScope

  // A memory operation's scope (§8.5).
  inductive Scope : Type
   | cta : Scope
   | cluster : Scope
   | gpu : Scope

  // The shared-memory window an address is in: this CTA's (`.shared::cta`), or the cluster's (`.shared::cluster`),
  // where it may name a peer CTA's shared memory.
  inductive Window : Type
   | cta : Window
   | cluster : Window

  // What an mbarrier arrival does (§9.7.15.16.16): one arrival; `n` arrivals at once; or an expect-tx operation of
  // `bytes`, then one arrival (`.expect_tx`).
  inductive Arrival : Type
   | one : Arrival
   | count (n: Expr) : Arrival
   | expectTx (bytes: Expr) : Arrival

  // Which side of a thread synchronization a `tcgen05.fence` orders this thread's tensor-core operations on
  // (§9.7.18.11.1).
  inductive ThreadSync : Type
   | before : ThreadSync
   | after : ThreadSync

  // What `cp.async.bulk.wait_group` waits for (§9.7.10.28.6.2): the reads of the bulk groups' sources (`.read`), or
  // their completion.
  inductive BulkWait : Type
   | read : BulkWait
   | complete : BulkWait

  // What `tcgen05.wait` waits for (§9.7.18.8.5): this thread's `tcgen05.ld`s, or its `tcgen05.st`s.
  inductive TmemWait : Type
   | load : TmemWait
   | store : TmemWait

  // A tensor-memory load's or store's shape (§9.7.18.8.3): `.32x32b`, each thread of the warp one lane of 32-bit
  // columns.
  inductive TmemShape : Type
   | s32x32b : TmemShape

  // The C type of a 32-bit register operand.
  inductive Word : Type
   | u32 : Word
   | f32 : Word

  // An IEEE rounding mode (§6.5.2): to nearest even, toward zero, toward −∞, toward +∞.
  inductive Rounding : Type
   | rn : Rounding
   | rz : Rounding
   | rm : Rounding
   | rp : Rounding

  // Which way a `setmaxnreg` moves a thread's register count (§9.7.21.5).
  inductive RegChange : Type
   | inc : RegChange
   | dec : RegChange

  // A special register (§10.16, §10.12, §10.13): `%cluster_ctarank`, `%clusterid.x`, `%nclusterid.x`.
  inductive SpecialReg : Type
   | clusterCtaRank : SpecialReg
   | clusterIdX : SpecialReg
   | nclusterIdX : SpecialReg

  // A shared-memory matrix descriptor (§9.7.18.4.1, Table 49) for a 128-byte-swizzled bf16 box at shared-window
  // address `base`, advanced by `step` steps of sixteen K-major elements (32 bytes): its leading byte offset is `lbo`, its
  // stride byte offset 1024, its version 1 and its swizzle mode 128 bytes. A K-major box has no leading byte offset
  // (0); an MN-major operand's is the distance between its 64-element halves of M or N. `base` is a run-time value, so
  // the descriptor is packed at run time, by the expression `Cuda.packSmemDesc` builds.
  struct SmemDesc : Type
   | mk (base: Expr)(lbo: Nat)(step: Nat) : SmemDesc

  // An MMA's instruction descriptor (§9.7.18.4.2, Table 51) for f32 += bf16 · bf16 of shape `m` × `n`, A K-major, and
  // B K-major or, with `transposeB`, MN-major. It is packed at generation (`Cuda.packInstrDesc`).
  struct InstrDesc : Type
   | mk (m: Nat)(n: Nat)(transposeB: Bool) : InstrDesc

  // An MMA's A operand: a shared-memory descriptor, or tensor memory at an address (§9.7.18.10.10.1).
  inductive MmaA : Type
   | smem (desc: SmemDesc) : MmaA
   | tmem (addr: Expr) : MmaA

  // A PTX instruction. A result is the fresh variable `d` it writes, which a declaration before it declares. Some
  // print as a short PTX block of their own, named by their constructor: `mbarWait` spins on `mbarrier.try_wait`,
  // `mma` sets its predicate, `elect` writes its flag, `ex2Emulated` is a sequence of f32 instructions.
  inductive Instr : Type
    // Named barrier `id`, for `threads` threads (`bar.sync`, §9.7.15.1).
   | barSync (id: Expr)(threads: Expr) : Instr
    // The mbarrier at `bar` (§9.7.15.16): initialized for `count` arrivals; invalidated; arrived on, at `bar` in
    // `window`, releasing at `level`; waited for until its phase of parity `parity` completes, acquiring at `level`.
   | mbarInit (bar: Expr)(count: Expr) : Instr
   | mbarInval (bar: Expr) : Instr
   | mbarArrive (level: BarrierScope)(window: Window)(bar: Expr)(arrival: Arrival) : Instr
   | mbarWait (level: BarrierScope)(bar: Expr)(parity: Expr) : Instr
    // Fences (§9.7.15.4): mbarrier initializations, released at cluster scope; this thread's generic-proxy writes to
    // shared memory, before the async proxy's accesses; tensor-core operations, on `side` of a thread
    // synchronization (§9.7.18.11.1).
   | fenceMbarInit : Instr
   | fenceProxyAsync : Instr
   | tcFence (side: ThreadSync) : Instr
    // The cluster barrier's arrive, releasing, and wait, acquiring (`barrier.cluster`, §9.7.15.3).
   | clusterArrive : Instr
   | clusterWait : Instr
    // A 2-D box of the tensor map at generic address `map`, at coordinates (`x`, `y`): loaded to shared address `dst`,
    // completing on the mbarrier at `bar` (§9.7.10.28.5.3); stored from shared address `src` in a bulk group.
   | tmaLoad (group: CtaGroup)(dst: Expr)(map: Expr)(x: Expr)(y: Expr)(bar: Expr) : Instr
   | tmaStore (map: Expr)(x: Expr)(y: Expr)(src: Expr) : Instr
    // Closes this thread's bulk group; waits until at most `pending` of its bulk groups have not finished `what`
    // (§9.7.10.28.6).
   | bulkCommit : Instr
   | bulkWait (what: BulkWait)(pending: Nat) : Instr
    // Tensor memory (§9.7.18.7.1): `cols` columns allocated, their address written to shared address `slot`; the right
    // to allocate given up; `cols` columns at `taddr` freed.
   | tmemAlloc (group: CtaGroup)(slot: Expr)(cols: Expr) : Instr
   | tmemRelinquish (group: CtaGroup) : Instr
   | tmemDealloc (group: CtaGroup)(taddr: Expr)(cols: Expr) : Instr
    // D (in tensor memory at `d`) = A·B, plus D when `accumulate` is not 0, of kind f16 (§9.7.18.10.10.1): the types
    // are `idesc`'s.
   | mma (group: CtaGroup)(d: Expr)(a: MmaA)(b: SmemDesc)(idesc: InstrDesc)(accumulate: Expr) : Instr
    // One arrival on the mbarrier at `bar` once this thread's tensor-core operations complete; with `multicast`, at
    // `bar`'s offset in each CTA of that CTA mask (§9.7.18.12.1).
   | commit (group: CtaGroup)(bar: Expr)(multicast: Option(Nat)) : Instr
    // Columns of this thread's lane at `taddr`: loaded, one per f32 variable of `dst`; stored, one per value of
    // `values`; and the wait for them (§9.7.18.8).
   | tmemLoad (shape: TmemShape)(dst: List(Nat))(taddr: Expr) : Instr
   | tmemStore (shape: TmemShape)(w: Word)(taddr: Expr)(values: List(Expr)) : Instr
   | tmemWait (what: TmemWait) : Instr
    // Warp-wide: `flag` set to 1 in the one lane `elect.sync` chooses (§9.7.15.15); `d` := lane `lane`'s `a`
    // (`shfl.sync.idx`, §9.7.10.6); `d` := whether `p` is not 0 in any lane, as 1 or 0 (`vote.sync.any`, §9.7.15.10).
   | elect (flag: Nat) : Instr
   | shfl (d: Nat)(a: Expr)(lane: Nat) : Instr
   | voteAny (d: Nat)(p: Expr) : Instr
    // This warp's register count per thread moved to `count` (§9.7.21.5).
   | setMaxNReg (change: RegChange)(count: Nat) : Instr
    // f32 results: the f32 of bits `bits` (`mov.b32`, §9.7.10.3); 2^a and log2(a), approximate, subnormals flushed
    // (§9.7.3.21, §9.7.3.20); 2^a on the FMA units (`Cuda.ex2Emulation`); 1/a, rounded by `rounding` (§9.7.3.13).
   | movF32 (d: Nat)(bits: Nat) : Instr
   | ex2 (d: Nat)(a: Expr) : Instr
   | lg2 (d: Nat)(a: Expr) : Instr
   | ex2Emulated (d: Nat)(a: Expr) : Instr
   | rcp (rounding: Rounding)(d: Nat)(a: Expr) : Instr
    // The 32-bit `d` := `hi` and `lo` rounded to nearest-even bf16, `hi` in the upper half (§9.7.10.24).
   | cvtBf16x2 (d: Nat)(hi: Expr)(lo: Expr) : Instr
    // 64-bit, relaxed at `level`, on the global address that generic address `addr` converts to (§9.7.10.8,
    // §9.7.15.5): `d` := the value; `d` := `atom.cas`'s old value, `desired` stored if it equalled `expected`.
   | ldRelaxed (level: Scope)(d: Nat)(addr: Expr) : Instr
   | casRelaxed (level: Scope)(d: Nat)(addr: Expr)(expected: Expr)(desired: Expr) : Instr
    // `d` := the special register `r`.
   | movSpecial (d: Nat)(r: SpecialReg) : Instr
    // `d` := the address in CTA `rank`'s shared memory of the object at shared address `addr` (`mapa`, §9.7.10.26).
   | mapa (d: Nat)(addr: Expr)(rank: Expr) : Instr
    // The f32 `values`, two or four of them, to shared memory at `addr` (`st.shared.v2`, `.v4`, §9.7.10.11).
   | stShared (addr: Expr)(values: List(Expr)) : Instr

  mutual {
    inductive Stmt : Type
     | decl (t: DType)(id: Nat)(init: Expr) : Stmt
     | declMut (t: DType)(id: Nat)(init: Expr) : Stmt
     | declOut (t: DType)(id: Nat) : Stmt
     | assign (id: Nat)(value: Expr) : Stmt
     | store (base: Expr)(i: Expr)(value: Expr) : Stmt
     | shared (t: DType)(id: Nat)(size: Nat) : Stmt
     | forLoop (id: Nat)(start: Expr)(count: Expr)(body: Block) : Stmt
     | forStride (id: Nat)(start: Expr)(stop: Expr)(step: Expr)(body: Block) : Stmt
     | ifElse (c: Expr)(yes: Block)(no: Block) : Stmt
     | scoped (body: Block) : Stmt
     | sync : Stmt
     | syncWarp : Stmt
     | asm (template: String)(outs: List(Operand))(ins: List(Operand)) : Stmt
     | instr (i: Instr) : Stmt
     | error (message: String) : Stmt

    inductive Block : Type
     | done : Block
     | seq (s: Stmt)(rest: Block) : Block
  }

  // What a kernel does through a tensor map: load from global memory (an operand), or store to it (the result).
  inductive MapUse : Type
   | load : MapUse
   | store : MapUse

  inductive Param : Type
   | input (t: DType)(name: String) : Param
   | output (t: DType)(name: String) : Param
   | scalar (t: DType)(name: String) : Param
   | tensorMap (use: MapUse)(name: String) : Param

  // How the host encodes the tensor-map parameter `param`, which the kernel uses for `use`: over the matrix of the host
  // parameter `source`, of its element type, `rows` × `cols` elements, `cols` contiguous (both host scalars), in boxes of
  // `inner` × `outer` elements with 128-byte swizzle. Elements outside the matrix read as zero, and are not written.
  struct MapEncoding : Type
   | mk (param: String)(use: MapUse)(source: Param)(rows: String)(cols: String)(inner: Nat)(outer: Nat) : MapEncoding

  // How many CTAs a launcher starts: `x` × `y`; for a persistent kernel, one per SM but no more than `tiles`; for a
  // kernel of CTA pairs, `x` × `y` pairs, each a cluster of two CTAs along x, the kernel declaring the cluster's shape
  // (`__cluster_dims__(2, 1, 1)`), so `2x` × `y` CTAs; or, for a persistent kernel of CTA pairs, one pair per two SMs
  // but no more than `tiles` pairs, along x.
  inductive Grid : Type
   | blocks (x: Expr)(y: Expr) : Grid
   | persistent (tiles: Expr) : Grid
   | pairs (x: Expr)(y: Expr) : Grid
   | persistentPairs (tiles: Expr) : Grid

  // A host function `<kernel>_launch` taking `params` and a stream: it fails with `cudaErrorInvalidValue` unless every
  // condition in `requires` holds, encodes `maps`, and launches `grid` of CTAs of `block` threads with the kernel's
  // dynamic shared memory. It passes the kernel's parameters by name: `params` declares each of them but the tensor
  // maps, which `maps` declares.
  struct Launcher : Type
   | mk (params: List(Param))(requires: List(Expr))(maps: List(MapEncoding))(grid: Grid)(block: Nat) : Launcher

  // A kernel, with the bytes of dynamic shared memory it must be launched with, and its host launcher if it has one.
  struct Kernel : Type
   | mk (name: String)(params: List(Param))(dynamicShared: Nat)(body: Block)(launcher: Option(Launcher)) : Kernel

  def dtype (t: DType): String := {
    match t returning String with
    | DType.u32 => "unsigned"
    | DType.u64 => "unsigned long long"
    | DType.f32 => "float"
    | DType.bf16 => "__nv_bfloat16"
    | DType.bool => "bool"
  }

  def binop (op: BinOp): String := {
    match op returning String with
    | BinOp.add => " + "
    | BinOp.sub => " - "
    | BinOp.mul => " * "
    | BinOp.div => " / "
    | BinOp.rem => " % "
    | BinOp.lt => " < "
    | BinOp.eq => " == "
    | BinOp.land => " && "
    | BinOp.shl => " << "
    | BinOp.shr => " >> "
    | BinOp.bor => " | "
    | BinOp.band => " & "
    | BinOp.bxor => " ^ "
  }

  def name (id: Nat): String := Text.cat("v", Text.nat(id))

  // The dynamic shared buffer, and its address in the shared window.
  def smem : String := "gpu_smem"

  def smemBase : String := "gpu_smem_base"

  def expr (e: Expr): String decreases structural(e) := {
    match e returning String with
    | Expr.var id => Cuda.name(id)
    | Expr.lit value => Text.cat(Text.nat(value), "u")
    | Expr.lit64 value => Text.cat(Text.nat(value), "ull")
    | Expr.zero t => {
      match t returning String with
      | DType.u32 => "0u"
      | DType.u64 => "0ull"
      | DType.f32 => "0.0f"
      | DType.bf16 => "__float2bfloat16(0.0f)"
      | DType.bool => "false"
    }
    | Expr.param n => n
    | Expr.special b => {
      match b returning String with
      | Builtin.threadX => "threadIdx.x"
      | Builtin.blockX => "blockIdx.x"
      | Builtin.blockY => "blockIdx.y"
      | Builtin.gridX => "gridDim.x"
      | Builtin.warp => "__shfl_sync(0xffffffffu, threadIdx.x / 32u, 0)"
      | Builtin.lane => "(threadIdx.x % 32u)"
    }
    | Expr.bin op a b => Text.cat3("(", Text.cat3(Cuda.expr(a), Cuda.binop(op), Cuda.expr(b)), ")")
    | Expr.max a b => Text.cat3("max(", Text.cat3(Cuda.expr(a), ", ", Cuda.expr(b)), ")")
    | Expr.fma a b c => Text.cat3("fmaf(", Text.cat3(Cuda.expr(a), ", ", Text.cat3(Cuda.expr(b), ", ", Cuda.expr(c))), ")")
    | Expr.select c t f => Text.cat3("(", Text.cat3(Cuda.expr(c), " ? ", Text.cat3(Cuda.expr(t), " : ", Cuda.expr(f))), ")")
    | Expr.index base i => Text.cat3(Cuda.expr(base), "[", Text.cat(Cuda.expr(i), "]"))
    | Expr.cast t x => Text.cat3("static_cast<", Cuda.dtype(t), Text.cat3(">(", Cuda.expr(x), ")"))
    | Expr.sharedAddr offset => Text.cat3("(", Cuda.smemBase, Text.cat3(" + ", Text.nat(offset), "u)"))
    | Expr.sharedPtr t offset =>
      Text.cat3("reinterpret_cast<", Cuda.dtype(t), Text.cat3("*>(", Cuda.smem, Text.cat3(" + ", Text.nat(offset), ")")))
    | Expr.paramAddr n => Text.cat3("reinterpret_cast<unsigned long long>(&", n, ")")
  }

  def operand (o: Operand): String := {
    let (c, x) := o
    Text.cat3("\"", c, Text.cat3("\"(", Cuda.expr(x), ")"))
  }

  def operands (os: List(Operand)): String decreases structural(os) := {
    match os returning String with
    | List.nil => ""
    | List.cons o more => {
      match more returning String with
      | List.nil => Cuda.operand(o)
      | List.cons p rest => Text.cat3(Cuda.operand(o), ", ", Cuda.operands(more))
    }
  }

  // ---- Instructions as inline assembly -----------------------------------------------------------------------------

  // An inline-assembly statement: its template, and its output and input operands, numbered `%0` on in that order.
  struct Asm : Type
   | mk (template: String)(outs: List(Operand))(ins: List(Operand)) : Asm

  def asmText (a: Asm): String := {
    let (template, outs, ins) := a
    Text.cat3("asm volatile(\"", template, Text.cat3("\" : ", Cuda.operands(outs), Text.cat3(" : ", Cuda.operands(ins), " : \"memory\");")))
  }

  def u32In (x: Expr): Operand := Operand.mk("r", x)

  def u64In (x: Expr): Operand := Operand.mk("l", x)

  def f32In (x: Expr): Operand := Operand.mk("f", x)

  def wordIn (w: Word): Expr -> Operand := {
    match w returning Expr -> Operand with
    | Word.u32 => Cuda.u32In
    | Word.f32 => Cuda.f32In
  }

  def ops1 (a: Operand): List(Operand) := List.cons(a, List.nil(Operand))

  def ops2 (a: Operand)(b: Operand): List(Operand) := List.cons(a, Cuda.ops1(b))

  // An instruction without outputs.
  def effect (template: String)(ins: List(Operand)): Asm := Asm.mk(template, List.nil(Operand), ins)

  // An instruction writing the variable `d` under `constraint`, its `%0`, from `ins`.
  def writes (template: String)(constraint: String)(d: Nat)(ins: List(Operand)): Asm :=
    Asm.mk(template, Cuda.ops1(Operand.mk(constraint, Expr.var(d))), ins)

  // `%first, %(first + 1), …`, `count` operand numbers.
  def numbered (first: Nat)(count: Nat): String decreases structural(count) := {
    match count returning String with
    | Nat.zero => ""
    | Nat.succ more => {
      match more returning String with
      | Nat.zero => Text.cat("%", Text.nat(first))
      | Nat.succ rest => Text.cat3("%", Text.nat(first), Text.cat(", ", Cuda.numbered(Nat.succ(first), more)))
    }
  }

  // A vector operand of `count` registers from operand `first` on.
  def vector (first: Nat)(count: Nat): String := Text.cat3("{", Cuda.numbered(first, count), "}")

  def ctaGroup (g: CtaGroup): String := {
    match g returning String with
    | CtaGroup.one => "cta_group::1"
    | CtaGroup.two => "cta_group::2"
  }

  // An mbarrier operation's `.sem.scope`, `sem` its ordering: none at the default scope, `.cta`.
  def barrierScope (sem: String)(s: BarrierScope): String := {
    match s returning String with
    | BarrierScope.cta => ""
    | BarrierScope.cluster => Text.cat(sem, ".cluster")
  }

  def memoryScope (s: Scope): String := {
    match s returning String with
    | Scope.cta => ".cta"
    | Scope.cluster => ".cluster"
    | Scope.gpu => ".gpu"
  }

  def window (w: Window): String := {
    match w returning String with
    | Window.cta => ".shared::cta"
    | Window.cluster => ".shared::cluster"
  }

  def tmemShape (s: TmemShape): String := {
    match s returning String with
    | TmemShape.s32x32b => ".32x32b"
  }

  def rounding (r: Rounding): String := {
    match r returning String with
    | Rounding.rn => ".rn"
    | Rounding.rz => ".rz"
    | Rounding.rm => ".rm"
    | Rounding.rp => ".rp"
  }

  def specialReg (r: SpecialReg): String := {
    match r returning String with
    | SpecialReg.clusterCtaRank => "cluster_ctarank"
    | SpecialReg.clusterIdX => "clusterid.x"
    | SpecialReg.nclusterIdX => "nclusterid.x"
  }

  // Table 49's fixed fields: stride byte offset 1024 >> 4 at bit 32, version 1 at bit 46, swizzle mode 2 (128 bytes)
  // at bit 61.
  def smemDescFixed : Nat := Nat.add(Nat.mul(64, Nat.pow(2, 32)), Nat.add(Nat.pow(2, 46), Nat.mul(2, Nat.pow(2, 61))))

  // The descriptor's 64 bits: the start address (its low 18 bits) >> 4 in bits 0–14, the leading byte offset >> 4 in
  // bits 16–30, and the fixed fields; then the step, added to the start address field.
  def packSmemDesc (d: SmemDesc): Expr := {
    let (base, lbo, step) := d
    Expr.bin(BinOp.add,
      Expr.bin(BinOp.bor, Expr.cast(DType.u64, Expr.bin(BinOp.shr, Expr.bin(BinOp.band, base, Expr.lit(262143)), Expr.lit(4))),
        Expr.lit64(Nat.add(Cuda.smemDescFixed, Nat.mul(Nat.div(lbo, 16), Nat.pow(2, 16))))),
      Expr.lit64(Nat.mul(2, step)))
  }

  // Table 51's fields: D's type f32 (1 in bits 4–5), A's and B's bf16 (1 in bits 7–9 and 10–12), transpose B (bit
  // 16), N >> 3 (bits 17–22) and M >> 4 (bits 24–28).
  def packInstrDesc (d: InstrDesc): Nat := {
    let (m, n, transposeB) := d
    Nat.add(Bool.cond(transposeB, Nat, Nat.pow(2, 16), 0),
      Nat.add(16, Nat.add(128, Nat.add(1024, Nat.add(Nat.mul(Nat.pow(2, 17), Nat.div(n, 8)), Nat.mul(Nat.pow(2, 24), Nat.div(m, 16)))))))
  }

  // `op` on the global address `a` that the generic address operand %1 converts to.
  def globalAt (op: String): String := Text.cat3("{\\n\\t.reg .u64 a;\\n\\tcvta.to.global.u64 a, %1;\\n\\t", op, "\\n\\t}")

  // FA4's `ex2_emulation`, for x = %1 < 128: x clamped to −127 (`max`); j = ⌊x⌋, by `add.rm` of 1.5·2²³ and the
  // subtraction of 1.5·2²³; f = x − j, in [0, 1]; 2^f by FA4's cubic (`POLY_EX2[3]`), Horner's rule by `fma.rn`; and j
  // added to the exponent of the result's bits, from the low bits of the `add.rm`'s.
  def ex2Emulation : String := {
    let floor := "\\n\\tmax.f32 c, %1, 0fC2FE0000;\\n\\tadd.rm.f32 r, c, 0f4B400000;\\n\\tsub.rn.f32 j, r, 0f4B400000;\\n\\tsub.rn.f32 f, c, j;"
    let poly := "\\n\\tfma.rn.f32 p, f, 0f3D9DF09D, 0f3E6906A4;\\n\\tfma.rn.f32 p, p, f, 0f3F31F519;\\n\\tfma.rn.f32 p, p, f, 0f3F800000;"
    let scale := "\\n\\tmov.b32 k, r;\\n\\tshl.b32 k, k, 23;\\n\\tmov.b32 q, p;\\n\\tadd.s32 q, k, q;\\n\\tmov.b32 %0, q;\\n\\t}"
    Text.cat3("{\\n\\t.reg .f32 c, r, j, f, p;\\n\\t.reg .b32 k, q;", floor, Text.cat(poly, scale))
  }

  // An instruction as the inline assembly CUTLASS uses for it.
  def asmOf (i: Instr): Asm := {
    match i returning Asm with
    | Instr.barSync id threads => Cuda.effect("bar.sync %0, %1;", Cuda.ops2(Cuda.u32In(id), Cuda.u32In(threads)))
    | Instr.mbarInit bar count => Cuda.effect("mbarrier.init.shared::cta.b64 [%0], %1;", Cuda.ops2(Cuda.u32In(bar), Cuda.u32In(count)))
    | Instr.mbarInval bar => Cuda.effect("mbarrier.inval.shared::cta.b64 [%0];", Cuda.ops1(Cuda.u32In(bar)))
    | Instr.mbarArrive s w bar arrival => {
      let at := Text.cat(Cuda.barrierScope(".release", s), Cuda.window(w))
      match arrival returning Asm with
      | Arrival.one => Cuda.effect(Text.cat3("mbarrier.arrive", at, ".b64 _, [%0];"), Cuda.ops1(Cuda.u32In(bar)))
      | Arrival.count n => Cuda.effect(Text.cat3("mbarrier.arrive", at, ".b64 _, [%0], %1;"), Cuda.ops2(Cuda.u32In(bar), Cuda.u32In(n)))
      | Arrival.expectTx bytes =>
        Cuda.effect(Text.cat3("mbarrier.arrive.expect_tx", at, ".b64 _, [%0], %1;"), Cuda.ops2(Cuda.u32In(bar), Cuda.u32In(bytes)))
    }
    | Instr.mbarWait s bar parity =>
      Cuda.effect(Text.cat3("{\\n\\t.reg .pred P1;\\n\\tLAB_WAIT:\\n\\tmbarrier.try_wait.parity", Cuda.barrierScope(".acquire", s),
        ".shared::cta.b64 P1, [%0], %1;\\n\\t@P1 bra DONE;\\n\\tbra LAB_WAIT;\\n\\tDONE:\\n\\t}"), Cuda.ops2(Cuda.u32In(bar), Cuda.u32In(parity)))
    | Instr.fenceMbarInit => Cuda.effect("fence.mbarrier_init.release.cluster;", List.nil(Operand))
    | Instr.fenceProxyAsync => Cuda.effect("fence.proxy.async.shared::cta;", List.nil(Operand))
    | Instr.tcFence side => {
      match side returning Asm with
      | ThreadSync.before => Cuda.effect("tcgen05.fence::before_thread_sync;", List.nil(Operand))
      | ThreadSync.after => Cuda.effect("tcgen05.fence::after_thread_sync;", List.nil(Operand))
    }
    | Instr.clusterArrive => Cuda.effect("barrier.cluster.arrive.release.aligned;", List.nil(Operand))
    | Instr.clusterWait => Cuda.effect("barrier.cluster.wait.acquire.aligned;", List.nil(Operand))
    // The CTA group is printed after the dimension, in the order of CUTLASS's `SM100_TMA_2SM_LOAD`; `.cta_group::1` is
    // the default, and not printed.
    | Instr.tmaLoad g dst map x y bar => {
      let group := {
        match g returning String with
        | CtaGroup.one => ""
        | CtaGroup.two => ".cta_group::2"
      }
      Cuda.effect(Text.cat3("cp.async.bulk.tensor.2d", group, ".shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%3, %4}], [%2];"),
        List.cons(Cuda.u32In(dst), List.cons(Cuda.u64In(map), List.cons(Cuda.u32In(bar), Cuda.ops2(Cuda.u32In(x), Cuda.u32In(y))))))
    }
    | Instr.tmaStore map x y src =>
      Cuda.effect("cp.async.bulk.tensor.2d.global.shared::cta.bulk_group [%0, {%2, %3}], [%1];",
        List.cons(Cuda.u64In(map), List.cons(Cuda.u32In(src), Cuda.ops2(Cuda.u32In(x), Cuda.u32In(y)))))
    | Instr.bulkCommit => Cuda.effect("cp.async.bulk.commit_group;", List.nil(Operand))
    | Instr.bulkWait what pending => {
      let read := {
        match what returning String with
        | BulkWait.read => ".read"
        | BulkWait.complete => ""
      }
      Cuda.effect(Text.cat3("cp.async.bulk.wait_group", read, Text.cat3(" ", Text.nat(pending), ";")), List.nil(Operand))
    }
    | Instr.tmemAlloc g slot cols =>
      Cuda.effect(Text.cat3("tcgen05.alloc.", Cuda.ctaGroup(g), ".sync.aligned.shared::cta.b32 [%0], %1;"), Cuda.ops2(Cuda.u32In(slot), Cuda.u32In(cols)))
    | Instr.tmemRelinquish g => Cuda.effect(Text.cat3("tcgen05.relinquish_alloc_permit.", Cuda.ctaGroup(g), ".sync.aligned;"), List.nil(Operand))
    | Instr.tmemDealloc g taddr cols =>
      Cuda.effect(Text.cat3("tcgen05.dealloc.", Cuda.ctaGroup(g), ".sync.aligned.b32 %0, %1;"), Cuda.ops2(Cuda.u32In(taddr), Cuda.u32In(cols)))
    // The predicate enable-input-d is set from the 32-bit `accumulate`.
    | Instr.mma g d a b idesc accumulate => {
      let (aText, aOperand) := {
        match a returning Pair(String, Operand) with
        | MmaA.smem desc => ("%1", Cuda.u64In(Cuda.packSmemDesc(desc)))
        | MmaA.tmem addr => ("[%1]", Cuda.u32In(addr))
      }
      let template := Text.cat3("{\\n\\t.reg .pred p;\\n\\tsetp.ne.b32 p, %4, 0;\\n\\ttcgen05.mma.", Cuda.ctaGroup(g),
        Text.cat3(".kind::f16 [%0], ", aText, ", %2, %3, p;\\n\\t}"))
      Cuda.effect(template, List.cons(Cuda.u32In(d), List.cons(aOperand, List.cons(Cuda.u64In(Cuda.packSmemDesc(b)),
        Cuda.ops2(Cuda.u32In(Expr.lit(Cuda.packInstrDesc(idesc))), Cuda.u32In(accumulate))))))
    }
    // The CTA mask is set in a `.b16` register: a 16-bit operand would need a 16-bit C type.
    | Instr.commit g bar multicast => {
      let head := Text.cat3("tcgen05.commit.", Cuda.ctaGroup(g), ".mbarrier::arrive::one.shared::cluster")
      let text := Option.elim(multicast, String, Text.cat(head, ".b64 [%0];"), fun (mask: Nat): String =>
        Text.cat3("{\\n\\t.reg .b16 mask;\\n\\tmov.b16 mask, ", Text.nat(mask), Text.cat3(";\\n\\t", head, ".multicast::cluster.b64 [%0], mask;\\n\\t}")))
      Cuda.effect(text, Cuda.ops1(Cuda.u32In(bar)))
    }
    | Instr.tmemLoad shape dst taddr => {
      let n := List.length(dst)
      let template := Text.cat3("tcgen05.ld.sync.aligned", Cuda.tmemShape(shape), Text.cat3(".x", Text.nat(n),
        Text.cat3(".b32 ", Cuda.vector(0, n), Text.cat3(", [%", Text.nat(n), "];"))))
      Asm.mk(template, List.map(dst, Operand, fun (v: Nat): Operand => Operand.mk("=f", Expr.var(v))), Cuda.ops1(Cuda.u32In(taddr)))
    }
    | Instr.tmemStore shape w taddr values => {
      let n := List.length(values)
      let template := Text.cat3("tcgen05.st.sync.aligned", Cuda.tmemShape(shape), Text.cat3(".x", Text.nat(n),
        Text.cat3(".b32 [%0], ", Cuda.vector(1, n), ";")))
      Cuda.effect(template, List.cons(Cuda.u32In(taddr), List.map(values, Operand, Cuda.wordIn(w))))
    }
    | Instr.tmemWait what => {
      match what returning Asm with
      | TmemWait.load => Cuda.effect("tcgen05.wait::ld.sync.aligned;", List.nil(Operand))
      | TmemWait.store => Cuda.effect("tcgen05.wait::st.sync.aligned;", List.nil(Operand))
    }
    | Instr.elect flag =>
      Cuda.writes("{\\n\\t.reg .b32 rx;\\n\\t.reg .pred px;\\n\\telect.sync rx|px, 0xffffffff;\\n\\t@px mov.u32 %0, 1;\\n\\t}", "+r", flag,
        List.nil(Operand))
    | Instr.shfl d a lane =>
      Cuda.writes(Text.cat3("shfl.sync.idx.b32 %0, %1, ", Text.nat(lane), ", 31, 0xffffffff;"), "=r", d, Cuda.ops1(Cuda.u32In(a)))
    | Instr.voteAny d p =>
      Cuda.writes("{\\n\\t.reg .pred p, q;\\n\\tsetp.ne.u32 p, %1, 0;\\n\\tvote.sync.any.pred q, p, 0xffffffff;\\n\\tselp.u32 %0, 1, 0, q;\\n\\t}",
        "=r", d, Cuda.ops1(Cuda.u32In(p)))
    | Instr.setMaxNReg change count => {
      let way := {
        match change returning String with
        | RegChange.inc => "inc"
        | RegChange.dec => "dec"
      }
      Cuda.effect(Text.cat3("setmaxnreg.", way, Text.cat3(".sync.aligned.u32 ", Text.nat(count), ";")), List.nil(Operand))
    }
    | Instr.movF32 d bits => Cuda.writes(Text.cat3("mov.b32 %0, ", Text.nat(bits), ";"), "=f", d, List.nil(Operand))
    | Instr.ex2 d a => Cuda.writes("ex2.approx.ftz.f32 %0, %1;", "=f", d, Cuda.ops1(Cuda.f32In(a)))
    | Instr.lg2 d a => Cuda.writes("lg2.approx.ftz.f32 %0, %1;", "=f", d, Cuda.ops1(Cuda.f32In(a)))
    | Instr.ex2Emulated d a => Cuda.writes(Cuda.ex2Emulation, "=f", d, Cuda.ops1(Cuda.f32In(a)))
    | Instr.rcp r d a => Cuda.writes(Text.cat3("rcp", Cuda.rounding(r), ".f32 %0, %1;"), "=f", d, Cuda.ops1(Cuda.f32In(a)))
    | Instr.cvtBf16x2 d hi lo => Cuda.writes("cvt.rn.bf16x2.f32 %0, %1, %2;", "=r", d, Cuda.ops2(Cuda.f32In(hi), Cuda.f32In(lo)))
    | Instr.ldRelaxed s d addr =>
      Cuda.writes(Cuda.globalAt(Text.cat3("ld.relaxed", Cuda.memoryScope(s), ".global.b64 %0, [a];")), "=l", d, Cuda.ops1(Cuda.u64In(addr)))
    | Instr.casRelaxed s d addr expected desired =>
      Cuda.writes(Cuda.globalAt(Text.cat3("atom.relaxed", Cuda.memoryScope(s), ".global.cas.b64 %0, [a], %2, %3;")), "=l", d,
        List.cons(Cuda.u64In(addr), Cuda.ops2(Cuda.u64In(expected), Cuda.u64In(desired))))
    // `%%` is a `%` in a template with operands.
    | Instr.movSpecial d r => Cuda.writes(Text.cat3("mov.u32 %0, %%", Cuda.specialReg(r), ";"), "=r", d, List.nil(Operand))
    | Instr.mapa d addr rank => Cuda.writes("mapa.shared::cluster.u32 %0, %1, %2;", "=r", d, Cuda.ops2(Cuda.u32In(addr), Cuda.u32In(rank)))
    | Instr.stShared addr values => {
      let n := List.length(values)
      Cuda.effect(Text.cat3("st.shared.v", Text.nat(n), Text.cat3(".f32 [%0], ", Cuda.vector(1, n), ";")),
        List.cons(Cuda.u32In(addr), List.map(values, Operand, Cuda.f32In)))
    }
  }

  def indent (depth: Nat): String decreases structural(depth) := {
    match depth returning String with
    | Nat.zero => ""
    | Nat.succ d => Text.cat("  ", Cuda.indent(d))
  }

  def line (depth: Nat)(text: String)(rest: String): String := Text.cat3(Cuda.indent(depth), text, Text.cat("\n", rest))

  mutual {
    // Renders `s` at `depth`, in front of `rest`, so a whole kernel is built by prepending lines.
    def stmt (depth: Nat)(s: Stmt)(rest: String): String decreases structural(s) := {
      match s returning String with
      | Stmt.decl t id init =>
        Cuda.line(depth, Text.cat3("const ", Cuda.dtype(t), Text.cat3(" ", Cuda.name(id), Text.cat3(" = ", Cuda.expr(init), ";"))), rest)
      | Stmt.declMut t id init =>
        Cuda.line(depth, Text.cat3(Cuda.dtype(t), " ", Text.cat3(Cuda.name(id), " = ", Text.cat(Cuda.expr(init), ";"))), rest)
      | Stmt.declOut t id => Cuda.line(depth, Text.cat3(Cuda.dtype(t), " ", Text.cat(Cuda.name(id), ";")), rest)
      | Stmt.assign id value => Cuda.line(depth, Text.cat3(Cuda.name(id), " = ", Text.cat(Cuda.expr(value), ";")), rest)
      | Stmt.store base i value =>
        Cuda.line(depth, Text.cat3(Cuda.expr(Expr.index(base, i)), " = ", Text.cat(Cuda.expr(value), ";")), rest)
      | Stmt.shared t id size =>
        Cuda.line(depth, Text.cat3("__shared__ ", Cuda.dtype(t), Text.cat3(" ", Cuda.name(id), Text.cat3("[", Text.nat(size), "];"))), rest)
      | Stmt.forLoop id start count body => {
        let i := Cuda.name(id)
        let head := Text.cat3("for (unsigned ", i, Text.cat3(" = ", Cuda.expr(start), Text.cat3("; ", i,
          Text.cat3(" < ", Cuda.expr(count), Text.cat3("; ++", i, ") {")))))
        Cuda.line(depth, head, Cuda.block(Nat.succ(depth), body, Cuda.line(depth, "}", rest)))
      }
      | Stmt.forStride id start stop step body => {
        let i := Cuda.name(id)
        let head := Text.cat3("for (unsigned ", i, Text.cat3(" = ", Cuda.expr(start), Text.cat3("; ", i,
          Text.cat3(" < ", Cuda.expr(stop), Text.cat3("; ", i, Text.cat3(" += ", Cuda.expr(step), ") {"))))))
        Cuda.line(depth, head, Cuda.block(Nat.succ(depth), body, Cuda.line(depth, "}", rest)))
      }
      | Stmt.ifElse c yes no => {
        let tail := Cuda.line(depth, "}", rest)
        let elseTail := {
          match no returning String with
          | Block.done => tail
          | Block.seq first more => Cuda.line(depth, "} else {", Cuda.block(Nat.succ(depth), Block.seq(first, more), tail))
        }
        Cuda.line(depth, Text.cat3("if (", Cuda.expr(c), ") {"), Cuda.block(Nat.succ(depth), yes, elseTail))
      }
      | Stmt.scoped body => Cuda.line(depth, "{", Cuda.block(Nat.succ(depth), body, Cuda.line(depth, "}", rest)))
      | Stmt.sync => Cuda.line(depth, "__syncthreads();", rest)
      | Stmt.syncWarp => Cuda.line(depth, "__syncwarp();", rest)
      | Stmt.asm template outs ins => Cuda.line(depth, Cuda.asmText(Asm.mk(template, outs, ins)), rest)
      | Stmt.instr i => Cuda.line(depth, Cuda.asmText(Cuda.asmOf(i)), rest)
      | Stmt.error message => Cuda.line(depth, Text.cat3("#error \"", message, "\""), rest)
    }

    def block (depth: Nat)(b: Block)(rest: String): String decreases structural(b) := {
      match b returning String with
      | Block.done => rest
      | Block.seq s more => Cuda.stmt(depth, s, Cuda.block(depth, more, rest))
    }
  }

  def param (p: Param): String := {
    match p returning String with
    | Param.input t n => Text.cat3("const ", Cuda.dtype(t), Text.cat("* __restrict__ ", n))
    | Param.output t n => Text.cat3(Cuda.dtype(t), "* __restrict__ ", n)
    | Param.scalar t n => Text.cat3(Cuda.dtype(t), " ", n)
    | Param.tensorMap u n => Text.cat("const __grid_constant__ CUtensorMap ", n)
  }

  // A host function's parameter: as the kernel's, without `__restrict__`, which means nothing on the host and would
  // stop `&p` converting to `void*` for the launch's argument array.
  def hostParam (p: Param): String := {
    match p returning String with
    | Param.input t n => Text.cat3("const ", Cuda.dtype(t), Text.cat("* ", n))
    | Param.output t n => Text.cat3(Cuda.dtype(t), "* ", n)
    | Param.scalar t n => Text.cat3(Cuda.dtype(t), " ", n)
    | Param.tensorMap u n => Text.cat("CUtensorMap ", n)
  }

  def hostParams (ps: List(Param)): String decreases structural(ps) := {
    match ps returning String with
    | List.nil => ""
    | List.cons p more => {
      match more returning String with
      | List.nil => Cuda.hostParam(p)
      | List.cons q rest => Text.cat3(Cuda.hostParam(p), ", ", Cuda.hostParams(more))
    }
  }

  def params (ps: List(Param)): String decreases structural(ps) := {
    match ps returning String with
    | List.nil => ""
    | List.cons p more => {
      match more returning String with
      | List.nil => Cuda.param(p)
      | List.cons q rest => Text.cat3(Cuda.param(p), ", ", Cuda.params(more))
    }
  }

  def usesTensorMaps (ps: List(Param)): Bool := List.any(ps, fun (p: Param): Bool => {
    match p returning Bool with
    | Param.input t n => Bool.false
    | Param.output t n => Bool.false
    | Param.scalar t n => Bool.false
    | Param.tensorMap u n => Bool.true
  })

  def isBf16 (t: DType): Bool := {
    match t returning Bool with
    | DType.u32 => Bool.false
    | DType.u64 => Bool.false
    | DType.f32 => Bool.false
    | DType.bf16 => Bool.true
    | DType.bool => Bool.false
  }

  def usesBf16 (ps: List(Param)): Bool := List.any(ps, fun (p: Param): Bool => {
    match p returning Bool with
    | Param.input t n => Cuda.isBf16(t)
    | Param.output t n => Cuda.isBf16(t)
    | Param.scalar t n => Cuda.isBf16(t)
    | Param.tensorMap u n => Bool.false
  })

  // `#include <header>` where `wanted`.
  def include (wanted: Bool)(header: String): String := Bool.cond(wanted, String, Text.cat3("#include <", header, ">\n"), "")

  // Headers a kernel needs, then a blank line if it needs any: the driver API's when it takes tensor maps (CUtensorMap),
  // bf16's when it takes tensor maps (of bf16) or bf16 parameters, and the runtime API's when it has a launcher.
  def headers (ps: List(Param))(launched: Bool)(rest: String): String := {
    let maps := Cuda.usesTensorMaps(ps)
    let bf16 := Bool.or(maps, Cuda.usesBf16(ps))
    let blank := Bool.cond(Bool.or(bf16, launched), String, "\n", "")
    Text.cat3(Cuda.include(maps, "cuda.h"), Cuda.include(bf16, "cuda_bf16.h"),
      Text.cat3(Cuda.include(launched, "cuda_runtime.h"), blank, rest))
  }

  // The dynamic shared buffer's declaration and shared-window address, when the kernel uses one.
  def sharedPrologue (bytes: Nat)(rest: String): String := {
    match Nat.isZero(bytes) returning String with
    | Bool.true => rest
    | Bool.false => {
      let buffer := Text.cat3("extern __shared__ __align__(1024) unsigned char ", Cuda.smem, "[];")
      let base := Text.cat3("const unsigned ", Cuda.smemBase, Text.cat3(" = static_cast<unsigned>(__cvta_generic_to_shared(", Cuda.smem, "));"))
      Cuda.line(1, buffer, Cuda.line(1, base, rest))
    }
  }

  // ---- The host launcher -------------------------------------------------------------------------------------------

  def paramName (p: Param): String := {
    match p returning String with
    | Param.input t n => n
    | Param.output t n => n
    | Param.scalar t n => n
    | Param.tensorMap u n => n
  }

  def failUnless (c: Expr)(rest: String): String :=
    Cuda.line(1, Text.cat3("if (!", Cuda.expr(c), ") {"), Cuda.line(2, "return cudaErrorInvalidValue;", Cuda.line(1, "}", rest)))

  def requirements (cs: List(Expr))(rest: String): String decreases structural(cs) := {
    match cs returning String with
    | List.nil => rest
    | List.cons c more => Cuda.failUnless(c, Cuda.requirements(more, rest))
  }

  // The element type of a parameter's array or scalar. (A tensor map's is never asked for: `Check.launcher` refuses a
  // map encoded from one.)
  def elementType (p: Param): DType := {
    match p returning DType with
    | Param.input t n => t
    | Param.output t n => t
    | Param.scalar t n => t
    | Param.tensorMap u n => DType.u64
  }

  def tensorDataType (t: DType): String := {
    match t returning String with
    | DType.u32 => "CU_TENSOR_MAP_DATA_TYPE_UINT32"
    | DType.u64 => "CU_TENSOR_MAP_DATA_TYPE_UINT64"
    | DType.f32 => "CU_TENSOR_MAP_DATA_TYPE_FLOAT32"
    | DType.bf16 => "CU_TENSOR_MAP_DATA_TYPE_BFLOAT16"
    | DType.bool => "CU_TENSOR_MAP_DATA_TYPE_UINT8"
  }

  def elementBytes (t: DType): Nat := {
    match t returning Nat with
    | DType.u32 => 4
    | DType.u64 => 8
    | DType.f32 => 4
    | DType.bf16 => 2
    | DType.bool => 1
  }

  def mapEncoding (m: MapEncoding)(rest: String): String := {
    let (param, use, source, rows, cols, inner, outer) := m
    let t := Cuda.elementType(source)
    let encode := Text.cat3("if (cuTensorMapEncodeTiled(&", param, Text.cat3(", ", Cuda.tensorDataType(t),
      Text.cat3(", 2, const_cast<void*>(static_cast<const void*>(", Cuda.paramName(source), ")), dims, strides, box, steps,")))
    Cuda.line(1, Text.cat3("CUtensorMap ", param, ";"), Cuda.line(1, "{",
      Cuda.line(2, Text.cat3("const cuuint64_t dims[2] = {", cols, Text.cat3(", ", rows, "};")),
      Cuda.line(2, Text.cat3("const cuuint64_t strides[1] = {static_cast<cuuint64_t>(", cols, Text.cat3(") * ", Text.nat(Cuda.elementBytes(t)), "u};")),
      Cuda.line(2, Text.cat3("const cuuint32_t box[2] = {", Text.nat(inner), Text.cat3("u, ", Text.nat(outer), "u};")),
      Cuda.line(2, "const cuuint32_t steps[2] = {1u, 1u};",
      Cuda.line(2, encode,
      Cuda.line(4, "CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B, CU_TENSOR_MAP_L2_PROMOTION_L2_256B,",
      Cuda.line(4, "CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE) != CUDA_SUCCESS) {",
      Cuda.line(3, "return cudaErrorInvalidValue;",
      Cuda.line(2, "}", Cuda.line(1, "}", rest))))))))))))
  }

  def mapEncodings (ms: List(MapEncoding))(rest: String): String decreases structural(ms) := {
    match ms returning String with
    | List.nil => rest
    | List.cons m more => Cuda.mapEncoding(m, Cuda.mapEncodings(more, rest))
  }

  // `&a, &b, …` for the kernel's parameters.
  def argAddrs (ps: List(Param)): String decreases structural(ps) := {
    match ps returning String with
    | List.nil => ""
    | List.cons p more => {
      match more returning String with
      | List.nil => Text.cat("&", Cuda.paramName(p))
      | List.cons q rest => Text.cat3("&", Cuda.paramName(p), Text.cat(", ", Cuda.argAddrs(more)))
    }
  }

  // A persistent grid's lines: the device's SM count, `gpu_sms`, and the tile count, `gpu_tiles`; then `rest`.
  def smCount (tiles: Expr)(rest: String): String := {
    let query := "if (cudaGetDevice(&gpu_device) != cudaSuccess || cudaDeviceGetAttribute(&gpu_sms, cudaDevAttrMultiProcessorCount, gpu_device) != cudaSuccess) {"
    Cuda.line(1, "int gpu_device = 0;", Cuda.line(1, "int gpu_sms = 0;", Cuda.line(1, query,
      Cuda.line(2, "return cudaErrorInvalidValue;", Cuda.line(1, "}",
      Cuda.line(1, Text.cat3("const unsigned gpu_tiles = ", Cuda.expr(tiles), ";"), rest))))))
  }

  // The grid's extent, after any lines that compute it.
  def gridDims (g: Grid)(rest: String -> String): String := {
    match g returning String with
    | Grid.blocks x y => rest(Text.cat3("dim3(", Cuda.expr(x), Text.cat3(", ", Cuda.expr(y), ")")))
    | Grid.pairs x y => rest(Text.cat3("dim3(", Cuda.expr(Expr.bin(BinOp.mul, Expr.lit(2), x)), Text.cat3(", ", Cuda.expr(y), ")")))
    | Grid.persistent tiles =>
      Cuda.smCount(tiles, rest("dim3(gpu_tiles < static_cast<unsigned>(gpu_sms) ? gpu_tiles : static_cast<unsigned>(gpu_sms))"))
    | Grid.persistentPairs tiles =>
      Cuda.smCount(tiles, Cuda.line(1, "const unsigned gpu_pairs = static_cast<unsigned>(gpu_sms) / 2u;",
        rest("dim3(2u * (gpu_tiles < gpu_pairs ? gpu_tiles : gpu_pairs))")))
  }

  def launcher (name: String)(kernelParams: List(Param))(bytes: Nat)(l: Launcher): String := {
    let (ps, requires, maps, grid, block) := l
    let entry := Text.cat3("reinterpret_cast<const void*>(", name, ")")
    let head := Text.cat3("extern \"C\" cudaError_t ", name, Text.cat3("_launch(", Cuda.hostParams(ps), ", cudaStream_t stream) {"))
    let attr := Text.cat3("const cudaError_t status = cudaFuncSetAttribute(", entry,
      Text.cat3(", cudaFuncAttributeMaxDynamicSharedMemorySize, ", Text.nat(bytes), ");"))
    let launch := fun (dims: String): String => Cuda.line(1, Text.cat3("return cudaLaunchKernel(", entry, Text.cat3(", ", dims,
      Text.cat3(", dim3(", Text.nat(block), Text.cat3("u), args, ", Text.nat(bytes), "u, stream);")))), "}\n")
    Cuda.line(0, "", Cuda.line(0, Text.cat3("// Launches ", name, " on `stream`, encoding its tensor maps as its parameter types require."),
      Cuda.line(0, head, Cuda.requirements(requires, Cuda.mapEncodings(maps,
        Cuda.line(1, attr, Cuda.line(1, "if (status != cudaSuccess) {", Cuda.line(2, "return status;", Cuda.line(1, "}",
        Cuda.line(1, Text.cat3("void* args[] = {", Cuda.argAddrs(kernelParams), "};"), Cuda.gridDims(grid, launch)))))))))))
  }

  // The cluster shape a kernel launched in pairs declares, which makes its launch a cluster launch.
  def clusterDims (host: Option(Launcher)): String := Option.elim(host, String, "", fun (l: Launcher): String => {
    match l.grid returning String with
    | Grid.blocks x y => ""
    | Grid.persistent tiles => ""
    | Grid.pairs x y => "__cluster_dims__(2, 1, 1) "
    | Grid.persistentPairs tiles => "__cluster_dims__(2, 1, 1) "
  })

  // As `kernel`, with `__launch_bounds__(n, r)` when `bounds` is `(n, r)`: blocks of at most `n` threads, at least `r`
  // of them resident per SM, so `ptxas` keeps a thread's registers within 65536 / (n · r).
  def boundedKernel (bounds: Option(Pair(Nat, Nat)))(k: Kernel): String := {
    let (n, ps, bytes, body, host) := k
    let limit := Option.elim(bounds, String, "", fun (b: Pair(Nat, Nat)): String => {
      let (threads, residency) := b
      Text.cat3("__launch_bounds__(", Text.cat3(Text.nat(threads), ", ", Text.nat(residency)), ") ")
    })
    let head := Text.cat3("extern \"C\" __global__ void ", Text.cat3(Cuda.clusterDims(host), limit, n), Text.cat3("(", Cuda.params(ps), ") {"))
    let tail := Option.elim(host, String, "", fun (l: Launcher): String => Cuda.launcher(n, ps, bytes, l))
    let launched := Option.elim(host, Bool, Bool.false, fun (l: Launcher): Bool => Bool.true)
    Cuda.headers(ps, launched, Cuda.line(0, head, Cuda.sharedPrologue(bytes, Cuda.block(1, body, Text.cat("}\n", tail)))))
  }

  // The kernel and its launcher as CUDA C++.
  def kernel (k: Kernel): String := Cuda.boundedKernel(Option.none(Pair(Nat, Nat)), k)
}
