// Unit tests of gpu/Check.rac: for hand-built kernels, what each checker finds, stated as theorems that checking
// proves by evaluation. Each rule of each checker has a kernel that breaks it, and the good kernels keep every rule.
// Run by check.sh, which requires this file to check without a diagnostic.

import Check

namespace T {
  open Cuda

  def none : List(String) := List.nil(String)

  def one (m: String): List(String) := List.cons(m, List.nil(String))

  def two (m: String)(n: String): List(String) := List.cons(m, T.one(n))

  def b1 (s: Stmt): Block := Block.seq(s, Block.done)

  def b2 (s: Stmt)(t: Stmt): Block := Block.seq(s, T.b1(t))

  def b3 (s: Stmt)(t: Stmt)(u: Stmt): Block := Block.seq(s, T.b2(t, u))

  def r (x: Expr): Operand := Operand.mk("r", x)

  def bar (id: Nat)(threads: Nat): Stmt := Stmt.asm(Check.barrierTemplate, List.nil(Operand), List.cons(T.r(Expr.lit(id)), List.cons(T.r(Expr.lit(threads)), List.nil(Operand))))

  def n : Param := Param.scalar(DType.u32, "N")

  // A kernel with one parameter `N`, no dynamic shared memory and no launcher.
  def plain (body: Block): Kernel := Kernel.mk("k", List.cons(T.n, List.nil(Param)), 0, body, Option.none(Launcher))

  // ---- Good kernels ---------------------------------------------------------------------------------------------------

  def goodParams : List(Param) := List.cons(Param.tensorMap(MapUse.load, "A_map"), List.cons(Param.output(DType.f32, "C"), List.cons(T.n, List.nil(Param))))

  def hostParams : List(Param) := List.cons(Param.input(DType.bf16, "A"), List.cons(Param.output(DType.f32, "C"),
    List.cons(T.n, List.cons(Param.scalar(DType.u32, "K"), List.nil(Param)))))

  def encodeA : MapEncoding := MapEncoding.mk("A_map", MapUse.load, Param.input(DType.bf16, "A"), "N", "K", 64, 128)

  def launcher (maps: List(MapEncoding)): Launcher := Launcher.mk(T.hostParams,
    List.cons(Expr.bin(BinOp.lt, Expr.param("N"), Expr.lit64(2147483648)), List.nil(Expr)), maps, Grid.blocks(Expr.param("N"), Expr.lit(1)), 256)

  // Every kind of statement: a loop whose variable its body uses, a branch whose arms are scopes, named barriers in
  // and out of the loop, a tensor map's address, a strided loop, and a 64-bit literal just below 2^64.
  def goodBody : Block :=
    Block.seq(Stmt.decl(DType.u32, 0, Expr.param("N")),
    Block.seq(Stmt.forLoop(1, Expr.lit(0), Expr.var(0), T.b3(Stmt.declMut(DType.u32, 2, Expr.var(1)),
      Stmt.assign(2, Expr.bin(BinOp.add, Expr.var(2), Expr.lit(4294967295))),
      T.bar(1, 64))),
    Block.seq(Stmt.ifElse(Expr.bin(BinOp.lt, Expr.special(Builtin.threadX), Expr.var(0)),
      T.b1(Stmt.scoped(T.b1(Stmt.decl(DType.u32, 3, Expr.sharedAddr(1023))))),
      T.b1(Stmt.store(Expr.param("C"), Expr.var(0), Expr.zero(DType.f32)))),
    Block.seq(T.bar(2, 32),
    Block.seq(Stmt.asm("cp.async", List.nil(Operand), List.cons(Operand.mk("l", Expr.paramAddr("A_map")), List.nil(Operand))),
    Block.seq(Stmt.forStride(4, Expr.special(Builtin.blockX), Expr.var(0), Expr.special(Builtin.gridX),
      T.b2(Stmt.declOut(DType.f32, 5), Stmt.decl(DType.u64, 6, Expr.lit64(18446744073709551615)))),
    Block.done))))))

  def good : Kernel := Kernel.mk("good", T.goodParams, 1024, T.goodBody, Option.some(T.launcher(List.cons(T.encodeA, List.nil(MapEncoding)))))

  // A kernel with a static shared array and no launcher, like the tiled SIMT kernels.
  def goodStatic : Kernel := Kernel.mk("tiled", List.cons(Param.output(DType.f32, "C"), List.nil(Param)), 0,
    T.b3(Stmt.shared(DType.f32, 0, 256), Stmt.store(Expr.var(0), Expr.special(Builtin.threadX), Expr.zero(DType.f32)), Stmt.sync),
    Option.none(Launcher))

  // The most dynamic shared memory an SM has.
  def goodFull : Kernel := Kernel.mk("full", T.goodParams, 232448, T.b1(Stmt.decl(DType.u32, 0, Expr.sharedAddr(232447))),
    Option.some(T.launcher(List.cons(T.encodeA, List.nil(MapEncoding)))))

  def goodErrors : Eq(List(String), Check.errors(T.good), T.none) := Eq.refl(T.none)

  def goodScoping : Eq(List(String), Check.scoping(T.good), T.none) := Eq.refl(T.none)

  def goodShared : Eq(List(String), Check.sharedMemory(T.good), T.none) := Eq.refl(T.none)

  def goodBarriers : Eq(List(String), Check.namedBarriers(T.good), T.none) := Eq.refl(T.none)

  def goodLiterals : Eq(List(String), Check.literals(T.good), T.none) := Eq.refl(T.none)

  def goodNames : Eq(List(String), Check.names(T.good), T.none) := Eq.refl(T.none)

  def goodLauncher : Eq(List(String), Check.launcher(T.good), T.none) := Eq.refl(T.none)

  def goodStaticShared : Eq(List(String), Check.sharedMemory(T.goodStatic), T.none) := Eq.refl(T.none)

  def goodStaticScoping : Eq(List(String), Check.scoping(T.goodStatic), T.none) := Eq.refl(T.none)

  def goodStaticNames : Eq(List(String), Check.names(T.goodStatic), T.none) := Eq.refl(T.none)

  def goodStaticLauncher : Eq(List(String), Check.launcher(T.goodStatic), T.none) := Eq.refl(T.none)

  def goodFullShared : Eq(List(String), Check.sharedMemory(T.goodFull), T.none) := Eq.refl(T.none)

  // The certificate itself, discharged at a call as `Gpu.render` discharges it.
  def certified (k: Kernel)[ok: Check.WellFormed(k)]: Bool := Bool.true

  def goodWellFormed : Eq(Bool, T.certified(T.good), Bool.true) := Eq.refl(Bool.true)

  def goodStaticWellFormed : Eq(Bool, T.certified(T.goodStatic), Bool.true) := Eq.refl(Bool.true)

  def goodFullWellFormed : Eq(Bool, T.certified(T.goodFull), Bool.true) := Eq.refl(Bool.true)

  // ---- Sets of naturals -----------------------------------------------------------------------------------------------

  def set : Check.NatSet := List.foldl(List.cons(0, List.cons(1, List.cons(2, List.cons(6, List.cons(1000000, List.nil(Nat)))))),
    Check.NatSet, Check.NatSet.empty, Check.NatSet.insert)

  def queries : List(Nat) := List.cons(0, List.cons(1, List.cons(2, List.cons(3, List.cons(5, List.cons(6, List.cons(999999,
    List.cons(1000000, List.nil(Nat)))))))))

  def answers : List(Bool) := List.cons(Bool.true, List.cons(Bool.true, List.cons(Bool.true, List.cons(Bool.false,
    List.cons(Bool.false, List.cons(Bool.true, List.cons(Bool.false, List.cons(Bool.true, List.nil(Bool)))))))))

  def found : List(Bool) := List.map(T.queries, Bool, fun (x: Nat): Bool => Check.NatSet.member(T.set, x))

  def members : Eq(List(Bool), T.found, T.answers) := Eq.refl(T.answers)

  // ---- errors ---------------------------------------------------------------------------------------------------------

  // Every `#error`, nested ones included, in program order.
  def withErrors : Kernel := T.plain(T.b2(Stmt.forLoop(0, Expr.lit(0), Expr.lit(1), T.b1(Stmt.error("first"))), Stmt.error("second")))

  def errorsInOrder : Eq(List(String), Check.errors(T.withErrors), T.two("first", "second")) := Eq.refl(T.two("first", "second"))

  // ---- I1, scoping ----------------------------------------------------------------------------------------------------

  def useBeforeDecl : Kernel := T.plain(T.b2(Stmt.decl(DType.u32, 0, Expr.var(1)), Stmt.decl(DType.u32, 1, Expr.lit(0))))

  def scopedUseBeforeDecl : Eq(List(String), Check.scoping(T.useBeforeDecl), T.one("v1 used before its declaration")) :=
    Eq.refl(T.one("v1 used before its declaration"))

  // A declaration's initializer is outside the name it declares.
  def selfInit : Kernel := T.plain(T.b1(Stmt.decl(DType.u32, 0, Expr.var(0))))

  def scopedSelfInit : Eq(List(String), Check.scoping(T.selfInit), T.one("v0 used before its declaration")) :=
    Eq.refl(T.one("v0 used before its declaration"))

  def afterScope : Kernel := T.plain(T.b2(Stmt.scoped(T.b1(Stmt.decl(DType.u32, 0, Expr.lit(0)))), Stmt.decl(DType.u32, 1, Expr.var(0))))

  def scopedAfterScope : Eq(List(String), Check.scoping(T.afterScope), T.one("v0 used outside the scope of its declaration")) :=
    Eq.refl(T.one("v0 used outside the scope of its declaration"))

  // A branch's arms are separate scopes.
  def otherArm : Kernel := T.plain(T.b1(Stmt.ifElse(Expr.lit(1), T.b1(Stmt.decl(DType.u32, 0, Expr.lit(0))),
    T.b1(Stmt.assign(0, Expr.lit(1))))))

  def scopedOtherArm : Eq(List(String), Check.scoping(T.otherArm), T.one("v0 used outside the scope of its declaration")) :=
    Eq.refl(T.one("v0 used outside the scope of its declaration"))

  // A loop's variable is in scope in its body only: not after it, and not in its own header.
  def loopVarAfter : Kernel := T.plain(T.b2(Stmt.forLoop(0, Expr.lit(0), Expr.lit(4), Block.done), Stmt.decl(DType.u32, 1, Expr.var(0))))

  def scopedLoopVarAfter : Eq(List(String), Check.scoping(T.loopVarAfter), T.one("v0 used outside the scope of its declaration")) :=
    Eq.refl(T.one("v0 used outside the scope of its declaration"))

  def loopVarInHeader : Kernel := T.plain(T.b1(Stmt.forStride(0, Expr.lit(0), Expr.lit(4), Expr.var(0), Block.done)))

  def scopedLoopVarInHeader : Eq(List(String), Check.scoping(T.loopVarInHeader), T.one("v0 used before its declaration")) :=
    Eq.refl(T.one("v0 used before its declaration"))

  // Every declaration counts once per kernel: a loop's variable, a shared array and each kind of declaration.
  def declaredTwice : Kernel := T.plain(T.b3(Stmt.forLoop(0, Expr.lit(0), Expr.lit(4), T.b1(Stmt.declOut(DType.f32, 1))),
    Stmt.shared(DType.f32, 1, 32), Stmt.declMut(DType.u32, 0, Expr.lit(0))))

  def scopedDeclaredTwice : Eq(List(String), Check.scoping(T.declaredTwice), T.two("v1 declared twice", "v0 declared twice")) :=
    Eq.refl(T.two("v1 declared twice", "v0 declared twice"))

  // A declaration in a loop body or a branch arm is out of scope after it.
  def afterBodies : Kernel := T.plain(T.b3(Stmt.forStride(0, Expr.lit(0), Expr.lit(4), Expr.lit(1), T.b1(Stmt.decl(DType.u32, 1, Expr.var(0)))),
    Stmt.ifElse(Expr.lit(1), T.b1(Stmt.declMut(DType.u32, 2, Expr.lit(0))), Block.done),
    Stmt.decl(DType.u32, 3, Expr.bin(BinOp.add, Expr.var(1), Expr.var(2)))))

  def scopedAfterBodies : Eq(List(String), Check.scoping(T.afterBodies),
      T.two("v1 used outside the scope of its declaration", "v2 used outside the scope of its declaration")) :=
    Eq.refl(T.two("v1 used outside the scope of its declaration", "v2 used outside the scope of its declaration"))

  // A second declaration of a name in scope, and a loop variable declared again.
  def redeclared : Kernel := T.plain(T.b3(Stmt.decl(DType.u32, 0, Expr.lit(0)), Stmt.decl(DType.u32, 0, Expr.lit(1)),
    Stmt.forStride(0, Expr.lit(0), Expr.lit(4), Expr.lit(1), Block.done)))

  def scopedRedeclared : Eq(List(String), Check.scoping(T.redeclared), T.two("v0 declared twice", "v0 declared twice")) :=
    Eq.refl(T.two("v0 declared twice", "v0 declared twice"))

  // A branch's condition, an asm input, and a store's index and value are uses.
  def undeclaredOperands : Kernel := T.plain(T.b3(Stmt.ifElse(Expr.var(1), Block.done, Block.done),
    Stmt.asm("mov", List.nil(Operand), List.cons(T.r(Expr.var(2)), List.nil(Operand))),
    Stmt.store(Expr.param("N"), Expr.var(3), Expr.var(4))))

  def scopedUndeclaredOperands : Eq(List(String), Check.scoping(T.undeclaredOperands),
      List.cons("v1 used before its declaration", List.cons("v2 used before its declaration",
        T.two("v3 used before its declaration", "v4 used before its declaration")))) :=
    Eq.refl(List.cons("v1 used before its declaration", List.cons("v2 used before its declaration",
      T.two("v3 used before its declaration", "v4 used before its declaration"))))

  // An assignment's target, a store's operands and an asm operand are uses.
  def undeclaredUses : Kernel := T.plain(T.b3(Stmt.assign(5, Expr.lit(0)), Stmt.store(Expr.var(6), Expr.lit(0), Expr.lit(0)),
    Stmt.asm("mov", List.cons(Operand.mk("=r", Expr.var(7)), List.nil(Operand)), List.nil(Operand))))

  def scopedUndeclaredUses : Eq(List(String), Check.scoping(T.undeclaredUses),
      List.cons("v5 used before its declaration", T.two("v6 used before its declaration", "v7 used before its declaration"))) :=
    Eq.refl(List.cons("v5 used before its declaration", T.two("v6 used before its declaration", "v7 used before its declaration")))

  // The launcher runs on the host, where no variable is declared.
  def hostVar : Kernel := Kernel.mk("good", T.goodParams, 1024, T.goodBody, Option.some(Launcher.mk(T.hostParams,
    List.cons(Expr.bin(BinOp.lt, Expr.var(0), Expr.param("N")), List.nil(Expr)), List.cons(T.encodeA, List.nil(MapEncoding)),
    Grid.persistent(Expr.param("N")), 256)))

  def scopedHostVar : Eq(List(String), Check.scoping(T.hostVar), T.one("launcher: v0 is not a host variable")) :=
    Eq.refl(T.one("launcher: v0 is not a host variable"))

  // Nor is an index, the dynamic shared buffer or an array's element, in the requirements or the grid.
  def hostDevice : Kernel := Kernel.mk("good", T.goodParams, 1024, T.goodBody, Option.some(Launcher.mk(T.hostParams,
    List.cons(Expr.bin(BinOp.lt, Expr.sharedAddr(0), Expr.index(Expr.param("C"), Expr.lit(0))), List.nil(Expr)),
    List.cons(T.encodeA, List.nil(MapEncoding)), Grid.blocks(Expr.special(Builtin.threadX), Expr.var(1)), 256)))

  def scopedHostDevice : Eq(List(String), Check.scoping(T.hostDevice), List.cons("launcher: dynamic shared memory is not host memory",
      List.cons("launcher: an array element is device memory, not a host value",
        T.two("launcher: a thread, block or grid index is not a host value", "launcher: v1 is not a host variable")))) :=
    Eq.refl(List.cons("launcher: dynamic shared memory is not host memory",
      List.cons("launcher: an array element is device memory, not a host value",
        T.two("launcher: a thread, block or grid index is not a host value", "launcher: v1 is not a host variable"))))

  // ---- I2, shared memory ----------------------------------------------------------------------------------------------

  def tooMuchShared : Kernel := Kernel.mk("good", T.goodParams, 232449, T.goodBody, Option.some(T.launcher(List.cons(T.encodeA, List.nil(MapEncoding)))))

  def sharedTooMuch : Eq(List(String), Check.sharedMemory(T.tooMuchShared),
      T.one("232449 bytes of dynamic shared memory, more than sm_100a's 232448")) :=
    Eq.refl(T.one("232449 bytes of dynamic shared memory, more than sm_100a's 232448"))

  def unlaunched : Kernel := Kernel.mk("k", T.goodParams, 1024, T.b1(Stmt.decl(DType.u32, 0, Expr.sharedAddr(0))), Option.none(Launcher))

  def sharedUnlaunched : Eq(List(String), Check.sharedMemory(T.unlaunched),
      T.one("1024 bytes of dynamic shared memory, and no launcher to ask for them")) :=
    Eq.refl(T.one("1024 bytes of dynamic shared memory, and no launcher to ask for them"))

  def staticAndDynamic : Kernel := Kernel.mk("good", T.goodParams, 1024,
    T.b1(Stmt.scoped(T.b1(Stmt.shared(DType.f32, 7, 32)))), Option.some(T.launcher(List.cons(T.encodeA, List.nil(MapEncoding)))))

  def sharedStaticAndDynamic : Eq(List(String), Check.sharedMemory(T.staticAndDynamic),
      T.one("static shared array v7 in a kernel with dynamic shared memory")) :=
    Eq.refl(T.one("static shared array v7 in a kernel with dynamic shared memory"))

  // An address into the dynamic buffer lies inside it; a kernel without one has none.
  def outsideBuffer : Kernel := Kernel.mk("good", T.goodParams, 1024, T.b1(Stmt.decl(DType.u32, 0, Expr.sharedAddr(1024))),
    Option.some(T.launcher(List.cons(T.encodeA, List.nil(MapEncoding)))))

  def sharedOutsideBuffer : Eq(List(String), Check.sharedMemory(T.outsideBuffer),
      T.one("dynamic shared memory at byte 1024, outside the kernel's 1024 bytes")) :=
    Eq.refl(T.one("dynamic shared memory at byte 1024, outside the kernel's 1024 bytes"))

  def noBuffer : Kernel := T.plain(T.b1(Stmt.decl(DType.u32, 0, Expr.index(Expr.sharedPtr(DType.u32, 0), Expr.lit(0)))))

  def sharedNoBuffer : Eq(List(String), Check.sharedMemory(T.noBuffer),
      T.one("dynamic shared memory at byte 0, outside the kernel's 0 bytes")) :=
    Eq.refl(T.one("dynamic shared memory at byte 0, outside the kernel's 0 bytes"))

  // ---- I3, named barriers ---------------------------------------------------------------------------------------------

  def barrierIds : Kernel := T.plain(T.b2(T.bar(0, 32), T.bar(16, 32)))

  def barriersIds : Eq(List(String), Check.namedBarriers(T.barrierIds),
      T.two("bar.sync 0: the id is outside 1..15", "bar.sync 16: the id is outside 1..15")) :=
    Eq.refl(T.two("bar.sync 0: the id is outside 1..15", "bar.sync 16: the id is outside 1..15"))

  // One id per barrier, wherever they stand: here one in a loop body and one in a branch arm.
  def barrierTwice : Kernel := T.plain(T.b2(Stmt.forLoop(0, Expr.lit(0), Expr.lit(4), T.b1(T.bar(3, 32))),
    Stmt.ifElse(Expr.lit(1), Block.done, T.b1(T.bar(3, 64)))))

  def barriersTwice : Eq(List(String), Check.namedBarriers(T.barrierTwice), T.one("bar.sync 3: the id is already another barrier's")) :=
    Eq.refl(T.one("bar.sync 3: the id is already another barrier's"))

  def barrierCounts : Kernel := T.plain(T.b2(T.bar(1, 48), T.bar(2, 0)))

  def barriersCounts : Eq(List(String), Check.namedBarriers(T.barrierCounts),
      T.two("bar.sync 1: waits for 48 threads, not a positive multiple of 32", "bar.sync 2: waits for 0 threads, not a positive multiple of 32")) :=
    Eq.refl(T.two("bar.sync 1: waits for 48 threads, not a positive multiple of 32", "bar.sync 2: waits for 0 threads, not a positive multiple of 32"))

  // A `bar.sync` whose operands are not two literal inputs: a variable id, an output, a third input.
  def barrierOperands : Kernel := T.plain(T.b3(Stmt.asm(Check.barrierTemplate, List.nil(Operand), List.cons(T.r(Expr.param("N")), List.cons(T.r(Expr.lit(32)), List.nil(Operand)))),
    Stmt.asm(Check.barrierTemplate, List.cons(T.r(Expr.lit(1)), List.nil(Operand)), List.cons(T.r(Expr.lit(1)), List.cons(T.r(Expr.lit(32)), List.nil(Operand)))),
    Stmt.asm(Check.barrierTemplate, List.nil(Operand), List.cons(T.r(Expr.lit(1)), List.cons(T.r(Expr.lit(32)), List.cons(T.r(Expr.lit(0)), List.nil(Operand)))))))

  def barriersOperands : Eq(List(String), Check.namedBarriers(T.barrierOperands), List.cons("bar.sync without a literal id and thread count",
      T.two("bar.sync without a literal id and thread count", "bar.sync without a literal id and thread count"))) :=
    Eq.refl(List.cons("bar.sync without a literal id and thread count",
      T.two("bar.sync without a literal id and thread count", "bar.sync without a literal id and thread count")))

  // ---- I4, literals ---------------------------------------------------------------------------------------------------

  // Literals anywhere: in a nested block's asm operand, in a 64-bit literal, and in the launcher's requirements.
  def wideLiterals : Kernel := Kernel.mk("good", T.goodParams, 0,
    T.b2(Stmt.scoped(T.b1(Stmt.asm("mov", List.nil(Operand), List.cons(T.r(Expr.bin(BinOp.add, Expr.lit(1), Expr.lit(4294967296))), List.nil(Operand))))),
      Stmt.decl(DType.u64, 0, Expr.lit64(18446744073709551616))),
    Option.some(Launcher.mk(T.hostParams, List.cons(Expr.bin(BinOp.lt, Expr.param("N"), Expr.lit(4294967297)), List.nil(Expr)),
      List.cons(T.encodeA, List.nil(MapEncoding)), Grid.blocks(Expr.param("N"), Expr.lit(1)), 256)))

  def literalsWide : Eq(List(String), Check.literals(T.wideLiterals), List.cons("32-bit literal 4294967296 does not fit 32 bits",
      T.two("64-bit literal 18446744073709551616 does not fit 64 bits", "32-bit literal 4294967297 does not fit 32 bits"))) :=
    Eq.refl(List.cons("32-bit literal 4294967296 does not fit 32 bits",
      T.two("64-bit literal 18446744073709551616 does not fit 64 bits", "32-bit literal 4294967297 does not fit 32 bits")))

  def wideGrid : Kernel := Kernel.mk("good", T.goodParams, 0, Block.done, Option.some(Launcher.mk(T.hostParams, List.nil(Expr),
    List.cons(T.encodeA, List.nil(MapEncoding)), Grid.persistent(Expr.lit(4294967296)), 256)))

  def literalsWideGrid : Eq(List(String), Check.literals(T.wideGrid), T.one("32-bit literal 4294967296 does not fit 32 bits")) :=
    Eq.refl(T.one("32-bit literal 4294967296 does not fit 32 bits"))

  // A launcher prints its block size and each box as 32-bit literals.
  def wideLaunch : Kernel := Kernel.mk("good", T.goodParams, 1024, T.goodBody, Option.some(Launcher.mk(T.hostParams,
    List.nil(Expr), List.cons(MapEncoding.mk("A_map", MapUse.load, Param.input(DType.bf16, "A"), "N", "K", 4294967296, 4294967297), List.nil(MapEncoding)),
    Grid.blocks(Expr.param("N"), Expr.lit(1)), 4294967296)))

  def literalsWideLaunch : Eq(List(String), Check.literals(T.wideLaunch), List.cons("launcher: a block of 4294967296 does not fit 32 bits",
      T.two("launcher: A_map's box width 4294967296 does not fit 32 bits", "launcher: A_map's box height 4294967297 does not fit 32 bits"))) :=
    Eq.refl(List.cons("launcher: a block of 4294967296 does not fit 32 bits",
      T.two("launcher: A_map's box width 4294967296 does not fit 32 bits", "launcher: A_map's box height 4294967297 does not fit 32 bits")))

  // ---- I5, names ------------------------------------------------------------------------------------------------------

  def named (name: String)(ps: List(Param)): Kernel := Kernel.mk(name, ps, 0, Block.done, Option.none(Launcher))

  def namesNotIdent : Eq(List(String), Check.names(T.named("1k", List.nil(Param))), T.one("kernel name 1k is not a C identifier")) :=
    Eq.refl(T.one("kernel name 1k is not a C identifier"))

  def namesEmpty : Eq(List(String), Check.names(T.named("", List.nil(Param))), T.one("kernel name  is not a C identifier")) :=
    Eq.refl(T.one("kernel name  is not a C identifier"))

  // The printer's own names: a variable, the `gpu_` prefix, the launcher's locals.
  def namesPrinters : Eq(List(String), Check.names(T.named("v12", List.cons(Param.scalar(DType.u32, "gpu_sms"),
      List.cons(Param.scalar(DType.u32, "stream"), List.cons(Param.scalar(DType.u32, "box"), List.nil(Param)))))),
    List.cons("kernel name v12 is a name the printer declares", List.cons("parameter gpu_sms is a name the printer declares",
      T.two("parameter stream is a name the printer declares", "parameter box is a name the printer declares")))) :=
    Eq.refl(List.cons("kernel name v12 is a name the printer declares", List.cons("parameter gpu_sms is a name the printer declares",
      T.two("parameter stream is a name the printer declares", "parameter box is a name the printer declares"))))

  def namesLauncherLocals : Eq(List(String), Check.names(T.named("k", List.cons(Param.scalar(DType.u32, "status"),
      List.cons(Param.scalar(DType.u32, "args"), List.cons(Param.scalar(DType.u32, "dims"), List.cons(Param.scalar(DType.u32, "strides"),
        List.cons(Param.scalar(DType.u32, "steps"), List.nil(Param)))))))),
    List.cons("parameter status is a name the printer declares", List.cons("parameter args is a name the printer declares",
      List.cons("parameter dims is a name the printer declares", T.two("parameter strides is a name the printer declares",
        "parameter steps is a name the printer declares"))))) :=
    Eq.refl(List.cons("parameter status is a name the printer declares", List.cons("parameter args is a name the printer declares",
      List.cons("parameter dims is a name the printer declares", T.two("parameter strides is a name the printer declares",
        "parameter steps is a name the printer declares")))))

  // `v` alone, and `v` followed by anything but digits, is not a variable's name.
  def namesAlmostPrinters : Eq(List(String), Check.names(T.named("v", List.cons(Param.scalar(DType.u32, "v1x"),
      List.cons(Param.scalar(DType.u32, "gpu"), List.nil(Param))))), T.none) := Eq.refl(T.none)

  def namesParams : Eq(List(String), Check.names(T.named("k", List.cons(Param.scalar(DType.u32, "a b"),
      List.cons(Param.input(DType.f32, "k"), List.cons(Param.scalar(DType.u32, "N"), List.cons(Param.output(DType.f32, "N"), List.nil(Param))))))),
    List.cons("parameter a b is not a C identifier", T.two("parameter k is the kernel's name", "parameter N is declared twice"))) :=
    Eq.refl(List.cons("parameter a b is not a C identifier", T.two("parameter k is the kernel's name", "parameter N is declared twice")))

  // A parameter named in the body, by value or by address, is one of the kernel's.
  def unknownParams : Kernel := T.plain(T.b2(Stmt.decl(DType.u32, 0, Expr.param("M")),
    Stmt.asm("mov", List.nil(Operand), List.cons(Operand.mk("l", Expr.paramAddr("B_map")), List.nil(Operand)))))

  def namesUnknownParams : Eq(List(String), Check.names(T.unknownParams), T.two("kernel: M is not a parameter", "kernel: B_map is not a parameter")) :=
    Eq.refl(T.two("kernel: M is not a parameter", "kernel: B_map is not a parameter"))

  // The launcher declares its parameters and its tensor maps in one function; its expressions name its parameters.
  def hostNames : Kernel := Kernel.mk("good", T.goodParams, 1024, T.goodBody, Option.some(Launcher.mk(List.cons(Param.input(DType.bf16, "A_map"), List.cons(Param.scalar(DType.u32, "good"), T.hostParams)),
    List.cons(Expr.bin(BinOp.lt, Expr.param("M"), Expr.param("N")), List.nil(Expr)), List.cons(T.encodeA, List.nil(MapEncoding)),
    Grid.blocks(Expr.param("N"), Expr.lit(1)), 256)))

  def namesHost : Eq(List(String), Check.names(T.hostNames), List.cons("launcher: name good is the kernel's name",
      T.two("launcher: name A_map is declared twice", "launcher: M is not a parameter"))) :=
    Eq.refl(List.cons("launcher: name good is the kernel's name", T.two("launcher: name A_map is declared twice", "launcher: M is not a parameter")))

  // The launcher's own names are chosen names too, its tensor maps' included.
  def hostChosen : Kernel := Kernel.mk("good", List.cons(Param.tensorMap(MapUse.load, "gpu_map"), List.nil(Param)), 0, Block.done,
    Option.some(Launcher.mk(List.cons(Param.input(DType.bf16, "a-b"), List.cons(Param.scalar(DType.u32, "v3"), T.hostParams)), List.nil(Expr),
    List.cons(MapEncoding.mk("gpu_map", MapUse.load, Param.input(DType.bf16, "A"), "N", "K", 64, 128), List.nil(MapEncoding)), Grid.blocks(Expr.lit(1), Expr.lit(1)), 256)))

  def namesHostChosen : Eq(List(String), Check.names(T.hostChosen), List.cons("parameter gpu_map is a name the printer declares",
      List.cons("launcher: name a-b is not a C identifier", T.two("launcher: name v3 is a name the printer declares",
        "launcher: name gpu_map is a name the printer declares")))) :=
    Eq.refl(List.cons("parameter gpu_map is a name the printer declares", List.cons("launcher: name a-b is not a C identifier",
      T.two("launcher: name v3 is a name the printer declares", "launcher: name gpu_map is a name the printer declares"))))

  // ---- I6, the launcher -----------------------------------------------------------------------------------------------

  // A kernel parameter the launcher does not declare, or declares otherwise.
  def unpassed : Kernel := Kernel.mk("good", List.cons(Param.scalar(DType.u64, "N"), List.cons(Param.input(DType.f32, "D"), List.nil(Param))), 0,
    Block.done, Option.some(T.launcher(List.nil(MapEncoding))))

  def launcherUnpassed : Eq(List(String), Check.launcher(T.unpassed), T.two("launcher: does not declare the kernel's parameter N as the kernel does",
      "launcher: does not declare the kernel's parameter D as the kernel does")) :=
    Eq.refl(T.two("launcher: does not declare the kernel's parameter N as the kernel does", "launcher: does not declare the kernel's parameter D as the kernel does"))

  // The same name and element type, but an input rather than an output.
  def otherKind : Kernel := Kernel.mk("good", List.cons(Param.input(DType.f32, "C"), List.nil(Param)), 0, Block.done,
    Option.some(T.launcher(List.nil(MapEncoding))))

  def launcherOtherKind : Eq(List(String), Check.launcher(T.otherKind), T.one("launcher: does not declare the kernel's parameter C as the kernel does")) :=
    Eq.refl(T.one("launcher: does not declare the kernel's parameter C as the kernel does"))

  // Each tensor map is encoded exactly once, and each encoding is of one of the kernel's tensor maps.
  def unencoded : Kernel := Kernel.mk("good", T.goodParams, 0, Block.done, Option.some(T.launcher(List.nil(MapEncoding))))

  def launcherUnencoded : Eq(List(String), Check.launcher(T.unencoded), T.one("launcher: tensor map A_map has 0 encodings, not one")) :=
    Eq.refl(T.one("launcher: tensor map A_map has 0 encodings, not one"))

  def encodedTwice : Kernel := Kernel.mk("good", T.goodParams, 0, Block.done,
    Option.some(T.launcher(List.cons(T.encodeA, List.cons(T.encodeA, List.cons(MapEncoding.mk("C", MapUse.load, Param.input(DType.bf16, "A"), "N", "K", 64, 8), List.nil(MapEncoding)))))))

  def launcherEncodedTwice : Eq(List(String), Check.launcher(T.encodedTwice), T.two("launcher: tensor map A_map has 2 encodings, not one",
      "launcher: the encoding of C names no load map of the kernel")) :=
    Eq.refl(T.two("launcher: tensor map A_map has 2 encodings, not one", "launcher: the encoding of C names no load map of the kernel"))

  // An encoding reads an array of the launcher that its use needs, with u32 scalars for its extents.
  def badSources : Kernel := Kernel.mk("good", T.goodParams, 0, Block.done,
    Option.some(T.launcher(List.cons(MapEncoding.mk("A_map", MapUse.load, Param.input(DType.f32, "C"), "A", "Q", 64, 128), List.nil(MapEncoding)))))

  def launcherBadSources : Eq(List(String), Check.launcher(T.badSources), List.cons("launcher: the encoding of A_map reads C, not a bf16 input",
      List.cons("launcher: the encoding of A_map reads C, which the launcher does not declare so",
      T.two("launcher: the encoding of A_map takes rows from A, not a u32 scalar of the launcher",
        "launcher: the encoding of A_map takes columns from Q, not a u32 scalar of the launcher")))) :=
    Eq.refl(List.cons("launcher: the encoding of A_map reads C, not a bf16 input",
      List.cons("launcher: the encoding of A_map reads C, which the launcher does not declare so",
      T.two("launcher: the encoding of A_map takes rows from A, not a u32 scalar of the launcher",
        "launcher: the encoding of A_map takes columns from Q, not a u32 scalar of the launcher"))))

  // A map the kernel stores through is encoded over an f32 output of the launcher.
  def storeParams : List(Param) := List.cons(Param.tensorMap(MapUse.load, "A_map"), List.cons(Param.tensorMap(MapUse.store, "C_map"), List.cons(T.n, List.nil(Param))))

  def storeMap (source: Param): Kernel := Kernel.mk("good", T.storeParams, 0, Block.done,
    Option.some(T.launcher(List.cons(T.encodeA, List.cons(MapEncoding.mk("C_map", MapUse.store, source, "N", "K", 32, 32), List.nil(MapEncoding))))))

  def launcherStoreMap : Eq(List(String), Check.launcher(T.storeMap(Param.output(DType.f32, "C"))), T.none) := Eq.refl(T.none)

  // An output of another element type, an input of the output's type, a bf16 input (an operand), a scalar, and an
  // output the launcher does not have.
  def launcherStoreBf16 : Eq(List(String), Check.launcher(T.storeMap(Param.output(DType.bf16, "C"))),
      T.two("launcher: the encoding of C_map reads C, not an f32 output", "launcher: the encoding of C_map reads C, which the launcher does not declare so")) :=
    Eq.refl(T.two("launcher: the encoding of C_map reads C, not an f32 output", "launcher: the encoding of C_map reads C, which the launcher does not declare so"))

  def launcherStoreInput : Eq(List(String), Check.launcher(T.storeMap(Param.input(DType.f32, "C"))),
      T.two("launcher: the encoding of C_map reads C, not an f32 output", "launcher: the encoding of C_map reads C, which the launcher does not declare so")) :=
    Eq.refl(T.two("launcher: the encoding of C_map reads C, not an f32 output", "launcher: the encoding of C_map reads C, which the launcher does not declare so"))

  def launcherStoreOperand : Eq(List(String), Check.launcher(T.storeMap(Param.input(DType.bf16, "A"))),
      T.one("launcher: the encoding of C_map reads A, not an f32 output")) :=
    Eq.refl(T.one("launcher: the encoding of C_map reads A, not an f32 output"))

  def launcherStoreScalar : Eq(List(String), Check.launcher(T.storeMap(Param.scalar(DType.u32, "N"))),
      T.one("launcher: the encoding of C_map reads N, not an f32 output")) :=
    Eq.refl(T.one("launcher: the encoding of C_map reads N, not an f32 output"))

  def launcherStoreUndeclared : Eq(List(String), Check.launcher(T.storeMap(Param.output(DType.f32, "D"))),
      T.one("launcher: the encoding of C_map reads D, which the launcher does not declare so")) :=
    Eq.refl(T.one("launcher: the encoding of C_map reads D, which the launcher does not declare so"))

  // The maps' roles swapped: the load map encoded over the output, the store map over an operand. And an encoding that
  // claims another use than the kernel declares.
  def swapped : Kernel := Kernel.mk("good", T.storeParams, 0, Block.done, Option.some(T.launcher(
    List.cons(MapEncoding.mk("A_map", MapUse.load, Param.output(DType.f32, "C"), "N", "K", 64, 128),
      List.cons(MapEncoding.mk("C_map", MapUse.store, Param.input(DType.bf16, "A"), "N", "K", 32, 32), List.nil(MapEncoding))))))

  def launcherSwapped : Eq(List(String), Check.launcher(T.swapped),
      T.two("launcher: the encoding of A_map reads C, not a bf16 input", "launcher: the encoding of C_map reads A, not an f32 output")) :=
    Eq.refl(T.two("launcher: the encoding of A_map reads C, not a bf16 input", "launcher: the encoding of C_map reads A, not an f32 output"))

  def misused : Kernel := Kernel.mk("good", T.storeParams, 0, Block.done, Option.some(T.launcher(
    List.cons(T.encodeA, List.cons(MapEncoding.mk("C_map", MapUse.load, Param.input(DType.bf16, "A"), "N", "K", 32, 32), List.nil(MapEncoding))))))

  def launcherMisused : Eq(List(String), Check.launcher(T.misused), T.one("launcher: the encoding of C_map names no load map of the kernel")) :=
    Eq.refl(T.one("launcher: the encoding of C_map names no load map of the kernel"))
}
