// A client's own function over programs forwards `render`'s certificate, stated as `Gpu.WellFormed`, and a call with
// a concrete program discharges it.
import Gpu

namespace T {
  open Gpu
  open Cuda

  def G : Group := Group.cta(256)

  def show (p: Program)[ok: Gpu.WellFormed(p)]: String := Gpu.render(p)[ok]

  def kernel : Program := Gpu.tiledKernel("copy16", DType.f32, 16,
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) => {
      let (e, x) := Gpu.gload(e, k.a, k.row, k.col)
      Gpu.gstore(e, k.c, c, x)
    })

  def shown : String := T.show(T.kernel)
}
