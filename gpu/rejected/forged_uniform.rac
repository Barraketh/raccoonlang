// expect: SealedConstructor
// A value that claims to be the same in every thread while it is the thread index: a branch on it would keep the
// whole CTA as the arm's group, so a barrier inside it would run under a divergent condition. Only the kernel builders
// name kernel parameters, so a program cannot make a value from a name of its choosing.
import Gpu
namespace T {
  open Gpu
  open Cuda
  def G : Group := Group.cta(256)

  def kernel : Program := Gpu.tiledKernel("bad", DType.f32, 16, Eq.refl(Bool.true),
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) => {
      let tid := Gpu.uniformParam(Key.key, l, "threadIdx.x")
      let yes := fun (m: Lifetime)(e: Ctx(m, T.G))(s: Unit): Pair(Ctx(m, T.G), Unit) => (e, s)
      let (e, s) := Gpu.branch(e, Gpu.lt(tid, Gpu.lit(1)), Gpu.fixedUnit, Unit.unit, yes, yes)
      Gpu.gstore(e, k.c, c, Gpu.zero(DType.f32))
    })
}
{ Gpu.render(T.kernel) }
