// expect: LinearReused
// The CTA's output block is written exactly once.
import Gpu
namespace T {
  open Gpu
  open Cuda
  def G : Group := Group.cta(256)

  def kernel : Program := Gpu.tiledKernel("bad", DType.f32, 16,
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) => {
      let e := Gpu.gstore(e, k.c, c, Gpu.zero(DType.f32))
      Gpu.gstore(e, k.c, c, Gpu.zero(DType.f32))
    })
}
{ Gpu.render(T.kernel) }
