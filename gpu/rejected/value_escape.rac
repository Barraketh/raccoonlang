// expect: TypeMismatch
// A loop that tries to carry its own index out as loop state. The index lives in the body's lifetime `m`; the state
// type is fixed outside the loop and cannot name `m`, so the body's type does not fit.
import Gpu
namespace T {
  open Gpu
  open Cuda
  def G : Group := Group.cta(256)
  def U : Type := Val(Lifetime.empty, Grain.uniform, DType.u32)

  def kernel : Kernel := Gpu.tiledKernel("bad", DType.f32, 16, Eq.refl(Bool.true),
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) => {
      let body := fun (m: Lifetime)(i: Val(m, Grain.uniform, DType.u32))(e: Ctx(m, T.G))(s: T.U)
          : LPair(Ctx(m, T.G), Val(m, Grain.uniform, DType.u32)) => LPair.mk(e, i)
      match Gpu.loop(e, k.k, Gpu.lit(0), body) returning Ctx(l, T.G) with
      | LPair.mk e last => Gpu.gstore(e, k.c, c, Gpu.zero(DType.f32))
    })
}
{ Cuda.kernel(T.kernel) }
