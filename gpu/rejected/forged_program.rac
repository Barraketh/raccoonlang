// expect: SealedConstructor
// A kernel built by hand and passed off as one the typed core built. Only Gpu builds a `Program`, the one thing
// `Gpu.render` prints.
import Gpu
namespace T {
  open Gpu
  open Cuda

  def raw : Kernel := Kernel.mk("raw", List.cons(Param.output(DType.f32, "C"), List.nil(Param)), 0,
    Block.seq(Stmt.store(Expr.param("C"), Expr.lit(0), Expr.special(Builtin.threadX)), Block.done), Option.none(Launcher))

  def kernel : Program := Program.mk(T.raw)
}
{ Gpu.render(T.kernel) }
