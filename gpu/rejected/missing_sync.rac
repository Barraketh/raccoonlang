// expect: TypeMismatch
// A K-step that reads the tile and loops back without a barrier: the next iteration's writes would race with this
// iteration's reads. The step returns the tile `reading`, not `empty`.
import Gpu
namespace T {
  open Gpu
  open Cuda
  def G : Group := Group.cta(256)
  def Tl (a: Lifetime)(s: TileState) : Type { kind = lin, scope = a } := Tile(a, DType.f32, 256, s)

  def kernel : Kernel := Gpu.tiledKernel("bad", DType.f32, 16, Eq.refl(Bool.true),
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) =>
      Gpu.shared(e, DType.f32, 256, fun (a: Lifetime)(sa: Smem(a, DType.f32, 256))(ta: T.Tl(a, TileState.empty))(e: Ctx(l, T.G)): Ctx(l, T.G) => {
        let body := fun (m: Lifetime)(i: Val(m, Grain.uniform, DType.u32))(e: Ctx(m, T.G))(t: T.Tl(a, TileState.empty))
            : Pair(Ctx(m, T.G), T.Tl(a, TileState.empty)) => {
          match Gpu.storeMine(e, sa, t, Gpu.zero(DType.f32)) returning Pair(Ctx(m, T.G), T.Tl(a, TileState.empty)) with
          | Pair.mk e t => {
            match Gpu.sync1(e, t) returning Pair(Ctx(m, T.G), T.Tl(a, TileState.empty)) with
            | Pair.mk e t => {
              let use := fun (r: Lifetime)(rd: SRead(a, r, DType.f32, 256))(e: Ctx(m, T.G)): Pair(Ctx(m, T.G), Unit) => {
                match Gpu.sread(e, sa, rd, k.tx) returning Pair(Ctx(m, T.G), Unit) with
                | Pair.mk e x => Pair.mk(e, Unit.unit)
              }
              match Gpu.reads(e, t, use) returning Pair(Ctx(m, T.G), T.Tl(a, TileState.empty)) with
              | Pair.mk e out => {
                match out returning Pair(Ctx(m, T.G), T.Tl(a, TileState.empty)) with
                | Pair.mk t done => Pair.mk(e, t)
              }
            }
          }
        }
        match Gpu.loop(e, k.k, Gpu.fixedTile(a, DType.f32, 256, TileState.empty), ta, body) returning Ctx(l, T.G) with
        | Pair.mk e t => {
          let _ := Gpu.release(t)
          Gpu.gstore(e, k.c, c, Gpu.zero(DType.f32))
        }
      }))
}
{ Cuda.kernel(T.kernel) }
