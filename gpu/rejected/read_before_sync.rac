// expect: TypeMismatch
// Reading a tile right after every thread wrote its own element, with no barrier between: `reads` needs `ready`,
// and the tile is `written`.
import Gpu
namespace T {
  open Gpu
  open Cuda
  def G : Group := Group.cta(256)

  def kernel : Kernel := Gpu.tiledKernel("bad", DType.f32, 16, Eq.refl(Bool.true),
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) =>
      Gpu.shared(e, DType.f32, 256, fun (a: Lifetime)(sa: Smem(a, DType.f32, 256))(ta: Tile(a, DType.f32, 256, TileState.empty))(e: Ctx(l, T.G)): Ctx(l, T.G) => {
        match Gpu.storeMine(e, sa, ta, Gpu.zero(DType.f32)) returning Ctx(l, T.G) with
        | LPair.mk e t => {
          let use := fun (r: Lifetime)(rd: SRead(a, r, DType.f32, 256))(e: Ctx(l, T.G)): LPair(Ctx(l, T.G), Val(l, Grain.thread, DType.f32)) =>
            Gpu.sread(e, sa, rd, k.tx)
          match Gpu.reads(e, t, use) returning Ctx(l, T.G) with
          | LPair.mk e out => {
            match out returning Ctx(l, T.G) with
            | LPair.mk t v => {
              let _ := Gpu.release(t)
              Gpu.gstore(e, k.c, c, v)
            }
          }
        }
      }))
}
{ Cuda.kernel(T.kernel) }
