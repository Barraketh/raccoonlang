// What the structural invariants of gpu/OBLIGATIONS.md §4 mean, stated on a kernel's AST without reference to how
// gpu/Check.rac decides them. Each invariant is a universal over an occurrence relation: whatever occurs in the kernel
// in some way has some property. gpu/proofs/ proves each checker sound against its statement here, so this file is
// part of what is trusted: it should say what the invariant means, and nothing else.

import Cuda

namespace Spec {
  open Cuda

  // ---- Occurrence ---------------------------------------------------------------------------------------------------

  // `x` is an element of `xs`.
  inductive Mem (A: Type)(x: A) indices (xs: List(A)) : Prop
   | here (rest: List(A)) : Mem(A, x, List.cons(x, rest))
   | there (y: A)(rest: List(A))(h: Mem(A, x, rest)) : Mem(A, x, List.cons(y, rest))

  // `x` is `e` or one of its subexpressions.
  inductive SubExpr (x: Expr) indices (e: Expr) : Prop
   | here : SubExpr(x, x)
   | binA (op: BinOp)(a: Expr)(b: Expr)(h: SubExpr(x, a)) : SubExpr(x, Expr.bin(op, a, b))
   | binB (op: BinOp)(a: Expr)(b: Expr)(h: SubExpr(x, b)) : SubExpr(x, Expr.bin(op, a, b))
   | maxA (a: Expr)(b: Expr)(h: SubExpr(x, a)) : SubExpr(x, Expr.max(a, b))
   | maxB (a: Expr)(b: Expr)(h: SubExpr(x, b)) : SubExpr(x, Expr.max(a, b))
   | fmaA (a: Expr)(b: Expr)(c: Expr)(h: SubExpr(x, a)) : SubExpr(x, Expr.fma(a, b, c))
   | fmaB (a: Expr)(b: Expr)(c: Expr)(h: SubExpr(x, b)) : SubExpr(x, Expr.fma(a, b, c))
   | fmaC (a: Expr)(b: Expr)(c: Expr)(h: SubExpr(x, c)) : SubExpr(x, Expr.fma(a, b, c))
   | selectC (c: Expr)(t: Expr)(f: Expr)(h: SubExpr(x, c)) : SubExpr(x, Expr.select(c, t, f))
   | selectT (c: Expr)(t: Expr)(f: Expr)(h: SubExpr(x, t)) : SubExpr(x, Expr.select(c, t, f))
   | selectF (c: Expr)(t: Expr)(f: Expr)(h: SubExpr(x, f)) : SubExpr(x, Expr.select(c, t, f))
   | indexBase (base: Expr)(i: Expr)(h: SubExpr(x, base)) : SubExpr(x, Expr.index(base, i))
   | indexI (base: Expr)(i: Expr)(h: SubExpr(x, i)) : SubExpr(x, Expr.index(base, i))
   | cast (t: DType)(a: Expr)(h: SubExpr(x, a)) : SubExpr(x, Expr.cast(t, a))

  mutual {
    // `x` is `s` or a statement in one of its blocks, at any depth.
    inductive InStmt (x: Stmt) indices (s: Stmt) : Prop
     | here : InStmt(x, x)
     | forLoop (id: Nat)(start: Expr)(count: Expr)(body: Block)(h: InBlock(x, body)) : InStmt(x, Stmt.forLoop(id, start, count, body))
     | forStride (id: Nat)(start: Expr)(stop: Expr)(step: Expr)(body: Block)(h: InBlock(x, body))
         : InStmt(x, Stmt.forStride(id, start, stop, step, body))
     | ifYes (c: Expr)(yes: Block)(no: Block)(h: InBlock(x, yes)) : InStmt(x, Stmt.ifElse(c, yes, no))
     | ifNo (c: Expr)(yes: Block)(no: Block)(h: InBlock(x, no)) : InStmt(x, Stmt.ifElse(c, yes, no))
     | scoped (body: Block)(h: InBlock(x, body)) : InStmt(x, Stmt.scoped(body))

    // `x` is a statement of `b`, or in the blocks of one, at any depth.
    inductive InBlock (x: Stmt) indices (b: Block) : Prop
     | head (s: Stmt)(rest: Block)(h: InStmt(x, s)) : InBlock(x, Block.seq(s, rest))
     | tail (s: Stmt)(rest: Block)(h: InBlock(x, rest)) : InBlock(x, Block.seq(s, rest))
  }

  mutual {
    // The statements in the blocks of `s`, at any depth, in program order.
    def inner (s: Stmt): List(Stmt) decreases structural(s) := {
      match s returning List(Stmt) with
      | Stmt.decl t id init => List.nil(Stmt)
      | Stmt.declMut t id init => List.nil(Stmt)
      | Stmt.declOut t id => List.nil(Stmt)
      | Stmt.assign id value => List.nil(Stmt)
      | Stmt.store base i value => List.nil(Stmt)
      | Stmt.shared t id size => List.nil(Stmt)
      | Stmt.forLoop id start count body => Spec.statements(body)
      | Stmt.forStride id start stop step body => Spec.statements(body)
      | Stmt.ifElse c yes no => List.append(Spec.statements(yes), Spec.statements(no))
      | Stmt.scoped body => Spec.statements(body)
      | Stmt.sync => List.nil(Stmt)
      | Stmt.syncWarp => List.nil(Stmt)
      | Stmt.asm template outs ins => List.nil(Stmt)
      | Stmt.instr i => List.nil(Stmt)
      | Stmt.error message => List.nil(Stmt)
    }

    // The statements of `b`, and those in their blocks, at any depth, in program order.
    def statements (b: Block): List(Stmt) decreases structural(b) := {
      match b returning List(Stmt) with
      | Block.done => List.nil(Stmt)
      | Block.seq s rest => List.cons(s, List.append(Spec.inner(s), Spec.statements(rest)))
    }
  }

  // `x` comes before `y` in `xs`, at another place.
  inductive Before (A: Type)(x: A)(y: A) indices (xs: List(A)) : Prop
   | here (rest: List(A))(later: Mem(A, y, rest)) : Before(A, x, y, List.cons(x, rest))
   | there (z: A)(rest: List(A))(h: Before(A, x, y, rest)) : Before(A, x, y, List.cons(z, rest))

  // `x` is, or is inside, an expression that statement `s` holds itself (not in its blocks): an initializer, an
  // assigned or stored value, a store's address or index, a loop's header, a branch's condition, an asm operand, an
  // expression an instruction prints as an operand (`Cuda.instrExprs`).
  inductive OwnExpr (x: Expr) indices (s: Stmt) : Prop
   | decl (t: DType)(id: Nat)(init: Expr)(h: SubExpr(x, init)) : OwnExpr(x, Stmt.decl(t, id, init))
   | declMut (t: DType)(id: Nat)(init: Expr)(h: SubExpr(x, init)) : OwnExpr(x, Stmt.declMut(t, id, init))
   | assign (id: Nat)(value: Expr)(h: SubExpr(x, value)) : OwnExpr(x, Stmt.assign(id, value))
   | storeBase (base: Expr)(i: Expr)(value: Expr)(h: SubExpr(x, base)) : OwnExpr(x, Stmt.store(base, i, value))
   | storeIndex (base: Expr)(i: Expr)(value: Expr)(h: SubExpr(x, i)) : OwnExpr(x, Stmt.store(base, i, value))
   | storeValue (base: Expr)(i: Expr)(value: Expr)(h: SubExpr(x, value)) : OwnExpr(x, Stmt.store(base, i, value))
   | forStart (id: Nat)(start: Expr)(count: Expr)(body: Block)(h: SubExpr(x, start)) : OwnExpr(x, Stmt.forLoop(id, start, count, body))
   | forCount (id: Nat)(start: Expr)(count: Expr)(body: Block)(h: SubExpr(x, count)) : OwnExpr(x, Stmt.forLoop(id, start, count, body))
   | strideStart (id: Nat)(start: Expr)(stop: Expr)(step: Expr)(body: Block)(h: SubExpr(x, start))
       : OwnExpr(x, Stmt.forStride(id, start, stop, step, body))
   | strideStop (id: Nat)(start: Expr)(stop: Expr)(step: Expr)(body: Block)(h: SubExpr(x, stop))
       : OwnExpr(x, Stmt.forStride(id, start, stop, step, body))
   | strideStep (id: Nat)(start: Expr)(stop: Expr)(step: Expr)(body: Block)(h: SubExpr(x, step))
       : OwnExpr(x, Stmt.forStride(id, start, stop, step, body))
   | cond (c: Expr)(yes: Block)(no: Block)(h: SubExpr(x, c)) : OwnExpr(x, Stmt.ifElse(c, yes, no))
   | asmOut (template: String)(outs: List(Operand))(ins: List(Operand))(o: Operand)(operand: Mem(Operand, o, outs))(h: SubExpr(x, o.e))
       : OwnExpr(x, Stmt.asm(template, outs, ins))
   | asmIn (template: String)(outs: List(Operand))(ins: List(Operand))(o: Operand)(operand: Mem(Operand, o, ins))(h: SubExpr(x, o.e))
       : OwnExpr(x, Stmt.asm(template, outs, ins))
   | instr (i: Instr)(y: Expr)(operand: Mem(Expr, y, Cuda.instrExprs(i)))(h: SubExpr(x, y)) : OwnExpr(x, Stmt.instr(i))

  // `x` occurs in an expression of block `b`.
  inductive ExprIn (x: Expr)(b: Block) : Prop
   | mk (s: Stmt)(stmt: InBlock(s, b))(own: OwnExpr(x, s)) : ExprIn(x, b)

  // `root` is an expression of grid `g`.
  inductive GridExpr (root: Expr) indices (g: Grid) : Prop
   | blocksX (y: Expr) : GridExpr(root, Grid.blocks(root, y))
   | blocksY (x: Expr) : GridExpr(root, Grid.blocks(x, root))
   | persistent : GridExpr(root, Grid.persistent(root))
   | pairsX (y: Expr) : GridExpr(root, Grid.pairs(root, y))
   | pairsY (x: Expr) : GridExpr(root, Grid.pairs(x, root))
   | persistentPairs : GridExpr(root, Grid.persistentPairs(root))

  // `root` is an expression launcher `l` evaluates on the host: a requirement, or its grid's extent.
  inductive HostRoot (l: Launcher)(root: Expr) : Prop
   | require (h: Mem(Expr, root, l.requires)) : HostRoot(l, root)
   | grid (h: GridExpr(root, l.grid)) : HostRoot(l, root)

  // `x` occurs in an expression launcher `l` evaluates on the host.
  inductive LauncherExpr (l: Launcher)(x: Expr) : Prop
   | mk (root: Expr)(evaluated: HostRoot(l, root))(sub: SubExpr(x, root)) : LauncherExpr(l, x)

  // `x` occurs in an expression the launcher of kernel `k` evaluates on the host.
  inductive HostExpr (k: Kernel)(x: Expr) : Prop
   | mk (l: Launcher)(launched: Eq(Option(Launcher), k.launcher, Option.some(l)))(h: LauncherExpr(l, x)) : HostExpr(k, x)

  // ---- Generation errors --------------------------------------------------------------------------------------------

  // The kernel has no `#error` line.
  def NoErrors (k: Kernel): Prop := (m: String) -> Spec.InBlock(Stmt.error(m), k.body) -> False

  // ---- I1, scoping --------------------------------------------------------------------------------------------------

  // The variables `s` declares for the rest of its block: a declaration's and a shared array's.
  def declaredBy (s: Stmt): List(Nat) := {
    match s returning List(Nat) with
    | Stmt.decl t id init => List.cons(id, List.nil(Nat))
    | Stmt.declMut t id init => List.cons(id, List.nil(Nat))
    | Stmt.declOut t id => List.cons(id, List.nil(Nat))
    | Stmt.assign id value => List.nil(Nat)
    | Stmt.store base i value => List.nil(Nat)
    | Stmt.shared t id size => List.cons(id, List.nil(Nat))
    | Stmt.forLoop id start count body => List.nil(Nat)
    | Stmt.forStride id start stop step body => List.nil(Nat)
    | Stmt.ifElse c yes no => List.nil(Nat)
    | Stmt.scoped body => List.nil(Nat)
    | Stmt.sync => List.nil(Nat)
    | Stmt.syncWarp => List.nil(Nat)
    | Stmt.asm template outs ins => List.nil(Nat)
    | Stmt.instr i => List.nil(Nat)
    | Stmt.error message => List.nil(Nat)
  }

  mutual {
    // `x` occurs in `s`, where the variables `vars` are in scope, and `visible` at `x`. A loop's variable is
    // in scope in its body.
    inductive StmtScope (x: Stmt)(visible: List(Nat)) indices (vars: List(Nat))(s: Stmt) : Prop
     | here : StmtScope(x, visible, visible, x)
     | forLoop (vars: List(Nat))(id: Nat)(start: Expr)(count: Expr)(body: Block)(h: BlockScope(x, visible, List.cons(id, vars), body))
         : StmtScope(x, visible, vars, Stmt.forLoop(id, start, count, body))
     | forStride (vars: List(Nat))(id: Nat)(start: Expr)(stop: Expr)(step: Expr)(body: Block)(h: BlockScope(x, visible, List.cons(id, vars), body))
         : StmtScope(x, visible, vars, Stmt.forStride(id, start, stop, step, body))
     | ifYes (vars: List(Nat))(c: Expr)(yes: Block)(no: Block)(h: BlockScope(x, visible, vars, yes)) : StmtScope(x, visible, vars, Stmt.ifElse(c, yes, no))
     | ifNo (vars: List(Nat))(c: Expr)(yes: Block)(no: Block)(h: BlockScope(x, visible, vars, no)) : StmtScope(x, visible, vars, Stmt.ifElse(c, yes, no))
     | scoped (vars: List(Nat))(body: Block)(h: BlockScope(x, visible, vars, body)) : StmtScope(x, visible, vars, Stmt.scoped(body))

    // `x` occurs in `b`, where `vars` are in scope, and `visible` at `x`. A block is a C scope: what a
    // statement declares is in scope for the rest of it.
    inductive BlockScope (x: Stmt)(visible: List(Nat)) indices (vars: List(Nat))(b: Block) : Prop
     | head (vars: List(Nat))(s: Stmt)(rest: Block)(h: StmtScope(x, visible, vars, s)) : BlockScope(x, visible, vars, Block.seq(s, rest))
     | tail (vars: List(Nat))(s: Stmt)(rest: Block)(h: BlockScope(x, visible, List.append(Spec.declaredBy(s), vars), rest))
         : BlockScope(x, visible, vars, Block.seq(s, rest))
  }

  // Statement `s` uses variable `id` itself: in one of its expressions, or as an assignment's target.
  inductive Uses (id: Nat) indices (s: Stmt) : Prop
   | expr (s: Stmt)(h: OwnExpr(Expr.var(id), s)) : Uses(id, s)
   | target (value: Expr) : Uses(id, Stmt.assign(id, value))

  // Statement `s` declares id `id`: a declaration, a shared array, or a loop's variable.
  inductive Binds (id: Nat) indices (s: Stmt) : Prop
   | decl (t: DType)(init: Expr) : Binds(id, Stmt.decl(t, id, init))
   | declMut (t: DType)(init: Expr) : Binds(id, Stmt.declMut(t, id, init))
   | declOut (t: DType) : Binds(id, Stmt.declOut(t, id))
   | shared (t: DType)(size: Nat) : Binds(id, Stmt.shared(t, id, size))
   | forLoop (start: Expr)(count: Expr)(body: Block) : Binds(id, Stmt.forLoop(id, start, count, body))
   | forStride (start: Expr)(stop: Expr)(step: Expr)(body: Block) : Binds(id, Stmt.forStride(id, start, stop, step, body))

  // An expression only the device can evaluate: a variable, a thread, block or grid index, an array element (arrays
  // are device memory), or the dynamic shared buffer.
  inductive DeviceOnly indices (x: Expr) : Prop
   | var (id: Nat) : DeviceOnly(Expr.var(id))
   | special (b: Builtin) : DeviceOnly(Expr.special(b))
   | element (base: Expr)(i: Expr) : DeviceOnly(Expr.index(base, i))
   | sharedAddr (offset: Nat) : DeviceOnly(Expr.sharedAddr(offset))
   | sharedPtr (t: DType)(offset: Nat) : DeviceOnly(Expr.sharedPtr(t, offset))

  // I1: each statement uses only variables in scope where it stands, no two statements declare one id, and the
  // launcher evaluates nothing only the device can.
  struct Scoping (k: Kernel) : Prop
   | mk (inScope: (x: Stmt) -> (visible: List(Nat)) -> Spec.BlockScope(x, visible, List.nil(Nat), k.body) -> (id: Nat) -> Spec.Uses(id, x) -> Mem(Nat, id, visible))
        (once: (x: Stmt) -> (y: Stmt) -> (id: Nat) -> Spec.Before(Stmt, x, y, Spec.statements(k.body)) -> Spec.Binds(id, x) -> Spec.Binds(id, y) -> False)
        (host: (x: Expr) -> Spec.HostExpr(k, x) -> Spec.DeviceOnly(x) -> False) : Scoping(k)

  // ---- I2, shared memory --------------------------------------------------------------------------------------------

  // The dynamic shared memory an sm_100a CTA can have.
  def maxDynamicShared : Nat := 232448

  // `offset` is a constant offset into the dynamic shared buffer, taken as a shared-window address or as a pointer.
  inductive SharedAt (b: Block)(offset: Nat) : Prop
   | addr (h: Spec.ExprIn(Expr.sharedAddr(offset), b)) : SharedAt(b, offset)
   | ptr (t: DType)(h: Spec.ExprIn(Expr.sharedPtr(t, offset), b)) : SharedAt(b, offset)

  // I2, as far as the AST shows it: the dynamic buffer fits an SM; a kernel that has one has a launcher and no static
  // shared array; every constant offset into it lies inside it.
  struct SharedMemory (k: Kernel) : Prop
   | mk (fits: Nat.le(k.dynamicShared, Spec.maxDynamicShared))
        (launched: Nat.lt(0, k.dynamicShared) -> Not(Eq(Option(Launcher), k.launcher, Option.none(Launcher))))
        (noStatic: (t: DType) -> (id: Nat) -> (size: Nat) -> Spec.InBlock(Stmt.shared(t, id, size), k.body) -> Eq(Nat, k.dynamicShared, 0))
        (inside: (offset: Nat) -> Spec.SharedAt(k.body, offset) -> Nat.lt(offset, k.dynamicShared)) : SharedMemory(k)

  // ---- I3, named barriers -------------------------------------------------------------------------------------------

  // Two 32-bit literals.
  inductive LiteralPair indices (a: Expr)(b: Expr) : Prop
   | mk (id: Nat)(threads: Nat) : LiteralPair(Expr.lit(id), Expr.lit(threads))

  // `s` is the named barrier `bar.sync id, threads`.
  inductive Barrier (id: Nat)(threads: Nat) indices (s: Stmt) : Prop
   | mk : Barrier(id, threads, Stmt.instr(Instr.barSync(Expr.lit(id), Expr.lit(threads))))

  // `s` begins with `p`.
  inductive Prefixed (p: List(Char))(s: List(Char)) : Prop
   | mk (rest: List(Char))(spelled: Eq(List(Char), s, List.append(p, rest))) : Prefixed(p, s)

  // An asm template of a CTA barrier instruction: `bar.…`, or `barrier.…` but not the cluster barrier's.
  def CtaBarrierTemplate (t: String): Prop :=
    Or(Spec.Prefixed("bar.".data, t.data), And(Spec.Prefixed("barrier.".data, t.data), Not(Spec.Prefixed("barrier.cluster".data, t.data))))

  // Each `bar.sync` has literal operands and an id in 1..15, and no two have one id; and no asm statement is a CTA
  // barrier, so every named barrier is a `bar.sync` here.
  struct BarrierIds (k: Kernel) : Prop
   | mk (literal: (a: Expr) -> (b: Expr) -> Spec.InBlock(Stmt.instr(Instr.barSync(a, b)), k.body) -> Spec.LiteralPair(a, b))
        (noTemplate: (t: String) -> (outs: List(Operand)) -> (ins: List(Operand)) -> Spec.InBlock(Stmt.asm(t, outs, ins), k.body)
          -> Not(Spec.CtaBarrierTemplate(t)))
        (inRange: (s: Stmt) -> (id: Nat) -> (threads: Nat) -> Spec.InBlock(s, k.body) -> Spec.Barrier(id, threads, s) -> And(Nat.le(1, id), Nat.le(id, 15)))
        (distinct: (x: Stmt) -> (y: Stmt) -> (id: Nat) -> (tx: Nat) -> (ty: Nat) -> Spec.Before(Stmt, x, y, Spec.statements(k.body))
          -> Spec.Barrier(id, tx, x) -> Spec.Barrier(id, ty, y) -> False) : BarrierIds(k)

  // Each `bar.sync` waits for a positive multiple of 32 threads. (A definition, not a field: declaring an inductive
  // whose field's type applies `Nat.mod` to a variable takes time exponential in the modulus.)
  def BarrierCounts (k: Kernel): Prop :=
    (s: Stmt) -> (id: Nat) -> (threads: Nat) -> Spec.InBlock(s, k.body) -> Spec.Barrier(id, threads, s) -> And(Nat.lt(0, threads), Eq(Nat, Nat.mod(threads, 32), 0))

  // I3, as far as the AST shows it.
  def NamedBarriers (k: Kernel): Prop := And(Spec.BarrierIds(k), Spec.BarrierCounts(k))

  // ---- I4, literals -------------------------------------------------------------------------------------------------

  // Every value of a 64-bit unsigned integer is below it.
  def u64Limit : Nat := 18446744073709551616

  // `n` is printed as a 32-bit literal: a `lit` in the kernel or its launcher, the launcher's block size, or a
  // dimension of a tensor map's box. The printer also writes a shared-window address's offset and the launch's dynamic
  // shared bytes as `u` literals; those are not here. In the body `Spec.SharedMemory` bounds them (an offset below the
  // size, the size at most 232448), and `Spec.Scoping` rules shared addresses out of the launcher; `Spec.WellFormed`
  // holds all three.
  inductive Lit32 (k: Kernel)(n: Nat) : Prop
   | body (h: Spec.ExprIn(Expr.lit(n), k.body)) : Lit32(k, n)
   | host (h: Spec.HostExpr(k, Expr.lit(n))) : Lit32(k, n)
   | block (l: Launcher)(launched: Eq(Option(Launcher), k.launcher, Option.some(l)))(size: Eq(Nat, l.block, n)) : Lit32(k, n)
   | boxInner (l: Launcher)(launched: Eq(Option(Launcher), k.launcher, Option.some(l)))(m: MapEncoding)
       (encoded: Mem(MapEncoding, m, l.maps))(size: Eq(Nat, m.inner, n)) : Lit32(k, n)
   | boxOuter (l: Launcher)(launched: Eq(Option(Launcher), k.launcher, Option.some(l)))(m: MapEncoding)
       (encoded: Mem(MapEncoding, m, l.maps))(size: Eq(Nat, m.outer, n)) : Lit32(k, n)

  // `n` is printed as a 64-bit literal: a `lit64` in the kernel or its launcher.
  inductive Lit64 (k: Kernel)(n: Nat) : Prop
   | body (h: Spec.ExprIn(Expr.lit64(n), k.body)) : Lit64(k, n)
   | host (h: Spec.HostExpr(k, Expr.lit64(n))) : Lit64(k, n)

  // The columns a tensor-memory load or store of shape `.32x32b` moves per thread (PTX §9.7.18.8.3, `.num`).
  def tmemCounts : List(Nat) := List.cons(1, List.cons(2, List.cons(4, List.cons(8, List.cons(16, List.cons(32, List.cons(64,
    List.cons(128, List.nil(Nat)))))))))

  // A shared-memory descriptor's fields fit Table 49: the leading byte offset is a multiple of 16 below 2^18, and the
  // step advances the start address by less than 2^18 bytes.
  def SmemDescFits (d: SmemDesc): Prop := And(Nat.lt(d.lbo, 262144), And(Eq(Nat, Nat.mod(d.lbo, 16), 0), Nat.lt(d.step, 8192)))

  // An MMA shape: M is `m1` or `m2`, and N a multiple of `step` in `step`..256.
  def ShapeFits (m1: Nat)(m2: Nat)(step: Nat)(d: InstrDesc): Prop :=
    And(Or(Eq(Nat, d.m, m1), Eq(Nat, d.m, m2)), And(Nat.le(step, d.n), And(Nat.le(d.n, 256), Eq(Nat, Nat.mod(d.n, step), 0))))

  // An instruction descriptor's shape is one kind::f16 has for the CTA group (PTX §9.7.18.2.1, Table 48): for one
  // CTA, M of 64 or 128 and N a multiple of 8 up to 256; for a pair, M of 128 or 256 and N a multiple of 16 up to 256.
  // Each then fits its field of Table 51.
  def InstrDescFits (g: CtaGroup)(d: InstrDesc): Prop := {
    match g returning Prop with
    | CtaGroup.one => Spec.ShapeFits(64, 128, 8, d)
    | CtaGroup.two => Spec.ShapeFits(128, 256, 16, d)
  }

  // The columns a tensor-memory load or store moves per thread, for its shape.
  def TmemCountOk (shape: TmemShape)(n: Nat): Prop := {
    match shape returning Prop with
    | TmemShape.s32x32b => Mem(Nat, n, Spec.tmemCounts)
  }

  def MmaAFits (a: MmaA): Prop := {
    match a returning Prop with
    | MmaA.smem desc => Spec.SmemDescFits(desc)
    | MmaA.tmem addr => True
  }

  // A multicast commit's CTA mask fits its 16-bit register.
  def MaskFits (multicast: Option(Nat)): Prop := {
    match multicast returning Prop with
    | Option.none => True
    | Option.some mask => Nat.lt(mask, 65536)
  }

  // An instruction's immediates, which its template prints, are in their ranges, and the fields the printer packs into
  // its descriptors fit them. `shfl`'s lane below 32 is the library's rule: PTX reads the lane operand's low 5 bits.
  def InRange (i: Instr): Prop := {
    match i returning Prop with
    | Instr.barSync id threads => True
    | Instr.mbarInit bar count => True
    | Instr.mbarInval bar => True
    | Instr.mbarArrive w bar arrival => True
    | Instr.mbarWait s bar parity => True
    | Instr.fenceMbarInit => True
    | Instr.fenceProxyAsync => True
    | Instr.tcFence side => True
    | Instr.clusterArrive => True
    | Instr.clusterWait => True
    | Instr.tmaLoad g dst map x y bar => True
    | Instr.tmaStore map x y src => True
    | Instr.bulkCommit => True
    | Instr.bulkWait what pending => Nat.lt(pending, Spec.u64Limit)
    | Instr.tmemAlloc g slot cols => True
    | Instr.tmemRelinquish g => True
    | Instr.tmemDealloc g taddr cols => True
    | Instr.mma g acc a b idesc accumulate => And(Spec.MmaAFits(a), And(Spec.SmemDescFits(b), Spec.InstrDescFits(g, idesc)))
    | Instr.tcCommit g bar multicast => Spec.MaskFits(multicast)
    | Instr.tmemLoad shape dst taddr => Spec.TmemCountOk(shape, List.length(dst))
    | Instr.tmemStore shape w taddr values => Spec.TmemCountOk(shape, List.length(values))
    | Instr.tmemWait what => True
    | Instr.elect flag => True
    | Instr.shfl d a lane => Nat.lt(lane, 32)
    | Instr.voteAny d p => True
    | Instr.setMaxNReg change count => And(Nat.le(24, count), And(Nat.le(count, 256), Eq(Nat, Nat.mod(count, 8), 0)))
    | Instr.movF32 d bits => Nat.lt(bits, Cuda.u32Limit)
    | Instr.ex2 d a => True
    | Instr.lg2 d a => True
    | Instr.ex2Emulated d a => True
    | Instr.rcp r d a => True
    | Instr.cvtBf16x2 d hi lo => True
    | Instr.ldRelaxed s d addr => True
    | Instr.casRelaxed s d addr expected desired => True
    | Instr.movSpecial d r => True
    | Instr.mapa d addr rank => True
    | Instr.stShared addr values => Mem(Nat, List.length(values), List.cons(2, List.cons(4, List.nil(Nat))))
  }

  // I4: every 32-bit literal is below 2^32, every 64-bit literal below 2^64, and every instruction is in range.
  struct Literals (k: Kernel) : Prop
   | mk (u32: (n: Nat) -> Spec.Lit32(k, n) -> Nat.lt(n, Cuda.u32Limit))
        (u64: (n: Nat) -> Spec.Lit64(k, n) -> Nat.lt(n, Spec.u64Limit))
        (ranges: (i: Instr) -> Spec.InBlock(Stmt.instr(i), k.body) -> Spec.InRange(i)) : Literals(k)

  // ---- I5, names ----------------------------------------------------------------------------------------------------

  // `x` occurs at two places in `xs`.
  inductive Twice (A: Type)(x: A) indices (xs: List(A)) : Prop
   | here (rest: List(A))(again: Mem(A, x, rest)) : Twice(A, x, List.cons(x, rest))
   | there (y: A)(rest: List(A))(h: Twice(A, x, rest)) : Twice(A, x, List.cons(y, rest))

  // `c` may start a C identifier: an ASCII letter or `_`.
  def IdentStart (c: Char): Prop :=
    Or(And(Nat.le(65, c.value), Nat.le(c.value, 90)), Or(And(Nat.le(97, c.value), Nat.le(c.value, 122)), Eq(Nat, c.value, 95)))

  // `c` is an ASCII digit.
  def Digit (c: Char): Prop := And(Nat.le(48, c.value), Nat.le(c.value, 57))

  // `name` is a C identifier: a letter or `_`, then letters, digits and `_`.
  inductive CIdent (name: String) : Prop
   | mk (c: Char)(rest: List(Char))(spelled: Eq(List(Char), name.data, List.cons(c, rest)))(start: Spec.IdentStart(c))
        (continued: (d: Char) -> Mem(Char, d, rest) -> Or(Spec.IdentStart(d), Spec.Digit(d))) : CIdent(name)

  // The printed launcher's own locals.
  def printerLocals : List(String) := List.cons("stream", List.cons("status", List.cons("args", List.cons("dims", List.cons("strides",
    List.cons("box", List.cons("steps", List.nil(String))))))))

  // `name` is one the printer declares itself where it prints a kernel's, a parameter's or a tensor map's name: a
  // variable (`v` and digits), a name starting `gpu_`, or one of the launcher's locals.
  inductive PrinterName (name: String) : Prop
   | variable (d: Char)(ds: List(Char))(spelled: Eq(List(Char), name.data, List.append("v".data, List.cons(d, ds))))
       (digits: (e: Char) -> Mem(Char, e, List.cons(d, ds)) -> Spec.Digit(e)) : PrinterName(name)
   | prefixed (rest: List(Char))(spelled: Eq(List(Char), name.data, List.append("gpu_".data, rest))) : PrinterName(name)
   | local (h: Mem(String, name, Spec.printerLocals)) : PrinterName(name)

  // A name a program chose: a C identifier the printer does not declare itself.
  struct Chosen (name: String) : Prop
   | mk (ident: Spec.CIdent(name))(own: Not(Spec.PrinterName(name))) : Chosen(name)

  // `names` are those one function declares, in a kernel named `kernel`: each chosen, none the kernel's, none twice.
  struct Declared (kernel: String)(names: List(String)) : Prop
   | mk (chosen: (n: String) -> Mem(String, n, names) -> Spec.Chosen(n))
        (notKernel: (n: String) -> Mem(String, n, names) -> Not(Eq(String, n, kernel)))
        (once: (n: String) -> Not(Spec.Twice(String, n, names))) : Declared(kernel, names)

  def paramNames (ps: List(Param)): List(String) := List.map(ps, String, Cuda.paramName)

  def mapNames (maps: List(MapEncoding)): List(String) := List.map(maps, String, fun (m: MapEncoding): String => m.param)

  // A launcher's names: its parameters' and its tensor maps' are declared as one function's, and its expressions name
  // only its parameters, by value or by address.
  struct LauncherNames (kernel: String)(l: Launcher) : Prop
   | mk (declared: Spec.Declared(kernel, List.append(Spec.paramNames(l.params), Spec.mapNames(l.maps))))
        (value: (n: String) -> Spec.LauncherExpr(l, Expr.param(n)) -> Mem(String, n, Spec.paramNames(l.params)))
        (address: (n: String) -> Spec.LauncherExpr(l, Expr.paramAddr(n)) -> Mem(String, n, Spec.paramNames(l.params))) : LauncherNames(kernel, l)

  // I5: the kernel's name is chosen; its parameters' names are declared as one function's, and its body names only
  // them, by value or by address; and so is its launcher's.
  struct Names (k: Kernel) : Prop
   | mk (kernel: Spec.Chosen(k.name))
        (params: Spec.Declared(k.name, Spec.paramNames(k.params)))
        (value: (n: String) -> Spec.ExprIn(Expr.param(n), k.body) -> Mem(String, n, Spec.paramNames(k.params)))
        (address: (n: String) -> Spec.ExprIn(Expr.paramAddr(n), k.body) -> Mem(String, n, Spec.paramNames(k.params)))
        (launcher: (l: Launcher) -> Eq(Option(Launcher), k.launcher, Option.some(l)) -> Spec.LauncherNames(k.name, l)) : Names(k)

  // ---- I6, the launcher ---------------------------------------------------------------------------------------------

  // `p` is not a tensor map.
  def NotMap (p: Param): Prop := (use: MapUse) -> (name: String) -> Not(Eq(Param, p, Param.tensorMap(use, name)))

  // An array a tensor map the kernel uses for `use` may be encoded over: a bf16 input to load (an operand), an f32
  // output to store (the result).
  inductive MapSource indices (use: MapUse)(p: Param) : Prop
   | load (name: String) : MapSource(MapUse.load, Param.input(DType.bf16, name))
   | store (name: String) : MapSource(MapUse.store, Param.output(DType.f32, name))

  // I6 for kernel `k` with launcher `l`, as far as the AST shows it: the launcher declares each of the kernel's
  // parameters but the tensor maps exactly as the kernel does, and encodes each tensor map exactly once; each encoding
  // names a tensor map of the kernel with the use the kernel declares, and reads an array of the launcher that is a
  // `MapSource` for that use, and two u32 scalars of the launcher. Encodings are counted by name: that a name is one
  // map's, of one use, is I5's (`Names.params`, each name declared once).
  struct Launched (k: Kernel)(l: Launcher) : Prop
   | mk (declared: (p: Param) -> Mem(Param, p, k.params) -> Spec.NotMap(p) -> Mem(Param, p, l.params))
        (encoded: (use: MapUse) -> (name: String) -> Mem(Param, Param.tensorMap(use, name), k.params) -> Mem(String, name, Spec.mapNames(l.maps)))
        (once: (use: MapUse) -> (name: String) -> Mem(Param, Param.tensorMap(use, name), k.params) -> Not(Spec.Twice(String, name, Spec.mapNames(l.maps))))
        (named: (m: MapEncoding) -> Mem(MapEncoding, m, l.maps) -> Mem(Param, Param.tensorMap(m.use, m.param), k.params))
        (array: (m: MapEncoding) -> Mem(MapEncoding, m, l.maps) -> Spec.MapSource(m.use, m.source))
        (source: (m: MapEncoding) -> Mem(MapEncoding, m, l.maps) -> Mem(Param, m.source, l.params))
        (rows: (m: MapEncoding) -> Mem(MapEncoding, m, l.maps) -> Mem(Param, Param.scalar(DType.u32, m.rows), l.params))
        (cols: (m: MapEncoding) -> Mem(MapEncoding, m, l.maps) -> Mem(Param, Param.scalar(DType.u32, m.cols), l.params)) : Launched(k, l)

  // I6: if the kernel has a launcher, it keeps `Launched`.
  def LauncherOk (k: Kernel): Prop := (l: Launcher) -> Eq(Option(Launcher), k.launcher, Option.some(l)) -> Spec.Launched(k, l)

  // ---- The certificate ----------------------------------------------------------------------------------------------

  // What `Check.WellFormed` certifies of a kernel: no generation error, and I1 to I6 as far as its AST shows them. (A
  // conjunction rather than a structure, for `Spec.BarrierCounts`'s sake, see there.)
  def WellFormed (k: Kernel): Prop :=
    And(Spec.NoErrors(k), And(Spec.Scoping(k), And(Spec.SharedMemory(k), And(Spec.NamedBarriers(k), And(Spec.Literals(k), And(Spec.Names(k),
      Spec.LauncherOk(k)))))))
}
