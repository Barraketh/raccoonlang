// Persistent, random-access memory for source-level evaluator work. Uniform allocation shares immutable subtrees;
// each successful write copies only the path to its leaf. The cached extent and each branch's left extent avoid
// rebuilding powers or deriving subtree sizes during accesses.

namespace Evaluator {
  sealed inductive MemoryTree {u: Level}{S: Lifetime}(A: Type { level = u, scope = S }) : Type { level = u, scope = S }
   | leaf (value: A) : MemoryTree(A)
   | branch (leftExtent: Nat)(left: MemoryTree(A))(right: MemoryTree(A)) : MemoryTree(A)

  sealed struct Memory {u: Level}{S: Lifetime}(A: Type { level = u, scope = S }) : Type { level = u, scope = S }
   | mk (extent: Nat)(root: MemoryTree(A)) : Memory(A)

  namespace Memory {
    // Internal construction helper. It returns sealed tree data; only allocPow2 packages a tree and extent as Memory.
    def filledTree {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (depth: Nat)(extent: Nat)(initial: A)
        : MemoryTree(A) decreases structural(depth) := {
      match depth returning MemoryTree(A) with
      | Nat.zero => MemoryTree.leaf(initial)
      | Nat.succ rest => {
        let leftExtent := Nat.div(extent, 2)
        let child := Memory.filledTree(rest, leftExtent, initial)
        MemoryTree.branch(leftExtent, child, child)
      }
    }

    // Allocate exactly 2^depth cells. Reusing the same immutable child at each branch makes uniform fill compact;
    // subsequent set operations preserve persistence by copying only the selected path.
    def allocPow2 {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (depth: Nat)(initial: A): Memory(A) := {
      let extent := Nat.pow(2, depth)
      Memory.mk(extent, Memory.filledTree(depth, extent, initial))
    }

    // Build a balanced power-of-two memory directly from its indices. This is useful when an evaluator operation
    // produces a whole immutable tile: constructing it by repeated `set` would copy the same tree paths over and over.
    def tabulateTree {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (depth: Nat)(extent: Nat)(start: Nat)(at: Nat -> A)
        : MemoryTree(A) decreases structural(depth) := {
      match depth returning MemoryTree(A) with
      | Nat.zero => MemoryTree.leaf(at(start))
      | Nat.succ rest => {
        let leftExtent := Nat.div(extent, 2)
        let left := Memory.tabulateTree(rest, leftExtent, start, at)
        let right := Memory.tabulateTree(rest, leftExtent, Nat.add(start, leftExtent), at)
        MemoryTree.branch(leftExtent, left, right)
      }
    }

    def tabulatePow2 {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (depth: Nat)(at: Nat -> A): Memory(A) := {
      let extent := Nat.pow(2, depth)
      Memory.mk(extent, Memory.tabulateTree(depth, extent, 0, at))
    }

    // Internal helper for replacing one complete, naturally aligned power-of-two subtree. Bulk device transfers use
    // this to materialize a contiguous swizzled tile without repeated persistent point writes.
    def replaceTree {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (tree: MemoryTree(A))(extent: Nat)(treeStart: Nat)
        (targetStart: Nat)(targetExtent: Nat)(targetDepth: Nat)(at: Nat -> A): Option(MemoryTree(A))
        decreases structural(tree) := {
      match tree returning Option(MemoryTree(A)) with
      | MemoryTree.leaf old => {
        match Bool.and(Nat.beq(extent, targetExtent), Nat.beq(treeStart, targetStart)) returning Option(MemoryTree(A)) with
        | Bool.true => Option.some(Memory.tabulateTree(targetDepth, targetExtent, targetStart, at))
        | Bool.false => Option.none(MemoryTree(A))
      }
      | MemoryTree.branch leftExtent left right => {
        let leftEnd := Nat.add(treeStart, leftExtent)
        match Bool.and(Nat.beq(extent, targetExtent), Nat.beq(treeStart, targetStart)) returning Option(MemoryTree(A)) with
        | Bool.true => Option.some(Memory.tabulateTree(targetDepth, targetExtent, targetStart, at))
        | Bool.false => {
          match Nat.ble(Nat.add(targetStart, targetExtent), leftEnd) returning Option(MemoryTree(A)) with
          | Bool.true => {
            match Memory.replaceTree(left, leftExtent, treeStart, targetStart, targetExtent, targetDepth, at)
                returning Option(MemoryTree(A)) with
            | Option.none => Option.none(MemoryTree(A))
            | Option.some changed => Option.some(MemoryTree.branch(leftExtent, changed, right))
          }
          | Bool.false => {
            match Nat.ble(leftEnd, targetStart) returning Option(MemoryTree(A)) with
            | Bool.true => {
              match Memory.replaceTree(right, Nat.sub(extent, leftExtent), leftEnd, targetStart, targetExtent, targetDepth, at)
                  returning Option(MemoryTree(A)) with
              | Option.none => Option.none(MemoryTree(A))
            | Option.some changed => Option.some(MemoryTree.branch(leftExtent, left, changed))
            }
            | Bool.false => Option.none(MemoryTree(A))
          }
        }
      }
    }

    def replacePow2 {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (memory: Memory(A))(start: Nat)(depth: Nat)
        (at: Nat -> A): Option(Memory(A)) := {
      match memory returning Option(Memory(A)) with
      | Memory.mk extent root => {
        let targetExtent := Nat.pow(2, depth)
        let inBounds := Nat.ble(Nat.add(start, targetExtent), extent)
        let aligned := Nat.isZero(Nat.mod(start, targetExtent))
        match Bool.and(inBounds, aligned) returning Option(Memory(A)) with
        | Bool.false => Option.none(Memory(A))
        | Bool.true => {
          match Memory.replaceTree(root, extent, 0, start, targetExtent, depth, at) returning Option(Memory(A)) with
          | Option.none => Option.none(Memory(A))
          | Option.some changed => Option.some(Memory.mk(extent, changed))
        }
      }
    }

    def capacity {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (memory: Memory(A)): Nat := {
      match memory returning Nat with
      | Memory.mk extent root => extent
    }

    // Internal tree traversal helpers; the public get/set operations check the cached extent before calling them.
    def getTree {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (tree: MemoryTree(A))(index: Nat)
        : Option(A) decreases structural(tree) := {
      match tree returning Option(A) with
      | MemoryTree.leaf value => {
        match index returning Option(A) with
        | Nat.zero => Option.some(value)
        | Nat.succ rest => Option.none(A)
      }
      | MemoryTree.branch leftExtent left right => {
        match Nat.blt(index, leftExtent) returning Option(A) with
        | Bool.true => Memory.getTree(left, index)
        | Bool.false => Memory.getTree(right, Nat.sub(index, leftExtent))
      }
    }

    def get {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (memory: Memory(A))(index: Nat): Option(A) := {
      match memory returning Option(A) with
      | Memory.mk extent root => {
        match Nat.blt(index, extent) returning Option(A) with
        | Bool.true => Memory.getTree(root, index)
        | Bool.false => Option.none(A)
      }
    }

    def setTree {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (tree: MemoryTree(A))(index: Nat)(value: A)
        : Option(MemoryTree(A)) decreases structural(tree) := {
      match tree returning Option(MemoryTree(A)) with
      | MemoryTree.leaf old => {
        match index returning Option(MemoryTree(A)) with
        | Nat.zero => Option.some(MemoryTree.leaf(value))
        | Nat.succ rest => Option.none(MemoryTree(A))
      }
      | MemoryTree.branch leftExtent left right => {
        match Nat.blt(index, leftExtent) returning Option(MemoryTree(A)) with
        | Bool.true => {
          match Memory.setTree(left, index, value) returning Option(MemoryTree(A)) with
          | Option.none => Option.none(MemoryTree(A))
          | Option.some changed => Option.some(MemoryTree.branch(leftExtent, changed, right))
        }
        | Bool.false => {
          match Memory.setTree(right, Nat.sub(index, leftExtent), value) returning Option(MemoryTree(A)) with
          | Option.none => Option.none(MemoryTree(A))
          | Option.some changed => Option.some(MemoryTree.branch(leftExtent, left, changed))
        }
      }
    }

    def set {u: Level}{S: Lifetime}{A: Type { level = u, scope = S }} (memory: Memory(A))(index: Nat)(value: A)
        : Option(Memory(A)) := {
      match memory returning Option(Memory(A)) with
      | Memory.mk extent root => {
        match Nat.blt(index, extent) returning Option(Memory(A)) with
        | Bool.false => Option.none(Memory(A))
        | Bool.true => {
          match Memory.setTree(root, index, value) returning Option(Memory(A)) with
          | Option.none => Option.none(Memory(A))
          | Option.some changed => Option.some(Memory.mk(extent, changed))
        }
      }
    }
  }
}
