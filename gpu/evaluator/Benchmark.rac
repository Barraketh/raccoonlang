// A small source-level workload over persistent random-access memory. Each iteration performs two writes and one read
// at nonuniform indices in the fixed 16,384-cell buffer; it is a buffer-operation count, not a warp-step model.

import evaluator.Memory
import evaluator.Ring

namespace Evaluator {
  namespace Benchmark {
    def capacity : Nat := 16384

    // An out-of-bounds result is represented by 257, outside Z/257, so a broken memory operation cannot look like a
    // valid benchmark checksum.
    def oob : Nat := Evaluator.Ring.modulus

    def loop (remaining: Nat)(iteration: Nat)(checksum: Nat)(memory: Evaluator.Memory(Nat))
        : Nat decreases structural(remaining) := {
      match remaining returning Nat with
      | Nat.zero => Evaluator.Ring.add(checksum,
          Evaluator.Ring.add(iteration, Evaluator.Ring.ofNat(Evaluator.Memory.capacity(memory))))
      | Nat.succ rest => {
        let extent := Evaluator.Memory.capacity(memory)
        let index := Nat.mod(Nat.add(Nat.mul(iteration, 7919), 101), extent)
        let priorIteration := Nat.div(iteration, 2)
        let probe := Nat.mod(Nat.add(Nat.mul(priorIteration, 7919), 101), extent)
        let value := Evaluator.Ring.mul(iteration, 2)
        match Evaluator.Memory.set(memory, index, value) returning Nat with
        | Option.none => Evaluator.Benchmark.oob
        | Option.some afterFirstWrite => {
          match Evaluator.Memory.get(afterFirstWrite, probe) returning Nat with
          | Option.none => Evaluator.Benchmark.oob
          | Option.some observed => {
            let updated := Evaluator.Ring.add(observed, value)
            match Evaluator.Memory.set(afterFirstWrite, probe, updated) returning Nat with
            | Option.none => Evaluator.Benchmark.oob
            | Option.some afterSecondWrite =>
              Evaluator.Benchmark.loop(rest, Nat.succ(iteration),
                Evaluator.Ring.add(checksum, observed), afterSecondWrite)
          }
        }
      }
    }

    def run (iterations: Nat): Nat :=
      Evaluator.Benchmark.loop(iterations, Nat.zero, Nat.zero,
        Evaluator.Memory.allocPow2(14, Evaluator.Ring.zero))
  }
}
