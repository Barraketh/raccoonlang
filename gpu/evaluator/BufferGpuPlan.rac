// Public compiler and runner for the bounded, one-CTA TinyGEMM Buffer.Program evaluator.
// GPU AST interpretation stays in ordinary source modules; execution crosses only Buffer.run.

import Cuda
import buffer.Program
import evaluator.BufferControl
import evaluator.BufferData
import evaluator.BufferGpuEventSchedule
import evaluator.BufferIO
import evaluator.BufferKernels
import evaluator.TinyDevice
import evaluator.WarpMachine

namespace Evaluator {
  namespace BufferGpuPlan {
    def inputValuesA : Nat := 8192
    def inputValuesB : Nat := 8192
    def outputValues : Nat := 16384
    def inputBytesA : Nat := 16384
    def inputBytesB : Nat := 16384
    def outputBytes : Nat := 65536
    def tmemBytes : Nat := 65536
    def maxBufferBytes : Nat := 67108864
    def maxTotalBytes : Nat := 268435456
    def maxProgramWords : Nat := 1000000
    def maxProgramInstructions : Nat := 200000
    def maxBankEntries : Nat := 65536

    sealed struct Extents : Type
     | mk (inputAValues: Nat)(inputBValues: Nat)(outputValues: Nat) : Extents

    // Construction is confined to this compiler after header and resource checks pass.
    sealed struct Plan : Type
     | mk (program: Buffer.Program)(extents: Extents)(stats: WarpMachine.Stats) : Plan

    inductive CompileResult : Type
     | ready (plan: Plan) : CompileResult
     | rejected (code: Nat) : CompileResult

    inductive RunError : Type
     | invalidInput (inputIndex: Nat) : RunError
     | bufferFailure (code: Nat) : RunError
     | invalidOutput : RunError

    inductive RunResult : Type
     | success (outputs: List(Nat))(stats: WarpMachine.Stats) : RunResult
     | failure (error: RunError) : RunResult

    def planProgram (plan: Plan): Buffer.Program := {
      match plan returning Buffer.Program with
      | Plan.mk program extents stats => program
    }

    def planStats (plan: Plan): WarpMachine.Stats := {
      match plan returning WarpMachine.Stats with
      | Plan.mk program extents stats => stats
    }

    def sharedExtentValid (bytes: Nat): Bool := Bool.and(Nat.blt(0, bytes),
      Bool.and(Nat.ble(bytes, 262144), Nat.isZero(Nat.mod(bytes, 4))))

    def kernelParamsValid (params: List(Cuda.Param)): Bool :=
      TinyDevice.expectedKernelParams(params)

    def launcherValid (launcher: Option(Cuda.Launcher)): Bool := {
      match launcher returning Bool with
      | Option.none => Bool.false
      | Option.some value => {
        match value returning Bool with
        | Cuda.Launcher.mk params requires maps grid block => Bool.and(
            TinyDevice.expectedHostParams(params),
            Bool.and(TinyDevice.expectedMaps(maps),
              Bool.and(TinyDevice.expectedGrid(grid),
                Bool.and(TinyDevice.requirementsOk(requires, 128, 128, 64), Nat.beq(block, 256)))))
      }
    }

    def withinBufferLimit (bytes: Nat): Bool := Nat.ble(bytes, BufferGpuPlan.maxBufferBytes)

    def layoutWithinLimits (sharedBytes: Nat)(snapshotBytes: Nat): Bool := {
      let total := Nat.add(BufferGpuPlan.inputBytesA,
        Nat.add(BufferGpuPlan.inputBytesB,
          Nat.add(sharedBytes,
            Nat.add(BufferGpuPlan.tmemBytes, Nat.add(snapshotBytes, BufferGpuPlan.outputBytes)))))
      Bool.and(BufferGpuPlan.withinBufferLimit(sharedBytes),
        Bool.and(BufferGpuPlan.withinBufferLimit(snapshotBytes),
          Nat.ble(total, BufferGpuPlan.maxTotalBytes)))
    }

    def programWordsWithinLimit (words: List(Nat))(remaining: Nat): Bool
        decreases structural(remaining) := {
      match remaining returning Bool with
      | Nat.zero => {
        match words returning Bool with
        | List.nil => Bool.true
        | List.cons _ _ => Bool.false
      }
      | Nat.succ rest => {
        match words returning Bool with
        | List.nil => Bool.true
        | List.cons _ tail => BufferGpuPlan.programWordsWithinLimit(tail, rest)
      }
    }

    def validProgramHeader (words: List(Nat)): Bool := {
      match words returning Bool with
      | List.nil => Bool.false
      | List.cons magic rest1 => {
        match rest1 returning Bool with
        | List.nil => Bool.false
        | List.cons version rest2 => {
          match rest2 returning Bool with
          | List.nil => Bool.false
          | List.cons slots32 rest3 => {
            match rest3 returning Bool with
            | List.nil => Bool.false
            | List.cons slots64 rest4 => {
              match rest4 returning Bool with
              | List.nil => Bool.false
              | List.cons buffers rest5 => {
                match rest5 returning Bool with
                | List.nil => Bool.false
                | List.cons instructions _ => Bool.and(Nat.beq(magic, 1112884806),
                    Bool.and(Nat.beq(version, 3),
                      Bool.and(Nat.ble(slots32, BufferGpuPlan.maxBankEntries),
                        Bool.and(Nat.ble(slots64, BufferGpuPlan.maxBankEntries),
                          Bool.and(Nat.beq(buffers, 6),
                            Nat.ble(instructions, BufferGpuPlan.maxProgramInstructions))))))
              }
            }
          }
        }
      }
    }

    def programWithinLimits (program: Buffer.Program): Bool := {
      let words := Buffer.programWords(program)
      Bool.and(BufferGpuPlan.programWordsWithinLimit(words, BufferGpuPlan.maxProgramWords),
        BufferGpuPlan.validProgramHeader(words))
    }

    def snapshotBytes (expanded: BufferControl.State): Nat := {
      match expanded returning Nat with
      | BufferControl.State.mk registers traces workCount nextSnapshotOrdinal =>
        Nat.mul(nextSnapshotOrdinal, BufferKernels.snapshotBytesPerLoad)
    }

    def lowerProgram (dynamicShared: Nat)(expanded: BufferControl.State)
        (actions: List(BufferData.Action))(supply: BufferKernels.SlotSupply)
        : Option(Buffer.Program) := {
      let snapshots := BufferGpuPlan.snapshotBytes(expanded)
      let supplyFits := Bool.and(
        Nat.ble(BufferKernels.slots32(supply), BufferGpuPlan.maxBankEntries),
        Nat.ble(BufferKernels.slots64(supply), BufferGpuPlan.maxBankEntries))
      match Bool.and(supplyFits,
          BufferGpuPlan.layoutWithinLimits(dynamicShared, snapshots)) returning Option(Buffer.Program) with
      | Bool.false => Option.none(Buffer.Program)
      | Bool.true => {
        let layout := BufferData.Layout.mk(BufferGpuPlan.inputBytesA, BufferGpuPlan.inputBytesB,
          dynamicShared, BufferGpuPlan.tmemBytes, snapshots, BufferGpuPlan.outputBytes)
        match BufferData.lower(layout, BufferKernels.slots32(supply),
            BufferKernels.slots64(supply), actions) returning Option(Buffer.Program) with
        | BufferData.LowerResult.rejected error => Option.none(Buffer.Program)
        | BufferData.LowerResult.program program => {
          match BufferGpuPlan.programWithinLimits(program) returning Option(Buffer.Program) with
          | Bool.true => Option.some(program)
          | Bool.false => Option.none(Buffer.Program)
        }
      }
    }

    def compile (kernel: Cuda.Kernel): CompileResult := {
      match kernel returning CompileResult with
      | Cuda.Kernel.mk name params dynamicShared body launcher => {
        let shapeOk := Bool.and(BufferGpuPlan.kernelParamsValid(params),
          BufferGpuPlan.sharedExtentValid(dynamicShared))
        match shapeOk returning CompileResult with
        | Bool.false => CompileResult.rejected(1)
        | Bool.true => {
          match BufferGpuPlan.launcherValid(launcher) returning CompileResult with
          | Bool.false => CompileResult.rejected(2)
          | Bool.true => {
            match BufferControl.expandCta(128, 128, 64, body) returning CompileResult with
            | BufferControl.Result.rejected code => CompileResult.rejected(code)
            | BufferControl.Result.success expanded => {
              match BufferGpuEventSchedule.compile(kernel, expanded) returning CompileResult with
              | BufferGpuEventSchedule.CompileResult.rejected code => CompileResult.rejected(code)
              | BufferGpuEventSchedule.CompileResult.compiled actions supply stats => {
                match BufferGpuPlan.lowerProgram(dynamicShared, expanded, actions, supply) returning CompileResult with
                | Option.none => CompileResult.rejected(900)
                | Option.some program => CompileResult.ready(Plan.mk(program,
                    Extents.mk(BufferGpuPlan.inputValuesA, BufferGpuPlan.inputValuesB,
                      BufferGpuPlan.outputValues), stats))
              }
            }
          }
        }
      }
    }

    def runOutputs (outputs: List(List(Nat)))(expectedValues: Nat)
        (stats: WarpMachine.Stats): RunResult := {
      match outputs returning RunResult with
      | List.nil => RunResult.failure(RunError.invalidOutput)
      | List.cons bytes rest => {
        match rest returning RunResult with
        | List.cons _ _ => RunResult.failure(RunError.invalidOutput)
        | List.nil => {
          match BufferIO.decode32(bytes, expectedValues) returning RunResult with
          | Option.none => RunResult.failure(RunError.invalidOutput)
          | Option.some values => RunResult.success(values, stats)
        }
      }
    }

    def run (plan: Plan)(inputA: List(Nat))(inputB: List(Nat)): RunResult := {
      match plan returning RunResult with
      | Plan.mk program extents stats => {
        match extents returning RunResult with
        | Extents.mk aValues bValues cValues => {
          match BufferIO.encode16(inputA, aValues) returning RunResult with
          | Option.none => RunResult.failure(RunError.invalidInput(0))
          | Option.some bytesA => {
            match BufferIO.encode16(inputB, bValues) returning RunResult with
            | Option.none => RunResult.failure(RunError.invalidInput(1))
            | Option.some bytesB => {
              match Buffer.run(program,
                  List.cons(bytesA, List.cons(bytesB, List.nil(List(Nat))))) returning RunResult with
              | Buffer.Result.failure code => RunResult.failure(RunError.bufferFailure(code))
              | Buffer.Result.success outputs => BufferGpuPlan.runOutputs(outputs, cValues, stats)
            }
          }
        }
      }
    }
  }
}
