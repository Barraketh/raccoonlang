import Cuda
import encoding.Core
import encoding.TinyGemm
import evaluator.BufferControl
import evaluator.BufferData
import evaluator.BufferGpuDecode
import evaluator.BufferPlan
import evaluator.DeviceApi

def decodeProbeKernel : Cuda.Kernel := Core.checkedKernel(Tiny.kernel)
def decodeProbeFullMask : Nat := 4294967295

def decodeProbeTrace (warp: Nat)(mask: Nat)(registers: List(Evaluator.BufferPlan.Register))
    (instruction: Cuda.Instr)(ordinal: Nat): Evaluator.BufferControl.Trace :=
  Evaluator.BufferControl.Trace.mk(warp, mask, registers, registers, Cuda.Stmt.instr(instruction), ordinal)

def decodeProbe (warp: Nat)(mask: Nat)(registers: List(Evaluator.BufferPlan.Register))
    (instruction: Cuda.Instr): Evaluator.BufferGpuDecode.DecodeResult :=
  Evaluator.BufferGpuDecode.decode(decodeProbeKernel,
    decodeProbeTrace(warp, mask, registers, instruction, 0))

def decodedTmaLoad (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.false
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => {
    match op returning Bool with
    | Evaluator.BufferGpuDecode.Op.issueTmaLoad request barrier => {
      match request returning Bool with
      | Evaluator.DeviceApi.DataRequest.tmaLoad map destination x y => {
        match map returning Bool with
        | Evaluator.DeviceApi.ResolvedMap.mk encoding rows cols => Bool.and(
            Nat.beq(rows, 128), Bool.and(Nat.beq(cols, 64),
              Bool.and(Nat.beq(destination, 33792), Bool.and(Nat.isZero(x),
                Bool.and(Nat.isZero(y), Nat.beq(barrier, 8))))))
      }
      | _ => Bool.false
    }
    | _ => Bool.false
  }
}

def decodedTmaStore (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.false
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => {
    match op returning Bool with
    | Evaluator.BufferGpuDecode.Op.issueTmaStore request => {
      match request returning Bool with
      | Evaluator.DeviceApi.DataRequest.tmaStore map x y source => {
        match map returning Bool with
        | Evaluator.DeviceApi.ResolvedMap.mk encoding rows cols => Bool.and(
            Nat.beq(rows, 128), Bool.and(Nat.beq(cols, 128),
              Bool.and(Nat.beq(x, 64), Bool.and(Nat.beq(y, 32), Nat.beq(source, 1024)))))
      }
      | _ => Bool.false
    }
    | _ => Bool.false
  }
}

def decodedMma (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.false
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => {
    match op returning Bool with
    | Evaluator.BufferGpuDecode.Op.issueMma request => {
      match request returning Bool with
      | Evaluator.DeviceApi.DataRequest.mma desc => {
        match desc returning Bool with
        | Evaluator.DeviceApi.MmaDesc.mk group accumulator a b idesc accumulate => {
          match a returning Bool with
          | Evaluator.DeviceApi.MmaSource.shared aDesc => {
            match aDesc returning Bool with
            | Evaluator.DeviceApi.OperandDesc.mk aBase aLbo aStep => {
              match b returning Bool with
              | Evaluator.DeviceApi.OperandDesc.mk bBase bLbo bStep => Bool.and(
                  Nat.beq(accumulator, 0), Bool.and(Nat.beq(aBase, 33792),
                    Bool.and(Nat.beq(bBase, 50176), Bool.and(Nat.beq(aLbo, 0),
                      Bool.and(Nat.beq(bLbo, 0), Bool.and(Nat.beq(aStep, 2),
                        Bool.and(Nat.beq(bStep, 2), Nat.isZero(accumulate))))))))
            }
          }
          | _ => Bool.false
        }
      }
      | _ => Bool.false
    }
    | _ => Bool.false
  }
}

def decodedTmemLoad (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.false
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => {
    match op returning Bool with
    | Evaluator.BufferGpuDecode.Op.issueTmemLoad request ordinal => {
      match request returning Bool with
      | Evaluator.DeviceApi.DataRequest.tmemLoad shape destinations address group mask =>
          Bool.and(Nat.beq(ordinal, 0), Bool.and(Nat.isZero(address),
            Bool.and(Nat.isZero(group), Nat.beq(mask, decodeProbeFullMask))))
      | _ => Bool.false
    }
    | _ => Bool.false
  }
}

def sharedProbeBase : Cuda.Expr := Cuda.Expr.bin(Cuda.BinOp.add, Cuda.Expr.lit(1024),
  Cuda.Expr.bin(Cuda.BinOp.mul, Cuda.Expr.special(Cuda.Builtin.lane), Cuda.Expr.lit(4)))

def sharedProbeActions (values: List(Cuda.Expr))(registers: List(Evaluator.BufferPlan.Register))
    : Option(List(BufferData.Action)) :=
  Evaluator.BufferGpuDecode.sharedWriteActions(0, decodeProbeFullMask, registers, 262144,
    sharedProbeBase, values)

def actionCountIs (result: Option(List(BufferData.Action)))(count: Nat): Bool := {
  match result returning Bool with
  | Option.none => Bool.false
  | Option.some actions => Nat.beq(List.length(actions), count)
}

def actionResultIsNone (result: Option(List(BufferData.Action))): Bool := {
  match result returning Bool with
  | Option.none => Bool.true
  | Option.some actions => Bool.false
}

def storeRunPrefix (actions: List(BufferData.Action))(base: Nat)(value: Nat)(lane: Nat)(remaining: Nat)
    : Option(List(BufferData.Action)) decreases structural(remaining) := {
  match remaining returning Option(List(BufferData.Action)) with
  | Nat.zero => Option.some(actions)
  | Nat.succ rest => {
    match actions returning Option(List(BufferData.Action)) with
    | List.nil => Option.none(List(BufferData.Action))
    | List.cons action more => {
      match action returning Option(List(BufferData.Action)) with
      | BufferData.Action.store32 target offset stored => {
        match target returning Option(List(BufferData.Action)) with
        | BufferData.BufferRef.shared => {
          match offset returning Option(List(BufferData.Action)) with
          | BufferData.Expr64.literal address => {
            match stored returning Option(List(BufferData.Action)) with
            | BufferData.Expr32.literal storedValue => {
              match Bool.and(Nat.beq(address, Nat.add(base, Nat.mul(lane, 4))), Nat.beq(storedValue, value))
                  returning Option(List(BufferData.Action)) with
              | Bool.false => Option.none(List(BufferData.Action))
              | Bool.true => storeRunPrefix(more, base, value, Nat.succ(lane), rest)
            }
            | _ => Option.none(List(BufferData.Action))
          }
          | _ => Option.none(List(BufferData.Action))
        }
        | _ => Option.none(List(BufferData.Action))
      }
      | _ => Option.none(List(BufferData.Action))
    }
  }
}

def orderedLiteralWrites (result: Option(List(BufferData.Action))): Bool := {
  match result returning Bool with
  | Option.none => Bool.false
  | Option.some actions => {
    match storeRunPrefix(actions, 1024, 3, 0, 32) returning Bool with
    | Option.none => Bool.false
    | Option.some secondColumn => {
      match storeRunPrefix(secondColumn, 1028, 4, 0, 32) returning Bool with
      | Option.none => Bool.false
      | Option.some rest => {
        match rest returning Bool with
        | List.nil => Bool.true
        | List.cons action more => Bool.false
      }
    }
  }
}

def isRejected (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.true
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => Bool.false
}

def decodedBarrierInit (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => {
    match op returning Bool with
    | Evaluator.BufferGpuDecode.Op.barrierInit address count => Bool.and(Nat.beq(address, 8), Nat.beq(count, 1))
    | _ => Bool.false
  }
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.false
}

def decodedGate (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => {
    match op returning Bool with
    | Evaluator.BufferGpuDecode.Op.gate id expected participants => Bool.and(
        Nat.beq(id, 3), Bool.and(Nat.beq(expected, 32), Nat.beq(participants, 32)))
    | _ => Bool.false
  }
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.false
}

def decodedBarrierArrive (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => {
    match op returning Bool with
    | Evaluator.BufferGpuDecode.Op.barrierArrive address arrivals txBytes =>
        Bool.and(Nat.beq(address, 8), Bool.and(Nat.beq(arrivals, 1), Nat.beq(txBytes, 16384)))
    | _ => Bool.false
  }
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.false
}

def decodedTmemWait (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => {
    match op returning Bool with
    | Evaluator.BufferGpuDecode.Op.tmemWait => Bool.true
    | _ => Bool.false
  }
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.false
}

def decodedTmemAlloc (result: Evaluator.BufferGpuDecode.DecodeResult): Bool := {
  match result returning Bool with
  | Evaluator.BufferGpuDecode.DecodeResult.decoded op => {
    match op returning Bool with
    | Evaluator.BufferGpuDecode.Op.tmemAlloc slot columns => Bool.and(Nat.isZero(slot), Nat.beq(columns, 128))
    | _ => Bool.false
  }
  | Evaluator.BufferGpuDecode.DecodeResult.rejected code => Bool.false
}

def decoderProbeResult : Nat := {
  let tmaLoad := decodeProbe(0, 1, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.tmaLoad(Cuda.CtaGroup.one, Cuda.Expr.sharedAddr(33792),
      Cuda.Expr.paramAddr("A_map"), Cuda.Expr.lit(0), Cuda.Expr.lit(0), Cuda.Expr.sharedAddr(8)))
  let tmaStore := decodeProbe(0, 1, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.tmaStore(Cuda.Expr.paramAddr("C_map"), Cuda.Expr.lit(64), Cuda.Expr.lit(32),
      Cuda.Expr.sharedAddr(1024)))
  let mma := decodeProbe(0, 1, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.mma(Cuda.CtaGroup.one, Cuda.Expr.lit(0),
      Cuda.MmaA.smem(Cuda.SmemDesc.mk(Cuda.Expr.sharedAddr(33792), 0, 2)),
      Cuda.SmemDesc.mk(Cuda.Expr.sharedAddr(50176), 0, 2), Cuda.InstrDesc.mk(128, 128, Bool.false),
      Cuda.Expr.lit(0)))
  let stagingMma := decodeProbe(0, 1, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.mma(Cuda.CtaGroup.one, Cuda.Expr.lit(0),
      Cuda.MmaA.smem(Cuda.SmemDesc.mk(Cuda.Expr.sharedAddr(1024), 0, 2)),
      Cuda.SmemDesc.mk(Cuda.Expr.sharedAddr(17408), 0, 2), Cuda.InstrDesc.mk(128, 128, Bool.false),
      Cuda.Expr.lit(0)))
  let destinations := List.cons(1,
    List.cons(2,
      List.cons(3,
        List.cons(4,
          List.cons(5,
            List.cons(6,
              List.cons(7,
                List.cons(8, List.nil(Nat)))))))))
  let tmemLoad := decodeProbe(0, decodeProbeFullMask, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.tmemLoad(Cuda.TmemShape.s32x32b, destinations, Cuda.Expr.lit(0)))
  let mbarInit := decodeProbe(0, 1, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.mbarInit(Cuda.Expr.sharedAddr(8), Cuda.Expr.lit(1)))
  let arrive := decodeProbe(0, 1, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.mbarArrive(Cuda.Window.cta, Cuda.Expr.sharedAddr(8), Cuda.Arrival.expectTx(Cuda.Expr.lit(16384))))
  let tmemWait := decodeProbe(0, decodeProbeFullMask, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.tmemWait(Cuda.TmemWait.load))
  let sharedAllocator := decodeProbe(0, decodeProbeFullMask, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.tmemAlloc(Cuda.CtaGroup.one, Cuda.Expr.sharedAddr(0), Cuda.Expr.lit(128)))
  let validGate := decodeProbe(0, decodeProbeFullMask, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.barSync(Cuda.Expr.lit(3), Cuda.Expr.lit(32)))
  let invalidGateId := decodeProbe(0, decodeProbeFullMask, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.barSync(Cuda.Expr.lit(0), Cuda.Expr.lit(32)))
  let invalidGateThreads := decodeProbe(0, decodeProbeFullMask, List.nil(Evaluator.BufferPlan.Register),
    Cuda.Instr.barSync(Cuda.Expr.lit(3), Cuda.Expr.lit(33)))
  let literalWrites := sharedProbeActions(List.cons(Cuda.Expr.lit(3),
    List.cons(Cuda.Expr.lit(4), List.nil(Cuda.Expr))), List.nil(Evaluator.BufferPlan.Register))
  let payloadValues := Evaluator.BufferControl.payloadLanes(1024, 0, 32)
  let payloadRegisters := List.cons(Evaluator.BufferPlan.Register.mk(7, payloadValues, decodeProbeFullMask),
    List.nil(Evaluator.BufferPlan.Register))
  let payloadWrites := sharedProbeActions(List.cons(Cuda.Expr.var(7),
    List.cons(Cuda.Expr.var(7), List.nil(Cuda.Expr))), payloadRegisters)
  let invalidRingValue := sharedProbeActions(List.cons(Cuda.Expr.lit(257),
    List.cons(Cuda.Expr.lit(0), List.nil(Cuda.Expr))), List.nil(Evaluator.BufferPlan.Register))
  let checks0 := Bool.and(decodedTmaLoad(tmaLoad), decodedTmaStore(tmaStore))
  let checks1 := Bool.and(decodedMma(mma), Bool.and(isRejected(stagingMma), decodedTmemLoad(tmemLoad)))
  let checks2 := Bool.and(orderedLiteralWrites(literalWrites), actionCountIs(payloadWrites, 128))
  let checks3 := Bool.and(actionResultIsNone(invalidRingValue),
    Bool.and(decodedBarrierInit(mbarInit), decodedBarrierArrive(arrive)))
  let checks4 := Bool.and(decodedTmemWait(tmemWait),
    Bool.and(decodedTmemAlloc(sharedAllocator),
      Bool.and(decodedGate(validGate), Bool.and(isRejected(invalidGateId), isRejected(invalidGateThreads)))))
  let allChecks := Bool.and(checks0, Bool.and(checks1, Bool.and(checks2, Bool.and(checks3, checks4))))
  Bool.cond(allChecks, Nat, 1, 0)
}

{ decoderProbeResult }
