import Cuda
import evaluator.BufferControl

def body : Cuda.Block := Cuda.Block.seq(
  Cuda.Stmt.decl(Cuda.DType.u32, 1,
    Cuda.Expr.index(Cuda.Expr.sharedPtr(Cuda.DType.u32, 0), Cuda.Expr.lit(0))),
  Cuda.Block.seq(
    Cuda.Stmt.instr(Cuda.Instr.stShared(Cuda.Expr.sharedAddr(0),
      List.cons(Cuda.Expr.lit(9), List.nil(Cuda.Expr)))),
    Cuda.Block.done))

def result : Nat := Evaluator.BufferControl.summary(
  Evaluator.BufferControl.expandCta(128, 128, 64, body))

{ result }
