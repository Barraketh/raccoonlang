import Cuda
import evaluator.BufferControl
import evaluator.BufferData
import evaluator.BufferGpuEventSchedule
import evaluator.BufferKernels
import evaluator.DeviceApi
import evaluator.TinyGemmLibrary
import evaluator.WarpMachine

namespace Evaluator {
  namespace BufferGpuEventScheduleProbe {
    def expectedGateResult (result: BufferGpuEventSchedule.SchedulerResult): Bool := {
      match result returning Bool with
      | BufferGpuEventSchedule.SchedulerResult.rejected code after => {
        let finalProtocol := BufferGpuEventSchedule.protocolOf(after)
        let gateReset := match BufferGpuEventSchedule.findGate(
            BufferGpuEventSchedule.gateList(finalProtocol), 9) returning Bool with
          | Option.none => Bool.false
          | Option.some reset => {
            match reset returning Bool with
            | WarpMachine.SyncGate.mk id expected arrived remaining released =>
                Bool.and(Nat.isZero(arrived), Bool.and(Nat.isZero(remaining), Bool.not(released)))
          }
        let stepCount := match BufferGpuEventSchedule.statsOf(after) returning Nat with
          | WarpMachine.Stats.mk steps events bytes muls adds mmas loads stores => steps
        Bool.and(Nat.beq(code, BufferGpuEventSchedule.incompleteOutput),
          Bool.and(Nat.beq(stepCount, 1),
            Bool.and(Nat.beq(BufferGpuEventSchedule.cursorOf(after), 5),
              Bool.and(Nat.beq(BufferGpuEventSchedule.finishedMask(finalProtocol), 255),
                Bool.and(BufferGpuEventSchedule.blockedEmpty(BufferGpuEventSchedule.blockedList(finalProtocol)),
                  gateReset)))))
      }
      | BufferGpuEventSchedule.SchedulerResult.finished after => Bool.false
      | BufferGpuEventSchedule.SchedulerResult.deadlocked after => Bool.false
    }

    def emptyTailGateCursor : Bool := {
      let gate := WarpMachine.SyncGate.mk(9, 32, 32, 32, Bool.true)
      let blocked := BufferGpuEventSchedule.Blocked.mk(0,
        BufferGpuEventSchedule.BlockKind.gate(9), DeviceApi.LaneVector.fullMask)
      let protocol := BufferGpuEventSchedule.Protocol.mk(List.nil(WarpMachine.Barrier),
        List.cons(gate, List.nil(WarpMachine.SyncGate)), List.cons(blocked, List.nil(BufferGpuEventSchedule.Blocked)),
        0, Bool.false, 0, 0, Bool.false,
        List.cons(0, List.cons(0, List.cons(0, List.cons(0, List.cons(0, List.cons(0,
          List.cons(0, List.cons(0, List.nil(Nat))))))))))
      let state := BufferGpuEventSchedule.State.mk(protocol, List.nil(BufferGpuEventSchedule.Event), 5,
        WarpMachine.Stats.zero, BufferKernels.initialSupply, List.nil(BufferData.Action),
        List.nil(BufferGpuEventSchedule.Tile))
      BufferGpuEventScheduleProbe.expectedGateResult(BufferGpuEventSchedule.runLoop(TinyGemmApi.kernel,
          List.nil(BufferControl.Trace), List.nil(BufferControl.Trace),
          List.nil(BufferControl.Trace), List.nil(BufferControl.Trace),
          List.nil(BufferControl.Trace), List.nil(BufferControl.Trace),
          List.nil(BufferControl.Trace), List.nil(BufferControl.Trace),
          List.nil(BufferGpuEventSchedule.Event), state))
    }

    def mmaRequest (accumulate: Nat): DeviceApi.DataRequest :=
      DeviceApi.DataRequest.mma(DeviceApi.MmaDesc.mk(Cuda.CtaGroup.one, 0,
        DeviceApi.MmaSource.shared(DeviceApi.OperandDesc.mk(33792, 0, 0)),
        DeviceApi.OperandDesc.mk(50176, 0, 0), Cuda.InstrDesc.mk(128, 128, Bool.false), accumulate))

    def rejectedBeforeInitialization (result: BufferGpuEventSchedule.CompletionResult): Bool := {
      match result returning Bool with
      | BufferGpuEventSchedule.CompletionResult.rejected code =>
          Nat.beq(code, BufferGpuEventSchedule.badDeviceRequest)
      | BufferGpuEventSchedule.CompletionResult.advanced after => Bool.false
      | BufferGpuEventSchedule.CompletionResult.deadlocked after => Bool.false
    }

    def completionLeavesTmemInitialized (result: BufferGpuEventSchedule.CompletionResult): Bool := {
      match result returning Bool with
      | BufferGpuEventSchedule.CompletionResult.advanced after =>
          BufferGpuEventSchedule.tmemIsInitialized(BufferGpuEventSchedule.protocolOf(after))
      | BufferGpuEventSchedule.CompletionResult.rejected code => Bool.false
      | BufferGpuEventSchedule.CompletionResult.deadlocked after => Bool.false
    }

    def initializedMmaCanAccumulate (result: BufferGpuEventSchedule.CompletionResult): Bool := {
      match result returning Bool with
      | BufferGpuEventSchedule.CompletionResult.advanced initialized => {
        let laterAccumulate := BufferGpuEventSchedule.completeDataEvent(initialized, 0,
          BufferGpuEventScheduleProbe.mmaRequest(1), Option.none(Nat), 0, Bool.true, 0)
        Bool.and(BufferGpuEventSchedule.tmemIsInitialized(BufferGpuEventSchedule.protocolOf(initialized)),
          BufferGpuEventScheduleProbe.completionLeavesTmemInitialized(laterAccumulate))
      }
      | BufferGpuEventSchedule.CompletionResult.rejected code => Bool.false
      | BufferGpuEventSchedule.CompletionResult.deadlocked after => Bool.false
    }

    def tmemCompletionGuard : Bool := {
      let initial := BufferGpuEventSchedule.initialState
      let liveProtocol := BufferGpuEventSchedule.withTmem(
        BufferGpuEventSchedule.protocolOf(initial), Bool.true, 0, 128)
      let live := BufferGpuEventSchedule.replaceProtocol(initial, liveProtocol)
      let prematureAccumulate := BufferGpuEventSchedule.completeDataEvent(live, 0,
        BufferGpuEventScheduleProbe.mmaRequest(1), Option.none(Nat), 0, Bool.true, 0)
      let firstInitialization := BufferGpuEventSchedule.completeDataEvent(live, 0,
        BufferGpuEventScheduleProbe.mmaRequest(0), Option.none(Nat), 0, Bool.true, 0)
      Bool.and(BufferGpuEventScheduleProbe.rejectedBeforeInitialization(prematureAccumulate),
        BufferGpuEventScheduleProbe.initializedMmaCanAccumulate(firstInitialization))
    }
  }
}

{ (Evaluator.BufferGpuEventScheduleProbe.emptyTailGateCursor,
    Evaluator.BufferGpuEventScheduleProbe.tmemCompletionGuard) }
