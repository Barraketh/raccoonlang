import buffer.Program
import Cuda
import evaluator.BufferData
import evaluator.BufferKernels
import evaluator.DeviceApi

namespace Evaluator {
 namespace BufferKernelsProbe {
  open BufferData
  def aValue (row: Nat)(k: Nat): Nat := Nat.mod(Nat.add(Nat.add(Nat.mul(row, 3), Nat.mul(k, 5)), 7), 257)
  def bValue (row: Nat)(k: Nat): Nat := Nat.mod(Nat.add(Nat.add(Nat.mul(row, 11), Nat.mul(k, 13)), 9), 257)

  def aRowBytes (row: Nat)(k: Nat)(remaining: Nat): List(Nat) decreases structural(remaining) := {
    match remaining returning List(Nat) with
    | Nat.zero => List.nil(Nat)
    | Nat.succ rest => {
      let value := BufferKernelsProbe.aValue(row, k)
      List.cons(Nat.mod(value, 256), List.cons(Nat.div(value, 256),
        BufferKernelsProbe.aRowBytes(row, Nat.succ(k), rest)))
    }
  }

  def bRowBytes (row: Nat)(k: Nat)(remaining: Nat): List(Nat) decreases structural(remaining) := {
    match remaining returning List(Nat) with
    | Nat.zero => List.nil(Nat)
    | Nat.succ rest => {
      let value := BufferKernelsProbe.bValue(row, k)
      List.cons(Nat.mod(value, 256), List.cons(Nat.div(value, 256),
        BufferKernelsProbe.bRowBytes(row, Nat.succ(k), rest)))
    }
  }

  def aBytes (row: Nat)(remainingRows: Nat): List(Nat) decreases structural(remainingRows) := {
    match remainingRows returning List(Nat) with
    | Nat.zero => List.nil(Nat)
    | Nat.succ rest => List.append(BufferKernelsProbe.aRowBytes(row, 0, 64),
        BufferKernelsProbe.aBytes(Nat.succ(row), rest))
  }

  def bBytes (row: Nat)(remainingRows: Nat): List(Nat) decreases structural(remainingRows) := {
    match remainingRows returning List(Nat) with
    | Nat.zero => List.nil(Nat)
    | Nat.succ rest => List.append(BufferKernelsProbe.bRowBytes(row, 0, 64),
        BufferKernelsProbe.bBytes(Nat.succ(row), rest))
  }

  def inputA : List(Nat) := BufferKernelsProbe.aBytes(0, 128)
  def inputB : List(Nat) := BufferKernelsProbe.bBytes(0, 128)
  def inputs : List(List(Nat)) := List.cons(BufferKernelsProbe.inputA,
    List.cons(BufferKernelsProbe.inputB, List.nil(List(Nat))))

  def mapA : DeviceApi.ResolvedMap := DeviceApi.ResolvedMap.mk(
    Cuda.MapEncoding.mk("A_map", Cuda.MapUse.load, Cuda.Param.input(Cuda.DType.bf16, "A"), "M", "K", 64, 128),
    128, 64)
  def mapB : DeviceApi.ResolvedMap := DeviceApi.ResolvedMap.mk(
    Cuda.MapEncoding.mk("B_map", Cuda.MapUse.load, Cuda.Param.input(Cuda.DType.bf16, "B"), "N", "K", 64, 128),
    128, 64)
  def mapC : DeviceApi.ResolvedMap := DeviceApi.ResolvedMap.mk(
    Cuda.MapEncoding.mk("C_map", Cuda.MapUse.store, Cuda.Param.output(Cuda.DType.f32, "C"), "M", "N", 32, 32),
    128, 128)

  def inputARequest : DeviceApi.DataRequest := DeviceApi.DataRequest.tmaLoad(BufferKernelsProbe.mapA, 33792, 0, 0)
  def inputBRequest : DeviceApi.DataRequest := DeviceApi.DataRequest.tmaLoad(BufferKernelsProbe.mapB, 50176, 0, 0)

  def mmaDesc (step: Nat)(accumulate: Nat): DeviceApi.MmaDesc :=
    DeviceApi.MmaDesc.mk(Cuda.CtaGroup.one, 0,
      DeviceApi.MmaSource.shared(DeviceApi.OperandDesc.mk(33792, 0, step)),
      DeviceApi.OperandDesc.mk(50176, 0, step), Cuda.InstrDesc.mk(128, 128, Bool.false), accumulate)

  def ids8 : List(Nat) := List.cons(0, List.cons(1, List.cons(2, List.cons(3,
    List.cons(4, List.cons(5, List.cons(6, List.cons(7, List.nil(Nat)))))))))

  def loadRequest : DeviceApi.DataRequest := DeviceApi.DataRequest.tmemLoad(
    Cuda.TmemShape.s32x32b, BufferKernelsProbe.ids8, 0, 0, 4294967295)

  def outputRequest : DeviceApi.DataRequest := DeviceApi.DataRequest.tmaStore(BufferKernelsProbe.mapC, 64, 32, 164864)

  def takeFragment (result: BufferKernels.FragmentResult): BufferKernels.Fragment := {
    match result returning BufferKernels.Fragment with
    | BufferKernels.FragmentResult.emitted fragment => fragment
    | BufferKernels.FragmentResult.unsupported reason =>
        BufferKernels.Fragment.mk(List.nil(BufferData.Action), BufferKernels.initialSupply)
  }

  def accepted (result: BufferKernels.FragmentResult): Nat := {
    match result returning Nat with
    | BufferKernels.FragmentResult.emitted fragment => 1
    | BufferKernels.FragmentResult.unsupported reason => 0
  }

  def rejected (result: BufferKernels.FragmentResult): Nat := {
    match result returning Nat with
    | BufferKernels.FragmentResult.emitted fragment => 0
    | BufferKernels.FragmentResult.unsupported reason => 1
  }

  def fragmentActions (fragment: BufferKernels.Fragment): List(BufferData.Action) := {
    match fragment returning List(BufferData.Action) with
    | BufferKernels.Fragment.mk actions supply => actions
  }

  def fragmentSupply (fragment: BufferKernels.Fragment): BufferKernels.SlotSupply := {
    match fragment returning BufferKernels.SlotSupply with
    | BufferKernels.Fragment.mk actions supply => supply
  }

  def loadAResult : BufferKernels.FragmentResult := BufferKernels.tmaLoad(BufferKernels.initialSupply,
    BufferKernelsProbe.inputARequest)
  def loadA : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.loadAResult)
  def loadBResult : BufferKernels.FragmentResult := BufferKernels.tmaLoad(BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.loadA),
    BufferKernelsProbe.inputBRequest)
  def loadB : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.loadBResult)

  def firstMmaResult : BufferKernels.FragmentResult := BufferKernels.mma(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.loadB), BufferKernelsProbe.mmaDesc(2, 0))
  def firstMma : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.firstMmaResult)
  def firstLoadResult : BufferKernels.FragmentResult := BufferKernels.tmemLoad(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.firstMma), BufferKernelsProbe.loadRequest, 0)
  def firstLoad : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.firstLoadResult)

  def secondMmaResult : BufferKernels.FragmentResult := BufferKernels.mma(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.firstLoad), BufferKernelsProbe.mmaDesc(3, 1))
  def secondMma : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.secondMmaResult)
  def secondLoadResult : BufferKernels.FragmentResult := BufferKernels.tmemLoad(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.secondMma), BufferKernelsProbe.loadRequest, 1)
  def secondLoad : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.secondLoadResult)

  def replay00Result : BufferKernels.FragmentResult := BufferKernels.copySnapshotToShared(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.secondLoad), 0, 0, 0, 164864)
  def replay00 : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.replay00Result)
  def replay10Result : BufferKernels.FragmentResult := BufferKernels.copySnapshotToShared(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.secondLoad), 1, 0, 0, 164868)
  def replay10 : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.replay10Result)
  def replay04Result : BufferKernels.FragmentResult := BufferKernels.copySnapshotToShared(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.secondLoad), 0, 4, 3, 164872)
  def replay04 : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.replay04Result)
  def replay14Result : BufferKernels.FragmentResult := BufferKernels.copySnapshotToShared(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.secondLoad), 1, 4, 3, 164876)
  def replay14 : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.replay14Result)
  def replayRow1Result : BufferKernels.FragmentResult := BufferKernels.copySnapshotToShared(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.secondLoad), 1, 0, 0, 165008)
  def replayRow1 : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.replayRow1Result)
  def outputResult : BufferKernels.FragmentResult := BufferKernels.tmaStore(
    BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.secondLoad), BufferKernelsProbe.outputRequest)
  def output : BufferKernels.Fragment := BufferKernelsProbe.takeFragment(BufferKernelsProbe.outputResult)

  def badInputCoordinates : BufferKernels.FragmentResult := BufferKernels.tmaLoad(
    BufferKernels.initialSupply, DeviceApi.DataRequest.tmaLoad(BufferKernelsProbe.mapA, 33792, 1, 0))
  def badInputExtent : BufferKernels.FragmentResult := BufferKernels.tmaLoad(BufferKernels.initialSupply,
    DeviceApi.DataRequest.tmaLoad(DeviceApi.ResolvedMap.mk(
      Cuda.MapEncoding.mk("A_map", Cuda.MapUse.load, Cuda.Param.input(Cuda.DType.bf16, "A"), "M", "K", 64, 128),
      127, 64), 33792, 0, 0))
  def badOutputCoordinates : BufferKernels.FragmentResult := BufferKernels.tmaStore(
    BufferKernels.initialSupply, DeviceApi.DataRequest.tmaStore(BufferKernelsProbe.mapC, 65, 32, 164864))
  def badMmaStep : BufferKernels.FragmentResult := BufferKernels.mma(
    BufferKernels.initialSupply, BufferKernelsProbe.mmaDesc(4, 0))
  def badMmaShape : BufferKernels.FragmentResult := BufferKernels.mma(BufferKernels.initialSupply,
    DeviceApi.MmaDesc.mk(Cuda.CtaGroup.one, 0,
      DeviceApi.MmaSource.shared(DeviceApi.OperandDesc.mk(33792, 0, 0)),
      DeviceApi.OperandDesc.mk(50176, 0, 0), Cuda.InstrDesc.mk(64, 128, Bool.false), 0))

  def acceptedFragments : Nat := Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.loadAResult),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.loadBResult),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.firstMmaResult),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.firstLoadResult),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.secondMmaResult),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.secondLoadResult),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.replay00Result),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.replay10Result),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.replay04Result),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.replay14Result),
    Nat.add(BufferKernelsProbe.accepted(BufferKernelsProbe.replayRow1Result),
      BufferKernelsProbe.accepted(BufferKernelsProbe.outputResult))))))))))))

  def rejectedFragments : Nat := Nat.add(BufferKernelsProbe.rejected(BufferKernelsProbe.badInputCoordinates),
    Nat.add(BufferKernelsProbe.rejected(BufferKernelsProbe.badOutputCoordinates),
    Nat.add(BufferKernelsProbe.rejected(BufferKernelsProbe.badMmaStep),
      Nat.add(BufferKernelsProbe.rejected(BufferKernelsProbe.badInputExtent),
        BufferKernelsProbe.rejected(BufferKernelsProbe.badMmaShape)))))

  def allActions : List(BufferData.Action) := List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.loadA),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.loadB),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.firstMma),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.firstLoad),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.secondMma),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.secondLoad),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.replay00),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.replay10),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.replay04),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.replay14),
    List.append(BufferKernelsProbe.fragmentActions(BufferKernelsProbe.replayRow1),
      BufferKernelsProbe.fragmentActions(BufferKernelsProbe.output))))))))))))

  def finalSupply : BufferKernels.SlotSupply := BufferKernelsProbe.fragmentSupply(BufferKernelsProbe.output)
  def layout : BufferData.Layout := BufferData.Layout.mk(16384, 16384, 172032, 65536, 2048, 65536)

  def runLowered (lowered: BufferData.LowerResult): Buffer.Result := {
    match lowered returning Buffer.Result with
    | BufferData.LowerResult.program program => Buffer.run(program, BufferKernelsProbe.inputs)
    | BufferData.LowerResult.rejected error => Buffer.Result.failure(99)
  }

  def programResult : Buffer.Result := BufferKernelsProbe.runLowered(
    BufferData.lower(BufferKernelsProbe.layout, BufferKernels.slots32(BufferKernelsProbe.finalSupply),
      BufferKernels.slots64(BufferKernelsProbe.finalSupply), BufferKernelsProbe.allActions))

  def result : Pair(Buffer.Result, Nat) :=
    Pair.mk(BufferKernelsProbe.programResult,
      Nat.add(BufferKernelsProbe.acceptedFragments, BufferKernelsProbe.rejectedFragments))
 }
}

{ Evaluator.BufferKernelsProbe.result }
