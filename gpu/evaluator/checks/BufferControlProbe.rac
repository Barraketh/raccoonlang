import Cuda
import evaluator.BufferControl
import evaluator.BufferPlan

def fullMask : Nat := Nat.sub(Nat.pow(2, 32), 1)
def oneLane : Nat := 1

def block : Cuda.Block := Cuda.Block.seq(
  Cuda.Stmt.decl(Cuda.DType.u32, 1, Cuda.Expr.lit(7)),
  Cuda.Block.seq(
    Cuda.Stmt.ifElse(Cuda.Expr.bin(Cuda.BinOp.eq, Cuda.Expr.var(1), Cuda.Expr.lit(7)),
      Cuda.Block.seq(Cuda.Stmt.assign(1, Cuda.Expr.lit(9)), Cuda.Block.done), Cuda.Block.done),
    Cuda.Block.done))

def loopBlock : Cuda.Block := Cuda.Block.seq(
  Cuda.Stmt.decl(Cuda.DType.u32, 2, Cuda.Expr.lit(0)),
  Cuda.Block.seq(
    Cuda.Stmt.forLoop(3, Cuda.Expr.lit(0), Cuda.Expr.lit(3),
      Cuda.Block.seq(Cuda.Stmt.assign(2,
        Cuda.Expr.bin(Cuda.BinOp.add, Cuda.Expr.var(2), Cuda.Expr.var(3))), Cuda.Block.done)),
    Cuda.Block.done))

def expandedLoop : Evaluator.BufferControl.Result :=
  Evaluator.BufferControl.expand(0, fullMask, 128, 128, 64, loopBlock)

def loopValue: Option(Nat) := {
  match expandedLoop returning Option(Nat) with
  | Evaluator.BufferControl.Result.success state => {
    match state returning Option(Nat) with
    | Evaluator.BufferControl.State.mk registers events count nextSnapshot => {
      match Evaluator.BufferControl.findRegister(registers, 2) returning Option(Nat) with
      | Option.some register => {
        match register returning Option(Nat) with
        | Evaluator.BufferPlan.Register.mk id values mask => Evaluator.BufferPlan.knownLane(values, 0)
      }
    }
  }
}

def badDivision : Cuda.Expr := Cuda.Expr.bin(Cuda.BinOp.div, Cuda.Expr.lit(1), Cuda.Expr.lit(0))

def unusedBadDecl : Cuda.Block :=
  Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.u32, 8, badDivision), Cuda.Block.done)

def unusedBadCast : Cuda.Block :=
  Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.u32, 8,
    Cuda.Expr.cast(Cuda.DType.f32, Cuda.Expr.lit(1))), Cuda.Block.done)

def inactiveBadArm : Cuda.Block :=
  Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.u32, 9,
    Cuda.Expr.select(Cuda.Expr.lit(1), Cuda.Expr.lit(7), badDivision)), Cuda.Block.done)

def undeclaredAssignment : Cuda.Block :=
  Cuda.Block.seq(Cuda.Stmt.assign(99, Cuda.Expr.lit(7)), Cuda.Block.done)

def snapshotLoopBlock : Cuda.Block := Cuda.Block.seq(
  Cuda.Stmt.decl(Cuda.DType.u32, 1, Cuda.Expr.lit(4)),
  Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.u32, 2, Cuda.Expr.lit(0)),
    Cuda.Block.seq(Cuda.Stmt.forStride(3, Cuda.Expr.lit(0), Cuda.Expr.var(1), Cuda.Expr.lit(2),
      Cuda.Block.seq(Cuda.Stmt.assign(2,
        Cuda.Expr.bin(Cuda.BinOp.add, Cuda.Expr.var(2), Cuda.Expr.var(3))),
        Cuda.Block.seq(Cuda.Stmt.assign(1, Cuda.Expr.lit(0)), Cuda.Block.done))), Cuda.Block.done)))

def zeroTripBlock : Cuda.Block := Cuda.Block.seq(
  Cuda.Stmt.forLoop(4, Cuda.Expr.lit(7), Cuda.Expr.lit(7),
    Cuda.Block.done), Cuda.Block.done)

def zeroStrideBlock : Cuda.Block := Cuda.Block.seq(
  Cuda.Stmt.forStride(5, Cuda.Expr.lit(0), Cuda.Expr.lit(7), Cuda.Expr.lit(0), Cuda.Block.done),
  Cuda.Block.done)

def inductionWriteBlock : Cuda.Block := Cuda.Block.seq(
  Cuda.Stmt.forLoop(6, Cuda.Expr.lit(0), Cuda.Expr.lit(1),
    Cuda.Block.seq(Cuda.Stmt.assign(6, Cuda.Expr.lit(9)), Cuda.Block.done)), Cuda.Block.done)

def laneZero (registers: List(Evaluator.BufferPlan.Register))(id: Nat): Nat := {
  match Evaluator.BufferControl.findRegister(registers, id) returning Nat with
  | Option.none => 999
  | Option.some register => {
    match register returning Nat with
    | Evaluator.BufferPlan.Register.mk found values mask =>
        Option.getD(Evaluator.BufferPlan.knownLane(values, 0), 999)
  }
}

def laneAt (registers: List(Evaluator.BufferPlan.Register))(id: Nat)(lane: Nat): Nat := {
  match Evaluator.BufferControl.findRegister(registers, id) returning Nat with
  | Option.none => 999
  | Option.some register => {
    match register returning Nat with
    | Evaluator.BufferPlan.Register.mk found values mask =>
        Option.getD(Evaluator.BufferPlan.knownLane(values, lane), 999)
  }
}

def loadIds : List(Nat) := List.cons(20, List.cons(21, List.cons(22, List.cons(23,
  List.cons(24, List.cons(25, List.cons(26, List.cons(27, List.nil(Nat)))))))))

def loadDestinationDecls (rest: Cuda.Block): Cuda.Block :=
  Cuda.Block.seq(Cuda.Stmt.declOut(Cuda.DType.f32, 21), Cuda.Block.seq(
    Cuda.Stmt.declOut(Cuda.DType.f32, 22), Cuda.Block.seq(
      Cuda.Stmt.declOut(Cuda.DType.f32, 23), Cuda.Block.seq(
        Cuda.Stmt.declOut(Cuda.DType.f32, 24), Cuda.Block.seq(
          Cuda.Stmt.declOut(Cuda.DType.f32, 25), Cuda.Block.seq(
            Cuda.Stmt.declOut(Cuda.DType.f32, 26), Cuda.Block.seq(
              Cuda.Stmt.declOut(Cuda.DType.f32, 27), rest)))))))

def tmemLoadStmt : Cuda.Stmt :=
  Cuda.Stmt.instr(Cuda.Instr.tmemLoad(Cuda.TmemShape.s32x32b, loadIds, Cuda.Expr.lit(0)))

def electBlock : Cuda.Block := Cuda.Block.seq(
  Cuda.Stmt.decl(Cuda.DType.u32, 10, Cuda.Expr.lit(0)),
  Cuda.Block.seq(Cuda.Stmt.instr(Cuda.Instr.elect(10)), Cuda.Block.done))

def checksOldValue : Cuda.Block :=
  Cuda.Block.seq(Cuda.Stmt.ifElse(Cuda.Expr.bin(Cuda.BinOp.eq, Cuda.Expr.var(20), Cuda.Expr.lit(7)),
    Cuda.Block.done, Cuda.Block.done), Cuda.Block.done)

def oldValueBeforeWait : Cuda.Block := {
  let afterLoad := Cuda.Block.seq(tmemLoadStmt, checksOldValue)
  Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.f32, 20, Cuda.Expr.lit(7)), loadDestinationDecls(afterLoad))
}

def payloadAfterWait : Cuda.Block := {
  let afterWait := Cuda.Block.seq(Cuda.Stmt.instr(Cuda.Instr.tmemWait(Cuda.TmemWait.load)), checksOldValue)
  let afterLoad := Cuda.Block.seq(tmemLoadStmt, afterWait)
  Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.f32, 20, Cuda.Expr.lit(7)), loadDestinationDecls(afterLoad))
}

def twoSnapshotLoads : Cuda.Block := {
  let afterWait := Cuda.Block.seq(Cuda.Stmt.instr(Cuda.Instr.tmemWait(Cuda.TmemWait.load)), Cuda.Block.done)
  let afterSecondLoad := Cuda.Block.seq(tmemLoadStmt, afterWait)
  let afterFirstLoad := Cuda.Block.seq(tmemLoadStmt, afterSecondLoad)
  Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.f32, 20, Cuda.Expr.lit(7)), loadDestinationDecls(afterFirstLoad))
}

def copiedSnapshotLoads : Cuda.Block := {
  let afterSecondWait := Cuda.Block.seq(Cuda.Stmt.instr(Cuda.Instr.tmemWait(Cuda.TmemWait.load)), Cuda.Block.done)
  let afterSecondLoad := Cuda.Block.seq(tmemLoadStmt, afterSecondWait)
  let afterCopy := Cuda.Block.seq(Cuda.Stmt.assign(30, Cuda.Expr.var(20)), afterSecondLoad)
  let afterFirstWait := Cuda.Block.seq(Cuda.Stmt.instr(Cuda.Instr.tmemWait(Cuda.TmemWait.load)), afterCopy)
  let afterFirstLoad := Cuda.Block.seq(tmemLoadStmt, afterFirstWait)
  let destinations := Cuda.Block.seq(Cuda.Stmt.declOut(Cuda.DType.f32, 30),
    Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.f32, 20, Cuda.Expr.lit(7)), loadDestinationDecls(afterFirstLoad)))
  destinations
}

def loadWaitOnly : Cuda.Block :=
  Cuda.Block.seq(tmemLoadStmt,
    Cuda.Block.seq(Cuda.Stmt.instr(Cuda.Instr.tmemWait(Cuda.TmemWait.load)), Cuda.Block.done))

def crossWarpWait : Cuda.Block :=
  Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.f32, 20, Cuda.Expr.lit(7)),
    Cuda.Block.seq(Cuda.Stmt.instr(Cuda.Instr.tmemWait(Cuda.TmemWait.load)), Cuda.Block.done))

def unwaitedWarpLoad : Cuda.Block :=
  Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.f32, 20, Cuda.Expr.lit(7)),
    loadDestinationDecls(Cuda.Block.seq(tmemLoadStmt, Cuda.Block.done)))

def payloadKeyAt (registers: List(Evaluator.BufferPlan.Register))(id: Nat)(lane: Nat): Nat := {
  match Evaluator.BufferControl.findRegister(registers, id) returning Nat with
  | Option.none => 999999
  | Option.some register => {
    match register returning Nat with
    | Evaluator.BufferPlan.Register.mk found values mask => {
      match Evaluator.BufferControl.scalarAt(values, lane) returning Nat with
      | Option.none => 999999
      | Option.some value => {
        match value returning Nat with
        | Evaluator.BufferPlan.Scalar.payload key => key
        | _ => 999999
      }
    }
  }
}

def snapshotLoopCheck : Nat := {
  match Evaluator.BufferControl.expand(0, fullMask, 128, 128, 64, snapshotLoopBlock) returning Nat with
  | Evaluator.BufferControl.Result.success state => {
    match state returning Nat with
    | Evaluator.BufferControl.State.mk registers events workCount nextSnapshot => {
      let sumIsTwo := Nat.beq(laneZero(registers, 2), 2)
      let boundIsZero := Nat.isZero(laneZero(registers, 1))
      let indexIsFour := Nat.beq(laneZero(registers, 3), 4)
      Bool.cond(Bool.and(sumIsTwo, Bool.and(boundIsZero, indexIsFour)), Nat, 1, 0)
    }
  }
}

def zeroTripCheck : Nat := {
  match Evaluator.BufferControl.expand(0, fullMask, 128, 128, 64, zeroTripBlock) returning Nat with
  | Evaluator.BufferControl.Result.success state => {
    match state returning Nat with
    | Evaluator.BufferControl.State.mk registers events workCount nextSnapshot =>
        Bool.cond(Nat.beq(laneZero(registers, 4), 7), Nat, 1, 0)
  }
}

def mixedAndValues : Option(Pair(Nat, Nat)) := {
  let registers := List.cons(
    Evaluator.BufferPlan.Register.mk(1,
      List.cons(Evaluator.BufferPlan.Scalar.known(0),
        List.cons(Evaluator.BufferPlan.Scalar.known(1),
          Evaluator.BufferPlan.repeated(Evaluator.BufferPlan.Scalar.known(0), 30))), 3),
    List.cons(Evaluator.BufferPlan.Register.mk(2,
      List.cons(Evaluator.BufferPlan.Scalar.payload(6),
        List.cons(Evaluator.BufferPlan.Scalar.known(1),
          Evaluator.BufferPlan.repeated(Evaluator.BufferPlan.Scalar.payload(6), 30))), 2),
      List.nil(Evaluator.BufferPlan.Register)))
  match Evaluator.BufferPlan.eval(0, 3, registers, 128, 128, 64,
      Cuda.Expr.bin(Cuda.BinOp.land, Cuda.Expr.var(1), Cuda.Expr.var(2))) returning Option(Pair(Nat, Nat)) with
  | Evaluator.BufferPlan.ExprValue.lanes values => {
    match Evaluator.BufferPlan.knownLane(values, 0) returning Option(Pair(Nat, Nat)) with
    | Option.some zeroLane => {
      match Evaluator.BufferPlan.knownLane(values, 1) returning Option(Pair(Nat, Nat)) with
      | Option.some oneLaneValue => Option.some((zeroLane, oneLaneValue))
    }
  }
}

def mixedAndCorrect : Bool := {
  match mixedAndValues returning Bool with
  | Option.some lanes => {
    let (first, second) := lanes
    Bool.and(Nat.isZero(first), Nat.beq(second, 1))
  }
}

def isRejected (mask: Nat)(candidate: Cuda.Block): Bool := {
  match Evaluator.BufferControl.expand(0, mask, 128, 128, 64, candidate) returning Bool with
      | Evaluator.BufferControl.Result.rejected reason => Bool.true
      | Evaluator.BufferControl.Result.success state => Bool.false
}

def isAccepted (mask: Nat)(candidate: Cuda.Block): Bool := {
  match Evaluator.BufferControl.expand(0, mask, 128, 128, 64, candidate) returning Bool with
  | Evaluator.BufferControl.Result.rejected reason => Bool.false
  | Evaluator.BufferControl.Result.success state => Bool.true
}

def instructionStateCheck : Bool := {
  match Evaluator.BufferControl.expand(0, fullMask, 128, 128, 64, electBlock) returning Bool with
  | Evaluator.BufferControl.Result.success elected => {
    match elected returning Bool with
    | Evaluator.BufferControl.State.mk electRegisters electTraces electWork electSnapshots => {
      let immediate := Bool.and(Nat.beq(laneAt(electRegisters, 10, 0), 1),
        Nat.isZero(laneAt(electRegisters, 10, 1)))
      let oldReadable := isAccepted(fullMask, oldValueBeforeWait)
      let postWaitBlocked := isRejected(fullMask, payloadAfterWait)
      let olderWins := {
        match Evaluator.BufferControl.expand(0, fullMask, 128, 128, 64, twoSnapshotLoads) returning Bool with
        | Evaluator.BufferControl.Result.success loaded => {
          match loaded returning Bool with
          | Evaluator.BufferControl.State.mk loadRegisters loadTraces loadWork loadSnapshots =>
              Bool.and(Nat.beq(loadSnapshots, 2), Bool.and(Nat.beq(payloadKeyAt(loadRegisters, 20, 0), 0),
                Nat.beq(payloadKeyAt(loadRegisters, 20, 1), 4)))
        }
      }
      let copiedKeysStayStable := {
        match Evaluator.BufferControl.expand(0, fullMask, 128, 128, 64, copiedSnapshotLoads) returning Bool with
        | Evaluator.BufferControl.Result.success loaded => {
          match loaded returning Bool with
          | Evaluator.BufferControl.State.mk loadRegisters loadTraces loadWork loadSnapshots =>
              Bool.and(Nat.beq(loadSnapshots, 2), Bool.and(
                Nat.beq(payloadKeyAt(loadRegisters, 30, 0), 0),
                Bool.and(Nat.beq(payloadKeyAt(loadRegisters, 30, 1), 4),
                  Bool.and(Nat.beq(payloadKeyAt(loadRegisters, 20, 0), 1024),
                    Bool.and(Nat.beq(payloadKeyAt(loadRegisters, 21, 0), 1152),
                      Nat.beq(payloadKeyAt(loadRegisters, 20, 1), 1028))))))
        }
      }
      let crossWarpOrdinalsAdvance := {
        match Evaluator.BufferControl.expand(0, fullMask, 128, 128, 64, twoSnapshotLoads) returning Bool with
        | Evaluator.BufferControl.Result.success firstWarp => {
          match Evaluator.BufferControl.expandWarp(1, fullMask, firstWarp, 128, 128, 64,
              loadWaitOnly) returning Bool with
          | Evaluator.BufferControl.Result.success secondWarp => {
            match secondWarp returning Bool with
            | Evaluator.BufferControl.State.mk warpRegisters warpTraces warpWork warpSnapshots =>
                Bool.and(Nat.beq(warpSnapshots, 3), Bool.and(
                  Nat.beq(payloadKeyAt(warpRegisters, 20, 0), 2048),
                  Nat.beq(payloadKeyAt(warpRegisters, 21, 0), 2176)))
          }
        }
      }
      let waitDoesNotPublishOtherWarp := {
        match Evaluator.BufferControl.expand(0, fullMask, 128, 128, 64,
            unwaitedWarpLoad) returning Bool with
        | Evaluator.BufferControl.Result.success firstWarp => {
          match Evaluator.BufferControl.expandWarp(1, fullMask, firstWarp, 128, 128, 64,
              crossWarpWait) returning Bool with
          | Evaluator.BufferControl.Result.success secondWarp => {
            match secondWarp returning Bool with
            | Evaluator.BufferControl.State.mk warpRegisters warpTraces warpWork warpSnapshots =>
                Bool.and(Nat.beq(warpSnapshots, 1),
                  Nat.beq(laneZero(warpRegisters, 20), 7))
          }
        }
      }
      Bool.and(immediate, Bool.and(oldReadable, Bool.and(postWaitBlocked,
        Bool.and(olderWins, Bool.and(copiedKeysStayStable,
          Bool.and(crossWarpOrdinalsAdvance, waitDoesNotPublishOtherWarp))))))
    }
  }
}

def baseControlWorks : Bool := {
  match Evaluator.BufferControl.expand(0, fullMask, 128, 128, 64, block) returning Bool with
  | Evaluator.BufferControl.Result.success state => Nat.beq(Option.getD(loopValue, 999), 3)
}

def result : Nat := {
  let strictRejects := Bool.and(isRejected(fullMask, unusedBadDecl),
    Bool.and(isRejected(fullMask, unusedBadCast), isRejected(fullMask, undeclaredAssignment)))
  let badLoopsReject := Bool.and(isRejected(fullMask, zeroStrideBlock), isRejected(fullMask, inductionWriteBlock))
  let maskedSucceeds := isAccepted(oneLane, inactiveBadArm)
  let allPass := Bool.and(baseControlWorks, Bool.and(strictRejects,
    Bool.and(maskedSucceeds, Bool.and(mixedAndCorrect, Bool.and(Nat.beq(snapshotLoopCheck, 1),
      Bool.and(Nat.beq(zeroTripCheck, 1), Bool.and(badLoopsReject, instructionStateCheck)))))))
  Bool.cond(allPass, Nat, 1, 0)
}

{ result }
