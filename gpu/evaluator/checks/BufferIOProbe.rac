import evaluator.BufferIO

namespace Evaluator {
  namespace BufferIOProbe {
    def validValues : List(Nat) := List.cons(0, List.cons(1, List.cons(255, List.cons(256, List.nil(Nat)))))
    def expectedEncodedBytes : List(Nat) := List.cons(0, List.cons(0, List.cons(1, List.cons(0,
      List.cons(255, List.cons(0, List.cons(0, List.cons(1, List.nil(Nat)))))))))
    def shortValues : List(Nat) := List.cons(0, List.cons(1, List.cons(255, List.nil(Nat))))
    def extraValues : List(Nat) := List.cons(0, List.cons(1, List.cons(255,
      List.cons(256, List.cons(0, List.nil(Nat))))))
    def badValue : List(Nat) := List.cons(257, List.nil(Nat))

    def word0Bytes : List(Nat) := List.cons(0, List.cons(0, List.cons(0, List.cons(0, List.nil(Nat)))))
    def word1Bytes : List(Nat) := List.cons(1, List.cons(0, List.cons(0, List.cons(0, List.nil(Nat)))))
    def word255Bytes : List(Nat) := List.cons(255, List.cons(0, List.cons(0, List.cons(0, List.nil(Nat)))))
    def word256Bytes : List(Nat) := List.cons(0, List.cons(1, List.cons(0, List.cons(0, List.nil(Nat)))))
    def validWordsBytes : List(Nat) := List.append(BufferIOProbe.word0Bytes,
      List.append(BufferIOProbe.word1Bytes,
        List.append(BufferIOProbe.word255Bytes, BufferIOProbe.word256Bytes)))
    def shortBytes : List(Nat) := List.append(BufferIOProbe.word0Bytes,
      List.append(BufferIOProbe.word1Bytes, BufferIOProbe.word255Bytes))
    def extraBytes : List(Nat) := List.append(BufferIOProbe.validWordsBytes,
      BufferIOProbe.word0Bytes)
    def badByte : List(Nat) := List.cons(0, List.cons(0, List.cons(0, List.cons(256, List.nil(Nat)))))
    def value257Bytes : List(Nat) := List.cons(1, List.cons(1, List.cons(0, List.cons(0, List.nil(Nat)))))

    def encoded : Option(List(Nat)) := BufferIO.encode16(BufferIOProbe.validValues, 4)
    def badEncodeValue : Option(List(Nat)) := BufferIO.encode16(BufferIOProbe.badValue, 1)
    def badEncodeShort : Option(List(Nat)) := BufferIO.encode16(BufferIOProbe.shortValues, 4)
    def badEncodeExtra : Option(List(Nat)) := BufferIO.encode16(BufferIOProbe.extraValues, 4)
    def encodedZero : Option(List(Nat)) := BufferIO.encode16(List.nil(Nat), 0)
    def encodedZeroExtra : Option(List(Nat)) := BufferIO.encode16(List.cons(0, List.nil(Nat)), 0)

    def decoded : Option(List(Nat)) := BufferIO.decode32(BufferIOProbe.validWordsBytes, 4)
    def badDecodeByte : Option(List(Nat)) := BufferIO.decode32(BufferIOProbe.badByte, 1)
    def badDecodeShort : Option(List(Nat)) := BufferIO.decode32(BufferIOProbe.shortBytes, 4)
    def badDecodeExtra : Option(List(Nat)) := BufferIO.decode32(BufferIOProbe.extraBytes, 4)
    def badDecodeValue : Option(List(Nat)) := BufferIO.decode32(BufferIOProbe.value257Bytes, 1)
    def decodedZero : Option(List(Nat)) := BufferIO.decode32(List.nil(Nat), 0)
    def decodedZeroExtra : Option(List(Nat)) := BufferIO.decode32(BufferIOProbe.validWordsBytes, 0)

    def encodeResults : List(Option(List(Nat))) := List.cons(BufferIOProbe.encoded,
      List.cons(BufferIOProbe.badEncodeValue,
        List.cons(BufferIOProbe.badEncodeShort,
          List.cons(BufferIOProbe.badEncodeExtra,
            List.cons(BufferIOProbe.encodedZero,
              List.cons(BufferIOProbe.encodedZeroExtra, List.nil(Option(List(Nat)))))))))
    def decodeResults : List(Option(List(Nat))) := List.cons(BufferIOProbe.decoded,
      List.cons(BufferIOProbe.badDecodeByte,
        List.cons(BufferIOProbe.badDecodeShort,
          List.cons(BufferIOProbe.badDecodeExtra,
            List.cons(BufferIOProbe.badDecodeValue,
              List.cons(BufferIOProbe.decodedZero,
                List.cons(BufferIOProbe.decodedZeroExtra, List.nil(Option(List(Nat))))))))))
    def results : List(Option(List(Nat))) := List.append(BufferIOProbe.encodeResults, BufferIOProbe.decodeResults)
  }
}

{ Evaluator.BufferIOProbe.results }
