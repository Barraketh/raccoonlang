import buffer.Program
import evaluator.BufferData

namespace BufferDataProbe {
  open BufferData

  def layout : Layout := Layout.mk(6, 8, 8, 12, 8, 12)

  def elementOffset (scale: Nat): Expr64 :=
    Expr64.binary(Bin64.mul, Expr64.extend32(Expr32.ref(0)), Expr64.literal(scale))

  def loopBody : List(Action) :=
    List.cons(Action.load16(BufferRef.inputA, BufferDataProbe.elementOffset(2), 2),
    List.cons(Action.store16(BufferRef.shared, BufferDataProbe.elementOffset(2), Expr32.ref(2)),
    List.cons(Action.load16(BufferRef.shared, BufferDataProbe.elementOffset(2), 3),
    List.cons(Action.store32(BufferRef.tmem, BufferDataProbe.elementOffset(4), Expr32.ref(3)),
    List.cons(Action.load32(BufferRef.tmem, BufferDataProbe.elementOffset(4), 4),
    List.cons(Action.store16(BufferRef.snapshot, BufferDataProbe.elementOffset(2), Expr32.ref(4)),
    List.cons(Action.load16(BufferRef.snapshot, BufferDataProbe.elementOffset(2), 5),
    List.cons(Action.set32(1, Expr32.binary(Bin32.add, Expr32.ref(1), Expr32.ref(5))),
      List.nil(Action)))))))))

  def actionsBeforeLoop : List(Action) :=
    List.cons(Action.set32(1, Expr32.literal(0)),
    List.cons(Action.repeat32(0, Expr32.literal(3), BufferDataProbe.loopBody), List.nil(Action)))

  def actionsAfterSum : List(Action) :=
    List.cons(Action.load32(BufferRef.inputB, Expr64.literal(0), 6),
    List.cons(Action.set32(1, Expr32.binary(Bin32.add, Expr32.ref(1), Expr32.ref(6))),
    List.cons(Action.store32(BufferRef.output, Expr64.literal(8), Expr32.ref(1)), List.nil(Action))))

  def actions64A : List(Action) :=
    List.cons(Action.set64(0, Expr64.literal(0)),
    List.cons(Action.load64(BufferRef.inputB, Expr64.literal(0), 4),
    List.cons(Action.store64(BufferRef.shared, Expr64.literal(0), Expr64.ref(4)),
    List.cons(Action.load64(BufferRef.shared, Expr64.literal(0), 0), List.nil(Action)))))

  def actions64B : List(Action) :=
    List.cons(Action.store64(BufferRef.tmem, Expr64.literal(0), Expr64.ref(0)),
    List.cons(Action.load64(BufferRef.tmem, Expr64.literal(0), 1),
    List.cons(Action.store64(BufferRef.snapshot, Expr64.literal(0), Expr64.ref(1)), List.nil(Action))))

  def actions64C : List(Action) :=
    List.cons(Action.load64(BufferRef.snapshot, Expr64.literal(0), 2),
    List.cons(Action.store64(BufferRef.output, Expr64.literal(0), Expr64.ref(2)),
    List.cons(Action.load64(BufferRef.output, Expr64.literal(0), 3), List.nil(Action))))

  def actionsAfterLoop : List(Action) :=
    List.append(BufferDataProbe.actionsAfterSum,
      List.append(BufferDataProbe.actions64A,
        List.append(BufferDataProbe.actions64B, BufferDataProbe.actions64C)))

  def actions : List(Action) := List.append(BufferDataProbe.actionsBeforeLoop, BufferDataProbe.actionsAfterLoop)

  def inputA : List(Nat) := List.cons(2, List.cons(0, List.cons(3, List.cons(0, List.cons(5, List.cons(0, List.nil(Nat)))))))
  def inputBFirst : List(Nat) := List.cons(7, List.cons(0, List.cons(0, List.cons(0, List.nil(Nat)))))
  def inputBSecond : List(Nat) := List.cons(13, List.cons(0, List.cons(0, List.cons(0, List.nil(Nat)))))
  def inputB : List(Nat) := List.append(BufferDataProbe.inputBFirst, BufferDataProbe.inputBSecond)
  def inputs : List(List(Nat)) := List.cons(BufferDataProbe.inputA,
    List.cons(BufferDataProbe.inputB, List.nil(List(Nat))))

  def invalidInputStore : LowerResult :=
    BufferData.lower(layout, 1, 0,
      List.cons(Action.store32(BufferRef.inputA, Expr64.literal(0), Expr32.literal(1)), List.nil(Action)))

  def runLowered (lowered: LowerResult): Buffer.Result := {
    match lowered returning Buffer.Result with
    | LowerResult.program program => Buffer.run(program, BufferDataProbe.inputs)
    | LowerResult.rejected error => Buffer.Result.failure(99)
  }

  def result : Buffer.Result := BufferDataProbe.runLowered(BufferData.lower(layout, 7, 5, actions))

}

{ Pair.mk(BufferDataProbe.result, BufferDataProbe.invalidInputStore) }
