// Static, GPU-library-side facts used while compiling the supported Cuda AST to ordinary Buffer.Program code.
// This module never runs TinyDevice/WarpMachine data operations: values produced by device events stay payloads.

import Check
import Cuda
import evaluator.WarpExpr

namespace Evaluator {
  namespace BufferPlan {
    inductive Scalar : Type
     | known (value: Nat) : Scalar
     | payload (key: Nat) : Scalar
     | invalid (reason: Nat) : Scalar

    struct Register : Type
     | mk (id: Nat)(values: List(Scalar))(initializedMask: Nat) : Register

    inductive ExprValue : Type
     | lanes (values: List(Scalar)) : ExprValue
     | sharedPointer (dtype: Cuda.DType)(byteBase: Nat) : ExprValue
     | mapAddress (name: String) : ExprValue
     | invalid (reason: Nat) : ExprValue

    def maskHas (mask: Nat)(lane: Nat): Bool :=
      Nat.beq(Nat.mod(Nat.div(mask, Nat.pow(2, lane)), 2), 1)

    def maskWithinWarp (mask: Nat): Bool := Nat.beq(mask, Nat.mod(mask, Nat.pow(2, 32)))

    def lanesFrom (warp: Nat)(lane: Nat)(remaining: Nat): List(Scalar) decreases structural(remaining) := {
      match remaining returning List(Scalar) with
      | Nat.zero => List.nil(Scalar)
      | Nat.succ rest => List.cons(Scalar.known(Nat.add(Nat.mul(warp, 32), lane)),
          BufferPlan.lanesFrom(warp, Nat.succ(lane), rest))
    }

    def repeated (value: Scalar)(remaining: Nat): List(Scalar) decreases structural(remaining) := {
      match remaining returning List(Scalar) with
      | Nat.zero => List.nil(Scalar)
      | Nat.succ rest => List.cons(value, BufferPlan.repeated(value, rest))
    }

    def register (registers: List(Register))(id: Nat): Option(Register) decreases structural(registers) := {
      match registers returning Option(Register) with
      | List.nil => Option.none(Register)
      | List.cons value rest => {
        match value returning Option(Register) with
        | Register.mk found values mask => {
          match Nat.beq(id, found) returning Option(Register) with
          | Bool.true => Option.some(value)
          | Bool.false => BufferPlan.register(rest, id)
        }
      }
    }

    def laneBinary (op: Cuda.BinOp)(left: Scalar)(right: Scalar): Scalar := {
      match left returning Scalar with
      | Scalar.known a => {
        match right returning Scalar with
        | Scalar.known b => {
          match WarpExpr.scalarBinary(op, a, b) returning Scalar with
          | Option.none => Scalar.invalid(1)
          | Option.some result => Scalar.known(result)
        }
        | Scalar.payload key => Scalar.invalid(10)
        | Scalar.invalid reason => Scalar.invalid(reason)
      }
      | Scalar.payload key => Scalar.invalid(10)
      | Scalar.invalid reason => Scalar.invalid(reason)
    }

    def laneBinaryShortCircuit (op: Cuda.BinOp)(left: Scalar)(right: Scalar): Scalar := {
      match op returning Scalar with
      | Cuda.BinOp.land => {
        match left returning Scalar with
        | Scalar.known value => {
          match Nat.isZero(value) returning Scalar with
          | Bool.true => Scalar.known(0)
          | Bool.false => BufferPlan.laneBinary(op, left, right)
        }
        | Scalar.payload key => Scalar.invalid(10)
        | Scalar.invalid reason => Scalar.invalid(reason)
      }
      | _ => BufferPlan.laneBinary(op, left, right)
    }

    def binaryLoop (op: Cuda.BinOp)(left: List(Scalar))(right: List(Scalar))(activeMask: Nat)(lane: Nat)
        : ExprValue decreases structural(left) := {
      match left returning ExprValue with
      | List.nil => {
        match right returning ExprValue with
        | List.nil => ExprValue.lanes(List.nil(Scalar))
        | _ => ExprValue.invalid(3)
      }
      | List.cons x xs => {
        match right returning ExprValue with
        | List.nil => ExprValue.invalid(3)
        | List.cons y ys => {
          let active := BufferPlan.maskHas(activeMask, lane)
          let current := Bool.cond(active, Scalar, BufferPlan.laneBinaryShortCircuit(op, x, y), Scalar.known(0))
          match BufferPlan.binaryLoop(op, xs, ys, activeMask, Nat.succ(lane)) returning ExprValue with
          | ExprValue.lanes more => ExprValue.lanes(List.cons(current, more))
          | ExprValue.invalid reason => ExprValue.invalid(reason)
          | _ => ExprValue.invalid(3)
        }
      }
    }

    def maximum (left: Scalar)(right: Scalar): Scalar := {
      match left returning Scalar with
      | Scalar.known a => {
        match right returning Scalar with
        | Scalar.known b => Scalar.known(Bool.cond(Nat.ble(a, b), Nat, b, a))
        | Scalar.payload key => Scalar.invalid(10)
        | Scalar.invalid reason => Scalar.invalid(reason)
      }
      | Scalar.payload key => Scalar.invalid(10)
      | Scalar.invalid reason => Scalar.invalid(reason)
    }

    def maxLoop (left: List(Scalar))(right: List(Scalar))(activeMask: Nat)(lane: Nat): ExprValue
        decreases structural(left) := {
      match left returning ExprValue with
      | List.nil => {
        match right returning ExprValue with
        | List.nil => ExprValue.lanes(List.nil(Scalar))
        | _ => ExprValue.invalid(3)
      }
      | List.cons x xs => {
        match right returning ExprValue with
        | List.nil => ExprValue.invalid(3)
        | List.cons y ys => {
          let current := Bool.cond(BufferPlan.maskHas(activeMask, lane), Scalar,
            BufferPlan.maximum(x, y), Scalar.known(0))
          match BufferPlan.maxLoop(xs, ys, activeMask, Nat.succ(lane)) returning ExprValue with
          | ExprValue.lanes more => ExprValue.lanes(List.cons(current, more))
          | ExprValue.invalid reason => ExprValue.invalid(reason)
          | _ => ExprValue.invalid(3)
        }
      }
    }

    def castScalar (dtype: Cuda.DType)(value: Scalar): Scalar := {
      match value returning Scalar with
      | Scalar.known number => {
        match WarpExpr.castScalar(dtype, number) returning Scalar with
        | Option.none => Scalar.invalid(7)
        | Option.some casted => Scalar.known(casted)
      }
      | Scalar.payload key => Scalar.invalid(10)
      | Scalar.invalid reason => Scalar.invalid(reason)
    }

    def castLoop (dtype: Cuda.DType)(values: List(Scalar))(activeMask: Nat)(lane: Nat)
        : List(Scalar) decreases structural(values) := {
      match values returning List(Scalar) with
      | List.nil => List.nil(Scalar)
      | List.cons value rest => {
        let current := Bool.cond(BufferPlan.maskHas(activeMask, lane), Scalar,
          BufferPlan.castScalar(dtype, value), Scalar.known(0))
        List.cons(current, BufferPlan.castLoop(dtype, rest, activeMask, Nat.succ(lane)))
      }
    }

    def selectLoop (condition: List(Scalar))(yes: List(Scalar))(no: List(Scalar))(activeMask: Nat)(lane: Nat)
        : ExprValue decreases structural(condition) := {
      match condition returning ExprValue with
      | List.nil => {
        match yes returning ExprValue with
        | List.nil => {
          match no returning ExprValue with
          | List.nil => ExprValue.lanes(List.nil(Scalar))
          | _ => ExprValue.invalid(3)
        }
        | _ => ExprValue.invalid(3)
      }
      | List.cons c cs => {
        match yes returning ExprValue with
        | List.nil => ExprValue.invalid(3)
        | List.cons y ys => {
          match no returning ExprValue with
          | List.nil => ExprValue.invalid(3)
          | List.cons n ns => {
            match BufferPlan.maskHas(activeMask, lane) returning ExprValue with
            | Bool.false => {
              match BufferPlan.selectLoop(cs, ys, ns, activeMask, Nat.succ(lane)) returning ExprValue with
              | ExprValue.lanes more => ExprValue.lanes(List.cons(Scalar.known(0), more))
              | ExprValue.invalid reason => ExprValue.invalid(reason)
              | _ => ExprValue.invalid(3)
            }
            | Bool.true => {
              match c returning ExprValue with
              | Scalar.known test => {
                let selected := Bool.cond(Nat.isZero(test), Scalar, n, y)
                match BufferPlan.selectLoop(cs, ys, ns, activeMask, Nat.succ(lane)) returning ExprValue with
                | ExprValue.lanes more => ExprValue.lanes(List.cons(selected, more))
                | ExprValue.invalid reason => ExprValue.invalid(reason)
                | _ => ExprValue.invalid(3)
              }
              | Scalar.payload key => ExprValue.invalid(9)
              | Scalar.invalid reason => ExprValue.invalid(reason)
            }
          }
        }
      }
    }

    def splitMaskLoop (values: List(Scalar))(activeMask: Nat)(lane: Nat)(remaining: Nat)
        (yesMask: Nat)(noMask: Nat): Option(Pair(Nat, Nat)) decreases structural(remaining) := {
      match remaining returning Option(Pair(Nat, Nat)) with
      | Nat.zero => {
        match values returning Option(Pair(Nat, Nat)) with
        | List.nil => Option.some((yesMask, noMask))
        | _ => Option.none(Pair(Nat, Nat))
      }
      | Nat.succ rest => {
        match values returning Option(Pair(Nat, Nat)) with
        | List.nil => Option.none(Pair(Nat, Nat))
        | List.cons value more => {
          match BufferPlan.maskHas(activeMask, lane) returning Option(Pair(Nat, Nat)) with
          | Bool.false => BufferPlan.splitMaskLoop(more, activeMask, Nat.succ(lane), rest, yesMask, noMask)
          | Bool.true => {
            match value returning Option(Pair(Nat, Nat)) with
            | Scalar.known number => {
              let bit := Nat.pow(2, lane)
              let goesYes := Bool.not(Nat.isZero(number))
              let nextYes := Bool.cond(goesYes, Nat, Nat.add(yesMask, bit), yesMask)
              let nextNo := Bool.cond(goesYes, Nat, noMask, Nat.add(noMask, bit))
              BufferPlan.splitMaskLoop(more, activeMask, Nat.succ(lane), rest, nextYes, nextNo)
            }
            | _ => Option.none(Pair(Nat, Nat))
          }
        }
      }
    }

    def splitMask (values: List(Scalar))(activeMask: Nat): Option(Pair(Nat, Nat)) := {
      match Nat.beq(List.length(values), 32) returning Option(Pair(Nat, Nat)) with
      | Bool.false => Option.none(Pair(Nat, Nat))
      | Bool.true => {
        match BufferPlan.maskWithinWarp(activeMask) returning Option(Pair(Nat, Nat)) with
        | Bool.false => Option.none(Pair(Nat, Nat))
        | Bool.true => BufferPlan.splitMaskLoop(values, activeMask, 0, 32, 0, 0)
      }
    }

    def maskCoversLoop (available: Nat)(required: Nat)(lane: Nat)(remaining: Nat): Bool
        decreases structural(remaining) := {
      match remaining returning Bool with
      | Nat.zero => Bool.true
      | Nat.succ rest => {
        let covered := Bool.or(Bool.not(BufferPlan.maskHas(required, lane)), BufferPlan.maskHas(available, lane))
        Bool.and(covered, BufferPlan.maskCoversLoop(available, required, Nat.succ(lane), rest))
      }
    }

    def maskCovers (available: Nat)(required: Nat): Bool :=
      Bool.and(BufferPlan.maskWithinWarp(available), Bool.and(BufferPlan.maskWithinWarp(required),
        BufferPlan.maskCoversLoop(available, required, 0, 32)))

    def activeIndicesAreZero (values: List(Scalar))(activeMask: Nat)(lane: Nat)
        : Bool decreases structural(values) := {
      match values returning Bool with
      | List.nil => Bool.true
      | List.cons value rest => {
        match BufferPlan.maskHas(activeMask, lane) returning Bool with
        | Bool.false => BufferPlan.activeIndicesAreZero(rest, activeMask, Nat.succ(lane))
        | Bool.true => {
          match value returning Bool with
          | Scalar.known index => Bool.and(Nat.isZero(index),
              BufferPlan.activeIndicesAreZero(rest, activeMask, Nat.succ(lane)))
          | _ => Bool.false
        }
      }
    }

    def eval (warp: Nat)(activeMask: Nat)(registers: List(Register))(m: Nat)(n: Nat)(k: Nat)(expr: Cuda.Expr)
        : ExprValue decreases structural(expr) := {
      match BufferPlan.maskWithinWarp(activeMask) returning ExprValue with
      | Bool.false => ExprValue.invalid(11)
      | Bool.true => {
      match Nat.isZero(activeMask) returning ExprValue with
      | Bool.true => ExprValue.lanes(BufferPlan.repeated(Scalar.known(0), 32))
      | Bool.false => match expr returning ExprValue with
      | Cuda.Expr.var id => {
        match BufferPlan.register(registers, id) returning ExprValue with
        | Option.none => ExprValue.invalid(4)
        | Option.some value => {
          match value returning ExprValue with
          | Register.mk found values mask => {
            match Nat.beq(List.length(values), 32) returning ExprValue with
            | Bool.false => ExprValue.invalid(12)
            | Bool.true => {
            match BufferPlan.maskCovers(mask, activeMask) returning ExprValue with
            | Bool.true => ExprValue.lanes(values)
            | Bool.false => ExprValue.invalid(11)
            }
          }
        }
      }
      | Cuda.Expr.lit value => ExprValue.lanes(BufferPlan.repeated(Scalar.known(value), 32))
      | Cuda.Expr.lit64 value => ExprValue.lanes(BufferPlan.repeated(Scalar.known(value), 32))
      | Cuda.Expr.zero dtype => ExprValue.lanes(BufferPlan.repeated(Scalar.known(0), 32))
      | Cuda.Expr.param name => {
        match Check.same(name, "M") returning ExprValue with
        | Bool.true => ExprValue.lanes(BufferPlan.repeated(Scalar.known(m), 32))
        | Bool.false => {
          match Check.same(name, "N") returning ExprValue with
          | Bool.true => ExprValue.lanes(BufferPlan.repeated(Scalar.known(n), 32))
          | Bool.false => {
            match Check.same(name, "K") returning ExprValue with
            | Bool.true => ExprValue.lanes(BufferPlan.repeated(Scalar.known(k), 32))
            | Bool.false => ExprValue.invalid(5)
          }
        }
      }
      | Cuda.Expr.special special => {
        match special returning ExprValue with
        | Cuda.Builtin.threadX => ExprValue.lanes(BufferPlan.lanesFrom(warp, 0, 32))
        | Cuda.Builtin.warp => ExprValue.lanes(BufferPlan.repeated(Scalar.known(warp), 32))
        | Cuda.Builtin.lane => ExprValue.lanes(BufferPlan.lanesFrom(0, 0, 32))
        | Cuda.Builtin.blockX => ExprValue.lanes(BufferPlan.repeated(Scalar.known(0), 32))
        | Cuda.Builtin.blockY => ExprValue.lanes(BufferPlan.repeated(Scalar.known(0), 32))
        | Cuda.Builtin.gridX => ExprValue.lanes(BufferPlan.repeated(Scalar.known(1), 32))
      }
      | Cuda.Expr.bin op left right => {
        match BufferPlan.eval(warp, activeMask, registers, m, n, k, left) returning ExprValue with
        | ExprValue.invalid reason => ExprValue.invalid(reason)
        | ExprValue.lanes a => {
          match op returning ExprValue with
          | Cuda.BinOp.land => {
            match BufferPlan.splitMask(a, activeMask) returning ExprValue with
            | Option.none => ExprValue.invalid(9)
            | Option.some masks => {
              let (rightMask, ignored) := masks
              match BufferPlan.eval(warp, rightMask, registers, m, n, k, right) returning ExprValue with
              | ExprValue.invalid reason => ExprValue.invalid(reason)
              | ExprValue.lanes b => BufferPlan.binaryLoop(op, a, b, activeMask, 0)
              | _ => ExprValue.invalid(6)
            }
          }
          | _ => {
            match BufferPlan.eval(warp, activeMask, registers, m, n, k, right) returning ExprValue with
            | ExprValue.invalid reason => ExprValue.invalid(reason)
            | ExprValue.lanes b => BufferPlan.binaryLoop(op, a, b, activeMask, 0)
            | _ => ExprValue.invalid(6)
          }
        }
        | _ => ExprValue.invalid(6)
      }
      | Cuda.Expr.max left right => {
        match BufferPlan.eval(warp, activeMask, registers, m, n, k, left) returning ExprValue with
        | ExprValue.lanes a => {
          match BufferPlan.eval(warp, activeMask, registers, m, n, k, right) returning ExprValue with
          | ExprValue.lanes b => BufferPlan.maxLoop(a, b, activeMask, 0)
          | _ => ExprValue.invalid(6)
        }
        | _ => ExprValue.invalid(6)
      }
      | Cuda.Expr.select condition yes no => {
        match BufferPlan.eval(warp, activeMask, registers, m, n, k, condition) returning ExprValue with
        | ExprValue.lanes c => {
          match BufferPlan.splitMask(c, activeMask) returning ExprValue with
          | Option.none => ExprValue.invalid(9)
          | Option.some masks => {
            let (yesMask, noMask) := masks
            match BufferPlan.eval(warp, yesMask, registers, m, n, k, yes) returning ExprValue with
            | ExprValue.lanes y => {
              match BufferPlan.eval(warp, noMask, registers, m, n, k, no) returning ExprValue with
              | ExprValue.lanes other => BufferPlan.selectLoop(c, y, other, activeMask, 0)
              | _ => ExprValue.invalid(6)
            }
            | _ => ExprValue.invalid(6)
          }
        }
        | _ => ExprValue.invalid(6)
      }
      | Cuda.Expr.index base index => {
        // The tensor-memory allocator's shared slot is initialized to zero.  This planner
        // accepts only that exact u32 slot-zero read; BufferControl separately proves no
        // planned payload write can overlap it before accepting the expanded CTA.
        match BufferPlan.eval(warp, activeMask, registers, m, n, k, base) returning ExprValue with
        | ExprValue.sharedPointer dtype byteBase => {
          match Bool.and(WarpExpr.sameDType(dtype, Cuda.DType.u32), Nat.isZero(byteBase)) returning ExprValue with
          | Bool.false => ExprValue.invalid(13)
          | Bool.true => {
            match BufferPlan.eval(warp, activeMask, registers, m, n, k, index) returning ExprValue with
            | ExprValue.lanes indexes => {
              match Bool.and(Nat.beq(List.length(indexes), 32),
                  BufferPlan.activeIndicesAreZero(indexes, activeMask, 0)) returning ExprValue with
              | Bool.true => ExprValue.lanes(BufferPlan.repeated(Scalar.known(0), 32))
              | Bool.false => ExprValue.invalid(13)
            }
            | _ => ExprValue.invalid(13)
          }
        }
        | _ => ExprValue.invalid(13)
      }
      | Cuda.Expr.cast dtype value => {
        match BufferPlan.eval(warp, activeMask, registers, m, n, k, value) returning ExprValue with
        | ExprValue.lanes values => ExprValue.lanes(BufferPlan.castLoop(dtype, values, activeMask, 0))
        | _ => ExprValue.invalid(7)
      }
      | Cuda.Expr.sharedAddr offset => ExprValue.lanes(BufferPlan.repeated(Scalar.known(offset), 32))
      | Cuda.Expr.sharedPtr dtype offset => ExprValue.sharedPointer(dtype, offset)
      | Cuda.Expr.paramAddr name => ExprValue.mapAddress(name)
      | _ => ExprValue.invalid(8)
      }
    }

    def knownLane (values: List(Scalar))(lane: Nat): Option(Nat) decreases structural(values) := {
      match values returning Option(Nat) with
      | List.nil => Option.none(Nat)
      | List.cons value rest => {
        match lane returning Option(Nat) with
        | Nat.zero => {
          match value returning Option(Nat) with
          | Scalar.known number => Option.some(number)
          | _ => Option.none(Nat)
        }
        | Nat.succ more => BufferPlan.knownLane(rest, more)
      }
    }

    def uniformKnownLoop (values: List(Scalar))(activeMask: Nat)(lane: Nat)(found: Option(Nat))
        : Option(Nat) decreases structural(values) := {
      match values returning Option(Nat) with
      | List.nil => found
      | List.cons value rest => {
        match BufferPlan.maskHas(activeMask, lane) returning Option(Nat) with
        | Bool.false => BufferPlan.uniformKnownLoop(rest, activeMask, Nat.succ(lane), found)
        | Bool.true => {
          match value returning Option(Nat) with
          | Scalar.known current => {
            match found returning Option(Nat) with
            | Option.none => BufferPlan.uniformKnownLoop(rest, activeMask, Nat.succ(lane), Option.some(current))
            | Option.some prior => {
              match Nat.beq(current, prior) returning Option(Nat) with
              | Bool.true => BufferPlan.uniformKnownLoop(rest, activeMask, Nat.succ(lane), found)
              | Bool.false => Option.none(Nat)
            }
          }
          | _ => Option.none(Nat)
        }
      }
    }

    def uniformKnown (value: ExprValue)(activeMask: Nat): Option(Nat) := {
      match value returning Option(Nat) with
      | ExprValue.lanes values => {
        match Nat.beq(List.length(values), 32) returning Option(Nat) with
        | Bool.false => Option.none(Nat)
        | Bool.true => {
          match BufferPlan.maskWithinWarp(activeMask) returning Option(Nat) with
          | Bool.false => Option.none(Nat)
          | Bool.true => BufferPlan.uniformKnownLoop(values, activeMask, 0, Option.none(Nat))
        }
      }
      | _ => Option.none(Nat)
    }

    def evalUniformKnown (warp: Nat)(activeMask: Nat)(registers: List(Register))(m: Nat)(n: Nat)(k: Nat)
        (expr: Cuda.Expr): Option(Nat) :=
      BufferPlan.uniformKnown(BufferPlan.eval(warp, activeMask, registers, m, n, k, expr), activeMask)
  }
}
