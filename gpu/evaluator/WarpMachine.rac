// Deterministic one-CTA interpreter for the concrete Cuda AST emitted by TinyGEMM. Unsupported AST/instruction forms
// are errors; this evaluator does not synthesize a kernel or replace the generated address/control program.

import Check
import Cuda
import Text
import evaluator.DeviceApi
import evaluator.TinyDevice
import evaluator.WarpExpr

namespace Evaluator {
  namespace WarpMachine {
    // Counts refer to source AST warp-statement retirements, FIFO device-event completions and exact Z/257 MMA scalar
    // operations as separate quantities. In particular, an unsuccessful wait contributes no warp step.
    struct Stats : Type
     | mk (warpSteps: Nat)(asyncCompletions: Nat)(tmaBytes: Nat)(scalarMuls: Nat)(scalarAdds: Nat)
          (mmaInstructions: Nat)(tmemLoads: Nat)(tmaStores: Nat) : Stats

    namespace Stats {
      def zero : Stats := Stats.mk(0, 0, 0, 0, 0, 0, 0, 0)
    }

    inductive Failure : Type
     | fuelExhausted : Failure
     | deadlocked : Failure
     | unsupported (message: String) : Failure
     | deviceFault (message: String) : Failure
     | invalidState (message: String) : Failure
     | incompleteOutput : Failure
     | notQuiescent : Failure

    inductive WarpStatus : Type
     | runnable : WarpStatus
     | blocked : WarpStatus
     | blockedGate (id: Nat) : WarpStatus
     | blockedMbar (address: Nat)(parity: Nat) : WarpStatus
     | blockedBulk (what: Cuda.BulkWait)(pending: Nat) : WarpStatus
     | blockedTmem (what: Cuda.TmemWait) : WarpStatus
     | finished : WarpStatus

    inductive Frame : Type
     | branchNo (no: Cuda.Block)(rest: Cuda.Block)(parentMask: Nat)(noMask: Nat) : Frame
     | branchJoin (rest: Cuda.Block)(parentMask: Nat) : Frame
     | loop (id: Nat)(stop: List(Nat))(step: List(Nat))(body: Cuda.Block)(rest: Cuda.Block)
            (parentMask: Nat)(iterationMask: Nat) : Frame
     | scoped (rest: Cuda.Block)(parentMask: Nat) : Frame

    inductive FrameStack : Type
     | nil : FrameStack
     | cons (head: Frame)(tail: FrameStack) : FrameStack

    struct WarpState : Type
     | mk (id: Nat)(block: Cuda.Block)(frames: FrameStack)(registers: List(WarpExpr.Register))
          (deferredLoads: List(DeviceApi.RegisterWrite))(activeMask: Nat)(status: WarpStatus) : WarpState

    struct Barrier : Type
     | mk (address: Nat)(expectedArrivals: Nat)(arrivals: Nat)(expectedBytes: Nat)(issuedBytes: Nat)(completedBytes: Nat)
          (phase: Nat)(initialized: Bool)(completedPhases: Nat) : Barrier

    struct SyncGate : Type
     | mk (id: Nat)(expectedThreads: Nat)(arrivedThreads: Nat)(remainingThreads: Nat)(released: Bool) : SyncGate

    inductive PendingEvent : Type
     | data (warp: Nat)(request: DeviceApi.DataRequest)(barrier: Option(Nat))(barrierPhase: Nat)(committed: Bool) : PendingEvent
     | tcCommit (warp: Nat)(barrier: Nat)(barrierPhase: Nat) : PendingEvent

    struct Engine : Type
     | mk (kernel: Cuda.Kernel)(inputs: TinyDevice.Inputs)(storage: TinyDevice.Storage)(warps: List(WarpState))
          (barriers: List(Barrier))(gates: List(SyncGate))(events: List(PendingEvent))(cursor: Nat)(idle: Nat)
          (stats: Stats) : Engine

    inductive Attempt : Type
     | progress (engine: Engine) : Attempt
     | waiting (engine: Engine) : Attempt
     | fail (problem: Failure)(engine: Engine) : Attempt

    def bumpStats (stats: Stats)(steps: Nat)(events: Nat)(bytes: Nat)(muls: Nat)(adds: Nat)(mmas: Nat)(loads: Nat)(stores: Nat): Stats := {
      match stats returning Stats with
      | Stats.mk oldSteps oldEvents oldBytes oldMuls oldAdds oldMmas oldLoads oldStores =>
        Stats.mk(Nat.add(oldSteps, steps), Nat.add(oldEvents, events), Nat.add(oldBytes, bytes),
          Nat.add(oldMuls, muls), Nat.add(oldAdds, adds), Nat.add(oldMmas, mmas),
          Nat.add(oldLoads, loads), Nat.add(oldStores, stores))
    }

    inductive MachineResult : Type
     | complete (storage: TinyDevice.Storage)(stats: Stats) : MachineResult
     | failed (failure: Failure)(stats: Stats) : MachineResult
    def outputs (result: MachineResult): List(Nat) := {
      match result returning List(Nat) with
      | MachineResult.complete storage counts => TinyDevice.outputList(storage)
      | MachineResult.failed failure stats => List.nil(Nat)
    }
    def stats (result: MachineResult): Stats := {
      match result returning Stats with
      | MachineResult.complete xs counts => counts
      | MachineResult.failed failure counts => counts
    }
    def failure (result: MachineResult): Option(Failure) := {
      match result returning Option(Failure) with
      | MachineResult.complete xs counts => Option.none(Failure)
      | MachineResult.failed problem counts => Option.some(problem)
    }
    def failureName (problem: Failure): String := {
      match problem returning String with
      | Failure.fuelExhausted => "fuel-exhausted"
      | Failure.deadlocked => "deadlocked"
      | Failure.unsupported message => Text.cat("unsupported: ", message)
      | Failure.deviceFault message => Text.cat("device-fault: ", message)
      | Failure.invalidState message => Text.cat("invalid-state: ", message)
      | Failure.incompleteOutput => "incomplete-output"
      | Failure.notQuiescent => "not-quiescent"
    }
    def errors (result: MachineResult): String := {
      match result returning String with
      | MachineResult.complete storage counts => "ok"
      | MachineResult.failed problem counts => WarpMachine.failureName(problem)
    }
    def warpAt (warps: List(WarpState))(index: Nat): Option(WarpState) decreases structural(warps) := {
      match warps returning Option(WarpState) with
      | List.nil => Option.none(WarpState)
      | List.cons warp rest => {
        match index returning Option(WarpState) with
        | Nat.zero => Option.some(warp)
        | Nat.succ more => WarpMachine.warpAt(rest, more)
      }
    }
    def replaceWarp (warps: List(WarpState))(index: Nat)(changed: WarpState): List(WarpState) decreases structural(warps) := {
      match warps returning List(WarpState) with
      | List.nil => List.nil(WarpState)
      | List.cons warp rest => {
        match index returning List(WarpState) with
        | Nat.zero => List.cons(changed, rest)
        | Nat.succ more => List.cons(warp, WarpMachine.replaceWarp(rest, more, changed))
      }
    }
    def engineWithWarps (engine: Engine)(warps: List(WarpState)): Engine := {
      match engine returning Engine with
      | Engine.mk kernel inputs storage old barriers gates events cursor idle counts =>
        Engine.mk(kernel, inputs, storage, warps, barriers, gates, events, cursor, idle, counts)
    }
    def engineWithStorage (engine: Engine)(storage: TinyDevice.Storage): Engine := {
      match engine returning Engine with
      | Engine.mk kernel inputs old warps barriers gates events cursor idle counts =>
        Engine.mk(kernel, inputs, storage, warps, barriers, gates, events, cursor, idle, counts)
    }
    def engineWithBarriers (engine: Engine)(barriers: List(Barrier)): Engine := {
      match engine returning Engine with
      | Engine.mk kernel inputs storage warps old gates events cursor idle counts =>
        Engine.mk(kernel, inputs, storage, warps, barriers, gates, events, cursor, idle, counts)
    }
    def engineWithGates (engine: Engine)(gates: List(SyncGate)): Engine := {
      match engine returning Engine with
      | Engine.mk kernel inputs storage warps barriers old events cursor idle counts =>
        Engine.mk(kernel, inputs, storage, warps, barriers, gates, events, cursor, idle, counts)
    }
    def engineWithEvents (engine: Engine)(events: List(PendingEvent)): Engine := {
      match engine returning Engine with
      | Engine.mk kernel inputs storage warps barriers gates old cursor idle counts =>
        Engine.mk(kernel, inputs, storage, warps, barriers, gates, events, cursor, idle, counts)
    }
    def engineWithCursor (engine: Engine)(cursor: Nat)(idle: Nat): Engine := {
      match engine returning Engine with
      | Engine.mk kernel inputs storage warps barriers gates events oldCursor oldIdle counts =>
        Engine.mk(kernel, inputs, storage, warps, barriers, gates, events, cursor, idle, counts)
    }
    def engineWithStats (engine: Engine)(stats: Stats): Engine := {
      match engine returning Engine with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle old =>
        Engine.mk(kernel, inputs, storage, warps, barriers, gates, events, cursor, idle, stats)
    }
    def statsOfEngine (engine: Engine): Stats := {
      match engine returning Stats with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => counts
    }
    def warpsOf (engine: Engine): List(WarpState) := {
      match engine returning List(WarpState) with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => warps
    }
    def engineWarp (engine: Engine)(index: Nat): Option(WarpState) := {
      match engine returning Option(WarpState) with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => WarpMachine.warpAt(warps, index)
    }
    def engineReplaceWarp (engine: Engine)(index: Nat)(warp: WarpState): Engine := {
      match engine returning Engine with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts =>
        WarpMachine.engineWithWarps(engine, WarpMachine.replaceWarp(warps, index, warp))
    }
    def deferredLoadsOf (warp: WarpState): List(DeviceApi.RegisterWrite) := {
      match warp returning List(DeviceApi.RegisterWrite) with
      | WarpState.mk id block frames registers deferredLoads active status => deferredLoads
    }
    def appendRegisterWrites (current: List(DeviceApi.RegisterWrite))(added: List(DeviceApi.RegisterWrite))
        : List(DeviceApi.RegisterWrite) decreases structural(added) := {
      match added returning List(DeviceApi.RegisterWrite) with
      | List.nil => current
      | List.cons write rest => List.cons(write, WarpMachine.appendRegisterWrites(current, rest))
    }
    def engineBump (engine: Engine)(steps: Nat)(events: Nat)(bytes: Nat)(muls: Nat)(adds: Nat)(mmas: Nat)(loads: Nat)(stores: Nat): Engine := {
      match engine returning Engine with
      | Engine.mk kernel inputs storage warps barriers gates pending cursor idle counts =>
        WarpMachine.engineWithStats(engine, WarpMachine.bumpStats(counts, steps, events, bytes, muls, adds, mmas, loads, stores))
    }
    def findBarrier (barriers: List(Barrier))(address: Nat): Option(Barrier) decreases structural(barriers) := {
      match barriers returning Option(Barrier) with
      | List.nil => Option.none(Barrier)
      | List.cons barrier rest => {
        match barrier returning Option(Barrier) with
        | Barrier.mk got expected arrivals txExpected issued txDone phase active completed => {
          match Nat.beq(got, address) returning Option(Barrier) with
          | Bool.true => Option.some(barrier)
          | Bool.false => WarpMachine.findBarrier(rest, address)
        }
      }
    }
    def setBarrier (barriers: List(Barrier))(changed: Barrier): List(Barrier) decreases structural(barriers) := {
      match changed returning List(Barrier) with
      | Barrier.mk address expected arrivals txExpected issued txDone phase initialized completed => {
        match barriers returning List(Barrier) with
        | List.nil => List.cons(changed, List.nil(Barrier))
        | List.cons barrier rest => {
          match barrier returning List(Barrier) with
          | Barrier.mk got oldExpected oldArrivals oldTxExpected oldIssued oldTxDone oldPhase oldInitialized oldCompleted => {
            match Nat.beq(got, address) returning List(Barrier) with
            | Bool.true => List.cons(changed, rest)
            | Bool.false => List.cons(barrier, WarpMachine.setBarrier(rest, changed))
          }
        }
      }
    }
    def barriersOf (engine: Engine): List(Barrier) := {
      match engine returning List(Barrier) with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => barriers
    }
    def gatesOf (engine: Engine): List(SyncGate) := {
      match engine returning List(SyncGate) with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => gates
    }
    def eventsOf (engine: Engine): List(PendingEvent) := {
      match engine returning List(PendingEvent) with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => events
    }
    def storageOf (engine: Engine): TinyDevice.Storage := {
      match engine returning TinyDevice.Storage with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => storage
    }
    def inputsOf (engine: Engine): TinyDevice.Inputs := {
      match engine returning TinyDevice.Inputs with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => inputs
    }
    def kernelOf (engine: Engine): Cuda.Kernel := {
      match engine returning Cuda.Kernel with
      | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => kernel
    }
    def barrierAfterInit (address: Nat)(expected: Nat): Barrier :=
      Barrier.mk(address, expected, 0, 0, 0, 0, 0, Bool.true, 0)
    def barrierAfterInvalidate (barrier: Barrier): Barrier := {
      match barrier returning Barrier with
      | Barrier.mk address expected arrivals txExpected issued txDone phase initialized completed =>
        Barrier.mk(address, expected, 0, 0, 0, 0, phase, Bool.false, completed)
    }
    def barrierAfterArrival (barrier: Barrier)(arrivals: Nat)(txBytes: Nat): Option(Barrier) := {
      match barrier returning Option(Barrier) with
      | Barrier.mk address expected oldArrivals oldTxExpected oldIssued oldTxDone phase initialized completed => {
        match Bool.and(initialized, Nat.ble(Nat.add(oldArrivals, arrivals), expected)) returning Option(Barrier) with
        | Bool.false => Option.none(Barrier)
        | Bool.true => {
          let nowArrivals := Nat.add(oldArrivals, arrivals)
          let nowExpectedBytes := Nat.add(oldTxExpected, txBytes)
          let done := Bool.and(Nat.ble(expected, nowArrivals), Nat.ble(nowExpectedBytes, oldTxDone))
          match done returning Option(Barrier) with
          | Bool.true => Option.some(Barrier.mk(address, expected, 0, 0, 0, 0, Nat.mod(Nat.succ(phase), 2), initialized,
              Nat.succ(completed)))
          | Bool.false => Option.some(Barrier.mk(address, expected, nowArrivals, nowExpectedBytes, oldIssued, oldTxDone,
              phase, initialized, completed))
        }
      }
    }
    def barrierAfterBytes (barrier: Barrier)(bytes: Nat): Option(Barrier) := {
      match barrier returning Option(Barrier) with
      | Barrier.mk address expected arrivals txExpected issued txDone phase initialized completed => {
        match Bool.and(initialized, Bool.and(Nat.ble(Nat.add(txDone, bytes), issued),
            Nat.ble(Nat.add(txDone, bytes), txExpected))) returning Option(Barrier) with
        | Bool.false => Option.none(Barrier)
        | Bool.true => {
          let nowDone := Nat.add(txDone, bytes)
          let done := Bool.and(Nat.ble(expected, arrivals), Nat.ble(txExpected, nowDone))
          match done returning Option(Barrier) with
          | Bool.true => Option.some(Barrier.mk(address, expected, 0, 0, 0, 0, Nat.mod(Nat.succ(phase), 2), initialized,
              Nat.succ(completed)))
          | Bool.false => Option.some(Barrier.mk(address, expected, arrivals, txExpected, issued, nowDone, phase, initialized, completed))
        }
      }
    }
    def barrierScheduleBytes (barrier: Barrier)(phase: Nat)(bytes: Nat): Option(Barrier) := {
      match barrier returning Option(Barrier) with
      | Barrier.mk address expected arrivals txExpected issued txDone currentPhase initialized completed => {
        match Bool.and(initialized, Bool.and(Nat.beq(phase, currentPhase),
            Nat.ble(Nat.add(issued, bytes), txExpected))) returning Option(Barrier) with
        | Bool.false => Option.none(Barrier)
        | Bool.true => Option.some(Barrier.mk(address, expected, arrivals, txExpected, Nat.add(issued, bytes), txDone,
            currentPhase, initialized, completed))
      }
    }
    def barrierQuiescent (barrier: Barrier): Bool := {
      match barrier returning Bool with
      | Barrier.mk address expected arrivals txExpected issued txDone phase initialized completed =>
        Bool.and(initialized, Bool.and(Nat.isZero(arrivals), Bool.and(Nat.isZero(txExpected),
          Bool.and(Nat.isZero(issued), Nat.isZero(txDone)))))
    }
    def eventsUseBarrier (events: List(PendingEvent))(address: Nat): Bool decreases structural(events) := {
      match events returning Bool with
      | List.nil => Bool.false
      | List.cons event rest => {
        let here := {
          match event returning Bool with
          | PendingEvent.data warp request barrier barrierPhase committed => {
            match barrier returning Bool with
            | Option.none => Bool.false
            | Option.some got => Nat.beq(got, address)
          }
          | PendingEvent.tcCommit warp got barrierPhase => Nat.beq(got, address)
        }
        Bool.or(here, WarpMachine.eventsUseBarrier(rest, address))
      }
    }
    def barrierWaitReady (barrier: Barrier)(parity: Nat): Bool := {
      match barrier returning Bool with
      | Barrier.mk address expected arrivals txExpected issued txDone phase initialized completed =>
        Bool.and(initialized, Bool.and(Nat.blt(0, completed), Bool.not(Nat.beq(phase, parity))))
    }
    def barrierPhase (barrier: Barrier): Nat := {
      match barrier returning Nat with
      | Barrier.mk address expected arrivals txExpected issued txDone phase initialized completed => phase
    }
    def findGateAny (gates: List(SyncGate))(id: Nat): Option(SyncGate) decreases structural(gates) := {
      match gates returning Option(SyncGate) with
      | List.nil => Option.none(SyncGate)
      | List.cons gate rest => {
        match gate returning Option(SyncGate) with
        | SyncGate.mk got expected arrived remaining released => {
          match Nat.beq(got, id) returning Option(SyncGate) with
          | Bool.true => Option.some(gate)
          | Bool.false => WarpMachine.findGateAny(rest, id)
        }
      }
    }
    def setGateById (gates: List(SyncGate))(changed: SyncGate): List(SyncGate) decreases structural(gates) := {
      match changed returning List(SyncGate) with
      | SyncGate.mk id threads arrived remaining released => {
        match gates returning List(SyncGate) with
        | List.nil => List.cons(changed, List.nil(SyncGate))
        | List.cons gate rest => {
          match gate returning List(SyncGate) with
          | SyncGate.mk oldId oldThreads oldArrived oldRemaining oldReleased => {
            match Nat.beq(oldId, id) returning List(SyncGate) with
            | Bool.true => List.cons(changed, rest)
            | Bool.false => List.cons(gate, WarpMachine.setGateById(rest, changed))
          }
        }
      }
    }
    def addGateArrival (gate: SyncGate)(threads: Nat): Option(SyncGate) := {
      match gate returning Option(SyncGate) with
      | SyncGate.mk id expected arrived remaining released => {
        match Bool.and(Bool.not(released), Nat.ble(Nat.add(arrived, threads), expected)) returning Option(SyncGate) with
        | Bool.false => Option.none(SyncGate)
        | Bool.true => {
          let now := Nat.add(arrived, threads)
          match Nat.beq(now, expected) returning Option(SyncGate) with
          | Bool.true => Option.some(SyncGate.mk(id, expected, now, now, Bool.true))
          | Bool.false => Option.some(SyncGate.mk(id, expected, now, 0, Bool.false))
        }
      }
    }
    def appendEvent (events: List(PendingEvent))(event: PendingEvent): List(PendingEvent) decreases structural(events) := {
      match events returning List(PendingEvent) with
      | List.nil => List.cons(event, List.nil(PendingEvent))
      | List.cons first rest => List.cons(first, WarpMachine.appendEvent(rest, event))
    }
    def commitStoreEvents (events: List(PendingEvent))(warp: Nat): List(PendingEvent) decreases structural(events) := {
      match events returning List(PendingEvent) with
      | List.nil => List.nil(PendingEvent)
      | List.cons event rest => {
        match event returning List(PendingEvent) with
        | PendingEvent.data owner request barrier barrierPhase committed => {
          match request returning List(PendingEvent) with
          | DeviceApi.DataRequest.tmaStore map x y srcByte => {
            let updated := {
              match Nat.beq(owner, warp) returning PendingEvent with
              | Bool.true => PendingEvent.data(owner, request, barrier, barrierPhase, Bool.true)
              | Bool.false => event
            }
            List.cons(updated, WarpMachine.commitStoreEvents(rest, warp))
          }
          | _ => List.cons(event, WarpMachine.commitStoreEvents(rest, warp))
        }
        | _ => List.cons(event, WarpMachine.commitStoreEvents(rest, warp))
      }
    }
    def popEvent (events: List(PendingEvent)): Option(Pair(PendingEvent, List(PendingEvent))) := {
      match events returning Option(Pair(PendingEvent, List(PendingEvent))) with
      | List.nil => Option.none(Pair(PendingEvent, List(PendingEvent)))
      | List.cons event rest => Option.some((event, rest))
    }
    def pendingTmemLoads (events: List(PendingEvent))(warp: Nat): Nat decreases structural(events) := {
      match events returning Nat with
      | List.nil => 0
      | List.cons event rest => {
        let tail := WarpMachine.pendingTmemLoads(rest, warp)
        match event returning Nat with
        | PendingEvent.data owner request barrier barrierPhase committed => {
          match request returning Nat with
          | DeviceApi.DataRequest.tmemLoad shape ids address group mask =>
            Nat.add(tail, Bool.cond(Nat.beq(owner, warp), Nat, 1, 0))
          | _ => tail
        }
        | _ => tail
      }
    }
    def eventCommitted (event: PendingEvent): Bool := {
      match event returning Bool with
      | PendingEvent.data warp request barrier barrierPhase committed => committed
      | PendingEvent.tcCommit warp barrier barrierPhase => Bool.true
    }
    def requestIsMma (request: DeviceApi.DataRequest): Bool := {
      match request returning Bool with
      | DeviceApi.DataRequest.mma desc => Bool.true
      | _ => Bool.false
    }
    def requestIsTmemLoad (request: DeviceApi.DataRequest): Bool := {
      match request returning Bool with
      | DeviceApi.DataRequest.tmemLoad shape ids address group mask => Bool.true
      | _ => Bool.false
    }
    def requestIsStore (request: DeviceApi.DataRequest): Bool := {
      match request returning Bool with
      | DeviceApi.DataRequest.tmaStore map x y srcByte => Bool.true
      | _ => Bool.false
    }
    def requestMask (request: DeviceApi.DataRequest): Nat := {
      match request returning Nat with
      | DeviceApi.DataRequest.tmemLoad shape ids address group mask => mask
      | _ => DeviceApi.LaneVector.fullMask
    }
    def completeBarrierBytes (engine: Engine)(barrierAddress: Option(Nat))(phase: Nat)(bytes: Nat): Option(Engine) := {
      match barrierAddress returning Option(Engine) with
      | Option.none => Option.some(engine)
      | Option.some address => {
        match WarpMachine.findBarrier(WarpMachine.barriersOf(engine), address) returning Option(Engine) with
        | Option.none => Option.none(Engine)
        | Option.some current => {
          match Nat.beq(WarpMachine.barrierPhase(current), phase) returning Option(Engine) with
          | Bool.false => Option.none(Engine)
          | Bool.true => {
            match WarpMachine.barrierAfterBytes(current, bytes) returning Option(Engine) with
            | Option.none => Option.none(Engine)
            | Option.some changed => Option.some(WarpMachine.engineWithBarriers(engine,
                WarpMachine.setBarrier(WarpMachine.barriersOf(engine), changed)))
          }
        }
      }
    }
    def retireCommit (engine: Engine)(barrierAddress: Nat)(phase: Nat): Attempt := {
      match WarpMachine.findBarrier(WarpMachine.barriersOf(engine), barrierAddress) returning Attempt with
      | Option.none => Attempt.fail(Failure.invalidState("tcgen05.commit arrived at an uninitialized mbarrier"), engine)
      | Option.some current => {
        match Nat.beq(WarpMachine.barrierPhase(current), phase) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("tcgen05.commit completed against a different barrier phase"), engine)
        | Bool.true => {
          match WarpMachine.barrierAfterArrival(current, 1, 0) returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("tcgen05.commit exceeded the mbarrier arrival count"), engine)
          | Option.some changed => {
            let next := WarpMachine.engineWithBarriers(engine, WarpMachine.setBarrier(WarpMachine.barriersOf(engine), changed))
            Attempt.progress(WarpMachine.engineBump(next, 0, 1, 0, 0, 0, 0, 0, 0))
          }
        }
      }
    }
    def sameLaneValue (values: List(Nat))(lane: Nat): Option(Nat) decreases structural(values) := {
      match values returning Option(Nat) with
      | List.nil => Option.none(Nat)
      | List.cons value rest => {
        match lane returning Option(Nat) with
        | Nat.zero => Option.some(value)
        | Nat.succ more => WarpMachine.sameLaneValue(rest, more)
      }
    }
    def offsetAddresses (addresses: List(Nat))(offset: Nat): List(Nat) decreases structural(addresses) := {
      match addresses returning List(Nat) with
      | List.nil => List.nil(Nat)
      | List.cons address rest => List.cons(Nat.add(address, offset), WarpMachine.offsetAddresses(rest, offset))
    }
    def writeStValues (storage: TinyDevice.Storage)(inputs: TinyDevice.Inputs)(warp: Nat)(mask: Nat)
        (registers: List(WarpExpr.Register))(baseAddresses: List(Nat))(values: List(Cuda.Expr))(index: Nat)
        : Option(TinyDevice.Storage) decreases structural(values) := {
      match values returning Option(TinyDevice.Storage) with
      | List.nil => Option.some(storage)
      | List.cons expr rest => {
        match WarpExpr.eval(inputs, storage, warp, mask, registers, expr) returning Option(TinyDevice.Storage) with
        | WarpExpr.EvalValue.bad message => Option.none(TinyDevice.Storage)
        | WarpExpr.EvalValue.vector lanes => {
          match Bool.and(Nat.beq(List.length(lanes), 32), Nat.beq(List.length(baseAddresses), 32))
              returning Option(TinyDevice.Storage) with
          | Bool.false => Option.none(TinyDevice.Storage)
          | Bool.true => {
            let at := WarpMachine.offsetAddresses(baseAddresses, Nat.mul(index, 4))
            match DeviceApi.LaneVector.ofList(at) returning Option(TinyDevice.Storage) with
            | Option.none => Option.none(TinyDevice.Storage)
            | Option.some addrVector => {
              match DeviceApi.LaneVector.ofList(lanes) returning Option(TinyDevice.Storage) with
              | Option.none => Option.none(TinyDevice.Storage)
              | Option.some valueVector => {
                match TinyDevice.writeSharedLanes(storage, addrVector, valueVector, mask, Cuda.DType.f32)
                    returning Option(TinyDevice.Storage) with
                | Option.none => Option.none(TinyDevice.Storage)
                | Option.some changed => WarpMachine.writeStValues(changed, inputs, warp, mask, registers,
                    baseAddresses, rest, Nat.succ(index))
              }
            }
          }
        }
        | _ => Option.none(TinyDevice.Storage)
      }
    }
    def runnableStatus (warp: WarpState): Bool := {
      match warp returning Bool with
      | WarpState.mk id block frames registers deferredLoads active status => {
        match status returning Bool with
        | WarpStatus.runnable => Bool.true
        | _ => Bool.false
      }
    }
    def findRunnable (warps: List(WarpState))(index: Nat)(remaining: Nat): Option(Nat)
        decreases structural(remaining) := {
      match remaining returning Option(Nat) with
      | Nat.zero => Option.none(Nat)
      | Nat.succ more => {
        match WarpMachine.warpAt(warps, index) returning Option(Nat) with
        | Option.none => Option.none(Nat)
        | Option.some warp => {
          match WarpMachine.runnableStatus(warp) returning Option(Nat) with
          | Bool.true => Option.some(index)
          | Bool.false => WarpMachine.findRunnable(warps, Nat.mod(Nat.succ(index), 8), more)
        }
      }
    }
    def allFinished (warps: List(WarpState)): Bool decreases structural(warps) := {
      match warps returning Bool with
      | List.nil => Bool.true
      | List.cons warp rest => {
        match warp returning Bool with
        | WarpState.mk id block frames registers deferredLoads active status => {
          match status returning Bool with
          | WarpStatus.finished => WarpMachine.allFinished(rest)
          | _ => Bool.false
        }
      }
    }
    def allBarriersInvalid (barriers: List(Barrier)): Bool decreases structural(barriers) := {
      match barriers returning Bool with
      | List.nil => Bool.true
      | List.cons barrier rest => {
        match barrier returning Bool with
        | Barrier.mk address expected arrivals txExpected issued txDone phase initialized completed =>
          Bool.and(Bool.not(initialized), WarpMachine.allBarriersInvalid(rest))
      }
    }
    def allDeferredLoadsEmpty (warps: List(WarpState)): Bool decreases structural(warps) := {
      match warps returning Bool with
      | List.nil => Bool.true
      | List.cons warp rest => {
        match warp returning Bool with
        | WarpState.mk id block frames registers deferredLoads active status =>
          Bool.and(Nat.isZero(List.length(deferredLoads)), WarpMachine.allDeferredLoadsEmpty(rest))
      }
    }
    def finalResult (engine: Engine): MachineResult := {
      let noDeferred := {
        match engine returning Bool with
        | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts =>
          WarpMachine.allDeferredLoadsEmpty(warps)
      }
      match noDeferred returning MachineResult with
      | Bool.false => MachineResult.failed(Failure.notQuiescent, WarpMachine.statsOfEngine(engine))
      | Bool.true => {
        match TinyDevice.tmemQuiescent(WarpMachine.storageOf(engine)) returning MachineResult with
        | Bool.false => MachineResult.failed(Failure.notQuiescent, WarpMachine.statsOfEngine(engine))
        | Bool.true => {
          match WarpMachine.allBarriersInvalid(WarpMachine.barriersOf(engine)) returning MachineResult with
          | Bool.false => MachineResult.failed(Failure.notQuiescent, WarpMachine.statsOfEngine(engine))
          | Bool.true => {
            match TinyDevice.outputComplete(WarpMachine.storageOf(engine)) returning MachineResult with
            | Bool.false => MachineResult.failed(Failure.incompleteOutput, WarpMachine.statsOfEngine(engine))
            | Bool.true => MachineResult.complete(WarpMachine.storageOf(engine), WarpMachine.statsOfEngine(engine))
          }
        }
      }
    }
    def makeWarps (body: Cuda.Block)(next: Nat)(remaining: Nat): List(WarpState) decreases structural(remaining) := {
      match remaining returning List(WarpState) with
      | Nat.zero => List.nil(WarpState)
      | Nat.succ more => List.cons(WarpState.mk(next, body, FrameStack.nil, List.nil(WarpExpr.Register),
          List.nil(DeviceApi.RegisterWrite), DeviceApi.LaneVector.fullMask, WarpStatus.runnable),
          WarpMachine.makeWarps(body, Nat.succ(next), more))
    }
    def eventCount (events: List(PendingEvent)): Nat decreases structural(events) := {
      match events returning Nat with
      | List.nil => 0
      | List.cons event rest => Nat.succ(WarpMachine.eventCount(rest))
    }
    def storeEventsForWarp (events: List(PendingEvent))(warp: Nat): Nat decreases structural(events) := {
      match events returning Nat with
      | List.nil => 0
      | List.cons event rest => {
        let restCount := WarpMachine.storeEventsForWarp(rest, warp)
        match event returning Nat with
        | PendingEvent.data owner request barrier barrierPhase committed =>
          Nat.add(restCount, Bool.cond(Bool.and(Nat.beq(owner, warp), WarpMachine.requestIsStore(request)), Nat, 1, 0))
        | PendingEvent.tcCommit owner barrier phase => restCount
      }
    }
    def bulkWaitReady (events: List(PendingEvent))(warp: Nat)(pending: Nat): Bool :=
      Nat.ble(WarpMachine.storeEventsForWarp(events, warp), pending)
    def statusReady (engine: Engine)(warp: WarpState): Bool := {
      match warp returning Bool with
      | WarpState.mk id block frames registers deferredLoads active status => {
        match status returning Bool with
        | WarpStatus.blockedGate gateId => {
          match WarpMachine.findGateAny(WarpMachine.gatesOf(engine), gateId) returning Bool with
          | Option.none => Bool.false
          | Option.some gate => {
            match gate returning Bool with
            | SyncGate.mk got expected arrived remaining released => released
          }
        }
        | WarpStatus.blockedMbar address parity => {
          match WarpMachine.findBarrier(WarpMachine.barriersOf(engine), address) returning Bool with
          | Option.none => Bool.false
          | Option.some barrier => WarpMachine.barrierWaitReady(barrier, parity)
        }
        | WarpStatus.blockedBulk what pending => WarpMachine.bulkWaitReady(WarpMachine.eventsOf(engine), id, pending)
        | WarpStatus.blockedTmem what => {
          match what returning Bool with
          | Cuda.TmemWait.load => Nat.isZero(WarpMachine.pendingTmemLoads(WarpMachine.eventsOf(engine), id))
          | Cuda.TmemWait.store => Bool.false
        }
        | _ => Bool.false
      }
    }
    def registerWrites (registers: List(WarpExpr.Register))(writes: List(DeviceApi.RegisterWrite))(mask: Nat)
        : List(WarpExpr.Register) decreases structural(writes) := {
      match writes returning List(WarpExpr.Register) with
      | List.nil => registers
      | List.cons write rest => {
        match write returning List(WarpExpr.Register) with
        | DeviceApi.RegisterWrite.mk id values => {
          let changed := WarpExpr.writeMasked(registers, id, DeviceApi.LaneVector.toList(values), mask)
          WarpMachine.registerWrites(changed, rest, mask)
        }
      }
    }
    def laneBit (mask: Nat)(lane: Nat): Bool := WarpExpr.laneMask(mask, lane)
    def electValues (mask: Nat)(lane: Nat)(remaining: Nat)(elected: Bool): Pair(List(Nat), Bool)
        decreases structural(remaining) := {
      match remaining returning Pair(List(Nat), Bool) with
      | Nat.zero => (List.nil(Nat), elected)
      | Nat.succ rest => {
        let active := WarpMachine.laneBit(mask, lane)
        let selected := Bool.and(active, Bool.not(elected))
        let nowElected := Bool.or(elected, active)
        let bit := Bool.cond(selected, Nat, 1, 0)
        let (tail, found) := WarpMachine.electValues(mask, Nat.succ(lane), rest, nowElected)
        (List.cons(bit, tail), found)
      }
    }
    def anyActiveNonzero (values: List(Nat))(mask: Nat)(lane: Nat): Bool decreases structural(values) := {
      match values returning Bool with
      | List.nil => Bool.false
      | List.cons value rest => {
        let here := Bool.and(WarpMachine.laneBit(mask, lane), Bool.not(Nat.isZero(value)))
        Bool.or(here, WarpMachine.anyActiveNonzero(rest, mask, Nat.succ(lane)))
      }
    }
    def uniformValueLoop (values: List(Nat))(mask: Nat)(lane: Nat)(found: Option(Nat))
        : Option(Nat) decreases structural(values) := {
      match values returning Option(Nat) with
      | List.nil => found
      | List.cons value rest => {
        match WarpMachine.laneBit(mask, lane) returning Option(Nat) with
        | Bool.false => WarpMachine.uniformValueLoop(rest, mask, Nat.succ(lane), found)
        | Bool.true => {
          match found returning Option(Nat) with
          | Option.none => WarpMachine.uniformValueLoop(rest, mask, Nat.succ(lane), Option.some(value))
          | Option.some previous => {
            match Nat.beq(previous, value) returning Option(Nat) with
            | Bool.true => WarpMachine.uniformValueLoop(rest, mask, Nat.succ(lane), found)
            | Bool.false => Option.none(Nat)
          }
        }
      }
    }
    def uniformValue (values: List(Nat))(mask: Nat): Option(Nat) :=
      WarpMachine.uniformValueLoop(values, mask, 0, Option.none(Nat))
    def evalExpr (inputs: TinyDevice.Inputs)(storage: TinyDevice.Storage)(warp: Nat)(mask: Nat)
        (registers: List(WarpExpr.Register))(expr: Cuda.Expr): WarpExpr.EvalValue :=
      WarpExpr.eval(inputs, storage, warp, mask, registers, expr)
    def evalUniformNat (inputs: TinyDevice.Inputs)(storage: TinyDevice.Storage)(warp: Nat)(mask: Nat)
        (registers: List(WarpExpr.Register))(expr: Cuda.Expr): Option(Nat) := {
      match WarpMachine.evalExpr(inputs, storage, warp, mask, registers, expr) returning Option(Nat) with
      | WarpExpr.EvalValue.vector values => WarpMachine.uniformValue(values, mask)
      | _ => Option.none(Nat)
    }
    def evalAddress (inputs: TinyDevice.Inputs)(storage: TinyDevice.Storage)(warp: Nat)(mask: Nat)
        (registers: List(WarpExpr.Register))(expr: Cuda.Expr): Option(Nat) := {
      match WarpMachine.evalExpr(inputs, storage, warp, mask, registers, expr) returning Option(Nat) with
      | WarpExpr.EvalValue.vector values => WarpMachine.uniformValue(values, mask)
      | WarpExpr.EvalValue.sharedPointer dtype byteBase => Option.some(byteBase)
      | _ => Option.none(Nat)
    }
    def evalOperandDesc (inputs: TinyDevice.Inputs)(storage: TinyDevice.Storage)(warp: Nat)(mask: Nat)
        (registers: List(WarpExpr.Register))(desc: Cuda.SmemDesc): Option(DeviceApi.OperandDesc) := {
      match desc returning Option(DeviceApi.OperandDesc) with
      | Cuda.SmemDesc.mk base lbo step => {
        match WarpMachine.evalAddress(inputs, storage, warp, mask, registers, base) returning Option(DeviceApi.OperandDesc) with
        | Option.none => Option.none(DeviceApi.OperandDesc)
        | Option.some byteBase => Option.some(DeviceApi.OperandDesc.mk(byteBase, lbo, step))
      }
    }
    def evalMmaA (inputs: TinyDevice.Inputs)(storage: TinyDevice.Storage)(warp: Nat)(mask: Nat)
        (registers: List(WarpExpr.Register))(a: Cuda.MmaA): Option(DeviceApi.MmaSource) := {
      match a returning Option(DeviceApi.MmaSource) with
      | Cuda.MmaA.smem desc => {
        match WarpMachine.evalOperandDesc(inputs, storage, warp, mask, registers, desc) returning Option(DeviceApi.MmaSource) with
        | Option.none => Option.none(DeviceApi.MmaSource)
        | Option.some value => Option.some(DeviceApi.MmaSource.shared(value))
      }
      | Cuda.MmaA.tmem address => {
        match WarpMachine.evalUniformNat(inputs, storage, warp, mask, registers, address) returning Option(DeviceApi.MmaSource) with
        | Option.none => Option.none(DeviceApi.MmaSource)
        | Option.some value => Option.some(DeviceApi.MmaSource.tensorMemory(value))
      }
    }
    def mapExtent (inputs: TinyDevice.Inputs)(name: String): Option(Nat) := {
      let (m, (n, k)) := TinyDevice.dimensions(inputs)
      match Check.same(name, "M") returning Option(Nat) with
      | Bool.true => Option.some(m)
      | Bool.false => {
        match Check.same(name, "N") returning Option(Nat) with
        | Bool.true => Option.some(n)
        | Bool.false => {
          match Check.same(name, "K") returning Option(Nat) with
          | Bool.true => Option.some(k)
          | Bool.false => Option.none(Nat)
        }
      }
    }
    def resolveMapLoop (maps: List(Cuda.MapEncoding))(inputs: TinyDevice.Inputs)(name: String)
        : Option(DeviceApi.ResolvedMap) decreases structural(maps) := {
      match maps returning Option(DeviceApi.ResolvedMap) with
      | List.nil => Option.none(DeviceApi.ResolvedMap)
      | List.cons map rest => {
        match map returning Option(DeviceApi.ResolvedMap) with
        | Cuda.MapEncoding.mk param use source rows cols inner outer => {
          match Check.same(param, name) returning Option(DeviceApi.ResolvedMap) with
          | Bool.false => WarpMachine.resolveMapLoop(rest, inputs, name)
          | Bool.true => {
            match WarpMachine.mapExtent(inputs, rows) returning Option(DeviceApi.ResolvedMap) with
            | Option.none => Option.none(DeviceApi.ResolvedMap)
            | Option.some rowCount => {
              match WarpMachine.mapExtent(inputs, cols) returning Option(DeviceApi.ResolvedMap) with
              | Option.none => Option.none(DeviceApi.ResolvedMap)
              | Option.some colCount => Option.some(DeviceApi.ResolvedMap.mk(map, rowCount, colCount))
            }
          }
        }
      }
    }
    def resolveMap (kernel: Cuda.Kernel)(inputs: TinyDevice.Inputs)(name: String): Option(DeviceApi.ResolvedMap) := {
      match kernel returning Option(DeviceApi.ResolvedMap) with
      | Cuda.Kernel.mk kernelName params shared body launcher => {
        match launcher returning Option(DeviceApi.ResolvedMap) with
        | Option.none => Option.none(DeviceApi.ResolvedMap)
        | Option.some actual => {
          match actual returning Option(DeviceApi.ResolvedMap) with
          | Cuda.Launcher.mk hostParams requires maps grid block => WarpMachine.resolveMapLoop(maps, inputs, name)
        }
      }
    }
    def evalResolvedMap (kernel: Cuda.Kernel)(inputs: TinyDevice.Inputs)(storage: TinyDevice.Storage)(warp: Nat)(mask: Nat)
        (registers: List(WarpExpr.Register))(expr: Cuda.Expr): Option(DeviceApi.ResolvedMap) := {
      match WarpMachine.evalExpr(inputs, storage, warp, mask, registers, expr) returning Option(DeviceApi.ResolvedMap) with
      | WarpExpr.EvalValue.parameterAddress name => WarpMachine.resolveMap(kernel, inputs, name)
      | _ => Option.none(DeviceApi.ResolvedMap)
    }
    def warpWithBlock (warp: WarpState)(block: Cuda.Block): WarpState := {
      match warp returning WarpState with
      | WarpState.mk id old frames registers deferred mask status => WarpState.mk(id, block, frames, registers, deferred, mask, status)
    }
    def warpWithFrames (warp: WarpState)(frames: FrameStack): WarpState := {
      match warp returning WarpState with
      | WarpState.mk id block old registers deferred mask status => WarpState.mk(id, block, frames, registers, deferred, mask, status)
    }
    def warpWithRegisters (warp: WarpState)(registers: List(WarpExpr.Register)): WarpState := {
      match warp returning WarpState with
      | WarpState.mk id block frames old deferred mask status => WarpState.mk(id, block, frames, registers, deferred, mask, status)
    }
    def warpWithDeferredLoads (warp: WarpState)(deferredLoads: List(DeviceApi.RegisterWrite)): WarpState := {
      match warp returning WarpState with
      | WarpState.mk id block frames registers old mask status =>
        WarpState.mk(id, block, frames, registers, deferredLoads, mask, status)
    }
    def retireData (engine: Engine)(warp: Nat)(request: DeviceApi.DataRequest)(barrier: Option(Nat))(phase: Nat)
        : Attempt := {
      let completed := TinyDevice.complete(WarpMachine.storageOf(engine), request)
      match completed returning Attempt with
      | TinyDevice.DeviceCompletion.mk storage writes bytes muls adds problem => {
        match problem returning Attempt with
        | Option.some fault => {
          match fault returning Attempt with
          | DeviceApi.Fault.mk message => Attempt.fail(Failure.deviceFault(message), engine)
        }
        | Option.none => {
          let withStorage := WarpMachine.engineWithStorage(engine, storage)
          let isLoad := WarpMachine.requestIsTmemLoad(request)
          let withRegisters := {
            match WarpMachine.engineWarp(withStorage, warp) returning Engine with
            | Option.none => withStorage
            | Option.some owner => {
              let changed := Bool.cond(isLoad, WarpState,
                WarpMachine.warpWithDeferredLoads(owner,
                  WarpMachine.appendRegisterWrites(WarpMachine.deferredLoadsOf(owner), writes)),
                WarpMachine.warpWithRegisters(owner,
                  WarpMachine.registerWrites(owner.registers, writes, WarpMachine.requestMask(request))))
              WarpMachine.engineReplaceWarp(withStorage, warp, changed)
            }
          }
          match WarpMachine.completeBarrierBytes(withRegisters, barrier, phase, bytes) returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("data event completed more bytes than its live mbarrier expected"), withRegisters)
          | Option.some withBarrier => {
            let isMma := WarpMachine.requestIsMma(request)
            let isStore := WarpMachine.requestIsStore(request)
            let statsChanged := WarpMachine.engineBump(withBarrier, 0, 1, bytes, muls, adds,
              Bool.cond(isMma, Nat, 1, 0), Bool.cond(isLoad, Nat, 1, 0), Bool.cond(isStore, Nat, 1, 0))
            Attempt.progress(statsChanged)
          }
        }
      }
    }
    def retireHead (engine: Engine): Attempt := {
      match WarpMachine.popEvent(WarpMachine.eventsOf(engine)) returning Attempt with
      | Option.none => Attempt.waiting(engine)
      | Option.some pair => {
        let (event, rest) := pair
        match WarpMachine.eventCommitted(event) returning Attempt with
        | Bool.false => Attempt.fail(Failure.deadlocked, engine)
        | Bool.true => {
          let withoutHead := WarpMachine.engineWithEvents(engine, rest)
          match event returning Attempt with
          | PendingEvent.data warp request barrier barrierPhase committed => {
            match WarpMachine.retireData(withoutHead, warp, request, barrier, barrierPhase) returning Attempt with
            | Attempt.progress changed => Attempt.progress(changed)
            | Attempt.waiting changed => Attempt.waiting(changed)
            | Attempt.fail problem changed => Attempt.fail(problem, changed)
          }
          | PendingEvent.tcCommit warp address phase => WarpMachine.retireCommit(withoutHead, address, phase)
        }
      }
    }
    def warpWithMask (warp: WarpState)(mask: Nat): WarpState := {
      match warp returning WarpState with
      | WarpState.mk id block frames registers deferred old status => WarpState.mk(id, block, frames, registers, deferred, mask, status)
    }
    def stepIfElse (engine: Engine)(warpIndex: Nat)(warp: WarpState)(condition: Cuda.Expr)(yes: Cuda.Block)
        (no: Cuda.Block)(rest: Cuda.Block): Attempt := {
      match WarpMachine.evalExpr(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id, warp.activeMask,
          warp.registers, condition) returning Attempt with
      | WarpExpr.EvalValue.bad message => Attempt.fail(Failure.invalidState(message), engine)
      | WarpExpr.EvalValue.vector values => {
        match Nat.beq(List.length(values), 32) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("if condition is not a 32-lane vector"), engine)
        | Bool.true => {
          let (yesMask, noMask) := WarpExpr.splitMask(values, warp.activeMask)
          let stepped := WarpMachine.engineBump(engine, 1, 0, 0, 0, 0, 0, 0, 0)
          match WarpExpr.maskCount(yesMask) returning Attempt with
          | Nat.zero => {
            let frames := FrameStack.cons(Frame.branchJoin(rest, warp.activeMask), warp.frames)
            let nextWarp := WarpMachine.warpWithFrames(WarpMachine.warpWithBlock(
              WarpMachine.warpWithMask(warp, noMask), no), frames)
            Attempt.progress(WarpMachine.engineReplaceWarp(stepped, warpIndex, nextWarp))
          }
          | Nat.succ lanes => {
            let frames := FrameStack.cons(Frame.branchNo(no, rest, warp.activeMask, noMask), warp.frames)
            let nextWarp := WarpMachine.warpWithFrames(WarpMachine.warpWithBlock(
              WarpMachine.warpWithMask(warp, yesMask), yes), frames)
            Attempt.progress(WarpMachine.engineReplaceWarp(stepped, warpIndex, nextWarp))
          }
        }
      }
      | _ => Attempt.fail(Failure.invalidState("if condition is not a numeric lane vector"), engine)
    }
    def warpWithStatus (warp: WarpState)(status: WarpStatus): WarpState := {
      match warp returning WarpState with
      | WarpState.mk id block frames registers deferred mask old => WarpState.mk(id, block, frames, registers, deferred, mask, status)
    }
    def gateArrive (engine: Engine)(warpIndex: Nat)(gateId: Nat)(expected: Nat)(rest: Cuda.Block): Attempt := {
      match WarpMachine.engineWarp(engine, warpIndex) returning Attempt with
      | Option.none => Attempt.fail(Failure.invalidState("missing warp at synchronization"), engine)
      | Option.some warp => {
        match warp returning Attempt with
        | WarpState.mk id block frames registers deferredLoads active status => {
          let participants := WarpExpr.maskCount(active)
          match Bool.and(Nat.blt(0, expected), Bool.and(Nat.ble(expected, 256), Nat.blt(0, participants))) returning Attempt with
          | Bool.false => Attempt.fail(Failure.invalidState("synchronization has an invalid participant count or empty active mask"), engine)
          | Bool.true => {
            match WarpMachine.findGateAny(WarpMachine.gatesOf(engine), gateId) returning Attempt with
            | Option.none => {
              match WarpMachine.addGateArrival(SyncGate.mk(gateId, expected, 0, 0, Bool.false), participants)
                  returning Attempt with
              | Option.none => Attempt.fail(Failure.invalidState("synchronization arrival exceeds expected participants"), engine)
              | Option.some changed => {
                let changedGates := WarpMachine.setGateById(WarpMachine.gatesOf(engine), changed)
                let changedEngine := WarpMachine.engineWithGates(engine, changedGates)
                let parked := WarpMachine.warpWithBlock(warp, rest)
                let waiting := WarpMachine.warpWithStatus(parked, WarpStatus.blockedGate(gateId))
                let next := WarpMachine.engineReplaceWarp(changedEngine, warpIndex, waiting)
                Attempt.progress(next)
              }
            }
            | Option.some oldGate => {
              match oldGate returning Attempt with
              | SyncGate.mk got oldExpected arrived remaining released => {
                match Nat.beq(oldExpected, expected) returning Attempt with
                | Bool.false => Attempt.fail(Failure.invalidState("synchronization id reused with a different participant count"), engine)
                | Bool.true => {
                  match WarpMachine.addGateArrival(oldGate, participants) returning Attempt with
                  | Option.none => Attempt.fail(Failure.invalidState("synchronization arrival exceeds expected participants or overlaps a live epoch"), engine)
                  | Option.some changed => {
                    let changedGates := WarpMachine.setGateById(WarpMachine.gatesOf(engine), changed)
                    let changedEngine := WarpMachine.engineWithGates(engine, changedGates)
                    let parked := WarpMachine.warpWithBlock(warp, rest)
                    let waiting := WarpMachine.warpWithStatus(parked, WarpStatus.blockedGate(gateId))
                    let next := WarpMachine.engineReplaceWarp(changedEngine, warpIndex, waiting)
                    Attempt.progress(next)
                  }
                }
              }
            }
          }
        }
      }
    }
    def wakeOne (engine: Engine)(index: Nat): Engine := {
      match WarpMachine.engineWarp(engine, index) returning Engine with
      | Option.none => engine
      | Option.some warp => {
        match warp returning Engine with
        | WarpState.mk id block frames registers deferredLoads active status => {
          match status returning Engine with
          | WarpStatus.blockedGate gateId => {
            match WarpMachine.findGateAny(WarpMachine.gatesOf(engine), gateId) returning Engine with
            | Option.none => engine
            | Option.some gate => {
              match gate returning Engine with
              | SyncGate.mk got expected arrived remaining released => {
                match released returning Engine with
                | Bool.false => engine
                | Bool.true => {
                  let participants := WarpExpr.maskCount(active)
                  let left := Nat.sub(remaining, participants)
                  let stillWaiting := Nat.isZero(left)
                  let changedGate := Bool.cond(stillWaiting, SyncGate, SyncGate.mk(got, expected, 0, 0, Bool.false),
                    SyncGate.mk(got, expected, arrived, left, Bool.true))
                  let changedGates := WarpMachine.setGateById(WarpMachine.gatesOf(engine), changedGate)
                  let withGate := WarpMachine.engineWithGates(engine, changedGates)
                  let awake := WarpMachine.engineReplaceWarp(withGate, index, WarpMachine.warpWithStatus(warp, WarpStatus.runnable))
                  WarpMachine.engineBump(awake, 1, 0, 0, 0, 0, 0, 0, 0)
                }
              }
            }
          }
          | WarpStatus.runnable => engine
          | WarpStatus.blocked => engine
          | WarpStatus.finished => engine
          | _ => {
            match WarpMachine.statusReady(engine, warp) returning Engine with
            | Bool.false => engine
            | Bool.true => WarpMachine.engineReplaceWarp(engine, index, WarpMachine.warpWithStatus(warp, WarpStatus.runnable))
          }
        }
      }
    }
    def wakeAll (engine: Engine)(index: Nat)(remaining: Nat): Engine decreases structural(remaining) := {
      match remaining returning Engine with
      | Nat.zero => engine
      | Nat.succ rest => WarpMachine.wakeAll(WarpMachine.wakeOne(engine, index), Nat.succ(index), rest)
    }
    def retireStatement (engine: Engine)(warpIndex: Nat)(warp: WarpState)(rest: Cuda.Block)
        (registers: List(WarpExpr.Register))(mask: Nat): Attempt := {
      let nextWarp := WarpMachine.warpWithStatus(WarpMachine.warpWithBlock(
        WarpMachine.warpWithRegisters(WarpMachine.warpWithMask(warp, mask), registers), rest), WarpStatus.runnable)
      let nextEngine := WarpMachine.engineReplaceWarp(engine, warpIndex, nextWarp)
      Attempt.progress(WarpMachine.engineBump(nextEngine, 1, 0, 0, 0, 0, 0, 0, 0))
    }
    def blockWarp (engine: Engine)(warpIndex: Nat)(warp: WarpState)(status: WarpStatus): Engine :=
      WarpMachine.engineReplaceWarp(engine, warpIndex, WarpMachine.warpWithStatus(warp, status))
    def stepMbarWait (engine: Engine)(warpIndex: Nat)(warp: WarpState)(address: Nat)(parity: Nat)(rest: Cuda.Block): Attempt := {
      match Nat.ble(parity, 1) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("mbarrier wait parity is not a one-bit value"), engine)
      | Bool.true => {
        match WarpMachine.findBarrier(WarpMachine.barriersOf(engine), address) returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("mbarrier.wait used an unknown shared byte address"), engine)
        | Option.some barrier => {
          match WarpMachine.barrierWaitReady(barrier, parity) returning Attempt with
          | Bool.false => Attempt.waiting(WarpMachine.blockWarp(engine, warpIndex, warp, WarpStatus.blockedMbar(address, parity)))
          | Bool.true => WarpMachine.retireStatement(engine, warpIndex, warp, rest, warp.registers, warp.activeMask)
        }
      }
    }
    def stepDeclare (engine: Engine)(warpIndex: Nat)(warp: WarpState)(id: Nat)(expr: Cuda.Expr)(rest: Cuda.Block)
        : Attempt := {
      match WarpMachine.evalExpr(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id, warp.activeMask,
          warp.registers, expr) returning Attempt with
      | WarpExpr.EvalValue.bad message => Attempt.fail(Failure.invalidState(message), engine)
      | WarpExpr.EvalValue.vector values => {
        match Nat.beq(List.length(values), 32) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("initializer is not a 32-lane vector"), engine)
        | Bool.true => {
          let registers := WarpExpr.declare(warp.registers, id, values, warp.activeMask)
          WarpMachine.retireStatement(engine, warpIndex, warp, rest, registers, warp.activeMask)
        }
      }
      | _ => Attempt.fail(Failure.invalidState("register initializer is not a numeric lane vector"), engine)
    }
    def stepAssign (engine: Engine)(warpIndex: Nat)(warp: WarpState)(id: Nat)(expr: Cuda.Expr)(rest: Cuda.Block)
        : Attempt := {
      match WarpMachine.evalExpr(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id, warp.activeMask,
          warp.registers, expr) returning Attempt with
      | WarpExpr.EvalValue.bad message => Attempt.fail(Failure.invalidState(message), engine)
      | WarpExpr.EvalValue.vector values => {
        match WarpExpr.findRegister(warp.registers, id) returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("assignment writes an undeclared register"), engine)
        | Option.some old => {
          let registers := WarpExpr.writeMasked(warp.registers, id, values, warp.activeMask)
          WarpMachine.retireStatement(engine, warpIndex, warp, rest, registers, warp.activeMask)
        }
      }
      | _ => Attempt.fail(Failure.invalidState("assignment value is not a numeric lane vector"), engine)
    }
    def queueData (engine: Engine)(warpIndex: Nat)(warp: WarpState)(request: DeviceApi.DataRequest)
        (barrier: Option(Nat))(phase: Nat)(committed: Bool)(rest: Cuda.Block): Attempt := {
      let event := PendingEvent.data(warp.id, request, barrier, phase, committed)
      let changed := WarpMachine.engineWithEvents(engine, WarpMachine.appendEvent(WarpMachine.eventsOf(engine), event))
      WarpMachine.retireStatement(changed, warpIndex, warp, rest, warp.registers, warp.activeMask)
    }
    def stepTmaStoreLeader (engine: Engine)(warpIndex: Nat)(warp: WarpState)(mapExpr: Cuda.Expr)(xExpr: Cuda.Expr)
        (yExpr: Cuda.Expr)(srcExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      let inputs := WarpMachine.inputsOf(engine)
      let storage := WarpMachine.storageOf(engine)
      let map := WarpMachine.evalResolvedMap(WarpMachine.kernelOf(engine), inputs, storage, warp.id, warp.activeMask, warp.registers, mapExpr)
      let x := WarpMachine.evalUniformNat(inputs, storage, warp.id, warp.activeMask, warp.registers, xExpr)
      let y := WarpMachine.evalUniformNat(inputs, storage, warp.id, warp.activeMask, warp.registers, yExpr)
      let source := WarpMachine.evalAddress(inputs, storage, warp.id, warp.activeMask, warp.registers, srcExpr)
      match map returning Attempt with
      | Option.none => Attempt.fail(Failure.invalidState("TMA store map operand is not a validated launcher map"), engine)
      | Option.some resolved => {
        match x returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("TMA store x coordinate is not uniform"), engine)
        | Option.some xValue => {
          match y returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("TMA store y coordinate is not uniform"), engine)
          | Option.some yValue => {
            match source returning Attempt with
            | Option.none => Attempt.fail(Failure.invalidState("TMA store source is not a uniform shared address"), engine)
            | Option.some srcByte => WarpMachine.queueData(engine, warpIndex, warp,
                DeviceApi.DataRequest.tmaStore(resolved, xValue, yValue, srcByte), Option.none(Nat), 0, Bool.false, rest)
          }
        }
      }
    }
    def stepMmaLeader (engine: Engine)(warpIndex: Nat)(warp: WarpState)(group: Cuda.CtaGroup)(accExpr: Cuda.Expr)
        (a: Cuda.MmaA)(b: Cuda.SmemDesc)(idesc: Cuda.InstrDesc)(accumulateExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      let inputs := WarpMachine.inputsOf(engine)
      let storage := WarpMachine.storageOf(engine)
      let acc := WarpMachine.evalUniformNat(inputs, storage, warp.id, warp.activeMask, warp.registers, accExpr)
      let sourceA := WarpMachine.evalMmaA(inputs, storage, warp.id, warp.activeMask, warp.registers, a)
      let sourceB := WarpMachine.evalOperandDesc(inputs, storage, warp.id, warp.activeMask, warp.registers, b)
      let accumulate := WarpMachine.evalUniformNat(inputs, storage, warp.id, warp.activeMask, warp.registers, accumulateExpr)
      match group returning Attempt with
      | Cuda.CtaGroup.two => Attempt.fail(Failure.unsupported("two-CTA tcgen05.mma"), engine)
      | Cuda.CtaGroup.one => {
        match acc returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("tcgen05.mma accumulator address is not uniform"), engine)
        | Option.some accumulator => {
          match sourceA returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("tcgen05.mma A operand is unsupported or nonuniform"), engine)
          | Option.some left => {
            match sourceB returning Attempt with
            | Option.none => Attempt.fail(Failure.invalidState("tcgen05.mma B descriptor is unsupported or nonuniform"), engine)
            | Option.some right => {
              match accumulate returning Attempt with
              | Option.none => Attempt.fail(Failure.invalidState("tcgen05.mma accumulate predicate is not uniform"), engine)
              | Option.some shouldAccumulate => WarpMachine.queueData(engine, warpIndex, warp,
                  DeviceApi.DataRequest.mma(DeviceApi.MmaDesc.mk(group, accumulator, left, right, idesc, shouldAccumulate)),
                  Option.none(Nat), 0, Bool.true, rest)
            }
          }
        }
      }
    }
    def stepTmemLoad (engine: Engine)(warpIndex: Nat)(warp: WarpState)(shape: Cuda.TmemShape)(dst: List(Nat))
        (addressExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match shape returning Attempt with
      | Cuda.TmemShape.s32x32b => {
        match Nat.beq(warp.activeMask, DeviceApi.LaneVector.fullMask) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("tcgen05.ld requires all 32 lanes of the issuing warp to participate"), engine)
        | Bool.true => {
          match WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
              warp.activeMask, warp.registers, addressExpr) returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("tcgen05.ld tensor-memory base is not uniform across the warp"), engine)
          | Option.some address => {
            let warpGroup := Nat.mod(warp.id, 4)
            WarpMachine.queueData(engine, warpIndex, warp,
              DeviceApi.DataRequest.tmemLoad(shape, dst, address, warpGroup, warp.activeMask),
              Option.none(Nat), 0, Bool.true, rest)
          }
        }
      }
    }
    def stepTmemAllocFull (engine: Engine)(warpIndex: Nat)(warp: WarpState)(group: Cuda.CtaGroup)(slotExpr: Cuda.Expr)
        (columnsExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match group returning Attempt with
      | Cuda.CtaGroup.two => Attempt.fail(Failure.unsupported("two-CTA tensor-memory allocation"), engine)
      | Cuda.CtaGroup.one => {
        let storage := WarpMachine.storageOf(engine)
        match WarpMachine.evalAddress(WarpMachine.inputsOf(engine), storage, warp.id, warp.activeMask, warp.registers, slotExpr)
            returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("tensor-memory allocation slot is not a shared address"), engine)
        | Option.some slot => {
          match WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), storage, warp.id, warp.activeMask, warp.registers, columnsExpr)
              returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("tensor-memory allocation column count is not uniform"), engine)
          | Option.some columns => {
            match TinyDevice.allocTmem(storage, slot, columns) returning Attempt with
            | Option.none => Attempt.fail(Failure.deviceFault("tensor-memory allocation has an invalid slot, extent, or live allocation"), engine)
            | Option.some changed => WarpMachine.retireStatement(WarpMachine.engineWithStorage(engine, changed),
                warpIndex, warp, rest, warp.registers, warp.activeMask)
          }
        }
      }
    }
    def stepTmemDeallocFull (engine: Engine)(warpIndex: Nat)(warp: WarpState)(group: Cuda.CtaGroup)(addressExpr: Cuda.Expr)
        (columnsExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match group returning Attempt with
      | Cuda.CtaGroup.two => Attempt.fail(Failure.unsupported("two-CTA tensor-memory deallocation"), engine)
      | Cuda.CtaGroup.one => {
        let storage := WarpMachine.storageOf(engine)
        let address := WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), storage, warp.id, warp.activeMask, warp.registers, addressExpr)
        let columns := WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), storage, warp.id, warp.activeMask, warp.registers, columnsExpr)
        match address returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("tensor-memory deallocation address is not uniform"), engine)
        | Option.some taddr => {
          match columns returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("tensor-memory deallocation column count is not uniform"), engine)
          | Option.some width => {
            match TinyDevice.deallocTmem(storage, taddr, width) returning Attempt with
            | Option.none => Attempt.fail(Failure.deviceFault("tensor-memory deallocation does not match the live allocation"), engine)
            | Option.some changed => WarpMachine.retireStatement(WarpMachine.engineWithStorage(engine, changed),
                warpIndex, warp, rest, warp.registers, warp.activeMask)
          }
        }
      }
    }
    def stepTmemWait (engine: Engine)(warpIndex: Nat)(warp: WarpState)(what: Cuda.TmemWait)(rest: Cuda.Block): Attempt := {
      match what returning Attempt with
      | Cuda.TmemWait.store => Attempt.fail(Failure.unsupported("tcgen05.wait::st without supported tmemStore"), engine)
      | Cuda.TmemWait.load => {
        match Nat.beq(warp.activeMask, DeviceApi.LaneVector.fullMask) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("tcgen05.wait::ld requires all 32 lanes of the issuing warp to participate"), engine)
        | Bool.true => {
          match Nat.isZero(WarpMachine.pendingTmemLoads(WarpMachine.eventsOf(engine), warp.id)) returning Attempt with
          | Bool.true => {
            let registers := WarpMachine.registerWrites(warp.registers, WarpMachine.deferredLoadsOf(warp),
              DeviceApi.LaneVector.fullMask)
            let loaded := WarpMachine.warpWithDeferredLoads(
              WarpMachine.warpWithRegisters(warp, registers), List.nil(DeviceApi.RegisterWrite))
            WarpMachine.retireStatement(engine, warpIndex, loaded, rest, loaded.registers, loaded.activeMask)
          }
          | Bool.false => Attempt.waiting(WarpMachine.blockWarp(engine, warpIndex, warp, WarpStatus.blockedTmem(what)))
        }
      }
    }
    def stepBarrierSync (engine: Engine)(warpIndex: Nat)(warp: WarpState)(idExpr: Cuda.Expr)(threadsExpr: Cuda.Expr)
        (rest: Cuda.Block): Attempt := {
      let id := WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
        warp.activeMask, warp.registers, idExpr)
      let threads := WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
        warp.activeMask, warp.registers, threadsExpr)
      match id returning Attempt with
      | Option.none => Attempt.fail(Failure.invalidState("bar.sync id is not uniform"), engine)
      | Option.some barrierId => {
        match threads returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("bar.sync participant count is not uniform"), engine)
        | Option.some participants => WarpMachine.gateArrive(engine, warpIndex, barrierId, participants, rest)
      }
    }
    def stepBulkCommitLeader (engine: Engine)(warpIndex: Nat)(warp: WarpState)(rest: Cuda.Block): Attempt := {
      let events := WarpMachine.commitStoreEvents(WarpMachine.eventsOf(engine), warp.id)
      let changed := WarpMachine.engineWithEvents(engine, events)
      WarpMachine.retireStatement(changed, warpIndex, warp, rest, warp.registers, warp.activeMask)
    }
    def stepMbarWaitExpr (engine: Engine)(warpIndex: Nat)(warp: WarpState)(barrierScope: Cuda.BarrierScope)(barExpr: Cuda.Expr)
        (parityExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match barrierScope returning Attempt with
      | Cuda.BarrierScope.cluster => Attempt.fail(Failure.unsupported("cluster-scope mbarrier wait"), engine)
      | Cuda.BarrierScope.cta => {
        let address := WarpMachine.evalAddress(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
          warp.activeMask, warp.registers, barExpr)
        let parity := WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
          warp.activeMask, warp.registers, parityExpr)
        match address returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("mbarrier.wait address is not shared memory"), engine)
        | Option.some barrier => {
          match parity returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("mbarrier.wait parity is not uniform"), engine)
          | Option.some phase => WarpMachine.stepMbarWait(engine, warpIndex, warp, barrier, phase, rest)
        }
      }
    }
    def stepTcCommitLeader (engine: Engine)(warpIndex: Nat)(warp: WarpState)(group: Cuda.CtaGroup)(barExpr: Cuda.Expr)
        (multicast: Option(Nat))(rest: Cuda.Block): Attempt := {
      match group returning Attempt with
      | Cuda.CtaGroup.two => Attempt.fail(Failure.unsupported("two-CTA tcgen05.commit"), engine)
      | Cuda.CtaGroup.one => {
        match multicast returning Attempt with
        | Option.some mask => Attempt.fail(Failure.unsupported("multicast tcgen05.commit"), engine)
        | Option.none => {
          match WarpMachine.evalAddress(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
              warp.activeMask, warp.registers, barExpr) returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("tcgen05.commit barrier is not shared memory"), engine)
          | Option.some address => {
            match WarpMachine.findBarrier(WarpMachine.barriersOf(engine), address) returning Attempt with
            | Option.none => Attempt.fail(Failure.invalidState("tcgen05.commit targets an uninitialized mbarrier"), engine)
            | Option.some barrier => {
              let queued := WarpMachine.engineWithEvents(engine,
                WarpMachine.appendEvent(WarpMachine.eventsOf(engine),
                  PendingEvent.tcCommit(warp.id, address, WarpMachine.barrierPhase(barrier))))
              WarpMachine.retireStatement(queued, warpIndex, warp, rest, warp.registers, warp.activeMask)
            }
          }
        }
      }
    }
    def stepElectFull (engine: Engine)(warpIndex: Nat)(warp: WarpState)(flag: Nat)(rest: Cuda.Block): Attempt := {
      let (values, elected) := WarpMachine.electValues(warp.activeMask, 0, 32, Bool.false)
      match elected returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("elect.sync has no active lane"), engine)
      | Bool.true => {
        let registers := WarpExpr.writeMasked(warp.registers, flag, values, warp.activeMask)
        WarpMachine.retireStatement(engine, warpIndex, warp, rest, registers, warp.activeMask)
      }
    }
    def stepVoteAnyFull (engine: Engine)(warpIndex: Nat)(warp: WarpState)(destination: Nat)(predicate: Cuda.Expr)
        (rest: Cuda.Block): Attempt := {
      match WarpMachine.evalExpr(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id, warp.activeMask,
          warp.registers, predicate) returning Attempt with
      | WarpExpr.EvalValue.bad message => Attempt.fail(Failure.invalidState(message), engine)
      | WarpExpr.EvalValue.vector values => {
        match Nat.beq(List.length(values), 32) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("vote.sync.any predicate is not a 32-lane vector"), engine)
        | Bool.true => {
          let any := WarpMachine.anyActiveNonzero(values, warp.activeMask, 0)
          let result := Bool.cond(any, Nat, 1, 0)
          let registers := WarpExpr.writeMasked(warp.registers, destination, WarpExpr.uniform(result), warp.activeMask)
          WarpMachine.retireStatement(engine, warpIndex, warp, rest, registers, warp.activeMask)
        }
      }
      | _ => Attempt.fail(Failure.invalidState("vote.sync.any predicate is not a lane vector"), engine)
    }
    def stepShflFull (engine: Engine)(warpIndex: Nat)(warp: WarpState)(destination: Nat)(sourceExpr: Cuda.Expr)
        (sourceLane: Nat)(rest: Cuda.Block): Attempt := {
      match Nat.blt(sourceLane, 32) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("shfl.sync.idx source lane is out of range"), engine)
      | Bool.true => {
        match WarpMachine.laneBit(warp.activeMask, sourceLane) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("shfl.sync.idx source lane is not participating"), engine)
        | Bool.true => {
          match WarpMachine.evalExpr(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
              warp.activeMask, warp.registers, sourceExpr) returning Attempt with
          | WarpExpr.EvalValue.bad message => Attempt.fail(Failure.invalidState(message), engine)
          | WarpExpr.EvalValue.vector values => {
            match WarpMachine.sameLaneValue(values, sourceLane) returning Attempt with
            | Option.none => Attempt.fail(Failure.invalidState("shfl.sync.idx source value is absent"), engine)
            | Option.some value => {
              let registers := WarpExpr.writeMasked(warp.registers, destination, WarpExpr.uniform(value), warp.activeMask)
              WarpMachine.retireStatement(engine, warpIndex, warp, rest, registers, warp.activeMask)
            }
          }
          | _ => Attempt.fail(Failure.invalidState("shfl.sync.idx source is not a lane vector"), engine)
        }
      }
    }
    def stepStShared (engine: Engine)(warpIndex: Nat)(warp: WarpState)(addressExpr: Cuda.Expr)
        (values: List(Cuda.Expr))(rest: Cuda.Block): Attempt := {
      match WarpExpr.eval(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id, warp.activeMask,
          warp.registers, addressExpr) returning Attempt with
      | WarpExpr.EvalValue.bad message => Attempt.fail(Failure.invalidState(message), engine)
      | WarpExpr.EvalValue.vector addresses => {
        match Bool.and(Nat.beq(List.length(addresses), 32), Nat.blt(0, List.length(values))) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("st.shared requires a 32-lane address vector and at least one value"), engine)
        | Bool.true => {
          match WarpMachine.writeStValues(WarpMachine.storageOf(engine), WarpMachine.inputsOf(engine), warp.id,
              warp.activeMask, warp.registers, addresses, values, 0) returning Attempt with
          | Option.none => Attempt.fail(Failure.deviceFault("st.shared vector access is outside dynamic shared memory"), engine)
          | Option.some changed => WarpMachine.retireStatement(WarpMachine.engineWithStorage(engine, changed),
              warpIndex, warp, rest, warp.registers, warp.activeMask)
        }
      }
      | _ => Attempt.fail(Failure.invalidState("st.shared address is not a lane vector"), engine)
    }
    def stepLdShared (engine: Engine)(warpIndex: Nat)(warp: WarpState)(memoryScope: Cuda.Scope)(destination: Nat)
        (addressExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match memoryScope returning Attempt with
      | Cuda.Scope.cluster => Attempt.fail(Failure.unsupported("cluster-scope generic load"), engine)
      | Cuda.Scope.gpu => Attempt.fail(Failure.unsupported("GPU-scope generic load"), engine)
      | Cuda.Scope.cta => {
        match WarpMachine.evalAddress(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
            warp.activeMask, warp.registers, addressExpr) returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("generic load address is not a uniform shared pointer"), engine)
        | Option.some address => {
          match TinyDevice.readShared(WarpMachine.storageOf(engine), address, Cuda.DType.u32) returning Attempt with
          | Option.none => Attempt.fail(Failure.deviceFault("generic shared load is out of bounds or misaligned"), engine)
          | Option.some value => {
            let registers := WarpExpr.writeMasked(warp.registers, destination, WarpExpr.uniform(value), warp.activeMask)
            WarpMachine.retireStatement(engine, warpIndex, warp, rest, registers, warp.activeMask)
          }
        }
      }
    }
    def oneLaneActive (warp: WarpState): Bool := Nat.beq(WarpExpr.maskCount(warp.activeMask), 1)
    def stepMbarInit (engine: Engine)(warpIndex: Nat)(warp: WarpState)(address: Nat)(expected: Nat)(rest: Cuda.Block): Attempt := {
      match Bool.and(WarpMachine.oneLaneActive(warp),
          Bool.and(Nat.blt(0, expected), TinyDevice.sharedAddressOk(WarpMachine.storageOf(engine), address, 8, 8)))
          returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("mbarrier.init requires one active lane, a positive participant count, and a valid shared byte address"), engine)
      | Bool.true => {
        match WarpMachine.findBarrier(WarpMachine.barriersOf(engine), address) returning Attempt with
        | Option.none => {
          let barrier := WarpMachine.barrierAfterInit(address, expected)
          let next := WarpMachine.engineWithBarriers(engine, WarpMachine.setBarrier(WarpMachine.barriersOf(engine), barrier))
          WarpMachine.retireStatement(next, warpIndex, warp, rest, warp.registers, warp.activeMask)
        }
        | Option.some previous => {
          match previous returning Attempt with
          | Barrier.mk oldAddress oldExpected arrivals txExpected issued txDone phase initialized completed => {
            match initialized returning Attempt with
            | Bool.true => Attempt.fail(Failure.invalidState("mbarrier.init reinitialized a live barrier"), engine)
            | Bool.false => {
              let barrier := WarpMachine.barrierAfterInit(address, expected)
              let next := WarpMachine.engineWithBarriers(engine, WarpMachine.setBarrier(WarpMachine.barriersOf(engine), barrier))
              WarpMachine.retireStatement(next, warpIndex, warp, rest, warp.registers, warp.activeMask)
            }
          }
        }
      }
    }
    def stepMbarInval (engine: Engine)(warpIndex: Nat)(warp: WarpState)(address: Nat)(rest: Cuda.Block): Attempt := {
      match WarpMachine.oneLaneActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("mbarrier.inval requires exactly one active lane"), engine)
      | Bool.true => {
        match WarpMachine.findBarrier(WarpMachine.barriersOf(engine), address) returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("mbarrier.inval used an unknown shared byte address"), engine)
        | Option.some barrier => {
          match Bool.and(WarpMachine.barrierQuiescent(barrier),
              Bool.not(WarpMachine.eventsUseBarrier(WarpMachine.eventsOf(engine), address))) returning Attempt with
          | Bool.false => Attempt.fail(Failure.invalidState("mbarrier.inval while the barrier phase or async events are live"), engine)
          | Bool.true => {
            let invalidated := WarpMachine.barrierAfterInvalidate(barrier)
            let changed := WarpMachine.engineWithBarriers(engine, WarpMachine.setBarrier(WarpMachine.barriersOf(engine), invalidated))
            WarpMachine.retireStatement(changed, warpIndex, warp, rest, warp.registers, warp.activeMask)
          }
        }
      }
    }
    def stepMbarArrive (engine: Engine)(warpIndex: Nat)(warp: WarpState)(address: Nat)(arrivals: Nat)(bytes: Nat)
        (rest: Cuda.Block): Attempt := {
      match WarpMachine.oneLaneActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("mbarrier.arrive requires exactly one active lane"), engine)
      | Bool.true => {
        match WarpMachine.findBarrier(WarpMachine.barriersOf(engine), address) returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("mbarrier.arrive used an unknown shared byte address"), engine)
        | Option.some barrier => {
          match WarpMachine.barrierAfterArrival(barrier, arrivals, bytes) returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("mbarrier arrival count exceeds its initialized phase"), engine)
          | Option.some changedBarrier => {
            let changed := WarpMachine.engineWithBarriers(engine, WarpMachine.setBarrier(WarpMachine.barriersOf(engine), changedBarrier))
            WarpMachine.retireStatement(changed, warpIndex, warp, rest, warp.registers, warp.activeMask)
          }
        }
      }
    }
    def stepTmaLoad (engine: Engine)(warpIndex: Nat)(warp: WarpState)(group: Cuda.CtaGroup)(dst: Cuda.Expr)
        (mapExpr: Cuda.Expr)(xExpr: Cuda.Expr)(yExpr: Cuda.Expr)(barExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match group returning Attempt with
      | Cuda.CtaGroup.two => Attempt.fail(Failure.unsupported("two-CTA TMA load"), engine)
      | Cuda.CtaGroup.one => {
        match WarpMachine.oneLaneActive(warp) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("TMA load issue requires exactly one active lane"), engine)
        | Bool.true => {
          let inputs := WarpMachine.inputsOf(engine)
          let storage := WarpMachine.storageOf(engine)
          let map := WarpMachine.evalResolvedMap(WarpMachine.kernelOf(engine), inputs, storage, warp.id, warp.activeMask, warp.registers, mapExpr)
          let destination := WarpMachine.evalAddress(inputs, storage, warp.id, warp.activeMask, warp.registers, dst)
          let x := WarpMachine.evalUniformNat(inputs, storage, warp.id, warp.activeMask, warp.registers, xExpr)
          let y := WarpMachine.evalUniformNat(inputs, storage, warp.id, warp.activeMask, warp.registers, yExpr)
          let barrierAddress := WarpMachine.evalAddress(inputs, storage, warp.id, warp.activeMask, warp.registers, barExpr)
        match map returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("TMA load map operand is not a validated launcher map"), engine)
        | Option.some resolved => {
          match destination returning Attempt with
          | Option.none => Attempt.fail(Failure.invalidState("TMA load destination is not a uniform shared address"), engine)
          | Option.some dstByte => {
            match x returning Attempt with
            | Option.none => Attempt.fail(Failure.invalidState("TMA load x coordinate is not uniform"), engine)
            | Option.some xValue => {
              match y returning Attempt with
              | Option.none => Attempt.fail(Failure.invalidState("TMA load y coordinate is not uniform"), engine)
              | Option.some yValue => {
                match barrierAddress returning Attempt with
                | Option.none => Attempt.fail(Failure.invalidState("TMA load completion operand is not a shared address"), engine)
                | Option.some barrier => {
                  match WarpMachine.findBarrier(WarpMachine.barriersOf(engine), barrier) returning Attempt with
                  | Option.none => Attempt.fail(Failure.invalidState("TMA load targets an uninitialized completion barrier"), engine)
                  | Option.some readyBarrier => {
                    let phase := WarpMachine.barrierPhase(readyBarrier)
                    match WarpMachine.barrierScheduleBytes(readyBarrier, phase, 16384) returning Attempt with
                    | Option.none => Attempt.fail(Failure.invalidState("TMA load exceeds the current expect_tx byte budget"), engine)
                    | Option.some reserved => {
                      let scheduled := WarpMachine.engineWithBarriers(engine,
                        WarpMachine.setBarrier(WarpMachine.barriersOf(engine), reserved))
                      WarpMachine.queueData(scheduled, warpIndex, warp,
                        DeviceApi.DataRequest.tmaLoad(resolved, dstByte, xValue, yValue), Option.some(barrier), phase, Bool.true, rest)
                    }
                  }
                }
              }
            }
          }
          }
        }
      }
    }
    def stepTmaStore (engine: Engine)(warpIndex: Nat)(warp: WarpState)(mapExpr: Cuda.Expr)(xExpr: Cuda.Expr)
        (yExpr: Cuda.Expr)(srcExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match WarpMachine.oneLaneActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("TMA store issue requires exactly one active lane"), engine)
      | Bool.true => WarpMachine.stepTmaStoreLeader(engine, warpIndex, warp, mapExpr, xExpr, yExpr, srcExpr, rest)
    }
    def stepMma (engine: Engine)(warpIndex: Nat)(warp: WarpState)(group: Cuda.CtaGroup)(accExpr: Cuda.Expr)
        (a: Cuda.MmaA)(b: Cuda.SmemDesc)(idesc: Cuda.InstrDesc)(accumulateExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match WarpMachine.oneLaneActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("tcgen05.mma issue requires exactly one active lane"), engine)
      | Bool.true => WarpMachine.stepMmaLeader(engine, warpIndex, warp, group, accExpr, a, b, idesc, accumulateExpr, rest)
    }
    def stepBulkWait (engine: Engine)(warpIndex: Nat)(warp: WarpState)(what: Cuda.BulkWait)(pending: Nat)
        (rest: Cuda.Block): Attempt := {
      match WarpMachine.oneLaneActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("cp.async.bulk.wait_group requires exactly one active lane"), engine)
      | Bool.true => {
        match WarpMachine.bulkWaitReady(WarpMachine.eventsOf(engine), warp.id, pending) returning Attempt with
        | Bool.true => WarpMachine.retireStatement(engine, warpIndex, warp, rest, warp.registers, warp.activeMask)
        | Bool.false => Attempt.waiting(WarpMachine.blockWarp(engine, warpIndex, warp, WarpStatus.blockedBulk(what, pending)))
      }
    }
    def stepBulkCommit (engine: Engine)(warpIndex: Nat)(warp: WarpState)(rest: Cuda.Block): Attempt := {
      match WarpMachine.oneLaneActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("cp.async.bulk.commit_group requires exactly one active lane"), engine)
      | Bool.true => WarpMachine.stepBulkCommitLeader(engine, warpIndex, warp, rest)
    }
    def stepMbarInitExpr (engine: Engine)(warpIndex: Nat)(warp: WarpState)(barExpr: Cuda.Expr)(countExpr: Cuda.Expr)
        (rest: Cuda.Block): Attempt := {
      let storage := WarpMachine.storageOf(engine)
      let address := WarpMachine.evalAddress(WarpMachine.inputsOf(engine), storage, warp.id, warp.activeMask, warp.registers, barExpr)
      let count := WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), storage, warp.id, warp.activeMask, warp.registers, countExpr)
      match address returning Attempt with
      | Option.none => Attempt.fail(Failure.invalidState("mbarrier.init address is not shared memory"), engine)
      | Option.some barrier => {
        match count returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("mbarrier.init arrival count is not uniform"), engine)
        | Option.some expected => WarpMachine.stepMbarInit(engine, warpIndex, warp, barrier, expected, rest)
      }
    }
    def stepMbarInvalExpr (engine: Engine)(warpIndex: Nat)(warp: WarpState)(barExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match WarpMachine.evalAddress(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id, warp.activeMask,
          warp.registers, barExpr) returning Attempt with
      | Option.none => Attempt.fail(Failure.invalidState("mbarrier.inval address is not shared memory"), engine)
      | Option.some address => WarpMachine.stepMbarInval(engine, warpIndex, warp, address, rest)
    }
    def stepMbarArriveExpr (engine: Engine)(warpIndex: Nat)(warp: WarpState)(window: Cuda.Window)(barExpr: Cuda.Expr)
        (arrival: Cuda.Arrival)(rest: Cuda.Block): Attempt := {
      match window returning Attempt with
      | Cuda.Window.cluster => Attempt.fail(Failure.unsupported("cluster-scope mbarrier arrival"), engine)
      | Cuda.Window.cta => {
        let address := WarpMachine.evalAddress(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
          warp.activeMask, warp.registers, barExpr)
        match address returning Attempt with
        | Option.none => Attempt.fail(Failure.invalidState("mbarrier.arrive address is not shared memory"), engine)
        | Option.some barrier => {
          match arrival returning Attempt with
          | Cuda.Arrival.one => WarpMachine.stepMbarArrive(engine, warpIndex, warp, barrier, 1, 0, rest)
          | Cuda.Arrival.count countExpr => {
            match WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
                warp.activeMask, warp.registers, countExpr) returning Attempt with
            | Option.none => Attempt.fail(Failure.invalidState("mbarrier arrival count is not uniform"), engine)
            | Option.some count => WarpMachine.stepMbarArrive(engine, warpIndex, warp, barrier, count, 0, rest)
          }
          | Cuda.Arrival.expectTx bytesExpr => {
            match WarpMachine.evalUniformNat(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
                warp.activeMask, warp.registers, bytesExpr) returning Attempt with
            | Option.none => Attempt.fail(Failure.invalidState("mbarrier expected byte count is not uniform"), engine)
            | Option.some bytes => WarpMachine.stepMbarArrive(engine, warpIndex, warp, barrier, 1, bytes, rest)
          }
        }
      }
    }
    def stepTcCommit (engine: Engine)(warpIndex: Nat)(warp: WarpState)(group: Cuda.CtaGroup)(barExpr: Cuda.Expr)
        (multicast: Option(Nat))(rest: Cuda.Block): Attempt := {
      match WarpMachine.oneLaneActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("tcgen05.commit issue requires exactly one active lane"), engine)
      | Bool.true => WarpMachine.stepTcCommitLeader(engine, warpIndex, warp, group, barExpr, multicast, rest)
    }
    def fullWarpActive (warp: WarpState): Bool := Nat.beq(warp.activeMask, DeviceApi.LaneVector.fullMask)
    def stepTmemAlloc (engine: Engine)(warpIndex: Nat)(warp: WarpState)(group: Cuda.CtaGroup)(slotExpr: Cuda.Expr)
        (columnsExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match WarpMachine.fullWarpActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("tcgen05.alloc requires all 32 lanes of the issuing warp to participate"), engine)
      | Bool.true => WarpMachine.stepTmemAllocFull(engine, warpIndex, warp, group, slotExpr, columnsExpr, rest)
    }
    def stepTmemDealloc (engine: Engine)(warpIndex: Nat)(warp: WarpState)(group: Cuda.CtaGroup)(addressExpr: Cuda.Expr)
        (columnsExpr: Cuda.Expr)(rest: Cuda.Block): Attempt := {
      match WarpMachine.fullWarpActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("tcgen05.dealloc requires all 32 lanes of the issuing warp to participate"), engine)
      | Bool.true => WarpMachine.stepTmemDeallocFull(engine, warpIndex, warp, group, addressExpr, columnsExpr, rest)
    }
    def stepElect (engine: Engine)(warpIndex: Nat)(warp: WarpState)(flag: Nat)(rest: Cuda.Block): Attempt := {
      match WarpMachine.fullWarpActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("elect.sync requires its fixed full-warp member mask"), engine)
      | Bool.true => WarpMachine.stepElectFull(engine, warpIndex, warp, flag, rest)
    }
    def stepVoteAny (engine: Engine)(warpIndex: Nat)(warp: WarpState)(destination: Nat)(predicate: Cuda.Expr)
        (rest: Cuda.Block): Attempt := {
      match WarpMachine.fullWarpActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("vote.sync.any requires its fixed full-warp member mask"), engine)
      | Bool.true => WarpMachine.stepVoteAnyFull(engine, warpIndex, warp, destination, predicate, rest)
    }
    def stepShfl (engine: Engine)(warpIndex: Nat)(warp: WarpState)(destination: Nat)(sourceExpr: Cuda.Expr)
        (sourceLane: Nat)(rest: Cuda.Block): Attempt := {
      match WarpMachine.fullWarpActive(warp) returning Attempt with
      | Bool.false => Attempt.fail(Failure.invalidState("shfl.sync.idx requires its fixed full-warp member mask"), engine)
      | Bool.true => WarpMachine.stepShflFull(engine, warpIndex, warp, destination, sourceExpr, sourceLane, rest)
    }
    def stepInstr (engine: Engine)(warpIndex: Nat)(warp: WarpState)(instruction: Cuda.Instr)(rest: Cuda.Block): Attempt := {
      match instruction returning Attempt with
      | Cuda.Instr.barSync id threads => WarpMachine.stepBarrierSync(engine, warpIndex, warp, id, threads, rest)
      | Cuda.Instr.mbarInit bar count => WarpMachine.stepMbarInitExpr(engine, warpIndex, warp, bar, count, rest)
      | Cuda.Instr.mbarInval bar => WarpMachine.stepMbarInvalExpr(engine, warpIndex, warp, bar, rest)
      | Cuda.Instr.mbarArrive window bar arrival => WarpMachine.stepMbarArriveExpr(engine, warpIndex, warp, window, bar, arrival, rest)
      | Cuda.Instr.mbarWait barrierScope bar parity =>
        WarpMachine.stepMbarWaitExpr(engine, warpIndex, warp, barrierScope, bar, parity, rest)
      | Cuda.Instr.fenceMbarInit => WarpMachine.retireStatement(engine, warpIndex, warp, rest, warp.registers, warp.activeMask)
      | Cuda.Instr.fenceProxyAsync => WarpMachine.retireStatement(engine, warpIndex, warp, rest, warp.registers, warp.activeMask)
      | Cuda.Instr.tcFence side => WarpMachine.retireStatement(engine, warpIndex, warp, rest, warp.registers, warp.activeMask)
      | Cuda.Instr.clusterArrive => Attempt.fail(Failure.unsupported("cluster barrier arrive"), engine)
      | Cuda.Instr.clusterWait => Attempt.fail(Failure.unsupported("cluster barrier wait"), engine)
      | Cuda.Instr.tmaLoad group dst map x y barrier => WarpMachine.stepTmaLoad(engine, warpIndex, warp, group, dst, map, x, y, barrier, rest)
      | Cuda.Instr.tmaStore map x y src => WarpMachine.stepTmaStore(engine, warpIndex, warp, map, x, y, src, rest)
      | Cuda.Instr.bulkCommit => WarpMachine.stepBulkCommit(engine, warpIndex, warp, rest)
      | Cuda.Instr.bulkWait what pending => WarpMachine.stepBulkWait(engine, warpIndex, warp, what, pending, rest)
      | Cuda.Instr.tmemAlloc group slot cols => WarpMachine.stepTmemAlloc(engine, warpIndex, warp, group, slot, cols, rest)
      | Cuda.Instr.tmemRelinquish group => {
        match group returning Attempt with
        | Cuda.CtaGroup.one => {
          match WarpMachine.fullWarpActive(warp) returning Attempt with
          | Bool.false => Attempt.fail(Failure.invalidState("tcgen05.relinquish requires all 32 lanes of the issuing warp to participate"), engine)
          | Bool.true => WarpMachine.retireStatement(engine, warpIndex, warp, rest, warp.registers, warp.activeMask)
        }
        | Cuda.CtaGroup.two => Attempt.fail(Failure.unsupported("two-CTA tensor-memory permit relinquish"), engine)
      }
      | Cuda.Instr.tmemDealloc group address cols => WarpMachine.stepTmemDealloc(engine, warpIndex, warp, group, address, cols, rest)
      | Cuda.Instr.mma group acc a b idesc accumulate => WarpMachine.stepMma(engine, warpIndex, warp, group, acc, a, b, idesc, accumulate, rest)
      | Cuda.Instr.tcCommit group barrier multicast => WarpMachine.stepTcCommit(engine, warpIndex, warp, group, barrier, multicast, rest)
      | Cuda.Instr.tmemLoad shape dst address => WarpMachine.stepTmemLoad(engine, warpIndex, warp, shape, dst, address, rest)
      | Cuda.Instr.tmemStore shape word address values => Attempt.fail(Failure.unsupported("tcgen05.st is outside the TinyGEMM interpreter subset"), engine)
      | Cuda.Instr.tmemWait what => WarpMachine.stepTmemWait(engine, warpIndex, warp, what, rest)
      | Cuda.Instr.elect flag => WarpMachine.stepElect(engine, warpIndex, warp, flag, rest)
      | Cuda.Instr.shfl destination value sourceLane => WarpMachine.stepShfl(engine, warpIndex, warp, destination, value, sourceLane, rest)
      | Cuda.Instr.voteAny destination predicate => WarpMachine.stepVoteAny(engine, warpIndex, warp, destination, predicate, rest)
      | Cuda.Instr.setMaxNReg change count => Attempt.fail(Failure.unsupported("setmaxnreg register-pool behavior is not modeled"), engine)
      | Cuda.Instr.movF32 destination bits => Attempt.fail(Failure.unsupported("floating-point mov in exact-ring TinyGEMM"), engine)
      | Cuda.Instr.ex2 destination input => Attempt.fail(Failure.unsupported("floating-point ex2 in exact-ring TinyGEMM"), engine)
      | Cuda.Instr.lg2 destination input => Attempt.fail(Failure.unsupported("floating-point lg2 in exact-ring TinyGEMM"), engine)
      | Cuda.Instr.ex2Emulated destination input => Attempt.fail(Failure.unsupported("floating-point ex2 emulation in exact-ring TinyGEMM"), engine)
      | Cuda.Instr.rcp rounding destination input => Attempt.fail(Failure.unsupported("floating-point reciprocal in exact-ring TinyGEMM"), engine)
      | Cuda.Instr.cvtBf16x2 destination hi lo => Attempt.fail(Failure.unsupported("bf16 conversion in exact-ring TinyGEMM"), engine)
      | Cuda.Instr.ldRelaxed level destination address => WarpMachine.stepLdShared(engine, warpIndex, warp, level, destination, address, rest)
      | Cuda.Instr.casRelaxed level destination address expected desired => Attempt.fail(Failure.unsupported("atomic compare-and-swap"), engine)
      | Cuda.Instr.movSpecial destination register => Attempt.fail(Failure.unsupported("cluster special register"), engine)
      | Cuda.Instr.mapa destination address rank => Attempt.fail(Failure.unsupported("cluster shared-memory mapa"), engine)
      | Cuda.Instr.stShared address values => WarpMachine.stepStShared(engine, warpIndex, warp, address, values, rest)
    }
    def loopMask (values: List(Nat))(stop: List(Nat))(parentMask: Nat)(lane: Nat): Nat
        decreases structural(values) := {
      match values returning Nat with
      | List.nil => 0
      | List.cons current rest => {
        match stop returning Nat with
        | List.nil => 0
        | List.cons bound more => {
          let parent := WarpExpr.laneMask(parentMask, lane)
          let inLoop := Bool.and(parent, Nat.blt(current, bound))
          let bit := Bool.cond(inLoop, Nat, Nat.pow(2, lane), 0)
          Nat.add(bit, WarpMachine.loopMask(rest, more, parentMask, Nat.succ(lane)))
        }
      }
    }
    def stepLoop (engine: Engine)(warpIndex: Nat)(warp: WarpState)(id: Nat)(start: Cuda.Expr)(stop: Cuda.Expr)
        (step: Cuda.Expr)(body: Cuda.Block)(rest: Cuda.Block): Attempt := {
      let initialValue := WarpMachine.evalExpr(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
        warp.activeMask, warp.registers, start)
      let stopValue := WarpMachine.evalExpr(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
        warp.activeMask, warp.registers, stop)
      let stepValue := WarpMachine.evalExpr(WarpMachine.inputsOf(engine), WarpMachine.storageOf(engine), warp.id,
        warp.activeMask, warp.registers, step)
      match initialValue returning Attempt with
      | WarpExpr.EvalValue.bad message => Attempt.fail(Failure.invalidState(message), engine)
      | WarpExpr.EvalValue.vector initial => {
        match stopValue returning Attempt with
        | WarpExpr.EvalValue.bad message => Attempt.fail(Failure.invalidState(message), engine)
        | WarpExpr.EvalValue.vector bounds => {
          match stepValue returning Attempt with
          | WarpExpr.EvalValue.bad message => Attempt.fail(Failure.invalidState(message), engine)
          | WarpExpr.EvalValue.vector amounts => {
            match Bool.and(Nat.beq(List.length(initial), 32),
                Bool.and(Nat.beq(List.length(bounds), 32), Nat.beq(List.length(amounts), 32))) returning Attempt with
            | Bool.false => Attempt.fail(Failure.invalidState("loop operand is not a 32-lane vector"), engine)
            | Bool.true => {
              let registers := WarpExpr.declare(warp.registers, id, initial, warp.activeMask)
              let iterations := WarpMachine.loopMask(initial, bounds, warp.activeMask, 0)
              let stepped := WarpMachine.engineBump(engine, 1, 0, 0, 0, 0, 0, 0, 0)
              match WarpExpr.maskCount(iterations) returning Attempt with
              | Nat.zero => WarpMachine.retireStatement(engine, warpIndex, warp, rest, registers, warp.activeMask)
              | Nat.succ lanes => {
                let frames := FrameStack.cons(Frame.loop(id, bounds, amounts, body, rest, warp.activeMask, iterations), warp.frames)
                let inBody := WarpMachine.warpWithFrames(WarpMachine.warpWithRegisters(
                  WarpMachine.warpWithBlock(WarpMachine.warpWithMask(warp, iterations), body), registers), frames)
                let next := WarpMachine.engineReplaceWarp(stepped, warpIndex, inBody)
                Attempt.progress(next)
              }
            }
          }
          | _ => Attempt.fail(Failure.invalidState("loop step is not a numeric lane vector"), engine)
        }
        | _ => Attempt.fail(Failure.invalidState("loop stop is not a numeric lane vector"), engine)
      }
      | _ => Attempt.fail(Failure.invalidState("loop start is not a numeric lane vector"), engine)
    }
    def stepStmt (engine: Engine)(warpIndex: Nat)(warp: WarpState)(statement: Cuda.Stmt)(rest: Cuda.Block): Attempt := {
      match statement returning Attempt with
      | Cuda.Stmt.decl dtype id init => WarpMachine.stepDeclare(engine, warpIndex, warp, id, init, rest)
      | Cuda.Stmt.declMut dtype id init => WarpMachine.stepDeclare(engine, warpIndex, warp, id, init, rest)
      | Cuda.Stmt.declOut dtype id => {
        let registers := WarpExpr.declare(warp.registers, id, WarpExpr.zeroVector, 0)
        WarpMachine.retireStatement(engine, warpIndex, warp, rest, registers, warp.activeMask)
      }
      | Cuda.Stmt.assign id value => WarpMachine.stepAssign(engine, warpIndex, warp, id, value, rest)
      | Cuda.Stmt.store base index value => Attempt.fail(Failure.unsupported("generic global store statement"), engine)
      | Cuda.Stmt.shared dtype id size => Attempt.fail(Failure.unsupported("static shared declaration outside the dynamic-shared Tiny subset"), engine)
      | Cuda.Stmt.forLoop id start stop body => WarpMachine.stepLoop(engine, warpIndex, warp, id, start, stop,
          Cuda.Expr.lit(1), body, rest)
      | Cuda.Stmt.forStride id start stop step body => WarpMachine.stepLoop(engine, warpIndex, warp, id, start, stop, step, body, rest)
      | Cuda.Stmt.ifElse condition yes no => WarpMachine.stepIfElse(engine, warpIndex, warp, condition, yes, no, rest)
      | Cuda.Stmt.scoped body => {
        let frames := FrameStack.cons(Frame.scoped(rest, warp.activeMask), warp.frames)
        let nested := WarpMachine.warpWithFrames(WarpMachine.warpWithBlock(warp, body), frames)
        let changed := WarpMachine.engineReplaceWarp(engine, warpIndex, nested)
        Attempt.progress(WarpMachine.engineBump(changed, 1, 0, 0, 0, 0, 0, 0, 0))
      }
      | Cuda.Stmt.sync => WarpMachine.gateArrive(engine, warpIndex, 1000000, 256, rest)
      | Cuda.Stmt.syncWarp => {
        match WarpMachine.fullWarpActive(warp) returning Attempt with
        | Bool.false => Attempt.fail(Failure.invalidState("__syncwarp requires its default full-warp member mask"), engine)
        | Bool.true => WarpMachine.gateArrive(engine, warpIndex, Nat.add(2000000, warp.id), 32, rest)
      }
      | Cuda.Stmt.instr instruction => WarpMachine.stepInstr(engine, warpIndex, warp, instruction, rest)
      | Cuda.Stmt.error message => Attempt.fail(Failure.unsupported(Text.cat("Cuda.Stmt.error: ", message)), engine)
    }
    def addLoopValues (current: List(Nat))(step: List(Nat))(mask: Nat)(lane: Nat): List(Nat)
        decreases structural(current) := {
      match current returning List(Nat) with
      | List.nil => List.nil(Nat)
      | List.cons value rest => {
        match step returning List(Nat) with
        | List.nil => List.cons(value, WarpMachine.addLoopValues(rest, List.nil(Nat), mask, Nat.succ(lane)))
        | List.cons amount more => {
          let next := Bool.cond(WarpExpr.laneMask(mask, lane), Nat, Nat.add(value, amount), value)
          List.cons(next, WarpMachine.addLoopValues(rest, more, mask, Nat.succ(lane)))
        }
      }
    }
    def normalize (warp: WarpState)(fuel: Nat): WarpState decreases structural(fuel) := {
      match fuel returning WarpState with
      | Nat.zero => warp
      | Nat.succ moreFuel => {
        match warp returning WarpState with
        | WarpState.mk id block frames registers deferredLoads active status => {
          match block returning WarpState with
          | Cuda.Block.seq first rest => {
            match WarpExpr.maskCount(active) returning WarpState with
            | Nat.zero => WarpMachine.normalize(WarpState.mk(id, Cuda.Block.done, frames, registers, deferredLoads, active, status), moreFuel)
            | Nat.succ someLanes => WarpState.mk(id, block, frames, registers, deferredLoads, active, WarpStatus.runnable)
          }
          | Cuda.Block.done => {
            match frames returning WarpState with
            | FrameStack.nil => WarpState.mk(id, Cuda.Block.done, FrameStack.nil, registers, deferredLoads, active, WarpStatus.finished)
            | FrameStack.cons frame more => {
              match frame returning WarpState with
              | Frame.branchNo no rest parent noMask => {
                match WarpExpr.maskCount(noMask) returning WarpState with
                | Nat.zero => WarpMachine.normalize(WarpState.mk(id, rest, more, registers, deferredLoads, parent, WarpStatus.runnable), moreFuel)
                | Nat.succ someLanes => {
                  let joined := FrameStack.cons(Frame.branchJoin(rest, parent), more)
                  WarpMachine.normalize(WarpState.mk(id, no, joined, registers, deferredLoads, noMask, WarpStatus.runnable), moreFuel)
                }
              }
              | Frame.branchJoin rest parent =>
                WarpMachine.normalize(WarpState.mk(id, rest, more, registers, deferredLoads, parent, WarpStatus.runnable), moreFuel)
              | Frame.scoped rest parent =>
                WarpMachine.normalize(WarpState.mk(id, rest, more, registers, deferredLoads, parent, WarpStatus.runnable), moreFuel)
              | Frame.loop loopId stop step body rest parent iterationMask => {
                match WarpExpr.findRegister(registers, loopId) returning WarpState with
                | Option.none => WarpState.mk(id, Cuda.Block.done, frames, registers, deferredLoads, active, WarpStatus.blocked)
                | Option.some register => {
                  match register returning WarpState with
                  | WarpExpr.Register.mk got values initialized => {
                    let nextValues := WarpMachine.addLoopValues(values, step, iterationMask, 0)
                    let nextRegisters := WarpExpr.writeMasked(registers, loopId, nextValues, iterationMask)
                    let nextMask := WarpMachine.loopMask(nextValues, stop, parent, 0)
                    match WarpExpr.maskCount(nextMask) returning WarpState with
                    | Nat.zero => WarpMachine.normalize(WarpState.mk(id, rest, more, nextRegisters, deferredLoads, parent, WarpStatus.runnable), moreFuel)
                    | Nat.succ someCount => {
                      let again := FrameStack.cons(Frame.loop(loopId, stop, step, body, rest, parent, nextMask), more)
                      WarpState.mk(id, body, again, nextRegisters, deferredLoads, nextMask, WarpStatus.runnable)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    def stepWarp (engine: Engine)(warpIndex: Nat): Attempt := {
      match WarpMachine.engineWarp(engine, warpIndex) returning Attempt with
      | Option.none => Attempt.fail(Failure.invalidState("scheduler selected a missing warp"), engine)
      | Option.some original => {
        let warp := WarpMachine.normalize(original, 96)
        let normalizedEngine := WarpMachine.engineReplaceWarp(engine, warpIndex, warp)
        match warp returning Attempt with
        | WarpState.mk id block frames registers deferredLoads active status => {
          match status returning Attempt with
          | WarpStatus.finished => Attempt.progress(normalizedEngine)
          | WarpStatus.runnable => {
            match block returning Attempt with
            | Cuda.Block.done => Attempt.progress(normalizedEngine)
            | Cuda.Block.seq statement rest => WarpMachine.stepStmt(normalizedEngine, warpIndex, warp, statement, rest)
          }
          | _ => Attempt.waiting(normalizedEngine)
        }
      }
    }
    def runLoop (engine: Engine)(fuel: Nat): MachineResult decreases structural(fuel) := {
      let awake := WarpMachine.wakeAll(engine, 0, 8)
      match WarpMachine.allFinished(WarpMachine.warpsOf(awake)) returning MachineResult with
      | Bool.true => {
        match WarpMachine.eventCount(WarpMachine.eventsOf(awake)) returning MachineResult with
        | Nat.zero => WarpMachine.finalResult(awake)
        | Nat.succ pending => {
          match fuel returning MachineResult with
          | Nat.zero => MachineResult.failed(Failure.fuelExhausted, WarpMachine.statsOfEngine(awake))
          | Nat.succ moreFuel => {
            match WarpMachine.retireHead(awake) returning MachineResult with
            | Attempt.progress changed => WarpMachine.runLoop(changed, moreFuel)
            | Attempt.waiting changed => MachineResult.failed(Failure.deadlocked, WarpMachine.statsOfEngine(changed))
            | Attempt.fail problem changed => MachineResult.failed(problem, WarpMachine.statsOfEngine(changed))
          }
        }
      }
      | Bool.false => {
        match fuel returning MachineResult with
        | Nat.zero => MachineResult.failed(Failure.fuelExhausted, WarpMachine.statsOfEngine(awake))
        | Nat.succ moreFuel => {
          match awake returning MachineResult with
          | Engine.mk kernel inputs storage warps barriers gates events cursor idle counts => {
            match WarpMachine.findRunnable(warps, cursor, 8) returning MachineResult with
            | Option.some index => {
              let nextCursor := Nat.mod(Nat.succ(index), 8)
              match WarpMachine.stepWarp(awake, index) returning MachineResult with
              | Attempt.progress changed => WarpMachine.runLoop(WarpMachine.engineWithCursor(changed, nextCursor, 0), moreFuel)
              | Attempt.waiting changed => WarpMachine.runLoop(WarpMachine.engineWithCursor(changed, nextCursor, Nat.succ(idle)), moreFuel)
              | Attempt.fail problem changed => MachineResult.failed(problem, WarpMachine.statsOfEngine(changed))
            }
            | Option.none => {
              match WarpMachine.eventCount(events) returning MachineResult with
              | Nat.zero => MachineResult.failed(Failure.deadlocked, counts)
              | Nat.succ pending => {
                match WarpMachine.retireHead(awake) returning MachineResult with
                | Attempt.progress changed => WarpMachine.runLoop(WarpMachine.engineWithCursor(changed, cursor, 0), moreFuel)
                | Attempt.waiting changed => MachineResult.failed(Failure.deadlocked, WarpMachine.statsOfEngine(changed))
                | Attempt.fail problem changed => MachineResult.failed(problem, WarpMachine.statsOfEngine(changed))
              }
            }
          }
        }
      }
    }
    def run (kernel: Cuda.Kernel)(inputs: TinyDevice.Inputs)(fuel: Nat): MachineResult := {
      match kernel returning MachineResult with
      | Cuda.Kernel.mk name params dynamicShared body launcher => {
        match TinyDevice.beginRun(inputs, dynamicShared) returning MachineResult with
        | Option.none => MachineResult.failed(Failure.invalidState("dynamic shared extent does not match checked inputs"), Stats.zero)
        | Option.some storage => {
          let warps := WarpMachine.makeWarps(body, 0, 8)
          let engine := Engine.mk(kernel, inputs, storage, warps, List.nil(Barrier), List.nil(SyncGate),
            List.nil(PendingEvent), 0, 0, Stats.zero)
          WarpMachine.runLoop(engine, fuel)
        }
      }
    }
}
}
