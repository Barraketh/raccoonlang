// Event-aware finite scheduler for the supported CUDA-library subset.  It consumes one
// actual-AST trace per runnable warp or one FIFO event per recursive scheduler step.

import Cuda
import evaluator.BufferControl
import evaluator.BufferData
import evaluator.BufferGpuDecode
import evaluator.BufferKernels
import evaluator.BufferPlan
import evaluator.DeviceApi
import evaluator.WarpMachine

namespace Evaluator {
  namespace BufferGpuEventSchedule {
    struct WorkLists : Type
     | mk (warp0: List(BufferControl.Trace))(warp1: List(BufferControl.Trace))
          (warp2: List(BufferControl.Trace))(warp3: List(BufferControl.Trace))
          (warp4: List(BufferControl.Trace))(warp5: List(BufferControl.Trace))
          (warp6: List(BufferControl.Trace))(warp7: List(BufferControl.Trace)) : WorkLists

    inductive BlockKind : Type
     | gate (id: Nat) : BlockKind
     | mbar (address: Nat)(parity: Nat) : BlockKind
     | bulk (pending: Nat) : BlockKind
     | tmem : BlockKind

    struct Blocked : Type
     | mk (warp: Nat)(kind: BlockKind)(activeMask: Nat) : Blocked

    inductive Event : Type
     | data (warp: Nat)(request: DeviceApi.DataRequest)(barrier: Option(Nat))(phase: Nat)
         (committed: Bool)(snapshotOrdinal: Nat) : Event
     | tcCommit (warp: Nat)(barrier: Nat)(phase: Nat) : Event

    struct Tile : Type
     | mk (x: Nat)(y: Nat) : Tile

    // Protocol metadata is separate from the action stream. It contains no input or device-buffer values.
    struct Protocol : Type
     | mk (barriers: List(WarpMachine.Barrier))(gates: List(WarpMachine.SyncGate))
          (blocked: List(Blocked))(finishedMask: Nat)(tmemLive: Bool)(tmemAddress: Nat)
          (tmemColumns: Nat)(tmemInitialized: Bool)(deferredLoads: List(Nat)) : Protocol

    struct State : Type
     | mk (protocol: Protocol)(events: List(Event))(cursor: Nat)(stats: WarpMachine.Stats)
          (supply: BufferKernels.SlotSupply)(actionsReversed: List(BufferData.Action))
          (tiles: List(Tile)) : State

    inductive CompileResult : Type
     | compiled (actions: List(BufferData.Action))(supply: BufferKernels.SlotSupply)
         (stats: WarpMachine.Stats) : CompileResult
     | rejected (code: Nat) : CompileResult

    inductive SchedulerResult : Type
     | finished (state: State) : SchedulerResult
     | rejected (code: Nat)(state: State) : SchedulerResult
     | deadlocked (state: State) : SchedulerResult

    inductive ScanResult : Type
     | selected (warp: Nat)(trace: BufferControl.Trace)(op: BufferGpuDecode.Op)
         (state: State) : ScanResult
     | exhausted (state: State) : ScanResult
     | invalid (code: Nat)(state: State) : ScanResult

    inductive OpResult : Type
     | advanced (state: State) : OpResult
     | invalid (code: Nat)(state: State) : OpResult

    inductive FragmentResult : Type
     | emitted (actions: List(BufferData.Action))(supply: BufferKernels.SlotSupply) : FragmentResult
     | invalid : FragmentResult

    inductive CompletionResult : Type
     | advanced (state: State) : CompletionResult
     | rejected (code: Nat) : CompletionResult
     | deadlocked (state: State) : CompletionResult

    def badProtocol : Nat := 7300
    def badDeviceRequest : Nat := 7301
    def notQuiescent : Nat := 7302
    def incompleteOutput : Nat := 7303
    def deadlockCode : Nat := 7304

    def tracesForWarp (warp: Nat)(traces: List(BufferControl.Trace))
        : List(BufferControl.Trace) decreases structural(traces) := {
      match traces returning List(BufferControl.Trace) with
      | List.nil => List.nil(BufferControl.Trace)
      | List.cons trace rest => {
        match trace returning List(BufferControl.Trace) with
        | BufferControl.Trace.mk owner mask registers postRegisters statement snapshot => {
          let tail := BufferGpuEventSchedule.tracesForWarp(warp, rest)
          Bool.cond(Nat.beq(owner, warp), List(BufferControl.Trace), List.cons(trace, tail), tail)
        }
      }
    }

    def workLists (tracesReversed: List(BufferControl.Trace)): WorkLists := {
      let all := List.reverse(tracesReversed)
      WorkLists.mk(BufferGpuEventSchedule.tracesForWarp(0, all), BufferGpuEventSchedule.tracesForWarp(1, all),
        BufferGpuEventSchedule.tracesForWarp(2, all), BufferGpuEventSchedule.tracesForWarp(3, all),
        BufferGpuEventSchedule.tracesForWarp(4, all), BufferGpuEventSchedule.tracesForWarp(5, all),
        BufferGpuEventSchedule.tracesForWarp(6, all), BufferGpuEventSchedule.tracesForWarp(7, all))
    }

    def workAt (work: WorkLists)(index: Nat): List(BufferControl.Trace) := {
      match work returning List(BufferControl.Trace) with
      | WorkLists.mk warp0 warp1 warp2 warp3 warp4 warp5 warp6 warp7 => {
        match Nat.beq(index, 0) returning List(BufferControl.Trace) with
        | Bool.true => warp0
        | Bool.false => {
          match Nat.beq(index, 1) returning List(BufferControl.Trace) with
          | Bool.true => warp1
          | Bool.false => {
            match Nat.beq(index, 2) returning List(BufferControl.Trace) with
            | Bool.true => warp2
            | Bool.false => {
              match Nat.beq(index, 3) returning List(BufferControl.Trace) with
              | Bool.true => warp3
              | Bool.false => {
                match Nat.beq(index, 4) returning List(BufferControl.Trace) with
                | Bool.true => warp4
                | Bool.false => {
                  match Nat.beq(index, 5) returning List(BufferControl.Trace) with
                  | Bool.true => warp5
                  | Bool.false => {
                    match Nat.beq(index, 6) returning List(BufferControl.Trace) with
                    | Bool.true => warp6
                    | Bool.false => warp7
                  }
                }
              }
            }
          }
        }
      }
    }

    def workListEmpty (work: List(BufferControl.Trace)): Bool := {
      match work returning Bool with
      | List.nil => Bool.true
      | List.cons first rest => Bool.false
    }

    def workListsEmpty (work: WorkLists): Bool := {
      match work returning Bool with
      | WorkLists.mk warp0 warp1 warp2 warp3 warp4 warp5 warp6 warp7 =>
          Bool.and(BufferGpuEventSchedule.workListEmpty(warp0),
            Bool.and(BufferGpuEventSchedule.workListEmpty(warp1),
              Bool.and(BufferGpuEventSchedule.workListEmpty(warp2),
                Bool.and(BufferGpuEventSchedule.workListEmpty(warp3),
                  Bool.and(BufferGpuEventSchedule.workListEmpty(warp4),
                    Bool.and(BufferGpuEventSchedule.workListEmpty(warp5),
                      Bool.and(BufferGpuEventSchedule.workListEmpty(warp6),
                        BufferGpuEventSchedule.workListEmpty(warp7))))))))
    }

    def initialState : State := State.mk(
      Protocol.mk(List.nil(WarpMachine.Barrier), List.nil(WarpMachine.SyncGate), List.nil(Blocked),
        0, Bool.false, 0, 0, Bool.false, List.cons(0, List.cons(0, List.cons(0, List.cons(0,
          List.cons(0, List.cons(0, List.cons(0, List.cons(0, List.nil(Nat)))))))))),
      List.nil(Event), 0, WarpMachine.Stats.zero, BufferKernels.initialSupply,
      List.nil(BufferData.Action), List.nil(Tile))

    def protocolOf (state: State): Protocol := {
      match state returning Protocol with
      | State.mk protocol events cursor stats supply actions tiles => protocol
    }

    def eventsOf (state: State): List(Event) := {
      match state returning List(Event) with
      | State.mk protocol events cursor stats supply actions tiles => events
    }

    def cursorOf (state: State): Nat := {
      match state returning Nat with
      | State.mk protocol events cursor stats supply actions tiles => cursor
    }

    def statsOf (state: State): WarpMachine.Stats := {
      match state returning WarpMachine.Stats with
      | State.mk protocol events cursor stats supply actions tiles => stats
    }

    def supplyOf (state: State): BufferKernels.SlotSupply := {
      match state returning BufferKernels.SlotSupply with
      | State.mk protocol events cursor stats supply actions tiles => supply
    }

    def actionsReversedOf (state: State): List(BufferData.Action) := {
      match state returning List(BufferData.Action) with
      | State.mk protocol events cursor stats supply actions tiles => actions
    }

    def tilesOf (state: State): List(Tile) := {
      match state returning List(Tile) with
      | State.mk protocol events cursor stats supply actions tiles => tiles
    }

    def replaceProtocol (state: State)(protocol: Protocol): State := {
      match state returning State with
      | State.mk old events cursor stats supply actions tiles => State.mk(protocol, events, cursor, stats, supply, actions, tiles)
    }

    def replaceEvents (state: State)(events: List(Event)): State := {
      match state returning State with
      | State.mk protocol old cursor stats supply actions tiles => State.mk(protocol, events, cursor, stats, supply, actions, tiles)
    }

    def replaceCursor (state: State)(cursor: Nat): State := {
      match state returning State with
      | State.mk protocol events old stats supply actions tiles => State.mk(protocol, events, cursor, stats, supply, actions, tiles)
    }

    def replaceStats (state: State)(stats: WarpMachine.Stats): State := {
      match state returning State with
      | State.mk protocol events cursor old supply actions tiles => State.mk(protocol, events, cursor, stats, supply, actions, tiles)
    }

    def replaceProgram (state: State)(supply: BufferKernels.SlotSupply)
        (actionsReversed: List(BufferData.Action)): State := {
      match state returning State with
      | State.mk protocol events cursor stats oldSupply oldActions tiles =>
          State.mk(protocol, events, cursor, stats, supply, actionsReversed, tiles)
    }

    def replaceTiles (state: State)(tiles: List(Tile)): State := {
      match state returning State with
      | State.mk protocol events cursor stats supply actions old => State.mk(protocol, events, cursor, stats, supply, actions, tiles)
    }

    def withBarriers (protocol: Protocol)(barriers: List(WarpMachine.Barrier)): Protocol := {
      match protocol returning Protocol with
      | Protocol.mk old gates blocked finished tmemLive tmemAddress tmemColumns initialized deferred =>
          Protocol.mk(barriers, gates, blocked, finished, tmemLive, tmemAddress, tmemColumns, initialized, deferred)
    }

    def withGates (protocol: Protocol)(gates: List(WarpMachine.SyncGate)): Protocol := {
      match protocol returning Protocol with
      | Protocol.mk barriers old blocked finished tmemLive tmemAddress tmemColumns initialized deferred =>
          Protocol.mk(barriers, gates, blocked, finished, tmemLive, tmemAddress, tmemColumns, initialized, deferred)
    }

    def withBlocked (protocol: Protocol)(blocked: List(Blocked)): Protocol := {
      match protocol returning Protocol with
      | Protocol.mk barriers gates old finished tmemLive tmemAddress tmemColumns initialized deferred =>
          Protocol.mk(barriers, gates, blocked, finished, tmemLive, tmemAddress, tmemColumns, initialized, deferred)
    }

    def withFinished (protocol: Protocol)(finished: Nat): Protocol := {
      match protocol returning Protocol with
      | Protocol.mk barriers gates blocked old tmemLive tmemAddress tmemColumns initialized deferred =>
          Protocol.mk(barriers, gates, blocked, finished, tmemLive, tmemAddress, tmemColumns, initialized, deferred)
    }

    def withTmem (protocol: Protocol)(live: Bool)(address: Nat)(columns: Nat): Protocol := {
      match protocol returning Protocol with
      | Protocol.mk barriers gates blocked finished old oldAddress oldColumns oldInitialized deferred =>
          Protocol.mk(barriers, gates, blocked, finished, live, address, columns, Bool.false, deferred)
    }

    def withDeferred (protocol: Protocol)(deferred: List(Nat)): Protocol := {
      match protocol returning Protocol with
      | Protocol.mk barriers gates blocked finished live address columns initialized old =>
          Protocol.mk(barriers, gates, blocked, finished, live, address, columns, initialized, deferred)
    }

    def withTmemInitialized (protocol: Protocol)(initialized: Bool): Protocol := {
      match protocol returning Protocol with
      | Protocol.mk barriers gates blocked finished live address columns oldInitialized deferred =>
          Protocol.mk(barriers, gates, blocked, finished, live, address, columns, initialized, deferred)
    }

    def finishedMask (protocol: Protocol): Nat := {
      match protocol returning Nat with
      | Protocol.mk barriers gates blocked finished tmemLive address columns initialized deferred => finished
    }

    def tmemIsLive (protocol: Protocol): Bool := {
      match protocol returning Bool with
      | Protocol.mk barriers gates blocked finished live address columns initialized deferred => live
    }

    def tmemAddress (protocol: Protocol): Nat := {
      match protocol returning Nat with
      | Protocol.mk barriers gates blocked finished live address columns initialized deferred => address
    }

    def tmemColumns (protocol: Protocol): Nat := {
      match protocol returning Nat with
      | Protocol.mk barriers gates blocked finished live address columns initialized deferred => columns
    }

    def tmemIsInitialized (protocol: Protocol): Bool := {
      match protocol returning Bool with
      | Protocol.mk barriers gates blocked finished live address columns initialized deferred => initialized
    }

    def deferredLoads (protocol: Protocol): List(Nat) := {
      match protocol returning List(Nat) with
      | Protocol.mk barriers gates blocked finished live address columns initialized deferred => deferred
    }

    def bumpStats (state: State)(steps: Nat)(events: Nat)(bytes: Nat)(muls: Nat)(adds: Nat)
        (mmas: Nat)(loads: Nat)(stores: Nat): State := {
      match state returning State with
      | State.mk protocol queued cursor old supply actions tiles => {
        match old returning State with
        | WarpMachine.Stats.mk oldSteps oldEvents oldBytes oldMuls oldAdds oldMmas oldLoads oldStores =>
            State.mk(protocol, queued, cursor,
              WarpMachine.Stats.mk(Nat.add(oldSteps, steps), Nat.add(oldEvents, events), Nat.add(oldBytes, bytes),
                Nat.add(oldMuls, muls), Nat.add(oldAdds, adds), Nat.add(oldMmas, mmas),
                Nat.add(oldLoads, loads), Nat.add(oldStores, stores)), supply, actions, tiles)
      }
    }

    def appendEvents (events: List(Event))(event: Event): List(Event) decreases structural(events) := {
      match events returning List(Event) with
      | List.nil => List.cons(event, List.nil(Event))
      | List.cons first rest => List.cons(first, BufferGpuEventSchedule.appendEvents(rest, event))
    }

    def findBarrier (barriers: List(WarpMachine.Barrier))(address: Nat)
        : Option(WarpMachine.Barrier) := WarpMachine.findBarrier(barriers, address)

    def setBarrier (barriers: List(WarpMachine.Barrier))(barrier: WarpMachine.Barrier)
        : List(WarpMachine.Barrier) := WarpMachine.setBarrier(barriers, barrier)

    def barrierList (protocol: Protocol): List(WarpMachine.Barrier) := {
      match protocol returning List(WarpMachine.Barrier) with
      | Protocol.mk barriers gates blocked finished live address columns initialized deferred => barriers
    }

    def gateList (protocol: Protocol): List(WarpMachine.SyncGate) := {
      match protocol returning List(WarpMachine.SyncGate) with
      | Protocol.mk barriers gates blocked finished live address columns initialized deferred => gates
    }

    def blockedList (protocol: Protocol): List(Blocked) := {
      match protocol returning List(Blocked) with
      | Protocol.mk barriers gates blocked finished live address columns initialized deferred => blocked
    }

    def findBlocked (blocked: List(Blocked))(warp: Nat): Option(Blocked) decreases structural(blocked) := {
      match blocked returning Option(Blocked) with
      | List.nil => Option.none(Blocked)
      | List.cons value rest => {
        match value returning Option(Blocked) with
        | Blocked.mk got kind mask =>
          Bool.cond(Nat.beq(got, warp), Option(Blocked), Option.some(value),
            BufferGpuEventSchedule.findBlocked(rest, warp))
      }
    }

    def removeBlocked (blocked: List(Blocked))(warp: Nat): List(Blocked) decreases structural(blocked) := {
      match blocked returning List(Blocked) with
      | List.nil => List.nil(Blocked)
      | List.cons value rest => {
        match value returning List(Blocked) with
        | Blocked.mk got kind mask =>
          Bool.cond(Nat.beq(got, warp), List(Blocked), rest,
            List.cons(value, BufferGpuEventSchedule.removeBlocked(rest, warp)))
      }
    }

    def blockedFor (protocol: Protocol)(warp: Nat): Option(Blocked) :=
      BufferGpuEventSchedule.findBlocked(BufferGpuEventSchedule.blockedList(protocol), warp)

    def maskCount (mask: Nat)(lane: Nat)(remaining: Nat)(sum: Nat): Nat decreases structural(remaining) := {
      match remaining returning Nat with
      | Nat.zero => sum
      | Nat.succ rest => {
        let present := BufferPlan.maskHas(mask, lane)
        BufferGpuEventSchedule.maskCount(mask, Nat.succ(lane), rest,
          Nat.add(sum, Bool.cond(present, Nat, 1, 0)))
      }
    }

    def appendEventState (state: State)(event: Event): State :=
      BufferGpuEventSchedule.replaceEvents(state,
        BufferGpuEventSchedule.appendEvents(BufferGpuEventSchedule.eventsOf(state), event))

    def pushRawActions (state: State)(actions: List(BufferData.Action)): State :=
      BufferGpuEventSchedule.replaceProgram(state, BufferGpuEventSchedule.supplyOf(state),
        List.append(List.reverse(actions), BufferGpuEventSchedule.actionsReversedOf(state)))

    def addFinished (protocol: Protocol)(warp: Nat): Protocol := {
      let old := BufferGpuEventSchedule.finishedMask(protocol)
      let bit := Nat.pow(2, warp)
      let fresh := Bool.not(BufferPlan.maskHas(old, warp))
      BufferGpuEventSchedule.withFinished(protocol,
        Nat.add(old, Bool.cond(fresh, Nat, bit, 0)))
    }

    def isFinished (protocol: Protocol)(warp: Nat): Bool :=
      BufferPlan.maskHas(BufferGpuEventSchedule.finishedMask(protocol), warp)

    def natAt (values: List(Nat))(index: Nat): Option(Nat) decreases structural(values) := {
      match values returning Option(Nat) with
      | List.nil => Option.none(Nat)
      | List.cons value rest => {
        match index returning Option(Nat) with
        | Nat.zero => Option.some(value)
        | Nat.succ more => BufferGpuEventSchedule.natAt(rest, more)
      }
    }

    def replaceNatAt (values: List(Nat))(index: Nat)(nextValue: Nat): Option(List(Nat))
        decreases structural(values) := {
      match values returning Option(List(Nat)) with
      | List.nil => Option.none(List(Nat))
      | List.cons value rest => {
        match index returning Option(List(Nat)) with
        | Nat.zero => Option.some(List.cons(nextValue, rest))
        | Nat.succ more => {
          match BufferGpuEventSchedule.replaceNatAt(rest, more, nextValue) returning Option(List(Nat)) with
          | Option.none => Option.none(List(Nat))
          | Option.some tail => Option.some(List.cons(value, tail))
        }
      }
    }

    def incrementDeferred (protocol: Protocol)(warp: Nat): Option(Protocol) := {
      match BufferGpuEventSchedule.natAt(BufferGpuEventSchedule.deferredLoads(protocol), warp)
          returning Option(Protocol) with
      | Option.none => Option.none(Protocol)
      | Option.some old => {
        match BufferGpuEventSchedule.replaceNatAt(BufferGpuEventSchedule.deferredLoads(protocol), warp,
            Nat.succ(old)) returning Option(Protocol) with
        | Option.none => Option.none(Protocol)
        | Option.some changed => Option.some(BufferGpuEventSchedule.withDeferred(protocol, changed))
      }
    }

    def clearDeferred (protocol: Protocol)(warp: Nat): Option(Protocol) :=
      match BufferGpuEventSchedule.replaceNatAt(BufferGpuEventSchedule.deferredLoads(protocol), warp, 0)
          returning Option(Protocol) with
      | Option.none => Option.none(Protocol)
      | Option.some changed => Option.some(BufferGpuEventSchedule.withDeferred(protocol, changed))

    def deferredEmpty (values: List(Nat)): Bool decreases structural(values) := {
      match values returning Bool with
      | List.nil => Bool.true
      | List.cons value rest => Bool.and(Nat.isZero(value), BufferGpuEventSchedule.deferredEmpty(rest))
    }

    def eventUsesBarrier (events: List(Event))(address: Nat): Bool decreases structural(events) := {
      match events returning Bool with
      | List.nil => Bool.false
      | List.cons event rest => {
        let here := {
          match event returning Bool with
          | Event.data warp request barrier phase committed ordinal => {
            match barrier returning Bool with
            | Option.none => Bool.false
            | Option.some got => Nat.beq(got, address)
          }
          | Event.tcCommit warp got phase => Nat.beq(got, address)
        }
        Bool.or(here, BufferGpuEventSchedule.eventUsesBarrier(rest, address))
      }
    }

    def pendingTmemLoads (events: List(Event))(warp: Nat): Nat decreases structural(events) := {
      match events returning Nat with
      | List.nil => 0
      | List.cons event rest => {
        let tail := BufferGpuEventSchedule.pendingTmemLoads(rest, warp)
        match event returning Nat with
        | Event.data owner request barrier phase committed ordinal =>
          Nat.add(tail, Bool.cond(Bool.and(Nat.beq(owner, warp), WarpMachine.requestIsTmemLoad(request)), Nat, 1, 0))
        | Event.tcCommit owner address phase => tail
      }
    }

    def storeEventsForWarp (events: List(Event))(warp: Nat): Nat decreases structural(events) := {
      match events returning Nat with
      | List.nil => 0
      | List.cons event rest => {
        let tail := BufferGpuEventSchedule.storeEventsForWarp(rest, warp)
        match event returning Nat with
        | Event.data owner request barrier phase committed ordinal =>
          Nat.add(tail, Bool.cond(Bool.and(Nat.beq(owner, warp), WarpMachine.requestIsStore(request)), Nat, 1, 0))
        | Event.tcCommit owner address phase => tail
      }
    }

    def commitStoreEvents (events: List(Event))(warp: Nat): List(Event) decreases structural(events) := {
      match events returning List(Event) with
      | List.nil => List.nil(Event)
      | List.cons event rest => {
        match event returning List(Event) with
        | Event.data owner request barrier phase committed ordinal => {
          let next := Bool.cond(Bool.and(Nat.beq(owner, warp), WarpMachine.requestIsStore(request)), Event,
            Event.data(owner, request, barrier, phase, Bool.true, ordinal), event)
          List.cons(next, BufferGpuEventSchedule.commitStoreEvents(rest, warp))
        }
        | Event.tcCommit owner address phase => List.cons(event, BufferGpuEventSchedule.commitStoreEvents(rest, warp))
      }
    }

    def replaceBarrierState (state: State)(barriers: List(WarpMachine.Barrier)): State := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      BufferGpuEventSchedule.replaceProtocol(state, BufferGpuEventSchedule.withBarriers(protocol, barriers))
    }

    def activeMaskOf (trace: BufferControl.Trace): Nat := {
      match trace returning Nat with
      | BufferControl.Trace.mk warp mask registers postRegisters statement snapshot => mask
    }

    def findGate (gates: List(WarpMachine.SyncGate))(id: Nat): Option(WarpMachine.SyncGate) :=
      WarpMachine.findGateAny(gates, id)

    def replaceGateState (state: State)(gates: List(WarpMachine.SyncGate)): State := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      BufferGpuEventSchedule.replaceProtocol(state, BufferGpuEventSchedule.withGates(protocol, gates))
    }

    def mbarReady (protocol: Protocol)(address: Nat)(parity: Nat): Bool := {
      match BufferGpuEventSchedule.findBarrier(BufferGpuEventSchedule.barrierList(protocol), address)
          returning Bool with
      | Option.none => Bool.false
      | Option.some barrier => WarpMachine.barrierWaitReady(barrier, parity)
    }

    def gateReady (protocol: Protocol)(id: Nat): Bool := {
      match BufferGpuEventSchedule.findGate(BufferGpuEventSchedule.gateList(protocol), id) returning Bool with
      | Option.none => Bool.false
      | Option.some gate => {
        match gate returning Bool with
        | WarpMachine.SyncGate.mk got expected arrived remaining released => released
      }
    }

    def blockedReady (state: State)(blocked: Blocked): Bool := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      match blocked returning Bool with
      | Blocked.mk warp kind mask => {
        match kind returning Bool with
        | BlockKind.gate id => BufferGpuEventSchedule.gateReady(protocol, id)
        | BlockKind.mbar address parity => BufferGpuEventSchedule.mbarReady(protocol, address, parity)
        | BlockKind.bulk pending =>
            Nat.ble(BufferGpuEventSchedule.storeEventsForWarp(BufferGpuEventSchedule.eventsOf(state), warp), pending)
        | BlockKind.tmem => Nat.isZero(BufferGpuEventSchedule.pendingTmemLoads(BufferGpuEventSchedule.eventsOf(state), warp))
      }
    }

    def wakeOne (state: State)(warp: Nat): State := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      match BufferGpuEventSchedule.findBlocked(BufferGpuEventSchedule.blockedList(protocol), warp)
          returning State with
      | Option.none => state
      | Option.some value => {
        match BufferGpuEventSchedule.blockedReady(state, value) returning State with
        | Bool.false => state
        | Bool.true => {
          match value returning State with
          | Blocked.mk blockedWarp kind mask => {
            let stillBlocked := {
              match kind returning Bool with
              | BlockKind.gate id => Bool.true
              | _ => Bool.false
            }
            let gates := {
              match kind returning List(WarpMachine.SyncGate) with
              | BlockKind.gate id => {
                match BufferGpuEventSchedule.findGate(BufferGpuEventSchedule.gateList(protocol), id)
                    returning List(WarpMachine.SyncGate) with
                | Option.none => BufferGpuEventSchedule.gateList(protocol)
                | Option.some gate => {
                  match gate returning List(WarpMachine.SyncGate) with
                  | WarpMachine.SyncGate.mk got expected arrived remaining released => {
                    let left := Nat.sub(remaining, BufferGpuEventSchedule.maskCount(mask, 0, 32, 0))
                    let exhausted := Nat.isZero(left)
                    let nextGate := Bool.cond(exhausted, WarpMachine.SyncGate,
                      WarpMachine.SyncGate.mk(got, expected, 0, 0, Bool.false),
                      WarpMachine.SyncGate.mk(got, expected, arrived, left, Bool.true))
                    WarpMachine.setGateById(BufferGpuEventSchedule.gateList(protocol), nextGate)
                  }
                }
              }
              | _ => BufferGpuEventSchedule.gateList(protocol)
            }
            let remainingBlocked := BufferGpuEventSchedule.removeBlocked(BufferGpuEventSchedule.blockedList(protocol), warp)
            let changedProtocol := BufferGpuEventSchedule.withBlocked(
              BufferGpuEventSchedule.withGates(protocol, gates), remainingBlocked)
            let changed := BufferGpuEventSchedule.replaceProtocol(state, changedProtocol)
            Bool.cond(stillBlocked, State, BufferGpuEventSchedule.bumpStats(changed, 1, 0, 0, 0, 0, 0, 0, 0), changed)
          }
        }
      }
    }

    def wakeAll (state: State)(warp: Nat)(remaining: Nat): State decreases structural(remaining) := {
      match remaining returning State with
      | Nat.zero => state
      | Nat.succ rest => {
        let changed := BufferGpuEventSchedule.wakeOne(state, warp)
        BufferGpuEventSchedule.wakeAll(changed, Nat.succ(warp), rest)
      }
    }

    def addBlocked (state: State)(warp: Nat)(kind: BlockKind)(activeMask: Nat): State := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      let changed := BufferGpuEventSchedule.withBlocked(protocol,
        List.cons(Blocked.mk(warp, kind, activeMask), BufferGpuEventSchedule.blockedList(protocol)))
      BufferGpuEventSchedule.replaceProtocol(state, changed)
    }

    def advanceCursor (state: State)(warp: Nat): State :=
      BufferGpuEventSchedule.replaceCursor(state, Nat.mod(Nat.succ(warp), 8))

    def gateArrival (state: State)(warp: Nat)(id: Nat)(expected: Nat)(participants: Nat)
        (activeMask: Nat): Option(State) := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      let gates := BufferGpuEventSchedule.gateList(protocol)
      match Bool.and(Nat.blt(0, expected), Bool.and(Nat.ble(expected, 256), Nat.blt(0, participants)))
          returning Option(State) with
      | Bool.false => Option.none(State)
      | Bool.true => {
        match BufferGpuEventSchedule.findGate(gates, id) returning Option(State) with
        | Option.none => {
          match WarpMachine.addGateArrival(WarpMachine.SyncGate.mk(id, expected, 0, 0, Bool.false), participants)
              returning Option(State) with
          | Option.none => Option.none(State)
          | Option.some changedGate => {
            let nextGates := WarpMachine.setGateById(gates, changedGate)
            let next := BufferGpuEventSchedule.replaceGateState(state, nextGates)
            Option.some(BufferGpuEventSchedule.addBlocked(next, warp, BlockKind.gate(id), activeMask))
          }
        }
        | Option.some oldGate => {
          match oldGate returning Option(State) with
          | WarpMachine.SyncGate.mk got oldExpected arrived remaining released => {
            match Nat.beq(oldExpected, expected) returning Option(State) with
            | Bool.false => Option.none(State)
            | Bool.true => {
              match WarpMachine.addGateArrival(oldGate, participants) returning Option(State) with
              | Option.none => Option.none(State)
              | Option.some changedGate => {
                let nextGates := WarpMachine.setGateById(gates, changedGate)
                let next := BufferGpuEventSchedule.replaceGateState(state, nextGates)
                Option.some(BufferGpuEventSchedule.addBlocked(next, warp, BlockKind.gate(id), activeMask))
              }
            }
          }
        }
      }
    }

    def waitKind (op: BufferGpuDecode.Op): Option(BlockKind) := {
      match op returning Option(BlockKind) with
      | BufferGpuDecode.Op.mbarWait address parity => Option.some(BlockKind.mbar(address, parity))
      | BufferGpuDecode.Op.bulkWait pending => Option.some(BlockKind.bulk(pending))
      | BufferGpuDecode.Op.tmemWait => Option.some(BlockKind.tmem)
      | _ => Option.none(BlockKind)
    }

    def waitReady (state: State)(warp: Nat)(kind: BlockKind): Bool := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      match kind returning Bool with
      | BlockKind.gate id => BufferGpuEventSchedule.gateReady(protocol, id)
      | BlockKind.mbar address parity => BufferGpuEventSchedule.mbarReady(protocol, address, parity)
      | BlockKind.bulk pending =>
          Nat.ble(BufferGpuEventSchedule.storeEventsForWarp(BufferGpuEventSchedule.eventsOf(state), warp), pending)
      | BlockKind.tmem => Nat.isZero(BufferGpuEventSchedule.pendingTmemLoads(BufferGpuEventSchedule.eventsOf(state), warp))
    }

    def waitValid (state: State)(kind: BlockKind): Bool := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      match kind returning Bool with
      | BlockKind.mbar address parity => Bool.and(Nat.ble(parity, 1), {
        match BufferGpuEventSchedule.findBarrier(BufferGpuEventSchedule.barrierList(protocol), address)
            returning Bool with
        | Option.none => Bool.false
        | Option.some barrier => Bool.true
      })
      | _ => Bool.true
    }

    def scan (kernel: Cuda.Kernel)(work: WorkLists)(state: State)(candidate: Nat)(remaining: Nat)
        : ScanResult decreases structural(remaining) := {
      match remaining returning ScanResult with
      | Nat.zero => ScanResult.exhausted(state)
      | Nat.succ rest => {
        let warp := Nat.mod(candidate, 8)
        let protocol := BufferGpuEventSchedule.protocolOf(state)
        match BufferGpuEventSchedule.isFinished(protocol, warp) returning ScanResult with
        | Bool.true => BufferGpuEventSchedule.scan(kernel, work, state, Nat.succ(warp), rest)
        | Bool.false => {
          match BufferGpuEventSchedule.blockedFor(protocol, warp) returning ScanResult with
          | Option.some blocked => BufferGpuEventSchedule.scan(kernel, work, state, Nat.succ(warp), rest)
          | Option.none => {
            match BufferGpuEventSchedule.workAt(work, warp) returning ScanResult with
            | List.nil => {
              let changedProtocol := BufferGpuEventSchedule.addFinished(protocol, warp)
              let changed := BufferGpuEventSchedule.replaceProtocol(state, changedProtocol)
              let cursorChanged := BufferGpuEventSchedule.replaceCursor(changed, Nat.mod(Nat.succ(warp), 8))
              BufferGpuEventSchedule.scan(kernel, work, cursorChanged, Nat.succ(warp), rest)
            }
            | List.cons trace tail => {
              match BufferGpuDecode.decode(kernel, trace) returning ScanResult with
              | BufferGpuDecode.DecodeResult.rejected code => ScanResult.invalid(code, state)
              | BufferGpuDecode.DecodeResult.decoded op => {
                match BufferGpuEventSchedule.waitKind(op) returning ScanResult with
                | Option.none => ScanResult.selected(warp, trace, op, state)
                | Option.some kind => {
                  match BufferGpuEventSchedule.waitValid(state, kind) returning ScanResult with
                  | Bool.false => ScanResult.invalid(BufferGpuEventSchedule.badProtocol, state)
                  | Bool.true => {
                    match BufferGpuEventSchedule.waitReady(state, warp, kind) returning ScanResult with
                    | Bool.true => ScanResult.selected(warp, trace, op, state)
                    | Bool.false => {
                      let blocked := BufferGpuEventSchedule.addBlocked(state, warp, kind,
                        BufferGpuEventSchedule.activeMaskOf(trace))
                      let cursorChanged := BufferGpuEventSchedule.advanceCursor(blocked, warp)
                      BufferGpuEventSchedule.scan(kernel, work, cursorChanged, Nat.succ(warp), rest)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

    def requestTransferBytes (request: DeviceApi.DataRequest): Nat := {
      match request returning Nat with
      | DeviceApi.DataRequest.tmaLoad map dstByte x y => {
        match map returning Nat with
        | DeviceApi.ResolvedMap.mk encoding rows cols => {
          match encoding returning Nat with
          | Cuda.MapEncoding.mk name use source rowsName colsName inner outer => Nat.mul(Nat.mul(inner, outer), 2)
        }
      }
      | DeviceApi.DataRequest.tmaStore map x y srcByte => {
        match map returning Nat with
        | DeviceApi.ResolvedMap.mk encoding rows cols => {
          match encoding returning Nat with
          | Cuda.MapEncoding.mk name use source rowsName colsName inner outer => Nat.mul(Nat.mul(inner, outer), 4)
        }
      }
      | _ => 0
    }

    def mmaAccumulate (request: DeviceApi.DataRequest): Nat := {
      match request returning Nat with
      | DeviceApi.DataRequest.mma desc => {
        match desc returning Nat with
        | DeviceApi.MmaDesc.mk group accumulator a b idesc accumulate => accumulate
      }
      | _ => 0
    }

    def eventBytesReady (state: State)(barrier: Option(Nat))(phase: Nat)(bytes: Nat): Option(State) := {
      match barrier returning Option(State) with
      | Option.none => Option.some(state)
      | Option.some address => {
        match BufferGpuEventSchedule.findBarrier(BufferGpuEventSchedule.barrierList(
            BufferGpuEventSchedule.protocolOf(state)), address) returning Option(State) with
        | Option.none => Option.none(State)
        | Option.some current => {
          match Nat.beq(WarpMachine.barrierPhase(current), phase) returning Option(State) with
          | Bool.false => Option.none(State)
          | Bool.true => {
            match WarpMachine.barrierAfterBytes(current, bytes) returning Option(State) with
            | Option.none => Option.none(State)
            | Option.some changed => Option.some(BufferGpuEventSchedule.replaceBarrierState(state,
                WarpMachine.setBarrier(BufferGpuEventSchedule.barrierList(BufferGpuEventSchedule.protocolOf(state)), changed)))
          }
        }
      }
    }

    def convertFragment (fragment: BufferKernels.FragmentResult): FragmentResult := {
      match fragment returning FragmentResult with
      | BufferKernels.FragmentResult.unsupported reason => FragmentResult.invalid
      | BufferKernels.FragmentResult.emitted value => {
        match value returning FragmentResult with
        | BufferKernels.Fragment.mk actions supply => FragmentResult.emitted(actions, supply)
      }
    }

    def appendFragmentActions (state: State)(actions: List(BufferData.Action))
        (supply: BufferKernels.SlotSupply): State :=
      BufferGpuEventSchedule.replaceProgram(state, supply,
        List.append(List.reverse(actions), BufferGpuEventSchedule.actionsReversedOf(state)))

    def addTile (tiles: List(Tile))(tile: Tile): List(Tile) := List.cons(tile, tiles)

    def eventFragment (state: State)(request: DeviceApi.DataRequest)(ordinal: Nat): FragmentResult := {
      match request returning FragmentResult with
      | DeviceApi.DataRequest.tmaLoad map dstByte x y =>
          BufferGpuEventSchedule.convertFragment(BufferKernels.tmaLoad(BufferGpuEventSchedule.supplyOf(state), request))
      | DeviceApi.DataRequest.mma desc => {
        match BufferGpuEventSchedule.tmemIsLive(BufferGpuEventSchedule.protocolOf(state)) returning FragmentResult with
        | Bool.false => FragmentResult.invalid
        | Bool.true => {
          match BufferGpuEventSchedule.mmaAccumulate(request) returning FragmentResult with
          | Nat.zero => BufferGpuEventSchedule.convertFragment(BufferKernels.mma(BufferGpuEventSchedule.supplyOf(state), desc))
          | Nat.succ more => Bool.cond(BufferGpuEventSchedule.tmemIsInitialized(BufferGpuEventSchedule.protocolOf(state)),
              FragmentResult, BufferGpuEventSchedule.convertFragment(BufferKernels.mma(BufferGpuEventSchedule.supplyOf(state), desc)),
              FragmentResult.invalid)
        }
      }
      | DeviceApi.DataRequest.tmemLoad shape ids base group mask => {
        match Bool.and(BufferGpuEventSchedule.tmemIsLive(BufferGpuEventSchedule.protocolOf(state)),
            BufferGpuEventSchedule.tmemIsInitialized(BufferGpuEventSchedule.protocolOf(state))) returning FragmentResult with
        | Bool.false => FragmentResult.invalid
        | Bool.true => BufferGpuEventSchedule.convertFragment(
            BufferKernels.tmemLoad(BufferGpuEventSchedule.supplyOf(state), request, ordinal))
      }
      | DeviceApi.DataRequest.tmaStore map x y srcByte =>
          BufferGpuEventSchedule.convertFragment(BufferKernels.tmaStore(BufferGpuEventSchedule.supplyOf(state), request))
    }

    def tileOverlaps (tiles: List(Tile))(x: Nat)(y: Nat): Bool decreases structural(tiles) := {
      match tiles returning Bool with
      | List.nil => Bool.false
      | List.cons tile rest => {
        match tile returning Bool with
        | Tile.mk oldX oldY => {
          let overlapX := Bool.and(Nat.blt(x, Nat.add(oldX, 32)), Nat.blt(oldX, Nat.add(x, 32)))
          let overlapY := Bool.and(Nat.blt(y, Nat.add(oldY, 32)), Nat.blt(oldY, Nat.add(y, 32)))
          Bool.or(Bool.and(overlapX, overlapY), BufferGpuEventSchedule.tileOverlaps(rest, x, y))
        }
      }
    }

    def tileCoordinatesValid (x: Nat)(y: Nat): Bool :=
      Bool.and(Nat.ble(x, 96), Bool.and(Nat.ble(y, 96),
        Bool.and(Nat.isZero(Nat.mod(x, 32)), Nat.isZero(Nat.mod(y, 32)))))

    def addUniqueTile (state: State)(x: Nat)(y: Nat): Option(State) := {
      match Bool.and(BufferGpuEventSchedule.tileCoordinatesValid(x, y),
          Bool.not(BufferGpuEventSchedule.tileOverlaps(BufferGpuEventSchedule.tilesOf(state), x, y))) returning Option(State) with
      | Bool.false => Option.none(State)
      | Bool.true => Option.some(BufferGpuEventSchedule.replaceTiles(state,
          BufferGpuEventSchedule.addTile(BufferGpuEventSchedule.tilesOf(state), Tile.mk(x, y))))
    }

    def tileCount (tiles: List(Tile)): Nat decreases structural(tiles) := {
      match tiles returning Nat with
      | List.nil => 0
      | List.cons tile rest => Nat.succ(BufferGpuEventSchedule.tileCount(rest))
    }

    def blockedEmpty (blocked: List(Blocked)): Bool := {
      match blocked returning Bool with
      | List.nil => Bool.true
      | List.cons first rest => Bool.false
    }

    def gatesQuiescent (gates: List(WarpMachine.SyncGate)): Bool decreases structural(gates) := {
      match gates returning Bool with
      | List.nil => Bool.true
      | List.cons gate rest => {
        match gate returning Bool with
        | WarpMachine.SyncGate.mk id expected arrived remaining released =>
          Bool.and(Bool.not(released), Bool.and(Nat.isZero(arrived),
            Bool.and(Nat.isZero(remaining), BufferGpuEventSchedule.gatesQuiescent(rest))))
      }
    }

    def finalStateValid (work: WorkLists)(state: State): Bool := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      Bool.and(BufferGpuEventSchedule.workListsEmpty(work),
        Bool.and(Nat.beq(BufferGpuEventSchedule.finishedMask(protocol), 255),
          Bool.and(BufferGpuEventSchedule.blockedEmpty(BufferGpuEventSchedule.blockedList(protocol)),
            Bool.and(BufferGpuEventSchedule.gatesQuiescent(BufferGpuEventSchedule.gateList(protocol)),
              Bool.and(WarpMachine.allBarriersInvalid(BufferGpuEventSchedule.barrierList(protocol)),
                Bool.and(Bool.not(BufferGpuEventSchedule.tmemIsLive(protocol)),
                  Bool.and(BufferGpuEventSchedule.deferredEmpty(BufferGpuEventSchedule.deferredLoads(protocol)),
                    Nat.beq(BufferGpuEventSchedule.tileCount(BufferGpuEventSchedule.tilesOf(state)), 16))))))))
    }

    def issueData (state: State)(warp: Nat)(request: DeviceApi.DataRequest)
        (barrier: Option(Nat))(phase: Nat)(committed: Bool)(ordinal: Nat): State :=
      BufferGpuEventSchedule.appendEventState(state, Event.data(warp, request, barrier, phase, committed, ordinal))

    def reserveInputBytes (state: State)(warp: Nat)(request: DeviceApi.DataRequest)(address: Nat)(ordinal: Nat)
        : Option(State) := {
      match BufferGpuEventSchedule.findBarrier(BufferGpuEventSchedule.barrierList(
          BufferGpuEventSchedule.protocolOf(state)), address) returning Option(State) with
      | Option.none => Option.none(State)
      | Option.some barrier => {
        let phase := WarpMachine.barrierPhase(barrier)
        let bytes := BufferGpuEventSchedule.requestTransferBytes(request)
        match WarpMachine.barrierScheduleBytes(barrier, phase, bytes) returning Option(State) with
        | Option.none => Option.none(State)
        | Option.some reserved => {
          let barriers := WarpMachine.setBarrier(BufferGpuEventSchedule.barrierList(
            BufferGpuEventSchedule.protocolOf(state)), reserved)
          let withReservation := BufferGpuEventSchedule.replaceBarrierState(state, barriers)
          Option.some(BufferGpuEventSchedule.issueData(withReservation, warp, request,
            Option.some(address), phase, Bool.true, ordinal))
        }
      }
    }

    def dispatch (state: State)(warp: Nat)(trace: BufferControl.Trace)(op: BufferGpuDecode.Op): OpResult := {
      let advancedCursor := BufferGpuEventSchedule.advanceCursor(state, warp)
      match op returning OpResult with
      | BufferGpuDecode.Op.retire => OpResult.advanced(BufferGpuEventSchedule.bumpStats(
          advancedCursor, 1, 0, 0, 0, 0, 0, 0, 0))
      | BufferGpuDecode.Op.gate id expected participants => {
        match trace returning OpResult with
        | BufferControl.Trace.mk owner mask pre post statement snapshot => {
          match BufferGpuEventSchedule.gateArrival(advancedCursor, warp, id, expected, participants, mask)
              returning OpResult with
          | Option.none => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
          | Option.some changed => OpResult.advanced(changed)
        }
      }
      | BufferGpuDecode.Op.barrierInit address expected => {
        let protocol := BufferGpuEventSchedule.protocolOf(advancedCursor)
        match BufferGpuEventSchedule.findBarrier(BufferGpuEventSchedule.barrierList(protocol), address)
            returning OpResult with
        | Option.none => {
          let changed := WarpMachine.barrierAfterInit(address, expected)
          let next := BufferGpuEventSchedule.replaceBarrierState(advancedCursor,
            WarpMachine.setBarrier(BufferGpuEventSchedule.barrierList(protocol), changed))
          OpResult.advanced(BufferGpuEventSchedule.bumpStats(next, 1, 0, 0, 0, 0, 0, 0, 0))
        }
        | Option.some previous => {
          match previous returning OpResult with
          | WarpMachine.Barrier.mk oldAddress oldExpected arrivals txExpected issued txDone phase initialized completed => {
            match initialized returning OpResult with
            | Bool.true => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
            | Bool.false => {
              let changed := WarpMachine.barrierAfterInit(address, expected)
              let next := BufferGpuEventSchedule.replaceBarrierState(advancedCursor,
                WarpMachine.setBarrier(BufferGpuEventSchedule.barrierList(protocol), changed))
              OpResult.advanced(BufferGpuEventSchedule.bumpStats(next, 1, 0, 0, 0, 0, 0, 0, 0))
            }
          }
        }
      }
      | BufferGpuDecode.Op.barrierArrive address arrivals txBytes => {
        match BufferGpuEventSchedule.findBarrier(BufferGpuEventSchedule.barrierList(
            BufferGpuEventSchedule.protocolOf(advancedCursor)), address) returning OpResult with
        | Option.none => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
        | Option.some barrier => {
          match WarpMachine.barrierAfterArrival(barrier, arrivals, txBytes) returning OpResult with
          | Option.none => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
          | Option.some changed => {
            let barriers := WarpMachine.setBarrier(BufferGpuEventSchedule.barrierList(
              BufferGpuEventSchedule.protocolOf(advancedCursor)), changed)
            let next := BufferGpuEventSchedule.replaceBarrierState(advancedCursor, barriers)
            OpResult.advanced(BufferGpuEventSchedule.bumpStats(next, 1, 0, 0, 0, 0, 0, 0, 0))
          }
        }
      }
      | BufferGpuDecode.Op.barrierInvalidate address => {
        let protocol := BufferGpuEventSchedule.protocolOf(advancedCursor)
        match BufferGpuEventSchedule.findBarrier(BufferGpuEventSchedule.barrierList(protocol), address)
            returning OpResult with
        | Option.none => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
        | Option.some barrier => {
          match Bool.and(WarpMachine.barrierQuiescent(barrier),
              Bool.not(BufferGpuEventSchedule.eventUsesBarrier(BufferGpuEventSchedule.eventsOf(advancedCursor), address)))
              returning OpResult with
          | Bool.false => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
          | Bool.true => {
            let changed := WarpMachine.barrierAfterInvalidate(barrier)
            let next := BufferGpuEventSchedule.replaceBarrierState(advancedCursor,
              WarpMachine.setBarrier(BufferGpuEventSchedule.barrierList(protocol), changed))
            OpResult.advanced(BufferGpuEventSchedule.bumpStats(next, 1, 0, 0, 0, 0, 0, 0, 0))
          }
        }
      }
      | BufferGpuDecode.Op.mbarWait address parity => {
        match BufferGpuEventSchedule.mbarReady(BufferGpuEventSchedule.protocolOf(advancedCursor), address, parity)
            returning OpResult with
        | Bool.true => OpResult.advanced(BufferGpuEventSchedule.bumpStats(advancedCursor, 1, 0, 0, 0, 0, 0, 0, 0))
        | Bool.false => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
      }
      | BufferGpuDecode.Op.issueTmaLoad request barrier => {
        match BufferGpuEventSchedule.reserveInputBytes(advancedCursor, warp, request, barrier, 0) returning OpResult with
        | Option.none => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
        | Option.some queued => OpResult.advanced(BufferGpuEventSchedule.bumpStats(queued, 1, 0, 0, 0, 0, 0, 0, 0))
      }
      | BufferGpuDecode.Op.issueTmaStore request => {
        match request returning OpResult with
        | DeviceApi.DataRequest.tmaStore map x y source => {
          match BufferGpuEventSchedule.addUniqueTile(advancedCursor, x, y) returning OpResult with
          | Option.none => OpResult.invalid(BufferGpuEventSchedule.badDeviceRequest, advancedCursor)
          | Option.some covered => {
            let queued := BufferGpuEventSchedule.issueData(covered, warp, request,
              Option.none(Nat), 0, Bool.false, 0)
            OpResult.advanced(BufferGpuEventSchedule.bumpStats(queued, 1, 0, 0, 0, 0, 0, 0, 0))
          }
        }
        | _ => OpResult.invalid(BufferGpuEventSchedule.badDeviceRequest, advancedCursor)
      }
      | BufferGpuDecode.Op.issueMma request => {
        let queued := BufferGpuEventSchedule.issueData(advancedCursor, warp, request, Option.none(Nat), 0, Bool.true, 0)
        OpResult.advanced(BufferGpuEventSchedule.bumpStats(queued, 1, 0, 0, 0, 0, 0, 0, 0))
      }
      | BufferGpuDecode.Op.issueTmemLoad request ordinal => {
        let queued := BufferGpuEventSchedule.issueData(advancedCursor, warp, request, Option.none(Nat), 0, Bool.true, ordinal)
        OpResult.advanced(BufferGpuEventSchedule.bumpStats(queued, 1, 0, 0, 0, 0, 0, 0, 0))
      }
      | BufferGpuDecode.Op.tmemWait => {
        match BufferGpuEventSchedule.clearDeferred(BufferGpuEventSchedule.protocolOf(advancedCursor), warp)
            returning OpResult with
        | Option.none => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
        | Option.some protocol => {
          let next := BufferGpuEventSchedule.replaceProtocol(advancedCursor, protocol)
          OpResult.advanced(BufferGpuEventSchedule.bumpStats(next, 1, 0, 0, 0, 0, 0, 0, 0))
        }
      }
      | BufferGpuDecode.Op.tmemAlloc sharedSlot columns => {
        let protocol := BufferGpuEventSchedule.protocolOf(advancedCursor)
        match Bool.and(Bool.not(BufferGpuEventSchedule.tmemIsLive(protocol)),
            Bool.and(Nat.isZero(sharedSlot), Nat.beq(columns, 128))) returning OpResult with
        | Bool.false => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
        | Bool.true => {
          let allocated := BufferGpuEventSchedule.withTmem(protocol, Bool.true, 0, columns)
          let next := BufferGpuEventSchedule.replaceProtocol(advancedCursor, allocated)
          let writeZero := BufferData.Action.store32(BufferData.BufferRef.shared,
            BufferData.Expr64.literal(sharedSlot), BufferData.Expr32.literal(0))
          let actions := List.cons(writeZero, List.nil(BufferData.Action))
          OpResult.advanced(BufferGpuEventSchedule.bumpStats(
            BufferGpuEventSchedule.pushRawActions(next, actions), 1, 0, 0, 0, 0, 0, 0, 0))
        }
      }
      | BufferGpuDecode.Op.tmemFree address columns => {
        let protocol := BufferGpuEventSchedule.protocolOf(advancedCursor)
        match Bool.and(BufferGpuEventSchedule.tmemIsLive(protocol),
            Bool.and(Nat.beq(address, BufferGpuEventSchedule.tmemAddress(protocol)),
              Bool.and(Nat.beq(columns, BufferGpuEventSchedule.tmemColumns(protocol)),
                BufferGpuEventSchedule.deferredEmpty(BufferGpuEventSchedule.deferredLoads(protocol))))) returning OpResult with
        | Bool.false => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
        | Bool.true => {
          let freed := BufferGpuEventSchedule.withTmem(protocol, Bool.false, 0, 0)
          let next := BufferGpuEventSchedule.replaceProtocol(advancedCursor, freed)
          OpResult.advanced(BufferGpuEventSchedule.bumpStats(next, 1, 0, 0, 0, 0, 0, 0, 0))
        }
      }
      | BufferGpuDecode.Op.tcCommit address => {
        match BufferGpuEventSchedule.findBarrier(BufferGpuEventSchedule.barrierList(
            BufferGpuEventSchedule.protocolOf(advancedCursor)), address) returning OpResult with
        | Option.none => OpResult.invalid(BufferGpuEventSchedule.badProtocol, advancedCursor)
        | Option.some barrier => {
          let phase := WarpMachine.barrierPhase(barrier)
          let queued := BufferGpuEventSchedule.appendEventState(advancedCursor, Event.tcCommit(warp, address, phase))
          OpResult.advanced(BufferGpuEventSchedule.bumpStats(queued, 1, 0, 0, 0, 0, 0, 0, 0))
        }
      }
      | BufferGpuDecode.Op.bulkCommit => {
        let committed := BufferGpuEventSchedule.replaceEvents(
          advancedCursor, BufferGpuEventSchedule.commitStoreEvents(BufferGpuEventSchedule.eventsOf(advancedCursor), warp))
        OpResult.advanced(BufferGpuEventSchedule.bumpStats(committed, 1, 0, 0, 0, 0, 0, 0, 0))
      }
      | BufferGpuDecode.Op.bulkWait pending =>
        OpResult.advanced(BufferGpuEventSchedule.bumpStats(advancedCursor, 1, 0, 0, 0, 0, 0, 0, 0))
      | BufferGpuDecode.Op.sharedWrites actions => {
        let next := BufferGpuEventSchedule.pushRawActions(advancedCursor, actions)
        OpResult.advanced(BufferGpuEventSchedule.bumpStats(next, 1, 0, 0, 0, 0, 0, 0, 0))
      }
    }

    def mmaScalarCount (request: DeviceApi.DataRequest): Nat := {
      match request returning Nat with
      | DeviceApi.DataRequest.mma desc => {
        match desc returning Nat with
        | DeviceApi.MmaDesc.mk group accumulator a b instruction accumulate => {
          match instruction returning Nat with
          | Cuda.InstrDesc.mk m n transpose => Nat.mul(Nat.mul(m, n), 16)
        }
      }
      | _ => 0
    }

    def completeTmemInit (state: State)(request: DeviceApi.DataRequest): State := {
      match request returning State with
      | DeviceApi.DataRequest.mma desc => {
        match desc returning State with
        | DeviceApi.MmaDesc.mk group accumulator a b instruction accumulate => {
          match Nat.isZero(accumulate) returning State with
          | Bool.true => {
            let protocol := BufferGpuEventSchedule.protocolOf(state)
            BufferGpuEventSchedule.replaceProtocol(state,
              BufferGpuEventSchedule.withTmemInitialized(protocol, Bool.true))
          }
          | Bool.false => state
        }
      }
      | _ => state
    }

    def completeDeferredLoads (state: State)(warp: Nat)(request: DeviceApi.DataRequest): Option(State) := {
      match WarpMachine.requestIsTmemLoad(request) returning Option(State) with
      | Bool.false => Option.some(state)
      | Bool.true => {
        match BufferGpuEventSchedule.incrementDeferred(BufferGpuEventSchedule.protocolOf(state), warp)
            returning Option(State) with
        | Option.none => Option.none(State)
        | Option.some protocol => Option.some(BufferGpuEventSchedule.replaceProtocol(state, protocol))
      }
    }

    def completionStats (state: State)(request: DeviceApi.DataRequest)(bytes: Nat): State := {
      match request returning State with
      | DeviceApi.DataRequest.mma desc => {
        let count := BufferGpuEventSchedule.mmaScalarCount(request)
        BufferGpuEventSchedule.bumpStats(state, 0, 1, bytes, count, count, 1, 0, 0)
      }
      | DeviceApi.DataRequest.tmemLoad shape ids address group mask =>
          BufferGpuEventSchedule.bumpStats(state, 0, 1, bytes, 0, 0, 0, 1, 0)
      | DeviceApi.DataRequest.tmaStore map x y srcByte =>
          BufferGpuEventSchedule.bumpStats(state, 0, 1, bytes, 0, 0, 0, 0, 1)
      | DeviceApi.DataRequest.tmaLoad map dst x y =>
          BufferGpuEventSchedule.bumpStats(state, 0, 1, bytes, 0, 0, 0, 0, 0)
    }

    def completeDataEvent (state: State)(warp: Nat)(request: DeviceApi.DataRequest)
        (barrier: Option(Nat))(phase: Nat)(committed: Bool)(ordinal: Nat): CompletionResult := {
      match committed returning CompletionResult with
      | Bool.false => CompletionResult.deadlocked(state)
      | Bool.true => {
        let bytes := BufferGpuEventSchedule.requestTransferBytes(request)
        match BufferGpuEventSchedule.eventBytesReady(state, barrier, phase, bytes) returning CompletionResult with
        | Option.none => CompletionResult.rejected(BufferGpuEventSchedule.badProtocol)
        | Option.some afterBarrier => {
          match BufferGpuEventSchedule.eventFragment(afterBarrier, request, ordinal) returning CompletionResult with
          | FragmentResult.invalid => CompletionResult.rejected(BufferGpuEventSchedule.badDeviceRequest)
          | FragmentResult.emitted actions supply => {
            let withActions := BufferGpuEventSchedule.appendFragmentActions(afterBarrier, actions, supply)
            match BufferGpuEventSchedule.completeDeferredLoads(withActions, warp, request)
                returning CompletionResult with
              | Option.none => CompletionResult.rejected(BufferGpuEventSchedule.badProtocol)
              | Option.some withDeferred => {
                let initialized := BufferGpuEventSchedule.completeTmemInit(withDeferred, request)
                CompletionResult.advanced(BufferGpuEventSchedule.completionStats(initialized, request, bytes))
              }
            }
          }
        }
      }

    def completeCommitEvent (state: State)(warp: Nat)(address: Nat)(phase: Nat): CompletionResult := {
      let protocol := BufferGpuEventSchedule.protocolOf(state)
      match BufferGpuEventSchedule.findBarrier(BufferGpuEventSchedule.barrierList(protocol), address)
          returning CompletionResult with
      | Option.none => CompletionResult.rejected(BufferGpuEventSchedule.badProtocol)
      | Option.some barrier => {
        match Nat.beq(WarpMachine.barrierPhase(barrier), phase) returning CompletionResult with
        | Bool.false => CompletionResult.rejected(BufferGpuEventSchedule.badProtocol)
        | Bool.true => {
          match WarpMachine.barrierAfterArrival(barrier, 1, 0) returning CompletionResult with
          | Option.none => CompletionResult.rejected(BufferGpuEventSchedule.badProtocol)
          | Option.some changed => {
            let barriers := WarpMachine.setBarrier(BufferGpuEventSchedule.barrierList(protocol), changed)
            let next := BufferGpuEventSchedule.replaceBarrierState(state, barriers)
            CompletionResult.advanced(BufferGpuEventSchedule.bumpStats(next, 0, 1, 0, 0, 0, 0, 0, 0))
          }
        }
      }
    }

    def retireEvent (state: State)(event: Event): CompletionResult := {
      match event returning CompletionResult with
      | Event.data warp request barrier phase committed ordinal =>
          BufferGpuEventSchedule.completeDataEvent(state, warp, request, barrier, phase, committed, ordinal)
      | Event.tcCommit warp address phase => BufferGpuEventSchedule.completeCommitEvent(state, warp, address, phase)
    }

    // The eight warp worklists and FIFO event list are the termination measure. A selected
    // warp consumes its head; when no warp can run, event retirement consumes the FIFO head.
    // Wake/skip scans are bounded to one CTA and never recurse without consuming work.
    def runLoop (kernel: Cuda.Kernel)(warp0: List(BufferControl.Trace))(warp1: List(BufferControl.Trace))
        (warp2: List(BufferControl.Trace))(warp3: List(BufferControl.Trace))
        (warp4: List(BufferControl.Trace))(warp5: List(BufferControl.Trace))
        (warp6: List(BufferControl.Trace))(warp7: List(BufferControl.Trace))
        (events: List(Event))(state: State): SchedulerResult
        decreases lexicographic(warp0, warp1, warp2, warp3, warp4, warp5, warp6, warp7, events) := {
      let work := WorkLists.mk(warp0, warp1, warp2, warp3, warp4, warp5, warp6, warp7)
      let awake := BufferGpuEventSchedule.wakeAll(state, 0, 8)
      match BufferGpuEventSchedule.scan(kernel, work, awake, BufferGpuEventSchedule.cursorOf(awake), 8)
          returning SchedulerResult with
      | ScanResult.invalid code changed => SchedulerResult.rejected(code, changed)
      | ScanResult.selected selected trace op changed => {
        match selected returning SchedulerResult with
        | Nat.zero => {
          match warp0 returning SchedulerResult with
          | List.nil => SchedulerResult.rejected(BufferGpuEventSchedule.badProtocol, changed)
          | List.cons first rest => {
            match BufferGpuEventSchedule.dispatch(changed, 0, trace, op) returning SchedulerResult with
            | OpResult.invalid code failed => SchedulerResult.rejected(code, failed)
            | OpResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, rest, warp1, warp2, warp3,
                warp4, warp5, warp6, warp7, BufferGpuEventSchedule.eventsOf(next), next)
          }
        }
        | Nat.succ one => {
          match one returning SchedulerResult with
          | Nat.zero => {
            match warp1 returning SchedulerResult with
            | List.nil => SchedulerResult.rejected(BufferGpuEventSchedule.badProtocol, changed)
            | List.cons first rest => {
              match BufferGpuEventSchedule.dispatch(changed, 1, trace, op) returning SchedulerResult with
              | OpResult.invalid code failed => SchedulerResult.rejected(code, failed)
              | OpResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, warp0, rest, warp2, warp3,
                  warp4, warp5, warp6, warp7, BufferGpuEventSchedule.eventsOf(next), next)
            }
          }
          | Nat.succ two => {
            match two returning SchedulerResult with
            | Nat.zero => {
              match warp2 returning SchedulerResult with
              | List.nil => SchedulerResult.rejected(BufferGpuEventSchedule.badProtocol, changed)
              | List.cons first rest => {
                match BufferGpuEventSchedule.dispatch(changed, 2, trace, op) returning SchedulerResult with
                | OpResult.invalid code failed => SchedulerResult.rejected(code, failed)
                | OpResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, warp0, warp1, rest, warp3,
                    warp4, warp5, warp6, warp7, BufferGpuEventSchedule.eventsOf(next), next)
              }
            }
            | Nat.succ three => {
              match three returning SchedulerResult with
              | Nat.zero => {
                match warp3 returning SchedulerResult with
                | List.nil => SchedulerResult.rejected(BufferGpuEventSchedule.badProtocol, changed)
                | List.cons first rest => {
                  match BufferGpuEventSchedule.dispatch(changed, 3, trace, op) returning SchedulerResult with
                  | OpResult.invalid code failed => SchedulerResult.rejected(code, failed)
                  | OpResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, warp0, warp1, warp2, rest,
                      warp4, warp5, warp6, warp7, BufferGpuEventSchedule.eventsOf(next), next)
                }
              }
              | Nat.succ four => {
                match four returning SchedulerResult with
                | Nat.zero => {
                  match warp4 returning SchedulerResult with
                  | List.nil => SchedulerResult.rejected(BufferGpuEventSchedule.badProtocol, changed)
                  | List.cons first rest => {
                    match BufferGpuEventSchedule.dispatch(changed, 4, trace, op) returning SchedulerResult with
                    | OpResult.invalid code failed => SchedulerResult.rejected(code, failed)
                    | OpResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, warp0, warp1, warp2, warp3,
                        rest, warp5, warp6, warp7, BufferGpuEventSchedule.eventsOf(next), next)
                  }
                }
                | Nat.succ five => {
                  match five returning SchedulerResult with
                  | Nat.zero => {
                    match warp5 returning SchedulerResult with
                    | List.nil => SchedulerResult.rejected(BufferGpuEventSchedule.badProtocol, changed)
                    | List.cons first rest => {
                      match BufferGpuEventSchedule.dispatch(changed, 5, trace, op) returning SchedulerResult with
                      | OpResult.invalid code failed => SchedulerResult.rejected(code, failed)
                      | OpResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, warp0, warp1, warp2, warp3,
                          warp4, rest, warp6, warp7, BufferGpuEventSchedule.eventsOf(next), next)
                    }
                  }
                  | Nat.succ six => {
                    match six returning SchedulerResult with
                    | Nat.zero => {
                      match warp6 returning SchedulerResult with
                      | List.nil => SchedulerResult.rejected(BufferGpuEventSchedule.badProtocol, changed)
                      | List.cons first rest => {
                        match BufferGpuEventSchedule.dispatch(changed, 6, trace, op) returning SchedulerResult with
                        | OpResult.invalid code failed => SchedulerResult.rejected(code, failed)
                        | OpResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, warp0, warp1, warp2, warp3,
                            warp4, warp5, rest, warp7, BufferGpuEventSchedule.eventsOf(next), next)
                      }
                    }
                    | Nat.succ seven => {
                      match seven returning SchedulerResult with
                      | Nat.zero => {
                        match warp7 returning SchedulerResult with
                        | List.nil => SchedulerResult.rejected(BufferGpuEventSchedule.badProtocol, changed)
                        | List.cons first rest => {
                          match BufferGpuEventSchedule.dispatch(changed, 7, trace, op) returning SchedulerResult with
                          | OpResult.invalid code failed => SchedulerResult.rejected(code, failed)
                          | OpResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, warp0, warp1, warp2,
                              warp3, warp4, warp5, warp6, rest, BufferGpuEventSchedule.eventsOf(next), next)
                        }
                      }
                      | Nat.succ _ => SchedulerResult.rejected(BufferGpuEventSchedule.badProtocol, changed)
                    }
                  }
                }
              }
            }
          }
        }
      }
      | ScanResult.exhausted changed => {
        match events returning SchedulerResult with
        | List.cons event rest => {
          match event returning SchedulerResult with
          | Event.data warp request barrier phase committed ordinal => {
            match committed returning SchedulerResult with
            | Bool.false => SchedulerResult.deadlocked(changed)
            | Bool.true => {
              let withoutHead := BufferGpuEventSchedule.replaceEvents(changed, rest)
              match BufferGpuEventSchedule.retireEvent(withoutHead, event) returning SchedulerResult with
              | CompletionResult.rejected code => SchedulerResult.rejected(code, withoutHead)
              | CompletionResult.deadlocked failed => SchedulerResult.deadlocked(failed)
              | CompletionResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, warp0, warp1, warp2,
                  warp3, warp4, warp5, warp6, warp7, rest, next)
            }
          }
          | Event.tcCommit warp address phase => {
            let withoutHead := BufferGpuEventSchedule.replaceEvents(changed, rest)
            match BufferGpuEventSchedule.retireEvent(withoutHead, event) returning SchedulerResult with
            | CompletionResult.rejected code => SchedulerResult.rejected(code, withoutHead)
            | CompletionResult.deadlocked failed => SchedulerResult.deadlocked(failed)
            | CompletionResult.advanced next => BufferGpuEventSchedule.runLoop(kernel, warp0, warp1, warp2,
                warp3, warp4, warp5, warp6, warp7, rest, next)
          }
        }
        | List.nil => {
          let protocol := BufferGpuEventSchedule.protocolOf(changed)
          match Bool.and(BufferGpuEventSchedule.workListsEmpty(work),
              Nat.beq(BufferGpuEventSchedule.finishedMask(protocol), 255)) returning SchedulerResult with
          | Bool.false => SchedulerResult.deadlocked(changed)
          | Bool.true => {
            match BufferGpuEventSchedule.finalStateValid(work, changed) returning SchedulerResult with
            | Bool.true => SchedulerResult.finished(changed)
            | Bool.false => {
              match Nat.beq(BufferGpuEventSchedule.tileCount(BufferGpuEventSchedule.tilesOf(changed)), 16)
                  returning SchedulerResult with
              | Bool.false => SchedulerResult.rejected(BufferGpuEventSchedule.incompleteOutput, changed)
              | Bool.true => SchedulerResult.rejected(BufferGpuEventSchedule.notQuiescent, changed)
            }
          }
        }
      }
    }

    def compile (kernel: Cuda.Kernel)(expanded: BufferControl.State): CompileResult := {
      match expanded returning CompileResult with
      | BufferControl.State.mk registers traces workCount nextSnapshot => {
        let work := BufferGpuEventSchedule.workLists(traces)
        match work returning CompileResult with
        | WorkLists.mk warp0 warp1 warp2 warp3 warp4 warp5 warp6 warp7 => {
          match BufferGpuEventSchedule.runLoop(kernel, warp0, warp1, warp2, warp3, warp4, warp5, warp6,
              warp7, List.nil(Event), BufferGpuEventSchedule.initialState) returning CompileResult with
          | SchedulerResult.rejected code state => CompileResult.rejected(code)
          | SchedulerResult.deadlocked state => CompileResult.rejected(BufferGpuEventSchedule.deadlockCode)
          | SchedulerResult.finished state => CompileResult.compiled(
              List.reverse(BufferGpuEventSchedule.actionsReversedOf(state)),
              BufferGpuEventSchedule.supplyOf(state), BufferGpuEventSchedule.statsOf(state))
        }
      }
    }

  }
}
