// The checked kernel AST, preparation/run closures and extraction helpers share one module environment so all values
// retain the exact nominal Cuda family produced by Core.checkedKernel.

import Check
import Cuda
import encoding.Core
import encoding.TinyGemm
import evaluator.TinyDevice
import evaluator.WarpMachine

namespace Evaluator {
  namespace TinyGemmApi {
    struct Prepared : Type
     | mk (kernel: Cuda.Kernel)(inputs: TinyDevice.Inputs) : Prepared

    def kernel : Cuda.Kernel := Core.checkedKernel(Tiny.kernel)
    def prepare (actual: Cuda.Kernel)(seed: Nat): Option(Prepared) := {
      match TinyDevice.prepare(actual, 128, 128, 64, seed) returning Option(Prepared) with
      | Option.none => Option.none(Prepared)
      | Option.some inputs => Option.some(Prepared.mk(actual, inputs))
    }
    def run (prepared: Prepared): WarpMachine.MachineResult := {
      match prepared returning WarpMachine.MachineResult with
      | Prepared.mk actual inputs => WarpMachine.run(actual, inputs, 10000000)
    }
    def inputs (prepared: Prepared): Pair(List(Nat), List(Nat)) := {
      match prepared returning Pair(List(Nat), List(Nat)) with
      | Prepared.mk actual values => (TinyDevice.inputAList(values), TinyDevice.inputBList(values))
    }
    def outputs (result: WarpMachine.MachineResult): List(Nat) := WarpMachine.outputs(result)
    def stats (result: WarpMachine.MachineResult): WarpMachine.Stats := WarpMachine.stats(result)
    def errors (result: WarpMachine.MachineResult): String := WarpMachine.errors(result)
    def mutantNames : List(String) := List.cons("wrong-k-slice",
      List.cons("descriptor", List.cons("output-offset", List.cons("out-of-bounds",
        List.cons("partial-aligned", List.cons("partial-wait", List.cons("unsupported",
          List.cons("unsupported-regpool",
          List.cons("missing-commit", List.cons("missing-tma-completion",
            List.cons("fuel", List.cons("not-quiescent",
              List.cons("overlapping-tmem-load", List.nil(String))))))))))))))
    def kernelWithBody (actual: Cuda.Kernel)(body: Cuda.Block): Cuda.Kernel := {
      match actual returning Cuda.Kernel with
      | Cuda.Kernel.mk name params dynamicShared oldBody launcher =>
        Cuda.Kernel.mk(name, params, dynamicShared, body, launcher)
    }
    def rewriteDesc (desc: Cuda.SmemDesc)(fromStep: Nat)(toStep: Nat): Cuda.SmemDesc := {
      match desc returning Cuda.SmemDesc with
      | Cuda.SmemDesc.mk base lbo step => {
        let selected := Nat.beq(step, fromStep)
        Cuda.SmemDesc.mk(base, lbo, Bool.cond(selected, Nat, toStep, step))
      }
    }
    def rewriteMmaA (a: Cuda.MmaA)(fromStep: Nat)(toStep: Nat): Cuda.MmaA := {
      match a returning Cuda.MmaA with
      | Cuda.MmaA.smem desc => Cuda.MmaA.smem(TinyGemmApi.rewriteDesc(desc, fromStep, toStep))
      | Cuda.MmaA.tmem address => a
    }

    mutual {
      def rewriteBlock (astBlock: Cuda.Block)(fromStep: Nat)(toStep: Nat): Cuda.Block decreases structural(astBlock) := {
        match astBlock returning Cuda.Block with
        | Cuda.Block.done => Cuda.Block.done
        | Cuda.Block.seq statement rest => Cuda.Block.seq(
            TinyGemmApi.rewriteStmt(statement, fromStep, toStep), TinyGemmApi.rewriteBlock(rest, fromStep, toStep))
      }

      def rewriteStmt (statement: Cuda.Stmt)(fromStep: Nat)(toStep: Nat): Cuda.Stmt decreases structural(statement) := {
        match statement returning Cuda.Stmt with
        | Cuda.Stmt.forLoop id start stop body => Cuda.Stmt.forLoop(id, start, stop,
            TinyGemmApi.rewriteBlock(body, fromStep, toStep))
        | Cuda.Stmt.forStride id start stop step body => Cuda.Stmt.forStride(id, start, stop, step,
            TinyGemmApi.rewriteBlock(body, fromStep, toStep))
        | Cuda.Stmt.ifElse condition yes no => Cuda.Stmt.ifElse(condition,
            TinyGemmApi.rewriteBlock(yes, fromStep, toStep), TinyGemmApi.rewriteBlock(no, fromStep, toStep))
        | Cuda.Stmt.scoped body => Cuda.Stmt.scoped(TinyGemmApi.rewriteBlock(body, fromStep, toStep))
        | Cuda.Stmt.instr instruction => Cuda.Stmt.instr(TinyGemmApi.rewriteInstr(instruction, fromStep, toStep))
        | _ => statement
      }

      def rewriteInstr (instruction: Cuda.Instr)(fromStep: Nat)(toStep: Nat): Cuda.Instr
          decreases structural(instruction) := {
        match instruction returning Cuda.Instr with
        | Cuda.Instr.mma group acc a b desc accumulate => Cuda.Instr.mma(group, acc,
            TinyGemmApi.rewriteMmaA(a, fromStep, toStep), TinyGemmApi.rewriteDesc(b, fromStep, toStep), desc, accumulate)
        | _ => instruction
      }
    }
    def rewriteKernelSteps (actual: Cuda.Kernel)(fromStep: Nat)(toStep: Nat): Cuda.Kernel := {
      match actual returning Cuda.Kernel with
      | Cuda.Kernel.mk name params dynamicShared body launcher =>
        Cuda.Kernel.mk(name, params, dynamicShared, TinyGemmApi.rewriteBlock(body, fromStep, toStep), launcher)
    }
    mutual {
      def removeOneTmaBlock (astBlock: Cuda.Block)(removed: Bool): Pair(Cuda.Block, Bool)
          decreases structural(astBlock) := {
        match astBlock returning Pair(Cuda.Block, Bool) with
        | Cuda.Block.done => (Cuda.Block.done, removed)
        | Cuda.Block.seq statement rest => {
          let changedStatement := TinyGemmApi.removeOneTmaStmt(statement, removed)
          match changedStatement returning Pair(Cuda.Block, Bool) with
          | Pair.mk nextStatement didRemove => {
            let changedRest := TinyGemmApi.removeOneTmaBlock(rest, didRemove)
            match changedRest returning Pair(Cuda.Block, Bool) with
            | Pair.mk nextRest found => (Cuda.Block.seq(nextStatement, nextRest), found)
          }
        }
      }

      def removeOneTmaStmt (statement: Cuda.Stmt)(removed: Bool): Pair(Cuda.Stmt, Bool)
          decreases structural(statement) := {
        match statement returning Pair(Cuda.Stmt, Bool) with
        | Cuda.Stmt.instr instruction => TinyGemmApi.removeOneTmaInstr(instruction, removed)
        | Cuda.Stmt.scoped body => {
          match TinyGemmApi.removeOneTmaBlock(body, removed) returning Pair(Cuda.Stmt, Bool) with
          | Pair.mk changed found => (Cuda.Stmt.scoped(changed), found)
        }
        | Cuda.Stmt.forLoop id start stop body => {
          match TinyGemmApi.removeOneTmaBlock(body, removed) returning Pair(Cuda.Stmt, Bool) with
          | Pair.mk changed found => (Cuda.Stmt.forLoop(id, start, stop, changed), found)
        }
        | Cuda.Stmt.forStride id start stop step body => {
          match TinyGemmApi.removeOneTmaBlock(body, removed) returning Pair(Cuda.Stmt, Bool) with
          | Pair.mk changed found => (Cuda.Stmt.forStride(id, start, stop, step, changed), found)
        }
        | Cuda.Stmt.ifElse condition yes no => {
          match TinyGemmApi.removeOneTmaBlock(yes, removed) returning Pair(Cuda.Stmt, Bool) with
          | Pair.mk changedYes afterYes => {
            match TinyGemmApi.removeOneTmaBlock(no, afterYes) returning Pair(Cuda.Stmt, Bool) with
            | Pair.mk changedNo found => (Cuda.Stmt.ifElse(condition, changedYes, changedNo), found)
          }
        }
        | _ => (statement, removed)
      }

      def removeOneTmaInstr (instruction: Cuda.Instr)(removed: Bool): Pair(Cuda.Stmt, Bool)
          decreases structural(instruction) := {
        match removed returning Pair(Cuda.Stmt, Bool) with
        | Bool.true => (Cuda.Stmt.instr(instruction), Bool.true)
        | Bool.false => {
          match instruction returning Pair(Cuda.Stmt, Bool) with
          | Cuda.Instr.tmaLoad group dst map x y barrier =>
            (Cuda.Stmt.instr(Cuda.Instr.fenceProxyAsync), Bool.true)
          | _ => (Cuda.Stmt.instr(instruction), Bool.false)
        }
      }
    }
    def removeMissingTmaLoad (actual: Cuda.Kernel): Cuda.Kernel := {
      match actual returning Cuda.Kernel with
      | Cuda.Kernel.mk name params dynamicShared body launcher => {
        let changed := TinyGemmApi.removeOneTmaBlock(body, Bool.false)
        match changed returning Cuda.Kernel with
        | Pair.mk rewritten removed => Cuda.Kernel.mk(name, params, dynamicShared, rewritten, launcher)
      }
    }

    // Core.chunkLoad's first syntactic load is chunk column zero. Its runtime chunk bases are 0, 32, 64 and 96,
    // so a second load at +8 stays within the 128-column allocation while writing the same destination registers.
    mutual {
      def duplicateFirstTmemBlock(astBlock: Cuda.Block): Pair(Cuda.Block, Bool) decreases structural(astBlock) := {
        match astBlock returning Pair(Cuda.Block, Bool) with
        | Cuda.Block.done => (Cuda.Block.done, Bool.false)
        | Cuda.Block.seq statement rest => {
          match statement returning Pair(Cuda.Block, Bool) with
          | Cuda.Stmt.instr instruction => {
            match instruction returning Pair(Cuda.Block, Bool) with
            | Cuda.Instr.tmemLoad shape dst address => {
              let duplicateAddress := Cuda.Expr.bin(Cuda.BinOp.add, address, Cuda.Expr.lit(8))
              let duplicate := Cuda.Stmt.instr(Cuda.Instr.tmemLoad(shape, dst, duplicateAddress))
              (Cuda.Block.seq(statement, Cuda.Block.seq(duplicate, rest)), Bool.true)
            }
            | _ => {
              let changedRest := TinyGemmApi.duplicateFirstTmemBlock(rest)
              match changedRest returning Pair(Cuda.Block, Bool) with
              | Pair.mk nextRest inserted => (Cuda.Block.seq(statement, nextRest), inserted)
            }
          }
          | _ => {
            let changedStatement := TinyGemmApi.duplicateFirstTmemStmt(statement)
            match changedStatement returning Pair(Cuda.Block, Bool) with
            | Pair.mk nextStatement didInsert => {
              match didInsert returning Pair(Cuda.Block, Bool) with
              | Bool.true => (Cuda.Block.seq(nextStatement, rest), Bool.true)
              | Bool.false => {
                let changedRest := TinyGemmApi.duplicateFirstTmemBlock(rest)
                match changedRest returning Pair(Cuda.Block, Bool) with
                | Pair.mk nextRest inserted => (Cuda.Block.seq(nextStatement, nextRest), inserted)
              }
            }
          }
        }
      }

      def duplicateFirstTmemStmt(statement: Cuda.Stmt): Pair(Cuda.Stmt, Bool) decreases structural(statement) := {
        match statement returning Pair(Cuda.Stmt, Bool) with
        | Cuda.Stmt.scoped body => {
          let changed := TinyGemmApi.duplicateFirstTmemBlock(body)
          match changed returning Pair(Cuda.Stmt, Bool) with
          | Pair.mk newBody didInsert => (Cuda.Stmt.scoped(newBody), didInsert)
        }
        | Cuda.Stmt.forLoop id start stop body => {
          let changed := TinyGemmApi.duplicateFirstTmemBlock(body)
          match changed returning Pair(Cuda.Stmt, Bool) with
          | Pair.mk newBody didInsert => (Cuda.Stmt.forLoop(id, start, stop, newBody), didInsert)
        }
        | Cuda.Stmt.forStride id start stop step body => {
          let changed := TinyGemmApi.duplicateFirstTmemBlock(body)
          match changed returning Pair(Cuda.Stmt, Bool) with
          | Pair.mk newBody didInsert => (Cuda.Stmt.forStride(id, start, stop, step, newBody), didInsert)
        }
        | Cuda.Stmt.ifElse condition yes no => {
          let changedYes := TinyGemmApi.duplicateFirstTmemBlock(yes)
          match changedYes returning Pair(Cuda.Stmt, Bool) with
          | Pair.mk newYes didInsert => {
            match didInsert returning Pair(Cuda.Stmt, Bool) with
            | Bool.true => (Cuda.Stmt.ifElse(condition, newYes, no), Bool.true)
            | Bool.false => {
              let changedNo := TinyGemmApi.duplicateFirstTmemBlock(no)
              match changedNo returning Pair(Cuda.Stmt, Bool) with
              | Pair.mk newNo inserted => (Cuda.Stmt.ifElse(condition, newYes, newNo), inserted)
            }
          }
        }
        | _ => (statement, Bool.false)
      }
    }

    def duplicateFirstTmemLoad (actual: Cuda.Kernel): Cuda.Kernel := {
      match actual returning Cuda.Kernel with
      | Cuda.Kernel.mk name params dynamicShared body launcher => {
        let changed := TinyGemmApi.duplicateFirstTmemBlock(body)
        match changed returning Cuda.Kernel with
        | Pair.mk rewritten inserted => Cuda.Kernel.mk(name, params, dynamicShared, rewritten, launcher)
      }
    }
    def instruction (instruction: Cuda.Instr)(rest: Cuda.Block): Cuda.Block :=
      Cuda.Block.seq(Cuda.Stmt.instr(instruction), rest)
    def onlyWarpZero (body: Cuda.Block): Cuda.Block := Cuda.Block.seq(
      Cuda.Stmt.ifElse(Cuda.Expr.bin(Cuda.BinOp.eq, Cuda.Expr.special(Cuda.Builtin.warp), Cuda.Expr.lit(0)),
        body, Cuda.Block.done), Cuda.Block.done)
    def onlyLaneZero (body: Cuda.Block): Cuda.Block := Cuda.Block.seq(
      Cuda.Stmt.ifElse(Cuda.Expr.bin(Cuda.BinOp.eq, Cuda.Expr.special(Cuda.Builtin.lane), Cuda.Expr.lit(0)),
        body, Cuda.Block.done), Cuda.Block.done)
    def partialLoadBody : Cuda.Block := TinyGemmApi.onlyWarpZero(TinyGemmApi.onlyLaneZero(
      TinyGemmApi.instruction(Cuda.Instr.tmemLoad(Cuda.TmemShape.s32x32b,
        List.cons(0, List.nil(Nat)), Cuda.Expr.lit(0)), Cuda.Block.done)))
    def partialWaitBody : Cuda.Block := TinyGemmApi.onlyWarpZero(
      TinyGemmApi.instruction(Cuda.Instr.tmemLoad(Cuda.TmemShape.s32x32b,
        List.cons(0, List.nil(Nat)), Cuda.Expr.lit(0)), TinyGemmApi.onlyLaneZero(
          TinyGemmApi.instruction(Cuda.Instr.tmemWait(Cuda.TmemWait.load), Cuda.Block.done))))
    def outputOffsetBody : Cuda.Block := TinyGemmApi.onlyWarpZero(TinyGemmApi.onlyLaneZero(
      TinyGemmApi.instruction(Cuda.Instr.tmaStore(Cuda.Expr.paramAddr("C_map"), Cuda.Expr.lit(0), Cuda.Expr.lit(0),
        Cuda.Expr.sharedPtr(Cuda.DType.f32, 164928)),
        TinyGemmApi.instruction(Cuda.Instr.bulkCommit, Cuda.Block.done))))
    def outOfBoundsBody : Cuda.Block := TinyGemmApi.onlyWarpZero(
      TinyGemmApi.instruction(Cuda.Instr.tmemAlloc(Cuda.CtaGroup.one,
        Cuda.Expr.sharedPtr(Cuda.DType.u32, 164928), Cuda.Expr.lit(128)), Cuda.Block.done))
    def unsupportedBody : Cuda.Block := TinyGemmApi.onlyWarpZero(
      TinyGemmApi.instruction(Cuda.Instr.clusterArrive, Cuda.Block.done))
    def unsupportedRegpoolBody : Cuda.Block := TinyGemmApi.onlyWarpZero(TinyGemmApi.onlyLaneZero(
      TinyGemmApi.instruction(Cuda.Instr.setMaxNReg(Cuda.RegChange.inc, 32), Cuda.Block.done)))
    def missingCommitBody : Cuda.Block := TinyGemmApi.onlyWarpZero(TinyGemmApi.onlyLaneZero(
      TinyGemmApi.instruction(Cuda.Instr.tmaStore(Cuda.Expr.paramAddr("C_map"), Cuda.Expr.lit(0), Cuda.Expr.lit(0),
        Cuda.Expr.sharedPtr(Cuda.DType.f32, 0)), Cuda.Block.done)))
    def fuelBody : Cuda.Block := TinyGemmApi.onlyWarpZero(
      TinyGemmApi.instruction(Cuda.Instr.fenceProxyAsync, Cuda.Block.done))
    def notQuiescentBody : Cuda.Block := TinyGemmApi.onlyWarpZero(
      TinyGemmApi.instruction(Cuda.Instr.tmemAlloc(Cuda.CtaGroup.one,
        Cuda.Expr.sharedPtr(Cuda.DType.u32, 0), Cuda.Expr.lit(128)), Cuda.Block.done))
    def unknownBody : Cuda.Block := Cuda.Block.seq(Cuda.Stmt.error("unknown TinyGEMM mutant"), Cuda.Block.done)
    def descriptorBody : Cuda.Block := TinyGemmApi.onlyWarpZero(
      TinyGemmApi.instruction(Cuda.Instr.tmemAlloc(Cuda.CtaGroup.one,
        Cuda.Expr.sharedPtr(Cuda.DType.u32, 0), Cuda.Expr.lit(128)),
        TinyGemmApi.onlyLaneZero(TinyGemmApi.instruction(Cuda.Instr.mma(Cuda.CtaGroup.one, Cuda.Expr.lit(0),
          Cuda.MmaA.smem(Cuda.SmemDesc.mk(Cuda.Expr.sharedPtr(Cuda.DType.bf16, 33792), 0, 4)),
          Cuda.SmemDesc.mk(Cuda.Expr.sharedPtr(Cuda.DType.bf16, 50176), 0, 4),
          Cuda.InstrDesc.mk(128, 128, Bool.false), Cuda.Expr.lit(0)), Cuda.Block.done))))
    def chooseMutant (actual: Cuda.Kernel)(name: String): Cuda.Kernel := {
      match Check.same(name, "wrong-k-slice") returning Cuda.Kernel with
      | Bool.true => TinyGemmApi.rewriteKernelSteps(actual, 1, 2)
      | Bool.false => {
        match Check.same(name, "descriptor") returning Cuda.Kernel with
        | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.descriptorBody)
        | Bool.false => {
          match Check.same(name, "output-offset") returning Cuda.Kernel with
          | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.outputOffsetBody)
          | Bool.false => {
            match Check.same(name, "out-of-bounds") returning Cuda.Kernel with
            | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.outOfBoundsBody)
            | Bool.false => {
              match Check.same(name, "partial-aligned") returning Cuda.Kernel with
              | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.partialLoadBody)
              | Bool.false => {
                match Check.same(name, "partial-wait") returning Cuda.Kernel with
                | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.partialWaitBody)
                | Bool.false => {
                  match Check.same(name, "unsupported") returning Cuda.Kernel with
                  | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.unsupportedBody)
                  | Bool.false => {
                    match Check.same(name, "unsupported-regpool") returning Cuda.Kernel with
                    | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.unsupportedRegpoolBody)
                    | Bool.false => {
                      match Check.same(name, "missing-commit") returning Cuda.Kernel with
                      | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.missingCommitBody)
                      | Bool.false => {
                        match Check.same(name, "missing-tma-completion") returning Cuda.Kernel with
                        | Bool.true => TinyGemmApi.removeMissingTmaLoad(actual)
                        | Bool.false => {
                          match Check.same(name, "fuel") returning Cuda.Kernel with
                          | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.fuelBody)
                          | Bool.false => {
                            match Check.same(name, "not-quiescent") returning Cuda.Kernel with
                            | Bool.true => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.notQuiescentBody)
                            | Bool.false => {
                              match Check.same(name, "overlapping-tmem-load") returning Cuda.Kernel with
                              | Bool.true => TinyGemmApi.duplicateFirstTmemLoad(actual)
                              | Bool.false => TinyGemmApi.kernelWithBody(actual, TinyGemmApi.unknownBody)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    def runMutant (name: String)(fuel: Nat): WarpMachine.MachineResult := {
      match TinyGemmApi.prepare(TinyGemmApi.kernel, 17) returning WarpMachine.MachineResult with
      | Option.some prepared => {
        match prepared returning WarpMachine.MachineResult with
        | Prepared.mk original inputs =>
          WarpMachine.run(TinyGemmApi.chooseMutant(original, name), inputs, fuel)
      }
    }
  }

}

{ (Evaluator.TinyGemmApi.kernel, (Evaluator.TinyGemmApi.prepare, (Evaluator.TinyGemmApi.run,
    (Evaluator.TinyGemmApi.inputs, (Evaluator.TinyGemmApi.outputs, (Evaluator.TinyGemmApi.stats,
      (Evaluator.TinyGemmApi.errors, (Evaluator.TinyGemmApi.mutantNames,
        (Evaluator.TinyGemmApi.chooseMutant, Evaluator.TinyGemmApi.runMutant))))))))) }
