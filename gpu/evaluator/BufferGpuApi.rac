// Keep the compiler and source oracle in one module environment so checked CUDA values stay nominally identical.
import Cuda
import buffer.Program
import evaluator.BufferGpuPlan
import evaluator.TinyGemmLibrary

namespace Evaluator {
  namespace BufferGpuApi {
    // The source planner must accept this body-identical kernel independent of its source name.
    def renamedKernel : Cuda.Kernel := {
      match TinyGemmApi.kernel returning Cuda.Kernel with
      | Cuda.Kernel.mk name params dynamicShared body launcher =>
          Cuda.Kernel.mk("buffer-gpu-renamed-kernel", params, dynamicShared, body, launcher)
    }

    // This accessor keeps the benchmark on the generic Buffer.Program representation boundary.
    def programWords (program: Buffer.Program): List(Nat) := Buffer.programWords(program)
  }
}

{
  (Evaluator.TinyGemmApi.kernel,
    (Evaluator.TinyGemmApi.prepare,
      (Evaluator.TinyGemmApi.inputs,
        (Evaluator.TinyGemmApi.run,
          (Evaluator.TinyGemmApi.outputs,
            (Evaluator.TinyGemmApi.stats,
              (Evaluator.TinyGemmApi.errors,
                (Evaluator.TinyGemmApi.mutantNames,
                  (Evaluator.TinyGemmApi.chooseMutant,
                    (Evaluator.TinyGemmApi.runMutant,
                      (Evaluator.BufferGpuPlan.compile,
                        (Evaluator.BufferGpuPlan.run,
                          (Evaluator.BufferGpuPlan.planStats,
                            (Evaluator.BufferGpuPlan.planProgram,
                              (Evaluator.BufferGpuApi.programWords,
                                Evaluator.BufferGpuApi.renamedKernel))))))))))))))) }
