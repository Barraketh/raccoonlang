// Decode the checked TinyGEMM AST trace into generic, typed scheduler operations.
// This module reads only immutable pre-instruction metadata and never executes device data.

import Check
import Cuda
import evaluator.BufferControl
import evaluator.BufferData
import evaluator.BufferKernels
import evaluator.BufferPlan
import evaluator.DeviceApi
import evaluator.WarpExpr

namespace Evaluator {
  namespace BufferGpuDecode {
    def fullWarpMask : Nat := 4294967295
    def dimensionsM : Nat := 128
    def dimensionsN : Nat := 128
    def dimensionsK : Nat := 64
    def ringStart : Nat := 33792
    def ringEnd : Nat := 164864
    def stagingStart : Nat := 1024
    def stagingEnd : Nat := 33792

    inductive Op : Type
     | retire : Op
     | gate (id: Nat)(expectedThreads: Nat)(participants: Nat) : Op
     | barrierInit (address: Nat)(expectedArrivals: Nat) : Op
     | barrierArrive (address: Nat)(arrivals: Nat)(txBytes: Nat) : Op
     | barrierInvalidate (address: Nat) : Op
     | mbarWait (address: Nat)(parity: Nat) : Op
     | issueTmaLoad (request: DeviceApi.DataRequest)(barrier: Nat) : Op
     | issueTmaStore (request: DeviceApi.DataRequest) : Op
     | issueMma (request: DeviceApi.DataRequest) : Op
     | issueTmemLoad (request: DeviceApi.DataRequest)(snapshotOrdinal: Nat) : Op
     | tmemWait : Op
     | tmemAlloc (sharedSlot: Nat)(columns: Nat) : Op
     | tmemFree (address: Nat)(columns: Nat) : Op
     | tcCommit (barrier: Nat) : Op
     | bulkCommit : Op
     | bulkWait (pending: Nat) : Op
     | sharedWrites (actions: List(BufferData.Action)) : Op

    inductive DecodeResult : Type
     | decoded (op: Op) : DecodeResult
     | rejected (code: Nat) : DecodeResult

    def badTrace : Nat := 7100
    def badOperand : Nat := 7101
    def badSharedAddress : Nat := 7103
    def badMask : Nat := 7104
    def unsupported : Nat := 7105

    def evalExpr (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))(expr: Cuda.Expr)
        : BufferPlan.ExprValue :=
      BufferPlan.eval(warp, mask, registers, BufferGpuDecode.dimensionsM,
        BufferGpuDecode.dimensionsN, BufferGpuDecode.dimensionsK, expr)

    def evalUniform (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))(expr: Cuda.Expr)
        : Option(Nat) :=
      BufferPlan.uniformKnown(BufferGpuDecode.evalExpr(warp, mask, registers, expr), mask)

    def laneCount (mask: Nat): Nat := WarpExpr.maskCount(mask)

    def oneLane (mask: Nat): Bool := Nat.beq(BufferGpuDecode.laneCount(mask), 1)

    def fullWarp (mask: Nat): Bool := Nat.beq(mask, BufferGpuDecode.fullWarpMask)

    def aligned (address: Nat)(alignment: Nat): Bool := Nat.isZero(Nat.mod(address, alignment))

    def inSpan (extent: Nat)(address: Nat)(bytes: Nat): Bool :=
      Bool.and(Nat.ble(bytes, extent), Nat.ble(address, Nat.sub(extent, bytes)))

    def sharedAddressOk (sharedBytes: Nat)(address: Nat)(bytes: Nat)(alignment: Nat): Bool :=
      Bool.and(BufferGpuDecode.aligned(address, alignment),
        BufferGpuDecode.inSpan(sharedBytes, address, bytes))

    def barrierAddressOk (sharedBytes: Nat)(address: Nat): Bool :=
      BufferGpuDecode.sharedAddressOk(sharedBytes, address, 8, 8)

    def inputTileAddressOk (sharedBytes: Nat)(address: Nat): Bool :=
      Bool.and(Nat.ble(BufferGpuDecode.ringStart, address),
        Bool.and(Nat.ble(Nat.add(address, 16384), BufferGpuDecode.ringEnd),
          BufferGpuDecode.sharedAddressOk(sharedBytes, address, 16384, 1024)))

    def outputTileAddressOk (sharedBytes: Nat)(address: Nat): Bool :=
      Bool.and(Nat.ble(BufferGpuDecode.stagingStart, address),
        Bool.and(Nat.ble(Nat.add(address, 4096), BufferGpuDecode.stagingEnd),
          BufferGpuDecode.sharedAddressOk(sharedBytes, address, 4096, 1024)))

    def stagingWordAddressOk (sharedBytes: Nat)(address: Nat): Bool :=
      Bool.and(Nat.ble(BufferGpuDecode.stagingStart, address),
        Bool.and(Nat.ble(Nat.add(address, 4), BufferGpuDecode.stagingEnd),
          BufferGpuDecode.sharedAddressOk(sharedBytes, address, 4, 4)))

    def mapExtent (name: String): Option(Nat) := {
      match Check.same(name, "M") returning Option(Nat) with
      | Bool.true => Option.some(BufferGpuDecode.dimensionsM)
      | Bool.false => {
        match Check.same(name, "N") returning Option(Nat) with
        | Bool.true => Option.some(BufferGpuDecode.dimensionsN)
        | Bool.false => {
          match Check.same(name, "K") returning Option(Nat) with
          | Bool.true => Option.some(BufferGpuDecode.dimensionsK)
          | Bool.false => Option.none(Nat)
        }
      }
    }

    def resolvedMap (encoding: Cuda.MapEncoding): Option(DeviceApi.ResolvedMap) := {
      match encoding returning Option(DeviceApi.ResolvedMap) with
      | Cuda.MapEncoding.mk name use source rows cols inner outer => {
        match BufferGpuDecode.mapExtent(rows) returning Option(DeviceApi.ResolvedMap) with
        | Option.none => Option.none(DeviceApi.ResolvedMap)
        | Option.some rowCount => {
          match BufferGpuDecode.mapExtent(cols) returning Option(DeviceApi.ResolvedMap) with
          | Option.none => Option.none(DeviceApi.ResolvedMap)
          | Option.some colCount => Option.some(DeviceApi.ResolvedMap.mk(encoding, rowCount, colCount))
        }
      }
    }

    def findNamedMap (maps: List(Cuda.MapEncoding))(name: String): Option(Cuda.MapEncoding)
        decreases structural(maps) := {
      match maps returning Option(Cuda.MapEncoding) with
      | List.nil => Option.none(Cuda.MapEncoding)
      | List.cons encoding rest => {
        match encoding returning Option(Cuda.MapEncoding) with
        | Cuda.MapEncoding.mk found use source rows cols inner outer => {
          match Check.same(found, name) returning Option(Cuda.MapEncoding) with
          | Bool.true => Option.some(encoding)
          | Bool.false => BufferGpuDecode.findNamedMap(rest, name)
        }
      }
    }

    def countNamedMap (maps: List(Cuda.MapEncoding))(name: String): Nat decreases structural(maps) := {
      match maps returning Nat with
      | List.nil => 0
      | List.cons encoding rest => {
        match encoding returning Nat with
        | Cuda.MapEncoding.mk found use source rows cols inner outer => {
          let tail := BufferGpuDecode.countNamedMap(rest, name)
          Nat.add(tail, Bool.cond(Check.same(found, name), Nat, 1, 0))
        }
      }
    }

    def resolveMapName (kernel: Cuda.Kernel)(name: String): Option(DeviceApi.ResolvedMap) := {
      match kernel returning Option(DeviceApi.ResolvedMap) with
      | Cuda.Kernel.mk kernelName params sharedBytes body launcher => {
        match launcher returning Option(DeviceApi.ResolvedMap) with
        | Option.none => Option.none(DeviceApi.ResolvedMap)
        | Option.some actual => {
          match actual returning Option(DeviceApi.ResolvedMap) with
          | Cuda.Launcher.mk hostParams requires maps grid block => {
            match Nat.beq(BufferGpuDecode.countNamedMap(maps, name), 1) returning Option(DeviceApi.ResolvedMap) with
            | Bool.false => Option.none(DeviceApi.ResolvedMap)
            | Bool.true => {
              match BufferGpuDecode.findNamedMap(maps, name) returning Option(DeviceApi.ResolvedMap) with
              | Option.none => Option.none(DeviceApi.ResolvedMap)
              | Option.some encoding => BufferGpuDecode.resolvedMap(encoding)
            }
          }
        }
      }
    }

    def resolveMapExpr (kernel: Cuda.Kernel)(warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))
        (expr: Cuda.Expr): Option(DeviceApi.ResolvedMap) := {
      match BufferGpuDecode.evalExpr(warp, mask, registers, expr) returning Option(DeviceApi.ResolvedMap) with
      | BufferPlan.ExprValue.mapAddress name => BufferGpuDecode.resolveMapName(kernel, name)
      | _ => Option.none(DeviceApi.ResolvedMap)
    }

    def validInputMap (map: DeviceApi.ResolvedMap): Bool := BufferKernels.validInputMap(map)

    def validOutputMap (map: DeviceApi.ResolvedMap): Bool := BufferKernels.validOutputMap(map)

    def evalSharedDesc (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))(sharedBytes: Nat)
        (descriptor: Cuda.SmemDesc): Option(DeviceApi.OperandDesc) := {
      match descriptor returning Option(DeviceApi.OperandDesc) with
      | Cuda.SmemDesc.mk base lbo step => {
        match BufferGpuDecode.evalUniform(warp, mask, registers, base) returning Option(DeviceApi.OperandDesc) with
        | Option.none => Option.none(DeviceApi.OperandDesc)
        | Option.some address => {
          match BufferGpuDecode.inputTileAddressOk(sharedBytes, address) returning Option(DeviceApi.OperandDesc) with
          | Bool.false => Option.none(DeviceApi.OperandDesc)
          | Bool.true => Option.some(DeviceApi.OperandDesc.mk(address, lbo, step))
        }
      }
    }

    def tmaLoadRequest (kernel: Cuda.Kernel)(warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))
        (sharedBytes: Nat)(group: Cuda.CtaGroup)(dst: Cuda.Expr)(mapExpr: Cuda.Expr)
        (xExpr: Cuda.Expr)(yExpr: Cuda.Expr)(barExpr: Cuda.Expr): Option(Pair(DeviceApi.DataRequest, Nat)) := {
      match group returning Option(Pair(DeviceApi.DataRequest, Nat)) with
      | Cuda.CtaGroup.two => Option.none(Pair(DeviceApi.DataRequest, Nat))
      | Cuda.CtaGroup.one => {
        match BufferGpuDecode.oneLane(mask) returning Option(Pair(DeviceApi.DataRequest, Nat)) with
        | Bool.false => Option.none(Pair(DeviceApi.DataRequest, Nat))
        | Bool.true => {
          match BufferGpuDecode.resolveMapExpr(kernel, warp, mask, registers, mapExpr) returning Option(Pair(DeviceApi.DataRequest, Nat)) with
          | Option.none => Option.none(Pair(DeviceApi.DataRequest, Nat))
          | Option.some map => {
            match BufferGpuDecode.validInputMap(map) returning Option(Pair(DeviceApi.DataRequest, Nat)) with
            | Bool.false => Option.none(Pair(DeviceApi.DataRequest, Nat))
            | Bool.true => {
              match BufferGpuDecode.evalUniform(warp, mask, registers, dst) returning Option(Pair(DeviceApi.DataRequest, Nat)) with
              | Option.none => Option.none(Pair(DeviceApi.DataRequest, Nat))
              | Option.some destination => {
                match BufferGpuDecode.inputTileAddressOk(sharedBytes, destination) returning Option(Pair(DeviceApi.DataRequest, Nat)) with
                | Bool.false => Option.none(Pair(DeviceApi.DataRequest, Nat))
                | Bool.true => {
                  match BufferGpuDecode.evalUniform(warp, mask, registers, xExpr) returning Option(Pair(DeviceApi.DataRequest, Nat)) with
                  | Option.none => Option.none(Pair(DeviceApi.DataRequest, Nat))
                  | Option.some x => {
                    match BufferGpuDecode.evalUniform(warp, mask, registers, yExpr) returning Option(Pair(DeviceApi.DataRequest, Nat)) with
                    | Option.none => Option.none(Pair(DeviceApi.DataRequest, Nat))
                    | Option.some y => {
                      match BufferGpuDecode.evalUniform(warp, mask, registers, barExpr) returning Option(Pair(DeviceApi.DataRequest, Nat)) with
                      | Option.none => Option.none(Pair(DeviceApi.DataRequest, Nat))
                      | Option.some barrier => {
                        match BufferGpuDecode.barrierAddressOk(sharedBytes, barrier) returning Option(Pair(DeviceApi.DataRequest, Nat)) with
                        | Bool.false => Option.none(Pair(DeviceApi.DataRequest, Nat))
                        | Bool.true => Option.some((DeviceApi.DataRequest.tmaLoad(map, destination, x, y), barrier))
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

    def tmaStoreRequest (kernel: Cuda.Kernel)(warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))
        (sharedBytes: Nat)(mapExpr: Cuda.Expr)(xExpr: Cuda.Expr)(yExpr: Cuda.Expr)(srcExpr: Cuda.Expr)
        : Option(DeviceApi.DataRequest) := {
      match BufferGpuDecode.oneLane(mask) returning Option(DeviceApi.DataRequest) with
      | Bool.false => Option.none(DeviceApi.DataRequest)
      | Bool.true => {
        match BufferGpuDecode.resolveMapExpr(kernel, warp, mask, registers, mapExpr) returning Option(DeviceApi.DataRequest) with
        | Option.none => Option.none(DeviceApi.DataRequest)
        | Option.some map => {
          match BufferGpuDecode.validOutputMap(map) returning Option(DeviceApi.DataRequest) with
          | Bool.false => Option.none(DeviceApi.DataRequest)
          | Bool.true => {
            match BufferGpuDecode.evalUniform(warp, mask, registers, xExpr) returning Option(DeviceApi.DataRequest) with
            | Option.none => Option.none(DeviceApi.DataRequest)
            | Option.some x => {
              match BufferGpuDecode.evalUniform(warp, mask, registers, yExpr) returning Option(DeviceApi.DataRequest) with
              | Option.none => Option.none(DeviceApi.DataRequest)
              | Option.some y => {
                match BufferGpuDecode.evalUniform(warp, mask, registers, srcExpr) returning Option(DeviceApi.DataRequest) with
                | Option.none => Option.none(DeviceApi.DataRequest)
                | Option.some source => {
                  match BufferGpuDecode.outputTileAddressOk(sharedBytes, source) returning Option(DeviceApi.DataRequest) with
                  | Bool.false => Option.none(DeviceApi.DataRequest)
                  | Bool.true => Option.some(DeviceApi.DataRequest.tmaStore(map, x, y, source))
                }
              }
            }
          }
        }
      }
    }

    def mmaRequest (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))(sharedBytes: Nat)
        (group: Cuda.CtaGroup)(accExpr: Cuda.Expr)(a: Cuda.MmaA)(b: Cuda.SmemDesc)
        (idesc: Cuda.InstrDesc)(accumulateExpr: Cuda.Expr): Option(DeviceApi.DataRequest) := {
      match group returning Option(DeviceApi.DataRequest) with
      | Cuda.CtaGroup.two => Option.none(DeviceApi.DataRequest)
      | Cuda.CtaGroup.one => {
        match BufferGpuDecode.oneLane(mask) returning Option(DeviceApi.DataRequest) with
        | Bool.false => Option.none(DeviceApi.DataRequest)
        | Bool.true => {
          match BufferGpuDecode.evalUniform(warp, mask, registers, accExpr) returning Option(DeviceApi.DataRequest) with
          | Option.none => Option.none(DeviceApi.DataRequest)
          | Option.some accumulator => {
            match a returning Option(DeviceApi.DataRequest) with
            | Cuda.MmaA.tmem address => Option.none(DeviceApi.DataRequest)
            | Cuda.MmaA.smem aDescriptor => {
              match BufferGpuDecode.evalSharedDesc(warp, mask, registers, sharedBytes, aDescriptor) returning Option(DeviceApi.DataRequest) with
              | Option.none => Option.none(DeviceApi.DataRequest)
              | Option.some aOperand => {
                match BufferGpuDecode.evalSharedDesc(warp, mask, registers, sharedBytes, b) returning Option(DeviceApi.DataRequest) with
                | Option.none => Option.none(DeviceApi.DataRequest)
                | Option.some bOperand => {
                  match BufferGpuDecode.evalUniform(warp, mask, registers, accumulateExpr) returning Option(DeviceApi.DataRequest) with
                  | Option.none => Option.none(DeviceApi.DataRequest)
                  | Option.some accumulate => {
                    let descriptor := DeviceApi.MmaDesc.mk(group, accumulator,
                      DeviceApi.MmaSource.shared(aOperand), bOperand, idesc, accumulate)
                    match BufferKernels.validMma(descriptor) returning Option(DeviceApi.DataRequest) with
                    | Bool.false => Option.none(DeviceApi.DataRequest)
                    | Bool.true => Option.some(DeviceApi.DataRequest.mma(descriptor))
                  }
                }
              }
            }
          }
        }
      }
    }

    def tmemLoadRequest (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))(shape: Cuda.TmemShape)
        (destinations: List(Nat))(addressExpr: Cuda.Expr)(sharedBytes: Nat)(ordinal: Nat)
        : Option(DeviceApi.DataRequest) := {
      match BufferGpuDecode.fullWarp(mask) returning Option(DeviceApi.DataRequest) with
      | Bool.false => Option.none(DeviceApi.DataRequest)
      | Bool.true => {
        match BufferGpuDecode.evalUniform(warp, mask, registers, addressExpr) returning Option(DeviceApi.DataRequest) with
        | Option.none => Option.none(DeviceApi.DataRequest)
        | Option.some address => {
          let groupPosition := Nat.mod(warp, 4)
          let request := DeviceApi.DataRequest.tmemLoad(shape, destinations, address, groupPosition, mask)
          match BufferKernels.validTmemLoad(shape, destinations, address, groupPosition, mask) returning Option(DeviceApi.DataRequest) with
          | Bool.false => Option.none(DeviceApi.DataRequest)
          | Bool.true => {
            match BufferKernels.snapshotOrdinalFits(ordinal) returning Option(DeviceApi.DataRequest) with
            | Bool.false => Option.none(DeviceApi.DataRequest)
            | Bool.true => Option.some(request)
          }
        }
      }
    }

    def validSnapshotKey (key: Nat): Bool := {
      let ordinal := Nat.div(key, 1024)
      let inLoad := Nat.mod(key, 1024)
      let column := Nat.div(inLoad, 128)
      let laneByte := Nat.mod(inLoad, 128)
      Bool.and(BufferKernels.snapshotOrdinalFits(ordinal),
        Bool.and(Nat.blt(column, 8),
          Bool.and(Nat.isZero(Nat.mod(laneByte, 4)), Nat.blt(laneByte, 128))))
    }

    def appendSharedValue (address: Nat)(value: BufferPlan.Scalar): Option(List(BufferData.Action)) := {
      match value returning Option(List(BufferData.Action)) with
      | BufferPlan.Scalar.known number => {
        match Nat.ble(number, 256) returning Option(List(BufferData.Action)) with
        | Bool.false => Option.none(List(BufferData.Action))
        | Bool.true => Option.some(List.cons(BufferData.Action.store32(BufferData.BufferRef.shared,
            BufferData.Expr64.literal(address), BufferData.Expr32.literal(number)), List.nil(BufferData.Action)))
      }
      | BufferPlan.Scalar.payload key => {
        match BufferGpuDecode.validSnapshotKey(key) returning Option(List(BufferData.Action)) with
        | Bool.false => Option.none(List(BufferData.Action))
        | Bool.true => {
          let load := BufferData.Action.load32(BufferData.BufferRef.snapshot,
            BufferData.Expr64.literal(key), BufferKernels.scratch32)
          let store := BufferData.Action.store32(BufferData.BufferRef.shared,
            BufferData.Expr64.literal(address), BufferData.Expr32.ref(BufferKernels.scratch32))
          Option.some(List.cons(load, List.cons(store, List.nil(BufferData.Action))))
        }
      }
      | BufferPlan.Scalar.invalid reason => Option.none(List(BufferData.Action))
    }

    def sharedLaneActions (addresses: List(Nat))(values: List(BufferPlan.Scalar))(mask: Nat)
        (sharedBytes: Nat)(column: Nat)(lane: Nat): Option(List(BufferData.Action))
        decreases structural(addresses) := {
      match addresses returning Option(List(BufferData.Action)) with
      | List.nil => {
        match values returning Option(List(BufferData.Action)) with
        | List.nil => Option.some(List.nil(BufferData.Action))
        | _ => Option.none(List(BufferData.Action))
      }
      | List.cons base restAddresses => {
        match values returning Option(List(BufferData.Action)) with
        | List.nil => Option.none(List(BufferData.Action))
        | List.cons value restValues => {
          let address := Nat.add(base, Nat.mul(column, 4))
          match BufferPlan.maskHas(mask, lane) returning Option(List(BufferData.Action)) with
          | Bool.false => BufferGpuDecode.sharedLaneActions(restAddresses, restValues, mask,
              sharedBytes, column, Nat.succ(lane))
          | Bool.true => {
            match BufferGpuDecode.stagingWordAddressOk(sharedBytes, address) returning Option(List(BufferData.Action)) with
            | Bool.false => Option.none(List(BufferData.Action))
            | Bool.true => {
              match BufferGpuDecode.appendSharedValue(address, value) returning Option(List(BufferData.Action)) with
              | Option.none => Option.none(List(BufferData.Action))
              | Option.some head => {
                match BufferGpuDecode.sharedLaneActions(restAddresses, restValues, mask,
                    sharedBytes, column, Nat.succ(lane)) returning Option(List(BufferData.Action)) with
                | Option.none => Option.none(List(BufferData.Action))
                | Option.some tail => Option.some(List.append(head, tail))
              }
            }
          }
        }
      }
    }

    def sharedColumnsActions (values: List(Cuda.Expr))(addresses: List(Nat))(warp: Nat)(mask: Nat)
        (registers: List(BufferPlan.Register))(sharedBytes: Nat)(column: Nat)
        : Option(List(BufferData.Action)) decreases structural(values) := {
      match values returning Option(List(BufferData.Action)) with
      | List.nil => Option.some(List.nil(BufferData.Action))
      | List.cons expr rest => {
        match BufferGpuDecode.evalExpr(warp, mask, registers, expr) returning Option(List(BufferData.Action)) with
        | BufferPlan.ExprValue.lanes laneValues => {
          match Nat.beq(List.length(laneValues), 32) returning Option(List(BufferData.Action)) with
          | Bool.false => Option.none(List(BufferData.Action))
          | Bool.true => {
            match BufferGpuDecode.sharedLaneActions(addresses, laneValues, mask, sharedBytes, column, 0)
                returning Option(List(BufferData.Action)) with
            | Option.none => Option.none(List(BufferData.Action))
            | Option.some head => {
              match BufferGpuDecode.sharedColumnsActions(rest, addresses, warp, mask, registers,
                  sharedBytes, Nat.succ(column)) returning Option(List(BufferData.Action)) with
              | Option.none => Option.none(List(BufferData.Action))
              | Option.some tail => Option.some(List.append(head, tail))
            }
          }
        }
        | _ => Option.none(List(BufferData.Action))
      }
    }

    def knownAddresses (values: List(BufferPlan.Scalar))(mask: Nat)(lane: Nat): Option(List(Nat))
        decreases structural(values) := {
      match values returning Option(List(Nat)) with
      | List.nil => Option.some(List.nil(Nat))
      | List.cons value rest => {
        match BufferPlan.maskHas(mask, lane) returning Option(List(Nat)) with
        | Bool.false => {
          match BufferGpuDecode.knownAddresses(rest, mask, Nat.succ(lane)) returning Option(List(Nat)) with
          | Option.none => Option.none(List(Nat))
          | Option.some tail => Option.some(List.cons(0, tail))
        }
        | Bool.true => {
          match value returning Option(List(Nat)) with
          | BufferPlan.Scalar.known address => {
            match BufferGpuDecode.aligned(address, 4) returning Option(List(Nat)) with
            | Bool.false => Option.none(List(Nat))
            | Bool.true => {
              match BufferGpuDecode.knownAddresses(rest, mask, Nat.succ(lane)) returning Option(List(Nat)) with
              | Option.none => Option.none(List(Nat))
              | Option.some tail => Option.some(List.cons(address, tail))
            }
          }
          | _ => Option.none(List(Nat))
        }
      }
    }

    def sharedWriteValues (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))
        (sharedBytes: Nat)(baseExpr: Cuda.Expr)(values: List(Cuda.Expr))
        : Option(List(BufferData.Action)) := {
      match BufferGpuDecode.evalExpr(warp, mask, registers, baseExpr) returning Option(List(BufferData.Action)) with
      | BufferPlan.ExprValue.lanes addresses => {
        match Nat.beq(List.length(addresses), 32) returning Option(List(BufferData.Action)) with
        | Bool.false => Option.none(List(BufferData.Action))
        | Bool.true => {
          match BufferGpuDecode.knownAddresses(addresses, mask, 0) returning Option(List(BufferData.Action)) with
          | Option.none => Option.none(List(BufferData.Action))
          | Option.some known => BufferGpuDecode.sharedColumnsActions(values, known, warp, mask,
              registers, sharedBytes, 0)
        }
      }
      | _ => Option.none(List(BufferData.Action))
    }

    def sharedWriteActions (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))
        (sharedBytes: Nat)(baseExpr: Cuda.Expr)(values: List(Cuda.Expr))
        : Option(List(BufferData.Action)) := {
      match Nat.beq(List.length(values), 2) returning Option(List(BufferData.Action)) with
      | Bool.true => BufferGpuDecode.sharedWriteValues(warp, mask, registers, sharedBytes, baseExpr, values)
      | Bool.false => {
        match Nat.beq(List.length(values), 4) returning Option(List(BufferData.Action)) with
        | Bool.false => Option.none(List(BufferData.Action))
        | Bool.true => BufferGpuDecode.sharedWriteValues(warp, mask, registers, sharedBytes, baseExpr, values)
      }
    }

    def decodeArrival (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))
        (address: Nat)(arrival: Cuda.Arrival): DecodeResult := {
      match arrival returning DecodeResult with
      | Cuda.Arrival.one => DecodeResult.decoded(Op.barrierArrive(address, 1, 0))
      | Cuda.Arrival.count countExpr => {
        match BufferGpuDecode.evalUniform(warp, mask, registers, countExpr) returning DecodeResult with
        | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
        | Option.some count => DecodeResult.decoded(Op.barrierArrive(address, count, 0))
      }
      | Cuda.Arrival.expectTx bytesExpr => {
        match BufferGpuDecode.evalUniform(warp, mask, registers, bytesExpr) returning DecodeResult with
        | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
        | Option.some bytes => DecodeResult.decoded(Op.barrierArrive(address, 1, bytes))
      }
    }

    def decodeInstruction (kernel: Cuda.Kernel)(sharedBytes: Nat)(warp: Nat)(mask: Nat)
        (registers: List(BufferPlan.Register))(snapshotOrdinal: Nat)(instruction: Cuda.Instr): DecodeResult := {
      match instruction returning DecodeResult with
      | Cuda.Instr.barSync idExpr threadsExpr => {
        match BufferGpuDecode.evalUniform(warp, mask, registers, idExpr) returning DecodeResult with
        | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
        | Option.some id => {
          match BufferGpuDecode.evalUniform(warp, mask, registers, threadsExpr) returning DecodeResult with
          | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
          | Option.some expected => {
            let valid := Bool.and(Nat.blt(0, id),
              Bool.and(Nat.blt(id, 16), Bool.and(Nat.blt(0, expected),
                Bool.and(Nat.ble(expected, 256),
                  Bool.and(Nat.isZero(Nat.mod(expected, 32)), Nat.blt(0, BufferGpuDecode.laneCount(mask)))))))
            Bool.cond(valid, DecodeResult,
              DecodeResult.decoded(Op.gate(id, expected, BufferGpuDecode.laneCount(mask))),
              DecodeResult.rejected(BufferGpuDecode.badOperand))
          }
        }
      }
      | Cuda.Instr.mbarInit addressExpr countExpr => {
        match BufferGpuDecode.oneLane(mask) returning DecodeResult with
        | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
        | Bool.true => {
          match BufferGpuDecode.evalUniform(warp, mask, registers, addressExpr) returning DecodeResult with
          | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
          | Option.some address => {
            match BufferGpuDecode.barrierAddressOk(sharedBytes, address) returning DecodeResult with
            | Bool.false => DecodeResult.rejected(BufferGpuDecode.badSharedAddress)
            | Bool.true => {
              match BufferGpuDecode.evalUniform(warp, mask, registers, countExpr) returning DecodeResult with
              | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
              | Option.some count => {
                match Nat.blt(0, count) returning DecodeResult with
                | Bool.false => DecodeResult.rejected(BufferGpuDecode.badOperand)
                | Bool.true => DecodeResult.decoded(Op.barrierInit(address, count))
              }
            }
          }
        }
      }
      | Cuda.Instr.mbarArrive window addressExpr arrival => {
        match window returning DecodeResult with
        | Cuda.Window.cluster => DecodeResult.rejected(BufferGpuDecode.unsupported)
        | Cuda.Window.cta => {
          match BufferGpuDecode.oneLane(mask) returning DecodeResult with
          | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
          | Bool.true => {
            match BufferGpuDecode.evalUniform(warp, mask, registers, addressExpr) returning DecodeResult with
            | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
            | Option.some address => {
              match BufferGpuDecode.barrierAddressOk(sharedBytes, address) returning DecodeResult with
              | Bool.false => DecodeResult.rejected(BufferGpuDecode.badSharedAddress)
              | Bool.true => BufferGpuDecode.decodeArrival(warp, mask, registers, address, arrival)
            }
          }
        }
      }
      | Cuda.Instr.mbarInval addressExpr => {
        match BufferGpuDecode.oneLane(mask) returning DecodeResult with
        | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
        | Bool.true => {
          match BufferGpuDecode.evalUniform(warp, mask, registers, addressExpr) returning DecodeResult with
          | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
          | Option.some address => {
            match BufferGpuDecode.barrierAddressOk(sharedBytes, address) returning DecodeResult with
            | Bool.false => DecodeResult.rejected(BufferGpuDecode.badSharedAddress)
            | Bool.true => DecodeResult.decoded(Op.barrierInvalidate(address))
          }
        }
      }
      | Cuda.Instr.mbarWait barrierScope addressExpr parityExpr => {
        match barrierScope returning DecodeResult with
        | Cuda.BarrierScope.cluster => DecodeResult.rejected(BufferGpuDecode.unsupported)
        | Cuda.BarrierScope.cta => {
          match BufferGpuDecode.evalUniform(warp, mask, registers, addressExpr) returning DecodeResult with
          | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
          | Option.some address => {
            match BufferGpuDecode.barrierAddressOk(sharedBytes, address) returning DecodeResult with
            | Bool.false => DecodeResult.rejected(BufferGpuDecode.badSharedAddress)
            | Bool.true => {
              match BufferGpuDecode.evalUniform(warp, mask, registers, parityExpr) returning DecodeResult with
              | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
              | Option.some parity => {
                match Nat.ble(parity, 1) returning DecodeResult with
                | Bool.false => DecodeResult.rejected(BufferGpuDecode.badOperand)
                | Bool.true => DecodeResult.decoded(Op.mbarWait(address, parity))
              }
            }
          }
        }
      }
      | Cuda.Instr.tmaLoad group dst mapExpr xExpr yExpr barrierExpr => {
        match BufferGpuDecode.tmaLoadRequest(kernel, warp, mask, registers, sharedBytes, group,
            dst, mapExpr, xExpr, yExpr, barrierExpr) returning DecodeResult with
        | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
        | Option.some pair => {
          let (request, barrier) := pair
          DecodeResult.decoded(Op.issueTmaLoad(request, barrier))
        }
      }
      | Cuda.Instr.tmaStore mapExpr xExpr yExpr srcExpr => {
        match BufferGpuDecode.tmaStoreRequest(kernel, warp, mask, registers, sharedBytes,
            mapExpr, xExpr, yExpr, srcExpr) returning DecodeResult with
        | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
        | Option.some request => DecodeResult.decoded(Op.issueTmaStore(request))
      }
      | Cuda.Instr.mma group accExpr a b idesc accumulateExpr => {
        match BufferGpuDecode.mmaRequest(warp, mask, registers, sharedBytes,
            group, accExpr, a, b, idesc, accumulateExpr) returning DecodeResult with
        | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
        | Option.some request => DecodeResult.decoded(Op.issueMma(request))
      }
      | Cuda.Instr.tmemLoad shape destinations addressExpr => {
        match BufferGpuDecode.tmemLoadRequest(warp, mask, registers, shape, destinations,
            addressExpr, sharedBytes, snapshotOrdinal) returning DecodeResult with
        | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
        | Option.some request => DecodeResult.decoded(Op.issueTmemLoad(request, snapshotOrdinal))
      }
      | Cuda.Instr.tmemWait what => {
        match what returning DecodeResult with
        | Cuda.TmemWait.store => DecodeResult.rejected(BufferGpuDecode.unsupported)
        | Cuda.TmemWait.load => {
          match BufferGpuDecode.fullWarp(mask) returning DecodeResult with
          | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
          | Bool.true => DecodeResult.decoded(Op.tmemWait)
        }
      }
      | Cuda.Instr.tmemAlloc group slotExpr colsExpr => {
        match group returning DecodeResult with
        | Cuda.CtaGroup.two => DecodeResult.rejected(BufferGpuDecode.unsupported)
        | Cuda.CtaGroup.one => {
          match BufferGpuDecode.fullWarp(mask) returning DecodeResult with
          | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
          | Bool.true => {
            match BufferGpuDecode.evalUniform(warp, mask, registers, slotExpr) returning DecodeResult with
            | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
            | Option.some slot => {
              match BufferGpuDecode.sharedAddressOk(sharedBytes, slot, 4, 4) returning DecodeResult with
              | Bool.false => DecodeResult.rejected(BufferGpuDecode.badSharedAddress)
              | Bool.true => {
                match BufferGpuDecode.evalUniform(warp, mask, registers, colsExpr) returning DecodeResult with
                | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
                | Option.some columns => {
                  match Bool.and(Nat.isZero(slot), Nat.beq(columns, 128)) returning DecodeResult with
                  | Bool.false => DecodeResult.rejected(BufferGpuDecode.unsupported)
                  | Bool.true => DecodeResult.decoded(Op.tmemAlloc(slot, columns))
                }
              }
            }
          }
        }
      }
      | Cuda.Instr.tmemDealloc group addressExpr colsExpr => {
        match group returning DecodeResult with
        | Cuda.CtaGroup.two => DecodeResult.rejected(BufferGpuDecode.unsupported)
        | Cuda.CtaGroup.one => {
          match BufferGpuDecode.fullWarp(mask) returning DecodeResult with
          | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
          | Bool.true => {
            match BufferGpuDecode.evalUniform(warp, mask, registers, addressExpr) returning DecodeResult with
            | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
            | Option.some address => {
              match BufferGpuDecode.evalUniform(warp, mask, registers, colsExpr) returning DecodeResult with
              | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
              | Option.some columns => {
                match Bool.and(Nat.isZero(address), Nat.beq(columns, 128)) returning DecodeResult with
                | Bool.false => DecodeResult.rejected(BufferGpuDecode.unsupported)
                | Bool.true => DecodeResult.decoded(Op.tmemFree(address, columns))
              }
            }
          }
        }
      }
      | Cuda.Instr.tmemRelinquish group => {
        match group returning DecodeResult with
        | Cuda.CtaGroup.two => DecodeResult.rejected(BufferGpuDecode.unsupported)
        | Cuda.CtaGroup.one => Bool.cond(BufferGpuDecode.fullWarp(mask), DecodeResult,
            DecodeResult.decoded(Op.retire), DecodeResult.rejected(BufferGpuDecode.badMask))
      }
      | Cuda.Instr.tcCommit group barrierExpr multicast => {
        match group returning DecodeResult with
        | Cuda.CtaGroup.two => DecodeResult.rejected(BufferGpuDecode.unsupported)
        | Cuda.CtaGroup.one => {
          match multicast returning DecodeResult with
          | Option.some maskValue => DecodeResult.rejected(BufferGpuDecode.unsupported)
          | Option.none => {
            match BufferGpuDecode.oneLane(mask) returning DecodeResult with
            | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
            | Bool.true => {
              match BufferGpuDecode.evalUniform(warp, mask, registers, barrierExpr) returning DecodeResult with
              | Option.none => DecodeResult.rejected(BufferGpuDecode.badOperand)
              | Option.some barrier => {
                match BufferGpuDecode.barrierAddressOk(sharedBytes, barrier) returning DecodeResult with
                | Bool.false => DecodeResult.rejected(BufferGpuDecode.badSharedAddress)
                | Bool.true => DecodeResult.decoded(Op.tcCommit(barrier))
              }
            }
          }
        }
      }
      | Cuda.Instr.bulkCommit => {
        match BufferGpuDecode.oneLane(mask) returning DecodeResult with
        | Bool.true => DecodeResult.decoded(Op.bulkCommit)
        | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
      }
      | Cuda.Instr.bulkWait what pending => {
        match BufferGpuDecode.oneLane(mask) returning DecodeResult with
        | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
        | Bool.true => DecodeResult.decoded(Op.bulkWait(pending))
      }
      | Cuda.Instr.stShared addressExpr values => {
        match BufferGpuDecode.sharedWriteActions(warp, mask, registers, sharedBytes, addressExpr, values)
            returning DecodeResult with
        | Option.none => DecodeResult.rejected(BufferGpuDecode.badSharedAddress)
        | Option.some actions => DecodeResult.decoded(Op.sharedWrites(actions))
      }
      | Cuda.Instr.elect destination => Bool.cond(BufferGpuDecode.fullWarp(mask), DecodeResult,
          DecodeResult.decoded(Op.retire), DecodeResult.rejected(BufferGpuDecode.badMask))
      | Cuda.Instr.shfl destination value sourceLane => Bool.cond(BufferGpuDecode.fullWarp(mask), DecodeResult,
          DecodeResult.decoded(Op.retire), DecodeResult.rejected(BufferGpuDecode.badMask))
      | Cuda.Instr.voteAny destination predicate => Bool.cond(BufferGpuDecode.fullWarp(mask), DecodeResult,
          DecodeResult.decoded(Op.retire), DecodeResult.rejected(BufferGpuDecode.badMask))
      | Cuda.Instr.fenceMbarInit => DecodeResult.decoded(Op.retire)
      | Cuda.Instr.fenceProxyAsync => DecodeResult.decoded(Op.retire)
      | Cuda.Instr.tcFence side => DecodeResult.decoded(Op.retire)
      | _ => DecodeResult.rejected(BufferGpuDecode.unsupported)
    }

    def decode (kernel: Cuda.Kernel)(trace: BufferControl.Trace): DecodeResult := {
      match kernel returning DecodeResult with
      | Cuda.Kernel.mk name params sharedBytes body launcher => {
        match trace returning DecodeResult with
        | BufferControl.Trace.mk warp mask registers postRegisters statement snapshotOrdinal => {
          match Bool.and(Nat.blt(warp, 8), BufferPlan.maskWithinWarp(mask)) returning DecodeResult with
          | Bool.false => DecodeResult.rejected(BufferGpuDecode.badTrace)
          | Bool.true => {
            match statement returning DecodeResult with
            | Cuda.Stmt.sync => DecodeResult.decoded(Op.gate(1000000, 256, BufferGpuDecode.laneCount(mask)))
            | Cuda.Stmt.syncWarp => {
              match BufferGpuDecode.fullWarp(mask) returning DecodeResult with
              | Bool.false => DecodeResult.rejected(BufferGpuDecode.badMask)
              | Bool.true => DecodeResult.decoded(Op.gate(Nat.add(2000000, warp), 32, 32))
            }
            | Cuda.Stmt.instr instruction => BufferGpuDecode.decodeInstruction(kernel, sharedBytes,
                warp, mask, registers, snapshotOrdinal, instruction)
            | Cuda.Stmt.decl dtype id init => DecodeResult.decoded(Op.retire)
            | Cuda.Stmt.declMut dtype id init => DecodeResult.decoded(Op.retire)
            | Cuda.Stmt.declOut dtype id => DecodeResult.decoded(Op.retire)
            | Cuda.Stmt.assign id value => DecodeResult.decoded(Op.retire)
            | Cuda.Stmt.forLoop id start count nested => DecodeResult.decoded(Op.retire)
            | Cuda.Stmt.forStride id start stop step nested => DecodeResult.decoded(Op.retire)
            | Cuda.Stmt.ifElse condition yes no => DecodeResult.decoded(Op.retire)
            | Cuda.Stmt.scoped nested => DecodeResult.decoded(Op.retire)
            | _ => DecodeResult.rejected(BufferGpuDecode.unsupported)
          }
        }
      }
    }
  }
}
