// Exact byte adapters for the evaluator's Z/257 scalar payloads. The generic buffer VM only sees bytes and words.
import evaluator.Ring

namespace Evaluator {
  namespace BufferIO {
    def maxScalar : Nat := Nat.sub(Evaluator.Ring.modulus, 1)
    def maxByte : Nat := 255

    // Consume exactly `expectedCount` ring values, building U16LE bytes in a reversed accumulator.
    def encode16Loop (values: List(Nat))(expectedCount: Nat)(reversed: List(Nat)): Option(List(Nat))
        decreases structural(expectedCount) := {
      match expectedCount returning Option(List(Nat)) with
      | Nat.zero => {
        match values returning Option(List(Nat)) with
        | List.nil => Option.some(List.reverse(reversed))
        | List.cons value rest => Option.none(List(Nat))
      }
      | Nat.succ remaining => {
        match values returning Option(List(Nat)) with
        | List.nil => Option.none(List(Nat))
        | List.cons value rest => {
          match Nat.ble(value, BufferIO.maxScalar) returning Option(List(Nat)) with
          | Bool.false => Option.none(List(Nat))
          | Bool.true => {
            let lowThenHigh := List.cons(Nat.mod(value, 256), reversed)
            let next := List.cons(Nat.div(value, 256), lowThenHigh)
            BufferIO.encode16Loop(rest, remaining, next)
          }
        }
      }
    }

    def encode16 (values: List(Nat))(expectedCount: Nat): Option(List(Nat)) :=
      BufferIO.encode16Loop(values, expectedCount, List.nil(Nat))

    def byteValid (value: Nat): Bool := Nat.ble(value, BufferIO.maxByte)

    def decodeWord (b0: Nat)(b1: Nat)(b2: Nat)(b3: Nat): Nat :=
      Nat.add(b0, Nat.add(Nat.mul(b1, 256),
        Nat.add(Nat.mul(b2, 65536), Nat.mul(b3, 16777216))))

    // Consume four checked bytes per output word, building decoded values in a reversed accumulator.
    def decode32Loop (bytes: List(Nat))(expectedCount: Nat)(reversed: List(Nat)): Option(List(Nat))
        decreases structural(expectedCount) := {
      match expectedCount returning Option(List(Nat)) with
      | Nat.zero => {
        match bytes returning Option(List(Nat)) with
        | List.nil => Option.some(List.reverse(reversed))
        | List.cons byte rest => Option.none(List(Nat))
      }
      | Nat.succ remaining => {
        match bytes returning Option(List(Nat)) with
        | List.nil => Option.none(List(Nat))
        | List.cons b0 tail0 => {
          match tail0 returning Option(List(Nat)) with
          | List.nil => Option.none(List(Nat))
          | List.cons b1 tail1 => {
            match tail1 returning Option(List(Nat)) with
            | List.nil => Option.none(List(Nat))
            | List.cons b2 tail2 => {
              match tail2 returning Option(List(Nat)) with
              | List.nil => Option.none(List(Nat))
              | List.cons b3 rest => {
                let bytesOk := Bool.and(BufferIO.byteValid(b0),
                  Bool.and(BufferIO.byteValid(b1), Bool.and(BufferIO.byteValid(b2), BufferIO.byteValid(b3))))
                match bytesOk returning Option(List(Nat)) with
                | Bool.false => Option.none(List(Nat))
                | Bool.true => {
                  let value := BufferIO.decodeWord(b0, b1, b2, b3)
                  match Nat.ble(value, BufferIO.maxScalar) returning Option(List(Nat)) with
                  | Bool.false => Option.none(List(Nat))
                  | Bool.true => BufferIO.decode32Loop(rest, remaining, List.cons(value, reversed))
                }
              }
            }
          }
        }
      }
    }

    def decode32 (bytes: List(Nat))(expectedCount: Nat): Option(List(Nat)) :=
      BufferIO.decode32Loop(bytes, expectedCount, List.nil(Nat))
  }
}
