// A small exact scalar domain for evaluator experiments. This is arithmetic in Z/257, not a model of CUDA floating
// point or bf16 arithmetic.

namespace Evaluator.Ring {
  def modulus : Nat := 257

  def zero : Nat := 0

  def ofNat (value: Nat): Nat := Nat.mod(value, Evaluator.Ring.modulus)

  def add (left: Nat)(right: Nat): Nat := Nat.mod(Nat.add(left, right), Evaluator.Ring.modulus)

  def mul (left: Nat)(right: Nat): Nat := Nat.mod(Nat.mul(left, right), Evaluator.Ring.modulus)
}
