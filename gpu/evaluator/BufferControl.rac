// Finite static control expansion for a deliberately small subset of the checked CUDA AST.
// It evaluates only compile-time-known scalar controls; no device storage is read or executed here.

import Cuda
import evaluator.BufferPlan

namespace Evaluator {
  namespace BufferControl {
    struct Trace : Type
     | mk (warp: Nat)(activeMask: Nat)(registers: List(BufferPlan.Register))
          (postRegisters: List(BufferPlan.Register))(statement: Cuda.Stmt)(snapshotOrdinal: Nat) : Trace

    // workCount bounds compiler expansion (trace nodes plus loop iterations), not source warp steps.
    struct State : Type
     | mk (registers: List(BufferPlan.Register))(eventsReversed: List(Trace))(workCount: Nat)
          (nextSnapshotOrdinal: Nat) : State

    inductive Result : Type
     | success (state: State) : Result
     | rejected (reason: Nat) : Result

    def findRegister (registers: List(BufferPlan.Register))(id: Nat): Option(BufferPlan.Register)
        decreases structural(registers) := {
      match registers returning Option(BufferPlan.Register) with
      | List.nil => Option.none(BufferPlan.Register)
      | List.cons found rest => {
        match found returning Option(BufferPlan.Register) with
        | BufferPlan.Register.mk foundId values mask => {
          match Nat.beq(foundId, id) returning Option(BufferPlan.Register) with
          | Bool.true => Option.some(found)
          | Bool.false => BufferControl.findRegister(rest, id)
        }
      }
    }

    def replaceRegister (registers: List(BufferPlan.Register))(id: Nat)(values: List(BufferPlan.Scalar))
        (mask: Nat): List(BufferPlan.Register) decreases structural(registers) := {
      match registers returning List(BufferPlan.Register) with
      | List.nil => List.cons(BufferPlan.Register.mk(id, values, mask), List.nil(BufferPlan.Register))
      | List.cons found rest => {
        match found returning List(BufferPlan.Register) with
        | BufferPlan.Register.mk foundId oldValues oldMask => {
          match Nat.beq(foundId, id) returning List(BufferPlan.Register) with
          | Bool.true => List.cons(BufferPlan.Register.mk(id, values, mask), rest)
          | Bool.false => List.cons(found, BufferControl.replaceRegister(rest, id, values, mask))
        }
      }
    }

    def maskUnionLoop (left: Nat)(right: Nat)(lane: Nat)(remaining: Nat)(result: Nat)
        : Nat decreases structural(remaining) := {
      match remaining returning Nat with
      | Nat.zero => result
      | Nat.succ rest => {
        let present := Bool.or(BufferPlan.maskHas(left, lane), BufferPlan.maskHas(right, lane))
        let bit := Bool.cond(present, Nat, Nat.pow(2, lane), 0)
        BufferControl.maskUnionLoop(left, right, Nat.succ(lane), rest, Nat.add(result, bit))
      }
    }

    def maskUnion (left: Nat)(right: Nat): Nat := BufferControl.maskUnionLoop(left, right, 0, 32, 0)

    def mergeValues (fresh: List(BufferPlan.Scalar))(old: List(BufferPlan.Scalar))(mask: Nat)(lane: Nat)
        : Option(List(BufferPlan.Scalar)) decreases structural(fresh) := {
      match fresh returning Option(List(BufferPlan.Scalar)) with
      | List.nil => {
        match old returning Option(List(BufferPlan.Scalar)) with
        | List.nil => Option.some(List.nil(BufferPlan.Scalar))
        | _ => Option.none(List(BufferPlan.Scalar))
      }
      | List.cons next more => {
        match old returning Option(List(BufferPlan.Scalar)) with
        | List.nil => Option.none(List(BufferPlan.Scalar))
        | List.cons previous rest => {
          let selected := Bool.cond(BufferPlan.maskHas(mask, lane), BufferPlan.Scalar, next, previous)
          match BufferControl.mergeValues(more, rest, mask, Nat.succ(lane)) returning Option(List(BufferPlan.Scalar)) with
          | Option.none => Option.none(List(BufferPlan.Scalar))
          | Option.some tail => Option.some(List.cons(selected, tail))
        }
      }
    }

    def writeMasked (registers: List(BufferPlan.Register))(id: Nat)(values: List(BufferPlan.Scalar))
        (mask: Nat): Option(List(BufferPlan.Register)) := {
      match BufferControl.findRegister(registers, id) returning Option(List(BufferPlan.Register)) with
      | Option.none => Option.some(List.cons(BufferPlan.Register.mk(id, values, mask), registers))
      | Option.some found => {
        match found returning Option(List(BufferPlan.Register)) with
        | BufferPlan.Register.mk foundId oldValues oldMask => {
          match BufferControl.mergeValues(values, oldValues, mask, 0) returning Option(List(BufferPlan.Register)) with
          | Option.none => Option.none(List(BufferPlan.Register))
          | Option.some merged => Option.some(BufferControl.replaceRegister(registers, id, merged,
              BufferControl.maskUnion(oldMask, mask)))
        }
      }
    }

    def activeScalarsValid (values: List(BufferPlan.Scalar))(mask: Nat)(lane: Nat)
        : Bool decreases structural(values) := {
      match values returning Bool with
      | List.nil => Bool.true
      | List.cons value rest => {
        match BufferPlan.maskHas(mask, lane) returning Bool with
        | Bool.false => BufferControl.activeScalarsValid(rest, mask, Nat.succ(lane))
        | Bool.true => {
          match value returning Bool with
          | BufferPlan.Scalar.invalid reason => Bool.false
          | _ => BufferControl.activeScalarsValid(rest, mask, Nat.succ(lane))
        }
      }
    }

    def evalLanes (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))(m: Nat)(n: Nat)(k: Nat)
        (expr: Cuda.Expr): Option(List(BufferPlan.Scalar)) := {
      match BufferPlan.eval(warp, mask, registers, m, n, k, expr) returning Option(List(BufferPlan.Scalar)) with
      | BufferPlan.ExprValue.lanes values => {
        match Nat.beq(List.length(values), 32) returning Option(List(BufferPlan.Scalar)) with
        | Bool.false => Option.none(List(BufferPlan.Scalar))
        | Bool.true => {
          match BufferControl.activeScalarsValid(values, mask, 0) returning Option(List(BufferPlan.Scalar)) with
          | Bool.true => Option.some(values)
          | Bool.false => Option.none(List(BufferPlan.Scalar))
        }
      }
      | _ => Option.none(List(BufferPlan.Scalar))
    }

    def pushTraceFrom (state: State)(snapshotRegisters: List(BufferPlan.Register))(warp: Nat)(mask: Nat)
        (statement: Cuda.Stmt): State := {
      match state returning State with
      | State.mk registers events workCount nextSnapshot => {
        let isLoad := {
          match statement returning Bool with
          | Cuda.Stmt.instr instruction => {
            match instruction returning Bool with
            | Cuda.Instr.tmemLoad shape destinations address => Bool.true
            | _ => Bool.false
          }
          | _ => Bool.false
        }
        let followingSnapshot := Bool.cond(isLoad, Nat, Nat.succ(nextSnapshot), nextSnapshot)
        State.mk(registers, List.cons(Trace.mk(warp, mask, snapshotRegisters, registers, statement, nextSnapshot), events),
          Nat.succ(workCount), followingSnapshot)
      }
    }

    def pushTrace (state: State)(warp: Nat)(mask: Nat)(statement: Cuda.Stmt): State := {
      match state returning State with
      | State.mk registers events workCount nextSnapshot => BufferControl.pushTraceFrom(state, registers, warp, mask, statement)
    }

    def declaration (warp: Nat)(mask: Nat)(state: State)(m: Nat)(n: Nat)(k: Nat)(id: Nat)
        (statement: Cuda.Stmt)(init: Cuda.Expr): Result := {
      match state returning Result with
      | State.mk registers events workCount nextSnapshot => {
        match BufferControl.evalLanes(warp, mask, registers, m, n, k, init) returning Result with
        | Option.none => Result.rejected(Nat.add(1000, id))
        | Option.some values => {
          match Nat.beq(List.length(values), 32) returning Result with
          | Bool.false => Result.rejected(2)
          | Bool.true => Result.success(BufferControl.pushTraceFrom(
              State.mk(BufferControl.replaceRegister(registers, id, values, mask), events, workCount, nextSnapshot),
              registers, warp, mask, statement))
        }
      }
    }

    def idIn (ids: List(Nat))(id: Nat): Bool decreases structural(ids) := {
      match ids returning Bool with
      | List.nil => Bool.false
      | List.cons found rest => Bool.or(Nat.beq(found, id), BufferControl.idIn(rest, id))
    }

    mutual {
      def writesBlock (id: Nat)(block: Cuda.Block): Bool decreases structural(block) := {
        match block returning Bool with
        | Cuda.Block.done => Bool.false
        | Cuda.Block.seq statement rest => Bool.or(BufferControl.writesStmt(id, statement),
            BufferControl.writesBlock(id, rest))
      }

      def writesStmt (id: Nat)(statement: Cuda.Stmt): Bool decreases structural(statement) := {
        match statement returning Bool with
        | Cuda.Stmt.decl dtype declared init => Nat.beq(id, declared)
        | Cuda.Stmt.declMut dtype declared init => Nat.beq(id, declared)
        | Cuda.Stmt.declOut dtype declared => Nat.beq(id, declared)
        | Cuda.Stmt.assign target value => Nat.beq(id, target)
        | Cuda.Stmt.forLoop nested start stop body => Bool.or(Nat.beq(id, nested), BufferControl.writesBlock(id, body))
        | Cuda.Stmt.forStride nested start stop step body => Bool.or(Nat.beq(id, nested), BufferControl.writesBlock(id, body))
        | Cuda.Stmt.ifElse condition yes no => Bool.or(BufferControl.writesBlock(id, yes), BufferControl.writesBlock(id, no))
        | Cuda.Stmt.scoped body => BufferControl.writesBlock(id, body)
        | Cuda.Stmt.instr instruction => BufferControl.writesInstr(id, instruction)
        | _ => Bool.false
      }

      def writesInstr (id: Nat)(instruction: Cuda.Instr): Bool decreases structural(instruction) := {
        match instruction returning Bool with
        | Cuda.Instr.tmemLoad shape destinations address => BufferControl.idIn(destinations, id)
        | Cuda.Instr.elect destination => Nat.beq(destination, id)
        | Cuda.Instr.shfl destination value lane => Nat.beq(destination, id)
        | Cuda.Instr.voteAny destination predicate => Nat.beq(destination, id)
        | Cuda.Instr.movF32 destination bits => Nat.beq(destination, id)
        | Cuda.Instr.ex2 destination value => Nat.beq(destination, id)
        | Cuda.Instr.lg2 destination value => Nat.beq(destination, id)
        | Cuda.Instr.ex2Emulated destination value => Nat.beq(destination, id)
        | Cuda.Instr.rcp rounding destination value => Nat.beq(destination, id)
        | Cuda.Instr.cvtBf16x2 destination hi lo => Nat.beq(destination, id)
        | Cuda.Instr.ldRelaxed level destination address => Nat.beq(destination, id)
        | Cuda.Instr.casRelaxed level destination address expected desired => Nat.beq(destination, id)
        | Cuda.Instr.movSpecial destination special => Nat.beq(destination, id)
        | Cuda.Instr.mapa destination address rank => Nat.beq(destination, id)
        | _ => Bool.false
      }
    }

    def tripCount (start: Nat)(stop: Nat)(step: Nat): Option(Nat) := {
      match Nat.isZero(step) returning Option(Nat) with
      | Bool.true => Option.none(Nat)
      | Bool.false => {
        match Nat.blt(start, stop) returning Option(Nat) with
        | Bool.false => Option.some(0)
        | Bool.true => {
          let distance := Nat.sub(stop, start)
          let rounded := Nat.add(distance, Nat.sub(step, 1))
          Option.some(Nat.div(rounded, step))
        }
      }
    }

    def maxTripCount (starts: List(BufferPlan.Scalar))(stops: List(BufferPlan.Scalar))
        (steps: List(BufferPlan.Scalar))(parentMask: Nat)(lane: Nat)(maximum: Nat)
        : Option(Nat) decreases structural(starts) := {
      match starts returning Option(Nat) with
      | List.nil => {
        match stops returning Option(Nat) with
        | List.nil => {
          match steps returning Option(Nat) with
          | List.nil => Option.some(maximum)
          | _ => Option.none(Nat)
        }
        | _ => Option.none(Nat)
      }
      | List.cons start moreStarts => {
        match stops returning Option(Nat) with
        | List.nil => Option.none(Nat)
        | List.cons stop moreStops => {
          match steps returning Option(Nat) with
          | List.nil => Option.none(Nat)
          | List.cons step moreSteps => {
            match BufferPlan.maskHas(parentMask, lane) returning Option(Nat) with
            | Bool.false => BufferControl.maxTripCount(moreStarts, moreStops, moreSteps,
                parentMask, Nat.succ(lane), maximum)
            | Bool.true => {
              match start returning Option(Nat) with
              | BufferPlan.Scalar.known first => {
                match stop returning Option(Nat) with
                | BufferPlan.Scalar.known last => {
                  match step returning Option(Nat) with
                  | BufferPlan.Scalar.known amount => {
                    match BufferControl.tripCount(first, last, amount) returning Option(Nat) with
                    | Option.none => Option.none(Nat)
                    | Option.some trips => {
                      let nextMaximum := Bool.cond(Nat.ble(maximum, trips), Nat, trips, maximum)
                      BufferControl.maxTripCount(moreStarts, moreStops, moreSteps, parentMask,
                        Nat.succ(lane), nextMaximum)
                    }
                  }
                  | _ => Option.none(Nat)
                }
                | _ => Option.none(Nat)
              }
              | _ => Option.none(Nat)
            }
          }
        }
      }
    }

    def loopMask (values: List(BufferPlan.Scalar))(stops: List(BufferPlan.Scalar))
        (parentMask: Nat)(lane: Nat)(mask: Nat): Option(Nat) decreases structural(values) := {
      match values returning Option(Nat) with
      | List.nil => {
        match stops returning Option(Nat) with
        | List.nil => Option.some(mask)
        | _ => Option.none(Nat)
      }
      | List.cons value moreValues => {
        match stops returning Option(Nat) with
        | List.nil => Option.none(Nat)
        | List.cons stop moreStops => {
          match BufferPlan.maskHas(parentMask, lane) returning Option(Nat) with
          | Bool.false => BufferControl.loopMask(moreValues, moreStops, parentMask, Nat.succ(lane), mask)
          | Bool.true => {
            match value returning Option(Nat) with
            | BufferPlan.Scalar.known current => {
              match stop returning Option(Nat) with
              | BufferPlan.Scalar.known bound => {
                let inRange := Nat.blt(current, bound)
                let bit := Bool.cond(inRange, Nat, Nat.pow(2, lane), 0)
                BufferControl.loopMask(moreValues, moreStops, parentMask, Nat.succ(lane), Nat.add(mask, bit))
              }
              | _ => Option.none(Nat)
            }
            | _ => Option.none(Nat)
          }
        }
      }
    }

    def incrementValues (values: List(BufferPlan.Scalar))(steps: List(BufferPlan.Scalar))
        (mask: Nat)(lane: Nat): Option(List(BufferPlan.Scalar)) decreases structural(values) := {
      match values returning Option(List(BufferPlan.Scalar)) with
      | List.nil => {
        match steps returning Option(List(BufferPlan.Scalar)) with
        | List.nil => Option.some(List.nil(BufferPlan.Scalar))
        | _ => Option.none(List(BufferPlan.Scalar))
      }
      | List.cons value moreValues => {
        match steps returning Option(List(BufferPlan.Scalar)) with
        | List.nil => Option.none(List(BufferPlan.Scalar))
        | List.cons amount moreSteps => {
          match BufferPlan.maskHas(mask, lane) returning Option(List(BufferPlan.Scalar)) with
          | Bool.false => {
            match BufferControl.incrementValues(moreValues, moreSteps, mask, Nat.succ(lane))
                returning Option(List(BufferPlan.Scalar)) with
            | Option.none => Option.none(List(BufferPlan.Scalar))
            | Option.some rest => Option.some(List.cons(value, rest))
          }
          | Bool.true => {
            match value returning Option(List(BufferPlan.Scalar)) with
            | BufferPlan.Scalar.known current => {
              match amount returning Option(List(BufferPlan.Scalar)) with
              | BufferPlan.Scalar.known step => {
                match BufferControl.incrementValues(moreValues, moreSteps, mask, Nat.succ(lane))
                    returning Option(List(BufferPlan.Scalar)) with
                | Option.none => Option.none(List(BufferPlan.Scalar))
                | Option.some rest => Option.some(List.cons(BufferPlan.Scalar.known(Nat.add(current, step)), rest))
              }
              | _ => Option.none(List(BufferPlan.Scalar))
            }
            | _ => Option.none(List(BufferPlan.Scalar))
          }
        }
      }
    }

    def iterationTags (remaining: Nat): List(BufferPlan.Scalar) :=
      BufferPlan.repeated(BufferPlan.Scalar.known(0), remaining)

    def warpMask : Nat := Nat.sub(Nat.pow(2, 32), 1)

    def electValuesLoop (mask: Nat)(lane: Nat)(remaining: Nat)(found: Bool)
        : List(BufferPlan.Scalar) decreases structural(remaining) := {
      match remaining returning List(BufferPlan.Scalar) with
      | Nat.zero => List.nil(BufferPlan.Scalar)
      | Nat.succ rest => {
        let active := BufferPlan.maskHas(mask, lane)
        let selected := Bool.and(active, Bool.not(found))
        let value := BufferPlan.Scalar.known(Bool.cond(selected, Nat, 1, 0))
        List.cons(value, BufferControl.electValuesLoop(mask, Nat.succ(lane), rest, Bool.or(found, active)))
      }
    }

    def scalarAt (values: List(BufferPlan.Scalar))(index: Nat): Option(BufferPlan.Scalar)
        decreases structural(values) := {
      match values returning Option(BufferPlan.Scalar) with
      | List.nil => Option.none(BufferPlan.Scalar)
      | List.cons value rest => {
        match index returning Option(BufferPlan.Scalar) with
        | Nat.zero => Option.some(value)
        | Nat.succ more => BufferControl.scalarAt(rest, more)
      }
    }

    def voteAnyLoop (values: List(BufferPlan.Scalar))(mask: Nat)(lane: Nat)(found: Bool)
        (payload: Bool): BufferPlan.Scalar decreases structural(values) := {
      match values returning BufferPlan.Scalar with
      | List.nil => {
        match found returning BufferPlan.Scalar with
        | Bool.true => BufferPlan.Scalar.known(1)
        | Bool.false => Bool.cond(payload, BufferPlan.Scalar, BufferPlan.Scalar.invalid(30),
            BufferPlan.Scalar.known(0))
      }
      | List.cons value rest => {
        match BufferPlan.maskHas(mask, lane) returning BufferPlan.Scalar with
        | Bool.false => BufferControl.voteAnyLoop(rest, mask, Nat.succ(lane), found, payload)
        | Bool.true => {
          match value returning BufferPlan.Scalar with
          | BufferPlan.Scalar.known number => BufferControl.voteAnyLoop(rest, mask, Nat.succ(lane),
              Bool.or(found, Bool.not(Nat.isZero(number))), payload)
          | BufferPlan.Scalar.payload key => BufferControl.voteAnyLoop(rest, mask, Nat.succ(lane), found,
              Bool.true)
          | BufferPlan.Scalar.invalid reason => BufferPlan.Scalar.invalid(reason)
        }
      }
    }

    def pendingLoadTraces (warp: Nat)(traces: List(Trace)): List(Trace) decreases structural(traces) := {
      match traces returning List(Trace) with
      | List.nil => List.nil(Trace)
      | List.cons trace rest => {
        match trace returning List(Trace) with
        | Trace.mk traceWarp mask registers postRegisters statement snapshotOrdinal => {
          match Nat.beq(traceWarp, warp) returning List(Trace) with
          | Bool.false => BufferControl.pendingLoadTraces(warp, rest)
          | Bool.true => {
            match statement returning List(Trace) with
            | Cuda.Stmt.instr instruction => {
              match instruction returning List(Trace) with
              | Cuda.Instr.tmemWait what => {
                match what returning List(Trace) with
                | Cuda.TmemWait.load => List.nil(Trace)
                | Cuda.TmemWait.store => BufferControl.pendingLoadTraces(warp, rest)
              }
              | Cuda.Instr.tmemLoad shape destinations address =>
                  List.cons(trace, BufferControl.pendingLoadTraces(warp, rest))
              | _ => BufferControl.pendingLoadTraces(warp, rest)
            }
            | _ => BufferControl.pendingLoadTraces(warp, rest)
          }
        }
      }
    }

    def payloadLanes (base: Nat)(lane: Nat)(remaining: Nat): List(BufferPlan.Scalar)
        decreases structural(remaining) := {
      match remaining returning List(BufferPlan.Scalar) with
      | Nat.zero => List.nil(BufferPlan.Scalar)
      | Nat.succ rest => List.cons(BufferPlan.Scalar.payload(Nat.add(base, Nat.mul(lane, 4))),
          BufferControl.payloadLanes(base, Nat.succ(lane), rest))
    }

    def publishLoadDestinations (registers: List(BufferPlan.Register))(destinations: List(Nat))(mask: Nat)
        (ordinal: Nat)(column: Nat): Option(List(BufferPlan.Register)) decreases structural(destinations) := {
      match destinations returning Option(List(BufferPlan.Register)) with
      | List.nil => Option.some(registers)
      | List.cons destination rest => {
        let snapshotBase := Nat.add(Nat.mul(ordinal, 1024), Nat.mul(column, 128))
        let values := BufferControl.payloadLanes(snapshotBase, 0, 32)
        match BufferControl.writeMasked(registers, destination, values, mask) returning Option(List(BufferPlan.Register)) with
        | Option.none => Option.none(List(BufferPlan.Register))
        | Option.some changed => BufferControl.publishLoadDestinations(changed, rest, mask, ordinal, Nat.succ(column))
      }
    }

    def publishLoadTraces (registers: List(BufferPlan.Register))(traces: List(Trace))
        : Option(List(BufferPlan.Register)) decreases structural(traces) := {
      match traces returning Option(List(BufferPlan.Register)) with
      | List.nil => Option.some(registers)
      | List.cons trace rest => {
        match trace returning Option(List(BufferPlan.Register)) with
        | Trace.mk warp mask snapshotRegisters postRegisters statement snapshotOrdinal => {
          match statement returning Option(List(BufferPlan.Register)) with
          | Cuda.Stmt.instr instruction => {
            match instruction returning Option(List(BufferPlan.Register)) with
            | Cuda.Instr.tmemLoad shape destinations address => {
              match BufferControl.publishLoadDestinations(registers, destinations, mask, snapshotOrdinal, 0)
                  returning Option(List(BufferPlan.Register)) with
              | Option.none => Option.none(List(BufferPlan.Register))
              | Option.some changed => BufferControl.publishLoadTraces(changed, rest)
            }
            | _ => BufferControl.publishLoadTraces(registers, rest)
          }
          | _ => BufferControl.publishLoadTraces(registers, rest)
        }
      }
    }

    def instructionRegisters (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))
        (priorTraces: List(Trace))(m: Nat)(n: Nat)(k: Nat)(instruction: Cuda.Instr)
        : Option(List(BufferPlan.Register)) := {
      match instruction returning Option(List(BufferPlan.Register)) with
      | Cuda.Instr.elect destination => {
        match Nat.beq(mask, BufferControl.warpMask) returning Option(List(BufferPlan.Register)) with
        | Bool.false => Option.none(List(BufferPlan.Register))
        | Bool.true => BufferControl.writeMasked(registers, destination,
            BufferControl.electValuesLoop(mask, 0, 32, Bool.false), mask)
      }
      | Cuda.Instr.shfl destination value sourceLane => {
        match Bool.and(Nat.beq(mask, BufferControl.warpMask), Nat.blt(sourceLane, 32))
            returning Option(List(BufferPlan.Register)) with
        | Bool.false => Option.none(List(BufferPlan.Register))
        | Bool.true => {
          match BufferControl.evalLanes(warp, mask, registers, m, n, k, value) returning Option(List(BufferPlan.Register)) with
          | Option.none => Option.none(List(BufferPlan.Register))
          | Option.some values => {
            match BufferControl.scalarAt(values, sourceLane) returning Option(List(BufferPlan.Register)) with
            | Option.none => Option.none(List(BufferPlan.Register))
            | Option.some selected => BufferControl.writeMasked(registers, destination,
                BufferPlan.repeated(selected, 32), mask)
          }
        }
      }
      | Cuda.Instr.voteAny destination predicate => {
        match Nat.beq(mask, BufferControl.warpMask) returning Option(List(BufferPlan.Register)) with
        | Bool.false => Option.none(List(BufferPlan.Register))
        | Bool.true => {
          match BufferControl.evalLanes(warp, mask, registers, m, n, k, predicate) returning Option(List(BufferPlan.Register)) with
          | Option.none => Option.none(List(BufferPlan.Register))
          | Option.some values => {
            let result := BufferControl.voteAnyLoop(values, mask, 0, Bool.false, Bool.false)
            match result returning Option(List(BufferPlan.Register)) with
            | BufferPlan.Scalar.invalid reason => Option.none(List(BufferPlan.Register))
            | _ => BufferControl.writeMasked(registers, destination, BufferPlan.repeated(result, 32), mask)
          }
        }
      }
      | Cuda.Instr.tmemLoad shape destinations address => {
        match Bool.and(Nat.beq(mask, BufferControl.warpMask),
            Nat.beq(List.length(destinations), 8))
            returning Option(List(BufferPlan.Register)) with
        | Bool.false => Option.none(List(BufferPlan.Register))
        | Bool.true => {
          match BufferPlan.uniformKnown(BufferPlan.eval(warp, mask, registers, m, n, k, address), mask)
              returning Option(List(BufferPlan.Register)) with
          | Option.none => Option.none(List(BufferPlan.Register))
          | Option.some base => Option.some(registers)
        }
      }
      | Cuda.Instr.tmemWait what => {
        match what returning Option(List(BufferPlan.Register)) with
        | Cuda.TmemWait.store => Option.some(registers)
        | Cuda.TmemWait.load => {
          match Nat.beq(mask, BufferControl.warpMask) returning Option(List(BufferPlan.Register)) with
          | Bool.false => Option.none(List(BufferPlan.Register))
          | Bool.true => BufferControl.publishLoadTraces(registers,
              BufferControl.pendingLoadTraces(warp, priorTraces))
        }
      }
      | Cuda.Instr.movF32 destination bits => Option.none(List(BufferPlan.Register))
      | Cuda.Instr.ex2 destination value => Option.none(List(BufferPlan.Register))
      | Cuda.Instr.lg2 destination value => Option.none(List(BufferPlan.Register))
      | Cuda.Instr.ex2Emulated destination value => Option.none(List(BufferPlan.Register))
      | Cuda.Instr.rcp rounding destination value => Option.none(List(BufferPlan.Register))
      | Cuda.Instr.cvtBf16x2 destination high low => Option.none(List(BufferPlan.Register))
      | Cuda.Instr.ldRelaxed level destination address => Option.none(List(BufferPlan.Register))
      | Cuda.Instr.casRelaxed level destination address expected desired => Option.none(List(BufferPlan.Register))
      | Cuda.Instr.movSpecial destination register => Option.none(List(BufferPlan.Register))
      | Cuda.Instr.mapa destination address rank => Option.none(List(BufferPlan.Register))
      | _ => Option.some(registers)
    }

    def maxExpansionWork : Nat := 200000

    mutual {
    def expandBlock (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))(events: List(Trace))
        (workCount: Nat)(nextSnapshot: Nat)(m: Nat)(n: Nat)(k: Nat)(block: Cuda.Block)
        : Result decreases structural(block) := {
      match Nat.ble(workCount, BufferControl.maxExpansionWork) returning Result with
      | Bool.false => Result.rejected(20)
      | Bool.true => {
        match Nat.isZero(mask) returning Result with
        | Bool.true => Result.success(State.mk(registers, events, workCount, nextSnapshot))
        | Bool.false => {
          match block returning Result with
          | Cuda.Block.done => Result.success(State.mk(registers, events, workCount, nextSnapshot))
          | Cuda.Block.seq statement rest => {
            match BufferControl.expandStmt(warp, mask, State.mk(registers, events, workCount, nextSnapshot), m, n, k, statement)
                returning Result with
            | Result.rejected reason => Result.rejected(reason)
            | Result.success afterStatement => {
              match afterStatement returning Result with
              | State.mk nextRegisters nextEvents nextCount nextSnapshot => BufferControl.expandBlock(warp, mask,
                  nextRegisters, nextEvents, nextCount, nextSnapshot, m, n, k, rest)
            }
          }
        }
      }
    }

    def expandStmt (warp: Nat)(mask: Nat)(state: State)(m: Nat)(n: Nat)(k: Nat)(statement: Cuda.Stmt)
        : Result decreases structural(statement) := {
      match statement returning Result with
      | Cuda.Stmt.decl dtype id init => BufferControl.declaration(warp, mask, state, m, n, k, id, statement, init)
      | Cuda.Stmt.declMut dtype id init => BufferControl.declaration(warp, mask, state, m, n, k, id, statement, init)
      | Cuda.Stmt.declOut dtype id => {
        match state returning Result with
        | State.mk registers events workCount nextSnapshot => Result.success(BufferControl.pushTraceFrom(
            State.mk(BufferControl.replaceRegister(registers, id, BufferPlan.repeated(BufferPlan.Scalar.known(0), 32), 0),
              events, workCount, nextSnapshot), registers, warp, mask, statement))
      }
      | Cuda.Stmt.assign id value => {
        match state returning Result with
        | State.mk registers events workCount nextSnapshot => {
          match BufferControl.findRegister(registers, id) returning Result with
          | Option.none => Result.rejected(4)
          | Option.some target => {
            match BufferControl.evalLanes(warp, mask, registers, m, n, k, value) returning Result with
            | Option.none => Result.rejected(3)
            | Option.some values => {
              match BufferControl.writeMasked(registers, id, values, mask) returning Result with
              | Option.none => Result.rejected(4)
              | Option.some changed => Result.success(BufferControl.pushTraceFrom(State.mk(changed, events, workCount, nextSnapshot),
                  registers, warp, mask, statement))
            }
          }
        }
      }
      | Cuda.Stmt.ifElse condition yes no => {
        match state returning Result with
        | State.mk registers events workCount nextSnapshot => {
          match BufferControl.evalLanes(warp, mask, registers, m, n, k, condition) returning Result with
          | Option.none => Result.rejected(5)
          | Option.some values => {
            match BufferPlan.splitMask(values, mask) returning Result with
            | Option.none => Result.rejected(6)
            | Option.some masks => {
              let (yesMask, noMask) := masks
              let entered := BufferControl.pushTrace(State.mk(registers, events, workCount, nextSnapshot), warp, mask, statement)
              match entered returning Result with
              | State.mk enteredRegisters enteredEvents enteredCount enteredSnapshot =>
              match BufferControl.expandBlock(warp, yesMask, enteredRegisters, enteredEvents, enteredCount,
                  enteredSnapshot, m, n, k, yes) returning Result with
              | Result.rejected reason => Result.rejected(reason)
              | Result.success afterYes => {
                match afterYes returning Result with
                | State.mk yesRegisters yesEvents yesCount yesSnapshot =>
                  BufferControl.expandBlock(warp, noMask, yesRegisters, yesEvents, yesCount, yesSnapshot, m, n, k, no)
              }
            }
          }
        }
      }
      | Cuda.Stmt.scoped body => {
        match state returning Result with
        | State.mk registers events workCount nextSnapshot => {
          let entered := BufferControl.pushTrace(State.mk(registers, events, workCount, nextSnapshot), warp, mask, statement)
          match entered returning Result with
          | State.mk nextRegisters nextEvents nextCount nextSnapshot => BufferControl.expandBlock(warp, mask,
              nextRegisters, nextEvents, nextCount, nextSnapshot, m, n, k, body)
        }
      }
      | Cuda.Stmt.instr instruction => {
        match state returning Result with
        | State.mk registers events workCount nextSnapshot => {
          match BufferControl.instructionRegisters(warp, mask, registers, events, m, n, k, instruction)
              returning Result with
          | Option.none => Result.rejected(26)
          | Option.some changed => Result.success(BufferControl.pushTraceFrom(
              State.mk(changed, events, workCount, nextSnapshot), registers, warp, mask, statement))
        }
      }
      | Cuda.Stmt.sync => {
        match state returning Result with
        | State.mk registers events workCount nextSnapshot => Result.success(
            BufferControl.pushTrace(State.mk(registers, events, workCount, nextSnapshot), warp, mask, statement))
      }
      | Cuda.Stmt.syncWarp => {
        match state returning Result with
        | State.mk registers events workCount nextSnapshot => Result.success(
            BufferControl.pushTrace(State.mk(registers, events, workCount, nextSnapshot), warp, mask, statement))
      }
      | Cuda.Stmt.forLoop id start stop body => {
        match state returning Result with
        | State.mk registers events workCount nextSnapshot => {
          match BufferControl.evalLanes(warp, mask, registers, m, n, k, start) returning Result with
          | Option.none => Result.rejected(7)
          | Option.some starts => {
            match BufferControl.evalLanes(warp, mask, registers, m, n, k, stop) returning Result with
            | Option.none => Result.rejected(7)
            | Option.some stops => {
              match BufferControl.evalLanes(warp, mask, registers, m, n, k, Cuda.Expr.lit(1)) returning Result with
              | Option.none => Result.rejected(7)
              | Option.some steps => {
                match BufferControl.maxTripCount(starts, stops, steps, mask, 0, 0) returning Result with
                | Option.none => Result.rejected(7)
                | Option.some trips => {
                  let initialRegisters := BufferControl.replaceRegister(registers, id, starts, mask)
                  let initial := BufferControl.pushTraceFrom(State.mk(initialRegisters, events, workCount, nextSnapshot),
                    registers, warp, mask, statement)
                  match initial returning Result with
                  | State.mk startRegisters startEvents startWork startSnapshot => {
                  match Nat.ble(Nat.add(startWork, trips), BufferControl.maxExpansionWork) returning Result with
                  | Bool.false => Result.rejected(21)
                  | Bool.true => {
                    match BufferControl.writesBlock(id, body) returning Result with
                    | Bool.true => Result.rejected(22)
                    | Bool.false => {
                      let iterate := fun (prior: Result)(ignored: BufferPlan.Scalar): Result => {
                        match prior returning Result with
                        | Result.rejected reason => Result.rejected(reason)
                        | Result.success before => {
                          match before returning Result with
                          | State.mk beforeRegisters beforeEvents beforeCount beforeSnapshot => {
                            match BufferControl.findRegister(beforeRegisters, id) returning Result with
                            | Option.none => Result.rejected(23)
                            | Option.some loopRegister => {
                              match loopRegister returning Result with
                              | BufferPlan.Register.mk loopId currentValues initialized => {
                                match BufferControl.loopMask(currentValues, stops, mask, 0, 0) returning Result with
                                | Option.none => Result.rejected(24)
                                | Option.some iterationMask => {
                                  match BufferControl.expandBlock(warp, iterationMask, beforeRegisters, beforeEvents,
                                      Nat.succ(beforeCount), beforeSnapshot, m, n, k, body) returning Result with
                                  | Result.rejected reason => Result.rejected(reason)
                                  | Result.success afterBody => {
                                    match afterBody returning Result with
                                    | State.mk bodyRegisters bodyEvents bodyCount bodySnapshot => {
                                      match BufferControl.incrementValues(currentValues, steps, iterationMask, 0)
                                          returning Result with
                                      | Option.none => Result.rejected(25)
                                      | Option.some nextValues => {
                                        match BufferControl.writeMasked(bodyRegisters, id, nextValues, iterationMask)
                                            returning Result with
                                        | Option.none => Result.rejected(23)
                                        | Option.some nextRegisters => Result.success(State.mk(nextRegisters, bodyEvents, bodyCount, bodySnapshot))
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                      List.foldl(BufferControl.iterationTags(trips), Result, Result.success(initial), iterate)
                    }
                  }
                  }
                }
              }
            }
          }
        }
      }
      | Cuda.Stmt.forStride id start stop step body => {
        match state returning Result with
        | State.mk registers events workCount nextSnapshot => {
          match BufferControl.evalLanes(warp, mask, registers, m, n, k, start) returning Result with
          | Option.none => Result.rejected(7)
          | Option.some starts => {
            match BufferControl.evalLanes(warp, mask, registers, m, n, k, stop) returning Result with
            | Option.none => Result.rejected(7)
            | Option.some stops => {
              match BufferControl.evalLanes(warp, mask, registers, m, n, k, step) returning Result with
              | Option.none => Result.rejected(7)
              | Option.some steps => {
                match BufferControl.maxTripCount(starts, stops, steps, mask, 0, 0) returning Result with
                | Option.none => Result.rejected(7)
                | Option.some trips => {
                  let initialRegisters := BufferControl.replaceRegister(registers, id, starts, mask)
                  let initial := BufferControl.pushTraceFrom(State.mk(initialRegisters, events, workCount, nextSnapshot),
                    registers, warp, mask, statement)
                  match initial returning Result with
                  | State.mk startRegisters startEvents startWork startSnapshot => {
                  match Nat.ble(Nat.add(startWork, trips), BufferControl.maxExpansionWork) returning Result with
                  | Bool.false => Result.rejected(21)
                  | Bool.true => {
                    match BufferControl.writesBlock(id, body) returning Result with
                    | Bool.true => Result.rejected(22)
                    | Bool.false => {
                      let iterate := fun (prior: Result)(ignored: BufferPlan.Scalar): Result => {
                        match prior returning Result with
                        | Result.rejected reason => Result.rejected(reason)
                        | Result.success before => {
                          match before returning Result with
                          | State.mk beforeRegisters beforeEvents beforeCount beforeSnapshot => {
                            match BufferControl.findRegister(beforeRegisters, id) returning Result with
                            | Option.none => Result.rejected(23)
                            | Option.some loopRegister => {
                              match loopRegister returning Result with
                              | BufferPlan.Register.mk loopId currentValues initialized => {
                                match BufferControl.loopMask(currentValues, stops, mask, 0, 0) returning Result with
                                | Option.none => Result.rejected(24)
                                | Option.some iterationMask => {
                                  match BufferControl.expandBlock(warp, iterationMask, beforeRegisters, beforeEvents,
                                      Nat.succ(beforeCount), beforeSnapshot, m, n, k, body) returning Result with
                                  | Result.rejected reason => Result.rejected(reason)
                                  | Result.success afterBody => {
                                    match afterBody returning Result with
                                    | State.mk bodyRegisters bodyEvents bodyCount bodySnapshot => {
                                      match BufferControl.incrementValues(currentValues, steps, iterationMask, 0)
                                          returning Result with
                                      | Option.none => Result.rejected(25)
                                      | Option.some nextValues => {
                                        match BufferControl.writeMasked(bodyRegisters, id, nextValues, iterationMask)
                                            returning Result with
                                        | Option.none => Result.rejected(23)
                                        | Option.some nextRegisters => Result.success(State.mk(nextRegisters, bodyEvents, bodyCount, bodySnapshot))
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                      List.foldl(BufferControl.iterationTags(trips), Result, Result.success(initial), iterate)
                    }
                  }
                  }
                }
              }
            }
          }
        }
      }
      | _ => Result.rejected(8)
    }
    }

    // A CTA planner expands warps independently while threading the global trace list,
    // cumulative compiler-work bound, and durable snapshot ordinal through State.
    def expandWarp (warp: Nat)(mask: Nat)(prior: State)(m: Nat)(n: Nat)(k: Nat)(block: Cuda.Block): Result := {
      match BufferPlan.maskWithinWarp(mask) returning Result with
      | Bool.false => Result.rejected(26)
      | Bool.true => {
        match prior returning Result with
        | State.mk previousRegisters events workCount nextSnapshot =>
            BufferControl.expandBlock(warp, mask, List.nil(BufferPlan.Register), events,
              workCount, nextSnapshot, m, n, k, block)
      }
    }

    def expand (warp: Nat)(mask: Nat)(m: Nat)(n: Nat)(k: Nat)(block: Cuda.Block): Result := {
      BufferControl.expandWarp(warp, mask, State.mk(List.nil(BufferPlan.Register), List.nil(Trace), 0, 0),
        m, n, k, block)
    }

    def warpIdsFrom (start: Nat)(remaining: Nat): List(Nat) decreases structural(remaining) := {
      match remaining returning List(Nat) with
      | Nat.zero => List.nil(Nat)
      | Nat.succ more => List.cons(start, BufferControl.warpIdsFrom(Nat.succ(start), more))
    }

    def expandWarps (warps: List(Nat))(state: State)(m: Nat)(n: Nat)(k: Nat)(block: Cuda.Block)
        : Result decreases structural(warps) := {
      match warps returning Result with
      | List.nil => Result.success(state)
      | List.cons warp rest => {
        match BufferControl.expandWarp(warp, BufferControl.warpMask, state, m, n, k, block)
            returning Result with
        | Result.rejected reason => Result.rejected(reason)
        | Result.success next => BufferControl.expandWarps(rest, next, m, n, k, block)
      }
    }

    def addressesAvoidSlotZero (values: List(BufferPlan.Scalar))(mask: Nat)(lane: Nat)
        : Bool decreases structural(values) := {
      match values returning Bool with
      | List.nil => Bool.true
      | List.cons value rest => {
        match BufferPlan.maskHas(mask, lane) returning Bool with
        | Bool.false => BufferControl.addressesAvoidSlotZero(rest, mask, Nat.succ(lane))
        | Bool.true => {
          match value returning Bool with
          | BufferPlan.Scalar.known address => Bool.and(Nat.ble(4, address),
              BufferControl.addressesAvoidSlotZero(rest, mask, Nat.succ(lane)))
          | _ => Bool.false
        }
      }
    }

    def uniformAddressAvoidsSlotZero (warp: Nat)(mask: Nat)(registers: List(BufferPlan.Register))
        (m: Nat)(n: Nat)(k: Nat)(address: Cuda.Expr): Bool := {
      match BufferPlan.uniformKnown(BufferPlan.eval(warp, mask, registers, m, n, k, address), mask)
          returning Bool with
      | Option.some start => Nat.ble(4, start)
      | Option.none => Bool.false
    }

    // The only shared-memory read modeled as a compile-time zero is the u32 allocator slot at
    // byte zero. Prove that no planned operation can overwrite it with payload or nonzero data.
    def slotZeroWritesSafe (traces: List(Trace))(m: Nat)(n: Nat)(k: Nat)
        : Bool decreases structural(traces) := {
      match traces returning Bool with
      | List.nil => Bool.true
      | List.cons trace rest => {
        match trace returning Bool with
        | Trace.mk warp mask registers postRegisters statement snapshotOrdinal => {
          let safe := {
            match statement returning Bool with
            | Cuda.Stmt.instr instruction => {
              match instruction returning Bool with
              | Cuda.Instr.stShared address values => {
                match BufferPlan.eval(warp, mask, registers, m, n, k, address) returning Bool with
                | BufferPlan.ExprValue.lanes addresses =>
                    BufferControl.addressesAvoidSlotZero(addresses, mask, 0)
                | _ => Bool.false
              }
              | Cuda.Instr.tmaLoad group destination map x y barrier => {
                match BufferPlan.uniformKnown(BufferPlan.eval(warp, mask, registers, m, n, k, destination), mask)
                    returning Bool with
                | Option.some start => Nat.ble(4, start)
                | Option.none => Bool.false
              }
              | Cuda.Instr.mbarInit barrier count => BufferControl.uniformAddressAvoidsSlotZero(
                  warp, mask, registers, m, n, k, barrier)
              | Cuda.Instr.mbarInval barrier => BufferControl.uniformAddressAvoidsSlotZero(
                  warp, mask, registers, m, n, k, barrier)
              | Cuda.Instr.mbarArrive window barrier arrival => BufferControl.uniformAddressAvoidsSlotZero(
                  warp, mask, registers, m, n, k, barrier)
              | Cuda.Instr.mbarWait level barrier parity => BufferControl.uniformAddressAvoidsSlotZero(
                  warp, mask, registers, m, n, k, barrier)
              | Cuda.Instr.tmemAlloc group slot cols => {
                match BufferPlan.uniformKnown(BufferPlan.eval(warp, mask, registers, m, n, k, slot), mask)
                    returning Bool with
                | Option.some start => Bool.or(Nat.isZero(start), Nat.ble(4, start))
                | Option.none => Bool.false
              }
              | _ => Bool.true
            }
            | _ => Bool.true
          }
          Bool.and(safe, BufferControl.slotZeroWritesSafe(rest, m, n, k))
        }
      }
    }

    def expandCta (m: Nat)(n: Nat)(k: Nat)(block: Cuda.Block): Result := {
      match BufferControl.expandWarps(BufferControl.warpIdsFrom(0, 8),
          State.mk(List.nil(BufferPlan.Register), List.nil(Trace), 0, 0), m, n, k, block)
          returning Result with
      | Result.rejected reason => Result.rejected(reason)
      | Result.success state => {
        match state returning Result with
        | State.mk registers traces workCount snapshots => {
          match BufferControl.slotZeroWritesSafe(traces, m, n, k) returning Result with
          | Bool.true => Result.success(state)
          | Bool.false => Result.rejected(40)
        }
      }
    }

    // Compact debugging summary: rejected codes start at 2e12; success starts at 1e12, with
    // snapshot count, expansion work, and trace count encoded below that marker.
    def summary (result: Result): Nat := {
      match result returning Nat with
      | Result.rejected reason => Nat.add(2000000000000, reason)
      | Result.success state => {
        match state returning Nat with
        | State.mk registers traces workCount snapshots => Nat.add(1000000000000,
            Nat.add(Nat.mul(snapshots, 1000000000),
              Nat.add(Nat.mul(workCount, 1000), Nat.mod(List.length(traces), 1000))))
      }
    }
  }
}
