// expect: SealedConstructor
// An emitter made from nothing: its code would go nowhere, so operations on it would hand out authority for waits
// that never run. Only Core can start an emitter.
import encoding.Core
namespace T {
  open Core
  open Cuda
  def G : Group := Group.cta(256)

  def kernel : Program := Core.tiledKernel("bad", DType.f32, 16,
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) => {
      let spare := Core.start(Key.key, l, T.G, CtaGroup.one)
      Core.gstore(e, k.c, c, Core.zero(DType.f32))
    })
}
{ Core.render(T.kernel) }
