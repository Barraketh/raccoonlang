// expect: TypeMismatch
// A loop body runs any number of times, so it may not capture a linear value: here it would store the output block
// once per iteration. The body's closure is linear, and `loop` takes an unrestricted one.
import encoding.Core
namespace T {
  open Core
  open Cuda
  def G : Group := Group.cta(256)

  def kernel : Program := Core.tiledKernel("bad", DType.f32, 16,
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) => {
      let body := fun (m: Lifetime)(i: Val(m, Grain.uniform, DType.u32))(e: Ctx(m, T.G))(s: Unit): Pair(Ctx(m, T.G), Unit) =>
        (Core.gstore(e, k.c, c, Core.zero(DType.f32)), s)
      let (e, s) := Core.loop(e, k.k, Core.fixedUnit, Unit.unit, body)
      e
    })
}
{ Core.render(T.kernel) }
