// expect: TypeMismatch
// A role that tries to hand out a value it computed. The value lives in the role's lifetime `m`; the split's result
// type is fixed outside the split and cannot name `m`, so the role's type does not fit.
import encoding.Core
namespace T {
  open Core
  open Cuda
  def G : Group := Group.cta(256)
  def U : Type := Val(Lifetime.empty, Grain.thread, DType.f32)

  def kernel : Program := Core.tiledKernel("bad", DType.f32, 16,
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) => {
      let left := fun (m: Lifetime)(e: Ctx(m, Group.warps(0, 4))): Pair(Ctx(m, Group.warps(0, 4)), T.U) => {
        let (e, r) := Core.reg(e, Core.zero(DType.f32))
        Core.get(e, r)
      }
      let right := fun (m: Lifetime)(e: Ctx(m, Group.warps(4, 4))): Pair(Ctx(m, Group.warps(4, 4)), Unit) => (e, Unit.unit)
      let (e, (v, u)) := Core.split(e, 4, T.U, Unit, left, right)
      Core.gstore(e, k.c, c, v)
    })
}
{ Core.render(T.kernel) }
