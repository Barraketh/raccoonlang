// expect: TypeMismatch
// A shared array declared in a loop body is one array, reused by every iteration. Releasing it while threads may
// still be reading it lets the next iteration's writes race this iteration's reads: `release` takes only an `empty`
// tile, one that passed a barrier after its reads.
import encoding.Core
namespace T {
  open Core
  open Cuda
  def G : Group := Group.cta(256)

  def kernel : Program := Core.tiledKernel("bad", DType.f32, 16,
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) => {
      let (e, acc) := Core.reg(e, Core.zero(DType.f32))
      let body := fun (m: Lifetime)(i: Val(m, Grain.uniform, DType.u32))(e: Ctx(m, T.G))(s: Unit): Pair(Ctx(m, T.G), Unit) => {
        let e := Core.shared(e, DType.f32, 256,
          fun (a: Lifetime)(buf: Smem(a, DType.f32, 256))(t: Tile(a, DType.f32, 256, TileState.empty))(e: Ctx(m, T.G)): Ctx(m, T.G) => {
            let (e, x) := Core.gload(e, k.a, k.row, i)
            let (e, t) := Core.storeMine(e, buf, t, x)
            let (e, t) := Core.sync1(e, t)
            let rd := fun (r: Lifetime)(sr: SRead(a, r, DType.f32, 256))(e: Ctx(m, T.G)): Pair(Ctx(m, T.G), Unit) => {
              let (e, y) := Core.sread(e, buf, sr, Core.lit(255))
              (Core.set(e, acc, y), Unit.unit)
            }
            let (e, (t, u)) := Core.reads(e, t, rd)
            let gone := Core.release(t)
            e
          })
        (e, s)
      }
      let (e, s) := Core.loop(e, k.k, Core.fixedUnit, Unit.unit, body)
      let (e, v) := Core.get(e, acc)
      Core.gstore(e, k.c, c, v)
    })
}
{ Core.render(T.kernel) }
