// Unit tests of code the attention core emits (gpu/ATTENTION.md §6), stated as theorems that checking proves by
// evaluating the rendered kernel. Run by check.sh, which requires this file to check without a diagnostic.
//
// The kernel is a minimal client of the exchange, not a working one (its roles disagree on how many S buffers are
// filled, so it would wait forever): only its code is tested.
// - Tensor memory is split in halves, and the exchange lives in the upper one, so its products' D operand (Ô) and A
//   operand (P) carry the half's offset, 256 columns, through `tmemBase`.
// - The lower half is split again at `E.inner` (128 columns), and the S ring, of one buffer, lives in the second
//   quarter, so the MMA issued into it (`mmaFirstInto`, through the ring's buffer address) carries the offset 128,
//   through `tmemBase` and a nested split. `rejected/split_mutants.py` splits at 32 instead, which the core refuses.
// - The softmax warpgroup, after writing P (`writeP`, here P = S), releases S and spins in `awaitAcc` for the next S
//   before `publishP` (which the types allow), so `publishP` must reconverge the warp with `__syncwarp` before the
//   `.sync.aligned` `tcgen05.wait::st`.
// - The kernel is causal with bf16 output (A2): its key-block count is capped at the query tile's own, the softmax
//   warpgroup masks one chunk of scores (`maskedScores`, whose row needs the warp converged and is declared before the
//   select that takes the minimum), and `storeO` converts every element of O to bf16.

import Check
import encoding.Core
import encoding.Layout

namespace E {
  open Core
  open Cuda
  open Layout

  def box : TmaSpec := TmaSpec.mk(64, 128)
  def vRing : RingCfg := RingCfg.mk(2, box, box)

  // Where the lower half is split: the S ring starts this many columns in.
  def inner : Nat := 128

  // One S into the S ring, from a stage of the V ring; then one product into the exchange.
  def issuer {rv: Lifetime}{q: Lifetime}{x: Lifetime}(vr: Ring(rv, vRing))(accs: AccRing(q, 128))(ex: Exchange(x))(cv: Consumer(rv))
      (ap: AccProducer(q))(rd: ExReader(x))(m: Lifetime)(e: Ctx(m, Issue)): Pair(Ctx(m, Issue), Unit) :=
    elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      let (e, cv) := takeConsumer(e, w, vr, cv)
      let (e, ap) := takeAccProducer(e, w, accs, ap)
      let (e, rd) := takeExReader(e, w, ex, rd)
      let (e, s) := await(e, vr, cv)
      let (e, free) := acquireAcc(e, accs, ap)
      let (e, (sUsed, filling)) := mmaFirstInto(e, w, vr, s, accs, free)
      let (e, cv) := releaseByMma(e, w, vr, sUsed)
      let (e, ap) := commitAcc(e, w, accs, filling)
      let (e, p) := awaitP(e, ex, rd)
      let (e, v) := await(e, vr, cv)
      let (e, (used, vUsed)) := mmaPV(e, w, ex, p, vr, v)
      let (e, cv) := releaseByMma(e, w, vr, vUsed)
      let (e, rd) := commitPV(e, w, ex, used)
      let e := finishAccProducer(e, accs, ap)
      let e := finishConsumer(e, cv)
      (finishExReader(e, rd), Unit.unit)
    })

  // P written from S, S released, a spin in `awaitAcc`, then the publish.
  def writer {l: Lifetime}{q: Lifetime}{x: Lifetime}(g: AttnLaunch(l, box, DType.bf16))(accs: AccRing(q, 128))(ex: Exchange(x))(ac: AccConsumer(q))
      (wr: ExWriter(x))(own: OOwn(l, DType.bf16))(m: Lifetime)(e: Ctx(m, Wg)): Pair(Ctx(m, Wg), Unit) := {
    let (e, c) := takeAccConsumer(e, accs, ac)
    let (e, wa) := takeExWriter(e, ex, wr)
    let (e, one) := fconst(e, 1065353216)
    let v := F32x8.mk(one, one, one, one, one, one, one, one)
    let (e, masked) := maskedScores(e, g.mask, lit(3), 2, v)
    let (e, full) := awaitAcc(e, accs, c)
    let (e, p) := acquireP(e, ex, wa)
    let (e, (full, p)) := writeP(e, accs, full, ex, p,
      fun (ch: Nat)(s: F32x8(m, Grain.thread))(e: Ctx(m, Wg)): Pair(Ctx(m, Wg), F32x8(m, Grain.thread)) => (e, s))
    let (e, c) := releaseAcc(e, accs, full)
    let (e, full) := awaitAcc(e, accs, c)
    let (e, wa) := publishP(e, ex, p)
    let (e, c) := releaseAcc(e, accs, full)
    let (e, final) := finishExWriter(e, ex, wa)
    let (e, final) := storeO(e, ex, final, one, one, g.out, own)
    let e := finishAccConsumer(e, c)
    (closeExWriter(e, final), Unit.unit)
  }

  def kernel : Program :=
    attentionKernel("emitted", Bool.true, DType.bf16,
      fun (l: Lifetime)(e: Ctx(l, Cta))(g: AttnLaunch(l, box, DType.bf16))(own: OOwn(l, DType.bf16))(permit: TmemPermit(l)): Ctx(l, Cta) => {
        // The V ring, around the roles; its loader only takes and finishes the producer.
        let roles := fun (q: Lifetime)(x: Lifetime)(accs: AccRing(q, 128))(ex: Exchange(x))(ap: AccProducer(q))(ac: AccConsumer(q))(wr: ExWriter(x))
            (rd: ExReader(x))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Unit) =>
          withRing(e, vRing, Unit, fun (rv: Lifetime)(vr: Ring(rv, vRing))(pv: Producer(rv))(cv: Consumer(rv))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Unit) =>
            roles4(e, Unit,
              fun (m: Lifetime)(e: Ctx(m, Load)): Pair(Ctx(m, Load), Unit) =>
                elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
                  let (e, pv) := takeProducer(e, w, vr, pv)
                  (finishProducer(e, vr, pv), Unit.unit)
                }),
              fun (m: Lifetime)(e: Ctx(m, Issue)): Pair(Ctx(m, Issue), Unit) => issuer(vr, accs, ex, cv, ap, rd, m, e),
              fun (m: Lifetime)(e: Ctx(m, Wg)): Pair(Ctx(m, Wg), Unit) => writer(g, accs, ex, ac, wr, own, m, e)))
        let regions := fun (a: Lifetime)(t: Tmem(a, 512))(acc: Acc(a, AccState.empty))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Pair(Acc(a, AccState.empty), Unit)) =>
          splitTmem(e, t, acc, 256, Unit, fun (b: Lifetime)(c: Lifetime)(ts: Tmem(b, 256))(accS: Acc(b, AccState.empty))(to: Tmem(c, 256))
              (accO: Acc(c, AccState.empty))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Pair(Pair(Acc(b, AccState.empty), Acc(c, AccState.empty)), Unit)) => {
            let sRing := fun (q: Lifetime)(accs: AccRing(q, 128))(ap: AccProducer(q))(ac: AccConsumer(q))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Acc(c, AccState.empty)) => {
              let (e, (accO, u)) := withExchange(e, to, accO, Unit,
                fun (x: Lifetime)(ex: Exchange(x))(wr: ExWriter(x))(rd: ExReader(x))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Unit) => roles(q, x, accs, ex, ap, ac, wr, rd, e))
              (e, accO)
            }
            let quarters := fun (b1: Lifetime)(b2: Lifetime)(tu: Tmem(b1, inner))(accU: Acc(b1, AccState.empty))(tr: Tmem(b2, Nat.sub(256, inner)))
                (accR: Acc(b2, AccState.empty))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Pair(Pair(Acc(b1, AccState.empty), Acc(b2, AccState.empty)), Acc(c, AccState.empty))) => {
              let (e, (accR, accO)) := withAccRing(e, tr, accR, 1, 128, Acc(c, AccState.empty), sRing)
              (e, ((accU, accR), accO))
            }
            let (e, (accS, accO)) := splitTmem(e, ts, accS, inner, Acc(c, AccState.empty), quarters)
            (e, ((accS, accO), Unit.unit))
          })
        let (e, u) := withTmem(e, permit, 512, AccState.empty, Unit, regions)
        e
      })

  def text : String := Core.render(E.kernel)

  // ---- Reading the text -------------------------------------------------------------------------------------------

  def empty (cs: List(Char)): Bool := {
    match cs returning Bool with
    | List.nil => Bool.true
    | List.cons c more => Bool.false
  }

  // `xs` reversed onto `acc`, in linear time (the prelude's `List.reverse` is quadratic).
  def revOnto {A: Type}(xs: List(A))(acc: List(A)): List(A) decreases structural(xs) := {
    match xs returning List(A) with
    | List.nil => acc
    | List.cons x more => E.revOnto(more, List.cons(x, acc))
  }

  // The lines of `cs`, each without its indentation, in order; `line` is the current line so far, reversed, and `acc`
  // the lines before it, newest first. (Each case is a `match`: `Bool.cond` would evaluate both recursive calls.)
  def linesFrom (cs: List(Char))(line: List(Char))(acc: List(List(Char))): List(List(Char)) decreases structural(cs) := {
    match cs returning List(List(Char)) with
    | List.nil => E.revOnto(List.cons(E.revOnto(line, List.nil(Char)), acc), List.nil(List(Char)))
    | List.cons ch more => {
      match Nat.beq(ch.value, 10) returning List(List(Char)) with
      | Bool.true => E.linesFrom(more, List.nil(Char), List.cons(E.revOnto(line, List.nil(Char)), acc))
      | Bool.false => {
        match Bool.and(Nat.beq(ch.value, 32), E.empty(line)) returning List(List(Char)) with
        | Bool.true => E.linesFrom(more, line, acc)
        | Bool.false => E.linesFrom(more, List.cons(ch, line), acc)
      }
    }
  }

  def lines : List(List(Char)) := E.linesFrom(E.text.data, List.nil(Char), List.nil(List(Char)))

  // How many lines start with `prefix`.
  def starting (prefix: String): Nat := List.length(List.filter(E.lines, fun (l: List(Char)): Bool => Check.startsWith(l, prefix.data)))

  // Whether `want` are the first lines of `ls`.
  def opens (ls: List(List(Char)))(want: List(String)): Bool decreases structural(want) := {
    match want returning Bool with
    | List.nil => Bool.true
    | List.cons w more => {
      match ls returning Bool with
      | List.nil => Bool.false
      | List.cons l rest => Bool.and(Check.sameChars(l, w.data), E.opens(rest, more))
    }
  }

  // Whether `want` occur as consecutive lines of `ls`.
  def occurs (ls: List(List(Char)))(want: List(String)): Bool decreases structural(ls) := {
    match ls returning Bool with
    | List.nil => Bool.false
    | List.cons l rest => Bool.or(E.opens(ls, want), E.occurs(rest, want))
  }

  // ---- The tests -----------------------------------------------------------------------------------------------------

  // A product of the exchange, with P in tensor memory: its template, up to its operands.
  def pvMma : String :=
    "asm volatile(\"{\\n\\t.reg .pred p;\\n\\tsetp.ne.b32 p, %4, 0;\\n\\ttcgen05.mma.cta_group::1.kind::f16 [%0], [%1], %2, %3, p;\\n\\t}\" :  : "

  // v2 is the allocation's address (v0 is the number of key blocks, v1 is −∞). Every one of the 8 products writes Ô at
  // the upper half's first column, v2 + 256, and the first reads P from 128 columns further.
  def pvCount : Eq(Nat, E.starting(E.pvMma), 8) := Eq.refl(8)

  def pvIntoUpperHalf : Eq(Nat, E.starting(Text.cat(E.pvMma, "\"r\"((v2 + 256u)), ")), 8) := Eq.refl(8)

  def pvFirstFromP : Eq(Nat, E.starting(Text.cat(E.pvMma, "\"r\"((v2 + 256u)), \"r\"(((v2 + 256u) + 128u)), ")), 1) := Eq.refl(1)

  // An MMA with both operands in shared memory: its template, up to its operands.
  def ssMma : String :=
    "asm volatile(\"{\\n\\t.reg .pred p;\\n\\tsetp.ne.b32 p, %4, 0;\\n\\ttcgen05.mma.cta_group::1.kind::f16 [%0], %1, %2, %3, p;\\n\\t}\" :  : "

  // The S ring's one buffer starts at the second quarter, v2 + 128 (v3 is the ring's issuing stage): all 4 MMAs of
  // the S write there.
  def sCount : Eq(Nat, E.starting(E.ssMma), 4) := Eq.refl(4)

  def sIntoSecondQuarter : Eq(Nat, E.starting(Text.cat(E.ssMma, "\"r\"(((v2 + 128u) + (v3 * 128u))), ")), 4) := Eq.refl(4)

  // `awaitAcc`'s wait and fence, then `publishP`: the warp reconverges before `wait::st`.
  def syncBeforeWaitSt : Eq(Bool, E.occurs(E.lines, List.cons("asm volatile(\"tcgen05.fence::after_thread_sync;\" :  :  : \"memory\");",
      List.cons("__syncwarp();", List.cons("asm volatile(\"tcgen05.wait::st.sync.aligned;\" :  :  : \"memory\");", List.nil(String))))), Bool.true) :=
    Eq.refl(Bool.true)

  // The causal block count, min(ceil(seq / 128), blockIdx.x + 1), declared once before anything else; then −∞.
  def causalBlocks : Eq(Bool, E.occurs(E.lines,
      List.cons("const unsigned v0 = ((((seq + 127u) / 128u) < (blockIdx.x + 1u)) ? ((seq + 127u) / 128u) : (blockIdx.x + 1u));",
      List.cons("float v1;", List.cons("asm volatile(\"mov.b32 %0, 4286578688;\" : \"=f\"(v1) :  : \"memory\");", List.nil(String))))), Bool.true) :=
    Eq.refl(Bool.true)

  // Chunk 2 of key block 3, masked for this thread's query row q: key 3·128 + 16 + j is kept while below
  // min(seq, q + 1), else −∞ (v1). The warp reconverges before the row's `__shfl_sync`, and the row is declared before
  // the select of the minimum, which would evaluate it in part of the warp only.
  def causalMask : Eq(Bool, E.occurs(E.lines,
      List.cons("const unsigned v16 = ((3u * 128u) + 16u);", List.cons("__syncwarp();",
      List.cons("const unsigned v17 = ((((blockIdx.x * 128u) + ((__shfl_sync(0xffffffffu, threadIdx.x / 32u, 0) % 4u) * 32u)) + (threadIdx.x % 32u)) + 1u);",
      List.cons("const unsigned v18 = ((seq < v17) ? seq : v17);", List.cons("const float v19 = ((v16 < v18) ? v15 : v1);",
      List.cons("const float v20 = (((v16 + 1u) < v18) ? v15 : v1);", List.cons("const float v21 = (((v16 + 2u) < v18) ? v15 : v1);",
      List.cons("const float v22 = (((v16 + 3u) < v18) ? v15 : v1);", List.cons("const float v23 = (((v16 + 4u) < v18) ? v15 : v1);",
      List.cons("const float v24 = (((v16 + 5u) < v18) ? v15 : v1);", List.cons("const float v25 = (((v16 + 6u) < v18) ? v15 : v1);",
      List.cons("const float v26 = (((v16 + 7u) < v18) ? v15 : v1);", List.nil(String)))))))))))))), Bool.true) :=
    Eq.refl(Bool.true)

  // `storeO` writes O's 128 elements of the row, each converted to bf16 in the core.
  def oStores : Eq(Nat, E.starting("O["), 128) := Eq.refl(128)

  def oStoresBf16 : Eq(Nat, E.starting("O[((v220 * 128u) + "), 128) := Eq.refl(128)

  def firstStoreConverted : Eq(Bool, E.occurs(E.lines, List.cons("O[((v220 * 128u) + 0u)] = static_cast<__nv_bfloat16>((v224 * v222));",
      List.nil(String))), Bool.true) := Eq.refl(Bool.true)
}
