// A client's own function over programs forwards `render`'s certificate, stated as `Core.WellFormed`, and a call with
// a concrete program discharges it.
import encoding.Core

namespace T {
  open Core
  open Cuda

  def G : Group := Group.cta(256)

  def show (p: Program)[ok: Core.WellFormed(p)]: String := Core.render(p)[ok]

  def kernel : Program := Core.tiledKernel("copy16", DType.f32, 16,
    fun (l: Lifetime)(e: Ctx(l, T.G))(k: Launch(l, DType.f32, 16))(c: GOwn(l, DType.f32, 16)): Ctx(l, T.G) => {
      let (e, x) := Core.gload(e, k.a, k.row, k.col)
      Core.gstore(e, k.c, c, x)
    })

  def shown : String := T.show(T.kernel)
}
