// Unit tests of the code `fillPage` emits (gpu/encoding/PAGED.md §3), stated as theorems that checking proves by
// evaluating the rendered kernel. Run by check.sh, which requires this file to check without a diagnostic.
//
// The kernel is a minimal client of the paged core, not a working one (its roles fill and read one V stage, issue no
// S, and the product reads a P written from an S that no one issued): only its code is tested. Its loader fills the V
// ring's stage with block `j` = 2^32 − 1, a block index outside every table, which the core must guard:
// - the table is read once, by a load whose guard tests the same index it reads at, and nothing else indexes it;
// - the two TMA loads through the cache's map take their row from that read, `p·128`, at the head's columns
//   `(blockIdx.y % 8)·128` and 64 more, and the kernel issues no TMA store.

import Check
import encoding.Core
import encoding.Layout

namespace P {
  open Core
  open Cuda
  open Layout

  def box : TmaSpec := TmaSpec.mk(64, 128)
  def vRing : RingCfg := RingCfg.mk(2, box, box)

  // One stage of V, from block 2^32 − 1 of this CTA's sequence.
  def loader {l: Lifetime}{rv: Lifetime}(g: PagedLaunch(l, box, DType.f32))(vr: Ring(rv, vRing))(pv: Producer(rv))(m: Lifetime)(e: Ctx(m, Load))
      : Pair(Ctx(m, Load), Unit) :=
    elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      let (e, pv) := takeProducer(e, w, vr, pv)
      let (e, s) := acquire(e, vr, pv)
      let (e, pv) := fillPage(e, vr, s, g.table, g.v, lit(4294967295))
      (finishProducer(e, vr, pv), Unit.unit)
    })

  // One product into the exchange, from that stage; the S ring's issuing side is taken and finished.
  def issuer {rv: Lifetime}{q: Lifetime}{x: Lifetime}(vr: Ring(rv, vRing))(accs: AccRing(q, 128))(ex: Exchange(x))(cv: Consumer(rv))
      (ap: AccProducer(q))(rd: ExReader(x))(m: Lifetime)(e: Ctx(m, Issue)): Pair(Ctx(m, Issue), Unit) :=
    elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      let (e, cv) := takeConsumer(e, w, vr, cv)
      let (e, ap) := takeAccProducer(e, w, accs, ap)
      let (e, rd) := takeExReader(e, w, ex, rd)
      let (e, p) := awaitP(e, ex, rd)
      let (e, v) := await(e, vr, cv)
      let (e, (used, vUsed)) := mmaPV(e, w, ex, p, vr, v)
      let (e, cv) := releaseByMma(e, w, vr, vUsed)
      let (e, rd) := commitPV(e, w, ex, used)
      let e := finishAccProducer(e, accs, ap)
      let e := finishConsumer(e, cv)
      (finishExReader(e, rd), Unit.unit)
    })

  // P written from S, published; then the output.
  def writer {l: Lifetime}{q: Lifetime}{x: Lifetime}(g: PagedLaunch(l, box, DType.f32))(accs: AccRing(q, 128))(ex: Exchange(x))(ac: AccConsumer(q))
      (wr: ExWriter(x))(own: OOwn(l, DType.f32, groupWarp))(m: Lifetime)(e: Ctx(m, Wg)): Pair(Ctx(m, Wg), Unit) := {
    let (e, c) := takeAccConsumer(e, accs, ac)
    let (e, wa) := takeExWriter(e, ex, wr)
    let (e, one) := fconst(e, 1065353216)
    let (e, full) := awaitAcc(e, accs, c)
    let (e, p) := acquireP(e, ex, wa)
    let (e, (full, p)) := writeP(e, accs, full, ex, p,
      fun (ch: Nat)(s: F32x8(m, Grain.thread))(e: Ctx(m, Wg)): Pair(Ctx(m, Wg), F32x8(m, Grain.thread)) => (e, s))
    let (e, c) := releaseAcc(e, accs, full)
    let (e, wa) := publishP(e, ex, p)
    let (e, final) := finishExWriter(e, ex, wa)
    let (e, final) := storeO(e, ex, final, one, one, g.out, own)
    let e := finishAccConsumer(e, c)
    (closeExWriter(e, final), Unit.unit)
  }

  def kernel : Program :=
    pagedAttentionKernel("paged_emitted", 8, Bool.false, DType.f32,
      fun (l: Lifetime)(e: Ctx(l, Cta))(g: PagedLaunch(l, box, DType.f32))(own: OOwn(l, DType.f32, groupWarp))(permit: TmemPermit(l)): Ctx(l, Cta) => {
        // The V ring, around the roles.
        let roles := fun (q: Lifetime)(x: Lifetime)(accs: AccRing(q, 128))(ex: Exchange(x))(ap: AccProducer(q))(ac: AccConsumer(q))(wr: ExWriter(x))
            (rd: ExReader(x))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Unit) =>
          withRing(e, vRing, Unit, fun (rv: Lifetime)(vr: Ring(rv, vRing))(pv: Producer(rv))(cv: Consumer(rv))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Unit) =>
            roles4(e, Unit,
              fun (m: Lifetime)(e: Ctx(m, Load)): Pair(Ctx(m, Load), Unit) => loader(g, vr, pv, m, e),
              fun (m: Lifetime)(e: Ctx(m, Issue)): Pair(Ctx(m, Issue), Unit) => issuer(vr, accs, ex, cv, ap, rd, m, e),
              fun (m: Lifetime)(e: Ctx(m, Wg)): Pair(Ctx(m, Wg), Unit) => writer(g, accs, ex, ac, wr, own, m, e)))
        // Tensor memory: the S ring in the lower half, the exchange in the upper.
        let regions := fun (a: Lifetime)(t: Tmem(a, 512))(acc: Acc(a, AccState.empty))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Pair(Acc(a, AccState.empty), Unit)) =>
          splitTmem(e, t, acc, 256, Unit, fun (b: Lifetime)(c: Lifetime)(ts: Tmem(b, 256))(accS: Acc(b, AccState.empty))(to: Tmem(c, 256))
              (accO: Acc(c, AccState.empty))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Pair(Pair(Acc(b, AccState.empty), Acc(c, AccState.empty)), Unit)) => {
            let sRing := fun (q: Lifetime)(accs: AccRing(q, 128))(ap: AccProducer(q))(ac: AccConsumer(q))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Acc(c, AccState.empty)) => {
              let (e, (accO, u)) := withExchange(e, to, accO, Unit,
                fun (x: Lifetime)(ex: Exchange(x))(wr: ExWriter(x))(rd: ExReader(x))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Unit) => roles(q, x, accs, ex, ap, ac, wr, rd, e))
              (e, accO)
            }
            let (e, (accS, accO)) := withAccRing(e, ts, accS, 1, 128, Acc(c, AccState.empty), sRing)
            (e, ((accS, accO), Unit.unit))
          })
        let (e, u) := withTmem(e, permit, 512, AccState.empty, Unit, regions)
        e
      })

  def text : String := Core.render(P.kernel)

  // ---- Reading the text -------------------------------------------------------------------------------------------

  def empty (cs: List(Char)): Bool := {
    match cs returning Bool with
    | List.nil => Bool.true
    | List.cons c more => Bool.false
  }

  // `xs` reversed onto `acc`, in linear time (the prelude's `List.reverse` is quadratic).
  def revOnto {A: Type}(xs: List(A))(acc: List(A)): List(A) decreases structural(xs) := {
    match xs returning List(A) with
    | List.nil => acc
    | List.cons x more => P.revOnto(more, List.cons(x, acc))
  }

  // The lines of `cs`, each without its indentation, in order; `line` is the current line so far, reversed, and `acc`
  // the lines before it, newest first.
  def linesFrom (cs: List(Char))(line: List(Char))(acc: List(List(Char))): List(List(Char)) decreases structural(cs) := {
    match cs returning List(List(Char)) with
    | List.nil => P.revOnto(List.cons(P.revOnto(line, List.nil(Char)), acc), List.nil(List(Char)))
    | List.cons ch more => {
      match Nat.beq(ch.value, 10) returning List(List(Char)) with
      | Bool.true => P.linesFrom(more, List.nil(Char), List.cons(P.revOnto(line, List.nil(Char)), acc))
      | Bool.false => {
        match Bool.and(Nat.beq(ch.value, 32), P.empty(line)) returning List(List(Char)) with
        | Bool.true => P.linesFrom(more, line, acc)
        | Bool.false => P.linesFrom(more, List.cons(ch, line), acc)
      }
    }
  }

  def lines : List(List(Char)) := P.linesFrom(P.text.data, List.nil(Char), List.nil(List(Char)))

  // Whether `needle` occurs in `cs`.
  def contains (cs: List(Char))(needle: List(Char)): Bool decreases structural(cs) := {
    match cs returning Bool with
    | List.nil => Check.startsWith(cs, needle)
    | List.cons c more => {
      match Check.startsWith(cs, needle) returning Bool with
      | Bool.true => Bool.true
      | Bool.false => P.contains(more, needle)
    }
  }

  // How many lines start with `prefix` and contain `part`. (A `match`, so that only lines with the prefix are searched.)
  def matching (prefix: String)(part: String): Nat :=
    List.length(List.filter(P.lines, fun (l: List(Char)): Bool => {
      match Check.startsWith(l, prefix.data) returning Bool with
      | Bool.true => P.contains(l, part.data)
      | Bool.false => Bool.false
    }))

  // ---- The tests -----------------------------------------------------------------------------------------------------

  // The table is indexed once, by the guarded read of block 2^32 − 1 of sequence `blockIdx.y / 8`: the guard tests the
  // index the read uses.
  def tableIndexedOnce : Eq(Nat, P.matching("", "block_table["), 1) := Eq.refl(1)

  def tableReadGuarded : Eq(Nat, P.matching("const unsigned v",
      " = ((((blockIdx.y / 8u) < B) && (4294967295u < max_pages)) ? block_table[(((blockIdx.y / 8u) * max_pages) + 4294967295u)] : 0u);"), 1) :=
    Eq.refl(1)

  // A TMA load: its template, up to its operands.
  def tmaLoad : String :=
    "asm volatile(\"cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%3, %4}], [%2];\" :  : "

  // The kernel's two TMA loads are V's two boxes, at columns `(blockIdx.y % 8)·128` and 64 more of row `v14·128` (the
  // cache `[pages·128, 8·128]`): v14 is the page read (after the key blocks v0, −∞ v1, the allocation's address v2, the S ring's registers v3 to v6, the
  // exchange's phases v7 and v8, the V ring's registers v9 to v12 and the elect's flag v13).
  def twoLoads : Eq(Nat, P.matching(P.tmaLoad, ""), 2) := Eq.refl(2)

  def bothFromV : Eq(Nat, P.matching(P.tmaLoad, "(&V_map)"), 2) := Eq.refl(2)

  def firstBoxAtPageRow : Eq(Nat, P.matching(P.tmaLoad, "\"r\"(((blockIdx.y % 8u) * 128u)), \"r\"((v14 * 128u)) : \"memory\");"), 1) := Eq.refl(1)

  def secondBoxAtPageRow : Eq(Nat, P.matching(P.tmaLoad, "\"r\"((((blockIdx.y % 8u) * 128u) + 64u)), \"r\"((v14 * 128u)) : \"memory\");"), 1) := Eq.refl(1)

  // No TMA store, so nothing is written through a map.
  def noTmaStore : Eq(Nat, P.matching("", "cp.async.bulk.tensor.2d.global"), 0) := Eq.refl(0)
}
