// Registers as a modelled resource (gpu/encoding/REGISTERS.md): the CTA's register pool and its warpgroups' shares,
// which only this module makes and ends. It emits nothing: emission needs `Core.Key`, which only `Core.rac` can build,
// so `Core` is this module's client, and its emitters of `setmaxnreg` require a share (REGISTERS.md §2).
//
// The rules:
// - A kernel's pool is created by its builder (`pool`): its threads times the uniform budget its threads and residency
//   leave, the count every warp holds outside a split.
// - A split divides the pool among the warpgroups of a 512-thread CTA, one share each, if the counts are ones
//   `setmaxnreg` takes and fit the pool (`fits`). The pool is not used up: a kernel may split any number of times.
// - The join returns the four shares, together. No operation changes a share, so a share exists only between its split
//   and its join, at the count the split gave it (REGISTERS.md §9, decision 3).

namespace Registers {
  // The registers of an SM, 32 bits each.
  def smRegisters : Nat := 65536

  // The registers per thread of a kernel of `threads` threads that means to run `residency` CTAs per SM: its share of
  // the SM's registers, rounded down to the allocation granularity of 8, and at most 255, the most a thread can
  // address.
  def budget (threads: Nat)(residency: Nat): Nat :=
    Nat.min(255, Nat.mul(8, Nat.div(Nat.div(Registers.smRegisters, Nat.mul(threads, residency)), 8)))

  // The register pool of a CTA of `threads` threads, `perThread` registers each, which `setmaxnreg` draws on: evidence
  // of the per-thread count, which the kernel's context does not carry.
  sealed inductive RegPool (l: Lifetime)(threads: Nat)(perThread: Nat) : Type { scope = l }
   | mk : RegPool(l, threads, perThread)

  // The registers of the warpgroup of warps `f` to `f + 3`, at `count` per thread, out of a pool at `perThread`: the
  // count its warps hold before and after the split.
  sealed inductive RegShare (l: Lifetime)(f: Nat)(perThread: Nat)(count: Nat) : Type { kind = lin, scope = l }
   | mk : RegShare(l, f, perThread, count)

  // The pool of a kernel of `threads` threads and `residency` CTAs per SM. Trusted: only a kernel builder calls it,
  // with the threads and residency it compiles for (`__launch_bounds__`), so the pool's per-thread count is the one
  // every warp enters with (OBLIGATIONS.md §7).
  def pool (l: Lifetime)(threads: Nat)(residency: Nat): RegPool(l, threads, Registers.budget(threads, residency)) :=
    RegPool.mk(l, threads, Registers.budget(threads, residency))

  // A count `setmaxnreg` takes: a multiple of 8 from 24 to 256.
  def countOk (count: Nat): Bool := Bool.and(Nat.ble(24, count), Bool.and(Nat.ble(count, 256), Nat.isZero(Nat.mod(count, 8))))

  // Whether four warpgroups' counts fit the pool of a 512-thread CTA at `perThread`: each one `setmaxnreg` takes, and
  // together no more than the pool holds, 128 · (c0 + c1 + c2 + c3) ≤ 512 · perThread.
  def fits (perThread: Nat)(c0: Nat)(c1: Nat)(c2: Nat)(c3: Nat): Bool :=
    Bool.and(Bool.and(Bool.and(Registers.countOk(c0), Registers.countOk(c1)), Bool.and(Registers.countOk(c2), Registers.countOk(c3))),
      Nat.ble(Nat.mul(128, Nat.add(Nat.add(c0, c1), Nat.add(c2, c3))), Nat.mul(512, perThread)))

  // Divides the pool of a 512-thread CTA into its warpgroups' shares, at `c0` to `c3` registers per thread.
  def split {l: Lifetime}{b: Nat}(regs: RegPool(l, 512, b))(c0: Nat)(c1: Nat)(c2: Nat)(c3: Nat)
      [fits: Eq(Bool, Registers.fits(b, c0, c1, c2, c3), Bool.true)]
      : Pair(Pair(RegShare(l, 0, b, c0), RegShare(l, 4, b, c1)), Pair(RegShare(l, 8, b, c2), RegShare(l, 12, b, c3))) :=
    ((RegShare.mk(l, 0, b, c0), RegShare.mk(l, 4, b, c1)), (RegShare.mk(l, 8, b, c2), RegShare.mk(l, 12, b, c3)))

  // Returns the four shares of a split to the pool, together.
  def join {l: Lifetime}{b: Nat}{c0: Nat}{c1: Nat}{c2: Nat}{c3: Nat}
      (s0: RegShare(l, 0, b, c0))(s1: RegShare(l, 4, b, c1))(s2: RegShare(l, 8, b, c2))(s3: RegShare(l, 12, b, c3)): Unit := {
    match s0 returning Unit with
    | RegShare.mk => {
      match s1 returning Unit with
      | RegShare.mk => {
        match s2 returning Unit with
        | RegShare.mk => {
          match s3 returning Unit with
          | RegShare.mk => Unit.unit
        }
      }
    }
  }
}
