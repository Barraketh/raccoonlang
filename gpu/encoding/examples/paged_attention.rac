// Paged forward attention on sm_100a (gpu/encoding/PAGED.md): A1 and A2 (examples/attention.rac) with K and V read
// from a paged cache. For B sequences of `seq` rows and 8 heads each, any `seq` ≥ 1, head dimension 128,
// O = softmax(scale · Q·Kᵀ + mask)·V and LSE, from Q in bf16 `[B·8·seq, 128]` and K and V in bf16 caches
// `[pages·8·128, 128]`, to O `[B·8·seq, 128]` and LSE in f32 `[B·8·seq]`. Page `p` of a cache holds 128 consecutive
// keys of each head, and entry `[b][j]` of the u32 block table `[B, max_pages]` is the page holding keys 128j to
// 128j + 127 of sequence `b`; a sequence's last page may be partly used. The caller passes `scale_log2` =
// scale · log2(e). Two kernels: `paged_attention`, non-causal with O in f32, and `paged_attention_causal`, causal
// within each sequence (prefill: the queries are the cached keys' positions) with O in bf16.
//
// One CTA per 128 query rows of one sequence and head: the roles of `encoding/Attention.rac`, with a loader that reads
// each block of K and V from the page the block table names (`Core.fillPage`, which reads the table itself). A last
// page's unused rows are masked; the causal kernel runs only the key blocks up to its query tile's.
//
// Run: gpu/gen.sh gpu/encoding/examples/paged_attention.rac

import encoding.Core
import encoding.Layout
import encoding.Attention

namespace Paged {
  open Core
  open Cuda
  open Layout
  open Attention

  // The heads of every sequence, a generation-time constant of the kernel.
  def heads : Nat := 8

  def Launch (l: Lifetime)(t: DType) : Type { scope = l } := PagedLaunch(l, box, t)

  // Q's block once, then K_j and V_j for every key block j, each from the page the table names for block j; then wait
  // for every stage to be released.
  def loader {l: Lifetime}{t: DType}{rq: Lifetime}{rk: Lifetime}{rv: Lifetime}(g: Launch(l, t))(qr: Ring(rq, qRing))(kr: Ring(rk, kRing))
      (vr: Ring(rv, vRing))(pq: Producer(rq))(pk: Producer(rk))(pv: Producer(rv))(m: Lifetime)(e: Ctx(m, Load)): Pair(Ctx(m, Load), Unit) :=
    elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      let block := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, One))(st: Pair(ProducerAt(rk, j), ProducerAt(rv, j)))
          : Pair(Ctx(n, One), Pair(ProducerAt(rk, j), ProducerAt(rv, j))) => {
        let (pk, pv) := st
        let (e, s) := acquire(e, kr, pk)
        let (e, pk) := fillPage(e, kr, s, g.table, g.k, i)
        let (e, s) := acquire(e, vr, pv)
        let (e, pv) := fillPage(e, vr, s, g.table, g.v, i)
        (e, (pk, pv))
      }
      let (e, pq) := takeProducer(e, w, qr, pq)
      let (e, pk) := takeProducer(e, w, kr, pk)
      let (e, pv) := takeProducer(e, w, vr, pv)
      let (e, s) := acquire(e, qr, pq)
      let (e, pq) := fillBlock(e, qr, s, g.q, g.q0)
      let (e, (pk, pv)) := loop(e, g.blocks, fixedPair(fixedProducerAt(rk, j), fixedProducerAt(rv, j)), (pk, pv), block)
      let e := finishProducer(e, qr, pq)
      let e := finishProducer(e, kr, pk)
      (finishProducer(e, vr, pv), Unit.unit)
    })

  // The kernel `name`, causal or not, writing O as `t` (f32 or bf16).
  def kernel (name: String)(causal: Bool)(t: DType): Program :=
    pagedAttentionKernel(name, heads, causal, t, fun (l: Lifetime)(e: Ctx(l, Cta))(g: Launch(l, t))(own: OOwn(l, t))(permit: TmemPermit(l))
        : Ctx(l, Cta) =>
      cta(e, permit, g.blocks, g.mask, g.scale, g.out, own, fun (rq: Lifetime)(rk: Lifetime)(rv: Lifetime)(qr: Ring(rq, qRing))
          (kr: Ring(rk, kRing))(vr: Ring(rv, vRing))(pq: Producer(rq))(pk: Producer(rk))(pv: Producer(rv))(m: Lifetime)(e: Ctx(m, Load))
          : Pair(Ctx(m, Load), Unit) => loader(g, qr, kr, vr, pq, pk, pv, m, e)))
}

// The non-causal kernel with f32 output (P1's, now for any `seq`), then the causal one with bf16 output.
{ String.append(Core.render(Paged.kernel("paged_attention", Bool.false, Cuda.DType.f32)),
    Core.render(Paged.kernel("paged_attention_causal", Bool.true, Cuda.DType.bf16))) }
