// TinyGEMM by CTA pairs on sm_100a (gpu/encoding/TWO_CTA.md): C (f32) = A · Bᵀ with A (M×K) and B (N×K) in bf16, one
// 256×256 block of C per pair of CTAs, each CTA computing 128 rows of it.
//
// Both CTAs run the CTA of eight warps of `Layout`. Warp 0 of each elects a thread that streams 64-wide K slices of
// its half into a four-stage pair ring with TMA: its 128 rows of A and its 128 rows of B, the block's columns split
// between the CTAs. Warp 1 of the leader elects a thread that waits for both halves of each stage, issues four
// tcgen05.mma of M = 256 and N = 256 over the pair into the first of two 256-column buffers of the pair's tensor
// memory, and releases the stage in both CTAs by one commit; after the last stage it commits the buffer to both CTAs.
// Warp 1 of the other CTA idles, as do warps 2 and 3. Warps 4 to 7, an aligned warpgroup in each CTA, wait for their
// own CTA's rows of the buffer and store them to C, one element per thread and column.
//
// Run: gpu/gen.sh gpu/encoding/examples/tinygemm_pair.rac

import encoding.Core
import encoding.Layout

namespace TinyPair {
  open Core
  open Cuda
  open Layout

  def boxA : TmaSpec := TmaSpec.mk(64, 128)
  def boxB : TmaSpec := TmaSpec.mk(64, 128)
  def ringCfg : RingCfg := RingCfg.mk(4, boxA, boxB)

  def Launch (l: Lifetime) : Type { scope = l } := PairGemm(l, boxA, boxB)

  // Each CTA's producer: fill its half of one stage per K slice, then wait for every stage to be released.
  def producer {l: Lifetime}{r: Lifetime}(k: Launch(l))(ring: PairRing(r, ringCfg))(steps: Val(l, Grain.uniform, DType.u32))
      (p: Producer(r))(m: Lifetime)(e: Ctx(m, Load)): Pair(Ctx(m, Load), Unit) :=
    elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      let step := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, One))(p: ProducerAt(r, j)): Pair(Ctx(n, One), ProducerAt(r, j)) => {
        let (e, s) := acquirePair(e, ring, p)
        fillPair(e, ring, s, k.tile, k.a, k.b, mulC(i, 64))
      }
      let (e, p) := takePairProducer(e, w, ring, p)
      let (e, p) := loopPeeled(e, steps, fixedProducerAt(r, j), p, step, step)
      (finishPairProducer(e, ring, p), Unit.unit)
    })

  // The leader's MMA issuer: accumulate every stage of both CTAs into the first buffer, releasing each stage when its
  // MMAs complete, then commit the buffer to both CTAs' warpgroups and wait until both have read it.
  def issue {n: Lifetime}{r: Lifetime}{q: Lifetime}{l: Lifetime}(lead: Leader(n))(ring: PairRing(r, ringCfg))(accs: PairAccRing(q, 256))
      (steps: Val(l, Grain.uniform, DType.u32))(sides: Pair(Consumer(r), AccProducer(q)))(e: Ctx(n, Issue)): Ctx(n, Issue) := {
    let (e, u) := elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      let (c, p) := sides
      let first := fun (o: Lifetime)(i: Val(o, Grain.uniform, DType.u32))(e: Ctx(o, One))(st: Pair(ConsumerAt(r, j), AccFree(q, j)))
          : Pair(Ctx(o, One), Pair(ConsumerAt(r, j), AccFilling(q, j))) => {
        let (c, acc) := st
        let (e, rd) := awaitPair(e, ring, c)
        let (e, (used, acc)) := mmaPairFirst(e, w, ring, rd, accs, acc)
        let (e, c) := releasePair(e, w, ring, used)
        (e, (c, acc))
      }
      let rest := fun (o: Lifetime)(i: Val(o, Grain.uniform, DType.u32))(e: Ctx(o, One))(st: Pair(ConsumerAt(r, j), AccFilling(q, j)))
          : Pair(Ctx(o, One), Pair(ConsumerAt(r, j), AccFilling(q, j))) => {
        let (c, acc) := st
        let (e, rd) := awaitPair(e, ring, c)
        let (e, (used, acc)) := mmaPairNext(e, w, ring, rd, accs, acc)
        let (e, c) := releasePair(e, w, ring, used)
        (e, (c, acc))
      }
      let (e, c) := takePairConsumer(e, w, lead, ring, c)
      let (e, p) := takePairAccProducer(e, w, lead, accs, p)
      let (e, free) := acquirePairAcc(e, accs, p)
      let (e, (c, acc)) := loopPeeled(e, steps, fixedPair(fixedConsumerAt(r, j), fixedAccFilling(q, j)), (c, free), first, rest)
      let (e, p) := commitPairAcc(e, w, accs, acc)
      (finishConsumer(finishPairAccProducer(e, accs, p), c), Unit.unit)
    })
    e
  }

  // Warp 1 of each CTA: the issuer in the leader, nothing in the other CTA.
  def issuer {r: Lifetime}{q: Lifetime}{l: Lifetime}(pair: CtaPair(l))(ring: PairRing(r, ringCfg))(accs: PairAccRing(q, 256))
      (steps: Val(l, Grain.uniform, DType.u32))(c: Consumer(r))(p: AccProducer(q))(m: Lifetime)(e: Ctx(m, Issue)): Pair(Ctx(m, Issue), Unit) :=
    (onLeader(e, pair, leaderOnlyPair(leaderOnlyConsumer(ring), leaderOnlyAccProducer(accs)), (c, p),
      fun (n: Lifetime)(lead: Leader(n))(e: Ctx(n, Issue))(sides: Pair(Consumer(r), AccProducer(q))): Ctx(n, Issue) =>
        issue(lead, ring, accs, steps, sides, e)), Unit.unit)

  // Each CTA's epilogue: wait for its rows of the buffer, store them, and release the buffer to the leader.
  def epilogue {l: Lifetime}{q: Lifetime}(k: Launch(l))(accs: PairAccRing(q, 256))(c: AccConsumer(q))(own: HalfOwn(l))
      (m: Lifetime)(e: Ctx(m, Wg)): Pair(Ctx(m, Wg), Unit) := {
    let (e, c) := takePairAccConsumer(e, accs, c)
    let (e, full) := awaitPairAcc(e, accs, c)
    let (e, full) := storeHalf(e, accs, full, k.tile, k.c, own)
    let (e, c) := releasePairAcc(e, accs, full)
    (finishAccConsumer(e, c), Unit.unit)
  }

  def kernel : Program :=
    pairGemmKernel("tinygemm_pair", boxA, boxB, fun (l: Lifetime)(e: Ctx(l, Cta))(k: Launch(l))(own: HalfOwn(l))(pair: CtaPair(l))
        (permit: TmemPermit(l)): Ctx(l, Cta) => {
      let steps := ceilDivC(k.k, 64)
      let body := fun (a: Lifetime)(t: Tmem(a, 512))(acc: Acc(a, AccState.empty))(e: Ctx(l, Cta)): Pair(Ctx(l, Cta), Pair(Acc(a, AccState.empty), Unit)) =>
        withPairAccRing(e, pair, t, acc, 2, 256, Unit, fun (q: Lifetime)(accs: PairAccRing(q, 256))(ap: AccProducer(q))(ac: AccConsumer(q))(e: Ctx(l, Cta))
            : Pair(Ctx(l, Cta), Unit) =>
          withPairRing(e, pair, ringCfg, Unit, fun (r: Lifetime)(ring: PairRing(r, ringCfg))(p: Producer(r))(c: Consumer(r))(e: Ctx(l, Cta))
              : Pair(Ctx(l, Cta), Unit) =>
            roles4(e, Unit,
              fun (m: Lifetime)(e: Ctx(m, Load)): Pair(Ctx(m, Load), Unit) => producer(k, ring, steps, p, m, e),
              fun (m: Lifetime)(e: Ctx(m, Issue)): Pair(Ctx(m, Issue), Unit) => issuer(pair, ring, accs, steps, c, ap, m, e),
              fun (m: Lifetime)(e: Ctx(m, Wg)): Pair(Ctx(m, Wg), Unit) => epilogue(k, accs, ac, own, m, e))))
      let (e, u) := withPairTmem(e, pair, permit, AccState.empty, Unit, body)
      e
    })
}

{ Core.render(TinyPair.kernel) }
