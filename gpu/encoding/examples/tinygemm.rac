// TinyGEMM on sm_100a: C (f32) = A · Bᵀ with A (M×K) and B (N×K) in bf16, one 128×128 block of C per CTA.
//
// Four roles share a CTA of eight warps. Warp 0 elects a thread that streams 64-wide K slices of A and B into a
// four-stage ring with TMA. Warp 1 elects a thread that waits for each stage, issues four tcgen05.mma into a 128-column
// tensor-memory accumulator, and releases the stage by tcgen05.commit; after the last stage it hands the accumulator
// to the epilogue. Warps 2 and 3 idle. Warps 4 to 7, an aligned warpgroup, wait for the handoff and store the block
// 32 columns at a time: each warp reads its quadrant of the accumulator's lanes, writes it into a staging buffer in
// shared memory, and its lane 0 stores the buffer to C with TMA.
//
// Run: gpu/gen.sh gpu/encoding/examples/tinygemm.rac

import encoding.Core

namespace Tiny {
  open Core
  open Cuda

  def boxA : TmaSpec := TmaSpec.mk(64, 128)
  def boxB : TmaSpec := TmaSpec.mk(64, 128)
  def ring : RingCfg := RingCfg.mk(4, Tiny.boxA, Tiny.boxB)

  // The first warp of the epilogue's warpgroup, which must be aligned.
  def epilogueWarp : Nat := 4

  def Cta : Group := Group.cta(256)
  def Wg0 : Group := Group.warps(0, 4)
  def Wg1 : Group := Group.warps(Tiny.epilogueWarp, 4)
  def Load : Group := Group.warps(0, 1)
  def Rest : Group := Group.warps(1, 3)
  def Issue : Group := Group.warps(1, 1)
  def Idle : Group := Group.warps(2, 2)
  def One : Group := Group.lane

  def Launch (l: Lifetime) : Type { scope = l } := TmaLaunch(l, Tiny.boxA, Tiny.boxB)

  // The producer: fill one stage per K slice, then wait for every stage to be released.
  def producer {l: Lifetime}{r: Lifetime}(k: Tiny.Launch(l))(ring: Ring(r, Tiny.ring))(steps: Val(l, Grain.uniform, DType.u32))
      (p: Producer(r))(m: Lifetime)(e: Ctx(m, Tiny.Load)): Pair(Ctx(m, Tiny.Load), ProducerDone(r)) :=
    Core.elect(e, ProducerDone(r), fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, Tiny.One)): Pair(Ctx(j, Tiny.One), ProducerDone(r)) => {
      let step := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Tiny.One))(p: ProducerAt(r, j))
          : Pair(Ctx(n, Tiny.One), ProducerAt(r, j)) => {
        let (e, s) := Core.acquire(e, ring, p)
        Core.fill(e, ring, s, k.a, Core.mulC(i, 64), Core.tileRow0(k.tile), k.b, Core.mulC(i, 64), Core.tileCol0(k.tile))
      }
      let (e, p) := Core.takeProducer(e, w, ring, p)
      let (e, p) := Core.loopPeeled(e, steps, Core.fixedProducerAt(r, j), p, step, step)
      Core.finishProducer(e, ring, p)
    })

  // The MMA issuer: accumulate every stage into tensor memory, releasing each when its MMAs complete, then hand the
  // accumulator to the epilogue.
  def issuer {l: Lifetime}{r: Lifetime}{a: Lifetime}{h: Lifetime}(ring: Ring(r, Tiny.ring))(t: Tmem(a, 128))(hd: AccHandoff(h))
      (steps: Val(l, Grain.uniform, DType.u32))(c: Consumer(r))(acc: Acc(a, AccState.empty))(send: AccSend(h, a))
      (m: Lifetime)(e: Ctx(m, Tiny.Issue)): Pair(Ctx(m, Tiny.Issue), ConsumerDone(r)) :=
    Core.elect(e, ConsumerDone(r), fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, Tiny.One)): Pair(Ctx(j, Tiny.One), ConsumerDone(r)) => {
      let first := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Tiny.One))(st: Pair(ConsumerAt(r, j), Acc(a, AccState.empty)))
          : Pair(Ctx(n, Tiny.One), Pair(ConsumerAt(r, j), AccPending(a, j))) => {
        let (c, acc) := st
        let (e, rd) := Core.await(e, ring, c)
        let (e, (used, acc)) := Core.mmaFirst(e, w, ring, rd, t, acc)
        let (e, c) := Core.releaseByMma(e, w, ring, used)
        (e, (c, acc))
      }
      let rest := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Tiny.One))(st: Pair(ConsumerAt(r, j), AccPending(a, j)))
          : Pair(Ctx(n, Tiny.One), Pair(ConsumerAt(r, j), AccPending(a, j))) => {
        let (c, acc) := st
        let (e, rd) := Core.await(e, ring, c)
        let (e, (used, acc)) := Core.mmaNext(e, w, ring, rd, t, acc)
        let (e, c) := Core.releaseByMma(e, w, ring, used)
        (e, (c, acc))
      }
      let (e, c) := Core.takeConsumer(e, w, ring, c)
      let (e, (c, acc)) := Core.loopPeeled(e, steps,
        Core.fixedPair(Core.fixedConsumerAt(r, j), Core.fixedAccPending(a, j)), (c, acc), first, rest)
      (Core.sendAcc(e, w, hd, send, acc), Core.finishConsumer(c))
    })

  // What the epilogue hands back: the accumulator, still ready, and the storing side, every store complete.
  def EpilogueDone (a: Lifetime)(s: Lifetime) : Type { kind = lin, scope = union(a, s) } := Pair(Acc(a, AccState.ready), StoreDone(s))

  // The epilogue: wait for the accumulator and store this CTA's block of C, a chunk of 32 columns at a time, each
  // through a staging buffer; then wait for the stores.
  def epilogue {l: Lifetime}{a: Lifetime}{h: Lifetime}{s: Lifetime}(k: Tiny.Launch(l))(t: Tmem(a, 128))(hd: AccHandoff(h))
      (recv: AccRecv(h, a))(own: TileOwn(l, 128))(stg: Staging(s))(side: StoreSide(s))(m: Lifetime)(e: Ctx(m, Tiny.Wg1))
      : Pair(Ctx(m, Tiny.Wg1), Tiny.EpilogueDone(a, s)) := {
    let chunk := fun (p: Lifetime)(ch: ChunkAt(p, 128))(co: ChunkOwn(p, 128))(e: Ctx(p, Tiny.Wg1))(st: Pair(Acc(a, AccState.ready), StoreAt(s, m, Tiny.epilogueWarp)))
        : Pair(Ctx(p, Tiny.Wg1), Pair(Acc(a, AccState.ready), StoreAt(s, m, Tiny.epilogueWarp))) => {
      let (acc, sa) := st
      let (e, free) := Core.acquireStage(e, stg, sa)
      let (e, (acc, written)) := Core.stageAcc(e, t, acc, stg, free, ch)
      let (e, fenced) := Core.fenceStage(e, written)
      let (e, sa) := Core.storeStage(e, stg, fenced, k.c, ch, co)
      (e, (acc, sa))
    }
    let (e, acc) := Core.recvAcc(e, hd, recv)
    let (e, sa) := Core.takeStore(e, stg, side)
    let (e, (acc, sa)) := Core.forChunks(e, k.tile, own, Core.fixedPair(Core.fixedAcc(a, AccState.ready), Core.fixedStoreAt(s, m, Tiny.epilogueWarp)), (acc, sa), chunk)
    let (e, done) := Core.finishStores(e, stg, sa)
    (e, (acc, done))
  }

  def roles {l: Lifetime}{r: Lifetime}{a: Lifetime}{h: Lifetime}{s: Lifetime}(k: Tiny.Launch(l))(ring: Ring(r, Tiny.ring))(t: Tmem(a, 128))
      (hd: AccHandoff(h))(stg: Staging(s))(steps: Val(l, Grain.uniform, DType.u32))(p: Producer(r))(c: Consumer(r))(acc: Acc(a, AccState.empty))
      (send: AccSend(h, a))(recv: AccRecv(h, a))(own: TileOwn(l, 128))(side: StoreSide(s))(e: Ctx(l, Tiny.Cta))
      : Pair(Ctx(l, Tiny.Cta), Pair(Pair(ProducerDone(r), ConsumerDone(r)), Tiny.EpilogueDone(a, s))) := {
    let idle := fun (m: Lifetime)(e: Ctx(m, Tiny.Idle)): Pair(Ctx(m, Tiny.Idle), Unit) => (e, Unit.unit)
    let rest := fun (m: Lifetime)(e: Ctx(m, Tiny.Rest)): Pair(Ctx(m, Tiny.Rest), Pair(ConsumerDone(r), Unit)) =>
      Core.split(e, 1, ConsumerDone(r), Unit, fun (n: Lifetime)(e: Ctx(n, Tiny.Issue)): Pair(Ctx(n, Tiny.Issue), ConsumerDone(r)) =>
        Tiny.issuer(ring, t, hd, steps, c, acc, send, n, e), idle)
    let wg0 := fun (m: Lifetime)(e: Ctx(m, Tiny.Wg0)): Pair(Ctx(m, Tiny.Wg0), Pair(ProducerDone(r), Pair(ConsumerDone(r), Unit))) =>
      Core.split(e, 1, ProducerDone(r), Pair(ConsumerDone(r), Unit),
        fun (n: Lifetime)(e: Ctx(n, Tiny.Load)): Pair(Ctx(n, Tiny.Load), ProducerDone(r)) => Tiny.producer(k, ring, steps, p, n, e), rest)
    let wg1 := fun (m: Lifetime)(e: Ctx(m, Tiny.Wg1)): Pair(Ctx(m, Tiny.Wg1), Tiny.EpilogueDone(a, s)) =>
      Tiny.epilogue(k, t, hd, recv, own, stg, side, m, e)
    let (e, ((pd, (cd, u)), done)) :=
      Core.split(e, 4, Pair(ProducerDone(r), Pair(ConsumerDone(r), Unit)), Tiny.EpilogueDone(a, s), wg0, wg1)
    (e, ((pd, cd), done))
  }

  def kernel : Program :=
    Core.tmaGemmKernel("tinygemm", Tiny.boxA, Tiny.boxB,
      fun (l: Lifetime)(e: Ctx(l, Tiny.Cta))(k: Tiny.Launch(l))(own: TileOwn(l, 128))(permit: TmemPermit(l)): Ctx(l, Tiny.Cta) => {
        let steps := Core.ceilDivC(k.k, 64)
        let body := fun (a: Lifetime)(t: Tmem(a, 128))(acc: Acc(a, AccState.empty))(e: Ctx(l, Tiny.Cta))
            : Pair(Ctx(l, Tiny.Cta), Pair(Acc(a, AccState.ready), Unit)) => {
          let handoff := fun (h: Lifetime)(hd: AccHandoff(h))(send: AccSend(h, a))(recv: AccRecv(h, a))(e: Ctx(l, Tiny.Cta))
              : Pair(Ctx(l, Tiny.Cta), Acc(a, AccState.ready)) =>
            Core.withStaging(e, 2, Acc(a, AccState.ready), fun (s: Lifetime)(stg: Staging(s))(side: StoreSide(s))(e: Ctx(l, Tiny.Cta))
                : Pair(Ctx(l, Tiny.Cta), Pair(StoreDone(s), Acc(a, AccState.ready))) => {
              let (e, (acc, done)) := Core.withRing(e, Tiny.ring, Tiny.EpilogueDone(a, s),
                fun (r: Lifetime)(ring: Ring(r, Tiny.ring))(p: Producer(r))(c: Consumer(r))(e: Ctx(l, Tiny.Cta))
                    : Pair(Ctx(l, Tiny.Cta), Pair(Pair(ProducerDone(r), ConsumerDone(r)), Tiny.EpilogueDone(a, s))) =>
                  Tiny.roles(k, ring, t, hd, stg, steps, p, c, acc, send, recv, own, side, e))
              (e, (done, acc))
            })
          let (e, acc) := Core.withAccHandoff(e, t, handoff)
          (e, (acc, Unit.unit))
        }
        let (e, u) := Core.withTmem(e, permit, 128, AccState.ready, Unit, body)
        e
      })
}

{ Core.render(Tiny.kernel) }
