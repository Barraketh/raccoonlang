// The append of paged decode on sm_100a (gpu/encoding/P2.md §2): for B sequences of 8 KV heads each, writes each
// sequence's new K and V row, `k_new` and `v_new` in bf16 `[B·8, 128]`, at position `lens[b]` of the paged caches K and V
// `[pages·128, 8·128]`, the page being entry `[b][lens[b] / 128]` of the u32 block table `[B, max_pages]`. A sequence
// appends only if it claims its last page's rows of the head (`owners [pages·8]`, u64, for the launch's `epoch`), so
// two sequences whose tables name one last page never write the same rows; `appended [B·8]` says which did.
//
// One warp per sequence and head: claim (`Core.withClaim`), then write the claimed row, once (`Core.appendRow`).
//
// Run: gpu/gen.sh gpu/encoding/examples/paged_append.rac

import encoding.Core

namespace Append {
  open Core
  open Cuda

  // The KV heads of every sequence, a generation-time constant of the kernel.
  def heads : Nat := 8

  def kernel : Program :=
    appendKernel("paged_append", heads, fun (l: Lifetime)(e: Ctx(l, warpCta))(g: AppendLaunch(l))(own: ClaimOwn(l)): Ctx(l, warpCta) =>
      withClaim(e, g.lens, g.table, g.claims, own, fun (m: Lifetime)(e: Ctx(m, warpCta))(c: Claimed(m))(once: AppendOwn(m)): Ctx(m, warpCta) =>
        appendRow(e, c, once, g.cache, g.knew)))
}

{ Core.render(Append.kernel) }
