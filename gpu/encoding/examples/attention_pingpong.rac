// Forward attention on sm_100a with two query tiles per CTA in ping-pong (gpu/encoding/A3.md, step A3a): what
// examples/attention.rac computes, for any `seq` ≥ 1, with its two kernels, `attention_pingpong` (non-causal, O in f32)
// and `attention_pingpong_causal` (causal, O in bf16).
//
// One CTA of twelve warps (`Layout.rolesPair`) per 256 query rows of one head, as two tiles of 128 rows. Warp 9 loads
// each tile's Q block once into a one-stage ring, then K_j and V_j for every key block into two-stage rings. Warp 8
// elects the MMA thread, which holds both Q stages across the loop and serves the tiles in turn (FA4's order):
// - before the loop, S0_0 = Q0·K_0ᵀ and S1_0 = Q1·K_0ᵀ, each committed to its tile's score buffer;
// - for each key block i ≥ 1, for tile 0 and then tile 1: once the tile's warpgroup has published Pt_{i−1}, Ôt +=
//   Pt_{i−1}·V_{i−1}, then St_i = Qt·K_iᵀ over Pt, committed;
// - after the loop, for each tile, Ôt += Pt_{n−1}·V_{n−1}, committed alone.
// So a tile's next scores wait only for its own probabilities: while one warpgroup computes its probabilities, the
// tensor cores run the other tile's products. Warps 0–3 and 4–7 are the two tiles' softmax warpgroups, one row per
// thread, with examples/attention.rac's arithmetic (`Attention.scores`, `raiseMax`, `exps`): per key block, load the
// row of S into registers in one pass, take the new maximum of the masked scores, write P = 2^(c·s − max) over S's
// upper half, rescale Ô's row and publish. After the loop each waits for its tile's last product and stores its rows of
// O and LSE.
//
// Tensor memory: tile 0's score buffer in columns 0–255 (S, P over S's columns 64–127, then Ô), tile 1's in 256–511.
//
// Run: gpu/gen.sh gpu/encoding/examples/attention_pingpong.rac

import encoding.Core
import encoding.Layout
import encoding.Attention

namespace PingPong {
  open Core
  open Cuda
  open Layout
  open Attention

  def Launch (l: Lifetime)(t: DType) : Type { scope = l } := AttnLaunch(l, box, t)

  // Q's two tiles once, then K_j and V_j for every key block j; then wait for every stage to be released.
  def loader {l: Lifetime}{t: DType}{rq0: Lifetime}{rq1: Lifetime}{rk: Lifetime}{rv: Lifetime}(g: Launch(l, t))(q0r: Ring(rq0, qRing))
      (q1r: Ring(rq1, qRing))(kr: Ring(rk, kRing))(vr: Ring(rv, vRing))(pq0: Producer(rq0))(pq1: Producer(rq1))(pk: Producer(rk))
      (pv: Producer(rv))(m: Lifetime)(e: Ctx(m, PairLoad)): Pair(Ctx(m, PairLoad), Unit) :=
    elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      let block := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, One))(st: Pair(ProducerAt(rk, j), ProducerAt(rv, j)))
          : Pair(Ctx(n, One), Pair(ProducerAt(rk, j), ProducerAt(rv, j))) => {
        let (pk, pv) := st
        let row := mulC(i, 128)
        let (e, s) := acquire(e, kr, pk)
        let (e, pk) := fillBlock(e, kr, s, g.k, row)
        let (e, s) := acquire(e, vr, pv)
        let (e, pv) := fillBlock(e, vr, s, g.v, row)
        (e, (pk, pv))
      }
      let (e, pq0) := takeProducer(e, w, q0r, pq0)
      let (e, pq1) := takeProducer(e, w, q1r, pq1)
      let (e, pk) := takeProducer(e, w, kr, pk)
      let (e, pv) := takeProducer(e, w, vr, pv)
      let (e, s) := acquire(e, q0r, pq0)
      let (e, pq0) := fillBlock(e, q0r, s, g.q, g.q0)
      let (e, s) := acquire(e, q1r, pq1)
      let (e, pq1) := fillBlock(e, q1r, s, g.q, add(g.q0, lit(128)))
      let (e, (pk, pv)) := loop(e, g.blocks, fixedPair(fixedProducerAt(rk, j), fixedProducerAt(rv, j)), (pk, pv), block)
      let e := finishProducer(e, q0r, pq0)
      let e := finishProducer(e, q1r, pq1)
      let e := finishProducer(e, kr, pk)
      (finishProducer(e, vr, pv), Unit.unit)
    })

  // ---- The MMA issuer --------------------------------------------------------------------------------------------------

  // The issuer's state across key blocks: the held Q stages, the K and V rings' consumer sides, and its side of each
  // tile's score buffer.
  def Issuing (rq0: Lifetime)(rq1: Lifetime)(rk: Lifetime)(rv: Lifetime)(x0: Lifetime)(x1: Lifetime)(j: Lifetime)
      : Type { kind = lin, scope = union(rq0, union(rq1, union(rk, union(rv, union(x0, union(x1, j)))))) } :=
    Pair(Pair(ReadyUsed(rq0, j), ReadyUsed(rq1, j)), Pair(Pair(ConsumerAt(rk, j), ConsumerAt(rv, j)), Pair(MmaAt(x0, j), MmaAt(x1, j))))

  // Block 0's scores for both tiles before the loop; in iteration i ≥ 1, per tile, the product of block i − 1 and then
  // block i's scores, V released after tile 1's product and K after its scores; after the loop, the last products.
  def issuer {L: Lifetime}{rq0: Lifetime}{rq1: Lifetime}{rk: Lifetime}{rv: Lifetime}{x0: Lifetime}{x1: Lifetime}
      (blocks: Val(L, Grain.uniform, DType.u32))(q0r: Ring(rq0, qRing))(q1r: Ring(rq1, qRing))(kr: Ring(rk, kRing))(vr: Ring(rv, vRing))
      (b0: ScoreBuffer(x0))(b1: ScoreBuffer(x1))(cq0: Consumer(rq0))(cq1: Consumer(rq1))(ck: Consumer(rk))(cv: Consumer(rv))
      (s0: MmaSide(x0))(s1: MmaSide(x1))(m: Lifetime)(e: Ctx(m, PairIssue)): Pair(Ctx(m, PairIssue), Unit) :=
    elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      // The ring's next stage, held for MMAs until `releaseByMma`.
      let hold := fun {r: Lifetime}{c: RingCfg}{n: Lifetime}(e: Ctx(n, One))(ring: Ring(r, c))(cs: ConsumerAt(r, j))
          : Pair(Ctx(n, One), ReadyUsed(r, j)) => {
        let (e, ready) := await(e, ring, cs)
        (e, holdStage(ready))
      }
      // St = Qt·Kᵀ, committed: the buffer passes to tile t's warpgroup.
      let scores := fun {x: Lifetime}{rq: Lifetime}{n: Lifetime}(e: Ctx(n, One))(b: ScoreBuffer(x))(s: Issued(x, j))(qr: Ring(rq, qRing))
          (q: ReadyUsed(rq, j))(k: ReadyUsed(rk, j)): Pair(Ctx(n, One), Pair(MmaAt(x, j), Pair(ReadyUsed(rq, j), ReadyUsed(rk, j)))) => {
        let (e, (s, (q, k))) := issueScores(e, w, b, s, qr, q, kr, k)
        let (e, s) := commitBuffer(e, w, b, s)
        (e, (s, (q, k)))
      }
      // Ôt += Pt·V, once tile t's warpgroup has published Pt.
      let product := fun {x: Lifetime}{n: Lifetime}(e: Ctx(n, One))(b: ScoreBuffer(x))(s: MmaAt(x, j))(v: ReadyUsed(rv, j))
          : Pair(Ctx(n, One), Pair(Issued(x, j), ReadyUsed(rv, j))) => {
        let (e, p) := awaitProbs(e, b, s)
        issuePV(e, w, b, p, vr, v)
      }
      let block := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, One))(st: Issuing(rq0, rq1, rk, rv, x0, x1, j))
          : Pair(Ctx(n, One), Issuing(rq0, rq1, rk, rv, x0, x1, j)) => {
        let ((q0, q1), ((ck, cv), (s0, s1))) := st
        let (e, v) := hold(e, vr, cv)
        let (e, (s0, v)) := product(e, b0, s0, v)
        let (e, k) := hold(e, kr, ck)
        let (e, (s0, (q0, k))) := scores(e, b0, s0, q0r, q0, k)
        let (e, (s1, v)) := product(e, b1, s1, v)
        let (e, cv) := releaseByMma(e, w, vr, v)
        let (e, (s1, (q1, k))) := scores(e, b1, s1, q1r, q1, k)
        let (e, ck) := releaseByMma(e, w, kr, k)
        (e, ((q0, q1), ((ck, cv), (s0, s1))))
      }
      let (e, cq0) := takeConsumer(e, w, q0r, cq0)
      let (e, cq1) := takeConsumer(e, w, q1r, cq1)
      let (e, ck) := takeConsumer(e, w, kr, ck)
      let (e, cv) := takeConsumer(e, w, vr, cv)
      let (e, s0) := takeMma(e, w, b0, s0)
      let (e, s1) := takeMma(e, w, b1, s1)
      let (e, q0) := hold(e, q0r, cq0)
      let (e, k) := hold(e, kr, ck)
      let (e, (s0, (q0, k))) := scores(e, b0, s0, q0r, q0, k)
      let (e, q1) := hold(e, q1r, cq1)
      let (e, (s1, (q1, k))) := scores(e, b1, s1, q1r, q1, k)
      let (e, ck) := releaseByMma(e, w, kr, k)
      let fixed := fixedPair(fixedPair(fixedReadyUsed(rq0, j), fixedReadyUsed(rq1, j)),
        fixedPair(fixedPair(fixedConsumerAt(rk, j), fixedConsumerAt(rv, j)), fixedPair(fixedMmaAt(x0, j), fixedMmaAt(x1, j))))
      let (e, ((q0, q1), ((ck, cv), (s0, s1)))) := loop(e, subC(blocks, 1), fixed, ((q0, q1), ((ck, cv), (s0, s1))), block)
      let (e, v) := hold(e, vr, cv)
      let (e, (s0, v)) := product(e, b0, s0, v)
      let (e, s0) := commitBuffer(e, w, b0, s0)
      let (e, (s1, v)) := product(e, b1, s1, v)
      let (e, s1) := commitBuffer(e, w, b1, s1)
      let (e, cv) := releaseByMma(e, w, vr, v)
      let (e, cq0) := releaseByMma(e, w, q0r, q0)
      let (e, cq1) := releaseByMma(e, w, q1r, q1)
      let e := finishMma(e, s0)
      let e := finishMma(e, s1)
      let e := finishConsumer(e, cq0)
      let e := finishConsumer(e, cq1)
      let e := finishConsumer(e, ck)
      (finishConsumer(e, cv), Unit.unit)
    })

  // ---- The softmax warpgroups ------------------------------------------------------------------------------------------

  // The softmax of one tile, on the warpgroup of warps f to f + 3, one row per thread: its running maximum `m` (log2
  // units, from −∞) and sum `l` (from 0) are registers of the role. Per key block: await the scores; load the row in
  // one pass; the masked t of the row and its new maximum; P = 2^(t − m_new) over S, against the maximum as `usable`
  // gives it, summing it; rescale Ô's row by α = 2^(m_old − m_new), which in the first block, Ô still undefined, sets
  // it to 0; publish P; l = α·l + sum, where the first block's α is 2^−∞ = 0. After the loop: wait for the last product,
  // and store O = Ô/l and LSE = (m + log2 l)·ln 2.
  def softmax {L: Lifetime}{t: DType}{x: Lifetime}{f: Nat}(blocks: Val(L, Grain.uniform, DType.u32))(mask: Mask(L))
      (scale: Val(L, Grain.uniform, DType.f32))(out: AttnOut(L, t))(own: OOwn(L, t))(buf: ScoreBuffer(x))(side: RowSide(x))(m: Lifetime)
      (e: Ctx(m, Group.warps(f, 4)))[aligned: Eq(Nat, Nat.mod(f, 4), 0)]: Pair(Ctx(m, Group.warps(f, 4)), Unit) := {
    let (e, minusInfinity) := fconst(e, minusInfinityBits)
    let (e, mReg) := reg(e, minusInfinity)
    let (e, lReg) := reg(e, zero(DType.f32))
    let (e, lowest) := fconst(e, lowestFinite)
    let block := fun {o: OState}(n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Group.warps(f, 4)))(st: RowsAt(x, m, f, o))
        : Pair(Ctx(n, Group.warps(f, 4)), RowsAt(x, m, f, OState.held)) => {
      let (e, scored) := awaitScores(e, buf, st)
      let (e, (read, s)) := loadRow(e, buf, scored)
      let (e, mOld) := get(e, mReg)
      let (e, t) := mapRow(e, s, fun (c: Nat)(s: F32x8(n, Grain.thread))(e: Ctx(n, Group.warps(f, 4)))
          : Pair(Ctx(n, Group.warps(f, 4)), F32x8(n, Grain.thread)) => {
        let (e, t) := scores(mask, i, scale, c, s, e)
        (raiseMax(mReg, t, e), t)
      })
      let (e, mNew) := usable(lowest, mReg, e)
      let (e, sum) := reg(e, zero(DType.f32))
      let (e, p) := writeProbs(e, buf, read, t, fun (c: Nat)(t: F32x8(n, Grain.thread))(e: Ctx(n, Group.warps(f, 4)))
          : Pair(Ctx(n, Group.warps(f, 4)), F32x8(n, Grain.thread)) => exps(sum, mNew, t, e))
      let (e, alpha) := ex2(e, fsub(mOld, mNew))
      let (e, p) := rescaleRow(e, buf, p, alpha)
      let (e, st) := publishProbs(e, buf, p)
      let (e, s) := get(e, sum)
      let (e, lOld) := get(e, lReg)
      (set(e, lReg, fma(alpha, lOld, s)), st)
    }
    let first := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Group.warps(f, 4)))(st: RowsAt(x, m, f, OState.fresh))
        : Pair(Ctx(n, Group.warps(f, 4)), RowsAt(x, m, f, OState.held)) => block(n, i, e, st)
    let rest := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Group.warps(f, 4)))(st: RowsAt(x, m, f, OState.held))
        : Pair(Ctx(n, Group.warps(f, 4)), RowsAt(x, m, f, OState.held)) => block(n, i, e, st)
    let (e, st) := takeRows(e, buf, side)[aligned]
    let (e, st) := loopPeeled(e, blocks, fixedRowsAt(x, m, f, OState.held), st, first, rest)
    let (e, final) := awaitFinal(e, buf, st)
    let (e, lSum) := get(e, lReg)
    let (e, mMax) := get(e, mReg)
    let (e, inv) := rcp(e, lSum)
    let (e, logSum) := lg2(e, lSum)
    let (e, ln2) := fconst(e, ln2)
    let (e, final) := storeFinal(e, buf, final, inv, fmul(fadd(mMax, logSum), ln2), out, own)
    (closeRows(e, final), Unit.unit)
  }

  // ---- The CTA ---------------------------------------------------------------------------------------------------------

  // The CTA, given the launch, each tile's authority over its rows of O, and the permit. Tensor memory: each tile's
  // score buffer in one half.
  def cta {l: Lifetime}{t: DType}(e: Ctx(l, PairCta))(g: Launch(l, t))(own0: OOwn(l, t))(own1: OOwn(l, t))(permit: TmemPermit(l)): Ctx(l, PairCta) := {
    // The rings, innermost the V ring, around the roles.
    let rings := fun (x0: Lifetime)(x1: Lifetime)(b0: ScoreBuffer(x0))(b1: ScoreBuffer(x1))(r0: RowSide(x0))(r1: RowSide(x1))(s0: MmaSide(x0))
        (s1: MmaSide(x1))(e: Ctx(l, PairCta)): Pair(Ctx(l, PairCta), Unit) =>
      withRing(e, qRing, Unit, fun (rq0: Lifetime)(q0r: Ring(rq0, qRing))(pq0: Producer(rq0))(cq0: Consumer(rq0))(e: Ctx(l, PairCta))
          : Pair(Ctx(l, PairCta), Unit) =>
        withRing(e, qRing, Unit, fun (rq1: Lifetime)(q1r: Ring(rq1, qRing))(pq1: Producer(rq1))(cq1: Consumer(rq1))(e: Ctx(l, PairCta))
            : Pair(Ctx(l, PairCta), Unit) =>
          withRing(e, kRing, Unit, fun (rk: Lifetime)(kr: Ring(rk, kRing))(pk: Producer(rk))(ck: Consumer(rk))(e: Ctx(l, PairCta))
              : Pair(Ctx(l, PairCta), Unit) =>
            withRing(e, vRing, Unit, fun (rv: Lifetime)(vr: Ring(rv, vRing))(pv: Producer(rv))(cv: Consumer(rv))(e: Ctx(l, PairCta))
                : Pair(Ctx(l, PairCta), Unit) =>
              (rolesPair(e,
                fun (m: Lifetime)(e: Ctx(m, Group.warps(0, 4))): Pair(Ctx(m, Group.warps(0, 4)), Unit) =>
                  softmax(g.blocks, g.mask, g.scale, g.out, own0, b0, r0, m, e),
                fun (m: Lifetime)(e: Ctx(m, Group.warps(4, 4))): Pair(Ctx(m, Group.warps(4, 4)), Unit) =>
                  softmax(g.blocks, g.mask, g.scale, g.out, own1, b1, r1, m, e),
                fun (m: Lifetime)(e: Ctx(m, PairIssue)): Pair(Ctx(m, PairIssue), Unit) =>
                  issuer(g.blocks, q0r, q1r, kr, vr, b0, b1, cq0, cq1, ck, cv, s0, s1, m, e),
                fun (m: Lifetime)(e: Ctx(m, PairLoad)): Pair(Ctx(m, PairLoad), Unit) => loader(g, q0r, q1r, kr, vr, pq0, pq1, pk, pv, m, e)),
                Unit.unit)))))
    let regions := fun (a: Lifetime)(tm: Tmem(a, 512))(acc: Acc(a, AccState.empty))(e: Ctx(l, PairCta))
        : Pair(Ctx(l, PairCta), Pair(Acc(a, AccState.empty), Unit)) =>
      splitTmem(e, tm, acc, 256, Unit, fun (c0: Lifetime)(c1: Lifetime)(t0: Tmem(c0, 256))(acc0: Acc(c0, AccState.empty))(t1: Tmem(c1, 256))
          (acc1: Acc(c1, AccState.empty))(e: Ctx(l, PairCta)): Pair(Ctx(l, PairCta), Pair(Pair(Acc(c0, AccState.empty), Acc(c1, AccState.empty)), Unit)) => {
        let (e, (acc0, (acc1, u))) := withScoreBuffer(e, t0, acc0, Pair(Acc(c1, AccState.empty), Unit), fun (x0: Lifetime)(b0: ScoreBuffer(x0))
            (r0: RowSide(x0))(s0: MmaSide(x0))(e: Ctx(l, PairCta)): Pair(Ctx(l, PairCta), Pair(Acc(c1, AccState.empty), Unit)) =>
          withScoreBuffer(e, t1, acc1, Unit, fun (x1: Lifetime)(b1: ScoreBuffer(x1))(r1: RowSide(x1))(s1: MmaSide(x1))(e: Ctx(l, PairCta))
              : Pair(Ctx(l, PairCta), Unit) => rings(x0, x1, b0, b1, r0, r1, s0, s1, e)))
        (e, ((acc0, acc1), Unit.unit))
      })
    let (e, u) := withTmem(e, permit, 512, AccState.empty, Unit, regions)
    e
  }

  // The kernel `name`, causal or not, writing O as `t` (f32 or bf16).
  def kernel (name: String)(causal: Bool)(t: DType): Program :=
    pairAttentionKernel(name, causal, t, fun (l: Lifetime)(e: Ctx(l, PairCta))(g: Launch(l, t))(own0: OOwn(l, t))(own1: OOwn(l, t))
        (permit: TmemPermit(l)): Ctx(l, PairCta) => cta(e, g, own0, own1, permit))
}

// The non-causal kernel with f32 output, then the causal one with bf16 output.
{ String.append(Core.render(PingPong.kernel("attention_pingpong", Bool.false, Cuda.DType.f32)),
    Core.render(PingPong.kernel("attention_pingpong_causal", Bool.true, Cuda.DType.bf16))) }
