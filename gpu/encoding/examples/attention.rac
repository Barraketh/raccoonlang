// Forward attention on sm_100a (gpu/ATTENTION.md, stages A1 and A2): for BH heads of `seq` rows, any `seq` ≥ 1, head
// dimension 128, O = softmax(scale · Q·Kᵀ + mask)·V and LSE, from Q, K and V in bf16 `[BH·seq, 128]` to O `[BH·seq, 128]`
// and LSE in f32 `[BH·seq]`. The caller passes `scale_log2` = scale · log2(e). Two kernels: `attention`, non-causal
// with O in f32, and `attention_causal`, causal (key j of a head only for its queries i ≥ j) with O in bf16.
//
// One CTA per 128 query rows of one head: the roles of `encoding/Attention.rac`, with a loader that reads each block
// of Q, K and V at its row of the head. A last key block that runs past `seq` reads the next head's rows, which the
// mask hides; the causal kernel runs only the key blocks up to its query tile's (`Core.attentionKernel`'s block count).
//
// Run: gpu/gen.sh gpu/encoding/examples/attention.rac

import encoding.Core
import encoding.Layout
import encoding.Attention

namespace Attn {
  open Core
  open Cuda
  open Layout
  open Attention

  def Launch (l: Lifetime)(t: DType) : Type { scope = l } := AttnLaunch(l, box, t)

  // Q's block once, then K_j and V_j for every key block j; then wait for every stage to be released.
  def loader {l: Lifetime}{t: DType}{rq: Lifetime}{rk: Lifetime}{rv: Lifetime}(g: Launch(l, t))(qr: Ring(rq, qRing))(kr: Ring(rk, kRing))
      (vr: Ring(rv, vRing))(pq: Producer(rq))(pk: Producer(rk))(pv: Producer(rv))(m: Lifetime)(e: Ctx(m, Load)): Pair(Ctx(m, Load), Unit) :=
    elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      let block := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, One))(st: Pair(ProducerAt(rk, j), ProducerAt(rv, j)))
          : Pair(Ctx(n, One), Pair(ProducerAt(rk, j), ProducerAt(rv, j))) => {
        let (pk, pv) := st
        let row := mulC(i, 128)
        let (e, s) := acquire(e, kr, pk)
        let (e, pk) := fillBlock(e, kr, s, g.k, row)
        let (e, s) := acquire(e, vr, pv)
        let (e, pv) := fillBlock(e, vr, s, g.v, row)
        (e, (pk, pv))
      }
      let (e, pq) := takeProducer(e, w, qr, pq)
      let (e, pk) := takeProducer(e, w, kr, pk)
      let (e, pv) := takeProducer(e, w, vr, pv)
      let (e, s) := acquire(e, qr, pq)
      let (e, pq) := fillBlock(e, qr, s, g.q, g.q0)
      let (e, (pk, pv)) := loop(e, g.blocks, fixedPair(fixedProducerAt(rk, j), fixedProducerAt(rv, j)), (pk, pv), block)
      let e := finishProducer(e, qr, pq)
      let e := finishProducer(e, kr, pk)
      (finishProducer(e, vr, pv), Unit.unit)
    })

  // The kernel `name`, causal or not, writing O as `t` (f32 or bf16).
  def kernel (name: String)(causal: Bool)(t: DType): Program :=
    attentionKernel(name, causal, t, fun (l: Lifetime)(e: Ctx(l, Cta))(g: Launch(l, t))(own: OOwn(l, t, groupWarp))(permit: TmemPermit(l))
        : Ctx(l, Cta) =>
      cta(e, permit, g.blocks, g.mask, g.scale, g.out, own, fun (rq: Lifetime)(rk: Lifetime)(rv: Lifetime)(qr: Ring(rq, qRing))
          (kr: Ring(rk, kRing))(vr: Ring(rv, vRing))(pq: Producer(rq))(pk: Producer(rk))(pv: Producer(rv))(m: Lifetime)(e: Ctx(m, Load))
          : Pair(Ctx(m, Load), Unit) => loader(g, qr, kr, vr, pq, pk, pv, m, e)))
}

// The non-causal kernel with f32 output (A1's, now for any `seq`), then the causal one with bf16 output.
{ String.append(Core.render(Attn.kernel("attention", Bool.false, Cuda.DType.f32)),
    Core.render(Attn.kernel("attention_causal", Bool.true, Cuda.DType.bf16))) }
