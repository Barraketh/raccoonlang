// The attention of paged decode on sm_100a (gpu/encoding/P2.md §3): for B sequences of one new query per query head, 8
// KV heads of G query heads each, head dimension 128, partial results of O = softmax(scale · Q·Kᵀ)·V and LSE over a
// split of each sequence's keys, from Q in bf16 `[B·8·G, 128]` and K and V in the paged bf16 caches
// `[pages·128, 8·128]`, to `Opart [splits·B·8·G, 128]` and `LSEpart [splits·B·8·G]` in f32, which the combine kernel
// (examples/paged_combine.rac) merges. Sequence `b` has `lens[b] + 1` keys: its cached ones, and the new one the append
// kernel wrote at position `lens[b]`. The caller passes `scale_log2` = scale · log2(e). Three kernels, for G = 1, 4 and
// 8: `paged_decode_g1`, `paged_decode_g4` and `paged_decode_g8`.
//
// One CTA per split of the key blocks and KV head of a sequence: the roles of `encoding/Attention.rac`, with a loader
// that reads the G query rows of the KV head once (`Core.fillGroup`), then each of the split's key blocks of K and V
// from the page the block table names (`Core.fillPage`). The keys past the sequence are masked; the core's prologue
// computes the split's blocks, and stores only the G rows of each partial result.
//
// Run: gpu/gen.sh gpu/encoding/examples/paged_decode.rac

import encoding.Core
import encoding.Layout
import encoding.Attention

namespace Decode {
  open Core
  open Cuda
  open Layout
  open Attention

  // The KV heads of every sequence, a generation-time constant of the kernels.
  def heads : Nat := 8

  def Launch (l: Lifetime) : Type { scope = l } := DecodeLaunch(l, box)

  // The packed queries once, then K_j and V_j for each of the split's key blocks j = first + i, each from the page the
  // table names for block j; then wait for every stage to be released.
  def loader {l: Lifetime}{rq: Lifetime}{rk: Lifetime}{rv: Lifetime}(g: Launch(l))(qr: Ring(rq, qRing))(kr: Ring(rk, kRing))(vr: Ring(rv, vRing))
      (pq: Producer(rq))(pk: Producer(rk))(pv: Producer(rv))(m: Lifetime)(e: Ctx(m, Load)): Pair(Ctx(m, Load), Unit) :=
    elect(e, Unit, fun (j: Lifetime)(w: Elected(j))(e: Ctx(j, One)): Pair(Ctx(j, One), Unit) => {
      let block := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, One))(st: Pair(ProducerAt(rk, j), ProducerAt(rv, j)))
          : Pair(Ctx(n, One), Pair(ProducerAt(rk, j), ProducerAt(rv, j))) => {
        let (pk, pv) := st
        let (e, s) := acquire(e, kr, pk)
        let (e, pk) := fillPage(e, kr, s, g.table, g.k, add(g.first, i))
        let (e, s) := acquire(e, vr, pv)
        let (e, pv) := fillPage(e, vr, s, g.table, g.v, add(g.first, i))
        (e, (pk, pv))
      }
      let (e, pq) := takeProducer(e, w, qr, pq)
      let (e, pk) := takeProducer(e, w, kr, pk)
      let (e, pv) := takeProducer(e, w, vr, pv)
      let (e, s) := acquire(e, qr, pq)
      let (e, pq) := fillGroup(e, qr, s, g.q)
      let (e, (pk, pv)) := loop(e, g.blocks, fixedPair(fixedProducerAt(rk, j), fixedProducerAt(rv, j)), (pk, pv), block)
      let e := finishProducer(e, qr, pq)
      let e := finishProducer(e, kr, pk)
      (finishProducer(e, vr, pv), Unit.unit)
    })

  // The kernel `name`, for `group` query heads per KV head.
  def kernel (name: String)(group: Nat): Program :=
    decodeKernel(name, heads, group, fun (l: Lifetime)(e: Ctx(l, Cta))(g: Launch(l))(own: OOwn(l, DType.f32, groupWarp))(permit: TmemPermit(l))
        : Ctx(l, Cta) =>
      cta(e, permit, g.blocks, g.mask, g.scale, g.out, own, fun (rq: Lifetime)(rk: Lifetime)(rv: Lifetime)(qr: Ring(rq, qRing))
          (kr: Ring(rk, kRing))(vr: Ring(rv, vRing))(pq: Producer(rq))(pk: Producer(rk))(pv: Producer(rv))(m: Lifetime)(e: Ctx(m, Load))
          : Pair(Ctx(m, Load), Unit) => loader(g, qr, kr, vr, pq, pk, pv, m, e)))
}

{ String.append(Core.render(Decode.kernel("paged_decode_g1", 1)),
    String.append(Core.render(Decode.kernel("paged_decode_g4", 4)), Core.render(Decode.kernel("paged_decode_g8", 8)))) }
