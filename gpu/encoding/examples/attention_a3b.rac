// Forward attention on sm_100a with a correction warpgroup (gpu/encoding/A3B.md, step A3b): what
// examples/attention_pingpong.rac computes, for any `seq` ≥ 1, with its two kernels, `attention_a3b` (non-causal, O in
// f32) and `attention_a3b_causal` (causal, O in bf16).
//
// One CTA of sixteen warps (`Layout.rolesCorrected`) per 256 query rows of one head, as two tiles of 128 rows, on A3a's
// schedule (`Attention.pairLoader`, `pairIssuer`): warp 14 loads, warp 12's elected thread issues, warps 0–3 and 4–7
// are the tiles' softmax warpgroups, and warps 8–11 rescale both tiles' Ô. The softmax differs from A3a's in three ways:
// - the row's maximum moves only when a block's exceeds it by more than 8 (log2 units), so α is mostly 1 and p ≤ 2^8;
// - 16 of the row's 128 exponentials run on the FMA units (`ex2emu`), the rest on the special-function unit;
// - α goes to the correction warpgroup with P's publish (`publishAlpha`), and a warp of the correction warpgroup skips
//   its rescale when no row of its 32 has α below 1.
// Tensor memory: tile 0's score buffer in columns 0–255 (S, P over S's columns 64–127, then Ô), tile 1's in 256–511.
//
// Run: gpu/gen.sh gpu/encoding/examples/attention_a3b.rac

import encoding.Core
import encoding.Layout
import encoding.Attention

namespace Corrected {
  open Core
  open Cuda
  open Layout
  open Attention

  def Launch (l: Lifetime)(t: DType) : Type { scope = l } := PairLaunch(l, box, t)

  // How far the row's maximum may lag behind its scores, 8 (log2 units; FA4's `rescale_threshold` for 16-bit inputs),
  // and 1, as f32 bits.
  def lagBits : Nat := 1090519040
  def oneBits : Nat := 1065353216

  // ---- The softmax warpgroups ------------------------------------------------------------------------------------------

  // The running maximum `mx`, raised over a block from `old`, falls back to `old` unless the block raised it by more
  // than `lag`: then the block's exponents are at most `lag`, and its α is 1.
  def lagMax {n: Lifetime}{g: Group}{Sm: Lifetime}{So: Lifetime}{Sl: Lifetime}(mx: Reg(Sm, DType.f32))(old: Val(So, Grain.thread, DType.f32))
      (lag: Val(Sl, Grain.uniform, DType.f32))(e: Ctx(n, g)): Ctx(n, g) := {
    let (e, raised) := get(e, mx)
    set(e, mx, select(Core.lt(lag, fsub(raised, old)), raised, old))
  }

  // Whether key column 8c + j of a block takes its exponential on the FMA units: FA4's columns for its `cta_group::1`
  // kernels (`ex2_emu_freq` 16, `ex2_emu_res` 4, `ex2_emu_start_frg` 1), the last four of every sixteen in the 32-column
  // fragments other than the first and the last, so chunks 5, 7, 9 and 11, columns 4 to 7: 16 of 128.
  def emulated (c: Nat)(j: Nat): Bool :=
    Bool.and(Bool.and(Nat.ble(5, c), Nat.ble(c, 11)), Bool.and(Nat.beq(Nat.mod(c, 2), 1), Nat.ble(4, j)))

  // 2^x, on the FMA units when `emulate`, else on the special-function unit.
  def exp2 {n: Lifetime}{g: Group}{S: Lifetime}{u: Grain}(e: Ctx(n, g))(emulate: Bool)(x: Val(S, u, DType.f32))
      : Pair(Ctx(n, g), Val(n, u, DType.f32)) := {
    match emulate returning Pair(Ctx(n, g), Val(n, u, DType.f32)) with
    | Bool.true => ex2emu(e, x)
    | Bool.false => ex2(e, x)
  }

  // Chunk `c`'s p = 2^(t − max) against the row's maximum `mx` as `usable` gives it (0 for a masked key), its
  // `emulated` columns on the FMA units; `sum` gains their sum.
  def exps {n: Lifetime}{g: Group}{Ss: Lifetime}{Sm: Lifetime}{St: Lifetime}(sum: Reg(Ss, DType.f32))(mx: Val(Sm, Grain.thread, DType.f32))(c: Nat)
      (t: F32x8(St, Grain.thread))(e: Ctx(n, g)): Pair(Ctx(n, g), F32x8(n, Grain.thread)) := {
    let (e, p0) := exp2(e, emulated(c, 0), fsub(t.v0, mx))
    let (e, p1) := exp2(e, emulated(c, 1), fsub(t.v1, mx))
    let (e, p2) := exp2(e, emulated(c, 2), fsub(t.v2, mx))
    let (e, p3) := exp2(e, emulated(c, 3), fsub(t.v3, mx))
    let (e, p4) := exp2(e, emulated(c, 4), fsub(t.v4, mx))
    let (e, p5) := exp2(e, emulated(c, 5), fsub(t.v5, mx))
    let (e, p6) := exp2(e, emulated(c, 6), fsub(t.v6, mx))
    let (e, p7) := exp2(e, emulated(c, 7), fsub(t.v7, mx))
    let (e, old) := get(e, sum)
    let e := set(e, sum, fadd(old, fadd(fadd(fadd(p0, p1), fadd(p2, p3)), fadd(fadd(p4, p5), fadd(p6, p7)))))
    (e, F32x8.mk(p0, p1, p2, p3, p4, p5, p6, p7))
  }

  // The softmax of one tile (A3B.md §3.2), on the warpgroup of warps f to f + 3, one row per thread: its running
  // maximum `m` (log2 units, from −∞) and sum `l` (from 0) are registers of the role. Per block it keeps the row's
  // masked scores and raises `m` (`lagMax`), writes P against `m` as `usable` gives it, and publishes P with
  // α = 2^(m_old − m_new) for the correction warpgroup; then l = α·l + sum. After the loop it stores O = Ô/l and
  // LSE = (m + log2 l)·ln 2.
  def softmax {L: Lifetime}{t: DType}{x: Lifetime}{f: Nat}(blocks: Val(L, Grain.uniform, DType.u32))(mask: Mask(L))
      (scale: Val(L, Grain.uniform, DType.f32))(out: AttnOut(L, t))(own: OOwn(L, t, f))(buf: ScoreBuffer(x, Rescaler.correction))
      (side: RowSide(x))(m: Lifetime)(e: Ctx(m, Group.warps(f, 4)))[aligned: Eq(Nat, Nat.mod(f, 4), 0)]: Pair(Ctx(m, Group.warps(f, 4)), Unit) := {
    let (e, minusInfinity) := fconst(e, minusInfinityBits)
    let (e, mReg) := reg(e, minusInfinity)
    let (e, lReg) := reg(e, zero(DType.f32))
    let (e, lowest) := fconst(e, lowestFinite)
    let (e, lag) := fconst(e, lagBits)
    let block := fun {o: OState}(n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Group.warps(f, 4)))(st: RowsAt(x, m, f, o))
        : Pair(Ctx(n, Group.warps(f, 4)), RowsAt(x, m, f, OState.held)) => {
      let (e, scored) := awaitScores(e, buf, st)
      let (e, (read, s)) := loadRow(e, buf, scored)
      let (e, mOld) := get(e, mReg)
      let (e, t) := mapRow(e, s, fun (c: Nat)(s: F32x8(n, Grain.thread))(e: Ctx(n, Group.warps(f, 4)))
          : Pair(Ctx(n, Group.warps(f, 4)), F32x8(n, Grain.thread)) => {
        let (e, t) := scores(mask, i, scale, c, s, e)
        (raiseMax(mReg, t, e), t)
      })
      let e := lagMax(mReg, mOld, lag, e)
      let (e, mNew) := usable(lowest, mReg, e)
      let (e, sum) := reg(e, zero(DType.f32))
      let (e, p) := writeProbs(e, buf, read, t, fun (c: Nat)(t: F32x8(n, Grain.thread))(e: Ctx(n, Group.warps(f, 4)))
          : Pair(Ctx(n, Group.warps(f, 4)), F32x8(n, Grain.thread)) => exps(sum, mNew, c, t, e))
      let (e, alpha) := ex2(e, fsub(mOld, mNew))
      let (e, st) := publishAlpha(e, buf, p, alpha)
      let (e, s) := get(e, sum)
      let (e, lOld) := get(e, lReg)
      (set(e, lReg, fma(alpha, lOld, s)), st)
    }
    let first := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Group.warps(f, 4)))(st: RowsAt(x, m, f, OState.fresh))
        : Pair(Ctx(n, Group.warps(f, 4)), RowsAt(x, m, f, OState.held)) => block(n, i, e, st)
    let rest := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Group.warps(f, 4)))(st: RowsAt(x, m, f, OState.held))
        : Pair(Ctx(n, Group.warps(f, 4)), RowsAt(x, m, f, OState.held)) => block(n, i, e, st)
    let (e, st) := takeRows(e, buf, side)[aligned]
    let (e, st) := loopPeeled(e, blocks, fixedRowsAt(x, m, f, OState.held), st, first, rest)
    let (e, final) := awaitFinal(e, buf, st)
    let (e, lSum) := get(e, lReg)
    let (e, mMax) := get(e, mReg)
    let (e, inv) := rcp(e, lSum)
    let (e, logSum) := lg2(e, lSum)
    let (e, ln2) := fconst(e, ln2)
    let (e, final) := storeFinal(e, buf, final, inv, fmul(fadd(mMax, logSum), ln2), out, own)
    (closeRows(e, final), Unit.unit)
  }

  // ---- The correction warpgroup ----------------------------------------------------------------------------------------

  // The correction warpgroup's state across key blocks: its side of each tile's buffer.
  def Correcting (x0: Lifetime)(x1: Lifetime)(m: Lifetime)(o: OState) : Type { kind = lin, scope = union(x0, union(x1, m)) } :=
    Pair(CorrectAt(x0, m, 8, o), CorrectAt(x1, m, 8, o))

  // Warps 8–11, both tiles in turn per key block (A3B.md §3.2): in block 0 set the tile's Ô to 0; in a later block await
  // its α and let each warp rescale its quadrant of Ô when one of its 32 rows has α below 1; publish.
  def correction {L: Lifetime}{x0: Lifetime}{x1: Lifetime}(blocks: Val(L, Grain.uniform, DType.u32))(b0: ScoreBuffer(x0, Rescaler.correction))
      (b1: ScoreBuffer(x1, Rescaler.correction))(c0: CorrectionSide(x0))(c1: CorrectionSide(x1))(m: Lifetime)(e: Ctx(m, Group.warps(8, 4)))
      : Pair(Ctx(m, Group.warps(8, 4)), Unit) := {
    let (e, one) := fconst(e, oneBits)
    let zeroTile := fun {x: Lifetime}{n: Lifetime}(e: Ctx(n, Group.warps(8, 4)))(b: ScoreBuffer(x, Rescaler.correction))
        (st: CorrectAt(x, m, 8, OState.fresh)): Pair(Ctx(n, Group.warps(8, 4)), CorrectAt(x, m, 8, OState.held)) => {
      let (e, r) := zeroQuadrants(e, b, st)
      publishRescaled(e, b, r)
    }
    let rescaleTile := fun {x: Lifetime}{n: Lifetime}(e: Ctx(n, Group.warps(8, 4)))(b: ScoreBuffer(x, Rescaler.correction))
        (st: CorrectAt(x, m, 8, OState.held)): Pair(Ctx(n, Group.warps(8, 4)), CorrectAt(x, m, 8, OState.held)) => {
      let (e, (r, alpha)) := awaitAlpha(e, b, st)
      let (e, grows) := voteAny(e, Core.lt(alpha, one))
      // Each warp rescales its quadrant when its vote says so.
      let (e, r) := when(e, grows, fixedRescaling(x, m, 8), r, fun (k: Lifetime)(e: Ctx(k, Group.warpwise(8, 4)))(r: Rescaling(x, m, 8))
          : Pair(Ctx(k, Group.warpwise(8, 4)), Rescaling(x, m, 8)) => rescaleQuadrant(e, b, r, alpha))
      publishRescaled(e, b, r)
    }
    let first := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Group.warps(8, 4)))(st: Correcting(x0, x1, m, OState.fresh))
        : Pair(Ctx(n, Group.warps(8, 4)), Correcting(x0, x1, m, OState.held)) => {
      let (s0, s1) := st
      let (e, s0) := zeroTile(e, b0, s0)
      let (e, s1) := zeroTile(e, b1, s1)
      (e, (s0, s1))
    }
    let rest := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, Group.warps(8, 4)))(st: Correcting(x0, x1, m, OState.held))
        : Pair(Ctx(n, Group.warps(8, 4)), Correcting(x0, x1, m, OState.held)) => {
      let (s0, s1) := st
      let (e, s0) := rescaleTile(e, b0, s0)
      let (e, s1) := rescaleTile(e, b1, s1)
      (e, (s0, s1))
    }
    let (e, s0) := takeCorrection(e, b0, c0)
    let (e, s1) := takeCorrection(e, b1, c1)
    let (e, (s0, s1)) := loopPeeled(e, blocks, fixedPair(fixedCorrectAt(x0, m, 8, OState.held), fixedCorrectAt(x1, m, 8, OState.held)), (s0, s1),
      first, rest)
    let e := finishCorrection(e, s0)
    (finishCorrection(e, s1), Unit.unit)
  }

  // ---- The CTA ---------------------------------------------------------------------------------------------------------

  // The CTA, given the launch, each tile's authority over its rows of O, and the permits. Tensor memory: each tile's
  // score buffer in one half.
  def cta {l: Lifetime}{t: DType}(e: Ctx(l, CorrectedCta))(g: Launch(l, t))(own0: OOwn(l, t, 0))(own1: OOwn(l, t, 4))(permit: TmemPermit(l))
      (regs: RegPermit(l)): Ctx(l, CorrectedCta) := {
    // The rings, innermost the V ring, around the roles.
    let rings := fun (x0: Lifetime)(x1: Lifetime)(b0: ScoreBuffer(x0, Rescaler.correction))(b1: ScoreBuffer(x1, Rescaler.correction))
        (r0: RowSide(x0))(r1: RowSide(x1))(s0: MmaSide(x0))(s1: MmaSide(x1))(c0: CorrectionSide(x0))(c1: CorrectionSide(x1))
        (e: Ctx(l, CorrectedCta)): Pair(Ctx(l, CorrectedCta), Unit) =>
      withRing(e, qRing, Unit, fun (rq0: Lifetime)(q0r: Ring(rq0, qRing))(pq0: Producer(rq0))(cq0: Consumer(rq0))(e: Ctx(l, CorrectedCta))
          : Pair(Ctx(l, CorrectedCta), Unit) =>
        withRing(e, qRing, Unit, fun (rq1: Lifetime)(q1r: Ring(rq1, qRing))(pq1: Producer(rq1))(cq1: Consumer(rq1))(e: Ctx(l, CorrectedCta))
            : Pair(Ctx(l, CorrectedCta), Unit) =>
          withRing(e, kRing, Unit, fun (rk: Lifetime)(kr: Ring(rk, kRing))(pk: Producer(rk))(ck: Consumer(rk))(e: Ctx(l, CorrectedCta))
              : Pair(Ctx(l, CorrectedCta), Unit) =>
            withRing(e, vRing, Unit, fun (rv: Lifetime)(vr: Ring(rv, vRing))(pv: Producer(rv))(cv: Consumer(rv))(e: Ctx(l, CorrectedCta))
                : Pair(Ctx(l, CorrectedCta), Unit) =>
              (rolesCorrected(e, regs,
                fun (m: Lifetime)(e: Ctx(m, Group.warps(0, 4))): Pair(Ctx(m, Group.warps(0, 4)), Unit) =>
                  softmax(g.blocks, g.mask, g.scale, g.out, own0, b0, r0, m, e),
                fun (m: Lifetime)(e: Ctx(m, Group.warps(4, 4))): Pair(Ctx(m, Group.warps(4, 4)), Unit) =>
                  softmax(g.blocks, g.mask, g.scale, g.out, own1, b1, r1, m, e),
                fun (m: Lifetime)(e: Ctx(m, Group.warps(8, 4))): Pair(Ctx(m, Group.warps(8, 4)), Unit) =>
                  correction(g.blocks, b0, b1, c0, c1, m, e),
                fun (m: Lifetime)(e: Ctx(m, CorrectedIssue)): Pair(Ctx(m, CorrectedIssue), Unit) =>
                  pairIssuer(g.blocks, q0r, q1r, kr, vr, b0, b1, cq0, cq1, ck, cv, s0, s1, m, e),
                fun (m: Lifetime)(e: Ctx(m, CorrectedLoad)): Pair(Ctx(m, CorrectedLoad), Unit) =>
                  pairLoader(g, q0r, q1r, kr, vr, pq0, pq1, pk, pv, m, e)),
                Unit.unit)))))
    let regions := fun (a: Lifetime)(tm: Tmem(a, 512))(acc: Acc(a, AccState.empty))(e: Ctx(l, CorrectedCta))
        : Pair(Ctx(l, CorrectedCta), Pair(Acc(a, AccState.empty), Unit)) =>
      splitTmem(e, tm, acc, 256, Unit, fun (c0: Lifetime)(c1: Lifetime)(t0: Tmem(c0, 256))(acc0: Acc(c0, AccState.empty))(t1: Tmem(c1, 256))
          (acc1: Acc(c1, AccState.empty))(e: Ctx(l, CorrectedCta))
          : Pair(Ctx(l, CorrectedCta), Pair(Pair(Acc(c0, AccState.empty), Acc(c1, AccState.empty)), Unit)) => {
        let (e, (acc0, (acc1, u))) := withCorrectedBuffer(e, t0, acc0, Pair(Acc(c1, AccState.empty), Unit), fun (x0: Lifetime)
            (b0: ScoreBuffer(x0, Rescaler.correction))(r0: RowSide(x0))(s0: MmaSide(x0))(k0: CorrectionSide(x0))(e: Ctx(l, CorrectedCta))
            : Pair(Ctx(l, CorrectedCta), Pair(Acc(c1, AccState.empty), Unit)) =>
          withCorrectedBuffer(e, t1, acc1, Unit, fun (x1: Lifetime)(b1: ScoreBuffer(x1, Rescaler.correction))(r1: RowSide(x1))(s1: MmaSide(x1))
              (k1: CorrectionSide(x1))(e: Ctx(l, CorrectedCta)): Pair(Ctx(l, CorrectedCta), Unit) =>
            rings(x0, x1, b0, b1, r0, r1, s0, s1, k0, k1, e)))
        (e, ((acc0, acc1), Unit.unit))
      })
    let (e, u) := withTmem(e, permit, 512, AccState.empty, Unit, regions)
    e
  }

  // The kernel `name`, causal or not, writing O as `t` (f32 or bf16).
  def kernel (name: String)(causal: Bool)(t: DType): Program :=
    correctedAttentionKernel(name, causal, t, fun (l: Lifetime)(e: Ctx(l, CorrectedCta))(g: Launch(l, t))(own0: OOwn(l, t, 0))(own1: OOwn(l, t, 4))
        (permit: TmemPermit(l))(regs: RegPermit(l)): Ctx(l, CorrectedCta) => cta(e, g, own0, own1, permit, regs))
}

// The non-causal kernel with f32 output, then the causal one with bf16 output.
{ String.append(Core.render(Corrected.kernel("attention_a3b", Bool.false, Cuda.DType.f32)),
    Core.render(Corrected.kernel("attention_a3b_causal", Bool.true, Cuda.DType.bf16))) }
