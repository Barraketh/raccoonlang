// The CTAs the examples share: the attention and GEMM examples' eight warps, of which warp 0 loads, warp 1 issues the
// tensor-core work, warps 2 and 3 idle, and warps 4 to 7 form an aligned warpgroup (`roles4`); and the twelve warps
// of A3a's two query tiles (`rolesPair`). Other layouts use `Core.split`.

import encoding.Core

namespace Layout {
  open Core

  // The warpgroup's first warp, which must be aligned.
  def groupWarp : Nat := 4

  def Cta : Group := Group.cta(256)
  def Load : Group := Group.warps(0, 1)
  def Issue : Group := Group.warps(1, 1)
  def Wg : Group := Group.warps(groupWarp, 4)
  def One : Group := Group.lane

  // Runs `load` on warp 0, `issue` on warp 1 and `group` on the warpgroup, concurrently, then waits for all of them;
  // `group` hands back an `X`.
  def roles4 {l: Lifetime}{kx: Kind}{Sx: Lifetime}{k0: Kind}{S0: Lifetime}{k1: Kind}{S1: Lifetime}{k2: Kind}{S2: Lifetime}
      (e: Ctx(l, Cta))(X: Type { kind = kx, scope = Sx })
      (load: { kind = k0, scope = S0 } (m: Lifetime) -> Ctx(m, Load) -> Pair(Ctx(m, Load), Unit))
      (issue: { kind = k1, scope = S1 } (m: Lifetime) -> Ctx(m, Issue) -> Pair(Ctx(m, Issue), Unit))
      (group: { kind = k2, scope = S2 } (m: Lifetime) -> Ctx(m, Wg) -> Pair(Ctx(m, Wg), X))
      : Pair(Ctx(l, Cta), X) := {
    let idle := fun (m: Lifetime)(e: Ctx(m, Group.warps(2, 2))): Pair(Ctx(m, Group.warps(2, 2)), Unit) => (e, Unit.unit)
    let rest := fun (m: Lifetime)(e: Ctx(m, Group.warps(1, 3))): Pair(Ctx(m, Group.warps(1, 3)), Pair(Unit, Unit)) =>
      split(e, 1, Unit, Unit, issue, idle)
    let first := fun (m: Lifetime)(e: Ctx(m, Group.warps(0, 4))): Pair(Ctx(m, Group.warps(0, 4)), Pair(Unit, Pair(Unit, Unit))) =>
      split(e, 1, Unit, Pair(Unit, Unit), load, rest)
    let (e, (u, x)) := split(e, groupWarp, Pair(Unit, Pair(Unit, Unit)), X, first, group)
    (e, x)
  }

  // ---- Two query tiles (gpu/encoding/A3.md) -------------------------------------------------------------------------

  // The CTA of A3a's attention: twelve warps, of which warps 0–3 and 4–7 form two aligned warpgroups, warp 8 issues
  // the tensor-core work, warp 9 loads, and warps 10 and 11 idle.
  def PairCta : Group := Group.cta(384)
  def PairIssue : Group := Group.warps(8, 1)
  def PairLoad : Group := Group.warps(9, 1)

  // Runs `group0` on warps 0–3, `group1` on warps 4–7, `issue` on warp 8 and `load` on warp 9, concurrently, then waits
  // for all of them.
  def rolesPair {l: Lifetime}{k0: Kind}{S0: Lifetime}{k1: Kind}{S1: Lifetime}{k2: Kind}{S2: Lifetime}{k3: Kind}{S3: Lifetime}(e: Ctx(l, PairCta))
      (group0: { kind = k0, scope = S0 } (m: Lifetime) -> Ctx(m, Group.warps(0, 4)) -> Pair(Ctx(m, Group.warps(0, 4)), Unit))
      (group1: { kind = k1, scope = S1 } (m: Lifetime) -> Ctx(m, Group.warps(4, 4)) -> Pair(Ctx(m, Group.warps(4, 4)), Unit))
      (issue: { kind = k2, scope = S2 } (m: Lifetime) -> Ctx(m, PairIssue) -> Pair(Ctx(m, PairIssue), Unit))
      (load: { kind = k3, scope = S3 } (m: Lifetime) -> Ctx(m, PairLoad) -> Pair(Ctx(m, PairLoad), Unit))
      : Ctx(l, PairCta) := {
    let groups := fun (m: Lifetime)(e: Ctx(m, Group.warps(0, 8))): Pair(Ctx(m, Group.warps(0, 8)), Pair(Unit, Unit)) =>
      split(e, 4, Unit, Unit, group0, group1)
    let idle := fun (m: Lifetime)(e: Ctx(m, Group.warps(10, 2))): Pair(Ctx(m, Group.warps(10, 2)), Unit) => (e, Unit.unit)
    let rest := fun (m: Lifetime)(e: Ctx(m, Group.warps(9, 3))): Pair(Ctx(m, Group.warps(9, 3)), Pair(Unit, Unit)) =>
      split(e, 1, Unit, Unit, load, idle)
    let tensor := fun (m: Lifetime)(e: Ctx(m, Group.warps(8, 4))): Pair(Ctx(m, Group.warps(8, 4)), Pair(Unit, Pair(Unit, Unit))) =>
      split(e, 1, Unit, Pair(Unit, Unit), issue, rest)
    let (e, u) := split(e, 8, Pair(Unit, Unit), Pair(Unit, Pair(Unit, Unit)), groups, tensor)
    e
  }
}
