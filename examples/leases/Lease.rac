// Leases and tokens: capabilities confined to a scope.
//
// Both families are sealed, so only this file may build or match their values. Everything else reaches them through
// the definitions below.

// A lease on the lifetime `l`. Its type is scoped by `l`, so no value of it outlives the `scope` that opened `l`.
sealed inductive Lease (l: Lifetime) : Type { scope = l }
 | mk : Lease(l)

// A token of the lifetime `l`. It is linear: every token is used exactly once, so it can be neither copied nor dropped,
// and a linear family names its lifetime in its scope, so it is consumed before `l` closes.
sealed inductive Tok (l: Lifetime) : Type { kind = lin, scope = l }
 | mk : Tok(l)

// Opens a fresh lifetime and lends it to `f`. The result type `A` is bound outside `f`'s lifetime binder, so `f` cannot
// return anything confined to it. `k` and `S` let the result be a token or an unrestricted value, confined to an
// enclosing scope or to none; `kf` and `Sf` let the callback be linear or not and capture anything. `f` is applied
// exactly once, which is valid at either kind.
def withLease {k: Kind}{S: Lifetime}{A: Type { kind = k, scope = S }}{kf: Kind}{Sf: Lifetime}
    (f: { kind = kf, scope = Sf } (l: Lifetime) -> Lease(l) -> A): A :=
  scope l => f(l, Lease.mk(l))

// A lease's holder may mint tokens of its lifetime.
def issue {l: Lifetime}(h: Lease(l)): Tok(l) := Tok.mk(l)

// Redeeming a token consumes it, and is the only way to.
def redeem {l: Lifetime}(t: Tok(l)): Nat := match t returning Nat with
 | .mk => 1

// Reading through a lease leaves it usable: a lease is unrestricted.
def inspect {l: Lifetime}(h: Lease(l)): Nat := 10
