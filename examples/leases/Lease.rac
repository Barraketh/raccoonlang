// The opener lends one linear read token beside the copyable lease. Returning
// that token closes access; a lease alone cannot create further authority.

sealed inductive Lease (brand: Type) : Type
 | mk : Lease(brand)

sealed inductive Token (brand: Type) : Type { kind = lin }
 | mk : Token(brand)

def read {brand: Type}(lease: Lease(brand))(liveToken: Token(brand))
    : Pair(Token(brand), Nat) := Pair.mk(liveToken, 10)

def redeem {brand: Type}(token: Token(brand)): Nat := match token returning Nat with
 | Token.mk => 1

// The brand is quantified inside the callback; X is fixed outside it. The
// callback must return its token, which this opener consumes before returning X.
def withLease (X: Type){kf: Kind}
    (f: { kind = kf } (brand: Type) -> Lease(brand) -> Token(brand) -> Pair(Token(brand), X)): X := {
  let (returnedToken, value) := f(Unit, Lease.mk(Unit), Token.mk(Unit))
  let _ := redeem(returnedToken)
  value
}
