// Run with `sbt "run examples/leases/main.rac"`. Lease.rac is the module this file imports.
import Lease

// The callback captures nothing, so it is unrestricted and unscoped, and so is its result.
def plain : Nat := withLease(fun (l: Lifetime)(h: Lease(l)): Nat => 0)

// The callback captures the token `t`, so it is linear and scoped by `m`, as is its result. Consuming `t` in the
// callback is its one use here.
def pass {m: Lifetime}(t: Tok(m)): Tok(m) := withLease(fun (l: Lifetime)(h: Lease(l)): Tok(m) => t)

// The callback captures the lease `g`, so it is scoped by `m` but unrestricted.
def peek {m: Lifetime}(g: Lease(m)): Nat := withLease(fun (l: Lifetime)(h: Lease(l)): Nat => inspect(g))

// A token issued in a lifetime is redeemed inside it. The checker rejects every other way to treat it:
//   binding it with `let t := issue(g)` and never using `t`         LinearUnused
//   redeeming `t` twice                                             LinearReused
//   returning `issue(g)` from the callback, at type Tok(m)          withLease's A cannot name the callback's m
//   minting one with `Tok.mk(m)` here, outside its module           SealedConstructor
// and a function that names the lifetime belongs to it, so it cannot leave either:
//   returning `fun (u: Unit): Nat => List.length(List.nil(Lease(m)))`
//   from the callback, at type Unit -> Nat                         TypeMismatch: the function is at scope m
def spend : Nat := withLease(fun (m: Lifetime)(g: Lease(m)): Nat => Nat.add(redeem(pass(issue(g))), peek(g)))

// `scope` opens a lifetime directly, as `withLease` does. Here too a value whose type names it cannot leave:
// `scope l => List.nil(Lease(l))` as a definition's body is LifetimeEscapes.
def none : Nat := scope l => List.length(List.nil(Lease(l)))

{ Nat.add(plain, Nat.add(none, spend)) }
