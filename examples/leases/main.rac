// Run with `sbt "run examples/leases/main.rac"`. Lease.rac seals the token.
import Lease

def plain : Nat := withLease(Nat, fun (brand: Type)(lease: Lease(brand))(liveToken: Token(brand)): Pair(Token(brand), Nat) => {
  let (firstToken, first) := read(lease, liveToken)
  let (returnedToken, second) := read(lease, firstToken)
  Pair.mk(returnedToken, Nat.add(first, second))
})

{ plain }
