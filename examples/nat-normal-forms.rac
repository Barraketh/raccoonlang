axiom a: Nat
axiom b: Nat

// Associativity, commutativity, and numeral arithmetic hold by reflexivity.
def commutative (x: Nat)(y: Nat): Eq(Nat, Nat.add(x, y), Nat.add(y, x)) := Eq.refl(Nat.add(x, y))

def regrouped (x: Nat)(y: Nat)(z: Nat):
    Eq(Nat, Nat.mul(Nat.mul(x, y), z), Nat.mul(y, Nat.mul(z, x))) := Eq.refl(Nat.mul(x, Nat.mul(y, z)))

def doubled (x: Nat)(y: Nat):
    Eq(Nat, Nat.mul(2, Nat.add(x, y)), Nat.add(Nat.add(x, y), Nat.add(y, x))) :=
  Eq.refl(Nat.add(Nat.add(x, y), Nat.add(y, x)))

// Distributivity over a symbolic multiplier is the prelude axiom; its instances follow by conversion.
def distributive (x: Nat)(y: Nat)(z: Nat):
    Eq(Nat, Nat.mul(x, Nat.add(y, z)), Nat.add(Nat.mul(x, y), Nat.mul(x, z))) := Nat.mul_add(x, y, z)

def rightDistributive (x: Nat)(y: Nat)(z: Nat):
    Eq(Nat, Nat.mul(Nat.add(x, y), z), Nat.add(Nat.mul(x, z), Nat.mul(y, z))) := Nat.mul_add(z, x, y)

def successorStep (x: Nat)(y: Nat):
    Eq(Nat, Nat.mul(x, Nat.succ(y)), Nat.add(Nat.mul(x, y), x)) := Nat.mul_add(x, y, 1)

// Powers of equal bases add their exponents, symbolic or not, and powers of one are one.
def productLaw (x: Nat)(a: Nat)(b: Nat):
    Eq(Nat, Nat.mul(Nat.pow(x, a), Nat.pow(x, b)), Nat.pow(x, Nat.add(b, a))) := Eq.refl(Nat.pow(x, Nat.add(a, b)))

def unitPower (e: Nat): Eq(Nat, Nat.pow(1, e), 1) := Eq.refl(1)

// Powers of products and powers of powers are prelude theorems.
def powerOfProduct (x: Nat)(y: Nat)(a: Nat):
    Eq(Nat, Nat.pow(Nat.mul(x, y), a), Nat.mul(Nat.pow(x, a), Nat.pow(y, a))) := Nat.mul_pow(x, y, a)

def powerOfPower (x: Nat)(a: Nat)(b: Nat):
    Eq(Nat, Nat.pow(Nat.pow(x, a), b), Nat.pow(x, Nat.mul(a, b))) := Nat.pow_mul(x, a, b)

{
  Nat.add(
    Nat.add(Nat.mul(Nat.pow(Nat.add(a, b), 2), Nat.add(b, a)), Nat.mul(a, 2)),
    Nat.pow(2, Nat.succ(b))
  )
}
