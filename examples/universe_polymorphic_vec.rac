inductive Vec(u: Level)(A: Sort { level = u }) indices (n: Nat) : Sort { level = max(one, u) }
 | nil : Vec(u, A, Nat.zero)
 | cons (n: Nat)(vec: Vec(u, A, n))(elem: A): Vec(u, A, Nat.succ(n))

inductive Couple(u1: Level)(u2: Level)(A: Sort { level = u1 })(B: Sort { level = u2 }): Sort { level = max(u1, u2) }
 | mk (a: A)(b: B): Couple(u1, u2, A, B)

def zip(u1: Level)(u2: Level)(A: Sort { level = u1 })(B: Sort { level = u2 })(n: Nat)(va: Vec(u1, A, n))(vb: Vec(u2, B, n)): Vec(Level.max(u1, u2), Couple(u1, u2, A, B), n) decreases structural(n) := {
  let R := Couple(u1, u2, A, B)
  match va returning Vec(Level.max(u1, u2), R, n) with
  | Vec.nil => Vec.nil(R)
  | Vec.cons x va0 a => {
    match vb returning Vec(Level.max(u1, u2), R, n) with
    | Vec.cons _ vb0 b => Vec.cons(x, zip(u1, u2, A, B, x, va0, vb0), Couple.mk(a, b))
  }
}
