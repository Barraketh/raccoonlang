import buffer.Program

def useAfterExport {r: Type}{m: Type}{b: Type}
    (ctx: Buffer.Ctx(r, m))(handle: Buffer.OutputHandle(r, b))(owner: Buffer.OutputOwn(r, b))
    (offset: Buffer.Val64(r, m))(value: Buffer.Val32(r, m))
    : Pair(Buffer.Ctx(r, m), Buffer.OutputOwn(r, b)) := {
  let closed := Buffer.exportOutput(ctx, handle, owner)
  Buffer.store8Output(closed, handle, owner, offset, value)
}

{ Unit.unit }
