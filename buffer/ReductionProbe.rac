import buffer.Program
import buffer.Access

def sumBytesWithCount(countValue: Nat): Buffer.Result := {
  let (program, _) := Buffer.build(Nat, fun (r: Type)(ctx: Buffer.Ctx(r, r)): Pair(Buffer.Ctx(r, r), Nat) => {
    let (afterInput, _) := Buffer.withInput(ctx, 3, Nat,
        fun (inputBrand: Type)(input: Buffer.InputHandle(r, inputBrand))(inputCtx: Buffer.Ctx(r, r))
            : Pair(Buffer.Ctx(r, r), Nat) => {
      let (afterScratch, _) := Buffer.withScratch(inputCtx, 3, Nat,
          fun (scratchBrand: Type)(scratch: Buffer.ScratchHandle(r, scratchBrand))
              (scratchOwner: Buffer.ScratchOwn(r, scratchBrand))(scratchCtx: Buffer.Ctx(r, r))
              : Pair(Buffer.Ctx(r, r), Nat) => {
        let (afterOutput, (returnedScratch, _)) := Buffer.withOutput(scratchCtx, 4,
            Pair(Buffer.ScratchOwn(r, scratchBrand), Nat),
            fun (outputBrand: Type)(output: Buffer.OutputHandle(r, outputBrand))(outputOwner: Buffer.OutputOwn(r, outputBrand))
                (outputCtx: Buffer.Ctx(r, r))
                : Pair(Buffer.Ctx(r, r), Pair(Buffer.ScratchOwn(r, scratchBrand), Nat)) => {
              let (afterOffset, offset) := Buffer.const64(outputCtx, 0)
              let (afterCount, count) := Buffer.const32(afterOffset, countValue)
              let (afterZero, zero) := Buffer.const32(afterCount, 0)
              let (registerCtx, accumulator) := Buffer.newReg32(afterZero)
              let initialized := Buffer.setReg32(registerCtx, accumulator, zero)
              let fixedOwners := Buffer.fixedPair(Buffer.fixedScratch(scratch), Buffer.fixedOutput(output))
              let (loopCtx, loopOwners) := Buffer.repeat32(initialized, count, fixedOwners,
                  (scratchOwner, outputOwner),
                  fun (frame: Type)(view: BufferAccess.View(r, frame))(index: Buffer.Val32(r, frame))
                      (bodyCtx: Buffer.Ctx(r, frame))
                      (state: Pair(Buffer.ScratchOwn(r, scratchBrand), Buffer.OutputOwn(r, outputBrand)))
                      : Pair(Buffer.Ctx(r, frame), Pair(Buffer.ScratchOwn(r, scratchBrand), Buffer.OutputOwn(r, outputBrand))) => {
                    let (bodyScratch, bodyOutput) := state
                    let bodyZero := Buffer.lift32(view, zero)
                    let (wideCtx, wideIndex) := Buffer.extend32To64(bodyCtx, index)
                    let (loaded, byte) := Buffer.load8Input(wideCtx, input, wideIndex)
                    let (saved, savedScratch) := Buffer.store8Scratch(loaded, scratch, bodyScratch, wideIndex, byte)
                    let (gotSum, oldSum) := Buffer.getReg32(saved, accumulator)
                    let (added, newSum) := Buffer.add32(gotSum, oldSum, byte)
                    let updated := Buffer.setReg32(added, accumulator, newSum)
                    (updated, (savedScratch, bodyOutput))
                  })
              let (checked, isZero) := Buffer.eq32(loopCtx, count, zero)
              let (branchCtx, branchOwners) := Buffer.ifThenElse(checked, isZero, fixedOwners, loopOwners,
                  fun (frame: Type)(view: BufferAccess.View(r, frame))(yesCtx: Buffer.Ctx(r, frame))
                      (state: Pair(Buffer.ScratchOwn(r, scratchBrand), Buffer.OutputOwn(r, outputBrand)))
                      : Pair(Buffer.Ctx(r, frame), Pair(Buffer.ScratchOwn(r, scratchBrand), Buffer.OutputOwn(r, outputBrand))) => {
                    let (yesScratch, yesOutput) := state
                    let bodyZero := Buffer.lift32(view, zero)
                    let reset := Buffer.setReg32(yesCtx, accumulator, bodyZero)
                    (reset, (yesScratch, yesOutput))
                  },
                  fun (frame: Type)(view: BufferAccess.View(r, frame))(noCtx: Buffer.Ctx(r, frame))
                      (state: Pair(Buffer.ScratchOwn(r, scratchBrand), Buffer.OutputOwn(r, outputBrand)))
                      : Pair(Buffer.Ctx(r, frame), Pair(Buffer.ScratchOwn(r, scratchBrand), Buffer.OutputOwn(r, outputBrand))) =>
                    (noCtx, state))
              let (finalScratchOwner, finalOutputOwner) := branchOwners
              let (readTotal, total) := Buffer.getReg32(branchCtx, accumulator)
              let (writeTotal, finalOutput) := Buffer.store32Output(readTotal, output, finalOutputOwner, offset, total)
              let finishedOutput := Buffer.exportOutput(writeTotal, output, finalOutput)
              (finishedOutput, (finalScratchOwner, Nat.zero))
            })
        let finishedScratch := Buffer.releaseScratch(afterOutput, scratch, returnedScratch)
        (finishedScratch, Nat.zero)
      })
      (afterScratch, Nat.zero)
    })
    (afterInput, Nat.zero)
  })
  Buffer.run(program, List.cons(List.cons(2, List.cons(3, List.cons(5, List.nil(Nat)))), List.nil(List(Nat))))
}

def sumBytes: Buffer.Result := sumBytesWithCount(3)
def sumEmptyBytes: Buffer.Result := sumBytesWithCount(0)

{ Pair.mk(sumBytes, sumEmptyBytes) }
