// Pure source builders for finite programs over private little-endian byte buffers.
// Each allocation exists for the whole native invocation, even when its builder is nested in a repeat body.
import buffer.Access

namespace Buffer {
  // Only this module can emit bytecode or create frame permissions.
  sealed inductive Key : Type
   | key : Key

  struct State : Type
   | mk (next32: Nat)(next64: Nat)(bufferCount: Nat)(instructionCount: Nat)
        (buffersReversed: List(Nat))(codeReversed: List(Nat)) : State

  sealed inductive Ctx (r: Type)(m: Type) : Type { kind = lin }
   | mk (permission: BufferAccess.Token(m))(state: State) : Ctx(r, m)

  sealed struct Program : Type
   | mk (words: List(Nat)) : Program

  // Programs are immutable, so exposing their serialized words is safe for generic preparation and inspection.
  def programWords (program: Program): List(Nat) := program.words

  sealed struct InputHandle (r: Type)(b: Type) : Type
   | mk (id: Nat)(bytes: Nat) : InputHandle(r, b)

  sealed struct ScratchHandle (r: Type)(b: Type) : Type
   | mk (id: Nat)(bytes: Nat) : ScratchHandle(r, b)

  sealed inductive ScratchOwn (r: Type)(b: Type) : Type { kind = lin }
   | mk : ScratchOwn(r, b)

  sealed struct OutputHandle (r: Type)(b: Type) : Type
   | mk (id: Nat)(bytes: Nat) : OutputHandle(r, b)

  // Public extents let higher-level source libraries size loops without exposing buffer IDs or storage.
  def inputBytes {r: Type}{b: Type}(handle: InputHandle(r, b)): Nat := handle.bytes
  def scratchBytes {r: Type}{b: Type}(handle: ScratchHandle(r, b)): Nat := handle.bytes
  def outputBytes {r: Type}{b: Type}(handle: OutputHandle(r, b)): Nat := handle.bytes

  sealed inductive OutputOwn (r: Type)(b: Type) : Type { kind = lin }
   | mk : OutputOwn(r, b)

  sealed struct Val32 (r: Type)(s: Type) : Type
   | mk (id: Nat) : Val32(r, s)

  sealed struct Val64 (r: Type)(s: Type) : Type
   | mk (id: Nat) : Val64(r, s)

  // Registers are mutable program state; Val values are immutable snapshots copied from them.
  sealed struct Reg32 (r: Type) : Type
   | mk (id: Nat) : Reg32(r)

  sealed struct Reg64 (r: Type) : Type
   | mk (id: Nat) : Reg64(r)

  sealed inductive Fixed {k: Kind}(S: Type { kind = k }) : Type
   | mk : Fixed(S)

  inductive Result : Type
   | success (outputs: List(List(Nat))) : Result
   | failure (code: Nat) : Result

  def fixedUnit : Fixed(Unit) := Fixed.mk(Unit)

  def fixedScratch {r: Type}{b: Type}(handle: ScratchHandle(r, b)): Fixed(ScratchOwn(r, b)) :=
    Fixed.mk(ScratchOwn(r, b))

  def fixedOutput {r: Type}{b: Type}(handle: OutputHandle(r, b)): Fixed(OutputOwn(r, b)) :=
    Fixed.mk(OutputOwn(r, b))

  def fixedPair {ka: Kind}{A: Type { kind = ka }}
      {kb: Kind}{B: Type { kind = kb }}
      (a: Fixed(A))(b: Fixed(B)): Fixed(Pair(A, B)) := Fixed.mk(Pair(A, B))

  def emit {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m))(opcode: Nat)(operands: List(Nat)): Ctx(r, m) := {
    match ctx returning Ctx(r, m) with
    | Ctx.mk permission state => {
      let reversed := List.reverse(List.cons(opcode, operands))
      let nextCode := List.append(reversed, state.codeReversed)
      Ctx.mk(r, permission, State.mk(state.next32, state.next64, state.bufferCount, Nat.succ(state.instructionCount),
        state.buffersReversed, nextCode))
    }
  }

  def fresh32 {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m)): Pair(Ctx(r, m), Val32(r, m)) := {
    match ctx returning Pair(Ctx(r, m), Val32(r, m)) with
    | Ctx.mk permission state =>
      (Ctx.mk(r, permission, State.mk(Nat.succ(state.next32), state.next64, state.bufferCount, state.instructionCount,
        state.buffersReversed, state.codeReversed)), Val32.mk(r, m, state.next32))
  }

  def fresh64 {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m)): Pair(Ctx(r, m), Val64(r, m)) := {
    match ctx returning Pair(Ctx(r, m), Val64(r, m)) with
    | Ctx.mk permission state =>
      (Ctx.mk(r, permission, State.mk(state.next32, Nat.succ(state.next64), state.bufferCount, state.instructionCount,
        state.buffersReversed, state.codeReversed)), Val64.mk(r, m, state.next64))
  }

  def allocate {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m))(role: Nat)(bytes: Nat): Pair(Ctx(r, m), Nat) := {
    match ctx returning Pair(Ctx(r, m), Nat) with
    | Ctx.mk permission state => {
      // Descriptors are serialized in allocation order. Each buffer ID is its position in this list.
      let reversed := List.cons(bytes, List.cons(role, state.buffersReversed))
      (Ctx.mk(r, permission, State.mk(state.next32, state.next64, Nat.succ(state.bufferCount), state.instructionCount,
        reversed, state.codeReversed)), state.bufferCount)
    }
  }

  def build {kf: Kind}{kx: Kind}
      (X: Type { kind = kx })
      (body: { kind = kf } (r: Type) -> Ctx(r, r) -> Pair(Ctx(r, r), X))
      : Pair(Program, X) := BufferAccess.root(Pair(Program, X), fun (r: Type)(permission: BufferAccess.Token(r))
          : Pair(BufferAccess.Token(r), Pair(Program, X)) => {
    let initial := State.mk(0, 0, 0, 0, List.nil(Nat), List.nil(Nat))
    let (ctx, result) := body(r, Ctx.mk(r, permission, initial))
    match ctx returning Pair(BufferAccess.Token(r), Pair(Program, X)) with
    | Ctx.mk returned state => {
      let code := List.append(List.reverse(state.codeReversed), List.cons(0, List.nil(Nat)))
      let header := List.cons(1112884806, List.cons(3,
        List.cons(state.next32, List.cons(state.next64,
          List.cons(state.bufferCount, List.cons(Nat.succ(state.instructionCount), List.nil(Nat)))))))
      let descriptors := List.reverse(state.buffersReversed)
      let instructions := code
      (returned, (Program.mk(List.append(header, List.append(descriptors, instructions))), result))
    }
  })

  def withInput {r: Type}{m: Type}{kf: Kind}{kx: Kind}
      (ctx: Ctx(r, m))(bytes: Nat)(X: Type { kind = kx })
      (body: { kind = kf } (b: Type) -> InputHandle(r, b) -> Ctx(r, m) -> Pair(Ctx(r, m), X))
      : Pair(Ctx(r, m), X) := {
    let (withBuffer, id) := allocate(Key.key, ctx, 0, bytes)
    BufferAccess.root(Pair(Ctx(r, m), X), fun (b: Type)(brandToken: BufferAccess.Token(b))
        : Pair(BufferAccess.Token(b), Pair(Ctx(r, m), X)) => {
      let (inside, result) := body(b, InputHandle.mk(r, b, id, bytes), withBuffer)
      (brandToken, (inside, result))
    })
  }

  def withScratch {r: Type}{m: Type}{kf: Kind}{kx: Kind}
      (ctx: Ctx(r, m))(bytes: Nat)(X: Type { kind = kx })
      (body: { kind = kf } (b: Type) -> ScratchHandle(r, b) -> ScratchOwn(r, b) -> Ctx(r, m) -> Pair(Ctx(r, m), X))
      : Pair(Ctx(r, m), X) := {
    let (withBuffer, id) := allocate(Key.key, ctx, 1, bytes)
    BufferAccess.root(Pair(Ctx(r, m), X), fun (b: Type)(brandToken: BufferAccess.Token(b))
        : Pair(BufferAccess.Token(b), Pair(Ctx(r, m), X)) => {
      let (inside, result) := body(b, ScratchHandle.mk(r, b, id, bytes), ScratchOwn.mk(r, b), withBuffer)
      (brandToken, (inside, result))
    })
  }

  def withOutput {r: Type}{m: Type}{kf: Kind}{kx: Kind}
      (ctx: Ctx(r, m))(bytes: Nat)(X: Type { kind = kx })
      (body: { kind = kf } (b: Type) -> OutputHandle(r, b) -> OutputOwn(r, b) -> Ctx(r, m) -> Pair(Ctx(r, m), X))
      : Pair(Ctx(r, m), X) := {
    let (withBuffer, id) := allocate(Key.key, ctx, 2, bytes)
    BufferAccess.root(Pair(Ctx(r, m), X), fun (b: Type)(brandToken: BufferAccess.Token(b))
        : Pair(BufferAccess.Token(b), Pair(Ctx(r, m), X)) => {
      let (inside, result) := body(b, OutputHandle.mk(r, b, id, bytes), OutputOwn.mk(r, b), withBuffer)
      (brandToken, (inside, result))
    })
  }

  def releaseScratch {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))
      (handle: ScratchHandle(r, b))(own: ScratchOwn(r, b)): Ctx(r, m) := {
    match own returning Ctx(r, m) with
    | ScratchOwn.mk => ctx
  }

  def exportOutput {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))
      (handle: OutputHandle(r, b))(own: OutputOwn(r, b)): Ctx(r, m) := {
    match own returning Ctx(r, m) with
    | OutputOwn.mk => ctx
  }

  def const32 {r: Type}{m: Type}(ctx: Ctx(r, m))(value: Nat): Pair(Ctx(r, m), Val32(r, m)) := {
    let (withRegister, dst) := fresh32(Key.key, ctx)
    (emit(Key.key, withRegister, 1, List.cons(dst.id, List.cons(value, List.nil(Nat)))), dst)
  }

  def const64 {r: Type}{m: Type}(ctx: Ctx(r, m))(value: Nat): Pair(Ctx(r, m), Val64(r, m)) := {
    let (withRegister, dst) := fresh64(Key.key, ctx)
    (emit(Key.key, withRegister, 2, List.cons(dst.id, List.cons(value, List.nil(Nat)))), dst)
  }

  def newReg32 {r: Type}{m: Type}(ctx: Ctx(r, m)): Pair(Ctx(r, m), Reg32(r)) := {
    let (next, slot) := fresh32(Key.key, ctx)
    (next, Reg32.mk(r, slot.id))
  }

  def newReg64 {r: Type}{m: Type}(ctx: Ctx(r, m)): Pair(Ctx(r, m), Reg64(r)) := {
    let (next, slot) := fresh64(Key.key, ctx)
    (next, Reg64.mk(r, slot.id))
  }

  def getReg32 {r: Type}{m: Type}(ctx: Ctx(r, m))(reg: Reg32(r)): Pair(Ctx(r, m), Val32(r, m)) := {
    let (next, value) := fresh32(Key.key, ctx)
    (emit(Key.key, next, 3, List.cons(value.id, List.cons(reg.id, List.nil(Nat)))), value)
  }

  def setReg32 {r: Type}{m: Type}(ctx: Ctx(r, m))(reg: Reg32(r))(value: Val32(r, m)): Ctx(r, m) :=
    emit(Key.key, ctx, 3, List.cons(reg.id, List.cons(value.id, List.nil(Nat))))

  def getReg64 {r: Type}{m: Type}(ctx: Ctx(r, m))(reg: Reg64(r)): Pair(Ctx(r, m), Val64(r, m)) := {
    let (next, value) := fresh64(Key.key, ctx)
    (emit(Key.key, next, 4, List.cons(value.id, List.cons(reg.id, List.nil(Nat)))), value)
  }

  def setReg64 {r: Type}{m: Type}(ctx: Ctx(r, m))(reg: Reg64(r))(value: Val64(r, m)): Ctx(r, m) :=
    emit(Key.key, ctx, 4, List.cons(reg.id, List.cons(value.id, List.nil(Nat))))

  def alu32 {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m))
      (left: Val32(r, m))(right: Val32(r, m))(operator: Nat): Pair(Ctx(r, m), Val32(r, m)) := {
    let (withRegister, dst) := fresh32(Key.key, ctx)
    (emit(Key.key, withRegister, 5, List.cons(dst.id, List.cons(left.id, List.cons(right.id, List.cons(operator, List.nil(Nat)))))), dst)
  }

  def alu64 {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m))
      (left: Val64(r, m))(right: Val64(r, m))(operator: Nat): Pair(Ctx(r, m), Val64(r, m)) := {
    let (withRegister, dst) := fresh64(Key.key, ctx)
    (emit(Key.key, withRegister, 6, List.cons(dst.id, List.cons(left.id, List.cons(right.id, List.cons(operator, List.nil(Nat)))))), dst)
  }

  def add32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 0)
  def sub32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 1)
  def mul32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 2)
  def udiv32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 3)
  def urem32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 4)
  def and32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 5)
  def or32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 6)
  def xor32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 7)
  def shl32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 8)
  def lshr32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m)): Pair(Ctx(r, m), Val32(r, m)) := alu32(Key.key, ctx, x, y, 9)
  def add64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 0)
  def sub64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 1)
  def mul64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 2)
  def udiv64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 3)
  def urem64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 4)
  def and64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 5)
  def or64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 6)
  def xor64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 7)
  def shl64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 8)
  def lshr64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := alu64(Key.key, ctx, x, y, 9)

  def eq32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m))
      : Pair(Ctx(r, m), Val32(r, m)) := {
    let (withRegister, dst) := fresh32(Key.key, ctx)
    (emit(Key.key, withRegister, 7, List.cons(dst.id, List.cons(x.id, List.cons(y.id, List.cons(0, List.nil(Nat)))))), dst)
  }

  def ult32 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))(y: Val32(r, m))
      : Pair(Ctx(r, m), Val32(r, m)) := {
    let (withRegister, dst) := fresh32(Key.key, ctx)
    (emit(Key.key, withRegister, 7, List.cons(dst.id, List.cons(x.id, List.cons(y.id, List.cons(1, List.nil(Nat)))))), dst)
  }

  def eq64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m))
      : Pair(Ctx(r, m), Val32(r, m)) := {
    let (withRegister, dst) := fresh32(Key.key, ctx)
    (emit(Key.key, withRegister, 8, List.cons(dst.id, List.cons(x.id, List.cons(y.id, List.cons(0, List.nil(Nat)))))), dst)
  }

  def ult64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val64(r, m))(y: Val64(r, m))
      : Pair(Ctx(r, m), Val32(r, m)) := {
    let (withRegister, dst) := fresh32(Key.key, ctx)
    (emit(Key.key, withRegister, 8, List.cons(dst.id, List.cons(x.id, List.cons(y.id, List.cons(1, List.nil(Nat)))))), dst)
  }

  def lift32 {r: Type}{parent: Type}{child: Type}(view: BufferAccess.View(parent, child))(value: Val32(r, parent)): Val32(r, child) :=
    Val32.mk(r, child, value.id)

  def lift64 {r: Type}{parent: Type}{child: Type}(view: BufferAccess.View(parent, child))(value: Val64(r, parent)): Val64(r, child) :=
    Val64.mk(r, child, value.id)

  def extend32To64 {r: Type}{m: Type}(ctx: Ctx(r, m))(x: Val32(r, m))
      : Pair(Ctx(r, m), Val64(r, m)) := {
    let (withRegister, dst) := fresh64(Key.key, ctx)
    (emit(Key.key, withRegister, 23, List.cons(dst.id, List.cons(x.id, List.nil(Nat)))), dst)
  }

  def load32 {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m))
      (buffer: Nat)(offset: Val64(r, m))(opcode: Nat): Pair(Ctx(r, m), Val32(r, m)) := {
    let (withRegister, dst) := fresh32(Key.key, ctx)
    (emit(Key.key, withRegister, opcode, List.cons(dst.id, List.cons(buffer, List.cons(offset.id, List.nil(Nat))))), dst)
  }

  def load64 {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m))
      (buffer: Nat)(offset: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := {
    let (withRegister, dst) := fresh64(Key.key, ctx)
    (emit(Key.key, withRegister, 12, List.cons(dst.id, List.cons(buffer, List.cons(offset.id, List.nil(Nat))))), dst)
  }

  def load8Input {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: InputHandle(r, b))(offset: Val64(r, m)): Pair(Ctx(r, m), Val32(r, m)) := load32(Key.key, ctx, buffer.id, offset, 9)
  def load16Input {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: InputHandle(r, b))(offset: Val64(r, m)): Pair(Ctx(r, m), Val32(r, m)) := load32(Key.key, ctx, buffer.id, offset, 10)
  def load32Input {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: InputHandle(r, b))(offset: Val64(r, m)): Pair(Ctx(r, m), Val32(r, m)) := load32(Key.key, ctx, buffer.id, offset, 11)
  def load64Input {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: InputHandle(r, b))(offset: Val64(r, m)): Pair(Ctx(r, m), Val64(r, m)) := load64(Key.key, ctx, buffer.id, offset)

  def load8Scratch {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: ScratchHandle(r, b))(own: ScratchOwn(r, b))(offset: Val64(r, m))
      : Pair(Ctx(r, m), Pair(ScratchOwn(r, b), Val32(r, m))) := {
    let (next, value) := load32(Key.key, ctx, buffer.id, offset, 9)
    (next, (own, value))
  }

  def load16Scratch {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: ScratchHandle(r, b))(own: ScratchOwn(r, b))(offset: Val64(r, m))
      : Pair(Ctx(r, m), Pair(ScratchOwn(r, b), Val32(r, m))) := {
    let (next, value) := load32(Key.key, ctx, buffer.id, offset, 10)
    (next, (own, value))
  }

  def load32Scratch {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: ScratchHandle(r, b))(own: ScratchOwn(r, b))(offset: Val64(r, m))
      : Pair(Ctx(r, m), Pair(ScratchOwn(r, b), Val32(r, m))) := {
    let (next, value) := load32(Key.key, ctx, buffer.id, offset, 11)
    (next, (own, value))
  }

  def load64Scratch {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: ScratchHandle(r, b))(own: ScratchOwn(r, b))(offset: Val64(r, m))
      : Pair(Ctx(r, m), Pair(ScratchOwn(r, b), Val64(r, m))) := {
    let (next, value) := load64(Key.key, ctx, buffer.id, offset)
    (next, (own, value))
  }

  def load8Output {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: OutputHandle(r, b))(own: OutputOwn(r, b))(offset: Val64(r, m))
      : Pair(Ctx(r, m), Pair(OutputOwn(r, b), Val32(r, m))) := {
    let (next, value) := load32(Key.key, ctx, buffer.id, offset, 9)
    (next, (own, value))
  }

  def load16Output {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: OutputHandle(r, b))(own: OutputOwn(r, b))(offset: Val64(r, m))
      : Pair(Ctx(r, m), Pair(OutputOwn(r, b), Val32(r, m))) := {
    let (next, value) := load32(Key.key, ctx, buffer.id, offset, 10)
    (next, (own, value))
  }

  def load32Output {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: OutputHandle(r, b))(own: OutputOwn(r, b))(offset: Val64(r, m))
      : Pair(Ctx(r, m), Pair(OutputOwn(r, b), Val32(r, m))) := {
    let (next, value) := load32(Key.key, ctx, buffer.id, offset, 11)
    (next, (own, value))
  }

  def load64Output {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: OutputHandle(r, b))(own: OutputOwn(r, b))(offset: Val64(r, m))
      : Pair(Ctx(r, m), Pair(OutputOwn(r, b), Val64(r, m))) := {
    let (next, value) := load64(Key.key, ctx, buffer.id, offset)
    (next, (own, value))
  }

  def store32 {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m))
      (buffer: Nat)(offset: Val64(r, m))(value: Val32(r, m))(opcode: Nat): Ctx(r, m) :=
    emit(Key.key, ctx, opcode, List.cons(buffer, List.cons(offset.id, List.cons(value.id, List.nil(Nat)))))

  def store64 {r: Type}{m: Type}(key: Key)(ctx: Ctx(r, m))
      (buffer: Nat)(offset: Val64(r, m))(value: Val64(r, m)): Ctx(r, m) :=
    emit(Key.key, ctx, 16, List.cons(buffer, List.cons(offset.id, List.cons(value.id, List.nil(Nat)))))

  def store8Output {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: OutputHandle(r, b))(own: OutputOwn(r, b))(offset: Val64(r, m))(value: Val32(r, m))
      : Pair(Ctx(r, m), OutputOwn(r, b)) := (store32(Key.key, ctx, buffer.id, offset, value, 13), own)
  def store16Output {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: OutputHandle(r, b))(own: OutputOwn(r, b))(offset: Val64(r, m))(value: Val32(r, m))
      : Pair(Ctx(r, m), OutputOwn(r, b)) := (store32(Key.key, ctx, buffer.id, offset, value, 14), own)
  def store32Output {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: OutputHandle(r, b))(own: OutputOwn(r, b))(offset: Val64(r, m))(value: Val32(r, m))
      : Pair(Ctx(r, m), OutputOwn(r, b)) := (store32(Key.key, ctx, buffer.id, offset, value, 15), own)
  def store64Output {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: OutputHandle(r, b))(own: OutputOwn(r, b))(offset: Val64(r, m))(value: Val64(r, m))
      : Pair(Ctx(r, m), OutputOwn(r, b)) := (store64(Key.key, ctx, buffer.id, offset, value), own)

  def store8Scratch {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: ScratchHandle(r, b))(own: ScratchOwn(r, b))(offset: Val64(r, m))(value: Val32(r, m))
      : Pair(Ctx(r, m), ScratchOwn(r, b)) := (store32(Key.key, ctx, buffer.id, offset, value, 13), own)
  def store16Scratch {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: ScratchHandle(r, b))(own: ScratchOwn(r, b))(offset: Val64(r, m))(value: Val32(r, m))
      : Pair(Ctx(r, m), ScratchOwn(r, b)) := (store32(Key.key, ctx, buffer.id, offset, value, 14), own)
  def store32Scratch {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: ScratchHandle(r, b))(own: ScratchOwn(r, b))(offset: Val64(r, m))(value: Val32(r, m))
      : Pair(Ctx(r, m), ScratchOwn(r, b)) := (store32(Key.key, ctx, buffer.id, offset, value, 15), own)
  def store64Scratch {r: Type}{m: Type}{b: Type}(ctx: Ctx(r, m))(buffer: ScratchHandle(r, b))(own: ScratchOwn(r, b))(offset: Val64(r, m))(value: Val64(r, m))
      : Pair(Ctx(r, m), ScratchOwn(r, b)) := (store64(Key.key, ctx, buffer.id, offset, value), own)

  def ifThenElse {r: Type}{m: Type}{k: Kind}{S: Type { kind = k }}
      (ctx: Ctx(r, m))(condition: Val32(r, m))(fixed: Fixed(S))(state: S)
      (yes: (n: Type) -> BufferAccess.View(m, n) -> Ctx(r, n) -> S -> Pair(Ctx(r, n), S))
      (no: (n: Type) -> BufferAccess.View(m, n) -> Ctx(r, n) -> S -> Pair(Ctx(r, n), S))
      : Pair(Ctx(r, m), S) := {
    let begin := emit(Key.key, ctx, 17, List.cons(condition.id, List.nil(Nat)))
    match begin returning Pair(Ctx(r, m), S) with
    | Ctx.mk parentToken beginState => {
      let (afterYesToken, (yesState, afterYes)) := BufferAccess.within(parentToken, Pair(State, S),
          fun (n: Type)(view: BufferAccess.View(m, n))(childToken: BufferAccess.Token(n))
              : Pair(BufferAccess.Token(n), Pair(State, S)) => {
        let (yesCtx, yesResult) := yes(n, view, Ctx.mk(r, childToken, beginState), state)
        match yesCtx returning Pair(BufferAccess.Token(n), Pair(State, S)) with
        | Ctx.mk returned childState => (returned, (childState, yesResult))
      })
      let withElse := emit(Key.key, Ctx.mk(r, afterYesToken, yesState), 18, List.nil(Nat))
      match withElse returning Pair(Ctx(r, m), S) with
      | Ctx.mk elseToken elseState => {
        let (afterNoToken, (noState, afterNo)) := BufferAccess.within(elseToken, Pair(State, S),
            fun (n: Type)(view: BufferAccess.View(m, n))(childToken: BufferAccess.Token(n))
                : Pair(BufferAccess.Token(n), Pair(State, S)) => {
          let (noCtx, noResult) := no(n, view, Ctx.mk(r, childToken, elseState), afterYes)
          match noCtx returning Pair(BufferAccess.Token(n), Pair(State, S)) with
          | Ctx.mk returned childState => (returned, (childState, noResult))
        })
        (emit(Key.key, Ctx.mk(r, afterNoToken, noState), 19, List.nil(Nat)), afterNo)
      }
    }
  }

  def repeat32 {r: Type}{m: Type}{k: Kind}{S: Type { kind = k }}
      (ctx: Ctx(r, m))(count: Val32(r, m))(fixed: Fixed(S))(state: S)
      (body: (n: Type) -> BufferAccess.View(m, n) -> Val32(r, n) -> Ctx(r, n) -> S -> Pair(Ctx(r, n), S))
      : Pair(Ctx(r, m), S) := {
    let (withIndex, indexSlot) := fresh32(Key.key, ctx)
    let begin := emit(Key.key, withIndex, 20, List.cons(count.id, List.cons(indexSlot.id, List.nil(Nat))))
    match begin returning Pair(Ctx(r, m), S) with
    | Ctx.mk parentToken beginState => {
      let (returned, (finalState, nextState)) := BufferAccess.within(parentToken, Pair(State, S),
          fun (n: Type)(view: BufferAccess.View(m, n))(childToken: BufferAccess.Token(n))
              : Pair(BufferAccess.Token(n), Pair(State, S)) => {
        let index := Val32.mk(r, n, indexSlot.id)
        let (bodyCtx, bodyResult) := body(n, view, index, Ctx.mk(r, childToken, beginState), state)
        let ended := emit(Key.key, bodyCtx, 22, List.nil(Nat))
        match ended returning Pair(BufferAccess.Token(n), Pair(State, S)) with
        | Ctx.mk closed childState => (closed, (childState, bodyResult))
      })
      (Ctx.mk(r, returned, finalState), nextState)
    }
  }

  def repeat64 {r: Type}{m: Type}{k: Kind}{S: Type { kind = k }}
      (ctx: Ctx(r, m))(count: Val64(r, m))(fixed: Fixed(S))(state: S)
      (body: (n: Type) -> BufferAccess.View(m, n) -> Val64(r, n) -> Ctx(r, n) -> S -> Pair(Ctx(r, n), S))
      : Pair(Ctx(r, m), S) := {
    let (withIndex, indexSlot) := fresh64(Key.key, ctx)
    let begin := emit(Key.key, withIndex, 21, List.cons(count.id, List.cons(indexSlot.id, List.nil(Nat))))
    match begin returning Pair(Ctx(r, m), S) with
    | Ctx.mk parentToken beginState => {
      let (returned, (finalState, nextState)) := BufferAccess.within(parentToken, Pair(State, S),
          fun (n: Type)(view: BufferAccess.View(m, n))(childToken: BufferAccess.Token(n))
              : Pair(BufferAccess.Token(n), Pair(State, S)) => {
        let index := Val64.mk(r, n, indexSlot.id)
        let (bodyCtx, bodyResult) := body(n, view, index, Ctx.mk(r, childToken, beginState), state)
        let ended := emit(Key.key, bodyCtx, 22, List.nil(Nat))
        match ended returning Pair(BufferAccess.Token(n), Pair(State, S)) with
        | Ctx.mk closed childState => (closed, (childState, bodyResult))
      })
      (Ctx.mk(r, returned, finalState), nextState)
    }
  }

  // Outputs are returned in allocation order. Failure codes: 1 malformed, 3 bounds, 4 arithmetic, 5 resource,
  // 6 invalid input/shape. Inputs must match their Input allocations in the same order.
  def run(program: Program)(inputs: List(List(Nat))): Result := {
    match Buffer.Native.executeEncoded(program.words, inputs) returning Result with
    | Pair.mk status outputs => {
      match Nat.beq(status, 0) returning Result with
      | Bool.true => Result.success(outputs)
      | Bool.false => Result.failure(status)
    }
  }
}
