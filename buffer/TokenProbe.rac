import buffer.Program
import buffer.Access

def incrementProgram: Buffer.Program := {
  let (program, _) := Buffer.build(Nat, fun (r: Type)(ctx: Buffer.Ctx(r, r)): Pair(Buffer.Ctx(r, r), Nat) => {
    let (afterInput, _) := Buffer.withInput(ctx, 1, Nat,
        fun (inputBrand: Type)(input: Buffer.InputHandle(r, inputBrand))(inputCtx: Buffer.Ctx(r, r))
            : Pair(Buffer.Ctx(r, r), Nat) => {
      let (afterOutput, _) := Buffer.withOutput(inputCtx, 1, Nat,
          fun (outputBrand: Type)(output: Buffer.OutputHandle(r, outputBrand))(owner: Buffer.OutputOwn(r, outputBrand))
              (outputCtx: Buffer.Ctx(r, r)): Pair(Buffer.Ctx(r, r), Nat) => {
        let (withOffset, _) := Buffer.const64(outputCtx, 0)
        let (withOne, one) := Buffer.const32(withOffset, 1)
        let (loopCtx, finalOwner) := Buffer.repeat32(withOne, one, Buffer.fixedOutput(output), owner,
            fun (frame: Type)(view: BufferAccess.View(r, frame))(index: Buffer.Val32(r, frame))
                (bodyCtx: Buffer.Ctx(r, frame))(bodyOwner: Buffer.OutputOwn(r, outputBrand))
                : Pair(Buffer.Ctx(r, frame), Buffer.OutputOwn(r, outputBrand)) => {
              let bodyOne := Buffer.lift32(view, one)
              let (at, offset) := Buffer.extend32To64(bodyCtx, index)
              let (loaded, byte) := Buffer.load8Input(at, input, offset)
              let (added, incremented) := Buffer.add32(loaded, byte, bodyOne)
              Buffer.store8Output(added, output, bodyOwner, offset, incremented)
            })
        let finished := Buffer.exportOutput(loopCtx, output, finalOwner)
        (finished, Nat.zero)
      })
      (afterOutput, Nat.zero)
    })
    (afterInput, Nat.zero)
  })
  program
}

def runIncrement(program: Buffer.Program)(value: Nat): Buffer.Result :=
  Buffer.run(program, List.cons(List.cons(value, List.nil(Nat)), List.nil(List(Nat))))

def incrementByteRuns : Pair(Buffer.Result, Pair(Buffer.Result, Buffer.Result)) := {
  let program := incrementProgram
  let first := runIncrement(program, 41)
  let second := runIncrement(program, 9)
  Pair.mk(first, Pair.mk(second, runIncrement(program, 41)))
}

{ incrementByteRuns }
