import Contracts
import Cuda

namespace BufferModel {
  inductive Phase: Type
   | ready: Phase
   | borrowing: Phase
   | reading: Phase
   | writable: Phase

  // Payload is deliberately not fixed: two branch arms and different loop
  // iteration counts can produce different accumulators at the same phase.
  struct State: Type
   | mk (phase: Phase)(payload: Nat)(value: Nat): State

  inductive Op: Type
   | beginRead: Op
   | read: Op
   | close: Op
   | write (value: Nat): Op

  inductive Code: Type
   | skip: Code
   | atom (id: Nat)(actor: Nat)(op: Op): Code
   | seq (first: Code)(second: Code): Code
   | branch (yes: Code)(no: Code): Code
   | ifFirst (yes: Code)(no: Code): Code
   | loop (body: Code): Code

  def at (phase: Phase): State -> Prop := fun (s: State): Prop => Eq(Phase, s.phase, phase)

  def step (op: Op)(runtime: Contracts.Runtime)(state: State): Contracts.Outcome(State) := {
    match op returning Contracts.Outcome(State) with
    | Op.beginRead => {
      match state.phase returning Contracts.Outcome(State) with
      | Phase.ready => Contracts.Outcome.ok(State.mk(Phase.borrowing, state.payload, state.value))
      | _ => Contracts.Outcome.fault(State)
    }
    | Op.read => {
      match state.phase returning Contracts.Outcome(State) with
      | Phase.borrowing => Contracts.Outcome.ok(State.mk(Phase.borrowing, Nat.mod(Nat.add(state.payload, state.value), Cuda.u32Limit), state.value))
      | _ => Contracts.Outcome.fault(State)
    }
    | Op.close => {
      match state.phase returning Contracts.Outcome(State) with
      | Phase.borrowing => Contracts.Outcome.ok(State.mk(Phase.reading, state.payload, state.value))
      | _ => Contracts.Outcome.fault(State)
    }
    | Op.write value => {
      match state.phase returning Contracts.Outcome(State) with
      | Phase.writable => Contracts.Outcome.ok(State.mk(Phase.ready, state.payload, value))
      | _ => Contracts.Outcome.fault(State)
    }
  }

  def operation (op: Op): Contracts.Runtime -> State -> Contracts.Outcome(State) :=
    fun (r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => BufferModel.step(op, r, s)

  def source (op: Op): Phase := {
    match op returning Phase with
    | Op.beginRead => Phase.ready
    | Op.read => Phase.borrowing
    | Op.close => Phase.borrowing
    | Op.write value => Phase.writable
  }
  def target (op: Op): Phase := {
    match op returning Phase with
    | Op.beginRead => Phase.borrowing
    | Op.read => Phase.borrowing
    | Op.close => Phase.reading
    | Op.write value => Phase.ready
  }

  def operationSafe (op: Op): Contracts.Safe(BufferModel.operation(op), BufferModel.at(BufferModel.source(op)), BufferModel.at(BufferModel.target(op))) :=
    fun (runtime: Contracts.Runtime)(state: State)(initial: Eq(Phase, state.phase, BufferModel.source(op)))
        : Contracts.Post(BufferModel.at(BufferModel.target(op)), BufferModel.step(op, runtime, state)) => {
      match state returning Contracts.Post(BufferModel.at(BufferModel.target(op)), BufferModel.step(op, runtime, state)) with
      | State.mk phase payload value => {
        match op returning Contracts.Post(BufferModel.at(BufferModel.target(op)), BufferModel.step(op, runtime, state)) with
        | Op.beginRead => {
          match initial returning Contracts.Post(BufferModel.at(Phase.borrowing), BufferModel.step(op, runtime, state)) with
          | Eq.refl same => Eq.refl(Phase.borrowing)
        }
        | Op.read => {
          match initial returning Contracts.Post(BufferModel.at(Phase.borrowing), BufferModel.step(op, runtime, state)) with
          | Eq.refl same => Eq.refl(Phase.borrowing)
        }
        | Op.close => {
          match initial returning Contracts.Post(BufferModel.at(Phase.reading), BufferModel.step(op, runtime, state)) with
          | Eq.refl same => Eq.refl(Phase.reading)
        }
        | Op.write next => {
          match initial returning Contracts.Post(BufferModel.at(Phase.ready), BufferModel.step(op, runtime, state)) with
          | Eq.refl same => Eq.refl(Phase.ready)
        }
      }
    }

  // This relation ties the program tree to its semantics. Supplying an
  // arbitrary, conveniently safe function cannot certify different code.
  inductive Meaning (id: Nat)(actor: Nat) indices (code: Code)(run: Contracts.Runtime -> State -> Contracts.Outcome(State)): Prop
   | skip: Meaning(id, actor, Code.skip, Contracts.identityRun(State))
   | atom (op: Op): Meaning(id, actor, Code.atom(id, actor, op), BufferModel.operation(op))
   | seq (a: Code)(b: Code)(f: Contracts.Runtime -> State -> Contracts.Outcome(State))(g: Contracts.Runtime -> State -> Contracts.Outcome(State))
       (left: Meaning(id, actor, a, f))(right: Meaning(id, actor, b, g))
       : Meaning(id, actor, Code.seq(a, b), Contracts.composed(f, g))
   | branch (a: Code)(b: Code)(f: Contracts.Runtime -> State -> Contracts.Outcome(State))(g: Contracts.Runtime -> State -> Contracts.Outcome(State))
       (yes: Meaning(id, actor, a, f))(no: Meaning(id, actor, b, g))
       : Meaning(id, actor, Code.branch(a, b), Contracts.conditional(f, g))
   | ifFirst (a: Code)(b: Code)(f: Contracts.Runtime -> State -> Contracts.Outcome(State))(g: Contracts.Runtime -> State -> Contracts.Outcome(State))
       (yes: Meaning(id, actor, a, f))(no: Meaning(id, actor, b, g))
       : Meaning(id, actor, Code.ifFirst(a, b), Contracts.atFirst(f, g))
   | loop (body: Code)(f: Contracts.Runtime -> State -> Contracts.Outcome(State))(valid: Meaning(id, actor, body, f))
       : Meaning(id, actor, Code.loop(body), Contracts.repeated(f))
}
