// expect: TypeMismatch
import Emission
import Gpu
import Client
namespace Rejected {
  def removeLast (block: Cuda.Block): Cuda.Block decreases structural(block) := {
    match block returning Cuda.Block with
    | Cuda.Block.done => Cuda.Block.done
    | Cuda.Block.seq stmt rest => {
      match rest returning Cuda.Block with
      | Cuda.Block.done => Cuda.Block.done
      | Cuda.Block.seq next tail => Cuda.Block.seq(stmt, Rejected.removeLast(rest))
    }
  }
  // Both opaque roles are legal; delete only the final restoration barrier.
  def bad (l: Lifetime)
      (a: Gpu.Local(l, 0, 0, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading)))
      (b: Gpu.Local(l, 1, 1, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading)))
      : Emission.Whole(WholeModel.Code.split(Client.counts, Gpu.localCode(a), Gpu.localCode(b)), Option.none(Nat), 4,
          Rejected.removeLast(Emission.whole(WholeModel.Code.split(Client.counts, Gpu.localCode(a), Gpu.localCode(b)), Option.none(Nat), 4).block),
          Emission.whole(WholeModel.Code.split(Client.counts, Gpu.localCode(a), Gpu.localCode(b)), Option.none(Nat), 4).next) :=
    Emission.whole(WholeModel.Code.split(Client.counts, Gpu.localCode(a), Gpu.localCode(b)), Option.none(Nat), 4).valid
}
