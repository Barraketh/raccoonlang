// expect: TypeMismatch
import Contracts
import BufferModel
namespace Rejected {
  def body: Contracts.Runtime -> BufferModel.State -> Contracts.Outcome(BufferModel.State) :=
    Contracts.atFirst(BufferModel.operation(BufferModel.Op.read), BufferModel.operation(BufferModel.Op.close))
  def initial: BufferModel.State := BufferModel.State.mk(BufferModel.Phase.borrowing, 0, 1)
  def first: Contracts.Post(BufferModel.at(BufferModel.Phase.borrowing), Rejected.body(Contracts.Runtime.mk(3, Bool.true, 0), Rejected.initial)) := Eq.refl(BufferModel.Phase.borrowing)
  // The first iteration is valid, but the claimed loop invariant fails later.
  def bad: Contracts.Post(BufferModel.at(BufferModel.Phase.borrowing), Contracts.repeat(Rejected.body, Contracts.Runtime.mk(3, Bool.true, 0), Rejected.initial)) := Eq.refl(BufferModel.Phase.borrowing)
}
