import Contracts
import BufferModel
import WholeModel
import Footprints

// Source-level library interface. All command introductions contain both
// code/semantics correspondence and a universally quantified safety proof.
namespace Gpu {
  sealed struct Buffer (l: Lifetime)(id: Nat)(actor: Nat): Type { scope = l }
   | mk: Buffer(l, id, actor)
  sealed struct Lease (root: Lifetime)(loan: Lifetime)(id: Nat)(actor: Nat): Type { scope = Lifetime.union(root, loan) }
   | mk: Lease(root, loan, id, actor)

  sealed struct Local (l: Lifetime)(id: Nat)(actor: Nat)(P: BufferModel.State -> Prop)(Q: BufferModel.State -> Prop): Type { scope = l }
   | mk (code: BufferModel.Code)(run: Contracts.Runtime -> BufferModel.State -> Contracts.Outcome(BufferModel.State))
        (meaning: BufferModel.Meaning(id, actor, code, run))(safe: Contracts.Safe(run, P, Q)): Local(l, id, actor, P, Q)

  sealed struct Whole (l: Lifetime)(P: WholeModel.State -> Prop)(Q: WholeModel.State -> Prop): Type { scope = l }
   | mk (code: WholeModel.Code)(run: Contracts.Runtime -> WholeModel.State -> Contracts.Outcome(WholeModel.State))
        (meaning: WholeModel.Meaning(code, run))(safe: Contracts.Safe(run, P, Q)): Whole(l, P, Q)

  def read {root: Lifetime}{loan: Lifetime}{id: Nat}{actor: Nat}(buffer: Buffer(root, id, actor))(lease: Lease(root, loan, id, actor))
      : Local(Lifetime.union(root, loan), id, actor, BufferModel.at(BufferModel.Phase.borrowing), BufferModel.at(BufferModel.Phase.borrowing)) :=
    Local.mk(Lifetime.union(root, loan), BufferModel.at(BufferModel.Phase.borrowing), BufferModel.at(BufferModel.Phase.borrowing), BufferModel.Code.atom(id, actor, BufferModel.Op.read), BufferModel.operation(BufferModel.Op.read),
      BufferModel.Meaning.atom(id, actor, BufferModel.Op.read), BufferModel.operationSafe(BufferModel.Op.read))

  def sequence {l: Lifetime}{id: Nat}{actor: Nat}{P: BufferModel.State -> Prop}{M: BufferModel.State -> Prop}{Q: BufferModel.State -> Prop}
      (first: Local(l, id, actor, P, M))(second: Local(l, id, actor, M, Q)): Local(l, id, actor, P, Q) :=
    Local.mk(l, P, Q, BufferModel.Code.seq(first.code, second.code), Contracts.composed(first.run, second.run),
      BufferModel.Meaning.seq(first.code, second.code, first.run, second.run, first.meaning, second.meaning),
      Contracts.sequenceSafe(first.run, second.run, P, M, Q, first.safe, second.safe))

  def branch {l: Lifetime}{id: Nat}{actor: Nat}{P: BufferModel.State -> Prop}{Q: BufferModel.State -> Prop}
      (yes: Local(l, id, actor, P, Q))(no: Local(l, id, actor, P, Q)): Local(l, id, actor, P, Q) :=
    Local.mk(l, P, Q, BufferModel.Code.branch(yes.code, no.code), Contracts.conditional(yes.run, no.run),
      BufferModel.Meaning.branch(yes.code, no.code, yes.run, no.run, yes.meaning, no.meaning),
      Contracts.branchSafe(yes.run, no.run, P, Q, yes.safe, no.safe))

  def ifFirst {l: Lifetime}{id: Nat}{actor: Nat}{P: BufferModel.State -> Prop}{Q: BufferModel.State -> Prop}
      (yes: Local(l, id, actor, P, Q))(no: Local(l, id, actor, P, Q)): Local(l, id, actor, P, Q) :=
    Local.mk(l, P, Q, BufferModel.Code.ifFirst(yes.code, no.code), Contracts.atFirst(yes.run, no.run),
      BufferModel.Meaning.ifFirst(yes.code, no.code, yes.run, no.run, yes.meaning, no.meaning),
      Contracts.firstSafe(yes.run, no.run, P, Q, yes.safe, no.safe))

  def loop {l: Lifetime}{id: Nat}{actor: Nat}{I: BufferModel.State -> Prop}(body: Local(l, id, actor, I, I)): Local(l, id, actor, I, I) :=
    Local.mk(l, I, I, BufferModel.Code.loop(body.code), Contracts.repeated(body.run), BufferModel.Meaning.loop(body.code, body.run, body.meaning),
      Contracts.repeatSafe(body.run, I, body.safe))

  def borrow {root: Lifetime}{id: Nat}{actor: Nat}(buffer: Buffer(root, id, actor))
      (body: { scope = root } (loan: Lifetime) -> Lease(root, loan, id, actor)
        -> Local(Lifetime.union(root, loan), id, actor, BufferModel.at(BufferModel.Phase.borrowing), BufferModel.at(BufferModel.Phase.borrowing)))
      : Local(root, id, actor, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading)) := scope loan => {
    let inner := body(loan, Lease.mk(root, loan, id, actor))
    let enter := Local.mk(Lifetime.union(root, loan), BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.borrowing), BufferModel.Code.atom(id, actor, BufferModel.Op.beginRead), BufferModel.operation(BufferModel.Op.beginRead),
      BufferModel.Meaning.atom(id, actor, BufferModel.Op.beginRead), BufferModel.operationSafe(BufferModel.Op.beginRead))
    let exit := Local.mk(Lifetime.union(root, loan), BufferModel.at(BufferModel.Phase.borrowing), BufferModel.at(BufferModel.Phase.reading), BufferModel.Code.atom(id, actor, BufferModel.Op.close), BufferModel.operation(BufferModel.Op.close),
      BufferModel.Meaning.atom(id, actor, BufferModel.Op.close), BufferModel.operationSafe(BufferModel.Op.close))
    let full := Gpu.sequence(Gpu.sequence(enter, inner), exit)
    // The only dependency elimination: the retained program contains both the
    // loan's opening and closing, and its proof has ready/reading endpoints.
    Local.mk(root, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading), full.code, full.run, full.meaning, full.safe)
  }

  def split {l: Lifetime}(counts: WholeModel.Counts)
      (left: Local(l, 0, 0, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading)))
      (right: Local(l, 1, 1, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading)))
      [fits: Eq(Bool, WholeModel.fits(counts), Bool.true)]
      : Whole(l, WholeModel.at(BufferModel.Phase.ready), WholeModel.at(BufferModel.Phase.writable)) :=
    Whole.mk(l, WholeModel.at(BufferModel.Phase.ready), WholeModel.at(BufferModel.Phase.writable), WholeModel.Code.split(counts, left.code, right.code), WholeModel.splitRun(left.run, right.run),
      WholeModel.Meaning.split(counts, left.code, right.code, left.run, right.run, fits, left.meaning, right.meaning, left.safe, right.safe),
      WholeModel.splitSafe(left.run, right.run, left.safe, right.safe))

  def writeBoth (l: Lifetime)(value: Nat): Whole(l, WholeModel.at(BufferModel.Phase.writable), WholeModel.at(BufferModel.Phase.ready)) :=
    Whole.mk(l, WholeModel.at(BufferModel.Phase.writable), WholeModel.at(BufferModel.Phase.ready), WholeModel.Code.writeBoth(value), WholeModel.writeRun(value), WholeModel.Meaning.writeBoth(value), WholeModel.writeSafe(value))

  def thenWhole {l: Lifetime}{P: WholeModel.State -> Prop}{M: WholeModel.State -> Prop}{Q: WholeModel.State -> Prop}
      (first: Whole(l, P, M))(second: Whole(l, M, Q)): Whole(l, P, Q) :=
    Whole.mk(l, P, Q, WholeModel.Code.seq(first.code, second.code), Contracts.composed(first.run, second.run),
      WholeModel.Meaning.seq(first.code, second.code, first.run, second.run, first.meaning, second.meaning),
      Contracts.sequenceSafe(first.run, second.run, P, M, Q, first.safe, second.safe))

  def loopWhole {l: Lifetime}{I: WholeModel.State -> Prop}(body: Whole(l, I, I)): Whole(l, I, I) :=
    Whole.mk(l, I, I, WholeModel.Code.loop(body.code), Contracts.repeated(body.run), WholeModel.Meaning.loop(body.code, body.run, body.meaning),
      Contracts.repeatSafe(body.run, I, body.safe))

  def localCode {l: Lifetime}{id: Nat}{actor: Nat}{P: BufferModel.State -> Prop}{Q: BufferModel.State -> Prop}(command: Local(l, id, actor, P, Q)): BufferModel.Code := command.code
  def localRun {l: Lifetime}{id: Nat}{actor: Nat}{P: BufferModel.State -> Prop}{Q: BufferModel.State -> Prop}
      (command: Local(l, id, actor, P, Q)): Contracts.Runtime -> BufferModel.State -> Contracts.Outcome(BufferModel.State) := command.run
  def localMeaning {l: Lifetime}{id: Nat}{actor: Nat}{P: BufferModel.State -> Prop}{Q: BufferModel.State -> Prop}
      (command: Local(l, id, actor, P, Q)): BufferModel.Meaning(id, actor, Gpu.localCode(command), Gpu.localRun(command)) := command.meaning
  def localFootprint {l: Lifetime}{id: Nat}{actor: Nat}{P: BufferModel.State -> Prop}{Q: BufferModel.State -> Prop}
      (command: Local(l, id, actor, P, Q)): Footprints.Owns(id, actor, Gpu.localCode(command)) := Footprints.fromMeaning(id, actor, command.code, command.run, command.meaning)

  def localSafe {l: Lifetime}{id: Nat}{actor: Nat}{P: BufferModel.State -> Prop}{Q: BufferModel.State -> Prop}
      (command: Local(l, id, actor, P, Q)): Contracts.Safe(Gpu.localRun(command), P, Q) := command.safe

  struct Program: Type
   | mk (code: WholeModel.Code)(run: Contracts.Runtime -> WholeModel.State -> Contracts.Outcome(WholeModel.State))
        (meaning: WholeModel.Meaning(code, run))
        (safe: Contracts.Safe(run, WholeModel.at(BufferModel.Phase.ready), WholeModel.at(BufferModel.Phase.ready))): Program

  def kernel (body: (l: Lifetime) -> Buffer(l, 0, 0) -> Buffer(l, 1, 1)
      -> Whole(l, WholeModel.at(BufferModel.Phase.ready), WholeModel.at(BufferModel.Phase.ready))): Program := scope l => {
    let result := body(l, Buffer.mk(l, 0, 0), Buffer.mk(l, 1, 1))
    Program.mk(result.code, result.run, result.meaning, result.safe)
  }
}
