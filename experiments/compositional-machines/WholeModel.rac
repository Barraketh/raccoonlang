import Contracts
import BufferModel
import Separation
import encoding.Registers

namespace WholeModel {
  struct Counts: Type
   | mk (a: Nat)(b: Nat)(c: Nat)(d: Nat): Counts
  def fits (cs: Counts): Bool := Registers.fits(Registers.budget(512, 1), cs.a, cs.b, cs.c, cs.d)

  struct State: Type
   | mk (uniform: Bool)(left: BufferModel.State)(right: BufferModel.State): State

  def at (phase: BufferModel.Phase): State -> Prop := fun (state: State): Prop =>
    And(Eq(Bool, state.uniform, Bool.true),
      And(Eq(BufferModel.Phase, state.left.phase, phase), Eq(BufferModel.Phase, state.right.phase, phase)))

  inductive Code: Type
   | skip: Code
   | split (counts: Counts)(left: BufferModel.Code)(right: BufferModel.Code): Code
   | writeBoth (value: Nat): Code
   | seq (first: Code)(second: Code): Code
   | branch (yes: Code)(no: Code): Code
   | loop (body: Code): Code

  def joined (outcome: Contracts.Outcome(Pair(BufferModel.State, BufferModel.State))): Contracts.Outcome(State) := {
    match outcome returning Contracts.Outcome(State) with
    | Contracts.Outcome.fault => Contracts.Outcome.fault(State)
    | Contracts.Outcome.ok pair => {
      match pair returning Contracts.Outcome(State) with
      | Pair.mk a b => Contracts.Outcome.ok(State.mk(Bool.true,
          BufferModel.State.mk(BufferModel.Phase.writable, a.payload, a.value),
          BufferModel.State.mk(BufferModel.Phase.writable, b.payload, b.value)))
    }
  }

  def splitRun (left: Contracts.Runtime -> BufferModel.State -> Contracts.Outcome(BufferModel.State))
      (right: Contracts.Runtime -> BufferModel.State -> Contracts.Outcome(BufferModel.State))
      : Contracts.Runtime -> State -> Contracts.Outcome(State) :=
    fun (runtime: Contracts.Runtime)(state: State): Contracts.Outcome(State) => {
      match state.uniform returning Contracts.Outcome(State) with
      | Bool.false => Contracts.Outcome.fault(State)
      | Bool.true => WholeModel.joined(Separation.merge(left(runtime, state.left), right(runtime, state.right)))
    }

  def joinedSafe (outcome: Contracts.Outcome(Pair(BufferModel.State, BufferModel.State)))
      (initial: Contracts.Post(Separation.both(BufferModel.at(BufferModel.Phase.reading), BufferModel.at(BufferModel.Phase.reading)), outcome))
      : Contracts.Post(WholeModel.at(BufferModel.Phase.writable), WholeModel.joined(outcome)) := {
    match outcome returning Contracts.Post(WholeModel.at(BufferModel.Phase.writable), WholeModel.joined(outcome)) with
    | Contracts.Outcome.fault => initial
    | Contracts.Outcome.ok pair => {
      match pair returning Contracts.Post(WholeModel.at(BufferModel.Phase.writable), WholeModel.joined(outcome)) with
      | Pair.mk a b => And.intro(Eq.refl(Bool.true), And.intro(Eq.refl(BufferModel.Phase.writable), Eq.refl(BufferModel.Phase.writable)))
    }
  }

  def splitSafe (left: Contracts.Runtime -> BufferModel.State -> Contracts.Outcome(BufferModel.State))
      (right: Contracts.Runtime -> BufferModel.State -> Contracts.Outcome(BufferModel.State))
      (a: Contracts.Safe(left, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading)))
      (b: Contracts.Safe(right, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading)))
      : Contracts.Safe(WholeModel.splitRun(left, right), WholeModel.at(BufferModel.Phase.ready), WholeModel.at(BufferModel.Phase.writable)) :=
    fun (runtime: Contracts.Runtime)(state: State)(initial: WholeModel.at(BufferModel.Phase.ready)(state))
        : Contracts.Post(WholeModel.at(BufferModel.Phase.writable), WholeModel.splitRun(left, right)(runtime, state)) => {
      match state returning Contracts.Post(WholeModel.at(BufferModel.Phase.writable), WholeModel.splitRun(left, right)(runtime, state)) with
      | State.mk uniform l r => {
        match initial.left returning Contracts.Post(WholeModel.at(BufferModel.Phase.writable), WholeModel.splitRun(left, right)(runtime, state)) with
        | Eq.refl same => WholeModel.joinedSafe(Separation.merge(left(runtime, l), right(runtime, r)),
            Separation.mergeSafe(left(runtime, l), right(runtime, r), BufferModel.at(BufferModel.Phase.reading), BufferModel.at(BufferModel.Phase.reading),
              a(runtime, l, initial.right.left), b(runtime, r, initial.right.right)))
      }
    }

  def written (uniform: Bool)(outcome: Contracts.Outcome(Pair(BufferModel.State, BufferModel.State))): Contracts.Outcome(State) := {
    match outcome returning Contracts.Outcome(State) with
    | Contracts.Outcome.fault => Contracts.Outcome.fault(State)
    | Contracts.Outcome.ok pair => {
      match pair returning Contracts.Outcome(State) with
      | Pair.mk a b => Contracts.Outcome.ok(State.mk(uniform, a, b))
    }
  }

  def writeRun (value: Nat): Contracts.Runtime -> State -> Contracts.Outcome(State) :=
    fun (runtime: Contracts.Runtime)(state: State): Contracts.Outcome(State) => WholeModel.written(state.uniform,
      Separation.merge(BufferModel.step(BufferModel.Op.write(value), runtime, state.left), BufferModel.step(BufferModel.Op.write(value), runtime, state.right)))

  def writtenSafe (outcome: Contracts.Outcome(Pair(BufferModel.State, BufferModel.State)))
      (initial: Contracts.Post(Separation.both(BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.ready)), outcome))
      : Contracts.Post(WholeModel.at(BufferModel.Phase.ready), WholeModel.written(Bool.true, outcome)) := {
    match outcome returning Contracts.Post(WholeModel.at(BufferModel.Phase.ready), WholeModel.written(Bool.true, outcome)) with
    | Contracts.Outcome.fault => initial
    | Contracts.Outcome.ok pair => {
      match pair returning Contracts.Post(WholeModel.at(BufferModel.Phase.ready), WholeModel.written(Bool.true, outcome)) with
      | Pair.mk a b => And.intro(Eq.refl(Bool.true), initial)
    }
  }

  def writeSafe (value: Nat): Contracts.Safe(WholeModel.writeRun(value), WholeModel.at(BufferModel.Phase.writable), WholeModel.at(BufferModel.Phase.ready)) :=
    fun (runtime: Contracts.Runtime)(state: State)(initial: WholeModel.at(BufferModel.Phase.writable)(state))
        : Contracts.Post(WholeModel.at(BufferModel.Phase.ready), WholeModel.writeRun(value)(runtime, state)) => {
      match state returning Contracts.Post(WholeModel.at(BufferModel.Phase.ready), WholeModel.writeRun(value)(runtime, state)) with
      | State.mk uniform a b => {
        match initial.left returning Contracts.Post(WholeModel.at(BufferModel.Phase.ready), WholeModel.writeRun(value)(runtime, state)) with
        | Eq.refl same => WholeModel.writtenSafe(Separation.merge(BufferModel.step(BufferModel.Op.write(value), runtime, a), BufferModel.step(BufferModel.Op.write(value), runtime, b)),
            Separation.mergeSafe(BufferModel.step(BufferModel.Op.write(value), runtime, a), BufferModel.step(BufferModel.Op.write(value), runtime, b),
              BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.ready),
              BufferModel.operationSafe(BufferModel.Op.write(value))(runtime, a, initial.right.left),
              BufferModel.operationSafe(BufferModel.Op.write(value))(runtime, b, initial.right.right)))
      }
    }

  inductive Meaning indices (code: Code)(run: Contracts.Runtime -> State -> Contracts.Outcome(State)): Prop
   | skip: Meaning(Code.skip, Contracts.identityRun(State))
   | split (counts: Counts)(a: BufferModel.Code)(b: BufferModel.Code)
       (f: Contracts.Runtime -> BufferModel.State -> Contracts.Outcome(BufferModel.State))
       (g: Contracts.Runtime -> BufferModel.State -> Contracts.Outcome(BufferModel.State))
       (fits: Eq(Bool, WholeModel.fits(counts), Bool.true))
       (left: BufferModel.Meaning(0, 0, a, f))(right: BufferModel.Meaning(1, 1, b, g))
       (leftSafe: Contracts.Safe(f, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading)))
       (rightSafe: Contracts.Safe(g, BufferModel.at(BufferModel.Phase.ready), BufferModel.at(BufferModel.Phase.reading)))
       : Meaning(Code.split(counts, a, b), WholeModel.splitRun(f, g))
   | writeBoth (value: Nat): Meaning(Code.writeBoth(value), WholeModel.writeRun(value))
   | seq (a: Code)(b: Code)(f: Contracts.Runtime -> State -> Contracts.Outcome(State))(g: Contracts.Runtime -> State -> Contracts.Outcome(State))
       (left: Meaning(a, f))(right: Meaning(b, g)): Meaning(Code.seq(a, b), Contracts.composed(f, g))
   | branch (a: Code)(b: Code)(f: Contracts.Runtime -> State -> Contracts.Outcome(State))(g: Contracts.Runtime -> State -> Contracts.Outcome(State))
       (yes: Meaning(a, f))(no: Meaning(b, g)): Meaning(Code.branch(a, b), Contracts.conditional(f, g))
   | loop (body: Code)(f: Contracts.Runtime -> State -> Contracts.Outcome(State))(valid: Meaning(body, f))
       : Meaning(Code.loop(body), Contracts.repeated(f))
}
