// Checked Hoare contracts for eagerly generated, structured programs.
// A runtime input is model data, not the generator's representative value.
namespace Contracts {
  struct Runtime: Type
   | mk (count: Nat)(flag: Bool)(index: Nat): Runtime

  inductive Outcome (S: Type): Type
   | ok (state: S): Outcome(S)
   | fault: Outcome(S)

  def Post {S: Type}(Q: S -> Prop)(outcome: Outcome(S)): Prop := {
    match outcome returning Prop with
    | Outcome.ok state => Q(state)
    | Outcome.fault => False
  }

  def identityRun (S: Type): Runtime -> S -> Outcome(S) :=
    fun (r: Runtime)(s: S): Outcome(S) => Outcome.ok(s)

  def continue {S: Type}(outcome: Outcome(S))(next: S -> Outcome(S)): Outcome(S) := {
    match outcome returning Outcome(S) with
    | Outcome.ok mid => next(mid)
    | Outcome.fault => Outcome.fault(S)
  }

  def sequence {S: Type}(first: Runtime -> S -> Outcome(S))(second: Runtime -> S -> Outcome(S))
      (runtime: Runtime)(state: S): Outcome(S) :=
    Contracts.continue(first(runtime, state), fun (mid: S): Outcome(S) => second(runtime, mid))

  def branch {S: Type}(yes: Runtime -> S -> Outcome(S))(no: Runtime -> S -> Outcome(S))
      (runtime: Runtime)(state: S): Outcome(S) := {
    match runtime.flag returning Outcome(S) with
    | Bool.true => yes(runtime, state)
    | Bool.false => no(runtime, state)
  }

  def select {S: Type}(flag: Bool)(yes: Outcome(S))(no: Outcome(S)): Outcome(S) := {
    match flag returning Outcome(S) with
    | Bool.true => yes
    | Bool.false => no
  }
  def selectSafe {S: Type}(flag: Bool)(Q: S -> Prop)(yes: Outcome(S))(no: Outcome(S))
      (a: Contracts.Post(Q, yes))(b: Contracts.Post(Q, no)): Contracts.Post(Q, Contracts.select(flag, yes, no)) := {
    match flag returning Contracts.Post(Q, Contracts.select(flag, yes, no)) with
    | Bool.true => a
    | Bool.false => b
  }
  def firstCase {S: Type}(yes: Runtime -> S -> Outcome(S))(no: Runtime -> S -> Outcome(S))
      (runtime: Runtime)(state: S): Outcome(S) := Contracts.select(Nat.isZero(runtime.index), yes(runtime, state), no(runtime, state))
  def atFirst {S: Type}(yes: Runtime -> S -> Outcome(S))(no: Runtime -> S -> Outcome(S)): Runtime -> S -> Outcome(S) :=
    fun (r: Runtime)(s: S): Outcome(S) => Contracts.firstCase(yes, no, r, s)

  def iterate {S: Type}(body: Runtime -> S -> Outcome(S))(runtime: Runtime)(count: Nat)(index: Nat)(state: S)
      : Outcome(S) decreases structural(count) := {
    match count returning Outcome(S) with
    | Nat.zero => Outcome.ok(state)
    | Nat.succ rest => Contracts.continue(body(Runtime.mk(runtime.count, runtime.flag, index), state),
        fun (mid: S): Outcome(S) => Contracts.iterate(body, runtime, rest, Nat.succ(index), mid))
  }

  def repeat {S: Type}(body: Runtime -> S -> Outcome(S))(runtime: Runtime)(state: S): Outcome(S) :=
    Contracts.iterate(body, runtime, runtime.count, 0, state)

  def composed {S: Type}(first: Runtime -> S -> Outcome(S))(second: Runtime -> S -> Outcome(S)): Runtime -> S -> Outcome(S) :=
    fun (r: Runtime)(s: S): Outcome(S) => Contracts.sequence(first, second, r, s)

  def conditional {S: Type}(yes: Runtime -> S -> Outcome(S))(no: Runtime -> S -> Outcome(S)): Runtime -> S -> Outcome(S) :=
    fun (r: Runtime)(s: S): Outcome(S) => Contracts.branch(yes, no, r, s)

  def repeated {S: Type}(body: Runtime -> S -> Outcome(S)): Runtime -> S -> Outcome(S) :=
    fun (r: Runtime)(s: S): Outcome(S) => Contracts.repeat(body, r, s)

  def Safe {S: Type}(run: Runtime -> S -> Outcome(S))(P: S -> Prop)(Q: S -> Prop): Prop :=
    (runtime: Runtime) -> (state: S) -> P(state) -> Contracts.Post(Q, run(runtime, state))

  def continueSafe {S: Type}(outcome: Outcome(S))(P: S -> Prop)(Q: S -> Prop)(next: S -> Outcome(S))
      (safe: (state: S) -> P(state) -> Contracts.Post(Q, next(state)))(initial: Contracts.Post(P, outcome))
      : Contracts.Post(Q, Contracts.continue(outcome, next)) := {
    match outcome returning Contracts.Post(Q, Contracts.continue(outcome, next)) with
    | Outcome.ok mid => safe(mid, initial)
    | Outcome.fault => initial
  }

  def sequenceSafe {S: Type}(first: Runtime -> S -> Outcome(S))(second: Runtime -> S -> Outcome(S))
      (P: S -> Prop)(M: S -> Prop)(Q: S -> Prop)(a: Contracts.Safe(first, P, M))(b: Contracts.Safe(second, M, Q))
      : Contracts.Safe(Contracts.composed(first, second), P, Q) :=
    fun (runtime: Runtime)(state: S)(initial: P(state)): Contracts.Post(Q, Contracts.sequence(first, second, runtime, state)) =>
      Contracts.continueSafe(first(runtime, state), M, Q,
        fun (mid: S): Outcome(S) => second(runtime, mid),
        fun (mid: S)(h: M(mid)): Contracts.Post(Q, second(runtime, mid)) => b(runtime, mid, h), a(runtime, state, initial))

  def branchSafe {S: Type}(yes: Runtime -> S -> Outcome(S))(no: Runtime -> S -> Outcome(S))
      (P: S -> Prop)(Q: S -> Prop)(a: Contracts.Safe(yes, P, Q))(b: Contracts.Safe(no, P, Q))
      : Contracts.Safe(Contracts.conditional(yes, no), P, Q) :=
    fun (runtime: Runtime)(state: S)(initial: P(state)): Contracts.Post(Q, Contracts.branch(yes, no, runtime, state)) => {
      match runtime.flag returning Contracts.Post(Q, Contracts.branch(yes, no, runtime, state)) with
      | Bool.true => a(runtime, state, initial)
      | Bool.false => b(runtime, state, initial)
    }

  def firstSafe {S: Type}(yes: Runtime -> S -> Outcome(S))(no: Runtime -> S -> Outcome(S))
      (P: S -> Prop)(Q: S -> Prop)(a: Contracts.Safe(yes, P, Q))(b: Contracts.Safe(no, P, Q))
      : Contracts.Safe(Contracts.atFirst(yes, no), P, Q) :=
    fun (runtime: Runtime)(state: S)(initial: P(state)): Contracts.Post(Q, Contracts.firstCase(yes, no, runtime, state)) =>
      Contracts.selectSafe(Nat.isZero(runtime.index), Q, yes(runtime, state), no(runtime, state), a(runtime, state, initial), b(runtime, state, initial))

  def iterateSafe {S: Type}(body: Runtime -> S -> Outcome(S))(I: S -> Prop)(safe: Contracts.Safe(body, I, I))
      (runtime: Runtime)(count: Nat)(index: Nat)(state: S)(initial: I(state))
      : Contracts.Post(I, Contracts.iterate(body, runtime, count, index, state)) decreases structural(count) := {
    match count returning Contracts.Post(I, Contracts.iterate(body, runtime, count, index, state)) with
    | Nat.zero => initial
    | Nat.succ rest => Contracts.continueSafe(body(Runtime.mk(runtime.count, runtime.flag, index), state), I, I,
        fun (mid: S): Outcome(S) => Contracts.iterate(body, runtime, rest, Nat.succ(index), mid),
        fun (mid: S)(h: I(mid)): Contracts.Post(I, Contracts.iterate(body, runtime, rest, Nat.succ(index), mid)) =>
          Contracts.iterateSafe(body, I, safe, runtime, rest, Nat.succ(index), mid, h),
        safe(Runtime.mk(runtime.count, runtime.flag, index), state, initial))
  }
  def repeatSafe {S: Type}(body: Runtime -> S -> Outcome(S))(I: S -> Prop)(safe: Contracts.Safe(body, I, I))
      : Contracts.Safe(Contracts.repeated(body), I, I) :=
    fun (runtime: Runtime)(state: S)(initial: I(state)): Contracts.Post(I, Contracts.repeat(body, runtime, state)) =>
      Contracts.iterateSafe(body, I, safe, runtime, runtime.count, 0, state, initial)

}
