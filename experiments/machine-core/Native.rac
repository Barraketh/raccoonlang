import Cuda

// A deliberately closed sm_100a backend for TinyGEMM. These templates are
// ported from Core; this file and its clients have no dependency on Core.
namespace Native {
  open Cuda

  struct World: Type
   | mk (stages: Nat)(buffers: Nat)(staging: Nat)(ring: Nat)(bars: Nat)(bytes: Nat): World
  def world (stages: Nat)(buffers: Nat): World := {
    let staging := 1024
    let ring := Nat.add(staging, Nat.mul(Nat.mul(4, buffers), 4096))
    let bars := Nat.add(ring, Nat.mul(stages, 32768))
    World.mk(stages, buffers, staging, ring, bars, Nat.add(bars, Nat.mul(16, stages)))
  }
  def block (ss: List(Stmt)): Block decreases structural(ss) := {
    match ss returning Block with
    | List.nil => Block.done
    | List.cons s rest => Block.seq(s, Native.block(rest))
  }
  def append (a: Block)(b: Block): Block decreases structural(a) := {
    match a returning Block with
    | Block.done => b
    | Block.seq s rest => Block.seq(s, Native.append(rest, b))
  }
  def counting (first: Nat)(count: Nat): List(Nat) decreases structural(count) := {
    match count returning List(Nat) with
    | Nat.zero => List.nil(Nat)
    | Nat.succ n => List.cons(first, Native.counting(Nat.succ(first), n))
  }
  def advance (stage: Nat)(phase: Nat)(count: Nat): List(Stmt) :=
    List.cons(Stmt.assign(stage, Expr.bin(BinOp.add, Expr.var(stage), Expr.lit(1))),
      List.cons(Stmt.ifElse(Expr.bin(BinOp.eq, Expr.var(stage), Expr.lit(count)),
        Block.seq(Stmt.assign(stage, Expr.lit(0)), Block.seq(Stmt.assign(phase, Expr.bin(BinOp.sub, Expr.lit(1), Expr.var(phase))), Block.done)), Block.done), List.nil(Stmt)))
  def bar (base: Nat)(stage: Nat): Expr := Expr.bin(BinOp.add, Expr.sharedAddr(base), Expr.bin(BinOp.mul, Expr.var(stage), Expr.lit(8)))
  def full (w: World)(stage: Nat): Expr := Native.bar(w.bars, stage)
  def empty (w: World)(stage: Nat): Expr := Native.bar(Nat.add(w.bars, Nat.mul(8, w.stages)), stage)
  def stage (w: World)(cursor: Nat): Expr := Expr.bin(BinOp.add, Expr.sharedAddr(w.ring), Expr.bin(BinOp.mul, Expr.var(cursor), Expr.lit(32768)))
  def wait (bar: Expr)(phase: Expr): Stmt := Stmt.instr(Instr.mbarWait(BarrierScope.cta, bar, phase))
  def commit (bar: Expr): Stmt := Stmt.instr(Instr.tcCommit(CtaGroup.one, bar, Option.none(Nat)))
  def before: Stmt := Stmt.instr(Instr.tcFence(ThreadSync.before))
  def after: Stmt := Stmt.instr(Instr.tcFence(ThreadSync.after))
  def row: Expr := Expr.bin(BinOp.mul, Expr.special(Builtin.blockY), Expr.lit(128))
  def col: Expr := Expr.bin(BinOp.mul, Expr.special(Builtin.blockX), Expr.lit(128))
  def steps: Expr := Expr.bin(BinOp.div, Expr.bin(BinOp.add, Expr.lit(63), Expr.param("K")), Expr.lit(64))
  def quadrant: Expr := Expr.bin(BinOp.rem, Expr.special(Builtin.warp), Expr.lit(4))
  def buffer (w: World): Expr := Expr.bin(BinOp.add, Expr.sharedAddr(w.staging),
    Expr.bin(BinOp.mul, Expr.bin(BinOp.add, Expr.bin(BinOp.mul, Native.quadrant, Expr.lit(w.buffers)), Expr.var(1)), Expr.lit(4096)))
  def laneZero (ss: List(Stmt)): List(Stmt) := List.cons(Stmt.ifElse(Expr.bin(BinOp.eq, Expr.special(Builtin.lane), Expr.lit(0)), Native.block(ss), Block.done), List.cons(Stmt.syncWarp, List.nil(Stmt)))
  def declOuts (first: Nat)(count: Nat): List(Stmt) decreases structural(count) := {
    match count returning List(Stmt) with
    | Nat.zero => List.nil(Stmt)
    | Nat.succ n => List.cons(Stmt.declOut(DType.f32, first), Native.declOuts(Nat.succ(first), n))
  }
  def mma (w: World)(overwrite: Bool)(k: Nat)(count: Nat): List(Stmt) decreases structural(count) := {
    match count returning List(Stmt) with
    | Nat.zero => List.nil(Stmt)
    | Nat.succ n => {
      let a := Native.stage(w, 4)
      let b := Expr.bin(BinOp.add, a, Expr.lit(16384))
      let add := Bool.cond(Bool.and(overwrite, Nat.isZero(k)), Nat, 0, 1)
      List.cons(Stmt.instr(Instr.mma(CtaGroup.one, Expr.var(0), MmaA.smem(SmemDesc.mk(a, 0, k)), SmemDesc.mk(b, 0, k), InstrDesc.mk(128, 128, Bool.false), Expr.lit(add))), Native.mma(w, overwrite, Nat.succ(k), n))
    }
  }
  def drain (w: World)(count: Nat): List(Stmt) decreases structural(count) := {
    match count returning List(Stmt) with
    | Nat.zero => List.nil(Stmt)
    | Nat.succ n => List.cons(Native.wait(Native.empty(w, 2), Expr.var(3)), List.append(Native.advance(2, 3, w.stages), Native.drain(w, n)))
  }

  inductive Op: Type
   | acquire: Op
   | fill (index: Expr): Op
   | await: Op
   | mmaFirst: Op
   | mmaNext: Op
   | release: Op
   | load (index: Expr): Op
   | acquireStage: Op
   | writeStage (values: Nat): Op
   | fenceStage: Op
   | store (index: Expr): Op

  struct Emission: Type
   | mk (body: Block)(next: Nat): Emission
  def emit (w: World)(op: Op)(start: Nat): Emission := {
    match op returning Emission with
    | Op.acquire => Emission.mk(Block.seq(Native.wait(Native.empty(w, 2), Expr.var(3)), Block.done), start)
    | Op.fill i => {
      let dst := Native.stage(w, 2)
      let bar := Native.full(w, 2)
      let k := Expr.bin(BinOp.mul, i, Expr.lit(64))
      let copies := List.cons(Stmt.instr(Instr.mbarArrive(Window.cta, bar, Arrival.expectTx(Expr.lit(32768)))),
        List.cons(Stmt.instr(Instr.tmaLoad(CtaGroup.one, dst, Expr.paramAddr("A_map"), k, Native.row, bar)),
        List.cons(Stmt.instr(Instr.tmaLoad(CtaGroup.one, Expr.bin(BinOp.add, dst, Expr.lit(16384)), Expr.paramAddr("B_map"), k, Native.col, bar)), List.nil(Stmt))))
      Emission.mk(Native.block(List.append(copies, Native.advance(2, 3, w.stages))), start)
    }
    | Op.await => Emission.mk(Block.seq(Native.wait(Native.full(w, 4), Expr.var(5)), Block.seq(Native.after, Block.done)), start)
    | Op.mmaFirst => Emission.mk(Native.block(Native.mma(w, Bool.true, 0, 4)), start)
    | Op.mmaNext => Emission.mk(Native.block(Native.mma(w, Bool.false, 0, 4)), start)
    | Op.release => Emission.mk(Block.seq(Native.commit(Native.empty(w, 4)), Native.block(Native.advance(4, 5, w.stages))), start)
    | Op.load i => {
      let addr := Expr.bin(BinOp.add, Expr.bin(BinOp.add, Expr.var(0), Expr.bin(BinOp.shl, Expr.bin(BinOp.mul, Native.quadrant, Expr.lit(32)), Expr.lit(16))), Expr.bin(BinOp.mul, i, Expr.lit(32)))
      let load := fun (n: Nat): Stmt => Stmt.instr(Instr.tmemLoad(TmemShape.s32x32b, Native.counting(Nat.add(start, Nat.mul(8, n)), 8), Expr.bin(BinOp.add, addr, Expr.lit(Nat.mul(8, n)))))
      let ss := List.append(Native.declOuts(start, 32), List.cons(Stmt.syncWarp, List.cons(Native.after,
        List.append(List.map(Native.counting(0, 4), Stmt, load), List.cons(Stmt.instr(Instr.tmemWait(TmemWait.load)), List.nil(Stmt))))))
      Emission.mk(Native.block(ss), Nat.add(start, 32))
    }
    | Op.acquireStage => Emission.mk(Native.block(Native.laneZero(List.cons(Stmt.instr(Instr.bulkWait(BulkWait.read, Nat.pred(w.buffers))), List.nil(Stmt)))), start)
    | Op.writeStage values => {
      let row := start
      let swizzle := Nat.succ(start)
      let place := List.cons(Stmt.decl(DType.u32, row, Expr.bin(BinOp.add, Native.buffer(w), Expr.bin(BinOp.mul, Expr.special(Builtin.lane), Expr.lit(128)))),
        List.cons(Stmt.decl(DType.u32, swizzle, Expr.bin(BinOp.band, Expr.special(Builtin.lane), Expr.lit(7))), List.nil(Stmt)))
      let write := fun (g: Nat): Stmt => Stmt.instr(Instr.stShared(Expr.bin(BinOp.add, Expr.var(row),
        Expr.bin(BinOp.shl, Expr.bin(BinOp.bxor, Expr.lit(g), Expr.var(swizzle)), Expr.lit(4))), List.map(Native.counting(Nat.add(values, Nat.mul(4, g)), 4), Expr, Expr.var)))
      Emission.mk(Native.block(List.append(place, List.map(Native.counting(0, 8), Stmt, write))), Nat.add(start, 2))
    }
    | Op.fenceStage => Emission.mk(Block.seq(Stmt.instr(Instr.fenceProxyAsync), Block.seq(Stmt.syncWarp, Block.done)), start)
    | Op.store i => {
      let place := List.cons(Stmt.decl(DType.u32, start, Native.buffer(w)), List.cons(Stmt.decl(DType.u32, Nat.succ(start),
        Expr.bin(BinOp.add, Native.row, Expr.bin(BinOp.mul, Native.quadrant, Expr.lit(32)))), List.nil(Stmt)))
      let col := Expr.bin(BinOp.add, Native.col, Expr.bin(BinOp.mul, i, Expr.lit(32)))
      let store := Native.laneZero(List.cons(Stmt.instr(Instr.tmaStore(Expr.paramAddr("C_map"), col, Expr.var(Nat.succ(start)), Expr.var(start))), List.cons(Stmt.instr(Instr.bulkCommit), List.nil(Stmt))))
      let advance := List.cons(Stmt.assign(1, Expr.bin(BinOp.add, Expr.var(1), Expr.lit(1))),
        List.cons(Stmt.ifElse(Expr.bin(BinOp.eq, Expr.var(1), Expr.lit(w.buffers)), Block.seq(Stmt.assign(1, Expr.lit(0)), Block.done), Block.done), List.nil(Stmt)))
      Emission.mk(Native.block(List.append(place, List.append(store, advance))), Nat.add(start, 2))
    }
  }

  def initBars (base: Nat)(index: Nat)(count: Nat): List(Stmt) decreases structural(count) := {
    match count returning List(Stmt) with
    | Nat.zero => List.nil(Stmt)
    | Nat.succ n => List.cons(Stmt.instr(Instr.mbarInit(Expr.sharedAddr(Nat.add(base, Nat.mul(8, index))), Expr.lit(1))), Native.initBars(base, Nat.succ(index), n))
  }
  def completeBars (base: Nat)(index: Nat)(count: Nat): List(Stmt) decreases structural(count) := {
    match count returning List(Stmt) with
    | Nat.zero => List.nil(Stmt)
    | Nat.succ n => List.cons(Stmt.instr(Instr.mbarArrive(Window.cta, Expr.sharedAddr(Nat.add(base, Nat.mul(8, index))), Arrival.count(Expr.lit(1)))), Native.completeBars(base, Nat.succ(index), n))
  }
  def invalBars (base: Nat)(index: Nat)(count: Nat): List(Stmt) decreases structural(count) := {
    match count returning List(Stmt) with
    | Nat.zero => List.nil(Stmt)
    | Nat.succ n => List.cons(Stmt.instr(Instr.mbarInval(Expr.sharedAddr(Nat.add(base, Nat.mul(8, index))))), Native.invalBars(base, Nat.succ(index), n))
  }
  def threadZero (ss: List(Stmt)): Stmt := Stmt.ifElse(Expr.bin(BinOp.eq, Expr.special(Builtin.threadX), Expr.lit(0)), Native.block(ss), Block.done)
  def init (ss: List(Stmt)): Block := Block.seq(Native.threadZero(List.append(ss, List.cons(Stmt.instr(Instr.fenceMbarInit), List.nil(Stmt)))), Block.seq(Stmt.sync, Block.done))
  def warpZero (ss: List(Stmt)): Stmt := Stmt.ifElse(Expr.bin(BinOp.eq, Expr.special(Builtin.warp), Expr.lit(0)), Native.block(ss), Block.done)
  def openResources (w: World): Block := {
    let alloc := Native.warpZero(List.cons(Stmt.instr(Instr.tmemAlloc(CtaGroup.one, Expr.sharedAddr(0), Expr.lit(128))), List.cons(Stmt.instr(Instr.tmemRelinquish(CtaGroup.one)), List.nil(Stmt))))
    let tmem := Block.seq(alloc, Block.seq(Native.before, Block.seq(Stmt.sync, Block.seq(Native.after,
      Block.seq(Stmt.decl(DType.u32, 0, Expr.index(Expr.sharedPtr(DType.u32, 0), Expr.lit(0))), Block.done)))))
    Native.append(tmem, Native.append(Native.init(Native.initBars(8, 0, 1)),
      Native.init(List.append(Native.initBars(w.bars, 0, Nat.mul(2, w.stages)), Native.completeBars(w.bars, w.stages, w.stages)))))
  }
  def close (w: World): Block := Block.seq(Native.threadZero(Native.invalBars(w.bars, 0, Nat.mul(2, w.stages))),
    Block.seq(Native.threadZero(Native.invalBars(8, 0, 1)), Block.seq(Native.before, Block.seq(Stmt.sync, Block.seq(Native.after,
      Block.seq(Native.warpZero(List.cons(Stmt.instr(Instr.tmemDealloc(CtaGroup.one, Expr.var(0), Expr.lit(128))), List.nil(Stmt))), Block.done))))))
  def elect (flag: Nat)(body: Block): Block := Block.seq(Stmt.declMut(DType.u32, flag, Expr.zero(DType.u32)),
    Block.seq(Stmt.instr(Instr.elect(flag)), Block.seq(Stmt.ifElse(Expr.bin(BinOp.lt, Expr.lit(0), Expr.var(flag)), body, Block.done), Block.seq(Stmt.syncWarp, Block.done))))
  def take (stage: Nat)(phase: Nat)(body: Block): Block := Block.seq(Stmt.declMut(DType.u32, stage, Expr.lit(0)), Block.seq(Stmt.declMut(DType.u32, phase, Expr.lit(0)), body))
  def roles (producer: Block)(issuer: Block)(store: Block): Block := {
    let idle := Block.done
    let issue := Block.seq(Stmt.ifElse(Expr.bin(BinOp.lt, Expr.special(Builtin.warp), Expr.lit(2)), issuer, idle),
      Block.seq(Stmt.instr(Instr.barSync(Expr.lit(1), Expr.lit(96))), Block.done))
    let first := Block.seq(Stmt.ifElse(Expr.bin(BinOp.lt, Expr.special(Builtin.warp), Expr.lit(1)), producer, issue),
      Block.seq(Stmt.instr(Instr.barSync(Expr.lit(2), Expr.lit(128))), Block.done))
    Block.seq(Stmt.ifElse(Expr.bin(BinOp.lt, Expr.special(Builtin.warp), Expr.lit(4)), first, store), Block.seq(Stmt.sync, Block.done))
  }
  def kernelParams: List(Param) := List.cons(Param.tensorMap(MapUse.load, "A_map"), List.cons(Param.tensorMap(MapUse.load, "B_map"), List.cons(Param.tensorMap(MapUse.store, "C_map"),
    List.cons(Param.scalar(DType.u32, "M"), List.cons(Param.scalar(DType.u32, "N"), List.cons(Param.scalar(DType.u32, "K"), List.nil(Param)))))))
  def launcher: Launcher := {
    let host := List.cons(Param.input(DType.bf16, "A"), List.cons(Param.input(DType.bf16, "B"), List.cons(Param.output(DType.f32, "C"),
      List.cons(Param.scalar(DType.u32, "M"), List.cons(Param.scalar(DType.u32, "N"), List.cons(Param.scalar(DType.u32, "K"), List.nil(Param)))))))
    let below := fun (x: Expr)(limit: Nat): Expr => Expr.bin(BinOp.lt, x, Expr.lit64(limit))
    let requires := List.cons(below(Expr.bin(BinOp.mul, Expr.cast(DType.u64, Expr.param("M")), Expr.param("N")), Cuda.u32Limit),
      List.cons(below(Expr.param("M"), 2147483648), List.cons(below(Expr.param("N"), 2147483648), List.cons(below(Expr.param("K"), 2147483648),
      List.cons(Expr.bin(BinOp.eq, Expr.bin(BinOp.rem, Expr.param("N"), Expr.lit(4)), Expr.lit(0)), List.nil(Expr))))))
    let maps := List.cons(MapEncoding.mk("A_map", MapUse.load, Param.input(DType.bf16, "A"), "M", "K", 64, 128),
      List.cons(MapEncoding.mk("B_map", MapUse.load, Param.input(DType.bf16, "B"), "N", "K", 64, 128),
      List.cons(MapEncoding.mk("C_map", MapUse.store, Param.output(DType.f32, "C"), "M", "N", 32, 32), List.nil(MapEncoding))))
    let ceil := fun (x: String): Expr => Expr.bin(BinOp.div, Expr.bin(BinOp.add, Expr.param(x), Expr.lit(127)), Expr.lit(128))
    Launcher.mk(host, requires, maps, Grid.blocks(ceil("N"), ceil("M")), 256)
  }
  def kernel (name: String)(w: World)(producer: Block)(issuer: Block)(store: Block): Kernel :=
    Kernel.mk(name, Native.kernelParams, w.bytes, Native.append(Native.openResources(w), Native.append(Native.roles(producer, issuer, store), Native.close(w))), Option.some(Native.launcher))
  def assemble (name: String)(w: World)(producer: Block)(producerEnd: Nat)(issuer: Block)(store: Block): Kernel := {
    let prod := Native.elect(6, Native.take(2, 3, Native.append(producer, Native.block(Native.drain(w, w.stages)))))
    let issue := Native.elect(producerEnd, Native.take(4, 5, Native.append(issuer, Block.seq(Native.commit(Expr.sharedAddr(8)), Block.done))))
    let stores := Block.seq(Native.wait(Expr.sharedAddr(8), Expr.lit(0)), Block.seq(Native.after,
      Block.seq(Stmt.declMut(DType.u32, 1, Expr.lit(0)), Native.append(store,
        Native.block(Native.laneZero(List.cons(Stmt.instr(Instr.bulkWait(BulkWait.complete, 0)), List.nil(Stmt))))))))
    Native.kernel(name, w, prod, issue, stores)
  }
}
