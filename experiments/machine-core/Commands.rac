import Protocol

namespace Commands {
  open Protocol
  sealed inductive Key: Type
   | key: Key
  sealed struct Resource (l: Lifetime)(world: Native.World): Type { scope = l }
   | mk: Resource(l, world)
  sealed struct Index (l: Lifetime): Type { scope = l }
   | mk (expr: Cuda.Expr): Index(l)
  // A read-only register view minted by loadWith at the actual load's fresh-name position.
  // The world and chunk coordinate prevent substituting data from another allocation or chunk.
  sealed struct Values (l: Lifetime)(world: Native.World)(index: Cuda.Expr): Type { scope = l }
   | mk (first: Nat): Values(l, world, index)
  sealed inductive Cmd (l: Lifetime)(world: Native.World)(role: Role)(before: State)(after: State): Type { kind = lin, scope = l }
   | mk (build: { kind = lin, scope = l } (start: Nat) -> Output(world, role, before, after, start)): Cmd(l, world, role, before, after)

  def compile {l: Lifetime}{w: Native.World}{r: Role}{a: State}{b: State}(key: Key)(cmd: Cmd(l, w, r, a, b))(start: Nat): Output(w, r, a, b, start) := {
    match cmd returning Output(w, r, a, b, start) with
    | Cmd.mk build => build(start)
  }
  def atom {l: Lifetime}{w: Native.World}{r: Role}{a: State}{b: State}(key: Key)(resource: Resource(l, w))(op: Native.Op)(step: Step(r, a, b, op)): Cmd(l, w, r, a, b) :=
    Cmd.mk(w, r, a, b, fun { kind = lin, scope = l } (start: Nat): Output(w, r, a, b, start) => {
      let emitted := Native.emit(w, op, start)
      Output.mk(Plan.atom(op), emitted.body, emitted.next, Flow.atom(w, r, a, b, op, start, step))
    })
  def then {la: Lifetime}{lb: Lifetime}{w: Native.World}{r: Role}{a: State}{m: State}{b: State}
      (left: Cmd(la, w, r, a, m))(right: Cmd(lb, w, r, m, b)): Cmd(Lifetime.union(la, lb), w, r, a, b) :=
    Cmd.mk(w, r, a, b, fun { kind = lin, scope = Lifetime.union(la, lb) } (start: Nat): Output(w, r, a, b, start) => {
      let first := Commands.compile(Key.key, left, start)
      let second := Commands.compile(Key.key, right, first.next)
      Output.mk(Plan.seq(first.plan, second.plan), Native.append(first.body, second.body), second.next,
        Flow.seq(r, a, m, b, first.plan, second.plan, first.body, second.body, start, first.next, second.next, first.proof, second.proof))
    })
  def inScope {l: Lifetime}{w: Native.World}{r: Role}{a: State}{b: State}(extra: Lifetime)(cmd: Cmd(l, w, r, a, b)): Cmd(Lifetime.union(l, extra), w, r, a, b) :=
    Cmd.mk(w, r, a, b, fun { kind = lin, scope = Lifetime.union(l, extra) } (start: Nat): Output(w, r, a, b, start) => Commands.compile(Key.key, cmd, start))
  def acquire {l: Lifetime}{w: Native.World}(r: Resource(l, w)): Cmd(l, w, Role.producer, State.producing, State.slot) := Commands.atom(Key.key, r, Native.Op.acquire, Step.acquire)
  def fill {l: Lifetime}{i: Lifetime}{w: Native.World}(r: Resource(l, w))(index: Index(i)): Cmd(Lifetime.union(l, i), w, Role.producer, State.slot, State.producing) :=
    Commands.atom(Key.key, Resource.mk(Lifetime.union(l, i), w), Native.Op.fill(index.expr), Step.fill(index.expr))
  def awaitFirst {l: Lifetime}{w: Native.World}(r: Resource(l, w)): Cmd(l, w, Role.issuer, State.empty, State.readyEmpty) := Commands.atom(Key.key, r, Native.Op.await, Step.awaitFirst)
  def awaitNext {l: Lifetime}{w: Native.World}(r: Resource(l, w)): Cmd(l, w, Role.issuer, State.pending, State.readyPending) := Commands.atom(Key.key, r, Native.Op.await, Step.awaitNext)
  def mmaFirst {l: Lifetime}{w: Native.World}(r: Resource(l, w)): Cmd(l, w, Role.issuer, State.readyEmpty, State.used) := Commands.atom(Key.key, r, Native.Op.mmaFirst, Step.first)
  def mmaNext {l: Lifetime}{w: Native.World}(r: Resource(l, w)): Cmd(l, w, Role.issuer, State.readyPending, State.used) := Commands.atom(Key.key, r, Native.Op.mmaNext, Step.next)
  def release {l: Lifetime}{w: Native.World}(r: Resource(l, w)): Cmd(l, w, Role.issuer, State.used, State.pending) := Commands.atom(Key.key, r, Native.Op.release, Step.release)
  def coordinate {i: Lifetime}(index: Index(i)): Cuda.Expr := index.expr
  def scoped {l: Lifetime}{i: Lifetime}{w: Native.World}(r: Resource(l, w))(index: Index(i)): Resource(Lifetime.union(l, i), w) :=
    Resource.mk(Lifetime.union(l, i), w)
  def widenIndex {i: Lifetime}(extra: Lifetime)(index: Index(i)): Index(Lifetime.union(extra, i)) :=
    Index.mk(Lifetime.union(extra, i), index.expr)
  def ChunkBody (l: Lifetime)(w: Native.World){i: Lifetime}(index: Index(i)): Type { kind = lin, scope = Lifetime.union(l, i) } :=
    Cmd(Lifetime.union(l, i), w, Role.store, State.chunk(index.expr), State.stored(index.expr))
  def load {l: Lifetime}{i: Lifetime}{w: Native.World}(r: Resource(l, w))(index: Index(i)): Cmd(Lifetime.union(l, i), w, Role.store, State.chunk(index.expr), State.loaded(index.expr)) :=
    Commands.atom(Key.key, Resource.mk(Lifetime.union(l, i), w), Native.Op.load(index.expr), Step.load(index.expr))
  def acquireStage {l: Lifetime}{i: Lifetime}{w: Native.World}(r: Resource(l, w))(index: Index(i)): Cmd(Lifetime.union(l, i), w, Role.store, State.loaded(index.expr), State.free(index.expr)) :=
    Commands.atom(Key.key, Resource.mk(Lifetime.union(l, i), w), Native.Op.acquireStage, Step.acquireStage(index.expr))
  def writeStage {l: Lifetime}{i: Lifetime}{w: Native.World}(r: Resource(l, w))(index: Index(i)): Cmd(Lifetime.union(l, i), w, Role.store, State.free(index.expr), State.written(index.expr)) := {
    let coord := index.expr
    let resource := Commands.scoped(r, index)
    Cmd.mk(w, Role.store, State.free(coord), State.written(coord),
      fun { kind = lin, scope = Lifetime.union(l, i) } (start: Nat): Output(w, Role.store, State.free(coord), State.written(coord), start) =>
        Commands.compile(Key.key, Commands.atom(Key.key, resource, Native.Op.writeStage(Nat.sub(start, 32)), Step.write(coord, Nat.sub(start, 32))), start))
  }
  def writeValues {l: Lifetime}{i: Lifetime}{w: Native.World}(r: Resource(l, w))(index: Index(i))(values: Values(Lifetime.union(l, i), w, index.expr))
      : Cmd(Lifetime.union(l, i), w, Role.store, State.free(index.expr), State.written(index.expr)) :=
    Commands.atom(Key.key, Commands.scoped(r, index), Native.Op.writeStage(values.first), Step.write(index.expr, values.first))
  def loadWith {l: Lifetime}{i: Lifetime}{w: Native.World}{after: State}(r: Resource(l, w))(index: Index(i))
      (body: { scope = Lifetime.union(l, i) } (values: Values(Lifetime.union(l, i), w, index.expr)) -> Cmd(Lifetime.union(l, i), w, Role.store, State.loaded(index.expr), after))
      : Cmd(Lifetime.union(l, i), w, Role.store, State.chunk(index.expr), after) :=
    {
      let coord := index.expr
      let load := Commands.load(r, index)
      Cmd.mk(w, Role.store, State.chunk(coord), after,
        fun { kind = lin, scope = Lifetime.union(l, i) } (start: Nat): Output(w, Role.store, State.chunk(coord), after, start) => {
          let loaded := Commands.compile(Key.key, load, start)
          let rest := Commands.compile(Key.key, body(Values.mk(Lifetime.union(l, i), w, coord, start)), loaded.next)
          Output.mk(Plan.seq(loaded.plan, rest.plan), Native.append(loaded.body, rest.body), rest.next,
            Flow.seq(Role.store, State.chunk(coord), State.loaded(coord), after, loaded.plan, rest.plan, loaded.body, rest.body, start, loaded.next, rest.next, loaded.proof, rest.proof))
        })
    }
  def fenceStage {l: Lifetime}{i: Lifetime}{w: Native.World}(r: Resource(l, w))(index: Index(i)): Cmd(Lifetime.union(l, i), w, Role.store, State.written(index.expr), State.fenced(index.expr)) :=
    Commands.atom(Key.key, Resource.mk(Lifetime.union(l, i), w), Native.Op.fenceStage, Step.fence(index.expr))
  def store {l: Lifetime}{i: Lifetime}{w: Native.World}(r: Resource(l, w))(index: Index(i)): Cmd(Lifetime.union(l, i), w, Role.store, State.fenced(index.expr), State.stored(index.expr)) :=
    Commands.atom(Key.key, Resource.mk(Lifetime.union(l, i), w), Native.Op.store(index.expr), Step.store(index.expr))

  // Both callbacks are unrestricted: a runtime loop cannot duplicate captured
  // authority. The loop index belongs to a fresh scope; only syntax and the
  // proposition indexed by that syntax leave it.
  def peeled {l: Lifetime}{w: Native.World}{firstScope: Lifetime}{restScope: Lifetime}(r: Role)(a: State)(b: State)(resource: Resource(l, w))
      (first: { scope = firstScope } (i: Lifetime) -> Index(i) -> Cmd(Lifetime.union(l, i), w, r, a, b))
      (rest: { scope = restScope } (i: Lifetime) -> Index(i) -> Cmd(Lifetime.union(l, i), w, r, b, b)): Cmd(Lifetime.union(l, Lifetime.union(firstScope, restScope)), w, r, a, b) :=
    Cmd.mk(w, r, a, b, fun { kind = lin, scope = Lifetime.union(l, Lifetime.union(firstScope, restScope)) } (start: Nat): Output(w, r, a, b, start) => scope i => {
      let initial := Commands.compile(Key.key, first(i, Index.mk(i, Cuda.Expr.lit(0))), start)
      scope j => {
        let repeated := Commands.compile(Key.key, rest(j, Index.mk(j, Cuda.Expr.var(initial.next))), Nat.succ(initial.next))
        Output.mk(Plan.peeled(initial.plan, repeated.plan), Protocol.peeledBlock(initial.body, initial.next, repeated.body), repeated.next,
          Flow.peeled(r, a, b, initial.plan, repeated.plan, initial.body, repeated.body, start, initial.next, repeated.next, initial.proof, repeated.proof))
      }
    })
  def chunks {l: Lifetime}{w: Native.World}{bodyScope: Lifetime}(resource: Resource(l, w))
      (body: { scope = bodyScope } (i: Lifetime) -> (index: Index(i)) -> Commands.ChunkBody(l, w, index))
      : Cmd(Lifetime.union(l, bodyScope), w, Role.store, State.storing, State.done) :=
    Cmd.mk(w, Role.store, State.storing, State.done, fun { kind = lin, scope = Lifetime.union(l, bodyScope) } (start: Nat): Output(w, Role.store, State.storing, State.done, start) => scope i => {
      let repeated := Commands.compile(Key.key, body(i, Index.mk(i, Cuda.Expr.var(start))), Nat.succ(start))
      Output.mk(Plan.chunks(repeated.plan), Protocol.loopBlock(start, Cuda.Expr.lit(0), Cuda.Expr.lit(4), repeated.body), repeated.next, Flow.chunks(repeated.plan, repeated.body, start, repeated.next, repeated.proof))
    })

  // The shell owns all resources and assigns the physical actor groups. Only
  // complete role programs reach it; no command can select a different actor.
  sealed struct Program: Type
   | mk (world: Native.World)(producer: Output(world, Role.producer, State.producing, State.producing, 7))
        (issuer: Output(world, Role.issuer, State.empty, State.pending, Nat.succ(producer.next)))
        (store: Output(world, Role.store, State.storing, State.done, issuer.next))
        (name: String): Program
  def syntax (p: Program): Cuda.Kernel := Native.assemble(p.name, p.world, p.producer.body, p.producer.next, p.issuer.body, p.store.body)
  def world (p: Program): Native.World := p.world
  def certified (p: Program): KernelFlow(p.world, Commands.syntax(p)) :=
    KernelFlow.assembled(p.world, p.name, p.producer.plan, p.issuer.plan, p.store.plan, p.producer.body, p.producer.next, p.issuer.body, p.issuer.next, p.store.body, p.store.next,
      p.producer.proof, p.issuer.proof, p.store.proof)
  def kernel (name: String)(stages: Nat)(buffers: Nat)[stageCount: Nat.lt(0, stages)][bufferCount: Nat.lt(0, buffers)]
      (producer: (l: Lifetime) -> Resource(l, Native.world(stages, buffers)) -> Cmd(l, Native.world(stages, buffers), Role.producer, State.producing, State.producing))
      (issuer: (l: Lifetime) -> Resource(l, Native.world(stages, buffers)) -> Cmd(l, Native.world(stages, buffers), Role.issuer, State.empty, State.pending))
      (store: (l: Lifetime) -> Resource(l, Native.world(stages, buffers)) -> Cmd(l, Native.world(stages, buffers), Role.store, State.storing, State.done)): Program := scope l => {
    let w := Native.world(stages, buffers)
    let r := Resource.mk(l, w)
    let p := Commands.compile(Key.key, producer(l, r), 7)
    let i := Commands.compile(Key.key, issuer(l, r), Nat.succ(p.next))
    let s := Commands.compile(Key.key, store(l, r), i.next)
    Program.mk(w, p, i, s, name)
  }
}
