import Commands

// The real TinyGEMM client, expressed with state-indexed commands. The
// callbacks contain no emitter, authority-token tuple, Fixed witness, or
// proof term. They still choose and order the native resource operations.
namespace MachineTiny {
  open Commands
  open Protocol

  def producer {l: Lifetime}{w: Native.World}(r: Resource(l, w)): Cmd(l, w, Role.producer, State.producing, State.producing) := {
    let step := fun (i: Lifetime)(index: Index(i)): Cmd(Lifetime.union(l, i), w, Role.producer, State.producing, State.producing) =>
      Commands.then(acquire(r), fill(r, index))
    Commands.peeled(Role.producer, State.producing, State.producing, r, step, step)
  }
  def issuer {l: Lifetime}{w: Native.World}(r: Resource(l, w)): Cmd(l, w, Role.issuer, State.empty, State.pending) := {
    let first := fun (i: Lifetime)(index: Index(i)): Cmd(Lifetime.union(l, i), w, Role.issuer, State.empty, State.pending) =>
      Commands.inScope(i, Commands.then(awaitFirst(r), Commands.then(mmaFirst(r), release(r))))
    let rest := fun (i: Lifetime)(index: Index(i)): Cmd(Lifetime.union(l, i), w, Role.issuer, State.pending, State.pending) =>
      Commands.inScope(i, Commands.then(awaitNext(r), Commands.then(mmaNext(r), release(r))))
    Commands.peeled(Role.issuer, State.empty, State.pending, r, first, rest)
  }
  def epilogue {l: Lifetime}{w: Native.World}(r: Resource(l, w)): Cmd(l, w, Role.store, State.storing, State.done) :=
    Commands.chunks(r, fun (i: Lifetime)(index: Index(i)): Commands.ChunkBody(l, w, index) =>
      Commands.then(load(r, index), Commands.then(acquireStage(r, index), Commands.then(writeStage(r, index), Commands.then(fenceStage(r, index), store(r, index))))))

  def build (name: String)(stages: Nat)(buffers: Nat)[stageCount: Nat.lt(0, stages)][bufferCount: Nat.lt(0, buffers)]: Program := Commands.kernel(name, stages, buffers,
    fun (l: Lifetime)(r: Resource(l, Native.world(stages, buffers))): Cmd(l, Native.world(stages, buffers), Role.producer, State.producing, State.producing) => MachineTiny.producer(r),
    fun (l: Lifetime)(r: Resource(l, Native.world(stages, buffers))): Cmd(l, Native.world(stages, buffers), Role.issuer, State.empty, State.pending) => MachineTiny.issuer(r),
    fun (l: Lifetime)(r: Resource(l, Native.world(stages, buffers))): Cmd(l, Native.world(stages, buffers), Role.store, State.storing, State.done) => MachineTiny.epilogue(r))[stageCount, bufferCount]
  def kernel: Program := MachineTiny.build("tinygemm", 4, 2)
}
