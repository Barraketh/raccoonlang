import Commands
import Check

// Client-facing TinyGEMM slice. Physical layout and allocation graph are still
// fixed by Native; these views name the resources without exposing authority.
namespace Gpu {
  open Protocol

  def Layout: Type := Native.World
  def layout (stages: Nat)(buffers: Nat): Layout := Native.world(stages, buffers)
  def Program: Type := Commands.Program
  def then {la: Lifetime}{lb: Lifetime}{w: Layout}{r: Role}{a: State}{m: State}{b: State}
      (left: Commands.Cmd(la, w, r, a, m))(right: Commands.Cmd(lb, w, r, m, b)): Commands.Cmd(Lifetime.union(la, lb), w, r, a, b) := Commands.then(left, right)
  def syntax (program: Program): Cuda.Kernel := Commands.syntax(program)
  def certified (program: Program): KernelFlow(Commands.world(program), Gpu.syntax(program)) := Commands.certified(program)
  def render (program: Program)[valid: Check.WellFormed(Gpu.syntax(program))]: String := Cuda.boundedKernel(Option.some((256, 1)), Gpu.syntax(program))

  def ProducerBody (l: Lifetime)(w: Native.World): Type { kind = lin, scope = l } :=
    Commands.Cmd(l, w, Role.producer, State.producing, State.producing)
  def IssueBody (l: Lifetime)(w: Native.World): Type { kind = lin, scope = l } :=
    Commands.Cmd(l, w, Role.issuer, State.empty, State.pending)
  def StoreBody (l: Lifetime)(w: Native.World): Type { kind = lin, scope = l } :=
    Commands.Cmd(l, w, Role.store, State.storing, State.done)

  sealed struct Ring (l: Lifetime)(w: Native.World): Type { scope = l }
   | mk (resource: Commands.Resource(l, w)): Ring(l, w)
  namespace Ring {
    def acquire {l: Lifetime}{w: Native.World}(ring: Ring(l, w)): Commands.Cmd(l, w, Role.producer, State.producing, State.slot) := Commands.acquire(ring.resource)
    def awaitFirst {l: Lifetime}{w: Native.World}(ring: Ring(l, w)): Commands.Cmd(l, w, Role.issuer, State.empty, State.readyEmpty) := Commands.awaitFirst(ring.resource)
    def awaitNext {l: Lifetime}{w: Native.World}(ring: Ring(l, w)): Commands.Cmd(l, w, Role.issuer, State.pending, State.readyPending) := Commands.awaitNext(ring.resource)
    def release {l: Lifetime}{w: Native.World}(ring: Ring(l, w)): Commands.Cmd(l, w, Role.issuer, State.used, State.pending) := Commands.release(ring.resource)
  }
  sealed struct Accumulator (l: Lifetime)(w: Native.World): Type { scope = l }
   | mk (resource: Commands.Resource(l, w)): Accumulator(l, w)
  namespace Accumulator {
    def overwrite {l: Lifetime}{w: Native.World}(acc: Accumulator(l, w)): Commands.Cmd(l, w, Role.issuer, State.readyEmpty, State.used) := Commands.mmaFirst(acc.resource)
    def accumulate {l: Lifetime}{w: Native.World}(acc: Accumulator(l, w)): Commands.Cmd(l, w, Role.issuer, State.readyPending, State.used) := Commands.mmaNext(acc.resource)
  }

  sealed struct Slice (l: Lifetime)(i: Lifetime)(w: Native.World): Type { scope = Lifetime.union(l, i) }
   | mk (resource: Commands.Resource(Lifetime.union(l, i), w))(index: Commands.Index(i)): Slice(l, i, w)
  def ProduceStep (l: Lifetime)(i: Lifetime)(w: Native.World): Type { kind = lin, scope = Lifetime.union(l, i) } :=
    Gpu.ProducerBody(Lifetime.union(l, i), w)
  def FirstStep (l: Lifetime)(i: Lifetime)(w: Native.World): Type { kind = lin, scope = Lifetime.union(l, i) } :=
    Gpu.IssueBody(Lifetime.union(l, i), w)
  def NextStep (l: Lifetime)(i: Lifetime)(w: Native.World): Type { kind = lin, scope = Lifetime.union(l, i) } :=
    Commands.Cmd(Lifetime.union(l, i), w, Role.issuer, State.pending, State.pending)
  namespace Slice {
    def coordinate {l: Lifetime}{i: Lifetime}{w: Native.World}(slice: Slice(l, i, w)): Cuda.Expr := Commands.coordinate(slice.index)
    def ring {l: Lifetime}{i: Lifetime}{w: Native.World}(slice: Slice(l, i, w)): Ring(Lifetime.union(l, i), w) := Ring.mk(slice.resource)
    def accumulator {l: Lifetime}{i: Lifetime}{w: Native.World}(slice: Slice(l, i, w)): Accumulator(Lifetime.union(l, i), w) := Accumulator.mk(slice.resource)
    def fill {l: Lifetime}{i: Lifetime}{w: Native.World}(slice: Slice(l, i, w)): Commands.Cmd(Lifetime.union(l, i), w, Role.producer, State.slot, State.producing) := Commands.fill(slice.resource, slice.index)
  }

  sealed struct Producer (l: Lifetime)(w: Native.World): Type { scope = l }
   | mk (resource: Commands.Resource(l, w)): Producer(l, w)
  namespace Producer {
    def eachSlice {l: Lifetime}{w: Native.World}(producer: Producer(l, w))
        : { scope = l } {bodyScope: Lifetime}(body: { scope = bodyScope } (i: Lifetime) -> Slice(l, i, w) -> ProduceStep(l, i, w)) -> ProducerBody(Lifetime.union(l, bodyScope), w) :=
      fun {bodyScope: Lifetime}(body: { scope = bodyScope } (i: Lifetime) -> Slice(l, i, w) -> ProduceStep(l, i, w)): ProducerBody(Lifetime.union(l, bodyScope), w) => {
        let step := fun (i: Lifetime)(index: Commands.Index(i)): ProduceStep(l, i, w) => body(i, Slice.mk(l, Commands.scoped(producer.resource, index), index))
        Commands.peeled(Role.producer, State.producing, State.producing, producer.resource, step, step)
      }
  }

  sealed struct Issuer (l: Lifetime)(w: Native.World): Type { scope = l }
   | mk (resource: Commands.Resource(l, w)): Issuer(l, w)
  namespace Issuer {
    def peeled {l: Lifetime}{w: Native.World}(issuer: Issuer(l, w))
        : { scope = l } {firstScope: Lifetime}{restScope: Lifetime}(first: { scope = firstScope } (i: Lifetime) -> Slice(l, i, w) -> FirstStep(l, i, w)) ->
          (rest: { scope = restScope } (i: Lifetime) -> Slice(l, i, w) -> NextStep(l, i, w)) -> IssueBody(Lifetime.union(l, Lifetime.union(firstScope, restScope)), w) :=
      fun {firstScope: Lifetime}{restScope: Lifetime}(first: { scope = firstScope } (i: Lifetime) -> Slice(l, i, w) -> FirstStep(l, i, w))
          (rest: { scope = restScope } (i: Lifetime) -> Slice(l, i, w) -> NextStep(l, i, w)): IssueBody(Lifetime.union(l, Lifetime.union(firstScope, restScope)), w) =>
        Commands.peeled(Role.issuer, State.empty, State.pending, issuer.resource,
          fun (i: Lifetime)(index: Commands.Index(i)): FirstStep(l, i, w) => first(i, Slice.mk(l, Commands.scoped(issuer.resource, index), index)),
          fun (i: Lifetime)(index: Commands.Index(i)): NextStep(l, i, w) => rest(i, Slice.mk(l, Commands.scoped(issuer.resource, index), index)))
  }

  sealed struct Staging (l: Lifetime)(w: Native.World)(index: Commands.Index(l)): Type { scope = l }
   | mk (resource: Commands.Resource(l, w)): Staging(l, w, index)
  namespace Staging {
    def acquire {l: Lifetime}{w: Native.World}{index: Commands.Index(l)}(staging: Staging(l, w, index)): Commands.Cmd(l, w, Role.store, State.loaded(Commands.coordinate(index)), State.free(Commands.coordinate(index))) := Commands.acquireStage(staging.resource, index)
    def write {l: Lifetime}{w: Native.World}{index: Commands.Index(l)}(staging: Staging(l, w, index))
        : { scope = l } (values: Commands.Values(l, w, Commands.coordinate(index))) -> Commands.Cmd(l, w, Role.store, State.free(Commands.coordinate(index)), State.written(Commands.coordinate(index))) :=
      fun (values: Commands.Values(l, w, Commands.coordinate(index))): Commands.Cmd(l, w, Role.store, State.free(Commands.coordinate(index)), State.written(Commands.coordinate(index))) => Commands.writeValues(staging.resource, index, values)
    def fence {l: Lifetime}{w: Native.World}{index: Commands.Index(l)}(staging: Staging(l, w, index)): Commands.Cmd(l, w, Role.store, State.written(Commands.coordinate(index)), State.fenced(Commands.coordinate(index))) := Commands.fenceStage(staging.resource, index)
  }
  sealed struct Output (l: Lifetime)(w: Native.World)(index: Commands.Index(l)): Type { scope = l }
   | mk (resource: Commands.Resource(l, w)): Output(l, w, index)
  namespace Output {
    def store {l: Lifetime}{w: Native.World}{index: Commands.Index(l)}(output: Output(l, w, index)): Commands.Cmd(l, w, Role.store, State.fenced(Commands.coordinate(index)), State.stored(Commands.coordinate(index))) := Commands.store(output.resource, index)
  }

  sealed struct Chunk (l: Lifetime)(i: Lifetime)(w: Native.World): Type { scope = Lifetime.union(l, i) }
   | mk (resource: Commands.Resource(Lifetime.union(l, i), w))(index: Commands.Index(i)): Chunk(l, i, w)
  def ChunkBody {l: Lifetime}{i: Lifetime}{w: Native.World}(chunk: Chunk(l, i, w)): Type { kind = lin, scope = Lifetime.union(l, i) } :=
    Commands.Cmd(Lifetime.union(l, i), w, Role.store, State.chunk(Commands.coordinate(chunk.index)), State.stored(Commands.coordinate(chunk.index)))
  def LoadedBody {l: Lifetime}{i: Lifetime}{w: Native.World}(chunk: Chunk(l, i, w)): Type { kind = lin, scope = Lifetime.union(l, i) } :=
    Commands.Cmd(Lifetime.union(l, i), w, Role.store, State.loaded(Commands.coordinate(chunk.index)), State.stored(Commands.coordinate(chunk.index)))
  def Values {l: Lifetime}{i: Lifetime}{w: Native.World}(chunk: Chunk(l, i, w)): Type { scope = Lifetime.union(l, i) } :=
    Commands.Values(Lifetime.union(l, i), w, Commands.coordinate(chunk.index))
  namespace Chunk {
    def coordinate {l: Lifetime}{i: Lifetime}{w: Native.World}(chunk: Chunk(l, i, w)): Cuda.Expr := Commands.coordinate(chunk.index)
    def load {l: Lifetime}{i: Lifetime}{w: Native.World}(chunk: Chunk(l, i, w))
        : { scope = Lifetime.union(l, i) } (body: { scope = Lifetime.union(l, i) } (values: Gpu.Values(chunk)) -> LoadedBody(chunk)) -> ChunkBody(chunk) :=
      fun (body: { scope = Lifetime.union(l, i) } (values: Gpu.Values(chunk)) -> LoadedBody(chunk)): ChunkBody(chunk) => Commands.loadWith(chunk.resource, chunk.index, body)
    def staging {l: Lifetime}{i: Lifetime}{w: Native.World}(chunk: Chunk(l, i, w)): Staging(Lifetime.union(l, i), w, Commands.widenIndex(l, chunk.index)) :=
      Staging.mk(Commands.widenIndex(l, chunk.index), chunk.resource)
    def output {l: Lifetime}{i: Lifetime}{w: Native.World}(chunk: Chunk(l, i, w)): Output(Lifetime.union(l, i), w, Commands.widenIndex(l, chunk.index)) :=
      Output.mk(Commands.widenIndex(l, chunk.index), chunk.resource)
  }
  sealed struct Store (l: Lifetime)(w: Native.World): Type { scope = l }
   | mk (resource: Commands.Resource(l, w)): Store(l, w)
  namespace Store {
    def chunks {l: Lifetime}{w: Native.World}(store: Store(l, w))
        : { scope = l } {bodyScope: Lifetime}(body: { scope = bodyScope } (i: Lifetime) -> (chunk: Chunk(l, i, w)) -> ChunkBody(chunk)) -> StoreBody(Lifetime.union(l, bodyScope), w) :=
      fun {bodyScope: Lifetime}(body: { scope = bodyScope } (i: Lifetime) -> (chunk: Chunk(l, i, w)) -> ChunkBody(chunk)): StoreBody(Lifetime.union(l, bodyScope), w) =>
        Commands.chunks(store.resource, fun (i: Lifetime)(index: Commands.Index(i)): Commands.ChunkBody(l, w, index) =>
          body(i, Chunk.mk(l, Commands.scoped(store.resource, index), index)))
  }

  def tinyGemm (name: String)(stages: Nat)(buffers: Nat)[stageCount: Nat.lt(0, stages)][bufferCount: Nat.lt(0, buffers)]
      (producer: (l: Lifetime) -> Producer(l, Native.world(stages, buffers)) -> ProducerBody(l, Native.world(stages, buffers)))
      (issuer: (l: Lifetime) -> Issuer(l, Native.world(stages, buffers)) -> IssueBody(l, Native.world(stages, buffers)))
      (store: (l: Lifetime) -> Store(l, Native.world(stages, buffers)) -> StoreBody(l, Native.world(stages, buffers))): Commands.Program :=
    Commands.kernel(name, stages, buffers,
      fun (l: Lifetime)(r: Commands.Resource(l, Native.world(stages, buffers))): ProducerBody(l, Native.world(stages, buffers)) => producer(l, Producer.mk(r)),
      fun (l: Lifetime)(r: Commands.Resource(l, Native.world(stages, buffers))): IssueBody(l, Native.world(stages, buffers)) => issuer(l, Issuer.mk(r)),
      fun (l: Lifetime)(r: Commands.Resource(l, Native.world(stages, buffers))): StoreBody(l, Native.world(stages, buffers)) => store(l, Store.mk(r)))[stageCount, bufferCount]
}
