import encoding.Lowering
import encoding.Layout
import Machine

namespace LunaPair {
  open Core
  open Cuda
  open Layout
  open GpuMachine.{Machine, Ticket}

  def boxA : TmaSpec := TmaSpec.mk(64, 128)
  def boxB : TmaSpec := TmaSpec.mk(64, 128)
  def ringCfg (stages: Nat) : RingCfg := RingCfg.mk(stages, boxA, boxB)
  def Gemm (l: Lifetime) : Type { scope = l } := TmaGemm(l, boxA, boxB)

  def producer {stages: Nat}{l: Lifetime}{L: Lifetime}{r: Lifetime}(g: Gemm(l))(sched: PairSched(L, 256))(ring: PairRing(r, ringCfg(stages)))
      (steps: Val(l, Grain.uniform, DType.u32))(p: Producer(r))(m: Lifetime)(machine: Machine(m, Load, Unit)): Machine(m, Load, Unit) :=
    GpuMachine.elect(machine, fun (j: Lifetime)(w: Elected(j))(lane: Machine(j, Group.lane, Unit)): Machine(j, Group.lane, Unit) => {
      let tile := fun (n: Lifetime)(t: PairTile(n, 256))(state: Machine(n, Group.lane, ProducerAt(r, j))): Machine(n, Group.lane, ProducerAt(r, j)) =>
        GpuMachine.peeled(state, ProducerAt(r, j), steps,
          fun (o: Lifetime)(i: Val(o, Grain.uniform, DType.u32))(state: Machine(o, Group.lane, ProducerAt(r, j))): Machine(o, Group.lane, ProducerAt(r, j)) =>
            GpuMachine.fillPair(GpuMachine.acquirePair(state, ring), ring, t, g.a, g.b, mulC(i, 64)),
          fun (o: Lifetime)(i: Val(o, Grain.uniform, DType.u32))(state: Machine(o, Group.lane, ProducerAt(r, j))): Machine(o, Group.lane, ProducerAt(r, j)) =>
            GpuMachine.fillPair(GpuMachine.acquirePair(state, ring), ring, t, g.a, g.b, mulC(i, 64)))
      let state := GpuMachine.takePairProducer(lane, w, ring, p)
      let state := GpuMachine.forPairTiles(state, sched, tile)
      GpuMachine.finishPairProducer(state, ring)
    })

  def issue {stages: Nat}{n: Lifetime}{L: Lifetime}{r: Lifetime}{q: Lifetime}{l: Lifetime}(lead: Leader(n))(sched: PairSched(L, 256))
      (ring: PairRing(r, ringCfg(stages)))(accs: PairAccRing(q, 256))(steps: Val(l, Grain.uniform, DType.u32))(c: Consumer(r))(p: AccProducer(q))
      (machine: Machine(n, Issue, Unit)): Machine(n, Issue, Unit) :=
    GpuMachine.elect(machine, fun (j: Lifetime)(w: Elected(j))(lane: Machine(j, Group.lane, Unit)): Machine(j, Group.lane, Unit) => {
      let first := fun (o: Lifetime)(i: Val(o, Grain.uniform, DType.u32))(state: Machine(o, Group.lane, Pair(ConsumerAt(r, j), AccFree(q, j))))
          : Machine(o, Group.lane, Pair(ConsumerAt(r, j), AccFilling(q, j))) => {
        let state := GpuMachine.focusLeft(state, fun (c: Machine(o, Group.lane, ConsumerAt(r, j))): Machine(o, Group.lane, Ready(r, j)) => GpuMachine.awaitPair(c, ring))
        let state := GpuMachine.mmaPairFirst(state, w, ring, accs)
        GpuMachine.focusLeft(state, fun (c: Machine(o, Group.lane, ReadyUsed(r, j))): Machine(o, Group.lane, ConsumerAt(r, j)) => GpuMachine.releasePair(c, w, ring))
      }
      let rest := fun (o: Lifetime)(i: Val(o, Grain.uniform, DType.u32))(state: Machine(o, Group.lane, Pair(ConsumerAt(r, j), AccFilling(q, j))))
          : Machine(o, Group.lane, Pair(ConsumerAt(r, j), AccFilling(q, j))) => {
        let state := GpuMachine.focusLeft(state, fun (c: Machine(o, Group.lane, ConsumerAt(r, j))): Machine(o, Group.lane, Ready(r, j)) => GpuMachine.awaitPair(c, ring))
        let state := GpuMachine.mmaPairNext(state, w, ring, accs)
        GpuMachine.focusLeft(state, fun (c: Machine(o, Group.lane, ReadyUsed(r, j))): Machine(o, Group.lane, ConsumerAt(r, j)) => GpuMachine.releasePair(c, w, ring))
      }
      let tile := fun (o: Lifetime)(t: PairTile(o, 256))(state: Machine(o, Group.lane, Pair(ConsumerAt(r, j), AccProducerAt(q, j))))
          : Machine(o, Group.lane, Pair(ConsumerAt(r, j), AccProducerAt(q, j))) => {
        let state := GpuMachine.focusRight(state, fun (p: Machine(o, Group.lane, AccProducerAt(q, j))): Machine(o, Group.lane, AccFree(q, j)) => GpuMachine.acquirePairAcc(p, accs))
        let state := GpuMachine.peeled(state, Pair(ConsumerAt(r, j), AccFilling(q, j)), steps, first, rest)
        GpuMachine.focusRight(state, fun (a: Machine(o, Group.lane, AccFilling(q, j))): Machine(o, Group.lane, AccProducerAt(q, j)) => GpuMachine.commitPairAcc(a, w, accs))
      }
      let (empty, ct) := GpuMachine.park(GpuMachine.takePairConsumer(lane, w, lead, ring, c))
      let pstate := GpuMachine.takePairAccProducer(empty, w, lead, accs, p)
      let (empty, pt) := GpuMachine.park(pstate)
      let state := GpuMachine.use(empty, GpuMachine.pairTickets(ct, pt))
      let state := GpuMachine.forPairTiles(state, sched, tile)
      let state := GpuMachine.focusRight(state, fun (p: Machine(j, Group.lane, AccProducerAt(q, j))): Machine(j, Group.lane, Unit) => GpuMachine.finishPairAccProducer(p, accs))
      let state := GpuMachine.focusLeft(state, fun (c: Machine(j, Group.lane, ConsumerAt(r, j))): Machine(j, Group.lane, Unit) => GpuMachine.finishConsumer(c))
      GpuMachine.dropUnitLeft(state)
    })

  def issuer {stages: Nat}{l: Lifetime}{r: Lifetime}{q: Lifetime}{L: Lifetime}(pair: CtaPair(l))(sched: PairSched(L, 256))(ring: PairRing(r, ringCfg(stages)))
      (accs: PairAccRing(q, 256))(steps: Val(l, Grain.uniform, DType.u32))(c: Consumer(r))(p: AccProducer(q))
      (m: Lifetime)(machine: Machine(m, Issue, Unit)): Machine(m, Issue, Unit) :=
    GpuMachine.leaderIssue(machine, pair, ring, accs, c, p,
      fun (n: Lifetime)(lead: Leader(n))(u: Machine(n, Issue, Unit))(consumer: Consumer(r))(producer: AccProducer(q)): Machine(n, Issue, Unit) =>
        issue(lead, sched, ring, accs, steps, consumer, producer, u))

  def epilogue {l: Lifetime}{q: Lifetime}{s: Lifetime}(g: Gemm(l))(sched: PairSched(l, 256))(own: PairSchedOwn(l, 256))
      (accs: PairAccRing(q, 256))(ac: AccConsumer(q))(stg: Staging(s))(side: StoreSide(s))(m: Lifetime)(machine: Machine(m, Wg, Unit)): Machine(m, Wg, Unit) := {
    let chunk := fun (p: Lifetime)(ch: ChunkAt(p, 256))(co: ChunkOwn(p, 256))(state: Machine(p, Wg, Pair(AccFull(q, m, 4), StoreAt(s, m, 4))))
        : Machine(p, Wg, Pair(AccFull(q, m, 4), StoreAt(s, m, 4))) => {
      let (state, regs) := GpuMachine.focusLeftValue(state, fun (full: Machine(p, Wg, AccFull(q, m, 4))): Pair(Machine(p, Wg, AccFull(q, m, 4)), ChunkRegs(p)) => GpuMachine.loadPairChunk(full, accs, ch))
      let state := GpuMachine.focusRight(state, fun (sa: Machine(p, Wg, StoreAt(s, m, 4))): Machine(p, Wg, StageFree(s, m, 4)) => GpuMachine.acquireStage(sa, stg))
      let state := GpuMachine.focusRight(state, fun (sf: Machine(p, Wg, StageFree(s, m, 4))): Machine(p, Wg, StageWritten(s, m, 4)) => GpuMachine.writeStage(sf, stg, regs))
      let state := GpuMachine.focusRight(state, fun (w: Machine(p, Wg, StageWritten(s, m, 4))): Machine(p, Wg, StageFenced(s, m, 4)) => GpuMachine.fenceStage(w))
      GpuMachine.focusRight(state, fun (f: Machine(p, Wg, StageFenced(s, m, 4))): Machine(p, Wg, StoreAt(s, m, 4)) => GpuMachine.storeStage(f, stg, g.c, ch, co))
    }
    let tile := fun (n: Lifetime)(t: PairTile(n, 256))(o: HalfOwn(n))(state: Machine(n, Wg, Pair(AccConsumerAt(q, m, 4), StoreAt(s, m, 4))))
        : Machine(n, Wg, Pair(AccConsumerAt(q, m, 4), StoreAt(s, m, 4))) => {
      let state := GpuMachine.focusLeft(state, fun (c: Machine(n, Wg, AccConsumerAt(q, m, 4))): Machine(n, Wg, AccFull(q, m, 4)) => GpuMachine.awaitPairAcc(c, accs))
      let state := GpuMachine.forHalfChunks(state, t, o, chunk)
      GpuMachine.focusLeft(state, fun (full: Machine(n, Wg, AccFull(q, m, 4))): Machine(n, Wg, AccConsumerAt(q, m, 4)) => GpuMachine.releasePairAcc(full, accs))
    }
    let (empty, accTicket) := GpuMachine.park(GpuMachine.takePairAccConsumer(machine, accs, ac))
    let storeState := GpuMachine.takeStore(empty, stg, side)
    let (empty, storeTicket) := GpuMachine.park(storeState)
    let state := GpuMachine.use(empty, GpuMachine.pairTickets(accTicket, storeTicket))
    let state := GpuMachine.forOwnedPairTiles(state, sched, own, tile)
    let state := GpuMachine.focusRight(state, fun (s: Machine(m, Wg, StoreAt(s, m, 4))): Machine(m, Wg, Unit) => GpuMachine.finishStores(s, stg))
    let state := GpuMachine.focusLeft(state, fun (c: Machine(m, Wg, AccConsumerAt(q, m, 4))): Machine(m, Wg, Unit) => GpuMachine.finishAccConsumer(c))
    GpuMachine.dropUnitLeft(state)
  }

  def build(name: String)(stages: Nat)(buffers: Nat)(band: Nat): Program := {
    let cfg := ringCfg(stages)
    GpuMachine.pairGemmPersistentKernel(name, boxA, boxB, band,
      fun (l: Lifetime)(machine: Machine(l, Cta, Unit))(g: Gemm(l))(sched: PairSched(l, 256))(own: PairSchedOwn(l, 256))
          (pair: CtaPair(l))(permit: TmemPermit(l)): Machine(l, Cta, Unit) => {
        let steps := ceilDivC(g.k, 64)
        let (machine, output) := GpuMachine.withPairTmem(machine, pair, permit, AccState.empty, Unit,
          fun (a: Lifetime)(t: Tmem(a, 512))(acc: Acc(a, AccState.empty))(machine: Machine(l, Cta, Unit)): Pair(Machine(l, Cta, Unit), Pair(Acc(a, AccState.empty), Unit)) =>
            GpuMachine.withPairAccRing(machine, pair, t, acc, buffers, 256, Unit,
              fun (q: Lifetime)(accs: PairAccRing(q, 256))(ap: AccProducer(q))(ac: AccConsumer(q))(machine: Machine(l, Cta, Unit)): Pair(Machine(l, Cta, Unit), Unit) =>
                GpuMachine.withStaging(machine, buffers, Unit,
                  fun (s: Lifetime)(stg: Staging(s))(side: StoreSide(s))(machine: Machine(l, Cta, Unit)): Pair(Machine(l, Cta, Unit), Unit) =>
                    GpuMachine.withPairRing(machine, pair, cfg, Unit,
                      fun (r: Lifetime)(ring: PairRing(r, cfg))(p: Producer(r))(c: Consumer(r))(machine: Machine(l, Cta, Unit)): Pair(Machine(l, Cta, Unit), Unit) =>
                        (GpuMachine.roles4(machine,
                          fun (m: Lifetime)(machine: Machine(m, Load, Unit)): Machine(m, Load, Unit) => producer(g, sched, ring, steps, p, m, machine),
                          fun (m: Lifetime)(machine: Machine(m, Issue, Unit)): Machine(m, Issue, Unit) => issuer(pair, sched, ring, accs, steps, c, ap, m, machine),
                          fun (m: Lifetime)(machine: Machine(m, Wg, Unit)): Machine(m, Wg, Unit) => epilogue(g, sched, own, accs, ac, stg, side, m, machine)), Unit.unit))))
            )
        machine
      })
  }
  def kernel : Program := build("gemm_pair", 6, 2, 8)
}

