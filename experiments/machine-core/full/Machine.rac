import encoding.Lowering
import encoding.Layout

// The emitter and its fixed, linear resource state travel together. Values remain
// ordinary scoped read-only handles. A parked ticket owns state but emits no code.
namespace GpuMachine {
  open Core
  open Cuda

  sealed inductive Key: Type
   | key: Key

  sealed inductive Machine (l: Lifetime)(g: Group){k: Kind}{T: Lifetime}(S: Type { kind = k, scope = T }): Type { kind = lin, scope = union(l, T) }
   | mk (emitter: Ctx(l, g))(state: S)(fixed: Fixed(S)): Machine(l, g, S)
  sealed inductive Ticket {k: Kind}{T: Lifetime}(S: Type { kind = k, scope = T }): Type { kind = k, scope = T }
   | mk (state: S)(fixed: Fixed(S)): Ticket(S)

  def unpack {l: Lifetime}{g: Group}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}(key: Key)(machine: Machine(l, g, S))
      : Pair(Ctx(l, g), Pair(S, Fixed(S))) := {
    match machine returning Pair(Ctx(l, g), Pair(S, Fixed(S))) with
    | Machine.mk e state fixed => (e, (state, fixed))
  }
  def start {l: Lifetime}{g: Group}(key: Key)(e: Ctx(l, g)): Machine(l, g, Unit) := Machine.mk(e, Unit.unit, fixedUnit)
  def finish {l: Lifetime}{g: Group}(key: Key)(machine: Machine(l, g, Unit)): Ctx(l, g) := {
    let (e, (u, fixed)) := unpack(key, machine)
    e
  }
  def park {l: Lifetime}{g: Group}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}(machine: Machine(l, g, S))
      : Pair(Machine(l, g, Unit), Ticket(S)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    (start(Key.key, e), Ticket.mk(state, fixed))
  }
  def use {l: Lifetime}{g: Group}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}(machine: Machine(l, g, Unit))(ticket: Ticket(S)): Machine(l, g, S) := {
    match ticket returning Machine(l, g, S) with
    | Ticket.mk state fixed => Machine.mk(finish(Key.key, machine), state, fixed)
  }
  def join {l: Lifetime}{g: Group}{ka: Kind}{Ta: Lifetime}{A: Type { kind = ka, scope = Ta }}{kb: Kind}{Tb: Lifetime}{B: Type { kind = kb, scope = Tb }}
      (machine: Machine(l, g, A))(ticket: Ticket(B)): Machine(l, g, Pair(A, B)) := {
    let (e, (a, fa)) := unpack(Key.key, machine)
    match ticket returning Machine(l, g, Pair(A, B)) with
    | Ticket.mk b fb => Machine.mk(e, (a, b), fixedPair(fa, fb))
  }
  def split {l: Lifetime}{g: Group}{ka: Kind}{Ta: Lifetime}{A: Type { kind = ka, scope = Ta }}{kb: Kind}{Tb: Lifetime}{B: Type { kind = kb, scope = Tb }}
      (machine: Machine(l, g, Pair(A, B))): Pair(Machine(l, g, A), Ticket(B)) := {
    let (e, ((a, b), fixed)) := unpack(Key.key, machine)
    (Machine.mk(e, a, fixedLeft(fixed)), Ticket.mk(b, fixedRight(fixed)))
  }
  def pairTickets {ka: Kind}{Ta: Lifetime}{A: Type { kind = ka, scope = Ta }}{kb: Kind}{Tb: Lifetime}{B: Type { kind = kb, scope = Tb }}
      (left: Ticket(A))(right: Ticket(B)): Ticket(Pair(A, B)) := {
    match left returning Ticket(Pair(A, B)) with
    | Ticket.mk a fa => {
      match right returning Ticket(Pair(A, B)) with
      | Ticket.mk b fb => Ticket.mk((a, b), fixedPair(fa, fb))
    }
  }
  def splitTicket {ka: Kind}{Ta: Lifetime}{A: Type { kind = ka, scope = Ta }}{kb: Kind}{Tb: Lifetime}{B: Type { kind = kb, scope = Tb }}
      (ticket: Ticket(Pair(A, B))): Pair(Ticket(A), Ticket(B)) := {
    match ticket returning Pair(Ticket(A), Ticket(B)) with
    | Ticket.mk state fixed => {
      let (a, b) := state
      (Ticket.mk(a, fixedLeft(fixed)), Ticket.mk(b, fixedRight(fixed)))
    }
  }
  def dropUnitRight {l: Lifetime}{g: Group}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}
      (machine: Machine(l, g, Pair(S, Unit))): Machine(l, g, S) := {
    let (machine, unit) := split(machine)
    machine
  }
  def dropUnitLeft {l: Lifetime}{g: Group}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}
      (machine: Machine(l, g, Pair(Unit, S))): Machine(l, g, S) := {
    let (empty, ticket) := split(machine)
    use(empty, ticket)
  }
  def focusLeft {l: Lifetime}{g: Group}{ka: Kind}{Ta: Lifetime}{A: Type { kind = ka, scope = Ta }}{kb: Kind}{Tb: Lifetime}{B: Type { kind = kb, scope = Tb }}
      {kc: Kind}{Tc: Lifetime}{C: Type { kind = kc, scope = Tc }}{kf: Kind}{Sf: Lifetime}
      (machine: Machine(l, g, Pair(A, B)))(body: { kind = kf, scope = Sf } Machine(l, g, A) -> Machine(l, g, C)): Machine(l, g, Pair(C, B)) := {
    let (left, right) := split(machine)
    join(body(left), right)
  }
  def focusLeftValue {l: Lifetime}{g: Group}{ka: Kind}{Ta: Lifetime}{A: Type { kind = ka, scope = Ta }}{kb: Kind}{Tb: Lifetime}{B: Type { kind = kb, scope = Tb }}
      {kc: Kind}{Tc: Lifetime}{C: Type { kind = kc, scope = Tc }}{kv: Kind}{Tv: Lifetime}{V: Type { kind = kv, scope = Tv }}{kf: Kind}{Sf: Lifetime}
      (machine: Machine(l, g, Pair(A, B)))(body: { kind = kf, scope = Sf } Machine(l, g, A) -> Pair(Machine(l, g, C), V)): Pair(Machine(l, g, Pair(C, B)), V) := {
    let (left, right) := split(machine)
    let (left, value) := body(left)
    (join(left, right), value)
  }
  def focusRight {l: Lifetime}{g: Group}{ka: Kind}{Ta: Lifetime}{A: Type { kind = ka, scope = Ta }}{kb: Kind}{Tb: Lifetime}{B: Type { kind = kb, scope = Tb }}
      {kc: Kind}{Tc: Lifetime}{C: Type { kind = kc, scope = Tc }}{kf: Kind}{Sf: Lifetime}
      (machine: Machine(l, g, Pair(A, B)))(body: { kind = kf, scope = Sf } Machine(l, g, B) -> Machine(l, g, C)): Machine(l, g, Pair(A, C)) := {
    let (left, right) := split(machine)
    let (empty, a) := park(left)
    let (empty, c) := park(body(use(empty, right)))
    join(use(empty, a), c)
  }
  def repeatFrom {l: Lifetime}{g: Group}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}{Sf: Lifetime}{Sn: Lifetime}
      (machine: Machine(l, g, S))(startAt: Nat)(count: Val(Sn, Grain.uniform, DType.u32))
      (body: { scope = Sf } (n: Lifetime) -> Val(n, Grain.uniform, DType.u32) -> Machine(n, g, S) -> Machine(n, g, S)): Machine(l, g, S) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, state) := Core.loopFrom(e, startAt, count, fixed, state,
      fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, g))(state: S): Pair(Ctx(n, g), S) => {
        let (e, (state, f)) := unpack(Key.key, body(n, i, Machine.mk(e, state, fixed)))
        (e, state)
      })
    Machine.mk(e, state, fixed)
  }
  def repeat {l: Lifetime}{g: Group}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}{Sf: Lifetime}{Sn: Lifetime}
      (machine: Machine(l, g, S))(count: Val(Sn, Grain.uniform, DType.u32))
      (body: { scope = Sf } (n: Lifetime) -> Val(n, Grain.uniform, DType.u32) -> Machine(n, g, S) -> Machine(n, g, S)): Machine(l, g, S) := repeatFrom(machine, 0, count, body)
  def peeled {l: Lifetime}{g: Group}{k0: Kind}{T0: Lifetime}{S0: Type { kind = k0, scope = T0 }}
      {k1: Kind}{T1: Lifetime}{Sf: Lifetime}{Sr: Lifetime}{Sn: Lifetime}
      (machine: Machine(l, g, S0))(S1: Type { kind = k1, scope = T1 })(count: Val(Sn, Grain.uniform, DType.u32))
      (first: { scope = Sf } (n: Lifetime) -> Val(n, Grain.uniform, DType.u32) -> Machine(n, g, S0) -> Machine(n, g, S1))
      (rest: { scope = Sr } (n: Lifetime) -> Val(n, Grain.uniform, DType.u32) -> Machine(n, g, S1) -> Machine(n, g, S1)): Machine(l, g, S1) := {
    let (e, (state, fixed0)) := unpack(Key.key, machine)
    let (e, (state, fixed1)) := Core.loopPeeledInferred(e, count, state,
      fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, g))(state: S0): Pair(Ctx(n, g), Pair(Pair(S1, Fixed(S1)), Fixed(Pair(S1, Fixed(S1))))) => {
        // Carry the witness alongside the state through the remaining loop.
        let (e, (state, fixed)) := unpack(Key.key, first(n, i, Machine.mk(e, state, fixed0)))
        (e, ((state, fixed), fixedPair(fixed, Core.fixedFixed(fixed))))
      },
      fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(e: Ctx(n, g))(state: Pair(S1, Fixed(S1))): Pair(Ctx(n, g), Pair(S1, Fixed(S1))) => {
        let (state, fixed) := state
        unpack(Key.key, rest(n, i, Machine.mk(e, state, fixed)))
      })
    Machine.mk(e, state, fixed1)
  }
  def when {l: Lifetime}{g: Group}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}{Sf: Lifetime}{Sc: Lifetime}{uc: Grain}
      (machine: Machine(l, g, S))(cond: Val(Sc, uc, DType.bool))
      (yes: { scope = Sf } (n: Lifetime) -> Machine(n, Group.arm(g, uc), S) -> Machine(n, Group.arm(g, uc), S)): Machine(l, g, S) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, state) := Core.when(e, cond, fixed, state,
      fun (n: Lifetime)(e: Ctx(n, Group.arm(g, uc)))(state: S): Pair(Ctx(n, Group.arm(g, uc)), S) => {
        let (e, (state, f)) := unpack(Key.key, yes(n, Machine.mk(e, state, fixed)))
        (e, state)
      })
    Machine.mk(e, state, fixed)
  }


  def fconst {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{l: Lifetime}{g: Group}(machine: Machine(l, g, State))(bits: Nat): Pair(Machine(l, g, State), Val(l, Grain.uniform, DType.f32)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, value) := Core.fconst(e, bits)
    (Machine.mk(e, state, fixed), value)
  }

  def reg {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{l: Lifetime}{g: Group}{S: Lifetime}{u: Grain}{t: DType}(machine: Machine(l, g, State))(init: Val(S, u, t)): Pair(Machine(l, g, State), Reg(l, t)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, value) := Core.reg(e, init)
    (Machine.mk(e, state, fixed), value)
  }

  def get {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{l: Lifetime}{g: Group}{S: Lifetime}{t: DType}(machine: Machine(l, g, State))(r: Reg(S, t)): Pair(Machine(l, g, State), Val(l, Grain.thread, t)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, value) := Core.get(e, r)
    (Machine.mk(e, state, fixed), value)
  }

  def set {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{l: Lifetime}{g: Group}{S: Lifetime}{Sv: Lifetime}{u: Grain}{t: DType}(machine: Machine(l, g, State))(r: Reg(S, t))(v: Val(Sv, u, t)): Machine(l, g, State) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    Machine.mk(Core.set(e, r, v), state, fixed)
  }

  def ex2 {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{l: Lifetime}{g: Group}{S: Lifetime}{u: Grain}(machine: Machine(l, g, State))(x: Val(S, u, DType.f32)): Pair(Machine(l, g, State), Val(l, u, DType.f32)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, value) := Core.ex2(e, x)
    (Machine.mk(e, state, fixed), value)
  }

  def ex2emu {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{l: Lifetime}{g: Group}{S: Lifetime}{u: Grain}(machine: Machine(l, g, State))(x: Val(S, u, DType.f32)): Pair(Machine(l, g, State), Val(l, u, DType.f32)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, value) := Core.ex2emu(e, x)
    (Machine.mk(e, state, fixed), value)
  }

  def lg2 {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{l: Lifetime}{g: Group}{S: Lifetime}{u: Grain}(machine: Machine(l, g, State))(x: Val(S, u, DType.f32)): Pair(Machine(l, g, State), Val(l, u, DType.f32)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, value) := Core.lg2(e, x)
    (Machine.mk(e, state, fixed), value)
  }

  def rcp {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{l: Lifetime}{g: Group}{S: Lifetime}{u: Grain}(machine: Machine(l, g, State))(x: Val(S, u, DType.f32)): Pair(Machine(l, g, State), Val(l, u, DType.f32)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, value) := Core.rcp(e, x)
    (Machine.mk(e, state, fixed), value)
  }

  def voteAny {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{l: Lifetime}{f: Nat}{c: Nat}{S: Lifetime}{u: Grain}(machine: Machine(l, Group.warps(f, c), State))(cond: Val(S, u, DType.bool)): Pair(Machine(l, Group.warps(f, c), State), Val(l, Grain.warp, DType.bool)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, value) := Core.voteAny(e, cond)
    (Machine.mk(e, state, fixed), value)
  }

  def maskedScores {ks: Kind}{Ts: Lifetime}{State: Type { kind = ks, scope = Ts }}{k: Lifetime}{f: Nat}{L: Lifetime}{Sb: Lifetime}{ub: Grain}{S: Lifetime}{u: Grain}(machine: Machine(k, Group.warps(f, 4), State))(mask: Mask(L))(block: Val(Sb, ub, DType.u32))(c: Nat)(v: F32x8(S, u)): Pair(Machine(k, Group.warps(f, 4), State), F32x8(k, Grain.thread)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, value) := Core.maskedScores(e, mask, block, c, v)
    (Machine.mk(e, state, fixed), value)
  }

  def takeProducer {m: Lifetime}{r: Lifetime}{cfg: RingCfg}(machine: Machine(m, Group.lane, Unit))(w: Elected(m))(ring: Ring(r, cfg))(p: Producer(r)): Machine(m, Group.lane, ProducerAt(r, m)) := {
    let (e, (u, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.takeProducer(e, w, ring, p)
    Machine.mk(e, state, Core.fixedProducerAt(r, m))
  }

  def takeConsumer {m: Lifetime}{r: Lifetime}{cfg: RingCfg}(machine: Machine(m, Group.lane, Unit))(w: Elected(m))(ring: Ring(r, cfg))(c: Consumer(r)): Machine(m, Group.lane, ConsumerAt(r, m)) := {
    let (e, (u, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.takeConsumer(e, w, ring, c)
    Machine.mk(e, state, Core.fixedConsumerAt(r, m))
  }

  def acquire {n: Lifetime}{r: Lifetime}{m: Lifetime}{cfg: RingCfg}(machine: Machine(n, Group.lane, ProducerAt(r, m)))(ring: Ring(r, cfg)): Machine(n, Group.lane, Slot(r, m)) := {
    let (e, (p, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.acquire(e, ring, p)
    Machine.mk(e, state, Core.fixedSlot(r, m))
  }

  def fill {n: Lifetime}{r: Lifetime}{m: Lifetime}{cfg: RingCfg}{L: Lifetime}{S0: Lifetime}{S1: Lifetime}{S2: Lifetime}{S3: Lifetime}{u0: Grain}{u1: Grain}{u2: Grain}{u3: Grain}(machine: Machine(n, Group.lane, Slot(r, m)))(ring: Ring(r, cfg))(a: TMap(L, RingCfg.a(cfg)))(a0: Val(S0, u0, DType.u32))(a1: Val(S1, u1, DType.u32))(b: TMap(L, RingCfg.b(cfg)))(b0: Val(S2, u2, DType.u32))(b1: Val(S3, u3, DType.u32)): Machine(n, Group.lane, ProducerAt(r, m)) := {
    let (e, (s, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.fill(e, ring, s, a, a0, a1, b, b0, b1)
    Machine.mk(e, state, Core.fixedProducerAt(r, m))
  }

  def fillBlock {n: Lifetime}{r: Lifetime}{m: Lifetime}{cfg: RingCfg}{L: Lifetime}{S: Lifetime}{u: Grain}(machine: Machine(n, Group.lane, Slot(r, m)))(ring: Ring(r, cfg))(map: HeadMap(L, RingCfg.a(cfg)))(row: Val(S, u, DType.u32)): Machine(n, Group.lane, ProducerAt(r, m)) := {
    let (e, (s, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.fillBlock(e, ring, s, map, row)
    Machine.mk(e, state, Core.fixedProducerAt(r, m))
  }

  def finishProducer {n: Lifetime}{r: Lifetime}{m: Lifetime}{cfg: RingCfg}(machine: Machine(n, Group.lane, ProducerAt(r, m)))(ring: Ring(r, cfg)): Machine(n, Group.lane, Unit) := {
    let (e, (p, previous)) := unpack(Key.key, machine)
    start(Key.key, Core.finishProducer(e, ring, p))
  }

  def await {n: Lifetime}{r: Lifetime}{m: Lifetime}{cfg: RingCfg}(machine: Machine(n, Group.lane, ConsumerAt(r, m)))(ring: Ring(r, cfg)): Machine(n, Group.lane, Ready(r, m)) := {
    let (e, (c, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.await(e, ring, c)
    Machine.mk(e, state, Core.fixedReady(r, m))
  }

  def finishConsumer {n: Lifetime}{r: Lifetime}{m: Lifetime}(machine: Machine(n, Group.lane, ConsumerAt(r, m))): Machine(n, Group.lane, Unit) := {
    let (e, (c, previous)) := unpack(Key.key, machine)
    start(Key.key, Core.finishConsumer(e, c))
  }

  def takeRows {m: Lifetime}{f: Nat}{x: Lifetime}{h: Rescaler}(machine: Machine(m, Group.warps(f, 4), Unit))(buf: ScoreBuffer(x, h))(side: RowSide(x))[aligned: Eq(Nat, Nat.mod(f, 4), 0)]: Machine(m, Group.warps(f, 4), RowsAt(x, m, f, OState.fresh)) := {
    let (e, (u, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.takeRows(e, buf, side)[aligned]
    Machine.mk(e, state, Core.fixedRowsAt(x, m, f, OState.fresh))
  }

  def awaitScores {k: Lifetime}{f: Nat}{x: Lifetime}{h: Rescaler}{m: Lifetime}{o: OState}(machine: Machine(k, Group.warps(f, 4), RowsAt(x, m, f, o)))(buf: ScoreBuffer(x, h)): Machine(k, Group.warps(f, 4), Scored(x, m, f, o)) := {
    let (e, (at, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.awaitScores(e, buf, at)
    Machine.mk(e, state, Core.fixedScored(x, m, f, o))
  }

  def loadRow {k: Lifetime}{f: Nat}{x: Lifetime}{h: Rescaler}{m: Lifetime}{o: OState}(machine: Machine(k, Group.warps(f, 4), Scored(x, m, f, o)))(buf: ScoreBuffer(x, h)): Pair(Machine(k, Group.warps(f, 4), Loaded(x, m, f, o)), Row(k)) := {
    let (e, (s, previous)) := unpack(Key.key, machine)
    let (e, (state, value)) := Core.loadRow(e, buf, s)
    (Machine.mk(e, state, Core.fixedLoaded(x, m, f, o)), value)
  }

  def publishAlpha {k: Lifetime}{f: Nat}{x: Lifetime}{m: Lifetime}{o: OState}{S: Lifetime}{u: Grain}(machine: Machine(k, Group.warps(f, 4), Probs(x, m, f, o)))(buf: ScoreBuffer(x, Rescaler.correction))(alpha: Val(S, u, DType.f32)): Machine(k, Group.warps(f, 4), RowsAt(x, m, f, OState.held)) := {
    let (e, (p, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.publishAlpha(e, buf, p, alpha)
    Machine.mk(e, state, Core.fixedRowsAt(x, m, f, OState.held))
  }

  def awaitFinal {k: Lifetime}{f: Nat}{x: Lifetime}{h: Rescaler}{m: Lifetime}(machine: Machine(k, Group.warps(f, 4), RowsAt(x, m, f, OState.held)))(buf: ScoreBuffer(x, h)): Machine(k, Group.warps(f, 4), Final(x, m, f)) := {
    let (e, (at, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.awaitFinal(e, buf, at)
    Machine.mk(e, state, Core.fixedFinal(x, m, f))
  }

  def storeFinal {k: Lifetime}{f: Nat}{x: Lifetime}{h: Rescaler}{m: Lifetime}{S: Lifetime}{u: Grain}{S2: Lifetime}{u2: Grain}{L: Lifetime}{t: DType}(machine: Machine(k, Group.warps(f, 4), Final(x, m, f)))(buf: ScoreBuffer(x, h))(inv: Val(S, u, DType.f32))(lse: Val(S2, u2, DType.f32))(out: AttnOut(L, t))(own: OOwn(L, t, f)): Machine(k, Group.warps(f, 4), Final(x, m, f)) := {
    let (e, (o, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.storeFinal(e, buf, o, inv, lse, out, own)
    Machine.mk(e, state, Core.fixedFinal(x, m, f))
  }

  def closeRows {k: Lifetime}{f: Nat}{x: Lifetime}{m: Lifetime}(machine: Machine(k, Group.warps(f, 4), Final(x, m, f))): Machine(k, Group.warps(f, 4), Unit) := {
    let (e, (o, previous)) := unpack(Key.key, machine)
    start(Key.key, Core.closeRows(e, o))
  }

  def takeCorrection {m: Lifetime}{f: Nat}{x: Lifetime}(machine: Machine(m, Group.warps(f, 4), Unit))(buf: ScoreBuffer(x, Rescaler.correction))(side: CorrectionSide(x))[aligned: Eq(Nat, Nat.mod(f, 4), 0)]: Machine(m, Group.warps(f, 4), CorrectAt(x, m, f, OState.fresh)) := {
    let (e, (u, previous)) := unpack(Key.key, machine)
    let (e, state) := Core.takeCorrection(e, buf, side)[aligned]
    Machine.mk(e, state, Core.fixedCorrectAt(x, m, f, OState.fresh))
  }

  def awaitAlpha {k: Lifetime}{f: Nat}{x: Lifetime}{m: Lifetime}(machine: Machine(k, Group.warps(f, 4), CorrectAt(x, m, f, OState.held)))(buf: ScoreBuffer(x, Rescaler.correction)): Pair(Machine(k, Group.warps(f, 4), Rescaling(x, m, f)), Val(k, Grain.thread, DType.f32)) := {
    let (e, (at, previous)) := unpack(Key.key, machine)
    let (e, (state, value)) := Core.awaitAlpha(e, buf, at)
    (Machine.mk(e, state, Core.fixedRescaling(x, m, f)), value)
  }

  def zeroQuadrants {k: Lifetime}{g: Group}{f: Nat}{x: Lifetime}{m: Lifetime}(machine: Machine(k, g, CorrectAt(x, m, f, OState.fresh)))(buf: ScoreBuffer(x, Rescaler.correction))[converged: Eq(Bool, Core.ownQuadrants(g, f), Bool.true)]: Machine(k, g, Rescaling(x, m, f)) := {
    let (e, (at, previous)) := unpack(Key.key, machine)
