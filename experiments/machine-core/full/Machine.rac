  def withPairRing {l: Lifetime}{w: Nat}{kx: Kind}{Sx: Lifetime}{kf: Kind}{Sf: Lifetime}(machine: Machine(l, Group.cta(w), Unit))(pair: CtaPair(l))(cfg: RingCfg)(X: Type { kind = kx, scope = Sx })(body: { kind = kf, scope = Sf } (r: Lifetime) -> PairRing(r, cfg) -> Producer(r) -> Consumer(r) -> Machine(l, Group.cta(w), Unit)
        -> Pair(Machine(l, Group.cta(w), Unit), X)): Pair(Machine(l, Group.cta(w), Unit), X) := {
    let (e, result) := Core.withPairRing(finish(Key.key, machine), pair, cfg, X, fun (r: Lifetime)(arg1: PairRing(r, cfg))(arg2: Producer(r))(arg3: Consumer(r))(arg4: Ctx(l, Group.cta(w))): Pair(Ctx(l, Group.cta(w)), X) => {
        let (machine, result) := body(r, arg1, arg2, arg3, start(Key.key, arg4))
        (finish(Key.key, machine), result)
      })
    (start(Key.key, e), result)
  }

  def withPairAccRing {l: Lifetime}{w: Nat}{a: Lifetime}{cols: Nat}{kx: Kind}{Sx: Lifetime}{kf: Kind}{Sf: Lifetime}(machine: Machine(l, Group.cta(w), Unit))(pair: CtaPair(l))(t: Tmem(a, cols))(acc: Acc(a, AccState.empty))(bufs: Nat)(n: Nat)(X: Type { kind = kx, scope = Sx })(body: { kind = kf, scope = Sf } (q: Lifetime) -> PairAccRing(q, n) -> AccProducer(q) -> AccConsumer(q) -> Machine(l, Group.cta(w), Unit)
        -> Pair(Machine(l, Group.cta(w), Unit), X)): Pair(Machine(l, Group.cta(w), Unit), Pair(Acc(a, AccState.empty), X)) := {
    let (e, result) := Core.withPairAccRing(finish(Key.key, machine), pair, t, acc, bufs, n, X, fun (q: Lifetime)(arg1: PairAccRing(q, n))(arg2: AccProducer(q))(arg3: AccConsumer(q))(arg4: Ctx(l, Group.cta(w))): Pair(Ctx(l, Group.cta(w)), X) => {
        let (machine, result) := body(q, arg1, arg2, arg3, start(Key.key, arg4))
        (finish(Key.key, machine), result)
      })
    (start(Key.key, e), result)
  }

  def correctedAttentionKernel (name: String)(causal: Bool)(t: DType)(body: (l: Lifetime) -> Machine(l, Group.cta(512), Unit) -> PairLaunch(l, TmaSpec.mk(64, 128), t) -> OOwn(l, t, 0) -> OOwn(l, t, 4)
        -> TmemPermit(l) -> Registers.RegPool(l, 512, Registers.budget(512, 1)) -> Machine(l, Group.cta(512), Unit)): Program := {
    Core.correctedAttentionKernel(name, causal, t, fun (l: Lifetime)(arg1: Ctx(l, Group.cta(512)))(arg2: PairLaunch(l, TmaSpec.mk(64, 128), t))(arg3: OOwn(l, t, 0))(arg4: OOwn(l, t, 4))(arg5: TmemPermit(l))(arg6: Registers.RegPool(l, 512, Registers.budget(512, 1))): Ctx(l, Group.cta(512)) => {
        finish(Key.key, body(l, start(Key.key, arg1), arg2, arg3, arg4, arg5, arg6))
      })
  }

  def pairGemmPersistentKernel (name: String)(sa: TmaSpec)(sb: TmaSpec)(band: Nat)(body: (l: Lifetime) -> Machine(l, Group.cta(256), Unit) -> TmaGemm(l, sa, sb) -> PairSched(l, Nat.mul(2, TmaSpec.outer(sb)))
        -> PairSchedOwn(l, Nat.mul(2, TmaSpec.outer(sb))) -> CtaPair(l) -> TmemPermit(l) -> Machine(l, Group.cta(256), Unit)): Program := {
    Core.pairGemmPersistentKernel(name, sa, sb, band, fun (l: Lifetime)(arg1: Ctx(l, Group.cta(256)))(arg2: TmaGemm(l, sa, sb))(arg3: PairSched(l, Nat.mul(2, TmaSpec.outer(sb))))(arg4: PairSchedOwn(l, Nat.mul(2, TmaSpec.outer(sb))))(arg5: CtaPair(l))(arg6: TmemPermit(l)): Ctx(l, Group.cta(256)) => {
        finish(Key.key, body(l, start(Key.key, arg1), arg2, arg3, arg4, arg5, arg6))
      })
  }
  def holdStage {n: Lifetime}{g: Group}{r: Lifetime}{m: Lifetime}(machine: Machine(n, g, Ready(r, m))): Machine(n, g, ReadyUsed(r, m)) := {
    let (e, (ready, f)) := unpack(Key.key, machine)
    Machine.mk(e, Core.holdStage(ready), fixedReadyUsed(r, m))
  }
  def elect {l: Lifetime}{f: Nat}{kf: Kind}{Sf: Lifetime}(machine: Machine(l, Group.warps(f, 1), Unit))
      (body: { kind = kf, scope = Sf } (m: Lifetime) -> Elected(m) -> Machine(m, Group.lane, Unit) -> Machine(m, Group.lane, Unit))
      : Machine(l, Group.warps(f, 1), Unit) := {
    let (e, u) := Core.elect(finish(Key.key, machine), Unit,
      fun (m: Lifetime)(w: Elected(m))(e: Ctx(m, Group.lane)): Pair(Ctx(m, Group.lane), Unit) =>
        (finish(Key.key, body(m, w, start(Key.key, e))), Unit.unit))
    start(Key.key, e)
  }
  def leaderIssue {l: Lifetime}{g: Group}{L: Lifetime}{r: Lifetime}{cfg: RingCfg}{q: Lifetime}{cols: Nat}{Sf: Lifetime}
      (machine: Machine(l, g, Unit))(pair: CtaPair(L))(ring: PairRing(r, cfg))(accs: PairAccRing(q, cols))(consumer: Consumer(r))(producer: AccProducer(q))
      (body: { scope = Sf } (n: Lifetime) -> Leader(n) -> Machine(n, g, Unit) -> Consumer(r) -> AccProducer(q) -> Machine(n, g, Unit))
      : Machine(l, g, Unit) := {
    let state := (consumer, producer)
    let e := Core.onLeader(finish(Key.key, machine), pair, leaderOnlyPair(leaderOnlyConsumer(ring), leaderOnlyAccProducer(accs)), state,
      fun (n: Lifetime)(lead: Leader(n))(e: Ctx(n, g))(state: Pair(Consumer(r), AccProducer(q))): Ctx(n, g) => {
        let (consumer, producer) := state
        finish(Key.key, body(n, lead, start(Key.key, e), consumer, producer))
      })
    start(Key.key, e)
  }
  def forPairTiles {l: Lifetime}{L: Lifetime}{g: Group}{w: Nat}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}{Sf: Lifetime}
      (machine: Machine(l, g, S))(sched: PairSched(L, w))
      (body: { scope = Sf } (n: Lifetime) -> PairTile(n, w) -> Machine(n, g, S) -> Machine(n, g, S)): Machine(l, g, S) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, state) := Core.forPairTiles(e, sched, fixed, state,
      fun (n: Lifetime)(tile: PairTile(n, w))(e: Ctx(n, g))(state: S): Pair(Ctx(n, g), S) => {
        let (e, (state, f)) := unpack(Key.key, body(n, tile, Machine.mk(e, state, fixed)))
        (e, state)
      })
    Machine.mk(e, state, fixed)
  }
  def forOwnedPairTiles {l: Lifetime}{L: Lifetime}{g: Group}{w: Nat}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}{Sf: Lifetime}
      (machine: Machine(l, g, S))(sched: PairSched(L, w))(own: PairSchedOwn(L, w))
      (body: { scope = Sf } (n: Lifetime) -> PairTile(n, w) -> HalfOwn(n) -> Machine(n, g, S) -> Machine(n, g, S)): Machine(l, g, S) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, state) := Core.forOwnedPairTiles(e, sched, own, fixed, state,
      fun (n: Lifetime)(tile: PairTile(n, w))(own: HalfOwn(n))(e: Ctx(n, g))(state: S): Pair(Ctx(n, g), S) => {
        let (e, (state, f)) := unpack(Key.key, body(n, tile, own, Machine.mk(e, state, fixed)))
        (e, state)
      })
    Machine.mk(e, state, fixed)
  }
  def forHalfChunks {l: Lifetime}{j: Lifetime}{g: Group}{w: Nat}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}{Sf: Lifetime}
      (machine: Machine(l, g, S))(tile: PairTile(j, w))(own: HalfOwn(j))
      (body: { scope = Sf } (n: Lifetime) -> ChunkAt(n, w) -> ChunkOwn(n, w) -> Machine(n, g, S) -> Machine(n, g, S)): Machine(l, g, S) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, state) := Core.forHalfChunks(e, tile, own, fixed, state,
      fun (n: Lifetime)(chunk: ChunkAt(n, w))(own: ChunkOwn(n, w))(e: Ctx(n, g))(state: S): Pair(Ctx(n, g), S) => {
        let (e, (state, f)) := unpack(Key.key, body(n, chunk, own, Machine.mk(e, state, fixed)))
        (e, state)
      })
    Machine.mk(e, state, fixed)
  }
  def mapRow {l: Lifetime}{g: Group}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}{Sf: Lifetime}
      (machine: Machine(l, g, S))(row: Row(l))
      (body: { scope = Sf } Nat -> F32x8(l, Grain.thread) -> Machine(l, g, Unit) -> Pair(Machine(l, g, Unit), F32x8(l, Grain.thread)))
      : Pair(Machine(l, g, S), Row(l)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, row) := Core.mapRow(e, row,
      fun (c: Nat)(values: F32x8(l, Grain.thread))(e: Ctx(l, g)): Pair(Ctx(l, g), F32x8(l, Grain.thread)) => {
        let (machine, values) := body(c, values, start(Key.key, e))
        (finish(Key.key, machine), values)
      })
    (Machine.mk(e, state, fixed), row)
  }
  def writeProbs {l: Lifetime}{f: Nat}{x: Lifetime}{h: Rescaler}{m: Lifetime}{o: OState}{S: Lifetime}{u: Grain}{Sf: Lifetime}
      (machine: Machine(l, Group.warps(f, 4), Loaded(x, m, f, o)))(buffer: ScoreBuffer(x, h))(row: Row(l))
      (body: { scope = Sf } Nat -> F32x8(l, Grain.thread) -> Machine(l, Group.warps(f, 4), Unit) -> Pair(Machine(l, Group.warps(f, 4), Unit), F32x8(S, u)))
      : Machine(l, Group.warps(f, 4), Probs(x, m, f, o)) := {
    let (e, (state, fixed)) := unpack(Key.key, machine)
    let (e, state) := Core.writeProbs(e, buffer, state, row,
      fun (c: Nat)(values: F32x8(l, Grain.thread))(e: Ctx(l, Group.warps(f, 4))): Pair(Ctx(l, Group.warps(f, 4)), F32x8(S, u)) => {
        let (machine, values) := body(c, values, start(Key.key, e))
        (finish(Key.key, machine), values)
      })
    Machine.mk(e, state, Core.fixedProbs(x, m, f, o))
  }
  def roles4 {l: Lifetime}{k0: Kind}{S0: Lifetime}{k1: Kind}{S1: Lifetime}{k2: Kind}{S2: Lifetime}
      (machine: Machine(l, Layout.Cta, Unit))
      (load: { kind = k0, scope = S0 } (m: Lifetime) -> Machine(m, Layout.Load, Unit) -> Machine(m, Layout.Load, Unit))
      (issue: { kind = k1, scope = S1 } (m: Lifetime) -> Machine(m, Layout.Issue, Unit) -> Machine(m, Layout.Issue, Unit))
      (store: { kind = k2, scope = S2 } (m: Lifetime) -> Machine(m, Layout.Wg, Unit) -> Machine(m, Layout.Wg, Unit)): Machine(l, Layout.Cta, Unit) := {
    let (e, u) := Layout.roles4(finish(Key.key, machine), Unit,
      fun (m: Lifetime)(e: Ctx(m, Layout.Load)): Pair(Ctx(m, Layout.Load), Unit) => (finish(Key.key, load(m, start(Key.key, e))), Unit.unit),
      fun (m: Lifetime)(e: Ctx(m, Layout.Issue)): Pair(Ctx(m, Layout.Issue), Unit) => (finish(Key.key, issue(m, start(Key.key, e))), Unit.unit),
      fun (m: Lifetime)(e: Ctx(m, Layout.Wg)): Pair(Ctx(m, Layout.Wg), Unit) => (finish(Key.key, store(m, start(Key.key, e))), Unit.unit))
    start(Key.key, e)
  }
  def rolesCorrected {l: Lifetime}{k0: Kind}{S0: Lifetime}{k1: Kind}{S1: Lifetime}{k2: Kind}{S2: Lifetime}{k3: Kind}{S3: Lifetime}{k4: Kind}{S4: Lifetime}
      (machine: Machine(l, Layout.CorrectedCta, Unit))(regs: Registers.RegPool(l, 512, 128))
      (group0: { kind = k0, scope = S0 } (m: Lifetime) -> Machine(m, Group.warps(0, 4), Unit) -> Machine(m, Group.warps(0, 4), Unit))
      (group1: { kind = k1, scope = S1 } (m: Lifetime) -> Machine(m, Group.warps(4, 4), Unit) -> Machine(m, Group.warps(4, 4), Unit))
      (correct: { kind = k2, scope = S2 } (m: Lifetime) -> Machine(m, Group.warps(8, 4), Unit) -> Machine(m, Group.warps(8, 4), Unit))
      (issue: { kind = k3, scope = S3 } (m: Lifetime) -> Machine(m, Layout.CorrectedIssue, Unit) -> Machine(m, Layout.CorrectedIssue, Unit))
      (load: { kind = k4, scope = S4 } (m: Lifetime) -> Machine(m, Layout.CorrectedLoad, Unit) -> Machine(m, Layout.CorrectedLoad, Unit)): Machine(l, Layout.CorrectedCta, Unit) :=
    start(Key.key, Layout.rolesCorrected(finish(Key.key, machine), regs,
      fun (m: Lifetime)(e: Ctx(m, Group.warps(0, 4))): Pair(Ctx(m, Group.warps(0, 4)), Unit) => (finish(Key.key, group0(m, start(Key.key, e))), Unit.unit),
      fun (m: Lifetime)(e: Ctx(m, Group.warps(4, 4))): Pair(Ctx(m, Group.warps(4, 4)), Unit) => (finish(Key.key, group1(m, start(Key.key, e))), Unit.unit),
      fun (m: Lifetime)(e: Ctx(m, Group.warps(8, 4))): Pair(Ctx(m, Group.warps(8, 4)), Unit) => (finish(Key.key, correct(m, start(Key.key, e))), Unit.unit),
      fun (m: Lifetime)(e: Ctx(m, Layout.CorrectedIssue)): Pair(Ctx(m, Layout.CorrectedIssue), Unit) => (finish(Key.key, issue(m, start(Key.key, e))), Unit.unit),
      fun (m: Lifetime)(e: Ctx(m, Layout.CorrectedLoad)): Pair(Ctx(m, Layout.CorrectedLoad), Unit) => (finish(Key.key, load(m, start(Key.key, e))), Unit.unit)))
}
