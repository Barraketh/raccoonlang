// expect: TypeMismatch
import Machine
namespace Rejected {
  open Core
  open Cuda
  open GpuMachine.{Machine, Ticket}
  def bad {l: Lifetime}{L: Lifetime}{r: Lifetime}{cfg: RingCfg}{q: Lifetime}{s: Lifetime}{m: Lifetime}{Sf: Lifetime}
      (machine: Machine(l, Group.warps(4, 4), Unit))(pair: CtaPair(L))(ring: PairRing(r, cfg))(accs: PairAccRing(q, 256))
      (consumer: Consumer(r))(producer: AccProducer(q))(store: Ticket(StoreAt(s, m, 4)))(staging: Staging(s))
      (body: { scope = Sf } (n: Lifetime) -> Leader(n) -> Machine(n, Group.warps(4, 4), Unit) -> Consumer(r) -> AccProducer(q) -> Machine(n, Group.warps(4, 4), Unit))
      : Machine(l, Group.warps(4, 4), Unit) :=
    GpuMachine.leaderIssue(machine, pair, ring, accs, consumer, producer,
      fun (n: Lifetime)(lead: Leader(n))(inner: Machine(n, Group.warps(4, 4), Unit))(c: Consumer(r))(p: AccProducer(q)): Machine(n, Group.warps(4, 4), Unit) => {
        let inner := body(n, lead, inner, c, p)
        GpuMachine.finishStores(GpuMachine.use(inner, store), staging)
      })
}
