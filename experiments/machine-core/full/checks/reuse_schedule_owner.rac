// expect: LinearReused
import Machine
namespace Rejected {
  open Core
  open Cuda
  open GpuMachine.{Machine, Ticket}
  def bad {l: Lifetime}{L: Lifetime}{Sf: Lifetime}(a: Machine(l, Group.warps(4, 4), Unit))(b: Machine(l, Group.warps(4, 4), Unit))
      (sched: PairSched(L, 256))(owner: PairSchedOwn(L, 256))
      (body: { scope = Sf } (n: Lifetime) -> PairTile(n, 256) -> HalfOwn(n) -> Machine(n, Group.warps(4, 4), Unit) -> Machine(n, Group.warps(4, 4), Unit))
      : Pair(Machine(l, Group.warps(4, 4), Unit), Machine(l, Group.warps(4, 4), Unit)) :=
    (GpuMachine.forOwnedPairTiles(a, sched, owner, body), GpuMachine.forOwnedPairTiles(b, sched, owner, body))
}
