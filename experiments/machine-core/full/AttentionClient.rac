import Machine
import encoding.Layout

namespace LunaAttention {
  open Cuda
  open Core

  def box: TmaSpec := TmaSpec.mk(64, 128)
  def qRing: RingCfg := RingCfg.mk(1, box, box)
  def kRing: RingCfg := RingCfg.mk(2, box, box)
  def vRing: RingCfg := RingCfg.mk(2, box, box)
  def lowestFinite: Nat := 4286578687
  def ln2: Nat := 1060205080
  def Launch (l: Lifetime)(t: DType): Type { scope = l } := Core.PairLaunch(l, box, t)
  def lagBits: Nat := 1090519040
  def oneBits: Nat := 1065353216

  def scores {n: Lifetime}{f: Nat}{L: Lifetime}{Sb: Lifetime}{Sc: Lifetime}{Ss: Lifetime}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T }}
      (machine: GpuMachine.Machine(n, Group.warps(f, 4), S))(mask: Mask(L))(block: Val(Sb, Grain.uniform, DType.u32))
      (scale: Val(Sc, Grain.uniform, DType.f32))(c: Nat)(v: F32x8(Ss, Grain.thread))
      : Pair(GpuMachine.Machine(n, Group.warps(f, 4), S), F32x8(n, Grain.thread)) :=
    GpuMachine.maskedScores(machine, mask, block, c, F32x8.mk(fmul(scale, v.v0), fmul(scale, v.v1), fmul(scale, v.v2), fmul(scale, v.v3),
      fmul(scale, v.v4), fmul(scale, v.v5), fmul(scale, v.v6), fmul(scale, v.v7)))

  def raiseMax {n: Lifetime}{g: Group}{Sm: Lifetime}{St: Lifetime}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T}}
      (machine: GpuMachine.Machine(n, g, S))(mx: Reg(Sm, DType.f32))(t: F32x8(St, Grain.thread)): GpuMachine.Machine(n, g, S) := {
    let (machine, old) := GpuMachine.get(machine, mx)
    let m01 := fmax(t.v0, t.v1)
    let m23 := fmax(t.v2, t.v3)
    let m45 := fmax(t.v4, t.v5)
    let m67 := fmax(t.v6, t.v7)
    GpuMachine.set(machine, mx, fmax(old, fmax(fmax(m01, m23), fmax(m45, m67))))
  }

  def lagMax {n: Lifetime}{g: Group}{Sm: Lifetime}{So: Lifetime}{Sl: Lifetime}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T}}
      (machine: GpuMachine.Machine(n, g, S))(mx: Reg(Sm, DType.f32))(old: Val(So, Grain.thread, DType.f32))(lag: Val(Sl, Grain.uniform, DType.f32)): GpuMachine.Machine(n, g, S) := {
    let (machine, raised) := GpuMachine.get(machine, mx)
    GpuMachine.set(machine, mx, select(Core.lt(lag, fsub(raised, old)), raised, old))
  }

  def exp2 {n: Lifetime}{g: Group}{S: Lifetime}{u: Grain}{k: Kind}{T: Lifetime}{State: Type { kind = k, scope = T}}
      (machine: GpuMachine.Machine(n, g, State))(emulate: Bool)(x: Val(S, u, DType.f32)): Pair(GpuMachine.Machine(n, g, State), Val(n, u, DType.f32)) :=
    match emulate returning Pair(GpuMachine.Machine(n, g, State), Val(n, u, DType.f32)) with
    | Bool.true => GpuMachine.ex2emu(machine, x)
    | Bool.false => GpuMachine.ex2(machine, x)

  def emulated (c: Nat)(j: Nat): Bool :=
    Bool.and(Bool.and(Nat.ble(5, c), Nat.ble(c, 11)), Bool.and(Nat.beq(Nat.mod(c, 2), 1), Nat.ble(4, j)))

  def exps {n: Lifetime}{g: Group}{Ss: Lifetime}{Sm: Lifetime}{St: Lifetime}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T}}
      (machine: GpuMachine.Machine(n, g, S))(sum: Reg(Ss, DType.f32))(mx: Val(Sm, Grain.thread, DType.f32))(c: Nat)(t: F32x8(St, Grain.thread))
      : Pair(GpuMachine.Machine(n, g, S), F32x8(n, Grain.thread)) := {
    let (machine, p0) := exp2(machine, emulated(c, 0), fsub(t.v0, mx))
    let (machine, p1) := exp2(machine, emulated(c, 1), fsub(t.v1, mx))
    let (machine, p2) := exp2(machine, emulated(c, 2), fsub(t.v2, mx))
    let (machine, p3) := exp2(machine, emulated(c, 3), fsub(t.v3, mx))
    let (machine, p4) := exp2(machine, emulated(c, 4), fsub(t.v4, mx))
    let (machine, p5) := exp2(machine, emulated(c, 5), fsub(t.v5, mx))
    let (machine, p6) := exp2(machine, emulated(c, 6), fsub(t.v6, mx))
    let (machine, p7) := exp2(machine, emulated(c, 7), fsub(t.v7, mx))
    let (machine, old) := GpuMachine.get(machine, sum)
    let machine := GpuMachine.set(machine, sum, fadd(old, fadd(fadd(fadd(p0, p1), fadd(p2, p3)), fadd(fadd(p4, p5), fadd(p6, p7)))))
    (machine, F32x8.mk(p0, p1, p2, p3, p4, p5, p6, p7))
  }

  def usable {n: Lifetime}{g: Group}{Sl: Lifetime}{Sm: Lifetime}{k: Kind}{T: Lifetime}{S: Type { kind = k, scope = T}}
      (machine: GpuMachine.Machine(n, g, S))(lowest: Val(Sl, Grain.uniform, DType.f32))(mx: Reg(Sm, DType.f32))
      : Pair(GpuMachine.Machine(n, g, S), Val(n, Grain.thread, DType.f32)) := {
    let (machine, m) := GpuMachine.get(machine, mx)
    let (machine, use) := GpuMachine.reg(machine, select(Core.lt(m, lowest), zero(DType.f32), m))
    GpuMachine.get(machine, use)
  }

  def softmax {L: Lifetime}{t: DType}{x: Lifetime}{f: Nat}(blocks: Val(L, Grain.uniform, DType.u32))(mask: Mask(L))
      (scale: Val(L, Grain.uniform, DType.f32))(out: AttnOut(L, t))(own: OOwn(L, t, f))(buf: ScoreBuffer(x, Rescaler.correction))
      (side: RowSide(x))(m: Lifetime)(machine: GpuMachine.Machine(m, Group.warps(f, 4), Unit))[aligned: Eq(Nat, Nat.mod(f, 4), 0)]: GpuMachine.Machine(m, Group.warps(f, 4), Unit) := {
    let (machine, minusInfinity) := GpuMachine.fconst(machine, Core.minusInfinityBits)
    let (machine, mReg) := GpuMachine.reg(machine, minusInfinity)
    let (machine, lReg) := GpuMachine.reg(machine, zero(DType.f32))
    let (machine, lowest) := GpuMachine.fconst(machine, lowestFinite)
    let (machine, lag) := GpuMachine.fconst(machine, lagBits)
    let block := fun {o: OState}(n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(machine: GpuMachine.Machine(n, Group.warps(f, 4), RowsAt(x, m, f, o)))
        : GpuMachine.Machine(n, Group.warps(f, 4), RowsAt(x, m, f, OState.held)) => {
      let machine := GpuMachine.awaitScores(machine, buf)
      let (loaded, row) := GpuMachine.loadRow(machine, buf)
      let (machine, mOld) := GpuMachine.get(loaded, mReg)
      let (machine, row)  := GpuMachine.mapRow(machine, row, fun (c: Nat)(s: F32x8(n, Grain.thread))(machine: GpuMachine.Machine(n, Group.warps(f, 4), Unit))
          : Pair(GpuMachine.Machine(n, Group.warps(f, 4), Unit), F32x8(n, Grain.thread)) => {
        let (machine, t) := scores(machine, mask, i, scale, c, s)
        (raiseMax(machine, mReg, t), t)
      })
      let machine := lagMax(machine, mReg, mOld, lag)
      let (machine, mNew) := usable(machine, lowest, mReg)
      let (machine, sum) := GpuMachine.reg(machine, zero(DType.f32))
      let machine := GpuMachine.writeProbs(machine, buf, row, fun (c: Nat)(t: F32x8(n, Grain.thread))(machine: GpuMachine.Machine(n, Group.warps(f, 4), Unit))
          : Pair(GpuMachine.Machine(n, Group.warps(f, 4), Unit), F32x8(n, Grain.thread)) => exps(machine, sum, mNew, c, t))
      let (machine, alpha) := GpuMachine.ex2(machine, fsub(mOld, mNew))
      let machine := GpuMachine.publishAlpha(machine, buf, alpha)
      let (machine, s) := GpuMachine.get(machine, sum)
      let (machine, lOld) := GpuMachine.get(machine, lReg)
      GpuMachine.set(machine, lReg, fma(alpha, lOld, s))
    }
    let first := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(machine: GpuMachine.Machine(n, Group.warps(f, 4), RowsAt(x, m, f, OState.fresh)))
        : GpuMachine.Machine(n, Group.warps(f, 4), RowsAt(x, m, f, OState.held)) => block(n, i, machine)
    let rest := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(machine: GpuMachine.Machine(n, Group.warps(f, 4), RowsAt(x, m, f, OState.held)))
        : GpuMachine.Machine(n, Group.warps(f, 4), RowsAt(x, m, f, OState.held)) => block(n, i, machine)
    let machine := GpuMachine.takeRows(machine, buf, side)[aligned]
    let machine := GpuMachine.peeled(machine, RowsAt(x, m, f, OState.held), blocks, first, rest)
    let machine := GpuMachine.awaitFinal(machine, buf)
    let (machine, lSum) := GpuMachine.get(machine, lReg)
    let (machine, mMax) := GpuMachine.get(machine, mReg)
    let (machine, inv) := GpuMachine.rcp(machine, lSum)
    let (machine, logSum) := GpuMachine.lg2(machine, lSum)
    let (machine, ln2) := GpuMachine.fconst(machine, ln2)
    let machine := GpuMachine.storeFinal(machine, buf, inv, fmul(fadd(mMax, logSum), ln2), out, own)
    GpuMachine.closeRows(machine)
  }

  def QueryProducers (q0: Lifetime)(q1: Lifetime)(j: Lifetime): Type { kind = lin, scope = Lifetime.union(q0, Lifetime.union(q1, j)) } :=
    Pair(ProducerAt(q0, j), ProducerAt(q1, j))
  def KvProducers (k: Lifetime)(v: Lifetime)(j: Lifetime): Type { kind = lin, scope = Lifetime.union(k, Lifetime.union(v, j)) } :=
    Pair(ProducerAt(k, j), ProducerAt(v, j))
  def ProducerWork (q0: Lifetime)(q1: Lifetime)(k: Lifetime)(v: Lifetime)(j: Lifetime)
      : Type { kind = lin, scope = Lifetime.union(q0, Lifetime.union(q1, Lifetime.union(k, Lifetime.union(v, j)))) } :=
    Pair(QueryProducers(q0, q1, j), KvProducers(k, v, j))

  def producer {l: Lifetime}{t: DType}{q0: Lifetime}{q1: Lifetime}{k: Lifetime}{v: Lifetime}(g: Launch(l, t))
      (q0r: Ring(q0, qRing))(q1r: Ring(q1, qRing))(kr: Ring(k, kRing))(vr: Ring(v, vRing))
      (pq0: Producer(q0))(pq1: Producer(q1))(pk: Producer(k))(pv: Producer(v))(m: Lifetime)
      (machine: GpuMachine.Machine(m, Layout.CorrectedLoad, Unit)): GpuMachine.Machine(m, Layout.CorrectedLoad, Unit) :=
    GpuMachine.elect(machine, fun (j: Lifetime)(w: Elected(j))(lane: GpuMachine.Machine(j, Group.lane, Unit))
        : GpuMachine.Machine(j, Group.lane, Unit) => {
      let q0p := GpuMachine.takeProducer(lane, w, q0r, pq0)
      let (empty, q0ticket) := GpuMachine.park(q0p)
      let q1p := GpuMachine.takeProducer(empty, w, q1r, pq1)
      let (empty, q1ticket) := GpuMachine.park(q1p)
      let kp := GpuMachine.takeProducer(empty, w, kr, pk)
      let (empty, kticket) := GpuMachine.park(kp)
      let vp := GpuMachine.takeProducer(empty, w, vr, pv)
      let (empty, vticket) := GpuMachine.park(vp)
      let machine := GpuMachine.use(empty, GpuMachine.pairTickets(GpuMachine.pairTickets(q0ticket, q1ticket), GpuMachine.pairTickets(kticket, vticket)))
      let machine := GpuMachine.focusLeft(machine, fun (queries: GpuMachine.Machine(j, Group.lane, QueryProducers(q0, q1, j)))
          : GpuMachine.Machine(j, Group.lane, QueryProducers(q0, q1, j)) =>
        GpuMachine.focusLeft(queries, fun (q0p: GpuMachine.Machine(j, Group.lane, ProducerAt(q0, j)))
            : GpuMachine.Machine(j, Group.lane, ProducerAt(q0, j)) =>
          GpuMachine.fillBlock(GpuMachine.acquire(q0p, q0r), q0r, g.q, g.q0)))
      let machine := GpuMachine.focusLeft(machine, fun (queries: GpuMachine.Machine(j, Group.lane, QueryProducers(q0, q1, j)))
          : GpuMachine.Machine(j, Group.lane, QueryProducers(q0, q1, j)) =>
        GpuMachine.focusRight(queries, fun (q1p: GpuMachine.Machine(j, Group.lane, ProducerAt(q1, j)))
            : GpuMachine.Machine(j, Group.lane, ProducerAt(q1, j)) =>
          GpuMachine.fillBlock(GpuMachine.acquire(q1p, q1r), q1r, g.q, g.q1)))
      let machine := GpuMachine.repeat(machine, g.blocks, fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))
          (machine: GpuMachine.Machine(n, Group.lane, ProducerWork(q0, q1, k, v, j))): GpuMachine.Machine(n, Group.lane, ProducerWork(q0, q1, k, v, j)) => {
        let row := mulC(i, 128)
        GpuMachine.focusRight(machine, fun (kv: GpuMachine.Machine(n, Group.lane, KvProducers(k, v, j)))
            : GpuMachine.Machine(n, Group.lane, KvProducers(k, v, j)) => {
          let kv := GpuMachine.focusLeft(kv, fun (kp: GpuMachine.Machine(n, Group.lane, ProducerAt(k, j)))
              : GpuMachine.Machine(n, Group.lane, ProducerAt(k, j)) =>
            GpuMachine.fillBlock(GpuMachine.acquire(kp, kr), kr, g.k, row))
          GpuMachine.focusRight(kv, fun (vp: GpuMachine.Machine(n, Group.lane, ProducerAt(v, j)))
              : GpuMachine.Machine(n, Group.lane, ProducerAt(v, j)) =>
            GpuMachine.fillBlock(GpuMachine.acquire(vp, vr), vr, g.v, row))
        })
      })
      let machine := GpuMachine.focusLeft(machine, fun (queries: GpuMachine.Machine(j, Group.lane, QueryProducers(q0, q1, j)))
          : GpuMachine.Machine(j, Group.lane, ProducerAt(q1, j)) => {
        let queries := GpuMachine.focusLeft(queries, fun (q0p: GpuMachine.Machine(j, Group.lane, ProducerAt(q0, j)))
            : GpuMachine.Machine(j, Group.lane, Unit) => GpuMachine.finishProducer(q0p, q0r))
        GpuMachine.dropUnitLeft(queries)
      })
      let machine := GpuMachine.focusLeft(machine, fun (q1p: GpuMachine.Machine(j, Group.lane, ProducerAt(q1, j)))
          : GpuMachine.Machine(j, Group.lane, Unit) => GpuMachine.finishProducer(q1p, q1r))
      let machine := GpuMachine.dropUnitLeft(machine)
      let machine := GpuMachine.focusLeft(machine, fun (kp: GpuMachine.Machine(j, Group.lane, ProducerAt(k, j)))
          : GpuMachine.Machine(j, Group.lane, Unit) => GpuMachine.finishProducer(kp, kr))
      let machine := GpuMachine.dropUnitLeft(machine)
      GpuMachine.finishProducer(machine, vr)
    })

  def PairIssuing (rq0: Lifetime)(rq1: Lifetime)(rk: Lifetime)(rv: Lifetime)(x0: Lifetime)(x1: Lifetime)(j: Lifetime)
      : Type { kind = lin, scope = Lifetime.union(rq0, Lifetime.union(rq1, Lifetime.union(rk, Lifetime.union(rv, Lifetime.union(x0, Lifetime.union(x1, j)))))) } :=
    Pair(Pair(ReadyUsed(rq0, j), ReadyUsed(rq1, j)), Pair(Pair(ConsumerAt(rk, j), ConsumerAt(rv, j)), Pair(MmaAt(x0, j), MmaAt(x1, j))))

  def hold {n: Lifetime}{r: Lifetime}{j: Lifetime}{cfg: RingCfg}
      (machine: GpuMachine.Machine(n, Group.lane, ConsumerAt(r, j)))(ring: Ring(r, cfg))
      : GpuMachine.Machine(n, Group.lane, ReadyUsed(r, j)) := GpuMachine.holdStage(GpuMachine.await(machine, ring))

  def scoreIssue {n: Lifetime}{j: Lifetime}{x: Lifetime}{rq: Lifetime}{rk: Lifetime}{h: Rescaler}
      (machine: GpuMachine.Machine(n, Group.lane, Pair(Holding(x, j), Pair(ReadyUsed(rq, j), ReadyUsed(rk, j)))))
      (w: Elected(j))(buf: ScoreBuffer(x, h))(qr: Ring(rq, qRing))(kr: Ring(rk, kRing))
      : GpuMachine.Machine(n, Group.lane, Pair(MmaAt(x, j), Pair(ReadyUsed(rq, j), ReadyUsed(rk, j)))) := {
    let machine := GpuMachine.issueScores(machine, w, buf, qr, kr)
    GpuMachine.focusLeft(machine, fun (s: GpuMachine.Machine(n, Group.lane, Holding(x, j)))
        : GpuMachine.Machine(n, Group.lane, MmaAt(x, j)) => GpuMachine.commitBuffer(s, w, buf))
  }

  def valueIssue {n: Lifetime}{j: Lifetime}{x: Lifetime}{rv: Lifetime}{h: Rescaler}
      (machine: GpuMachine.Machine(n, Group.lane, Pair(MmaAt(x, j), ReadyUsed(rv, j))))(w: Elected(j))
      (buf: ScoreBuffer(x, h))(vr: Ring(rv, vRing))
      : GpuMachine.Machine(n, Group.lane, Pair(Holding(x, j), ReadyUsed(rv, j))) := {
    let machine := GpuMachine.focusLeft(machine, fun (s: GpuMachine.Machine(n, Group.lane, MmaAt(x, j)))
        : GpuMachine.Machine(n, Group.lane, Published(x, j)) => GpuMachine.awaitProbs(s, buf))
    GpuMachine.issuePV(machine, w, buf, vr)
  }

  def pairIssuer {L: Lifetime}{rq0: Lifetime}{rq1: Lifetime}{rk: Lifetime}{rv: Lifetime}{x0: Lifetime}{x1: Lifetime}
      (blocks: Val(L, Grain.uniform, DType.u32))(q0r: Ring(rq0, qRing))(q1r: Ring(rq1, qRing))(kr: Ring(rk, kRing))(vr: Ring(rv, vRing))
      (b0: ScoreBuffer(x0, Rescaler.correction))(b1: ScoreBuffer(x1, Rescaler.correction))
      (cq0: Consumer(rq0))(cq1: Consumer(rq1))(ck: Consumer(rk))(cv: Consumer(rv))
      (s0: MmaSide(x0))(s1: MmaSide(x1))(m: Lifetime)(machine: GpuMachine.Machine(m, Layout.CorrectedIssue, Unit))
      : GpuMachine.Machine(m, Layout.CorrectedIssue, Unit) :=
    GpuMachine.elect(machine, fun (j: Lifetime)(w: Elected(j))(lane: GpuMachine.Machine(j, Group.lane, Unit))
        : GpuMachine.Machine(j, Group.lane, Unit) => {
      let q0 := GpuMachine.takeConsumer(lane, w, q0r, cq0)
      let (empty, q0t) := GpuMachine.park(q0)
      let q1 := GpuMachine.takeConsumer(empty, w, q1r, cq1)
      let (empty, q1t) := GpuMachine.park(q1)
      let k := GpuMachine.takeConsumer(empty, w, kr, ck)
      let (empty, kt) := GpuMachine.park(k)
      let v := GpuMachine.takeConsumer(empty, w, vr, cv)
      let (empty, vt) := GpuMachine.park(v)
      let s0 := GpuMachine.takeMma(empty, w, b0, s0)
      let (empty, s0t) := GpuMachine.park(s0)
      let s1 := GpuMachine.takeMma(empty, w, b1, s1)
      let (empty, s1t) := GpuMachine.park(s1)

      // Initial block: S0 then S1; K stays acquired across both score MMAs.
      let q0 := hold(GpuMachine.use(empty, q0t), q0r)
      let (empty, q0t) := GpuMachine.park(q0)
      let k := hold(GpuMachine.use(empty, kt), kr)
      let (empty, kt) := GpuMachine.park(k)
      let active := GpuMachine.use(empty, GpuMachine.pairTickets(s0t, GpuMachine.pairTickets(q0t, kt)))
      let active := scoreIssue(active, w, b0, q0r, kr)
      let (empty, activeT) := GpuMachine.park(active)
      let (s0t, qkT) := GpuMachine.splitTicket(activeT)
      let (q0t, kt) := GpuMachine.splitTicket(qkT)
      let q1 := hold(GpuMachine.use(empty, q1t), q1r)
      let (empty, q1t) := GpuMachine.park(q1)
      let active := GpuMachine.use(empty, GpuMachine.pairTickets(s1t, GpuMachine.pairTickets(q1t, kt)))
      let active := scoreIssue(active, w, b1, q1r, kr)
      let (empty, activeT) := GpuMachine.park(active)
      let (s1t, qkT) := GpuMachine.splitTicket(activeT)
      let (q1t, kt) := GpuMachine.splitTicket(qkT)
      let k := GpuMachine.releaseByMma(GpuMachine.use(empty, kt), w, kr)
      let (empty, kt) := GpuMachine.park(k)
      let checkpoint := GpuMachine.use(empty,
        GpuMachine.pairTickets(GpuMachine.pairTickets(q0t, q1t),
          GpuMachine.pairTickets(GpuMachine.pairTickets(kt, vt), GpuMachine.pairTickets(s0t, s1t))))

      // Later key blocks overlap the previous product with the next score issue.
      let loop := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))
          (state: GpuMachine.Machine(n, Group.lane, PairIssuing(rq0, rq1, rk, rv, x0, x1, j)))
          : GpuMachine.Machine(n, Group.lane, PairIssuing(rq0, rq1, rk, rv, x0, x1, j)) => {
        let (qPair, restT) := GpuMachine.split(state)
        let (q0, q1t) := GpuMachine.split(qPair)
        let (empty, q0t) := GpuMachine.park(q0)
        let (consumerT, mmaT) := GpuMachine.splitTicket(restT)
        let (kt, vt) := GpuMachine.splitTicket(consumerT)
        let (s0t, s1t) := GpuMachine.splitTicket(mmaT)
        let v := hold(GpuMachine.use(empty, vt), vr)
        let (empty, vt) := GpuMachine.park(v)
        let active := valueIssue(GpuMachine.use(empty, GpuMachine.pairTickets(s0t, vt)), w, b0, vr)
        let (empty, activeT) := GpuMachine.park(active)
        let (s0t, vt) := GpuMachine.splitTicket(activeT)
        let k := hold(GpuMachine.use(empty, kt), kr)
        let (empty, kt) := GpuMachine.park(k)
        let active := scoreIssue(GpuMachine.use(empty, GpuMachine.pairTickets(s0t, GpuMachine.pairTickets(q0t, kt))), w, b0, q0r, kr)
        let (empty, activeT) := GpuMachine.park(active)
        let (s0t, qkT) := GpuMachine.splitTicket(activeT)
        let (q0t, kt) := GpuMachine.splitTicket(qkT)
        let active := valueIssue(GpuMachine.use(empty, GpuMachine.pairTickets(s1t, vt)), w, b1, vr)
        let (empty, activeT) := GpuMachine.park(active)
        let (s1t, vt) := GpuMachine.splitTicket(activeT)
        let v := GpuMachine.releaseByMma(GpuMachine.use(empty, vt), w, vr)
        let (empty, vt) := GpuMachine.park(v)
        let active := scoreIssue(GpuMachine.use(empty, GpuMachine.pairTickets(s1t, GpuMachine.pairTickets(q1t, kt))), w, b1, q1r, kr)
        let (empty, activeT) := GpuMachine.park(active)
        let (s1t, qkT) := GpuMachine.splitTicket(activeT)
        let (q1t, kt) := GpuMachine.splitTicket(qkT)
        let k := GpuMachine.releaseByMma(GpuMachine.use(empty, kt), w, kr)
        let (empty, kt) := GpuMachine.park(k)
        GpuMachine.use(empty,
          GpuMachine.pairTickets(GpuMachine.pairTickets(q0t, q1t),
            GpuMachine.pairTickets(GpuMachine.pairTickets(kt, vt), GpuMachine.pairTickets(s0t, s1t))))
      }
      let checkpoint := GpuMachine.repeatFrom(checkpoint, 1, blocks, loop)

      // Drain the final probabilities, commit both outputs, release the held stages, and close every side.
      let (qPair, restT) := GpuMachine.split(checkpoint)
      let (q0, q1t) := GpuMachine.split(qPair)
      let (empty, q0t) := GpuMachine.park(q0)
      let (consumerT, mmaT) := GpuMachine.splitTicket(restT)
      let (kt, vt) := GpuMachine.splitTicket(consumerT)
      let (s0t, s1t) := GpuMachine.splitTicket(mmaT)
      let v := hold(GpuMachine.use(empty, vt), vr)
      let (empty, vt) := GpuMachine.park(v)
      let active := valueIssue(GpuMachine.use(empty, GpuMachine.pairTickets(s0t, vt)), w, b0, vr)
      let (empty, activeT) := GpuMachine.park(active)
      let (s0t, vt) := GpuMachine.splitTicket(activeT)
      let s0 := GpuMachine.commitBuffer(GpuMachine.use(empty, s0t), w, b0)
      let (empty, s0t) := GpuMachine.park(s0)
      let active := valueIssue(GpuMachine.use(empty, GpuMachine.pairTickets(s1t, vt)), w, b1, vr)
      let (empty, activeT) := GpuMachine.park(active)
      let (s1t, vt) := GpuMachine.splitTicket(activeT)
      let s1 := GpuMachine.commitBuffer(GpuMachine.use(empty, s1t), w, b1)
      let (empty, s1t) := GpuMachine.park(s1)
      let v := GpuMachine.releaseByMma(GpuMachine.use(empty, vt), w, vr)
      let (empty, vt) := GpuMachine.park(v)
      let q0 := GpuMachine.releaseByMma(GpuMachine.use(empty, q0t), w, q0r)
      let (empty, q0t) := GpuMachine.park(q0)
      let q1 := GpuMachine.releaseByMma(GpuMachine.use(empty, q1t), w, q1r)
      let (empty, q1t) := GpuMachine.park(q1)
      let s0 := GpuMachine.finishMma(GpuMachine.use(empty, s0t))
      let (empty, s0t) := GpuMachine.park(s0)
      let s1 := GpuMachine.finishMma(GpuMachine.use(empty, s1t))
      let (empty, s1t) := GpuMachine.park(s1)
      let q0 := GpuMachine.finishConsumer(GpuMachine.use(empty, q0t))
      let (empty, q0t) := GpuMachine.park(q0)
      let q1 := GpuMachine.finishConsumer(GpuMachine.use(empty, q1t))
      let (empty, q1t) := GpuMachine.park(q1)
      let k := GpuMachine.finishConsumer(GpuMachine.use(empty, kt))
      let (empty, kt) := GpuMachine.park(k)
      let v := GpuMachine.finishConsumer(GpuMachine.use(empty, vt))
      let (empty, vt) := GpuMachine.park(v)
      let tickets := GpuMachine.pairTickets(GpuMachine.pairTickets(q0t, q1t),
        GpuMachine.pairTickets(GpuMachine.pairTickets(kt, vt), GpuMachine.pairTickets(s0t, s1t)))
      let units := GpuMachine.use(empty, tickets)
      let units := GpuMachine.focusLeft(units, fun (queries: GpuMachine.Machine(j, Group.lane, Pair(Unit, Unit)))
          : GpuMachine.Machine(j, Group.lane, Unit) => GpuMachine.dropUnitRight(queries))
      let units := GpuMachine.focusRight(units, fun (rest: GpuMachine.Machine(j, Group.lane, Pair(Pair(Unit, Unit), Pair(Unit, Unit))))
          : GpuMachine.Machine(j, Group.lane, Pair(Unit, Unit)) => {
        let rest := GpuMachine.focusLeft(rest, fun (consumers: GpuMachine.Machine(j, Group.lane, Pair(Unit, Unit)))
            : GpuMachine.Machine(j, Group.lane, Unit) => GpuMachine.dropUnitRight(consumers))
        GpuMachine.focusRight(rest, fun (mmAs: GpuMachine.Machine(j, Group.lane, Pair(Unit, Unit)))
            : GpuMachine.Machine(j, Group.lane, Unit) => GpuMachine.dropUnitRight(mmAs))
      })
      let units := GpuMachine.focusRight(units, fun (rest: GpuMachine.Machine(j, Group.lane, Pair(Unit, Unit)))
          : GpuMachine.Machine(j, Group.lane, Unit) => GpuMachine.dropUnitRight(rest))
      GpuMachine.dropUnitRight(units)
    })

  def Correcting (x0: Lifetime)(x1: Lifetime)(m: Lifetime)(o: OState): Type { kind = lin, scope = Lifetime.union(x0, Lifetime.union(x1, m)) } :=
    Pair(CorrectAt(x0, m, 8, o), CorrectAt(x1, m, 8, o))

  def correction {L: Lifetime}{x0: Lifetime}{x1: Lifetime}(blocks: Val(L, Grain.uniform, DType.u32))(b0: ScoreBuffer(x0, Rescaler.correction))
      (b1: ScoreBuffer(x1, Rescaler.correction))(c0: CorrectionSide(x0))(c1: CorrectionSide(x1))(m: Lifetime)
      (machine: GpuMachine.Machine(m, Group.warps(8, 4), Unit)): GpuMachine.Machine(m, Group.warps(8, 4), Unit) := {
    let (machine, one) := GpuMachine.fconst(machine, oneBits)
    let zeroTile := fun {x: Lifetime}{k: Lifetime}(machine: GpuMachine.Machine(k, Group.warps(8, 4), CorrectAt(x, m, 8, OState.fresh)))(b: ScoreBuffer(x, Rescaler.correction))
        : GpuMachine.Machine(k, Group.warps(8, 4), CorrectAt(x, m, 8, OState.held)) => GpuMachine.publishRescaled(GpuMachine.zeroQuadrants(machine, b), b)
    let rescaleTile := fun {x: Lifetime}{k: Lifetime}(machine: GpuMachine.Machine(k, Group.warps(8, 4), CorrectAt(x, m, 8, OState.held)))(b: ScoreBuffer(x, Rescaler.correction))
        : GpuMachine.Machine(k, Group.warps(8, 4), CorrectAt(x, m, 8, OState.held)) => {
      let (machine, alpha) := GpuMachine.awaitAlpha(machine, b)
      let (machine, grows) := GpuMachine.voteAny(machine, Core.lt(alpha, one))
      let machine := GpuMachine.when(machine, grows, fun (n: Lifetime)(machine: GpuMachine.Machine(n, Group.warpwise(8, 4), Rescaling(x, m, 8)))
          : GpuMachine.Machine(n, Group.warpwise(8, 4), Rescaling(x, m, 8)) => GpuMachine.rescaleQuadrant(machine, b, alpha))
      GpuMachine.publishRescaled(machine, b)
    }
    let first := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(machine: GpuMachine.Machine(n, Group.warps(8, 4), Correcting(x0, x1, m, OState.fresh)))
        : GpuMachine.Machine(n, Group.warps(8, 4), Correcting(x0, x1, m, OState.held)) =>
      GpuMachine.focusRight(GpuMachine.focusLeft(machine, fun (left: GpuMachine.Machine(n, Group.warps(8, 4), CorrectAt(x0, m, 8, OState.fresh)))
          : GpuMachine.Machine(n, Group.warps(8, 4), CorrectAt(x0, m, 8, OState.held)) => zeroTile(left, b0)),
        fun (right: GpuMachine.Machine(n, Group.warps(8, 4), CorrectAt(x1, m, 8, OState.fresh)))
          : GpuMachine.Machine(n, Group.warps(8, 4), CorrectAt(x1, m, 8, OState.held)) => zeroTile(right, b1))
    let rest := fun (n: Lifetime)(i: Val(n, Grain.uniform, DType.u32))(machine: GpuMachine.Machine(n, Group.warps(8, 4), Correcting(x0, x1, m, OState.held)))
        : GpuMachine.Machine(n, Group.warps(8, 4), Correcting(x0, x1, m, OState.held)) =>
      GpuMachine.focusRight(GpuMachine.focusLeft(machine, fun (left: GpuMachine.Machine(n, Group.warps(8, 4), CorrectAt(x0, m, 8, OState.held)))
          : GpuMachine.Machine(n, Group.warps(8, 4), CorrectAt(x0, m, 8, OState.held)) => rescaleTile(left, b0)),
        fun (right: GpuMachine.Machine(n, Group.warps(8, 4), CorrectAt(x1, m, 8, OState.held)))
          : GpuMachine.Machine(n, Group.warps(8, 4), CorrectAt(x1, m, 8, OState.held)) => rescaleTile(right, b1))
    let (empty, leftTicket) := GpuMachine.park(GpuMachine.takeCorrection(machine, b0, c0))
    let (empty, rightTicket) := GpuMachine.park(GpuMachine.takeCorrection(empty, b1, c1))
    let machine := GpuMachine.use(empty, GpuMachine.pairTickets(leftTicket, rightTicket))
    let machine := GpuMachine.peeled(machine, Correcting(x0, x1, m, OState.held), blocks, first, rest)
    let machine := GpuMachine.focusRight(machine, fun (right: GpuMachine.Machine(m, Group.warps(8, 4), CorrectAt(x1, m, 8, OState.held)))
        : GpuMachine.Machine(m, Group.warps(8, 4), Unit) => GpuMachine.finishCorrection(right))
    let machine := GpuMachine.dropUnitRight(machine)
    GpuMachine.finishCorrection(machine)
  }

  def cta {l: Lifetime}{t: DType}(machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit))(g: Launch(l, t))
      (own0: OOwn(l, t, 0))(own1: OOwn(l, t, 4))(permit: TmemPermit(l))
      (regs: Registers.RegPool(l, 512, Registers.budget(512, 1))): GpuMachine.Machine(l, Layout.CorrectedCta, Unit) := {
    let rings := fun (x0: Lifetime)(x1: Lifetime)(b0: ScoreBuffer(x0, Rescaler.correction))(b1: ScoreBuffer(x1, Rescaler.correction))
        (r0: RowSide(x0))(r1: RowSide(x1))(s0: MmaSide(x0))(s1: MmaSide(x1))(c0: CorrectionSide(x0))(c1: CorrectionSide(x1))
        (machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit)): GpuMachine.Machine(l, Layout.CorrectedCta, Unit) => {
      let (machine, _) := GpuMachine.withRing(machine, qRing, Unit, fun (rq0: Lifetime)(q0r: Ring(rq0, qRing))(pq0: Producer(rq0))(cq0: Consumer(rq0))
          (machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit)): Pair(GpuMachine.Machine(l, Layout.CorrectedCta, Unit), Unit) =>
        GpuMachine.withRing(machine, qRing, Unit, fun (rq1: Lifetime)(q1r: Ring(rq1, qRing))(pq1: Producer(rq1))(cq1: Consumer(rq1))
            (machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit)): Pair(GpuMachine.Machine(l, Layout.CorrectedCta, Unit), Unit) =>
          GpuMachine.withRing(machine, kRing, Unit, fun (rk: Lifetime)(kr: Ring(rk, kRing))(pk: Producer(rk))(ck: Consumer(rk))
              (machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit)): Pair(GpuMachine.Machine(l, Layout.CorrectedCta, Unit), Unit) =>
            GpuMachine.withRing(machine, vRing, Unit, fun (rv: Lifetime)(vr: Ring(rv, vRing))(pv: Producer(rv))(cv: Consumer(rv))
                (machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit)): Pair(GpuMachine.Machine(l, Layout.CorrectedCta, Unit), Unit) =>
              (GpuMachine.rolesCorrected(machine, regs,
                fun (m: Lifetime)(machine: GpuMachine.Machine(m, Group.warps(0, 4), Unit)): GpuMachine.Machine(m, Group.warps(0, 4), Unit) =>
                  softmax(g.blocks, g.mask, g.scale, g.out, own0, b0, r0, m, machine),
                fun (m: Lifetime)(machine: GpuMachine.Machine(m, Group.warps(4, 4), Unit)): GpuMachine.Machine(m, Group.warps(4, 4), Unit) =>
                  softmax(g.blocks, g.mask, g.scale, g.out, own1, b1, r1, m, machine),
                fun (m: Lifetime)(machine: GpuMachine.Machine(m, Group.warps(8, 4), Unit)): GpuMachine.Machine(m, Group.warps(8, 4), Unit) =>
                  correction(g.blocks, b0, b1, c0, c1, m, machine),
                fun (m: Lifetime)(machine: GpuMachine.Machine(m, Layout.CorrectedIssue, Unit)): GpuMachine.Machine(m, Layout.CorrectedIssue, Unit) =>
                  pairIssuer(g.blocks, q0r, q1r, kr, vr, b0, b1, cq0, cq1, ck, cv, s0, s1, m, machine),
                fun (m: Lifetime)(machine: GpuMachine.Machine(m, Layout.CorrectedLoad, Unit)): GpuMachine.Machine(m, Layout.CorrectedLoad, Unit) =>
                  producer(g, q0r, q1r, kr, vr, pq0, pq1, pk, pv, m, machine)), Unit.unit)))))
      machine
    }
    let regions := fun (a: Lifetime)(tm: Tmem(a, 512))(acc: Acc(a, AccState.empty))(machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit))
        : Pair(GpuMachine.Machine(l, Layout.CorrectedCta, Unit), Pair(Acc(a, AccState.empty), Unit)) =>
      GpuMachine.splitTmem(machine, tm, acc, 256, Unit,
        fun (c0: Lifetime)(c1: Lifetime)(t0: Tmem(c0, 256))(acc0: Acc(c0, AccState.empty))(t1: Tmem(c1, 256))(acc1: Acc(c1, AccState.empty))
            (machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit))
            : Pair(GpuMachine.Machine(l, Layout.CorrectedCta, Unit), Pair(Pair(Acc(c0, AccState.empty), Acc(c1, AccState.empty)), Unit)) => {
          let (machine, (acc0, (acc1, _))) := GpuMachine.withCorrectedBuffer(machine, t0, acc0, Pair(Acc(c1, AccState.empty), Unit),
            fun (x0: Lifetime)(b0: ScoreBuffer(x0, Rescaler.correction))(r0: RowSide(x0))(s0: MmaSide(x0))(k0: CorrectionSide(x0))
                (machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit))
                : Pair(GpuMachine.Machine(l, Layout.CorrectedCta, Unit), Pair(Acc(c1, AccState.empty), Unit)) =>
              GpuMachine.withCorrectedBuffer(machine, t1, acc1, Unit,
                fun (x1: Lifetime)(b1: ScoreBuffer(x1, Rescaler.correction))(r1: RowSide(x1))(s1: MmaSide(x1))(k1: CorrectionSide(x1))
                    (machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit))
                    : Pair(GpuMachine.Machine(l, Layout.CorrectedCta, Unit), Unit) =>
                  (rings(x0, x1, b0, b1, r0, r1, s0, s1, k0, k1, machine), Unit.unit)))
          (machine, ((acc0, acc1), Unit.unit))
        })
    let (machine, _) := GpuMachine.withTmem(machine, permit, 512, AccState.empty, Unit, regions)
    machine
  }

  def build (name: String)(causal: Bool)(t: DType): Program :=
    GpuMachine.correctedAttentionKernel(name, causal, t,
      fun (l: Lifetime)(machine: GpuMachine.Machine(l, Layout.CorrectedCta, Unit))(g: Launch(l, t))(own0: OOwn(l, t, 0))(own1: OOwn(l, t, 4))
          (permit: TmemPermit(l))(regs: Registers.RegPool(l, 512, Registers.budget(512, 1)))
          : GpuMachine.Machine(l, Layout.CorrectedCta, Unit) => cta(machine, g, own0, own1, permit, regs))

  def nonCausal: Program := LunaAttention.build("attention_a3b", Bool.false, Cuda.DType.f32)
  def causalBf16: Program := LunaAttention.build("attention_a3b_causal", Bool.true, Cuda.DType.bf16)

}
