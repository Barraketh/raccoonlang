import Elaboration
import Target
import Frame

namespace Examples {
  open Retirement
  // Zero or many stores, with a drain after the loop on every path and rank.
  def program: Dependent.Program := Dependent.allocate(
    Dependent.sequence(Dependent.loop(Dependent.issue),
      Dependent.sequence(Dependent.leader(Mode.all, Phase.live, Dependent.local(Mode.leader, Phase.live)), Dependent.finish)))
  def certified: Target.Correct(Retirement.at(Phase.outside), Retirement.at(Phase.outside), Target.syntax(Examples.program)) := Target.everyProgram(Examples.program)

  def skipped: Code := Code.allocate(Code.branch(Code.finish, Code.skip))
  def repeated: Code := Code.allocate(Code.loop(Code.finish))
  def leaderOnly: Code := Code.allocate(Code.leader(Code.finish))
  def undrained: Code := Code.allocate(Code.issue)
  def rejectedSkipped: Eq(Option(Elaboration.Accepted(Examples.skipped)), Elaboration.program(Examples.skipped), Option.none(Elaboration.Accepted(Examples.skipped))) := Eq.refl(Option.none(Elaboration.Accepted(Examples.skipped)))
  def rejectedRepeated: Eq(Option(Elaboration.Accepted(Examples.repeated)), Elaboration.program(Examples.repeated), Option.none(Elaboration.Accepted(Examples.repeated))) := Eq.refl(Option.none(Elaboration.Accepted(Examples.repeated)))
  def rejectedLeader: Eq(Option(Elaboration.Accepted(Examples.leaderOnly)), Elaboration.program(Examples.leaderOnly), Option.none(Elaboration.Accepted(Examples.leaderOnly))) := Eq.refl(Option.none(Elaboration.Accepted(Examples.leaderOnly)))
  def rejectedUndrained: Eq(Option(Elaboration.Accepted(Examples.undrained)), Elaboration.program(Examples.undrained), Option.none(Elaboration.Accepted(Examples.undrained))) := Eq.refl(Option.none(Elaboration.Accepted(Examples.undrained)))
  def accepted: Elaboration.Accepted(Dependent.code(Examples.program)) := {
    match Elaboration.program(Dependent.code(Examples.program)) returning Elaboration.Accepted(Dependent.code(Examples.program)) with
    | Option.some result => result
  }

  // Independent semantic witnesses: each rejected tree has an unsafe run.
  // These evaluate the interpreter, not the phase inference procedure.
  def skipsDrain: Eq(Contracts.Outcome(State), Retirement.run(Examples.skipped, Bool.true, Contracts.Runtime.mk(0, Bool.false, 0), State.mk(Bool.false, 0)), Contracts.Outcome.fault(State)) := Eq.refl(Contracts.Outcome.fault(State))
  def finishesTwice: Eq(Contracts.Outcome(State), Retirement.run(Examples.repeated, Bool.true, Contracts.Runtime.mk(2, Bool.true, 0), State.mk(Bool.false, 0)), Contracts.Outcome.fault(State)) := Eq.refl(Contracts.Outcome.fault(State))
  def leavesPeerLive: Eq(Contracts.Outcome(State), Retirement.run(Examples.leaderOnly, Bool.false, Contracts.Runtime.mk(0, Bool.true, 0), State.mk(Bool.false, 0)), Contracts.Outcome.fault(State)) := Eq.refl(Contracts.Outcome.fault(State))
  def leavesStorePending: Eq(Contracts.Outcome(State), Retirement.run(Examples.undrained, Bool.true, Contracts.Runtime.mk(0, Bool.true, 0), State.mk(Bool.false, 0)), Contracts.Outcome.fault(State)) := Eq.refl(Contracts.Outcome.fault(State))
}
