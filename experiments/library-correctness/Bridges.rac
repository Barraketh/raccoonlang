import Target
import Structural

namespace Bridges {
  open Retirement
  // This is the missing result of a logical-relations proof over reflected
  // CLIENT typing. Plain HasType and plain AST quotation do not supply it.
  struct CoreInterpretation (p: Core.Program): Type
   | mk (plan: Code)(usage: Typed(Mode.all, plan, Phase.outside, Phase.outside))
        (generated: Eq(Cuda.Block, Core.kernelSyntax(p).body, Target.compile(plan, 0).block)): CoreInterpretation(p)

  def reflectedCore {p: Core.Program}(interpretation: CoreInterpretation(p))
      : Target.Correct(Retirement.at(Phase.outside), Retirement.at(Phase.outside), Core.kernelSyntax(p).body) := {
    match interpretation returning Target.Correct(Retirement.at(Phase.outside), Retirement.at(Phase.outside), Core.kernelSyntax(p).body) with
    | CoreInterpretation.mk code valid generated => {
      match generated returning Target.Correct(Retirement.at(Phase.outside), Retirement.at(Phase.outside), Core.kernelSyntax(p).body) with
      | Eq.refl same => Target.everyProgram(Dependent.elaborateDerivation(code, valid))
    }
  }

  // Model of the proposed effect judgment, represented by ordinary Prop.
  // Compiler integration is not implemented or assumed sound by this test.
  def machineJudgment (code: Code)(valid: Typed(Mode.all, code, Phase.outside, Phase.outside))
      : Target.Correct(Retirement.at(Phase.outside), Retirement.at(Phase.outside), Target.compile(code, 0).block) :=
    Target.everyProgram(Dependent.elaborateDerivation(code, valid))

  // All three routes must discharge the SAME target obligation.
  // No special native-rule semantic theorem appears on the RHS.
  def ordinaryDependent (program: Dependent.Program)
      : Target.Correct(Retirement.at(Phase.outside), Retirement.at(Phase.outside), Target.syntax(program)) := Target.everyProgram(program)
}
