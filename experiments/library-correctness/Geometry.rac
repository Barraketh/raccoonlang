import Regions

namespace Geometry {
  def address (width: Nat)(row: Nat)(column: Nat): Nat := Nat.add(Nat.mul(width, row), column)
  def row (width: Nat)(r: Nat): Regions.Region := Regions.Region.mk(Nat.mul(width, r), width)
  def rowEnd (width: Nat)(r: Nat): Eq(Nat, Regions.end(Geometry.row(width, r)), Nat.mul(width, Nat.succ(r))) := Arithmetic.addCommute(Nat.mul(width, r), width)
  def inside (width: Nat)(r: Nat)(c: Nat)(bound: Nat.lt(c, width)): Regions.Contains(Geometry.row(width, r), Geometry.address(width, r, c)) :=
    And.intro(Arithmetic.addBound(Nat.mul(width, r), c),
      Arithmetic.rewriteLeft(Arithmetic.addSuccessor(Nat.mul(width, r), c), Nat.add(Nat.mul(width, r), width),
        Arithmetic.addLeftMonotone(Nat.succ(c), width, Nat.mul(width, r), bound)))
  def orderedRows (width: Nat)(a: Nat)(b: Nat)(order: Nat.lt(a, b)): Nat.le(Regions.end(Geometry.row(width, a)), Geometry.row(width, b).base) :=
    Arithmetic.rewriteLeft(Eq.symm(Geometry.rowEnd(width, a)), Nat.mul(width, b), Arithmetic.mulMonotone(Nat.succ(a), b, width, order))
  def separateRows (width: Nat)(a: Nat)(b: Nat)(different: Not(Eq(Nat, a, b))): Regions.Separate(Geometry.row(width, a), Geometry.row(width, b)) := {
    match Arithmetic.strictCases(a, b, different) returning Regions.Separate(Geometry.row(width, a), Geometry.row(width, b)) with
    | Or.inl ab => Or.inl(Nat.le(Regions.end(Geometry.row(width, b)), Geometry.row(width, a).base), Geometry.orderedRows(width, a, b, ab))
    | Or.inr ba => Or.inr(Nat.le(Regions.end(Geometry.row(width, a)), Geometry.row(width, b).base), Geometry.orderedRows(width, b, a, ba))
  }
  def differentRowsNeverAlias (width: Nat)(a: Nat)(b: Nat)(x: Nat)(y: Nat)(xb: Nat.lt(x, width))(yb: Nat.lt(y, width))
      (different: Not(Eq(Nat, a, b)))(same: Eq(Nat, Geometry.address(width, a, x), Geometry.address(width, b, y))): False := {
    Regions.noAlias(Geometry.row(width, a), Geometry.row(width, b), Geometry.separateRows(width, a, b, different),
      Geometry.address(width, a, x), Geometry.inside(width, a, x, xb),
      Eq.substP(Eq.symm(same), Regions.contains(Geometry.row(width, b)), Geometry.inside(width, b, y, yb)))
  }

  // The complete injectivity fact for row-major addresses, including tails.
  def injective (width: Nat)(a: Nat)(b: Nat)(x: Nat)(y: Nat)(xb: Nat.lt(x, width))(yb: Nat.lt(y, width))
      (same: Eq(Nat, Geometry.address(width, a, x), Geometry.address(width, b, y))): And(Eq(Nat, a, b), Eq(Nat, x, y)) := {
    match Nat.decEq(a, b) returning And(Eq(Nat, a, b), Eq(Nat, x, y)) with
    | Decidable.isFalse different => False.elimP(Geometry.differentRowsNeverAlias(width, a, b, x, y, xb, yb, different, same), And(Eq(Nat, a, b), Eq(Nat, x, y)))
    | Decidable.isTrue rows => {
      match rows returning And(Eq(Nat, a, b), Eq(Nat, x, y)) with
      | Eq.refl r => And.intro(Eq.refl(r), Arithmetic.cancelLeft(x, y, Nat.mul(width, r), same))
    }
  }
}
