import proofs.Lib

// A41 gives atomic reads/CAS of a word. Here its decoded epoch/owner fields
// are modeled exactly; the physical 64-bit packing is a separate obligation.
namespace Claims {
  struct Word: Type
   | mk (epoch: Nat)(owner: Nat): Word
  def equal (a: Word)(b: Word): Bool := Bool.and(Nat.beq(a.epoch, b.epoch), Nat.beq(a.owner, b.owner))
  def same (a: Word)(b: Word)(tested: Eq(Bool, Claims.equal(a, b), Bool.true)): Eq(Word, a, b) := {
    match a returning Eq(Word, a, b) with
    | Word.mk ae ao => {
      match b returning Eq(Word, a, b) with
      | Word.mk be bo => {
        match Lib.beqSound(ae, be, Lib.andLeft(Nat.beq(ae, be), Nat.beq(ao, bo), tested)) returning Eq(Word, a, b) with
        | Eq.refl epoch => {
          match Lib.beqSound(ao, bo, Lib.andRight(Nat.beq(ae, be), Nat.beq(ao, bo), tested)) returning Eq(Word, a, b) with
          | Eq.refl owner => Eq.refl(Word.mk(epoch, owner))
        }
      }
    }
  }
  inductive Request (epoch: Nat): Type
   | observe (owner: Nat): Request(epoch)
   | cas (owner: Nat)(snapshot: Word)(older: Not(Eq(Nat, snapshot.epoch, epoch))): Request(epoch)
  struct State: Type
   | mk (word: Word)(winners: List(Nat)): State
  def invariant (epoch: Nat): State -> Prop := fun (s: State): Prop =>
    (candidate: Nat) -> Spec.Mem(Nat, candidate, s.winners) -> Eq(Word, s.word, Word.mk(epoch, candidate))
  def initial (word: Word): State := State.mk(word, List.nil(Nat))
  def initialSafe (epoch: Nat)(word: Word): Claims.invariant(epoch)(Claims.initial(word)) :=
    fun (owner: Nat)(member: Spec.Mem(Nat, owner, List.nil(Nat))): Eq(Word, word, Word.mk(epoch, owner)) => {
        match member returning Eq(Word, word, Word.mk(epoch, owner)) with
      }
  def choose (flag: Bool)(yes: State)(no: State): State := {
    match flag returning State with
    | Bool.true => yes
    | Bool.false => no
  }
  def chooseTrue (flag: Bool)(yes: State)(no: State)(tested: Eq(Bool, flag, Bool.true)): Eq(State, Claims.choose(flag, yes, no), yes) := {
    match tested returning Eq(State, Claims.choose(flag, yes, no), yes) with
    | Eq.refl same => Eq.refl(yes)
  }
  def chooseFalse (flag: Bool)(yes: State)(no: State)(tested: Eq(Bool, flag, Bool.false)): Eq(State, Claims.choose(flag, yes, no), no) := {
    match tested returning Eq(State, Claims.choose(flag, yes, no), no) with
    | Eq.refl same => Eq.refl(no)
  }
  def step {epoch: Nat}(request: Request(epoch))(s: State): State := {
    match request returning State with
    | Request.observe owner => Claims.choose(Claims.equal(s.word, Word.mk(epoch, owner)), State.mk(s.word, List.cons(owner, s.winners)), s)
    | Request.cas owner snapshot older => Claims.choose(Claims.equal(s.word, snapshot), State.mk(Word.mk(epoch, owner), List.cons(owner, s.winners)), s)
  }

  def win (epoch: Nat)(s: State)(owner: Nat)(same: Eq(Word, s.word, Word.mk(epoch, owner)))(valid: Claims.invariant(epoch)(s))
      : Claims.invariant(epoch)(State.mk(s.word, List.cons(owner, s.winners))) :=
    fun (winner: Nat)(member: Spec.Mem(Nat, winner, List.cons(owner, s.winners))): Eq(Word, s.word, Word.mk(epoch, winner)) => {
        match member returning Eq(Word, s.word, Word.mk(epoch, winner)) with
        | Spec.Mem.here rest => same
        | Spec.Mem.there first rest there => valid(winner, there)
      }
  def casWin (epoch: Nat)(s: State)(owner: Nat)(snapshot: Word)(older: Not(Eq(Nat, snapshot.epoch, epoch)))
      (same: Eq(Word, s.word, snapshot))(valid: Claims.invariant(epoch)(s))
      : Claims.invariant(epoch)(State.mk(Word.mk(epoch, owner), List.cons(owner, s.winners))) :=
    fun (winner: Nat)(member: Spec.Mem(Nat, winner, List.cons(owner, s.winners))): Eq(Word, Word.mk(epoch, owner), Word.mk(epoch, winner)) => {
        match member returning Eq(Word, Word.mk(epoch, owner), Word.mk(epoch, winner)) with
        | Spec.Mem.here rest => Eq.refl(Word.mk(epoch, owner))
        | Spec.Mem.there first rest there => False.elimP(older(congrArg(Eq.trans(Eq.symm(same), valid(winner, there)), Nat, Word.epoch)), Eq(Word, Word.mk(epoch, owner), Word.mk(epoch, winner)))
      }
  def preserve {epoch: Nat}(request: Request(epoch))(s: State)(valid: Claims.invariant(epoch)(s)): Claims.invariant(epoch)(Claims.step(request, s)) := {
    match request returning Claims.invariant(epoch)(Claims.step(request, s)) with
    | Request.observe owner => {
      match tested : Claims.equal(s.word, Word.mk(epoch, owner)) returning Claims.invariant(epoch)(Claims.step(request, s)) with
      | Bool.true => Eq.substP(Eq.symm(Claims.chooseTrue(Claims.equal(s.word, Word.mk(epoch, owner)), State.mk(s.word, List.cons(owner, s.winners)), s, tested)), Claims.invariant(epoch), Claims.win(epoch, s, owner, Claims.same(s.word, Word.mk(epoch, owner), tested), valid))
      | Bool.false => Eq.substP(Eq.symm(Claims.chooseFalse(Claims.equal(s.word, Word.mk(epoch, owner)), State.mk(s.word, List.cons(owner, s.winners)), s, tested)), Claims.invariant(epoch), valid)
    }
    | Request.cas owner snapshot older => {
      match tested : Claims.equal(s.word, snapshot) returning Claims.invariant(epoch)(Claims.step(request, s)) with
      | Bool.true => Eq.substP(Eq.symm(Claims.chooseTrue(Claims.equal(s.word, snapshot), State.mk(Word.mk(epoch, owner), List.cons(owner, s.winners)), s, tested)), Claims.invariant(epoch), Claims.casWin(epoch, s, owner, snapshot, older, Claims.same(s.word, snapshot, tested), valid))
      | Bool.false => Eq.substP(Eq.symm(Claims.chooseFalse(Claims.equal(s.word, snapshot), State.mk(Word.mk(epoch, owner), List.cons(owner, s.winners)), s, tested)), Claims.invariant(epoch), valid)
    }
  }

  def run (epoch: Nat)(requests: List(Request(epoch)))(s: State): State decreases structural(requests) := {
    match requests returning State with
    | List.nil => s
    | List.cons first rest => Claims.run(epoch, rest, Claims.step(first, s))
  }
  def everyInterleaving (epoch: Nat)(requests: List(Request(epoch)))(s: State)(valid: Claims.invariant(epoch)(s))
      : Claims.invariant(epoch)(Claims.run(epoch, requests, s)) decreases structural(requests) := {
    match requests returning Claims.invariant(epoch)(Claims.run(epoch, requests, s)) with
    | List.nil => valid
    | List.cons first rest => Claims.everyInterleaving(epoch, rest, Claims.step(first, s), Claims.preserve(first, s, valid))
  }
  def exclusive (epoch: Nat)(requests: List(Request(epoch)))(initial: Word)(a: Nat)(b: Nat)
      (left: Spec.Mem(Nat, a, Claims.run(epoch, requests, Claims.initial(initial)).winners))
      (right: Spec.Mem(Nat, b, Claims.run(epoch, requests, Claims.initial(initial)).winners)): Eq(Nat, a, b) := {
    let valid := Claims.everyInterleaving(epoch, requests, Claims.initial(initial), Claims.initialSafe(epoch, initial))
    congrArg(Eq.trans(Eq.symm(valid(a, left)), valid(b, right)), Nat, Word.owner)
  }
}
