  def arriveZero (epoch: Nat): Eq(Mbarrier.Outcome,
      Mbarrier.liveStep(Mbarrier.Action.arrive(0), Mbarrier.waiting(epoch, Bool.true)),
      Mbarrier.Outcome.ran(Mbarrier.waiting(Nat.succ(epoch), Bool.false))) := Eq.refl(Mbarrier.Outcome.ran(Mbarrier.waiting(Nat.succ(epoch), Bool.false)))

  def emptyArriveActualRan (bytes: Nat)(before: RingPrimitives.World)(after: Mbarrier.State)(live: Eq(Bool, before.empty.live, Bool.true))
      (actual: Eq(Mbarrier.Outcome, Mbarrier.liveStep(Mbarrier.Action.arrive(bytes), before.empty), Mbarrier.Outcome.ran(after)))
      : Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.empty(Mbarrier.Action.arrive(bytes)), before), RingPrimitives.Outcome.ran(RingPrimitives.World.mk(before.full, after, before.joined))) :=
    congrArg(RingProofs.arriveStep(bytes, before.empty, after, live, actual), RingPrimitives.Outcome,
      fun (out: Mbarrier.Outcome): RingPrimitives.Outcome => RingPrimitives.emptyResult(before, out))

  def releaseReading (bytes: Nat)(n: Nat)
      : RingObligations.CorrectMacro(bytes, Concurrent.Action.release,
          Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.Phase.held, n), Concurrent.Slot.reading, n, Bool.false)) := {
    let s := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.Phase.held, n), Concurrent.Slot.reading, n, Bool.false)
    let next := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Slot.empty, Nat.succ(n), Bool.false)
    let before := RingPrimitives.world(bytes, s)
    let fence := RingPrimitives.Primitive.proxyFence
    let primitive := RingPrimitives.Primitive.empty(Mbarrier.Action.arrive(0))
    let fenceSafe := And.intro(And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)),
      And.intro(Eq.refl(Bool.true), And.intro(Eq.refl(0), Eq.refl(0))))
    let safe := And.intro(Or.inl(Eq(Mbarrier.State, before.empty, Mbarrier.initial), And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true))),
      And.intro(Eq.refl(Bool.true), And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true))))
    let actual := RingProofs.emptyArriveActualRan(0, before, Mbarrier.waiting(Nat.succ(Nat.succ(n)), Bool.false), Eq.refl(Bool.true),
      RingProofs.arriveZero(Nat.succ(n)))
    RingProofs.twoMacroRan(bytes, Concurrent.Action.release, s, next, fence, primitive,
      Eq.refl(RingPrimitives.two(fence, primitive)), fenceSafe, Eq.refl(RingPrimitives.Outcome.ran(before)), safe, actual,
      Eq.refl(Concurrent.Outcome.ran(next)))
  }

