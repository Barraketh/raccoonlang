import Mbarrier
import Concurrent
import RingPrimitives
import RingObligations
import Arithmetic
import Endpoints
import Scheduler
import Ring
import Contracts
import proofs.Lib

// Universal proofs for the count-one, single-CTA copy-ring primitive library.
namespace RingProofs {
  def setupOne: RingPrimitives.World := RingPrimitives.World.mk(Mbarrier.initial, Mbarrier.dead, Bool.false)
  def setupTwo: RingPrimitives.World := RingPrimitives.World.mk(Mbarrier.initial, Mbarrier.initial, Bool.false)
  def setupThree: RingPrimitives.World := RingPrimitives.World.mk(Mbarrier.initial, Mbarrier.State.mk(Bool.true, Bool.false, Bool.false, 1, Bool.true, 0, 0, Bool.false), Bool.false)
  def setupFour: RingPrimitives.World := RingPrimitives.World.mk(Mbarrier.State.mk(Bool.true, Bool.true, Bool.false, 0, Bool.true, 0, 0, Bool.true), Mbarrier.State.mk(Bool.true, Bool.false, Bool.false, 1, Bool.true, 0, 0, Bool.false), Bool.false)
  def setupFive: RingPrimitives.World := RingPrimitives.World.mk(Mbarrier.State.mk(Bool.true, Bool.true, Bool.false, 0, Bool.true, 0, 0, Bool.true), Mbarrier.State.mk(Bool.true, Bool.true, Bool.false, 1, Bool.true, 0, 0, Bool.false), Bool.false)
  def setupSix: RingPrimitives.World := RingPrimitives.World.mk(Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, 0, Bool.true, 0, 0, Bool.true), Mbarrier.State.mk(Bool.true, Bool.true, Bool.false, 1, Bool.true, 0, 0, Bool.false), Bool.false)
  def setupSeven: RingPrimitives.World := RingPrimitives.World.mk(Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, 0, Bool.true, 0, 0, Bool.true), Mbarrier.waiting(1, Bool.false), Bool.false)

  def setupTail6: List(RingPrimitives.Primitive) := List.cons(RingPrimitives.Primitive.empty(Mbarrier.Action.publish), List.nil(RingPrimitives.Primitive))
  def setupTail5: List(RingPrimitives.Primitive) := List.cons(RingPrimitives.Primitive.full(Mbarrier.Action.publish), setupTail6)
  def setupTail4: List(RingPrimitives.Primitive) := List.cons(RingPrimitives.Primitive.empty(Mbarrier.Action.fenceInit), setupTail5)
  def setupTail3: List(RingPrimitives.Primitive) := List.cons(RingPrimitives.Primitive.full(Mbarrier.Action.fenceInit), setupTail4)
  def setupTail2: List(RingPrimitives.Primitive) := List.cons(RingPrimitives.Primitive.empty(Mbarrier.Action.arrive(0)), setupTail3)
  def setupTail1: List(RingPrimitives.Primitive) := List.cons(RingPrimitives.Primitive.empty(Mbarrier.Action.init), setupTail2)
  def setupTail0: List(RingPrimitives.Primitive) := List.cons(RingPrimitives.Primitive.full(Mbarrier.Action.init), setupTail1)

  def setupResult (bytes: Nat): Eq(RingPrimitives.Outcome, RingPrimitives.run(RingPrimitives.setup, RingPrimitives.dead), RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial))) :=
    Eq.refl(RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial)))

  def setupAuditLast (bytes: Nat): RingObligations.Audit(setupTail6, setupSix, RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial))) :=
    RingObligations.Audit.advance(RingPrimitives.Primitive.empty(Mbarrier.Action.publish), List.nil(RingPrimitives.Primitive), setupSix, setupSeven,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial)), And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)),
      Eq.refl(RingPrimitives.Outcome.ran(setupSeven)), RingObligations.Audit.done(RingPrimitives.world(bytes, Concurrent.initial)))

  def setupAudit5 (bytes: Nat): RingObligations.Audit(setupTail5, setupFive, RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial))) :=
    RingObligations.Audit.advance(RingPrimitives.Primitive.full(Mbarrier.Action.publish), setupTail6, setupFive, setupSix,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial)), And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)),
      Eq.refl(RingPrimitives.Outcome.ran(setupSix)), RingProofs.setupAuditLast(bytes))

  def setupAudit4 (bytes: Nat): RingObligations.Audit(setupTail4, setupFour, RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial))) :=
    RingObligations.Audit.advance(RingPrimitives.Primitive.empty(Mbarrier.Action.fenceInit), setupTail5, setupFour, setupFive,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial)), Eq.refl(Bool.true), Eq.refl(RingPrimitives.Outcome.ran(setupFive)),
      RingProofs.setupAudit5(bytes))

  def setupAudit3 (bytes: Nat): RingObligations.Audit(setupTail3, setupThree, RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial))) :=
    RingObligations.Audit.advance(RingPrimitives.Primitive.full(Mbarrier.Action.fenceInit), setupTail4, setupThree, setupFour,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial)), Eq.refl(Bool.true), Eq.refl(RingPrimitives.Outcome.ran(setupFour)),
      RingProofs.setupAudit4(bytes))

  def setupAudit2 (bytes: Nat): RingObligations.Audit(setupTail2, setupTwo, RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial))) :=
    RingObligations.Audit.advance(RingPrimitives.Primitive.empty(Mbarrier.Action.arrive(0)), setupTail3, setupTwo, setupThree,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial)), And.intro(Or.inr(RingObligations.Usable(setupTwo.empty), Eq.refl(Mbarrier.initial)), And.intro(Eq.refl(Bool.true), And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)))),
      Eq.refl(RingPrimitives.Outcome.ran(setupThree)), RingProofs.setupAudit3(bytes))

  def setupAudit1 (bytes: Nat): RingObligations.Audit(setupTail1, setupOne, RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial))) :=
    RingObligations.Audit.advance(RingPrimitives.Primitive.empty(Mbarrier.Action.init), setupTail2, setupOne, setupTwo,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial)), Eq.refl(Bool.false),
      Eq.refl(RingPrimitives.Outcome.ran(setupTwo)), RingProofs.setupAudit2(bytes))

  def setupAudit (bytes: Nat): RingObligations.Audit(RingPrimitives.setup, RingPrimitives.dead, RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial))) :=
    RingObligations.Audit.advance(RingPrimitives.Primitive.full(Mbarrier.Action.init), setupTail1, RingPrimitives.dead, setupOne,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, Concurrent.initial)), Eq.refl(Bool.false),
      Eq.refl(RingPrimitives.Outcome.ran(setupOne)), RingProofs.setupAudit1(bytes))

  def waitAfterCurrent (test: Bool)(s: Mbarrier.State): Mbarrier.Outcome := {
    match test returning Mbarrier.Outcome with
    | Bool.false => Mbarrier.Outcome.fault
    | Bool.true => Mbarrier.Outcome.ran(Mbarrier.State.mk(s.live, s.fenced, s.visible, s.epoch, s.arrival, s.expected, s.completed, Bool.true))
  }

  def waitByTest (first: Bool)(epoch: Nat)(s: Mbarrier.State): Mbarrier.Outcome := {
    match first returning Mbarrier.Outcome with
    | Bool.true => Mbarrier.Outcome.blocked
    | Bool.false => RingProofs.waitAfterCurrent(Nat.beq(s.epoch, Nat.succ(epoch)), s)
  }

  def waitCurrentFrom (epoch: Nat)(s: Mbarrier.State)(current: Eq(Bool, Nat.beq(s.epoch, epoch), Bool.true))
      : Eq(Mbarrier.Outcome, Mbarrier.wait(epoch, s), Mbarrier.Outcome.blocked) :=
    Eq.substP(Eq.symm(current),
      fun (test: Bool): Prop => Eq(Mbarrier.Outcome, RingProofs.waitByTest(test, epoch, s), Mbarrier.Outcome.blocked),
      Eq.refl(Mbarrier.Outcome.blocked))

  def waitCurrent (epoch: Nat)(observed: Bool): Eq(Mbarrier.Outcome, Mbarrier.wait(epoch, Mbarrier.waiting(epoch, observed)), Mbarrier.Outcome.blocked) :=
    RingProofs.waitCurrentFrom(epoch, Mbarrier.waiting(epoch, observed), Lib.beqRefl(epoch))

  def beqPrevious (epoch: Nat): Eq(Bool, Nat.beq(Nat.succ(epoch), epoch), Bool.false) decreases structural(epoch) := {
    match epoch returning Eq(Bool, Nat.beq(Nat.succ(epoch), epoch), Bool.false) with
    | Nat.zero => Eq.refl(Bool.false)
    | Nat.succ n => RingProofs.beqPrevious(n)
  }

  def waitPreviousFrom (epoch: Nat)(s: Mbarrier.State)
      (older: Eq(Bool, Nat.beq(s.epoch, epoch), Bool.false))
      (current: Eq(Bool, Nat.beq(s.epoch, Nat.succ(epoch)), Bool.true))
      : Eq(Mbarrier.Outcome, Mbarrier.wait(epoch, s), Mbarrier.Outcome.ran(Mbarrier.State.mk(s.live, s.fenced, s.visible, s.epoch, s.arrival, s.expected, s.completed, Bool.true))) := {
    let updated := Mbarrier.Outcome.ran(Mbarrier.State.mk(s.live, s.fenced, s.visible, s.epoch, s.arrival, s.expected, s.completed, Bool.true))
    let currentStep := Eq.substP(Eq.symm(current),
      fun (test: Bool): Prop => Eq(Mbarrier.Outcome, RingProofs.waitAfterCurrent(test, s), updated), Eq.refl(updated))
    Eq.substP(Eq.symm(older),
      fun (test: Bool): Prop => Eq(Mbarrier.Outcome, RingProofs.waitByTest(test, epoch, s), updated), currentStep)
  }

  def waitPrevious (epoch: Nat)(observed: Bool): Eq(Mbarrier.Outcome, Mbarrier.wait(epoch, Mbarrier.waiting(Nat.succ(epoch), observed)), Mbarrier.Outcome.ran(Mbarrier.waiting(Nat.succ(epoch), Bool.true))) :=
    RingProofs.waitPreviousFrom(epoch, Mbarrier.waiting(Nat.succ(epoch), observed), RingProofs.beqPrevious(epoch), Lib.beqRefl(Nat.succ(epoch)))

  def continue (out: RingPrimitives.Outcome): RingPrimitives.Outcome := {
    match out returning RingPrimitives.Outcome with
    | RingPrimitives.Outcome.ran next => RingPrimitives.Outcome.ran(next)
    | RingPrimitives.Outcome.blocked => RingPrimitives.Outcome.blocked
    | RingPrimitives.Outcome.fault => RingPrimitives.Outcome.fault
  }

  def runOneRan (p: RingPrimitives.Primitive)(before: RingPrimitives.World)(after: RingPrimitives.World)
      (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, before), RingPrimitives.Outcome.ran(after)))
      : Eq(RingPrimitives.Outcome, RingPrimitives.run(List.cons(p, List.nil(RingPrimitives.Primitive)), before), RingPrimitives.Outcome.ran(after)) :=
    congrArg(actual, RingPrimitives.Outcome, RingProofs.continue)

  def runOneBlocked (p: RingPrimitives.Primitive)(before: RingPrimitives.World)
      (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, before), RingPrimitives.Outcome.blocked))
      : Eq(RingPrimitives.Outcome, RingPrimitives.run(List.cons(p, List.nil(RingPrimitives.Primitive)), before), RingPrimitives.Outcome.blocked) :=
    congrArg(actual, RingPrimitives.Outcome, RingProofs.continue)

  def continueRun (rest: List(RingPrimitives.Primitive))(out: RingPrimitives.Outcome): RingPrimitives.Outcome := {
    match out returning RingPrimitives.Outcome with
    | RingPrimitives.Outcome.ran next => RingPrimitives.run(rest, next)
    | RingPrimitives.Outcome.blocked => RingPrimitives.Outcome.blocked
    | RingPrimitives.Outcome.fault => RingPrimitives.Outcome.fault
  }

  def runTwoRan (p: RingPrimitives.Primitive)(q: RingPrimitives.Primitive)
      (before: RingPrimitives.World)(mid: RingPrimitives.World)(after: RingPrimitives.World)
      (actual1: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, before), RingPrimitives.Outcome.ran(mid)))
      (actual2: Eq(RingPrimitives.Outcome, RingPrimitives.step(q, mid), RingPrimitives.Outcome.ran(after)))
      : Eq(RingPrimitives.Outcome, RingPrimitives.run(RingPrimitives.two(p, q), before), RingPrimitives.Outcome.ran(after)) := {
    let first := congrArg(actual1, RingPrimitives.Outcome, fun (out: RingPrimitives.Outcome): RingPrimitives.Outcome =>
      RingProofs.continueRun(List.cons(q, List.nil(RingPrimitives.Primitive)), out))
    Eq.trans(first, RingProofs.runOneRan(q, mid, after, actual2))
  }

  def runThreeRan (p: RingPrimitives.Primitive)(q: RingPrimitives.Primitive)(r: RingPrimitives.Primitive)
      (before: RingPrimitives.World)(mid1: RingPrimitives.World)(mid2: RingPrimitives.World)(after: RingPrimitives.World)
      (actual1: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, before), RingPrimitives.Outcome.ran(mid1)))
      (actual2: Eq(RingPrimitives.Outcome, RingPrimitives.step(q, mid1), RingPrimitives.Outcome.ran(mid2)))
      (actual3: Eq(RingPrimitives.Outcome, RingPrimitives.step(r, mid2), RingPrimitives.Outcome.ran(after)))
      : Eq(RingPrimitives.Outcome, RingPrimitives.run(List.cons(p, List.cons(q, List.cons(r, List.nil(RingPrimitives.Primitive)))), before), RingPrimitives.Outcome.ran(after)) := {
    let first := congrArg(actual1, RingPrimitives.Outcome, fun (out: RingPrimitives.Outcome): RingPrimitives.Outcome =>
      RingProofs.continueRun(List.cons(q, List.cons(r, List.nil(RingPrimitives.Primitive))), out))
    Eq.trans(first, RingProofs.runTwoRan(q, r, mid1, mid2, after, actual2, actual3))
  }

  def oneMacroRan (bytes: Nat)(action: Concurrent.Action)(s: Concurrent.State)(next: Concurrent.State)(p: RingPrimitives.Primitive)
      (shape: Eq(List(RingPrimitives.Primitive), RingPrimitives.implementation(bytes, action, s), List.cons(p, List.nil(RingPrimitives.Primitive))))
      (safe: RingObligations.Safe(p, RingPrimitives.world(bytes, s)))
      (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, RingPrimitives.world(bytes, s)), RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, next))))
      (source: Eq(Concurrent.Outcome, Concurrent.step(action, s), Concurrent.Outcome.ran(next)))
      : RingObligations.CorrectMacro(bytes, action, s) := {
    let before := RingPrimitives.world(bytes, s)
    let target := RingPrimitives.modelResult(bytes, Concurrent.step(action, s))
    let model := congrArg(source, RingPrimitives.Outcome, fun (out: Concurrent.Outcome): RingPrimitives.Outcome => RingPrimitives.modelResult(bytes, out))
    let result := Eq.trans(RingProofs.runOneRan(p, before, RingPrimitives.world(bytes, next), actual), Eq.symm(model))
    let resultAtModel := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => Eq(RingPrimitives.Outcome, RingPrimitives.run(ps, before), target), result)
    let audit := RingObligations.Audit.advance(p, List.nil(RingPrimitives.Primitive), before, RingPrimitives.world(bytes, next),
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, next)), safe, actual, RingObligations.Audit.done(RingPrimitives.world(bytes, next)))
    let auditAtModel := Eq.substP(Eq.symm(model), fun (out: RingPrimitives.Outcome): Prop => RingObligations.Audit(List.cons(p, List.nil(RingPrimitives.Primitive)), before, out), audit)
    let auditAtImplementation := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => RingObligations.Audit(ps, before, target), auditAtModel)
    And.intro(resultAtModel, auditAtImplementation)
  }

  def oneMacroBlocked (bytes: Nat)(action: Concurrent.Action)(s: Concurrent.State)(p: RingPrimitives.Primitive)
      (shape: Eq(List(RingPrimitives.Primitive), RingPrimitives.implementation(bytes, action, s), List.cons(p, List.nil(RingPrimitives.Primitive))))
      (safe: RingObligations.Safe(p, RingPrimitives.world(bytes, s)))
      (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, RingPrimitives.world(bytes, s)), RingPrimitives.Outcome.blocked))
      (source: Eq(Concurrent.Outcome, Concurrent.step(action, s), Concurrent.Outcome.blocked))
      : RingObligations.CorrectMacro(bytes, action, s) := {
    let before := RingPrimitives.world(bytes, s)
    let target := RingPrimitives.modelResult(bytes, Concurrent.step(action, s))
    let model := congrArg(source, RingPrimitives.Outcome, fun (out: Concurrent.Outcome): RingPrimitives.Outcome => RingPrimitives.modelResult(bytes, out))
    let result := Eq.trans(RingProofs.runOneBlocked(p, before, actual), Eq.symm(model))
    let resultAtModel := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => Eq(RingPrimitives.Outcome, RingPrimitives.run(ps, before), target), result)
    let audit := RingObligations.Audit.blocked(p, List.nil(RingPrimitives.Primitive), before, safe, actual)
    let auditAtModel := Eq.substP(Eq.symm(model), fun (out: RingPrimitives.Outcome): Prop => RingObligations.Audit(List.cons(p, List.nil(RingPrimitives.Primitive)), before, out), audit)
    let auditAtImplementation := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => RingObligations.Audit(ps, before, target), auditAtModel)
    And.intro(resultAtModel, auditAtImplementation)
  }

  def twoMacroRan (bytes: Nat)(action: Concurrent.Action)(s: Concurrent.State)(next: Concurrent.State)
      (p: RingPrimitives.Primitive)(q: RingPrimitives.Primitive)
      (shape: Eq(List(RingPrimitives.Primitive), RingPrimitives.implementation(bytes, action, s), RingPrimitives.two(p, q)))
      (safe1: RingObligations.Safe(p, RingPrimitives.world(bytes, s)))
      (actual1: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, RingPrimitives.world(bytes, s)), RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, s))))
      (safe2: RingObligations.Safe(q, RingPrimitives.world(bytes, s)))
      (actual2: Eq(RingPrimitives.Outcome, RingPrimitives.step(q, RingPrimitives.world(bytes, s)), RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, next))))
      (source: Eq(Concurrent.Outcome, Concurrent.step(action, s), Concurrent.Outcome.ran(next)))
      : RingObligations.CorrectMacro(bytes, action, s) := {
    let before := RingPrimitives.world(bytes, s)
    let target := RingPrimitives.modelResult(bytes, Concurrent.step(action, s))
    let model := congrArg(source, RingPrimitives.Outcome, fun (out: Concurrent.Outcome): RingPrimitives.Outcome => RingPrimitives.modelResult(bytes, out))
    let result := Eq.trans(RingProofs.runTwoRan(p, q, before, before, RingPrimitives.world(bytes, next), actual1, actual2), Eq.symm(model))
    let resultAtModel := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => Eq(RingPrimitives.Outcome, RingPrimitives.run(ps, before), target), result)
    let tail := RingObligations.Audit.advance(q, List.nil(RingPrimitives.Primitive), before, RingPrimitives.world(bytes, next),
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, next)), safe2, actual2,
      RingObligations.Audit.done(RingPrimitives.world(bytes, next)))
    let audit := RingObligations.Audit.advance(p, List.cons(q, List.nil(RingPrimitives.Primitive)), before, before,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, next)), safe1, actual1, tail)
    let auditAtModel := Eq.substP(Eq.symm(model), fun (out: RingPrimitives.Outcome): Prop => RingObligations.Audit(RingPrimitives.two(p, q), before, out), audit)
    let auditAtImplementation := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => RingObligations.Audit(ps, before, target), auditAtModel)
    And.intro(resultAtModel, auditAtImplementation)
  }

  def nilMacroRan (bytes: Nat)(action: Concurrent.Action)(s: Concurrent.State)(next: Concurrent.State)
      (shape: Eq(List(RingPrimitives.Primitive), RingPrimitives.implementation(bytes, action, s), List.nil(RingPrimitives.Primitive)))
      (worlds: Eq(RingPrimitives.World, RingPrimitives.world(bytes, s), RingPrimitives.world(bytes, next)))
      (source: Eq(Concurrent.Outcome, Concurrent.step(action, s), Concurrent.Outcome.ran(next)))
      : RingObligations.CorrectMacro(bytes, action, s) := {
    let before := RingPrimitives.world(bytes, s)
    let target := RingPrimitives.modelResult(bytes, Concurrent.step(action, s))
    let model := congrArg(source, RingPrimitives.Outcome, fun (out: Concurrent.Outcome): RingPrimitives.Outcome => RingPrimitives.modelResult(bytes, out))
    let result := Eq.trans(congrArg(worlds, RingPrimitives.Outcome, RingPrimitives.Outcome.ran), Eq.symm(model))
    let resultAtImplementation := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => Eq(RingPrimitives.Outcome, RingPrimitives.run(ps, before), target), result)
    let audit := Eq.substP(worlds, fun (w: RingPrimitives.World): Prop => RingObligations.Audit(List.nil(RingPrimitives.Primitive), before, RingPrimitives.Outcome.ran(w)), RingObligations.Audit.done(before))
    let auditAtModel := Eq.substP(Eq.symm(model), fun (out: RingPrimitives.Outcome): Prop => RingObligations.Audit(List.nil(RingPrimitives.Primitive), before, out), audit)
    let auditAtImplementation := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => RingObligations.Audit(ps, before, target), auditAtModel)
    And.intro(resultAtImplementation, auditAtImplementation)
  }

  def threeMacroRan (bytes: Nat)(action: Concurrent.Action)(s: Concurrent.State)(next: Concurrent.State)
      (p: RingPrimitives.Primitive)(q: RingPrimitives.Primitive)(r: RingPrimitives.Primitive)
      (mid1: RingPrimitives.World)(mid2: RingPrimitives.World)
      (shape: Eq(List(RingPrimitives.Primitive), RingPrimitives.implementation(bytes, action, s), List.cons(p, List.cons(q, List.cons(r, List.nil(RingPrimitives.Primitive))))))
      (safe1: RingObligations.Safe(p, RingPrimitives.world(bytes, s)))
      (actual1: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, RingPrimitives.world(bytes, s)), RingPrimitives.Outcome.ran(mid1)))
      (safe2: RingObligations.Safe(q, mid1))
      (actual2: Eq(RingPrimitives.Outcome, RingPrimitives.step(q, mid1), RingPrimitives.Outcome.ran(mid2)))
      (safe3: RingObligations.Safe(r, mid2))
      (actual3: Eq(RingPrimitives.Outcome, RingPrimitives.step(r, mid2), RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, next))))
      (source: Eq(Concurrent.Outcome, Concurrent.step(action, s), Concurrent.Outcome.ran(next)))
      : RingObligations.CorrectMacro(bytes, action, s) := {
    let before := RingPrimitives.world(bytes, s)
    let target := RingPrimitives.modelResult(bytes, Concurrent.step(action, s))
    let model := congrArg(source, RingPrimitives.Outcome, fun (out: Concurrent.Outcome): RingPrimitives.Outcome => RingPrimitives.modelResult(bytes, out))
    let result := Eq.trans(RingProofs.runThreeRan(p, q, r, before, mid1, mid2, RingPrimitives.world(bytes, next), actual1, actual2, actual3), Eq.symm(model))
    let resultAtImplementation := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => Eq(RingPrimitives.Outcome, RingPrimitives.run(ps, before), target), result)
    let third := RingObligations.Audit.advance(r, List.nil(RingPrimitives.Primitive), mid2, RingPrimitives.world(bytes, next),
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, next)), safe3, actual3,
      RingObligations.Audit.done(RingPrimitives.world(bytes, next)))
    let second := RingObligations.Audit.advance(q, List.cons(r, List.nil(RingPrimitives.Primitive)), mid1, mid2,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, next)), safe2, actual2, third)
    let audit := RingObligations.Audit.advance(p, List.cons(q, List.cons(r, List.nil(RingPrimitives.Primitive))), before, mid1,
      RingPrimitives.Outcome.ran(RingPrimitives.world(bytes, next)), safe1, actual1, second)
    let auditAtModel := Eq.substP(Eq.symm(model), fun (out: RingPrimitives.Outcome): Prop => RingObligations.Audit(List.cons(p, List.cons(q, List.cons(r, List.nil(RingPrimitives.Primitive)))), before, out), audit)
    let auditAtImplementation := Eq.substP(Eq.symm(shape), fun (ps: List(RingPrimitives.Primitive)): Prop => RingObligations.Audit(ps, before, target), auditAtModel)
    And.intro(resultAtImplementation, auditAtImplementation)
  }

  def waitStep (epoch: Nat)(s: Mbarrier.State)(live: Eq(Bool, s.live, Bool.true))
      : Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.wait(epoch), s), Mbarrier.wait(epoch, s)) := {
    match s returning Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.wait(epoch), s), Mbarrier.wait(epoch, s)) with
    | Mbarrier.State.mk isLive fenced visible current arrival expected completed observed => {
      match isLive returning Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.wait(epoch), s), Mbarrier.wait(epoch, s)) with
      | Bool.true => Eq.refl(Mbarrier.wait(epoch, s))
      | Bool.false => False.elimP(Bool.falseNeTrue(live), Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.wait(epoch), s), Mbarrier.wait(epoch, s)))
    }
  }

  def emptyWaitActualRan (epoch: Nat)(before: RingPrimitives.World)(after: Mbarrier.State)(live: Eq(Bool, before.empty.live, Bool.true))
      (actual: Eq(Mbarrier.Outcome, Mbarrier.wait(epoch, before.empty), Mbarrier.Outcome.ran(after)))
      : Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), before), RingPrimitives.Outcome.ran(RingPrimitives.World.mk(before.full, after, before.joined))) :=
    congrArg(Eq.trans(RingProofs.waitStep(epoch, before.empty, live), actual), RingPrimitives.Outcome,
      fun (out: Mbarrier.Outcome): RingPrimitives.Outcome => RingPrimitives.emptyResult(before, out))

  def emptyWaitActualBlocked (epoch: Nat)(before: RingPrimitives.World)(live: Eq(Bool, before.empty.live, Bool.true))
      (actual: Eq(Mbarrier.Outcome, Mbarrier.wait(epoch, before.empty), Mbarrier.Outcome.blocked))
      : Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), before), RingPrimitives.Outcome.blocked) :=
    congrArg(Eq.trans(RingProofs.waitStep(epoch, before.empty, live), actual), RingPrimitives.Outcome,
      fun (out: Mbarrier.Outcome): RingPrimitives.Outcome => RingPrimitives.emptyResult(before, out))

  def fullWaitActualBlocked (epoch: Nat)(before: RingPrimitives.World)(live: Eq(Bool, before.full.live, Bool.true))
      (actual: Eq(Mbarrier.Outcome, Mbarrier.wait(epoch, before.full), Mbarrier.Outcome.blocked))
      : Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), before), RingPrimitives.Outcome.blocked) :=
    congrArg(Eq.trans(RingProofs.waitStep(epoch, before.full, live), actual), RingPrimitives.Outcome,
      fun (out: Mbarrier.Outcome): RingPrimitives.Outcome => RingPrimitives.fullResult(before, out))

  def fullWaitActualRan (epoch: Nat)(before: RingPrimitives.World)(after: Mbarrier.State)(live: Eq(Bool, before.full.live, Bool.true))
      (actual: Eq(Mbarrier.Outcome, Mbarrier.wait(epoch, before.full), Mbarrier.Outcome.ran(after)))
      : Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), before), RingPrimitives.Outcome.ran(RingPrimitives.World.mk(after, before.empty, before.joined))) :=
    congrArg(Eq.trans(RingProofs.waitStep(epoch, before.full, live), actual), RingPrimitives.Outcome,
      fun (out: Mbarrier.Outcome): RingPrimitives.Outcome => RingPrimitives.fullResult(before, out))

  def emptyWaitAuditRan (epoch: Nat)(before: RingPrimitives.World)(after: Mbarrier.State)
      (safe: RingObligations.Safe(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), before))
      (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), before), RingPrimitives.Outcome.ran(RingPrimitives.World.mk(before.full, after, before.joined))))
      : RingObligations.Audit(List.cons(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), List.nil(RingPrimitives.Primitive)), before,
        RingPrimitives.Outcome.ran(RingPrimitives.World.mk(before.full, after, before.joined))) :=
    RingObligations.Audit.advance(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), List.nil(RingPrimitives.Primitive), before,
      RingPrimitives.World.mk(before.full, after, before.joined), RingPrimitives.Outcome.ran(RingPrimitives.World.mk(before.full, after, before.joined)),
      safe, actual, RingObligations.Audit.done(RingPrimitives.World.mk(before.full, after, before.joined)))

  def emptyWaitAuditBlocked (epoch: Nat)(before: RingPrimitives.World)
      (safe: RingObligations.Safe(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), before))
      (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), before), RingPrimitives.Outcome.blocked))
      : RingObligations.Audit(List.cons(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), List.nil(RingPrimitives.Primitive)), before, RingPrimitives.Outcome.blocked) :=
    RingObligations.Audit.blocked(RingPrimitives.Primitive.empty(Mbarrier.Action.wait(epoch)), List.nil(RingPrimitives.Primitive), before, safe, actual)

  def fullWaitAuditBlocked (epoch: Nat)(before: RingPrimitives.World)
      (safe: RingObligations.Safe(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), before))
      (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), before), RingPrimitives.Outcome.blocked))
      : RingObligations.Audit(List.cons(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), List.nil(RingPrimitives.Primitive)), before, RingPrimitives.Outcome.blocked) :=
    RingObligations.Audit.blocked(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), List.nil(RingPrimitives.Primitive), before, safe, actual)

  def fullWaitAuditRan (epoch: Nat)(before: RingPrimitives.World)(after: Mbarrier.State)
      (safe: RingObligations.Safe(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), before))
      (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), before), RingPrimitives.Outcome.ran(RingPrimitives.World.mk(after, before.empty, before.joined))))
      : RingObligations.Audit(List.cons(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), List.nil(RingPrimitives.Primitive)), before,
        RingPrimitives.Outcome.ran(RingPrimitives.World.mk(after, before.empty, before.joined))) :=
    RingObligations.Audit.advance(RingPrimitives.Primitive.full(Mbarrier.Action.wait(epoch)), List.nil(RingPrimitives.Primitive), before,
      RingPrimitives.World.mk(after, before.empty, before.joined), RingPrimitives.Outcome.ran(RingPrimitives.World.mk(after, before.empty, before.joined)),
      safe, actual, RingObligations.Audit.done(RingPrimitives.World.mk(after, before.empty, before.joined)))

  def acquireIdle (bytes: Nat)(n: Nat)(consumerDone: Bool)
      : And(Eq(RingPrimitives.Outcome,
          RingPrimitives.run(RingPrimitives.implementation(bytes, Concurrent.Action.acquire,
            Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.empty, n, Bool.false)),
            RingPrimitives.world(bytes, Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.empty, n, Bool.false))),
          RingPrimitives.modelResult(bytes, Concurrent.step(Concurrent.Action.acquire,
            Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.empty, n, Bool.false)))),
        RingObligations.Audit(RingPrimitives.implementation(bytes, Concurrent.Action.acquire,
          Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.empty, n, Bool.false)),
          RingPrimitives.world(bytes, Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.empty, n, Bool.false)),
          RingPrimitives.modelResult(bytes, Concurrent.step(Concurrent.Action.acquire,
            Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.empty, n, Bool.false))))) := {
    let beforeState := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.empty, n, Bool.false)
    let afterState := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.held, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.writing, n, Bool.false)
    let before := RingPrimitives.world(bytes, beforeState)
    let primitive := RingPrimitives.Primitive.empty(Mbarrier.Action.wait(n))
    let safe := And.intro(And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)), Or.inr(Eq(Nat, Nat.succ(n), n), Eq.refl(Nat.succ(n))))
    let barrierActual := RingProofs.waitPrevious(n, Bool.false)
    let actual := RingProofs.emptyWaitActualRan(n, before, Mbarrier.waiting(Nat.succ(n), Bool.true), Eq.refl(Bool.true), barrierActual)
    RingProofs.oneMacroRan(bytes, Concurrent.Action.acquire, beforeState, afterState, primitive,
      Eq.refl(List.cons(primitive, List.nil(RingPrimitives.Primitive))), safe, actual, Eq.refl(Concurrent.Outcome.ran(afterState)))
  }

  def acquirePending (bytes: Nat)(n: Nat)(consumerDone: Bool)
      : RingObligations.CorrectMacro(bytes, Concurrent.Action.acquire,
          Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.pending, n, Bool.true)) := {
    let s := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.pending, n, Bool.true)
    let before := RingPrimitives.world(bytes, s)
    let primitive := RingPrimitives.Primitive.empty(Mbarrier.Action.wait(Nat.succ(n)))
    let safe := And.intro(And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)), Or.inl(Eq(Nat, Nat.succ(n), Nat.succ(Nat.succ(n))), Eq.refl(Nat.succ(n))))
    let actual := RingProofs.emptyWaitActualBlocked(Nat.succ(n), before, Eq.refl(Bool.true), RingProofs.waitCurrent(Nat.succ(n), Bool.true))
    RingProofs.oneMacroBlocked(bytes, Concurrent.Action.acquire, s, primitive,
      Eq.refl(List.cons(primitive, List.nil(RingPrimitives.Primitive))), safe, actual, Eq.refl(Concurrent.Outcome.blocked))
  }

  def acquireFull (bytes: Nat)(n: Nat)(consumerDone: Bool)
      : RingObligations.CorrectMacro(bytes, Concurrent.Action.acquire,
          Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.full, n, Bool.false)) := {
    let s := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.full, n, Bool.false)
    let before := RingPrimitives.world(bytes, s)
    let primitive := RingPrimitives.Primitive.empty(Mbarrier.Action.wait(Nat.succ(n)))
    let safe := And.intro(And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)), Or.inl(Eq(Nat, Nat.succ(n), Nat.succ(Nat.succ(n))), Eq.refl(Nat.succ(n))))
    let actual := RingProofs.emptyWaitActualBlocked(Nat.succ(n), before, Eq.refl(Bool.true), RingProofs.waitCurrent(Nat.succ(n), Bool.true))
    RingProofs.oneMacroBlocked(bytes, Concurrent.Action.acquire, s, primitive,
      Eq.refl(List.cons(primitive, List.nil(RingPrimitives.Primitive))), safe, actual, Eq.refl(Concurrent.Outcome.blocked))
  }

  def acquireReading (bytes: Nat)(n: Nat)
      : RingObligations.CorrectMacro(bytes, Concurrent.Action.acquire,
          Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.Phase.held, n), Concurrent.Slot.reading, n, Bool.false)) := {
    let s := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.Phase.held, n), Concurrent.Slot.reading, n, Bool.false)
    let before := RingPrimitives.world(bytes, s)
    let primitive := RingPrimitives.Primitive.empty(Mbarrier.Action.wait(Nat.succ(n)))
    let safe := And.intro(And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)), Or.inl(Eq(Nat, Nat.succ(n), Nat.succ(Nat.succ(n))), Eq.refl(Nat.succ(n))))
    let actual := RingProofs.emptyWaitActualBlocked(Nat.succ(n), before, Eq.refl(Bool.true), RingProofs.waitCurrent(Nat.succ(n), Bool.true))
    RingProofs.oneMacroBlocked(bytes, Concurrent.Action.acquire, s, primitive,
      Eq.refl(List.cons(primitive, List.nil(RingPrimitives.Primitive))), safe, actual, Eq.refl(Concurrent.Outcome.blocked))
  }

  def beqAddSuccLeft (a: Nat)(b: Nat): Eq(Bool, Nat.beq(Nat.add(Nat.succ(a), b), 0), Bool.false) decreases structural(b) := {
    match b returning Eq(Bool, Nat.beq(Nat.add(Nat.succ(a), b), 0), Bool.false) with
    | Nat.zero => Eq.refl(Bool.false)
    | Nat.succ k => RingProofs.beqAddSuccLeft(Nat.succ(a), k)
  }

  def settleByTest (test: Bool)(s: Mbarrier.State): Mbarrier.State := {
    match s.arrival returning Mbarrier.State with
    | Bool.true => s
    | Bool.false => {
      match test returning Mbarrier.State with
      | Bool.false => s
      | Bool.true => Mbarrier.State.mk(s.live, s.fenced, s.visible, Nat.succ(s.epoch), Bool.true, 0, 0, Bool.false)
    }
  }

  def settlePendingNoDebt (epoch: Nat)(expected: Nat)(noDebt: Eq(Bool, Nat.beq(expected, 0), Bool.false))
      : Eq(Mbarrier.State,
          Mbarrier.settle(Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, expected, 0, Bool.true)),
          Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, expected, 0, Bool.true)) :=
    Eq.substP(Eq.symm(noDebt),
      fun (test: Bool): Prop => Eq(Mbarrier.State, RingProofs.settleByTest(test, Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, expected, 0, Bool.true)),
        Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, expected, 0, Bool.true)),
      Eq.refl(Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, expected, 0, Bool.true)))

  def arriveFreshRaw (epoch: Nat)(k: Nat)
      : Eq(Mbarrier.Outcome, Mbarrier.arrive(Nat.succ(k), Mbarrier.waiting(epoch, Bool.true)),
          Mbarrier.Outcome.ran(Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, Nat.add(0, Nat.succ(k)), 0, Bool.true))) :=
    congrArg(RingProofs.settlePendingNoDebt(epoch, Nat.add(0, Nat.succ(k)), RingProofs.beqAddSuccLeft(0, k)), Mbarrier.Outcome, Mbarrier.Outcome.ran)

  def arrivePending (epoch: Nat)(bytes: Nat)(positive: Nat.lt(0, bytes))
      : Eq(Mbarrier.Outcome, Mbarrier.arrive(bytes, Mbarrier.waiting(epoch, Bool.true)), Mbarrier.Outcome.ran(Mbarrier.pending(epoch, bytes))) decreases structural(bytes) := {
    match bytes returning Eq(Mbarrier.Outcome, Mbarrier.arrive(bytes, Mbarrier.waiting(epoch, Bool.true)), Mbarrier.Outcome.ran(Mbarrier.pending(epoch, bytes))) with
    | Nat.zero => False.elimP(Bool.falseNeTrue(positive), Eq(Mbarrier.Outcome, Mbarrier.arrive(bytes, Mbarrier.waiting(epoch, Bool.true)), Mbarrier.Outcome.ran(Mbarrier.pending(epoch, bytes))))
    | Nat.succ k => {
      let rawEq := RingProofs.arriveFreshRaw(epoch, k)
      let canonical := congrArg(Arithmetic.zeroAdd(Nat.succ(k)), Mbarrier.Outcome,
        fun (expected: Nat): Mbarrier.Outcome => Mbarrier.Outcome.ran(Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, expected, 0, Bool.true)))
      Eq.trans(rawEq, canonical)
    }
  }

  def arriveStep (bytes: Nat)(s: Mbarrier.State)(after: Mbarrier.State)(live: Eq(Bool, s.live, Bool.true))(actual: Eq(Mbarrier.Outcome, Mbarrier.arrive(bytes, s), Mbarrier.Outcome.ran(after)))
      : Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.arrive(bytes), s), Mbarrier.Outcome.ran(after)) := {
    match s returning Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.arrive(bytes), s), Mbarrier.Outcome.ran(after)) with
    | Mbarrier.State.mk isLive fenced visible epoch arrival expected completed observed => {
      match isLive returning Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.arrive(bytes), s), Mbarrier.Outcome.ran(after)) with
      | Bool.true => actual
      | Bool.false => False.elimP(Bool.falseNeTrue(live), Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.arrive(bytes), s), Mbarrier.Outcome.ran(after)))
    }
  }

  def fullArriveActualRan (bytes: Nat)(before: RingPrimitives.World)(after: Mbarrier.State)(live: Eq(Bool, before.full.live, Bool.true))
      (actual: Eq(Mbarrier.Outcome, Mbarrier.arrive(bytes, before.full), Mbarrier.Outcome.ran(after)))
      : Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.full(Mbarrier.Action.arrive(bytes)), before), RingPrimitives.Outcome.ran(RingPrimitives.World.mk(after, before.empty, before.joined))) :=
    congrArg(RingProofs.arriveStep(bytes, before.full, after, live, actual), RingPrimitives.Outcome,
      fun (out: Mbarrier.Outcome): RingPrimitives.Outcome => RingPrimitives.fullResult(before, out))

  def issueWriting (bytes: Nat)(n: Nat)(consumerDone: Bool)(positive: Nat.lt(0, bytes)
      ): RingObligations.CorrectMacro(bytes, Concurrent.Action.issue,
          Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.held, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.writing, n, Bool.false)) := {
    let s := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.held, n), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.writing, n, Bool.false)
    let next := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.pending, n, Bool.true)
    let before := RingPrimitives.world(bytes, s)
    let primitive := RingPrimitives.Primitive.full(Mbarrier.Action.arrive(bytes))
    let safe := And.intro(Or.inl(Eq(Mbarrier.State, before.full, Mbarrier.initial), And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true))),
      And.intro(Eq.refl(Bool.true), And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true))))
    let actual := RingProofs.fullArriveActualRan(bytes, before, Mbarrier.pending(n, bytes), Eq.refl(Bool.true), RingProofs.arrivePending(n, bytes, positive))
    RingProofs.oneMacroRan(bytes, Concurrent.Action.issue, s, next, primitive,
      Eq.refl(List.cons(primitive, List.nil(RingPrimitives.Primitive))), safe, actual, Eq.refl(Concurrent.Outcome.ran(next)))
  }

  def completeDebtEq (bytes: Nat): Eq(Bool, Nat.beq(bytes, Nat.add(0, bytes)), Bool.true) :=
    Eq.symm(Eq.trans(Eq.symm(Lib.beqRefl(bytes)), congrArg(Eq.symm(Arithmetic.zeroAdd(bytes)), Bool, fun (n: Nat): Bool => Nat.beq(bytes, n))))

  def settleComplete (epoch: Nat)(bytes: Nat)(debtEq: Eq(Bool, Nat.beq(bytes, Nat.add(0, bytes)), Bool.true))
      : Eq(Mbarrier.State,
          Mbarrier.settle(Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, bytes, Nat.add(0, bytes), Bool.true)),
          Mbarrier.waiting(Nat.succ(epoch), Bool.false)) :=
    Eq.substP(Eq.symm(debtEq),
      fun (test: Bool): Prop => Eq(Mbarrier.State,
        RingProofs.settleByTest(test, Mbarrier.State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, bytes, Nat.add(0, bytes), Bool.true)),
        Mbarrier.waiting(Nat.succ(epoch), Bool.false)),
      Eq.refl(Mbarrier.waiting(Nat.succ(epoch), Bool.false)))

  def completePendingRaw (epoch: Nat)(bytes: Nat)
      : Eq(Mbarrier.Outcome, Mbarrier.liveStep(Mbarrier.Action.complete(bytes), Mbarrier.pending(epoch, bytes)), Mbarrier.Outcome.ran(Mbarrier.waiting(Nat.succ(epoch), Bool.false))) :=
    congrArg(RingProofs.settleComplete(epoch, bytes, RingProofs.completeDebtEq(bytes)), Mbarrier.Outcome, Mbarrier.Outcome.ran)

  def completeStep (bytes: Nat)(s: Mbarrier.State)(after: Mbarrier.State)(live: Eq(Bool, s.live, Bool.true))
      (actual: Eq(Mbarrier.Outcome, Mbarrier.liveStep(Mbarrier.Action.complete(bytes), s), Mbarrier.Outcome.ran(after)))
      : Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.complete(bytes), s), Mbarrier.Outcome.ran(after)) := {
    match s returning Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.complete(bytes), s), Mbarrier.Outcome.ran(after)) with
    | Mbarrier.State.mk isLive fenced visible epoch arrival expected completed observed => {
      match isLive returning Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.complete(bytes), s), Mbarrier.Outcome.ran(after)) with
      | Bool.true => actual
      | Bool.false => False.elimP(Bool.falseNeTrue(live), Eq(Mbarrier.Outcome, Mbarrier.step(Mbarrier.Action.complete(bytes), s), Mbarrier.Outcome.ran(after)))
    }
  }

  def fullCompleteActualRan (bytes: Nat)(before: RingPrimitives.World)(after: Mbarrier.State)(live: Eq(Bool, before.full.live, Bool.true))
      (actual: Eq(Mbarrier.Outcome, Mbarrier.liveStep(Mbarrier.Action.complete(bytes), before.full), Mbarrier.Outcome.ran(after)))
      : Eq(RingPrimitives.Outcome, RingPrimitives.step(RingPrimitives.Primitive.full(Mbarrier.Action.complete(bytes)), before), RingPrimitives.Outcome.ran(RingPrimitives.World.mk(after, before.empty, before.joined))) :=
    congrArg(RingProofs.completeStep(bytes, before.full, after, live, actual), RingPrimitives.Outcome,
      fun (out: Mbarrier.Outcome): RingPrimitives.Outcome => RingPrimitives.fullResult(before, out))

  def completePending (bytes: Nat)(n: Nat)(consumerDone: Bool)
      : RingObligations.CorrectMacro(bytes, Concurrent.Action.complete,
          Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.pending, n, Bool.true)) := {
    let s := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.pending, n, Bool.true)
    let next := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, Nat.succ(n)), Concurrent.Endpoint.mk(Concurrent.status(consumerDone), n), Concurrent.Slot.full, n, Bool.false)
    let before := RingPrimitives.world(bytes, s)
    let primitive := RingPrimitives.Primitive.full(Mbarrier.Action.complete(bytes))
    let safe := And.intro(And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)), And.intro(Eq.refl(Bool.false), And.intro(Eq.refl(bytes), Eq.refl(0))))
    let actual := RingProofs.fullCompleteActualRan(bytes, before, Mbarrier.waiting(Nat.succ(n), Bool.false), Eq.refl(Bool.true), RingProofs.completePendingRaw(n, bytes))
    RingProofs.oneMacroRan(bytes, Concurrent.Action.complete, s, next, primitive,
      Eq.refl(List.cons(primitive, List.nil(RingPrimitives.Primitive))), safe, actual, Eq.refl(Concurrent.Outcome.ran(next)))
  }

  def awaitIdle (bytes: Nat)(n: Nat)(producerDone: Bool)
      : RingObligations.CorrectMacro(bytes, Concurrent.Action.await,
          Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.status(producerDone), n), Concurrent.Endpoint.mk(Concurrent.Phase.ready, n), Concurrent.Slot.empty, n, Bool.false)) := {
