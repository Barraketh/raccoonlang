  def closeFinished (bytes: Nat)(n: Nat)
      : RingObligations.CorrectMacro(bytes, Concurrent.Action.close,
          Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.done, n), Concurrent.Endpoint.mk(Concurrent.Phase.done, n), Concurrent.Slot.empty, n, Bool.false)) := {
    let s := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.done, n), Concurrent.Endpoint.mk(Concurrent.Phase.done, n), Concurrent.Slot.empty, n, Bool.false)
    let next := Concurrent.State.mk(Bool.false, Concurrent.Endpoint.mk(Concurrent.Phase.done, n), Concurrent.Endpoint.mk(Concurrent.Phase.done, n), Concurrent.Slot.empty, n, Bool.false)
    let before := RingPrimitives.world(bytes, s)
    let join := RingPrimitives.Primitive.join
    let fullInvalidate := RingPrimitives.Primitive.full(Mbarrier.Action.invalidate)
    let emptyInvalidate := RingPrimitives.Primitive.empty(Mbarrier.Action.invalidate)
    let mid1 := RingPrimitives.World.mk(before.full, before.empty, Bool.true)
    let mid2 := RingPrimitives.World.mk(Mbarrier.dead, before.empty, Bool.true)
    let after := RingPrimitives.world(bytes, next)
    let quiescentFull := And.intro(Eq.refl(Bool.true), And.intro(Eq.refl(0), Eq.refl(0)))
    let quiescentEmpty := And.intro(Eq.refl(Bool.true), And.intro(Eq.refl(0), Eq.refl(0)))
    let safeJoin := And.intro(quiescentFull, quiescentEmpty)
    let safeFull := And.intro(And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)), And.intro(Eq.refl(Bool.true), quiescentFull))
    let safeEmpty := And.intro(And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)), And.intro(Eq.refl(Bool.true), quiescentEmpty))
    RingProofs.threeMacroRan(bytes, Concurrent.Action.close, s, next, join, fullInvalidate, emptyInvalidate, mid1, mid2,
      Eq.refl(List.cons(join, List.cons(fullInvalidate, List.cons(emptyInvalidate, List.nil(RingPrimitives.Primitive))))),
      safeJoin, Eq.refl(RingPrimitives.Outcome.ran(mid1)), safeFull, Eq.refl(RingPrimitives.Outcome.ran(mid2)), safeEmpty,
      Eq.refl(RingPrimitives.Outcome.ran(after)), Eq.refl(Concurrent.Outcome.ran(next)))
  }

  def macroCorrect (bytes: Nat)(action: Concurrent.Action)(s: Concurrent.State)
      (valid: Concurrent.Invariant(s))(allowed: Concurrent.Allowed(action, s))(positive: Nat.lt(0, bytes))
      : RingObligations.CorrectMacro(bytes, action, s) := {
    match valid returning RingObligations.CorrectMacro(bytes, action, s) with
    | Concurrent.Invariant.inactive n => False.elimP(Bool.falseNeTrue(allowed.left), RingObligations.CorrectMacro(bytes, action, s))
    | Concurrent.Invariant.idle n producerDone consumerDone => {
      match action returning RingObligations.CorrectMacro(bytes, action, s) with
      | Concurrent.Action.acquire => {
        match producerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.acquireIdle(bytes, n, consumerDone)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.issue => {
        match producerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.complete => Concurrent.emptyNotPending(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.await => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.awaitIdle(bytes, n, producerDone)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.read => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.release => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.finishProducer => {
        match producerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.finishProducerEmpty(bytes, n, consumerDone)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.finishConsumer => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.finishConsumerIdle(bytes, n, producerDone)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.close => {
        match producerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotDone(allowed.right.left, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => {
          match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
          | Bool.false => Concurrent.readyNotDone(allowed.right.right, RingObligations.CorrectMacro(bytes, action, s))
          | Bool.true => RingProofs.closeFinished(bytes, n)
    }
  }

    }
    | Concurrent.Invariant.writing n consumerDone => {
      match action returning RingObligations.CorrectMacro(bytes, action, s) with
      | Concurrent.Action.acquire => Concurrent.heldNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.issue => RingProofs.issueWriting(bytes, n, consumerDone, positive)
      | Concurrent.Action.complete => Concurrent.writingNotPending(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.await => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.awaitWriting(bytes, n, Bool.false)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.read => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.release => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.finishProducer => Concurrent.heldNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.finishConsumer => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.finishConsumerWriting(bytes, n)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.close => Concurrent.heldNotDone(allowed.right.left, RingObligations.CorrectMacro(bytes, action, s))
    }
    | Concurrent.Invariant.pending n consumerDone => {
      match action returning RingObligations.CorrectMacro(bytes, action, s) with
      | Concurrent.Action.acquire => RingProofs.acquirePending(bytes, n, consumerDone)
      | Concurrent.Action.issue => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.complete => RingProofs.completePending(bytes, n, consumerDone)
      | Concurrent.Action.await => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.awaitPending(bytes, n, Bool.false)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.read => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.release => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.finishProducer => RingProofs.finishProducerPending(bytes, n, consumerDone)
      | Concurrent.Action.finishConsumer => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.finishConsumerPending(bytes, n)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.close => Concurrent.readyNotDone(allowed.right.left, RingObligations.CorrectMacro(bytes, action, s))
    }
    | Concurrent.Invariant.full n consumerDone => {
      match action returning RingObligations.CorrectMacro(bytes, action, s) with
      | Concurrent.Action.acquire => RingProofs.acquireFull(bytes, n, consumerDone)
      | Concurrent.Action.issue => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.complete => Concurrent.fullNotPending(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.await => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.awaitFull(bytes, n)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.read => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.release => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.finishProducer => RingProofs.finishProducerFull(bytes, n, consumerDone)
      | Concurrent.Action.finishConsumer => {
        match consumerDone returning RingObligations.CorrectMacro(bytes, action, s) with
        | Bool.false => RingProofs.finishConsumerFull(bytes, n)
        | Bool.true => Concurrent.doneNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      }
      | Concurrent.Action.close => Concurrent.readyNotDone(allowed.right.left, RingObligations.CorrectMacro(bytes, action, s))
    }
    | Concurrent.Invariant.reading n => {
      match action returning RingObligations.CorrectMacro(bytes, action, s) with
      | Concurrent.Action.acquire => RingProofs.acquireReading(bytes, n)
      | Concurrent.Action.issue => Concurrent.readyNotHeld(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.complete => Concurrent.readingNotPending(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.await => Concurrent.heldNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.read => RingProofs.readReading(bytes, n)
      | Concurrent.Action.release => RingProofs.releaseReading(bytes, n)
      | Concurrent.Action.finishProducer => RingProofs.finishProducerReading(bytes, n)
      | Concurrent.Action.finishConsumer => Concurrent.heldNotReady(allowed.right, RingObligations.CorrectMacro(bytes, action, s))
      | Concurrent.Action.close => Concurrent.readyNotDone(allowed.right.left, RingObligations.CorrectMacro(bytes, action, s))
    }
  }


  def everyExecution (bytes: Nat)(actions: List(Concurrent.Action))(before: Concurrent.State)(after: Concurrent.State)
      (execution: Concurrent.Execution(actions, before, after))(valid: Concurrent.Invariant(before))(positive: Nat.lt(0, bytes))
      : RingObligations.History(bytes, actions, before, after) decreases structural(actions) := {
    match execution returning RingObligations.History(bytes, actions, before, after) with
    | Concurrent.Execution.done same => RingObligations.History.done(bytes, same)
    | Concurrent.Execution.advance action rest before mid after local actual tail =>
        RingObligations.History.advance(action, rest, before, mid, after, actual,
          RingProofs.macroCorrect(bytes, action, before, valid, local, positive),
          RingProofs.everyExecution(bytes, rest, mid, after, tail, Concurrent.advances(action, before, mid, valid, local, actual), positive))
    | Concurrent.Execution.blocked action rest before after local actual tail =>
        RingObligations.History.blocked(action, rest, before, after, actual,
          RingProofs.macroCorrect(bytes, action, before, valid, local, positive),
          RingProofs.everyExecution(bytes, rest, before, after, tail, valid, positive))
  }

  def everyKernel (producer: Endpoints.Cmd(Endpoints.Role.producer, Concurrent.Phase.ready, Concurrent.Phase.done))
      (consumer: Endpoints.Cmd(Endpoints.Role.consumer, Concurrent.Phase.ready, Concurrent.Phase.done))
      (producerRuntime: Contracts.Runtime)(consumerRuntime: Contracts.Runtime)(schedule: List(Scheduler.Choice))
      : RingObligations.History(Ring.bytes, Scheduler.kernel(producer, consumer, producerRuntime, consumerRuntime, schedule).actions,
          Concurrent.initial, Scheduler.kernel(producer, consumer, producerRuntime, consumerRuntime, schedule).state) := {
    let result := Scheduler.kernel(producer, consumer, producerRuntime, consumerRuntime, schedule)
    RingProofs.everyExecution(Ring.bytes, result.actions, Concurrent.initial, result.state, result.execution,
      Concurrent.Invariant.idle(0, Bool.false, Bool.false), Eq.refl(Bool.true))
  }

  def everyProgram (program: Ring.Program)(producerRuntime: Contracts.Runtime)(consumerRuntime: Contracts.Runtime)
      (schedule: List(Scheduler.Choice))
      : RingObligations.History(Ring.bytes, Ring.execute(program, producerRuntime, consumerRuntime, schedule).actions,
          Concurrent.initial, Ring.execute(program, producerRuntime, consumerRuntime, schedule).state) :=
    RingProofs.everyKernel(Ring.producerOf(program), Ring.consumerOf(program), producerRuntime, consumerRuntime, schedule)

  def retirementClose (bytes: Nat)(s: Concurrent.State)(joint: Scheduler.Joint(s))
      (producerEmpty: Eq(List(Concurrent.Action), joint.producer.actions, List.nil(Concurrent.Action)))
      (consumerEmpty: Eq(List(Concurrent.Action), joint.consumer.actions, List.nil(Concurrent.Action)))
      (positive: Nat.lt(0, bytes))
      : And(And(Concurrent.AccessSafe(Concurrent.Action.close, s), Concurrent.Invariant(Scheduler.closedState(s))),
          RingObligations.CorrectMacro(bytes, Concurrent.Action.close, s)) := {
    let retired := Scheduler.retirement(s, joint, producerEmpty, consumerEmpty)
    let producerDone := Endpoints.emptyDone(Endpoints.Role.producer, s.producer.phase, joint.producer, producerEmpty)
    let consumerDone := Endpoints.emptyDone(Endpoints.Role.consumer, s.consumer.phase, joint.consumer, consumerEmpty)
    let allowed := And.intro(joint.active, And.intro(producerDone, consumerDone))
    let close := RingProofs.macroCorrect(bytes, Concurrent.Action.close, s, joint.valid, allowed, positive)
    And.intro(And.intro(retired.left, retired.right), close)
  }

}
