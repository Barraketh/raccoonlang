import Mbarrier
import Concurrent

// The protocol implementation expands source operations into these primitives.
// CUDA implements publish by init-release fence + CTA synchronization, and join
// by a final CTA synchronization. Neither acquisition nor publication is an axiom.
namespace RingPrimitives {
  struct World: Type
   | mk (full: Mbarrier.State)(empty: Mbarrier.State)(joined: Bool): World
  inductive Primitive: Type
   | full (action: Mbarrier.Action): Primitive
   | empty (action: Mbarrier.Action): Primitive
   | proxyFence: Primitive
   | join: Primitive
  inductive Outcome: Type
   | ran (world: World): Outcome
   | blocked: Outcome
   | fault: Outcome
  def dead: World := World.mk(Mbarrier.dead, Mbarrier.dead, Bool.false)
  def fullResult (w: World)(out: Mbarrier.Outcome): Outcome := {
    match out returning Outcome with
    | Mbarrier.Outcome.ran next => Outcome.ran(World.mk(next, w.empty, w.joined))
    | Mbarrier.Outcome.blocked => Outcome.blocked
    | Mbarrier.Outcome.fault => Outcome.fault
  }
  def emptyResult (w: World)(out: Mbarrier.Outcome): Outcome := {
    match out returning Outcome with
    | Mbarrier.Outcome.ran next => Outcome.ran(World.mk(w.full, next, w.joined))
    | Mbarrier.Outcome.blocked => Outcome.blocked
    | Mbarrier.Outcome.fault => Outcome.fault
  }
  def step (p: Primitive)(w: World): Outcome := {
    match p returning Outcome with
    | Primitive.full action => RingPrimitives.fullResult(w, Mbarrier.step(action, w.full))
    | Primitive.empty action => RingPrimitives.emptyResult(w, Mbarrier.step(action, w.empty))
    | Primitive.proxyFence => Outcome.ran(w)
    | Primitive.join => Outcome.ran(World.mk(w.full, w.empty, Bool.true))
  }
  def run (ps: List(Primitive))(w: World): Outcome decreases structural(ps) := {
    match ps returning Outcome with
    | List.nil => Outcome.ran(w)
    | List.cons p rest => {
      match RingPrimitives.step(p, w) returning Outcome with
      | Outcome.ran next => RingPrimitives.run(rest, next)
      | Outcome.blocked => Outcome.blocked
      | Outcome.fault => Outcome.fault
    }
  }
  def two (a: Primitive)(b: Primitive): List(Primitive) := List.cons(a, List.cons(b, List.nil(Primitive)))
  def setup: List(Primitive) := List.cons(Primitive.full(Mbarrier.Action.init),
    List.cons(Primitive.empty(Mbarrier.Action.init), List.cons(Primitive.empty(Mbarrier.Action.arrive(0)),
    List.cons(Primitive.full(Mbarrier.Action.fenceInit), List.cons(Primitive.empty(Mbarrier.Action.fenceInit),
    List.cons(Primitive.full(Mbarrier.Action.publish), List.cons(Primitive.empty(Mbarrier.Action.publish), List.nil(Primitive))))))))

  def producerDone (p: Concurrent.Phase): Bool := {
    match p returning Bool with
    | Concurrent.Phase.done => Bool.true
    | _ => Bool.false
  }
  def emptyObserved (s: Concurrent.State): Bool := {
    match s.slot returning Bool with
    | Concurrent.Slot.empty => RingPrimitives.producerDone(s.producer.phase)
    | _ => Bool.true
  }
  def fullState (bytes: Nat)(s: Concurrent.State): Mbarrier.State := {
    match s.slot returning Mbarrier.State with
    | Concurrent.Slot.pending => Mbarrier.pending(s.round, bytes)
    | Concurrent.Slot.full => Mbarrier.waiting(Nat.succ(s.round), Bool.false)
    | Concurrent.Slot.reading => Mbarrier.waiting(Nat.succ(s.round), Bool.true)
    | _ => Mbarrier.waiting(s.round, Bool.true)
  }
  // This relation is a proposed representation invariant, not an assumption on
  // clients. The proof must show raw primitive steps implement every legal macro.
  def world (bytes: Nat)(s: Concurrent.State): World := {
    match s.active returning World with
    | Bool.false => World.mk(Mbarrier.dead, Mbarrier.dead, Bool.true)
    | Bool.true => World.mk(RingPrimitives.fullState(bytes, s),
        Mbarrier.waiting(Nat.succ(s.round), RingPrimitives.emptyObserved(s)), Bool.false)
  }
  def implementation (bytes: Nat)(action: Concurrent.Action)(s: Concurrent.State): List(Primitive) := {
    match action returning List(Primitive) with
    | Concurrent.Action.acquire => List.cons(Primitive.empty(Mbarrier.Action.wait(s.producer.round)), List.nil(Primitive))
    | Concurrent.Action.issue => List.cons(Primitive.full(Mbarrier.Action.arrive(bytes)), List.nil(Primitive))
    | Concurrent.Action.complete => List.cons(Primitive.full(Mbarrier.Action.complete(bytes)), List.nil(Primitive))
    | Concurrent.Action.await => List.cons(Primitive.full(Mbarrier.Action.wait(s.consumer.round)), List.nil(Primitive))
    | Concurrent.Action.read => List.nil(Primitive)
    | Concurrent.Action.release => RingPrimitives.two(Primitive.proxyFence, Primitive.empty(Mbarrier.Action.arrive(0)))
    | Concurrent.Action.finishProducer => List.cons(Primitive.empty(Mbarrier.Action.wait(s.producer.round)), List.nil(Primitive))
    | Concurrent.Action.finishConsumer => List.nil(Primitive)
    | Concurrent.Action.close => List.cons(Primitive.join,
        RingPrimitives.two(Primitive.full(Mbarrier.Action.invalidate), Primitive.empty(Mbarrier.Action.invalidate)))
  }
  def modelResult (bytes: Nat)(out: Concurrent.Outcome): Outcome := {
    match out returning Outcome with
    | Concurrent.Outcome.ran next => Outcome.ran(RingPrimitives.world(bytes, next))
    | Concurrent.Outcome.blocked => Outcome.blocked
    | Concurrent.Outcome.fault => Outcome.fault
  }
}
