import Regions
import encoding.Lowering

namespace Tensor {
  inductive Capacity: Type
   | c32: Capacity
   | c64: Capacity
   | c128: Capacity
   | c256: Capacity
   | c512: Capacity
  def columns (c: Capacity): Nat := {
    match c returning Nat with
    | Capacity.c32 => 32
    | Capacity.c64 => 64
    | Capacity.c128 => 128
    | Capacity.c256 => 256
    | Capacity.c512 => 512
  }
  def accepted (c: Capacity): Eq(Bool, Core.isAllocCols(Tensor.columns(c)), Bool.true) := {
    match c returning Eq(Bool, Core.isAllocCols(Tensor.columns(c)), Bool.true) with
    | Capacity.c32 => Eq.refl(Bool.true)
    | Capacity.c64 => Eq.refl(Bool.true)
    | Capacity.c128 => Eq.refl(Bool.true)
    | Capacity.c256 => Eq.refl(Bool.true)
    | Capacity.c512 => Eq.refl(Bool.true)
  }
  inductive Phase: Type
   | fresh: Phase
   | live: Phase
   | pending: Phase
   | finished: Phase
  struct State: Type
   | mk (phase: Phase)(columns: Nat)(permit: Bool)(allocated: Bool)(async: Bool): State
  inductive Invariant indices (s: State): Prop
   | fresh: Invariant(State.mk(Phase.fresh, 0, Bool.true, Bool.false, Bool.false))
   | live (c: Capacity): Invariant(State.mk(Phase.live, Tensor.columns(c), Bool.false, Bool.true, Bool.false))
   | pending (c: Capacity): Invariant(State.mk(Phase.pending, Tensor.columns(c), Bool.false, Bool.true, Bool.true))
   | finished (columns: Nat): Invariant(State.mk(Phase.finished, columns, Bool.false, Bool.false, Bool.false))
  inductive Action: Type
   | allocate (c: Capacity): Action
   | skip: Action
   | issue: Action
   | complete: Action
   | access (column: Nat)(width: Nat): Action
   | free: Action
  def Allowed (a: Action)(s: State): Prop := {
    match a returning Prop with
    | Action.allocate c => Eq(Phase, s.phase, Phase.fresh)
    | Action.skip => Eq(Phase, s.phase, Phase.fresh)
    | Action.issue => Eq(Phase, s.phase, Phase.live)
    | Action.complete => Eq(Phase, s.phase, Phase.pending)
    | Action.access column width => And(Eq(Phase, s.phase, Phase.live), Nat.le(Nat.add(column, width), s.columns))
    | Action.free => Eq(Phase, s.phase, Phase.live)
  }
  // Independent runtime fields ensure that a forged phase label does not
  // silently restore the allocation permit or discard asynchronous work.
  def step (a: Action)(s: State): State := {
    match a returning State with
    | Action.allocate c => State.mk(Phase.live, Tensor.columns(c), Bool.false, Bool.true, s.async)
    | Action.skip => State.mk(Phase.finished, s.columns, Bool.false, s.allocated, s.async)
    | Action.issue => State.mk(Phase.pending, s.columns, s.permit, s.allocated, Bool.true)
    | Action.complete => State.mk(Phase.live, s.columns, s.permit, s.allocated, Bool.false)
    | Action.access column width => s
    | Action.free => State.mk(Phase.finished, s.columns, s.permit, Bool.false, s.async)
  }
  def beforeFree (s: State)(valid: Invariant(s))(allowed: Allowed(Action.free, s))
      : And(Eq(Bool, s.async, Bool.false), Eq(Bool, s.permit, Bool.false)) := {
    match valid returning And(Eq(Bool, s.async, Bool.false), Eq(Bool, s.permit, Bool.false)) with
    | Invariant.fresh => {
      match allowed returning And(Eq(Bool, s.async, Bool.false), Eq(Bool, s.permit, Bool.false)) with
    }
    | Invariant.live c => And.intro(Eq.refl(Bool.false), Eq.refl(Bool.false))
    | Invariant.pending c => {
      match allowed returning And(Eq(Bool, s.async, Bool.false), Eq(Bool, s.permit, Bool.false)) with
    }
    | Invariant.finished columns => {
      match allowed returning And(Eq(Bool, s.async, Bool.false), Eq(Bool, s.permit, Bool.false)) with
    }
  }
  def preserve (a: Action)(s: State)(valid: Invariant(s))(allowed: Allowed(a, s)): Invariant(Tensor.step(a, s)) := {
    match a returning Invariant(Tensor.step(a, s)) with
    | Action.allocate cap => {
      match valid returning Invariant(Tensor.step(a, s)) with
      | Invariant.fresh => Invariant.live(cap)
      | Invariant.live c => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.pending c => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.finished columns => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
    }
    | Action.skip => {
      match valid returning Invariant(Tensor.step(a, s)) with
      | Invariant.fresh => Invariant.finished(0)
      | Invariant.live c => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.pending c => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.finished columns => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
    }
    | Action.issue => {
      match valid returning Invariant(Tensor.step(a, s)) with
      | Invariant.fresh => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.live c => Invariant.pending(c)
      | Invariant.pending c => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.finished columns => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
    }
    | Action.complete => {
      match valid returning Invariant(Tensor.step(a, s)) with
      | Invariant.fresh => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.live c => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.pending c => Invariant.live(c)
      | Invariant.finished columns => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
    }
    | Action.access column width => {
      match valid returning Invariant(Tensor.step(a, s)) with
      | Invariant.fresh => {
        match allowed.left returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.live c => valid
      | Invariant.pending c => {
        match allowed.left returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.finished columns => {
        match allowed.left returning Invariant(Tensor.step(a, s)) with
      }
    }
    | Action.free => {
      match valid returning Invariant(Tensor.step(a, s)) with
      | Invariant.fresh => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.live c => Invariant.finished(Tensor.columns(c))
      | Invariant.pending c => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
      | Invariant.finished columns => {
        match allowed returning Invariant(Tensor.step(a, s)) with
      }
    }
  }
  def accessBound (s: State)(column: Nat)(width: Nat)(allowed: Allowed(Action.access(column, width), s))(address: Nat)
      (inside: Regions.Contains(Regions.Region.mk(column, width), address)): Nat.lt(address, s.columns) :=
    Arithmetic.transitive(Nat.succ(address), Nat.add(column, width), s.columns, inside.right, allowed.right)

  inductive Execution indices (actions: List(Action))(before: State)(after: State): Prop
   | done (s: State): Execution(List.nil(Action), s, s)
   | next (action: Action)(rest: List(Action))(before: State)(after: State)(allowed: Allowed(action, before))
       (tail: Execution(rest, Tensor.step(action, before), after)): Execution(List.cons(action, rest), before, after)
  def everyExecution (actions: List(Action))(before: State)(after: State)(execution: Execution(actions, before, after))(valid: Invariant(before))
      : Invariant(after) decreases structural(actions) := {
    match execution returning Invariant(after) with
    | Execution.done s => valid
    | Execution.next action rest before after allowed tail => Tensor.everyExecution(rest, Tensor.step(action, before), after, tail, Tensor.preserve(action, before, valid, allowed))
  }
  def liveNotFresh (h: Eq(Phase, Phase.live, Phase.fresh)): False := {
    match h returning False with
  }
  def pendingNotFresh (h: Eq(Phase, Phase.pending, Phase.fresh)): False := {
    match h returning False with
  }
  def finishedNotFresh (h: Eq(Phase, Phase.finished, Phase.fresh)): False := {
    match h returning False with
  }
  def count (actions: List(Action)): Nat decreases structural(actions) := {
    match actions returning Nat with
    | List.nil => 0
    | List.cons action rest => {
      match action returning Nat with
      | Action.allocate capacity => Nat.succ(Tensor.count(rest))
      | _ => Tensor.count(rest)
    }
  }
  def neverFresh (a: Action)(s: State)(old: Not(Eq(Phase, s.phase, Phase.fresh))): Not(Eq(Phase, Tensor.step(a, s).phase, Phase.fresh)) :=
    fun (same: Eq(Phase, Tensor.step(a, s).phase, Phase.fresh)): False => {
      match a returning False with
      | Action.allocate c => Tensor.liveNotFresh(same)
      | Action.skip => Tensor.finishedNotFresh(same)
      | Action.issue => Tensor.pendingNotFresh(same)
      | Action.complete => Tensor.liveNotFresh(same)
      | Action.access column width => old(same)
      | Action.free => Tensor.finishedNotFresh(same)
    }
  def noMoreAllocations (actions: List(Action))(before: State)(after: State)(execution: Execution(actions, before, after))
      (notFresh: Not(Eq(Phase, before.phase, Phase.fresh))): Eq(Nat, Tensor.count(actions), 0) decreases structural(actions) := {
    match execution returning Eq(Nat, Tensor.count(actions), 0) with
    | Execution.done s => Eq.refl(0)
    | Execution.next action rest before after allowed tail => {
      match action returning Eq(Nat, Tensor.count(actions), 0) with
      | Action.allocate c => False.elimP(notFresh(allowed), Eq(Nat, Tensor.count(actions), 0))
      | Action.skip => False.elimP(notFresh(allowed), Eq(Nat, Tensor.count(actions), 0))
      | _ => Tensor.noMoreAllocations(rest, Tensor.step(action, before), after, tail, Tensor.neverFresh(action, before, notFresh))
    }
  }
  def freshAtMostOnce (actions: List(Action))(after: State)
      (execution: Execution(actions, State.mk(Phase.fresh, 0, Bool.true, Bool.false, Bool.false), after))
      : Nat.le(Tensor.count(actions), 1) decreases structural(actions) := {
    match execution returning Nat.le(Tensor.count(actions), 1) with
    | Execution.done s => Eq.refl(Bool.true)
    | Execution.next action rest before after allowed tail => {
      match action returning Nat.le(Tensor.count(actions), 1) with
      | Action.allocate c => Eq.substP(Eq.symm(congrArg(Tensor.noMoreAllocations(rest, Tensor.step(action, before), after, tail, Tensor.liveNotFresh), Nat, Nat.succ)), Arithmetic.upper(1), Eq.refl(Bool.true))
      | Action.skip => Eq.substP(Eq.symm(Tensor.noMoreAllocations(rest, Tensor.step(action, before), after, tail, Tensor.finishedNotFresh)), Arithmetic.upper(1), Eq.refl(Bool.true))
      | Action.issue => {
        match allowed returning Nat.le(Tensor.count(actions), 1) with
      }
      | Action.complete => {
        match allowed returning Nat.le(Tensor.count(actions), 1) with
      }
      | Action.access column width => {
        match allowed.left returning Nat.le(Tensor.count(actions), 1) with
      }
      | Action.free => {
        match allowed returning Nat.le(Tensor.count(actions), 1) with
      }
    }
  }
}
