import Endpoints

namespace EndpointEffects {
  open Concurrent.{Phase, Slot, Action, Outcome}
  def post (role: Endpoints.Role)(after: Phase)(before: Concurrent.State): Outcome -> Prop := fun (out: Outcome): Prop => {
    match out returning Prop with
    | Outcome.ran next => And(Eq(Phase, Endpoints.phase(role, next), after),
        And(Eq(Phase, Endpoints.other(role, next), Endpoints.other(role, before)), Eq(Bool, next.active, Bool.true)))
    | Outcome.blocked => True
    | Outcome.fault => False
  }
  // A local step changes only its own endpoint's declared phase. This is
  // proved from the raw executor, without assuming the shared invariant.
  def effects (role: Endpoints.Role)(action: Action)(p: Phase)(q: Phase)(s: Concurrent.State)
      (transition: Endpoints.Transition(role, action, p, q))
      (current: Eq(Phase, Endpoints.phase(role, s), p))(active: Eq(Bool, s.active, Bool.true))
      : EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) := {
    match s.active returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
    | Bool.false => False.elimP(Bool.falseNeTrue(active), EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
    | Bool.true => {
      match transition returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
      | Endpoints.Transition.acquire => {
        match s.producer.phase returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
        | Phase.ready => {
          match s.slot returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
          | Slot.empty => And.intro(Eq.refl(Phase.held), And.intro(Eq.refl(Endpoints.other(role, s)), Eq.refl(Bool.true)))
          | _ => True.intro
        }
        | Phase.held => Concurrent.heldNotReady(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
        | Phase.done => Concurrent.doneNotReady(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
      }
      | Endpoints.Transition.issue => {
        match s.producer.phase returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
        | Phase.ready => Concurrent.readyNotHeld(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
        | Phase.held => And.intro(Eq.refl(Phase.ready), And.intro(Eq.refl(Endpoints.other(role, s)), Eq.refl(Bool.true)))
        | Phase.done => Concurrent.doneNotHeld(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
      }
      | Endpoints.Transition.finishProducer => {
        match s.producer.phase returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
        | Phase.ready => {
          match s.slot returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
          | Slot.empty => And.intro(Eq.refl(Phase.done), And.intro(Eq.refl(Endpoints.other(role, s)), Eq.refl(Bool.true)))
          | _ => True.intro
        }
        | Phase.held => Concurrent.heldNotReady(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
        | Phase.done => Concurrent.doneNotReady(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
      }
      | Endpoints.Transition.await => {
        match s.consumer.phase returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
        | Phase.ready => {
          match s.slot returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
          | Slot.full => And.intro(Eq.refl(Phase.held), And.intro(Eq.refl(Endpoints.other(role, s)), Eq.refl(Bool.true)))
          | _ => True.intro
        }
        | Phase.held => Concurrent.heldNotReady(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
        | Phase.done => Concurrent.doneNotReady(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
      }
      | Endpoints.Transition.read => {
        match s.consumer.phase returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
        | Phase.ready => Concurrent.readyNotHeld(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
        | Phase.held => And.intro(Eq.refl(Phase.held), And.intro(Eq.refl(Endpoints.other(role, s)), Eq.refl(Bool.true)))
        | Phase.done => Concurrent.doneNotHeld(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
      }
      | Endpoints.Transition.release => {
        match s.consumer.phase returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
        | Phase.ready => Concurrent.readyNotHeld(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
        | Phase.held => And.intro(Eq.refl(Phase.ready), And.intro(Eq.refl(Endpoints.other(role, s)), Eq.refl(Bool.true)))
        | Phase.done => Concurrent.doneNotHeld(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
      }
      | Endpoints.Transition.finishConsumer => {
        match s.consumer.phase returning EndpointEffects.post(role, q, s)(Concurrent.step(action, s)) with
        | Phase.ready => And.intro(Eq.refl(Phase.done), And.intro(Eq.refl(Endpoints.other(role, s)), Eq.refl(Bool.true)))
        | Phase.held => Concurrent.heldNotReady(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
        | Phase.done => Concurrent.doneNotReady(current, EndpointEffects.post(role, q, s)(Concurrent.step(action, s)))
      }
    }
  }
}
