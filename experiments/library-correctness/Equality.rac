namespace Equality {
  def binary (A: Type)(B: Type)(C: Type)(f: (a: A) -> (b: B) -> C)(a: A)(b: A)(x: B)(y: B)
      (left: Eq(A, a, b))(right: Eq(B, x, y)): Eq(C, f(a, x), f(b, y)) := {
    match left returning Eq(C, f(a, x), f(b, y)) with
    | Eq.refl first => {
      match right returning Eq(C, f(first, x), f(first, y)) with
      | Eq.refl second => Eq.refl(f(first, second))
    }
  }
}
