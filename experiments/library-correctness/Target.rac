import Dependent

// A target-level contract semantics for the retirement fragment. Its atomic
// rules summarize A34/A35 and warp reconvergence; it is not full PTX semantics.
// Importantly these rules name concrete CUDA, not an independent emit function.
namespace Target {
  open Retirement
  open Cuda
  def Run: Type := (rank: Bool) -> (r: Contracts.Runtime) -> (s: State) -> Contracts.Outcome(State)
  def meaning (code: Code): Run := fun (rank: Bool)(r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Retirement.run(code, rank, r, s)

  def store: Block := Block.seq(Stmt.ifElse(Core.laneZero,
    Block.seq(Stmt.instr(Instr.tmaStore(Expr.paramAddr("O_map"), Expr.lit(0), Expr.lit(0), Expr.sharedAddr(0))),
      Block.seq(Stmt.instr(Instr.bulkCommit), Block.done)), Block.done), Block.seq(Stmt.syncWarp, Block.done))
  // This is deliberately stated independently of Core.bulkWait.
  def drainSpecification: Block := Block.seq(Stmt.ifElse(Core.laneZero,
    Block.seq(Stmt.instr(Instr.bulkWait(BulkWait.complete, 0)), Block.done), Block.done), Block.seq(Stmt.syncWarp, Block.done))
  def drainImplementation: Block := Core.toBlock(List.reverse(Core.onLaneZero(List.cons(Core.bulkWait(0), List.nil(Stmt)))), Block.done)
  def local: Block := Block.seq(Core.tcFenceBefore, Block.done)
  def sequence (a: Block)(b: Block): Block := Block.seq(Stmt.scoped(a), Block.seq(Stmt.scoped(b), Block.done))
  def branch (a: Block)(b: Block): Block := Block.seq(Stmt.ifElse(Expr.param("flag"), a, b), Block.done)
  def loop (id: Nat)(body: Block): Block := Block.seq(Stmt.forLoop(id, Expr.lit(0), Expr.param("K"), body), Block.done)
  def leader (body: Block): Block := Block.seq(Stmt.ifElse(Expr.param("leader"), body, Block.done), Block.done)
  // The shared region is owned by the surrounding fragment shell. Allocation
  // here opens/closes its ghost permission; it does not reserve new bytes.
  def allocate (body: Block): Block := Block.seq(Stmt.scoped(body), Block.done)

  def atRank (run: Run)(rank: Bool): Contracts.Runtime -> State -> Contracts.Outcome(State) :=
    fun (r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => run(rank, r, s)

  def composeRun (a: Run)(b: Run): Run := fun (rank: Bool)(r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Contracts.sequence(Target.atRank(a, rank), Target.atRank(b, rank), r, s)
  def branchRun (a: Run)(b: Run): Run := fun (rank: Bool)(r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Contracts.branch(Target.atRank(a, rank), Target.atRank(b, rank), r, s)
  def loopRun (body: Run): Run := fun (rank: Bool)(r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Contracts.repeat(Target.atRank(body, rank), r, s)
  def leaderRun (body: Run): Run := fun (rank: Bool)(r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Contracts.select(rank, body(rank, r, s), Contracts.Outcome.ok(s))
  def allocateRun (body: Run): Run := fun (rank: Bool)(r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Retirement.scoped(Target.atRank(body, rank), r, s)

  // Ghost opening/closing is part of the interpretation, so the same scoped
  // target block can have a transparent or a resource-scope interpretation.
  // The chosen interpretation is certified, not inferred from raw CUDA alone.
  inductive Interprets indices (block: Block)(run: Run): Prop
   | skip: Interprets(Block.done, Target.meaning(Code.skip))
   | store: Interprets(Target.store, Target.meaning(Code.issue))
   | drain: Interprets(Target.drainSpecification, Target.meaning(Code.finish))
   | local: Interprets(Target.local, Target.meaning(Code.local))
   | sequence (a: Block)(b: Block)(f: Run)(g: Run)(left: Interprets(a, f))(right: Interprets(b, g))
       : Interprets(Target.sequence(a, b), Target.composeRun(f, g))
   | branch (a: Block)(b: Block)(f: Run)(g: Run)(yes: Interprets(a, f))(no: Interprets(b, g))
       : Interprets(Target.branch(a, b), Target.branchRun(f, g))
   | loop (id: Nat)(body: Block)(f: Run)(valid: Interprets(body, f)): Interprets(Target.loop(id, body), Target.loopRun(f))
   | leader (body: Block)(f: Run)(valid: Interprets(body, f)): Interprets(Target.leader(body), Target.leaderRun(f))
   | allocate (body: Block)(f: Run)(valid: Interprets(body, f)): Interprets(Target.allocate(body), Target.allocateRun(f))

  struct Compiled (code: Code): Type
   | mk (next: Nat)(block: Block)(interpretation: Interprets(block, Target.meaning(code))): Compiled(code)
  def compile (code: Code)(start: Nat): Compiled(code) decreases structural(code) := {
    match code returning Compiled(code) with
    | Code.skip => Compiled.mk(code, start, Block.done, Interprets.skip)
    | Code.issue => Compiled.mk(code, start, Target.store, Interprets.store)
    | Code.finish => Compiled.mk(code, start, Target.drainImplementation, Interprets.drain)
    | Code.local => Compiled.mk(code, start, Target.local, Interprets.local)
    | Code.seq a b => {
      let left := Target.compile(a, start)
      let right := Target.compile(b, left.next)
      Compiled.mk(code, right.next, Target.sequence(left.block, right.block), Interprets.sequence(left.block, right.block, Target.meaning(a), Target.meaning(b), left.interpretation, right.interpretation))
    }
    | Code.branch a b => {
      let left := Target.compile(a, start)
      let right := Target.compile(b, left.next)
      Compiled.mk(code, right.next, Target.branch(left.block, right.block), Interprets.branch(left.block, right.block, Target.meaning(a), Target.meaning(b), left.interpretation, right.interpretation))
    }
    | Code.loop body => {
      let lowered := Target.compile(body, Nat.succ(start))
      Compiled.mk(code, lowered.next, Target.loop(start, lowered.block), Interprets.loop(start, lowered.block, Target.meaning(body), lowered.interpretation))
    }
    | Code.leader body => {
      let lowered := Target.compile(body, start)
      Compiled.mk(code, lowered.next, Target.leader(lowered.block), Interprets.leader(lowered.block, Target.meaning(body), lowered.interpretation))
    }
    | Code.allocate body => {
      let lowered := Target.compile(body, start)
      Compiled.mk(code, lowered.next, Target.allocate(lowered.block), Interprets.allocate(lowered.block, Target.meaning(body), lowered.interpretation))
    }
  }

  // There must be BOTH a concrete-target interpretation and a proof that its
  // executions satisfy the contract. Interprets alone is not correctness.
  inductive Correct (P: State -> Prop)(Q: State -> Prop) indices (block: Block): Prop
   | proved (block: Block)(run: Run)(meaning: Interprets(block, run))
       (safety: (rank: Bool) -> Contracts.Safe(Target.atRank(run, rank), P, Q)): Correct(P, Q, block)

  def syntax {mode: Mode}{p: Phase}{q: Phase}(cmd: Dependent.Cmd(mode, p, q)): Block := Target.compile(Dependent.code(cmd), 0).block
  def everyCommand {mode: Mode}{p: Phase}{q: Phase}(cmd: Dependent.Cmd(mode, p, q))
      : Correct(Retirement.at(p), Retirement.at(q), Target.syntax(cmd)) := {
    let result := Target.compile(Dependent.code(cmd), 0)
    Correct.proved(Retirement.at(p), Retirement.at(q), result.block, Target.meaning(Dependent.code(cmd)), result.interpretation,
      fun (rank: Bool): Contracts.Safe(Target.atRank(Target.meaning(Dependent.code(cmd)), rank), Retirement.at(p), Retirement.at(q)) => Dependent.safe(cmd, rank))
  }
  def everyProgram (program: Dependent.Program): Correct(Retirement.at(Phase.outside), Retirement.at(Phase.outside), Target.syntax(program)) := Target.everyCommand(program)
}
