import Cuda
import Equality

// An executable control semantics. Each participating thread computes its
// own condition/count. The safety theorem compares their collective traces.
namespace Coverage {
  struct Inputs: Type
   | mk (numbers: String -> Nat)(flags: String -> Bool): Inputs
  inductive Number: Type
   | literal (value: Nat): Number
   | parameter (name: String): Number
   | thread: Number
   | add (a: Number)(b: Number): Number
   | multiply (a: Number)(b: Number): Number
  inductive Condition: Type
   | literal (value: Bool): Condition
   | parameter (name: String): Condition
   | threadIs (id: Nat): Condition
   | negate (a: Condition): Condition
   | both (a: Condition)(b: Condition): Condition
   | less (a: Number)(b: Number): Condition
  def number (term: Number)(input: Inputs)(thread: Nat): Nat decreases structural(term) := {
    match term returning Nat with
    | Number.literal n => n
    | Number.parameter name => input.numbers(name)
    | Number.thread => thread
    | Number.add a b => Nat.add(Coverage.number(a, input, thread), Coverage.number(b, input, thread))
    | Number.multiply a b => Nat.mul(Coverage.number(a, input, thread), Coverage.number(b, input, thread))
  }
  def condition (term: Condition)(input: Inputs)(thread: Nat): Bool decreases structural(term) := {
    match term returning Bool with
    | Condition.literal flag => flag
    | Condition.parameter name => input.flags(name)
    | Condition.threadIs id => Nat.beq(thread, id)
    | Condition.negate a => Bool.not(Coverage.condition(a, input, thread))
    | Condition.both a b => Bool.and(Coverage.condition(a, input, thread), Coverage.condition(b, input, thread))
    | Condition.less a b => Nat.blt(Coverage.number(a, input, thread), Coverage.number(b, input, thread))
  }
  inductive UniformNumber indices (term: Number): Prop
   | literal (n: Nat): UniformNumber(Number.literal(n))
   | parameter (name: String): UniformNumber(Number.parameter(name))
   | add (a: Number)(b: Number)(left: UniformNumber(a))(right: UniformNumber(b)): UniformNumber(Number.add(a, b))
   | multiply (a: Number)(b: Number)(left: UniformNumber(a))(right: UniformNumber(b)): UniformNumber(Number.multiply(a, b))
  inductive UniformCondition indices (term: Condition): Prop
   | literal (flag: Bool): UniformCondition(Condition.literal(flag))
   | parameter (name: String): UniformCondition(Condition.parameter(name))
   | negate (a: Condition)(valid: UniformCondition(a)): UniformCondition(Condition.negate(a))
   | both (a: Condition)(b: Condition)(left: UniformCondition(a))(right: UniformCondition(b)): UniformCondition(Condition.both(a, b))
   | less (a: Number)(b: Number)(left: UniformNumber(a))(right: UniformNumber(b)): UniformCondition(Condition.less(a, b))

  def numbersAgree (term: Number)(valid: UniformNumber(term))(input: Inputs)(t: Nat)(u: Nat)
      : Eq(Nat, Coverage.number(term, input, t), Coverage.number(term, input, u)) decreases structural(term) := {
    match valid returning Eq(Nat, Coverage.number(term, input, t), Coverage.number(term, input, u)) with
    | UniformNumber.literal n => Eq.refl(n)
    | UniformNumber.parameter name => Eq.refl(input.numbers(name))
    | UniformNumber.add a b left right => Equality.binary(Nat, Nat, Nat, Nat.add, Coverage.number(a, input, t), Coverage.number(a, input, u), Coverage.number(b, input, t), Coverage.number(b, input, u), Coverage.numbersAgree(a, left, input, t, u), Coverage.numbersAgree(b, right, input, t, u))
    | UniformNumber.multiply a b left right => Equality.binary(Nat, Nat, Nat, Nat.mul, Coverage.number(a, input, t), Coverage.number(a, input, u), Coverage.number(b, input, t), Coverage.number(b, input, u), Coverage.numbersAgree(a, left, input, t, u), Coverage.numbersAgree(b, right, input, t, u))
  }

  def flagsAgree (term: Condition)(valid: UniformCondition(term))(input: Inputs)(t: Nat)(u: Nat)
      : Eq(Bool, Coverage.condition(term, input, t), Coverage.condition(term, input, u)) decreases structural(term) := {
    match valid returning Eq(Bool, Coverage.condition(term, input, t), Coverage.condition(term, input, u)) with
    | UniformCondition.literal flag => Eq.refl(flag)
    | UniformCondition.parameter name => Eq.refl(input.flags(name))
    | UniformCondition.negate a h => congrArg(Coverage.flagsAgree(a, h, input, t, u), Bool, Bool.not)
    | UniformCondition.both a b left right => Equality.binary(Bool, Bool, Bool, Bool.and, Coverage.condition(a, input, t), Coverage.condition(a, input, u), Coverage.condition(b, input, t), Coverage.condition(b, input, u), Coverage.flagsAgree(a, left, input, t, u), Coverage.flagsAgree(b, right, input, t, u))
    | UniformCondition.less a b left right => Equality.binary(Nat, Nat, Bool, Nat.blt, Coverage.number(a, input, t), Coverage.number(a, input, u), Coverage.number(b, input, t), Coverage.number(b, input, u), Coverage.numbersAgree(a, left, input, t, u), Coverage.numbersAgree(b, right, input, t, u))
  }


  inductive Code: Type
   | skip: Code
   | collective (site: Nat): Code
   | seq (a: Code)(b: Code): Code
   | branch (condition: Condition)(a: Code)(b: Code): Code
   | loop (count: Number)(body: Code): Code
  def select (flag: Bool)(yes: List(Nat))(no: List(Nat)): List(Nat) := {
    match flag returning List(Nat) with
    | Bool.true => yes
    | Bool.false => no
  }
  def repeat (n: Nat)(body: List(Nat)): List(Nat) decreases structural(n) := {
    match n returning List(Nat) with
    | Nat.zero => List.nil(Nat)
    | Nat.succ k => List.append(body, Coverage.repeat(k, body))
  }
  def trace (code: Code)(input: Inputs)(thread: Nat): List(Nat) decreases structural(code) := {
    match code returning List(Nat) with
    | Code.skip => List.nil(Nat)
    | Code.collective site => List.cons(site, List.nil(Nat))
    | Code.seq a b => List.append(Coverage.trace(a, input, thread), Coverage.trace(b, input, thread))
    | Code.branch condition a b => Coverage.select(Coverage.condition(condition, input, thread), Coverage.trace(a, input, thread), Coverage.trace(b, input, thread))
    | Code.loop count body => Coverage.repeat(Coverage.number(count, input, thread), Coverage.trace(body, input, thread))
  }
  inductive Typed indices (code: Code): Prop
   | skip: Typed(Code.skip)
   | collective (site: Nat): Typed(Code.collective(site))
   | seq (a: Code)(b: Code)(left: Typed(a))(right: Typed(b)): Typed(Code.seq(a, b))
   | branch (condition: Condition)(a: Code)(b: Code)(uniform: UniformCondition(condition))(yes: Typed(a))(no: Typed(b)): Typed(Code.branch(condition, a, b))
   | loop (count: Number)(body: Code)(uniform: UniformNumber(count))(valid: Typed(body)): Typed(Code.loop(count, body))

  def appendEqual (a: List(Nat))(b: List(Nat))(x: List(Nat))(y: List(Nat))(left: Eq(List(Nat), a, b))(right: Eq(List(Nat), x, y)): Eq(List(Nat), List.append(a, x), List.append(b, y)) := {
    match left returning Eq(List(Nat), List.append(a, x), List.append(b, y)) with
    | Eq.refl head => {
      match right returning Eq(List(Nat), List.append(head, x), List.append(head, y)) with
      | Eq.refl tail => Eq.refl(List.append(head, tail))
    }
  }
  def selectEqual (a: Bool)(b: Bool)(x: List(Nat))(y: List(Nat))(p: List(Nat))(q: List(Nat))
      (flag: Eq(Bool, a, b))(yes: Eq(List(Nat), x, y))(no: Eq(List(Nat), p, q)): Eq(List(Nat), Coverage.select(a, x, p), Coverage.select(b, y, q)) := {
    match flag returning Eq(List(Nat), Coverage.select(a, x, p), Coverage.select(b, y, q)) with
    | Eq.refl condition => {
      match condition returning Eq(List(Nat), Coverage.select(condition, x, p), Coverage.select(condition, y, q)) with
      | Bool.true => yes
      | Bool.false => no
    }
  }
  def repeatEqual (a: Nat)(b: Nat)(x: List(Nat))(y: List(Nat))(count: Eq(Nat, a, b))(body: Eq(List(Nat), x, y)): Eq(List(Nat), Coverage.repeat(a, x), Coverage.repeat(b, y)) := {
    match count returning Eq(List(Nat), Coverage.repeat(a, x), Coverage.repeat(b, y)) with
    | Eq.refl n => {
      match body returning Eq(List(Nat), Coverage.repeat(n, x), Coverage.repeat(n, y)) with
      | Eq.refl sites => Eq.refl(Coverage.repeat(n, sites))
    }
  }
  def everyParticipant (code: Code)(valid: Typed(code))(input: Inputs)(t: Nat)(u: Nat)
      : Eq(List(Nat), Coverage.trace(code, input, t), Coverage.trace(code, input, u)) decreases structural(code) := {
    match valid returning Eq(List(Nat), Coverage.trace(code, input, t), Coverage.trace(code, input, u)) with
    | Typed.skip => Eq.refl(List.nil(Nat))
    | Typed.collective site => Eq.refl(List.cons(site, List.nil(Nat)))
    | Typed.seq a b left right => Coverage.appendEqual(Coverage.trace(a, input, t), Coverage.trace(a, input, u), Coverage.trace(b, input, t), Coverage.trace(b, input, u), Coverage.everyParticipant(a, left, input, t, u), Coverage.everyParticipant(b, right, input, t, u))
    | Typed.branch condition a b uniform yes no => Coverage.selectEqual(Coverage.condition(condition, input, t), Coverage.condition(condition, input, u), Coverage.trace(a, input, t), Coverage.trace(a, input, u), Coverage.trace(b, input, t), Coverage.trace(b, input, u), Coverage.flagsAgree(condition, uniform, input, t, u), Coverage.everyParticipant(a, yes, input, t, u), Coverage.everyParticipant(b, no, input, t, u))
    | Typed.loop count body uniform h => Coverage.repeatEqual(Coverage.number(count, input, t), Coverage.number(count, input, u), Coverage.trace(body, input, t), Coverage.trace(body, input, u), Coverage.numbersAgree(count, uniform, input, t, u), Coverage.everyParticipant(body, h, input, t, u))
  }
}
