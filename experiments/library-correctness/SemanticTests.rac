import Coupled
import Publication
import Tensor
import Claims
import Outputs
import Coverage
import Budgets

namespace SemanticTests {
  def producer: Endpoints.Cmd(Endpoints.Role.producer, Concurrent.Phase.ready, Concurrent.Phase.done) := Endpoints.sequence(Endpoints.loop(Endpoints.sequence(Endpoints.acquire, Endpoints.issue)), Endpoints.finishProducer)
  def consumer: Endpoints.Cmd(Endpoints.Role.consumer, Concurrent.Phase.ready, Concurrent.Phase.done) := Endpoints.sequence(Endpoints.loop(Endpoints.sequence(Endpoints.await, Endpoints.sequence(Endpoints.read, Endpoints.release))), Endpoints.finishConsumer)
  // These are client programs, not per-kernel proofs. The library theorem
  // handles all loop counts, mismatches, schedules and repeated blocked waits.
  def communicating (producerCount: Nat)(consumerCount: Nat)(choices: List(Scheduler.Choice))
      : Concurrent.Audit(Scheduler.kernel(SemanticTests.producer, SemanticTests.consumer, Contracts.Runtime.mk(producerCount, Bool.true, 0), Contracts.Runtime.mk(consumerCount, Bool.false, 0), choices).actions,
          Concurrent.initial, Scheduler.kernel(SemanticTests.producer, SemanticTests.consumer, Contracts.Runtime.mk(producerCount, Bool.true, 0), Contracts.Runtime.mk(consumerCount, Bool.false, 0), choices).state) :=
    Scheduler.everyKernel(SemanticTests.producer, SemanticTests.consumer, Contracts.Runtime.mk(producerCount, Bool.true, 0), Contracts.Runtime.mk(consumerCount, Bool.false, 0), choices)
  def writing: Concurrent.State := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.held, 0), Concurrent.Endpoint.mk(Concurrent.Phase.ready, 0), Concurrent.Slot.writing, 0, Bool.false)
  def pending: Concurrent.State := Concurrent.State.mk(Bool.true, Concurrent.Endpoint.mk(Concurrent.Phase.ready, 1), Concurrent.Endpoint.mk(Concurrent.Phase.ready, 0), Concurrent.Slot.pending, 0, Bool.true)
  def awaitBeforeProduce: Eq(Concurrent.Outcome, Concurrent.step(Concurrent.Action.await, Concurrent.initial), Concurrent.Outcome.blocked) := Eq.refl(Concurrent.Outcome.blocked)
  def issueStartsAsync: Eq(Concurrent.Outcome, Concurrent.step(Concurrent.Action.issue, SemanticTests.writing), Concurrent.Outcome.ran(SemanticTests.pending)) := Eq.refl(Concurrent.Outcome.ran(SemanticTests.pending))
  def noReadBeforeCompletion: Eq(Concurrent.Outcome, Concurrent.step(Concurrent.Action.await, SemanticTests.pending), Concurrent.Outcome.blocked) := Eq.refl(Concurrent.Outcome.blocked)
  def tailDoesNotSkipRelease: Eq(Concurrent.Outcome, Concurrent.step(Concurrent.Action.finishProducer, SemanticTests.pending), Concurrent.Outcome.blocked) := Eq.refl(Concurrent.Outcome.blocked)

  def zeroAlignRejected: Eq(Option(Regions.Placement(0, 64, 16, 0)), Regions.placement(0, 64, 16, 0, 0), Option.none(Regions.Placement(0, 64, 16, 0))) := Eq.refl(Option.none(Regions.Placement(0, 64, 16, 0)))
  def overlapRejected: Eq(Option(Regions.Placement(128, 256, 64, 64)), Regions.placement(128, 256, 64, 64, 64), Option.none(Regions.Placement(128, 256, 64, 64))) := Eq.refl(Option.none(Regions.Placement(128, 256, 64, 64)))
  def firstPlace: Regions.Placement(0, 256, 64, 64) := Regions.Placement.mk(0, 256, 64, 64, 0, Eq.refl(Bool.true), Eq.refl(Bool.true), Eq.refl(0), Eq.refl(Bool.true))
  def firstArena: Regions.Arena(256) := Regions.reserve(Regions.empty(256), 64, 64, SemanticTests.firstPlace)
  def secondPlace: Regions.Placement(Regions.top(SemanticTests.firstArena), 256, 64, 64) := Regions.Placement.mk(64, 256, 64, 64, 64, Eq.refl(Bool.true), Eq.refl(Bool.true), Eq.refl(0), Eq.refl(Bool.true))
  def secondArena: Regions.Arena(256) := Regions.reserve(SemanticTests.firstArena, 64, 64, SemanticTests.secondPlace)
  def lastByteInBounds: Nat.lt(127, 256) := Regions.everyAccessInBounds(SemanticTests.secondArena, Regions.Region.mk(64, 64), Spec.Mem.here(Regions.Region.mk(64, 64), Regions.regions(SemanticTests.firstArena)), 127, And.intro(Eq.refl(Bool.true), Eq.refl(Bool.true)))

  def inputs: Coverage.Inputs := Coverage.Inputs.mk(fun (name: String): Nat => 2, fun (name: String): Bool => Bool.true)
  def divergent: Coverage.Code := Coverage.Code.branch(Coverage.Condition.threadIs(0), Coverage.Code.collective(9), Coverage.Code.skip)
  def oneParticipant: Eq(List(Nat), Coverage.trace(SemanticTests.divergent, SemanticTests.inputs, 0), List.cons(9, List.nil(Nat))) := Eq.refl(List.cons(9, List.nil(Nat)))
  def otherParticipant: Eq(List(Nat), Coverage.trace(SemanticTests.divergent, SemanticTests.inputs, 1), List.nil(Nat)) := Eq.refl(List.nil(Nat))

  def oldEpoch: Not(Eq(Nat, 0, 1)) := fun (same: Eq(Nat, 0, 1)): False => {
    match same returning False with
  }
  def claim1: Claims.Request(1) := Claims.Request.cas(3, Claims.Word.mk(0, 7), SemanticTests.oldEpoch)
  def claim2: Claims.Request(1) := Claims.Request.cas(4, Claims.Word.mk(0, 7), SemanticTests.oldEpoch)
  def staleSnapshotLoses: Eq(List(Nat), Claims.run(1, List.cons(SemanticTests.claim1, List.cons(SemanticTests.claim2, List.nil(Claims.Request(1)))), Claims.initial(Claims.Word.mk(0, 7))).winners, List.cons(3, List.nil(Nat))) := Eq.refl(List.cons(3, List.nil(Nat)))
  def reusedEpoch: Eq(List(Nat), Claims.run(1, List.cons(Claims.Request.observe(1, 3), List.cons(Claims.Request.observe(1, 4), List.nil(Claims.Request(1)))), Claims.initial(Claims.Word.mk(1, 3))).winners, List.cons(3, List.nil(Nat))) := Eq.refl(List.cons(3, List.nil(Nat)))

  // A duplicate initial permission really permits two writes. The uniqueness
  // premise is essential; the theorem must reject this initialization.
  def duplicates: List(Nat) := List.cons(0, List.cons(0, List.nil(Nat)))
  def duplicateTrace: Outputs.Trace(2, SemanticTests.duplicates, SemanticTests.duplicates, List.nil(Nat)) :=
    Outputs.Trace.write(1, 0, List.cons(0, List.nil(Nat)), SemanticTests.duplicates, List.cons(0, List.nil(Nat)), List.nil(Nat), Outputs.Erase.here(0, List.cons(0, List.nil(Nat))),
      Outputs.Trace.write(0, 0, List.nil(Nat), List.cons(0, List.nil(Nat)), List.nil(Nat), List.nil(Nat), Outputs.Erase.here(0, List.nil(Nat)), Outputs.Trace.skip(List.nil(Nat))))
  def distinctPermissionRange (start: Nat)(count: Nat): Outputs.Unique(Outputs.range(start, count)) := Outputs.rangeUnique(start, count)
  def nativeBudget: Budgets.Split(512, 1) := Budgets.split(1, Budgets.Counts.mk(32, 192, 144, 144))
  def nativeBudgetSound: Budgets.valid(Registers.budget(512, 1), Budgets.counts(SemanticTests.nativeBudget)) := Budgets.everySplit(SemanticTests.nativeBudget)

  def allChunkWrites (count: Nat): Outputs.Unique(Publication.writes(Publication.filled(count))) := Publication.exactlyOnce(Publication.filled(count))
  def everyAccessOrdered (producerCount: Nat)(consumerCount: Nat)(choices: List(Scheduler.Choice))
      : History.RaceFree(Coupled.kernelHistory(SemanticTests.producer, SemanticTests.consumer, Contracts.Runtime.mk(producerCount, Bool.true, 0), Contracts.Runtime.mk(consumerCount, Bool.false, 0), choices)) :=
    Coupled.noRace(SemanticTests.producer, SemanticTests.consumer, Contracts.Runtime.mk(producerCount, Bool.true, 0), Contracts.Runtime.mk(consumerCount, Bool.false, 0), choices)
}
