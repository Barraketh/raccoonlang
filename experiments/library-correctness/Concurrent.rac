import Contracts

// A single communicating slot, with independent endpoint counters. Waits
// can block. Completion is a separate scheduler event, not eager generation.
namespace Concurrent {
  inductive Phase: Type
   | ready: Phase
   | held: Phase
   | done: Phase
  struct Endpoint: Type
   | mk (phase: Phase)(round: Nat): Endpoint
  inductive Slot: Type
   | empty: Slot
   | writing: Slot
   | pending: Slot
   | full: Slot
   | reading: Slot
  struct State: Type
   | mk (active: Bool)(producer: Endpoint)(consumer: Endpoint)(slot: Slot)(round: Nat)(async: Bool): State
  inductive Action: Type
   | acquire: Action
   | issue: Action
   | complete: Action
   | await: Action
   | read: Action
   | release: Action
   | finishProducer: Action
   | finishConsumer: Action
   | close: Action
  inductive Outcome: Type
   | ran (state: State): Outcome
   | blocked: Outcome
   | fault: Outcome

  def status (done: Bool): Phase := {
    match done returning Phase with
    | Bool.true => Phase.done
    | Bool.false => Phase.ready
  }
  def initial: State := State.mk(Bool.true, Endpoint.mk(Phase.ready, 0), Endpoint.mk(Phase.ready, 0), Slot.empty, 0, Bool.false)
  // Crucially this relates BOTH endpoint counters to the same physical slot.
  inductive Invariant indices (state: State): Prop
   | inactive (n: Nat): Invariant(State.mk(Bool.false, Endpoint.mk(Phase.done, n), Endpoint.mk(Phase.done, n), Slot.empty, n, Bool.false))
   | idle (n: Nat)(p: Bool)(c: Bool): Invariant(State.mk(Bool.true, Endpoint.mk(Concurrent.status(p), n), Endpoint.mk(Concurrent.status(c), n), Slot.empty, n, Bool.false))
   | writing (n: Nat)(c: Bool): Invariant(State.mk(Bool.true, Endpoint.mk(Phase.held, n), Endpoint.mk(Concurrent.status(c), n), Slot.writing, n, Bool.false))
   | pending (n: Nat)(c: Bool): Invariant(State.mk(Bool.true, Endpoint.mk(Phase.ready, Nat.succ(n)), Endpoint.mk(Concurrent.status(c), n), Slot.pending, n, Bool.true))
   | full (n: Nat)(c: Bool): Invariant(State.mk(Bool.true, Endpoint.mk(Phase.ready, Nat.succ(n)), Endpoint.mk(Concurrent.status(c), n), Slot.full, n, Bool.false))
   | reading (n: Nat): Invariant(State.mk(Bool.true, Endpoint.mk(Phase.ready, Nat.succ(n)), Endpoint.mk(Phase.held, n), Slot.reading, n, Bool.false))

  // Local typing says which operations an endpoint may issue. It does NOT
  // supply slot ownership or quiescence; the shared invariant must prove those.
  def Local (action: Action)(s: State): Prop := {
    match action returning Prop with
    | Action.acquire => Eq(Phase, s.producer.phase, Phase.ready)
    | Action.issue => Eq(Phase, s.producer.phase, Phase.held)
    | Action.complete => Eq(Slot, s.slot, Slot.pending)
    | Action.await => Eq(Phase, s.consumer.phase, Phase.ready)
    | Action.read => Eq(Phase, s.consumer.phase, Phase.held)
    | Action.release => Eq(Phase, s.consumer.phase, Phase.held)
    | Action.finishProducer => Eq(Phase, s.producer.phase, Phase.ready)
    | Action.finishConsumer => Eq(Phase, s.consumer.phase, Phase.ready)
    | Action.close => And(Eq(Phase, s.producer.phase, Phase.done), Eq(Phase, s.consumer.phase, Phase.done))
  }
  def Allowed (action: Action)(s: State): Prop := And(Eq(Bool, s.active, Bool.true), Concurrent.Local(action, s))

  def activeStep (action: Action)(s: State): Outcome := {
    match action returning Outcome with
    | Action.acquire => {
      match s.producer.phase returning Outcome with
      | Phase.ready => {
        match s.slot returning Outcome with
        | Slot.empty => Outcome.ran(State.mk(Bool.true, Endpoint.mk(Phase.held, s.producer.round), s.consumer, Slot.writing, s.round, s.async))
        | _ => Outcome.blocked
      }
      | _ => Outcome.fault
    }
    | Action.issue => {
      match s.producer.phase returning Outcome with
      | Phase.held => Outcome.ran(State.mk(Bool.true, Endpoint.mk(Phase.ready, Nat.succ(s.producer.round)), s.consumer, Slot.pending, s.round, Bool.true))
      | _ => Outcome.fault
    }
    | Action.complete => {
      match s.slot returning Outcome with
      | Slot.pending => Outcome.ran(State.mk(Bool.true, s.producer, s.consumer, Slot.full, s.round, Bool.false))
      | _ => Outcome.fault
    }
    | Action.await => {
      match s.consumer.phase returning Outcome with
      | Phase.ready => {
        match s.slot returning Outcome with
        | Slot.full => Outcome.ran(State.mk(Bool.true, s.producer, Endpoint.mk(Phase.held, s.consumer.round), Slot.reading, s.round, s.async))
        | _ => Outcome.blocked
      }
      | _ => Outcome.fault
    }
    | Action.read => {
      match s.consumer.phase returning Outcome with
      | Phase.held => Outcome.ran(s)
      | _ => Outcome.fault
    }
    | Action.release => {
      match s.consumer.phase returning Outcome with
      | Phase.held => Outcome.ran(State.mk(Bool.true, s.producer, Endpoint.mk(Phase.ready, Nat.succ(s.consumer.round)), Slot.empty, Nat.succ(s.round), s.async))
      | _ => Outcome.fault
    }
    | Action.finishProducer => {
      match s.producer.phase returning Outcome with
      | Phase.ready => {
        match s.slot returning Outcome with
        | Slot.empty => Outcome.ran(State.mk(Bool.true, Endpoint.mk(Phase.done, s.producer.round), s.consumer, Slot.empty, s.round, s.async))
        | _ => Outcome.blocked
      }
      | _ => Outcome.fault
    }
    | Action.finishConsumer => {
      match s.consumer.phase returning Outcome with
      | Phase.ready => Outcome.ran(State.mk(Bool.true, s.producer, Endpoint.mk(Phase.done, s.consumer.round), s.slot, s.round, s.async))
      | _ => Outcome.fault
    }
    | Action.close => {
      match s.producer.phase returning Outcome with
      | Phase.done => {
        match s.consumer.phase returning Outcome with
        | Phase.done => Outcome.ran(State.mk(Bool.false, s.producer, s.consumer, s.slot, s.round, s.async))
        | _ => Outcome.fault
      }
      | _ => Outcome.fault
    }
  }
  def step (action: Action)(s: State): Outcome := {
    match s.active returning Outcome with
    | Bool.true => Concurrent.activeStep(action, s)
    | Bool.false => Outcome.fault
  }
  def post (s: State): Outcome -> Prop := fun (out: Outcome): Prop => {
    match out returning Prop with
    | Outcome.ran next => Invariant(next)
    | Outcome.blocked => Invariant(s)
    | Outcome.fault => False
  }
  def readyNotHeld (h: Eq(Phase, Phase.ready, Phase.held))(P: Prop): P := {
    match h returning P with
  }
  def heldNotReady (h: Eq(Phase, Phase.held, Phase.ready))(P: Prop): P := {
    match h returning P with
  }
  def doneNotReady (h: Eq(Phase, Phase.done, Phase.ready))(P: Prop): P := {
    match h returning P with
  }
  def readyNotDone (h: Eq(Phase, Phase.ready, Phase.done))(P: Prop): P := {
    match h returning P with
  }
  def heldNotDone (h: Eq(Phase, Phase.held, Phase.done))(P: Prop): P := {
    match h returning P with
  }
  def doneNotHeld (h: Eq(Phase, Phase.done, Phase.held))(P: Prop): P := {
    match h returning P with
  }
  def emptyNotPending (h: Eq(Slot, Slot.empty, Slot.pending))(P: Prop): P := {
    match h returning P with
  }
  def writingNotPending (h: Eq(Slot, Slot.writing, Slot.pending))(P: Prop): P := {
    match h returning P with
  }
  def fullNotPending (h: Eq(Slot, Slot.full, Slot.pending))(P: Prop): P := {
    match h returning P with
  }
  def readingNotPending (h: Eq(Slot, Slot.reading, Slot.pending))(P: Prop): P := {
    match h returning P with
  }

  def preserve (action: Action)(s: State)(invariant: Invariant(s))(allowed: Allowed(action, s))
      : Concurrent.post(s)(Concurrent.step(action, s)) := {
    match invariant returning Concurrent.post(s)(Concurrent.step(action, s)) with
    | Invariant.inactive n => False.elimP(Bool.falseNeTrue(allowed.left), Concurrent.post(s)(Concurrent.step(action, s)))
    | Invariant.idle n p c => {
      match action returning Concurrent.post(s)(Concurrent.step(action, s)) with
      | Action.acquire => {
          match p returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.writing(n, c)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.issue => {
          match p returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Concurrent.doneNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.complete => Concurrent.emptyNotPending(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.await => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.idle(n, p, c)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.read => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Concurrent.doneNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.release => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Concurrent.doneNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.finishProducer => {
          match p returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.idle(n, Bool.true, c)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.finishConsumer => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.idle(n, p, Bool.true)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.close => {
          match p returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotDone(allowed.right.left, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotDone(allowed.right.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Invariant.inactive(n)
        }
        }
    }
    | Invariant.writing n c => {
      match action returning Concurrent.post(s)(Concurrent.step(action, s)) with
      | Action.acquire => Concurrent.heldNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.finishProducer => Concurrent.heldNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.issue => Invariant.pending(n, c)
      | Action.complete => Concurrent.writingNotPending(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.await => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.writing(n, c)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.read => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Concurrent.doneNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.release => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Concurrent.doneNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.finishConsumer => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.writing(n, Bool.true)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.close => Concurrent.heldNotDone(allowed.right.left, Concurrent.post(s)(Concurrent.step(action, s)))
    }
    | Invariant.pending n c => {
      match action returning Concurrent.post(s)(Concurrent.step(action, s)) with
      | Action.acquire => Invariant.pending(n, c)
      | Action.finishProducer => Invariant.pending(n, c)
      | Action.issue => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.complete => Invariant.full(n, c)
      | Action.await => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.pending(n, c)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.read => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Concurrent.doneNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.release => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Concurrent.doneNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.finishConsumer => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.pending(n, Bool.true)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.close => Concurrent.readyNotDone(allowed.right.left, Concurrent.post(s)(Concurrent.step(action, s)))
    }
    | Invariant.full n c => {
      match action returning Concurrent.post(s)(Concurrent.step(action, s)) with
      | Action.acquire => Invariant.full(n, c)
      | Action.finishProducer => Invariant.full(n, c)
      | Action.issue => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.complete => Concurrent.fullNotPending(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.await => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.reading(n)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.read => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Concurrent.doneNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.release => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
          | Bool.true => Concurrent.doneNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.finishConsumer => {
          match c returning Concurrent.post(s)(Concurrent.step(action, s)) with
          | Bool.false => Invariant.full(n, Bool.true)
          | Bool.true => Concurrent.doneNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
        }
      | Action.close => Concurrent.readyNotDone(allowed.right.left, Concurrent.post(s)(Concurrent.step(action, s)))
    }
    | Invariant.reading n => {
      match action returning Concurrent.post(s)(Concurrent.step(action, s)) with
      | Action.acquire => Invariant.reading(n)
      | Action.finishProducer => Invariant.reading(n)
      | Action.read => Invariant.reading(n)
      | Action.issue => Concurrent.readyNotHeld(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.complete => Concurrent.readingNotPending(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.await => Concurrent.heldNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.finishConsumer => Concurrent.heldNotReady(allowed.right, Concurrent.post(s)(Concurrent.step(action, s)))
      | Action.release => Invariant.idle(Nat.succ(n), Bool.false, Bool.false)
      | Action.close => Concurrent.readyNotDone(allowed.right.left, Concurrent.post(s)(Concurrent.step(action, s)))
    }
  }

  def AccessSafe (action: Action)(s: State): Prop := {
    match action returning Prop with
    | Action.issue => And(Eq(Bool, s.async, Bool.false), And(Eq(Slot, s.slot, Slot.writing), Eq(Nat, s.producer.round, s.round)))
    | Action.read => And(Eq(Bool, s.async, Bool.false), And(Eq(Slot, s.slot, Slot.reading), Eq(Nat, s.consumer.round, s.round)))
    | Action.release => And(Eq(Bool, s.async, Bool.false), And(Eq(Slot, s.slot, Slot.reading), Eq(Nat, s.consumer.round, s.round)))
    | Action.close => And(Eq(Bool, s.async, Bool.false), Eq(Slot, s.slot, Slot.empty))
    | _ => True
  }
  def accessSafe (action: Action)(s: State)(invariant: Invariant(s))(allowed: Allowed(action, s)): AccessSafe(action, s) := {
    match action returning AccessSafe(action, s) with
    | Action.issue => {
      match invariant returning AccessSafe(action, s) with
      | Invariant.inactive n => False.elimP(Bool.falseNeTrue(allowed.left), AccessSafe(action, s))
      | Invariant.idle n p c => {
        match p returning AccessSafe(action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, AccessSafe(action, s))
      }
      | Invariant.writing n c => And.intro(Eq.refl(Bool.false), And.intro(Eq.refl(Slot.writing), Eq.refl(n)))
      | Invariant.pending n c => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
      | Invariant.full n c => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
      | Invariant.reading n => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
    }
    | Action.read => {
      match invariant returning AccessSafe(action, s) with
      | Invariant.inactive n => False.elimP(Bool.falseNeTrue(allowed.left), AccessSafe(action, s))
      | Invariant.idle n p c => {
        match c returning AccessSafe(action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, AccessSafe(action, s))
      }
      | Invariant.writing n c => {
        match c returning AccessSafe(action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, AccessSafe(action, s))
      }
      | Invariant.pending n c => {
        match c returning AccessSafe(action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, AccessSafe(action, s))
      }
      | Invariant.full n c => {
        match c returning AccessSafe(action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, AccessSafe(action, s))
      }
      | Invariant.reading n => And.intro(Eq.refl(Bool.false), And.intro(Eq.refl(Slot.reading), Eq.refl(n)))
    }
    | Action.release => {
      match invariant returning AccessSafe(action, s) with
      | Invariant.inactive n => False.elimP(Bool.falseNeTrue(allowed.left), AccessSafe(action, s))
      | Invariant.idle n p c => {
        match c returning AccessSafe(action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, AccessSafe(action, s))
      }
      | Invariant.writing n c => {
        match c returning AccessSafe(action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, AccessSafe(action, s))
      }
      | Invariant.pending n c => {
        match c returning AccessSafe(action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, AccessSafe(action, s))
      }
      | Invariant.full n c => {
        match c returning AccessSafe(action, s) with
        | Bool.false => Concurrent.readyNotHeld(allowed.right, AccessSafe(action, s))
        | Bool.true => Concurrent.doneNotHeld(allowed.right, AccessSafe(action, s))
      }
      | Invariant.reading n => And.intro(Eq.refl(Bool.false), And.intro(Eq.refl(Slot.reading), Eq.refl(n)))
    }
    | Action.close => {
      match invariant returning AccessSafe(action, s) with
      | Invariant.inactive n => And.intro(Eq.refl(Bool.false), Eq.refl(Slot.empty))
      | Invariant.idle n p c => And.intro(Eq.refl(Bool.false), Eq.refl(Slot.empty))
      | Invariant.writing n c => Concurrent.heldNotDone(allowed.right.left, AccessSafe(action, s))
      | Invariant.pending n c => Concurrent.readyNotDone(allowed.right.left, AccessSafe(action, s))
      | Invariant.full n c => Concurrent.readyNotDone(allowed.right.left, AccessSafe(action, s))
      | Invariant.reading n => Concurrent.readyNotDone(allowed.right.left, AccessSafe(action, s))
    }
    | _ => True.intro
  }

  // The execution relation records raw transitions, including blocked waits.
  // It does not assume the global invariant or safe buffer access.
  inductive Execution indices (actions: List(Action))(before: State)(after: State): Prop
   | done (s: State): Execution(List.nil(Action), s, s)
   | advance (action: Action)(rest: List(Action))(before: State)(mid: State)(after: State)
       (local: Allowed(action, before))(actual: Eq(Outcome, Concurrent.step(action, before), Outcome.ran(mid)))
       (tail: Execution(rest, mid, after)): Execution(List.cons(action, rest), before, after)
   | blocked (action: Action)(rest: List(Action))(before: State)(after: State)
       (local: Allowed(action, before))(actual: Eq(Outcome, Concurrent.step(action, before), Outcome.blocked))
       (tail: Execution(rest, before, after)): Execution(List.cons(action, rest), before, after)

  def advances (action: Action)(before: State)(mid: State)(valid: Invariant(before))(local: Allowed(action, before))
      (actual: Eq(Outcome, Concurrent.step(action, before), Outcome.ran(mid))): Invariant(mid) :=
    Eq.substP(actual, Concurrent.post(before), Concurrent.preserve(action, before, valid, local))

  def everyExecution (actions: List(Action))(before: State)(after: State)(execution: Execution(actions, before, after))(valid: Invariant(before))
      : Invariant(after) decreases structural(actions) := {
    match execution returning Invariant(after) with
    | Execution.done same => valid
    | Execution.advance action rest before mid after local actual tail =>
        Concurrent.everyExecution(rest, mid, after, tail, Concurrent.advances(action, before, mid, valid, local, actual))
    | Execution.blocked action rest before after local actual tail => Concurrent.everyExecution(rest, before, after, tail, valid)
  }

  // Every attempted primitive, including a blocked wait, has the access
  // precondition derived at that prefix. These are conclusions, not guards.
  inductive Audit indices (actions: List(Action))(before: State)(after: State): Prop
   | done (s: State): Audit(List.nil(Action), s, s)
   | advance (action: Action)(rest: List(Action))(before: State)(mid: State)(after: State)
       (safe: AccessSafe(action, before))(actual: Eq(Outcome, Concurrent.step(action, before), Outcome.ran(mid)))
       (tail: Audit(rest, mid, after)): Audit(List.cons(action, rest), before, after)
   | blocked (action: Action)(rest: List(Action))(before: State)(after: State)
       (safe: AccessSafe(action, before))(actual: Eq(Outcome, Concurrent.step(action, before), Outcome.blocked))
       (tail: Audit(rest, before, after)): Audit(List.cons(action, rest), before, after)
  def everyPrefix (actions: List(Action))(before: State)(after: State)(execution: Execution(actions, before, after))(valid: Invariant(before))
      : Audit(actions, before, after) decreases structural(actions) := {
    match execution returning Audit(actions, before, after) with
    | Execution.done same => Audit.done(same)
    | Execution.advance action rest before mid after local actual tail => Audit.advance(action, rest, before, mid, after,
        Concurrent.accessSafe(action, before, valid, local), actual,
        Concurrent.everyPrefix(rest, mid, after, tail, Concurrent.advances(action, before, mid, valid, local, actual)))
    | Execution.blocked action rest before after local actual tail => Audit.blocked(action, rest, before, after,
        Concurrent.accessSafe(action, before, valid, local), actual, Concurrent.everyPrefix(rest, before, after, tail, valid))
  }
}
