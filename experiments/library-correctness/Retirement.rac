import Contracts
import encoding.Lowering

// The same kernel-independent specification is used by every proof route.
// This is a retirement/coverage fragment, not a semantics of the complete GPU.
namespace Retirement {
  inductive Mode: Type
   | all: Mode
   | leader: Mode
  inductive Phase: Type
   | outside: Phase
   | live: Phase
   | finished: Phase

  struct State: Type
   | mk (live: Bool)(pending: Nat): State

  inductive Code: Type
   | skip: Code
   | issue: Code
   | finish: Code
   | local: Code
   | seq (a: Code)(b: Code): Code
   | branch (a: Code)(b: Code): Code
   | loop (body: Code): Code
   | leader (body: Code): Code
   | allocate (body: Code): Code

  def at (phase: Phase): State -> Prop := fun (s: State): Prop => {
    match phase returning Prop with
    | Phase.live => Eq(Bool, s.live, Bool.true)
    | _ => And(Eq(Bool, s.live, Bool.false), Eq(Nat, s.pending, 0))
  }

  def issue (s: State): Contracts.Outcome(State) := {
    match s.live returning Contracts.Outcome(State) with
    | Bool.true => Contracts.Outcome.ok(State.mk(Bool.true, Nat.succ(s.pending)))
    | Bool.false => Contracts.Outcome.fault(State)
  }
  // A35: a complete bulk wait of zero retires all this issuer's stores.
  def finish (s: State): Contracts.Outcome(State) := {
    match s.live returning Contracts.Outcome(State) with
    | Bool.true => Contracts.Outcome.ok(State.mk(Bool.false, 0))
    | Bool.false => Contracts.Outcome.fault(State)
  }
  def close (out: Contracts.Outcome(State)): Contracts.Outcome(State) := {
    match out returning Contracts.Outcome(State) with
    | Contracts.Outcome.fault => Contracts.Outcome.fault(State)
    | Contracts.Outcome.ok s => {
      match s.live returning Contracts.Outcome(State) with
      | Bool.true => Contracts.Outcome.fault(State)
      | Bool.false => {
        match s.pending returning Contracts.Outcome(State) with
        | Nat.zero => Contracts.Outcome.ok(s)
        | Nat.succ n => Contracts.Outcome.fault(State)
      }
    }
  }
  def scoped (body: Contracts.Runtime -> State -> Contracts.Outcome(State))(r: Contracts.Runtime)(s: State): Contracts.Outcome(State) := {
    match s.live returning Contracts.Outcome(State) with
    | Bool.true => Contracts.Outcome.fault(State)
    | Bool.false => Retirement.close(body(r, State.mk(Bool.true, 0)))
  }

  def run (code: Code)(isLeader: Bool)(r: Contracts.Runtime)(s: State): Contracts.Outcome(State) decreases structural(code) := {
    match code returning Contracts.Outcome(State) with
    | Code.skip => Contracts.Outcome.ok(s)
    | Code.issue => Retirement.issue(s)
    | Code.finish => Retirement.finish(s)
    | Code.local => Contracts.Outcome.ok(s)
    | Code.seq a b => Contracts.sequence(
        fun (r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Retirement.run(a, isLeader, r, s),
        fun (r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Retirement.run(b, isLeader, r, s), r, s)
    | Code.branch a b => Contracts.branch(
        fun (r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Retirement.run(a, isLeader, r, s),
        fun (r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Retirement.run(b, isLeader, r, s), r, s)
    | Code.loop body => Contracts.repeat(fun (r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Retirement.run(body, isLeader, r, s), r, s)
    | Code.leader body => Contracts.select(isLeader, Retirement.run(body, isLeader, r, s), Contracts.Outcome.ok(s))
    | Code.allocate body => Retirement.scoped(fun (r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Retirement.run(body, isLeader, r, s), r, s)
  }
  def interpretation (code: Code)(isLeader: Bool): Contracts.Runtime -> State -> Contracts.Outcome(State) :=
    fun (r: Contracts.Runtime)(s: State): Contracts.Outcome(State) => Retirement.run(code, isLeader, r, s)

  // An effect judgment. It is ordinary indexed data in this experiment.
  // A new primitive typing rule would have to produce exactly this evidence.
  inductive Typed indices (mode: Mode)(code: Code)(before: Phase)(after: Phase): Prop
   | skip (mode: Mode)(p: Phase): Typed(mode, Code.skip, p, p)
   | local (mode: Mode)(p: Phase): Typed(mode, Code.local, p, p)
   | issue: Typed(Mode.all, Code.issue, Phase.live, Phase.live)
   | finish: Typed(Mode.all, Code.finish, Phase.live, Phase.finished)
   | seq (mode: Mode)(a: Code)(b: Code)(p: Phase)(q: Phase)(r: Phase)
       (left: Typed(mode, a, p, q))(right: Typed(mode, b, q, r)): Typed(mode, Code.seq(a, b), p, r)
   | branch (mode: Mode)(a: Code)(b: Code)(p: Phase)(q: Phase)
       (yes: Typed(mode, a, p, q))(no: Typed(mode, b, p, q)): Typed(mode, Code.branch(a, b), p, q)
   | loop (mode: Mode)(body: Code)(p: Phase)(valid: Typed(mode, body, p, p)): Typed(mode, Code.loop(body), p, p)
   | leader (mode: Mode)(body: Code)(p: Phase)(valid: Typed(Mode.leader, body, p, p)): Typed(mode, Code.leader(body), p, p)
   | allocate (body: Code)(valid: Typed(Mode.all, body, Phase.live, Phase.finished)): Typed(Mode.all, Code.allocate(body), Phase.outside, Phase.outside)

  def issueSafe: Contracts.Safe(Retirement.interpretation(Code.issue, Bool.true), Retirement.at(Phase.live), Retirement.at(Phase.live)) :=
    fun (r: Contracts.Runtime)(s: State)(h: Retirement.at(Phase.live)(s)): Contracts.Post(Retirement.at(Phase.live), Retirement.issue(s)) => {
      match s returning Contracts.Post(Retirement.at(Phase.live), Retirement.issue(s)) with
      | State.mk live pending => {
        match h returning Contracts.Post(Retirement.at(Phase.live), Retirement.issue(s)) with
        | Eq.refl same => Eq.refl(Bool.true)
      }
    }
  def finishSafe: Contracts.Safe(Retirement.interpretation(Code.finish, Bool.true), Retirement.at(Phase.live), Retirement.at(Phase.finished)) :=
    fun (r: Contracts.Runtime)(s: State)(h: Retirement.at(Phase.live)(s)): Contracts.Post(Retirement.at(Phase.finished), Retirement.finish(s)) => {
      match s returning Contracts.Post(Retirement.at(Phase.finished), Retirement.finish(s)) with
      | State.mk live pending => {
        match h returning Contracts.Post(Retirement.at(Phase.finished), Retirement.finish(s)) with
        | Eq.refl same => And.intro(Eq.refl(Bool.false), Eq.refl(0))
      }
    }
  def closedSafe (out: Contracts.Outcome(State))(h: Contracts.Post(Retirement.at(Phase.finished), out))
      : Contracts.Post(Retirement.at(Phase.outside), Retirement.close(out)) := {
    match out returning Contracts.Post(Retirement.at(Phase.outside), Retirement.close(out)) with
    | Contracts.Outcome.fault => h
    | Contracts.Outcome.ok s => {
      match s returning Contracts.Post(Retirement.at(Phase.outside), Retirement.close(out)) with
      | State.mk live pending => {
        match h.left returning Contracts.Post(Retirement.at(Phase.outside), Retirement.close(out)) with
        | Eq.refl same => {
          match h.right returning Contracts.Post(Retirement.at(Phase.outside), Retirement.close(out)) with
          | Eq.refl same => And.intro(Eq.refl(Bool.false), Eq.refl(0))
        }
      }
    }
  }
  def scopedSafe (body: Contracts.Runtime -> State -> Contracts.Outcome(State))
      (valid: Contracts.Safe(body, Retirement.at(Phase.live), Retirement.at(Phase.finished)))
      (r: Contracts.Runtime)(s: State)(h: Retirement.at(Phase.outside)(s))
      : Contracts.Post(Retirement.at(Phase.outside), Retirement.scoped(body, r, s)) := {
    match s returning Contracts.Post(Retirement.at(Phase.outside), Retirement.scoped(body, r, s)) with
    | State.mk live pending => {
      match h.left returning Contracts.Post(Retirement.at(Phase.outside), Retirement.scoped(body, r, s)) with
      | Eq.refl same => Retirement.closedSafe(body(r, State.mk(Bool.true, 0)), valid(r, State.mk(Bool.true, 0), Eq.refl(Bool.true)))
    }
  }

  // This is semantic preservation, not merely a certificate accessor.
  // Both CTA ranks, all branch choices and all loop counts are quantified.
  def sound {mode: Mode}{before: Phase}{after: Phase}(code: Code)(valid: Typed(mode, code, before, after))(isLeader: Bool)
      : Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) decreases structural(code) := {
    match code returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
    | Code.skip => {
      match valid returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
      | Typed.skip m p => fun (r: Contracts.Runtime)(s: State)(h: Retirement.at(p)(s)): Contracts.Post(Retirement.at(p), Contracts.Outcome.ok(s)) => h
    }
    | Code.local => {
      match valid returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
      | Typed.local m p => fun (r: Contracts.Runtime)(s: State)(h: Retirement.at(p)(s)): Contracts.Post(Retirement.at(p), Contracts.Outcome.ok(s)) => h
    }
    | Code.issue => {
      match valid returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
      | Typed.issue => Retirement.issueSafe
    }
    | Code.finish => {
      match valid returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
      | Typed.finish => Retirement.finishSafe
    }
    | Code.seq a b => {
      match valid returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
      | Typed.seq m a b p q t left right => Contracts.sequenceSafe(Retirement.interpretation(a, isLeader), Retirement.interpretation(b, isLeader),
          Retirement.at(p), Retirement.at(q), Retirement.at(t), Retirement.sound(a, left, isLeader), Retirement.sound(b, right, isLeader))
    }
    | Code.branch a b => {
      match valid returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
      | Typed.branch m a b p q yes no => Contracts.branchSafe(Retirement.interpretation(a, isLeader), Retirement.interpretation(b, isLeader),
          Retirement.at(p), Retirement.at(q), Retirement.sound(a, yes, isLeader), Retirement.sound(b, no, isLeader))
    }
    | Code.loop body => {
      match valid returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
      | Typed.loop m body p h => Contracts.repeatSafe(Retirement.interpretation(body, isLeader), Retirement.at(p), Retirement.sound(body, h, isLeader))
    }
    | Code.leader body => {
      match valid returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
      | Typed.leader m body p h => fun (r: Contracts.Runtime)(s: State)(initial: Retirement.at(p)(s))
          : Contracts.Post(Retirement.at(p), Retirement.run(code, isLeader, r, s)) =>
        Contracts.selectSafe(isLeader, Retirement.at(p), Retirement.run(body, isLeader, r, s), Contracts.Outcome.ok(s),
          Retirement.sound(body, h, isLeader)(r, s, initial), initial)
    }
    | Code.allocate body => {
      match valid returning Contracts.Safe(Retirement.interpretation(code, isLeader), Retirement.at(before), Retirement.at(after)) with
      | Typed.allocate body h => fun (r: Contracts.Runtime)(s: State)(initial: Retirement.at(Phase.outside)(s))
          : Contracts.Post(Retirement.at(Phase.outside), Retirement.run(code, isLeader, r, s)) =>
        Retirement.scopedSafe(Retirement.interpretation(body, isLeader), Retirement.sound(body, h, isLeader), r, s, initial)
    }
  }
}
