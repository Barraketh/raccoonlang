import Ring

namespace RingClient {
  // Clients build descriptions eagerly. These combinators emit runtime control;
  // they do not preview callback execution or ask clients for a safety proof.
  def inspect: Ring.Read := Ring.choose(Ring.read, Ring.then(Ring.read, Ring.read))
  def program: Ring.Program := Ring.program(
    Ring.producer(Ring.repeat(Ring.fill)),
    Ring.consumer(Ring.repeat(Ring.take(RingClient.inspect))))
}
Ring.render(RingClient.program)
