// Count-one barriers used by the single-CTA copy ring. These are raw platform
// operations: this module deliberately contains no ring invariant or safety proof.
// Separate expected/completed totals represent a signed transaction balance,
// including completion before expectation; Nat subtraction would lose that case.
namespace Mbarrier {
  struct State: Type
   | mk (live: Bool)(fenced: Bool)(visible: Bool)(epoch: Nat)(arrival: Bool)
       (expected: Nat)(completed: Nat)(observed: Bool): State
  def dead: State := State.mk(Bool.false, Bool.false, Bool.false, 0, Bool.true, 0, 0, Bool.true)
  def initial: State := State.mk(Bool.true, Bool.false, Bool.false, 0, Bool.true, 0, 0, Bool.true)
  def waiting (epoch: Nat)(observed: Bool): State := State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.true, 0, 0, observed)
  def pending (epoch: Nat)(bytes: Nat): State := State.mk(Bool.true, Bool.true, Bool.true, epoch, Bool.false, bytes, 0, Bool.true)
  inductive Action: Type
   | init: Action
   | fenceInit: Action
   | publish: Action
   | arrive (bytes: Nat): Action
   | complete (bytes: Nat): Action
   | wait (epoch: Nat): Action
   | invalidate: Action
  inductive Outcome: Type
   | ran (state: State): Outcome
   | blocked: Outcome
   | fault: Outcome

  // A phase advances only when its arrival and its signed transaction debt
  // both reach zero. A new phase resets the count-one arrival obligation.
  def settle (s: State): State := {
    match s.arrival returning State with
    | Bool.true => s
    | Bool.false => {
      match Nat.beq(s.expected, s.completed) returning State with
      | Bool.false => s
      | Bool.true => State.mk(s.live, s.fenced, s.visible, Nat.succ(s.epoch), Bool.true, 0, 0, Bool.false)
    }
  }
  def arrive (bytes: Nat)(s: State): Outcome := {
    match s.arrival returning Outcome with
    | Bool.false => Outcome.fault
    | Bool.true => {
      match s.observed returning Outcome with
      | Bool.false => Outcome.fault
      | Bool.true => Outcome.ran(Mbarrier.settle(State.mk(s.live, s.fenced, s.visible, s.epoch,
          Bool.false, Nat.add(s.expected, bytes), s.completed, s.observed)))
    }
  }
  def wait (epoch: Nat)(s: State): Outcome := {
    match Nat.beq(s.epoch, epoch) returning Outcome with
    | Bool.true => Outcome.blocked
    | Bool.false => {
      match Nat.beq(s.epoch, Nat.succ(epoch)) returning Outcome with
      | Bool.false => Outcome.fault
      | Bool.true => Outcome.ran(State.mk(s.live, s.fenced, s.visible, s.epoch, s.arrival,
          s.expected, s.completed, Bool.true))
    }
  }
  def liveStep (action: Action)(s: State): Outcome := {
    match action returning Outcome with
    | Action.init => Outcome.fault
    | Action.fenceInit => Outcome.ran(State.mk(s.live, Bool.true, s.visible, s.epoch, s.arrival, s.expected, s.completed, s.observed))
    | Action.publish => {
      match s.fenced returning Outcome with
      | Bool.false => Outcome.fault
      | Bool.true => Outcome.ran(State.mk(s.live, s.fenced, Bool.true, s.epoch, s.arrival, s.expected, s.completed, s.observed))
    }
    | Action.arrive bytes => Mbarrier.arrive(bytes, s)
    | Action.complete bytes => Outcome.ran(Mbarrier.settle(State.mk(s.live, s.fenced, s.visible, s.epoch,
        s.arrival, s.expected, Nat.add(s.completed, bytes), s.observed)))
    | Action.wait epoch => Mbarrier.wait(epoch, s)
    | Action.invalidate => Outcome.ran(Mbarrier.dead)
  }
  def step (action: Action)(s: State): Outcome := {
    match s.live returning Outcome with
    | Bool.true => Mbarrier.liveStep(action, s)
    | Bool.false => {
      match action returning Outcome with
      | Action.init => Outcome.ran(Mbarrier.initial)
      | _ => Outcome.fault
    }
  }
}
