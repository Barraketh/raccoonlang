import Structural

namespace Representation {
  // The actual checker and its existing universal soundness proof accept it.
  def checked: Core.WellFormed(Core.representationCounterexample) := Check.Clean.mk(List.nil(String), List.nil(String), List.nil(String), List.nil(String), List.nil(String), List.nil(String), List.nil(String))
  def structurallySound: Spec.WellFormed(Core.kernelSyntax(Core.representationCounterexample)) :=
    Structural.everyRenderedProgram(Core.representationCounterexample, Representation.checked)
  def actualBody: Eq(Cuda.Block, Core.kernelSyntax(Core.representationCounterexample).body, Core.representationBody) := Eq.refl(Core.representationBody)
  // With 32 threads, thread 0 reaches this CTA barrier and thread 1 skips it.
  def reaches (thread: Nat): Bool := Nat.beq(thread, 0)
  def firstReaches: Eq(Bool, Representation.reaches(0), Bool.true) := Eq.refl(Bool.true)
  def peerSkips: Eq(Bool, Representation.reaches(1), Bool.false) := Eq.refl(Bool.false)
}
Core.render(Core.representationCounterexample)
