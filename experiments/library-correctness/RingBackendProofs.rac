import Ring
import RingBackend
import Endpoints
import Arithmetic
import proofs.WellFormed

// Proofs about the concrete CudaAst-generating ring API and its independent
// native-template specification. These establish syntax and checker facts;
// they do not establish the NVIDIA platform contracts for compound safety.
namespace RingBackendProofs {
  open Endpoints.{Role, Code, Typed, Transition}
  open Concurrent.{Phase, Action}
  open Cuda

  // Every well-typed endpoint syntax lowers according to the independent
  // atomic template relation, even when branch and loop allocations depend
  // on fresh identifiers selected by preceding syntax.
  def compilePlan (role: Role)(code: Code)(before: Phase)(after: Phase)
      (valid: Typed(role, code, before, after))(fresh: Nat)
      : RingBackend.Plan(role, code, Ring.compile(role, code, fresh).block) decreases structural(code) := {
    match valid returning RingBackend.Plan(role, code, Ring.compile(role, code, fresh).block) with
    | Typed.skip role phase => RingBackend.Plan.skip(role)
    | Typed.atom role action before after transition => {
      match transition returning RingBackend.Plan(role, Code.atom(action), Ring.compile(role, Code.atom(action), fresh).block) with
      | Transition.acquire => RingBackend.Plan.atom(Role.producer, Action.acquire, fresh, Ring.compile(Role.producer, Code.atom(Action.acquire), fresh).block, RingBackend.Atomic.acquire(fresh))
      | Transition.issue => RingBackend.Plan.atom(Role.producer, Action.issue, fresh, Ring.compile(Role.producer, Code.atom(Action.issue), fresh).block, RingBackend.Atomic.issue(fresh))
      | Transition.finishProducer => RingBackend.Plan.atom(Role.producer, Action.finishProducer, fresh, Ring.compile(Role.producer, Code.atom(Action.finishProducer), fresh).block, RingBackend.Atomic.finishProducer(fresh))
      | Transition.await => RingBackend.Plan.atom(Role.consumer, Action.await, fresh, Ring.compile(Role.consumer, Code.atom(Action.await), fresh).block, RingBackend.Atomic.await(fresh))
      | Transition.read => RingBackend.Plan.atom(Role.consumer, Action.read, fresh, Ring.compile(Role.consumer, Code.atom(Action.read), fresh).block, RingBackend.Atomic.read(fresh))
      | Transition.release => RingBackend.Plan.atom(Role.consumer, Action.release, fresh, Ring.compile(Role.consumer, Code.atom(Action.release), fresh).block, RingBackend.Atomic.release(fresh))
      | Transition.finishConsumer => RingBackend.Plan.atom(Role.consumer, Action.finishConsumer, fresh, Ring.compile(Role.consumer, Code.atom(Action.finishConsumer), fresh).block, RingBackend.Atomic.finishConsumer(fresh))
    }
    | Typed.seq role a b before middle after left right => {
      let leftPlan := RingBackendProofs.compilePlan(role, a, before, middle, left, fresh)
      let rightPlan := RingBackendProofs.compilePlan(role, b, middle, after, right, Ring.compile(role, a, fresh).next)
      RingBackend.Plan.sequence(role, a, b, Ring.compile(role, a, fresh).block,
        Ring.compile(role, b, Ring.compile(role, a, fresh).next).block, leftPlan, rightPlan)
    }
    | Typed.branch role a b before after yes no => {
      let yesPlan := RingBackendProofs.compilePlan(role, a, before, after, yes, fresh)
      let noPlan := RingBackendProofs.compilePlan(role, b, before, after, no, Ring.compile(role, a, fresh).next)
      RingBackend.Plan.branch(role, a, b, Ring.compile(role, a, fresh).block,
        Ring.compile(role, b, Ring.compile(role, a, fresh).next).block, yesPlan, noPlan)
    }
    | Typed.loop role body phase inner => {
      let bodyPlan := RingBackendProofs.compilePlan(role, body, phase, phase, inner, Nat.succ(fresh))
      RingBackend.Plan.loop(role, body, fresh, Ring.compile(role, body, Nat.succ(fresh)).block, bodyPlan)
    }
  }

  def atomicNoCollectives {role: Role}{action: Action}{fresh: Nat}{block: Block}
      (native: RingBackend.Atomic(role, action, fresh, block)) : RingBackend.NoCollectives(block) := {
    match native returning RingBackend.NoCollectives(block) with
    | RingBackend.Atomic.acquire fresh => And.intro(True.intro, True.intro)
    | RingBackend.Atomic.issue fresh => And.intro(True.intro, And.intro(True.intro, And.intro(True.intro, True.intro)))
    | RingBackend.Atomic.await fresh => And.intro(True.intro, True.intro)
    | RingBackend.Atomic.read fresh => And.intro(True.intro, True.intro)
    | RingBackend.Atomic.release fresh => And.intro(True.intro, And.intro(True.intro, And.intro(True.intro, True.intro)))
    | RingBackend.Atomic.finishProducer fresh => And.intro(True.intro, True.intro)
    | RingBackend.Atomic.finishConsumer fresh => True.intro
  }

  // The Plan constructors mirror exactly the recursive AST shape checked by
  // NoCollectives, so the endpoint proof composes through all control forms.
  def planNoCollectives (role: Role)(code: Code)(block: Block)
      (plan: RingBackend.Plan(role, code, block)) : RingBackend.NoCollectives(block) decreases structural(code) := {
    match plan returning RingBackend.NoCollectives(block) with
    | RingBackend.Plan.skip role => True.intro
    | RingBackend.Plan.atom role action fresh block native => RingBackendProofs.atomicNoCollectives(native)
    | RingBackend.Plan.sequence role a b left right first second =>
      And.intro(RingBackendProofs.planNoCollectives(role, a, left, first), And.intro(RingBackendProofs.planNoCollectives(role, b, right, second), True.intro))
    | RingBackend.Plan.branch role a b yes no first second =>
      And.intro(And.intro(RingBackendProofs.planNoCollectives(role, a, yes, first), RingBackendProofs.planNoCollectives(role, b, no, second)), True.intro)
    | RingBackend.Plan.loop role body fresh inner bodyPlan =>
      And.intro(RingBackendProofs.planNoCollectives(role, body, inner, bodyPlan), True.intro)
  }

  // Layout facts are concrete arithmetic consequences of the fixed ring
  // constants: barrier bytes fit before the 1024-byte stage, the stage fits
  // in 9216 bytes, its base is aligned, and launcher geometry and tensor map
  // match the native load contract.
  def layout: RingBackend.Layout :=
    And.intro(Eq.refl(Bool.true), And.intro(Eq.refl(Bool.true),
      And.intro(Eq.refl(Nat.zero), And.intro(Eq.refl(64), Eq.refl(Ring.launcher.maps)))))

  def everyProgram (p: Ring.Program): RingBackend.Artifact(p) := {
    let producer := Ring.producerOf(p)
    let consumer := Ring.consumerOf(p)
    let producerCode := Endpoints.syntax(producer)
    let consumerCode := Endpoints.syntax(consumer)
    let producerValid := Endpoints.typing(producer)
    let consumerValid := Endpoints.typing(consumer)
    let producerPlan := RingBackendProofs.compilePlan(Role.producer, producerCode, Phase.ready, Phase.done, producerValid, 2)
    let consumerFresh := Ring.compile(Role.producer, producerCode, 2).next
    let consumerPlan := RingBackendProofs.compilePlan(Role.consumer, consumerCode, Phase.ready, Phase.done, consumerValid, consumerFresh)
    RingBackend.Artifact.mk(p, producerPlan, consumerPlan, Eq.refl(Ring.setup), Eq.refl(Ring.close), RingBackendProofs.layout,
      Eq.refl(Ring.kernel(p)))
  }

  def everyEndpointNoCollectives (p: Ring.Program)
      : And(RingBackend.NoCollectives(Ring.compile(Role.producer, Endpoints.syntax(Ring.producerOf(p)), 2).block),
        RingBackend.NoCollectives(Ring.compile(Role.consumer, Endpoints.syntax(Ring.consumerOf(p)),
          Ring.compile(Role.producer, Endpoints.syntax(Ring.producerOf(p)), 2).next).block)) := {
    let producer := Ring.producerOf(p)
    let consumer := Ring.consumerOf(p)
    let producerPlan := RingBackendProofs.compilePlan(Role.producer, Endpoints.syntax(producer), Phase.ready, Phase.done, Endpoints.typing(producer), 2)
    let consumerFresh := Ring.compile(Role.producer, Endpoints.syntax(producer), 2).next
    let consumerPlan := RingBackendProofs.compilePlan(Role.consumer, Endpoints.syntax(consumer), Phase.ready, Phase.done, Endpoints.typing(consumer), consumerFresh)
    And.intro(RingBackendProofs.planNoCollectives(Role.producer, Endpoints.syntax(producer), Ring.compile(Role.producer, Endpoints.syntax(producer), 2).block, producerPlan),
      RingBackendProofs.planNoCollectives(Role.consumer, Endpoints.syntax(consumer),
        Ring.compile(Role.consumer, Endpoints.syntax(consumer), consumerFresh).block, consumerPlan))
  }

  // This is exactly the structural subset required by Ring.render. It inherits
  // the documented omissions of Check.WellFormed and Spec.WellFormed.
  def everyRenderedProgram (p: Ring.Program)[ok: Check.WellFormed(Ring.kernel(p))]
      : Spec.WellFormed(Ring.kernel(p)) := WellFormed.sound(Ring.kernel(p), ok)
}
