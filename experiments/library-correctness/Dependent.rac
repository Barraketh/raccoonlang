import Retirement

// Candidate: elaborate ordinary source into ordinary indexed commands.
// No new kernel typing judgment or typing-reflection axiom is used here.
namespace Dependent {
  open Retirement
  sealed struct Cmd (mode: Mode)(before: Phase)(after: Phase): Type
   | mk (code: Code)(valid: Typed(mode, code, before, after)): Cmd(mode, before, after)

  def skip (mode: Mode)(p: Phase): Cmd(mode, p, p) := Cmd.mk(Code.skip, Typed.skip(mode, p))
  def local (mode: Mode)(p: Phase): Cmd(mode, p, p) := Cmd.mk(Code.local, Typed.local(mode, p))
  def issue: Cmd(Mode.all, Phase.live, Phase.live) := Cmd.mk(Code.issue, Typed.issue)
  def finish: Cmd(Mode.all, Phase.live, Phase.finished) := Cmd.mk(Code.finish, Typed.finish)
  def sequence {mode: Mode}{p: Phase}{q: Phase}{r: Phase}(a: Cmd(mode, p, q))(b: Cmd(mode, q, r)): Cmd(mode, p, r) :=
    Cmd.mk(Code.seq(a.code, b.code), Typed.seq(mode, a.code, b.code, p, q, r, a.valid, b.valid))
  def branch {mode: Mode}{p: Phase}{q: Phase}(a: Cmd(mode, p, q))(b: Cmd(mode, p, q)): Cmd(mode, p, q) :=
    Cmd.mk(Code.branch(a.code, b.code), Typed.branch(mode, a.code, b.code, p, q, a.valid, b.valid))
  def loop {mode: Mode}{p: Phase}(body: Cmd(mode, p, p)): Cmd(mode, p, p) :=
    Cmd.mk(Code.loop(body.code), Typed.loop(mode, body.code, p, body.valid))
  def leader (mode: Mode)(p: Phase)(body: Cmd(Mode.leader, p, p)): Cmd(mode, p, p) :=
    Cmd.mk(Code.leader(body.code), Typed.leader(mode, body.code, p, body.valid))
  def allocate (body: Cmd(Mode.all, Phase.live, Phase.finished)): Cmd(Mode.all, Phase.outside, Phase.outside) :=
    Cmd.mk(Code.allocate(body.code), Typed.allocate(body.code, body.valid))

  def code {mode: Mode}{p: Phase}{q: Phase}(cmd: Cmd(mode, p, q)): Code := cmd.code
  def valid {mode: Mode}{p: Phase}{q: Phase}(cmd: Cmd(mode, p, q)): Typed(mode, cmd.code, p, q) := cmd.valid
  def safe {mode: Mode}{p: Phase}{q: Phase}(cmd: Cmd(mode, p, q))(isLeader: Bool)
      : Contracts.Safe(Retirement.interpretation(cmd.code, isLeader), Retirement.at(p), Retirement.at(q)) :=
    Retirement.sound(cmd.code, cmd.valid, isLeader)

  def Program: Type := Cmd(Mode.all, Phase.outside, Phase.outside)
  // This theorem checks with an unknown program, not any selected kernel.
  def everyProgram (p: Program)(isLeader: Bool)(runtime: Contracts.Runtime)
      : Contracts.Post(Retirement.at(Phase.outside), Retirement.run(p.code, isLeader, runtime, State.mk(Bool.false, 0))) :=
    Dependent.safe(p, isLeader)(runtime, State.mk(Bool.false, 0), And.intro(Eq.refl(Bool.false), Eq.refl(0)))

  // The native-rule candidate's derivation can be elaborated into this API.
  // Conversely each command already carries that same derivation.
  def elaborateDerivation {mode: Mode}{p: Phase}{q: Phase}(code: Code)(proof: Typed(mode, code, p, q)): Cmd(mode, p, q) :=
    Cmd.mk(code, proof)
}
