import RingPrimitives

// Independently stated preconditions for each executed library primitive. None
// are guards of RingPrimitives.run, and the endpoint typing rules do not contain
// these predicates. Proofs must derive them for arbitrary admitted executions.
namespace RingObligations {
  def Usable (s: Mbarrier.State): Prop := And(Eq(Bool, s.live, Bool.true), Eq(Bool, s.visible, Bool.true))
  def PhaseValid (epoch: Nat)(s: Mbarrier.State): Prop := Or(Eq(Nat, s.epoch, epoch), Eq(Nat, s.epoch, Nat.succ(epoch)))
  def Quiescent (s: Mbarrier.State): Prop := And(Eq(Bool, s.arrival, Bool.true), And(Eq(Nat, s.expected, 0), Eq(Nat, s.completed, 0)))
  def SafeBarrier (action: Mbarrier.Action)(s: Mbarrier.State)(joined: Bool): Prop := {
    match action returning Prop with
    | Mbarrier.Action.init => Eq(Bool, s.live, Bool.false)
    | Mbarrier.Action.fenceInit => Eq(Bool, s.live, Bool.true)
    | Mbarrier.Action.publish => And(Eq(Bool, s.live, Bool.true), Eq(Bool, s.fenced, Bool.true))
    // Setup's sole arrival is by its initializing thread before publication.
    | Mbarrier.Action.arrive bytes => And(Or(RingObligations.Usable(s), Eq(Mbarrier.State, s, Mbarrier.initial)),
        And(Eq(Bool, s.live, Bool.true), And(Eq(Bool, s.arrival, Bool.true), Eq(Bool, s.observed, Bool.true))))
    // This fragment has one whole-box completion per issue. The platform may
    // split that completion physically; the model coalesces its final event.
    | Mbarrier.Action.complete bytes => And(RingObligations.Usable(s), And(Eq(Bool, s.arrival, Bool.false),
        And(Eq(Nat, s.expected, bytes), Eq(Nat, s.completed, 0))))
    | Mbarrier.Action.wait epoch => And(RingObligations.Usable(s), RingObligations.PhaseValid(epoch, s))
    | Mbarrier.Action.invalidate => And(RingObligations.Usable(s), And(Eq(Bool, joined, Bool.true), RingObligations.Quiescent(s)))
  }
  def Safe (p: RingPrimitives.Primitive)(w: RingPrimitives.World): Prop := {
    match p returning Prop with
    | RingPrimitives.Primitive.full action => RingObligations.SafeBarrier(action, w.full, w.joined)
    | RingPrimitives.Primitive.empty action => RingObligations.SafeBarrier(action, w.empty, w.joined)
    | RingPrimitives.Primitive.proxyFence => And(RingObligations.Usable(w.full), RingObligations.Quiescent(w.full))
    | RingPrimitives.Primitive.join => And(RingObligations.Quiescent(w.full), RingObligations.Quiescent(w.empty))
  }
  inductive Audit indices (ps: List(RingPrimitives.Primitive))(before: RingPrimitives.World)(out: RingPrimitives.Outcome): Prop
   | done (w: RingPrimitives.World): Audit(List.nil(RingPrimitives.Primitive), w, RingPrimitives.Outcome.ran(w))
   | advance (p: RingPrimitives.Primitive)(rest: List(RingPrimitives.Primitive))(before: RingPrimitives.World)(mid: RingPrimitives.World)(out: RingPrimitives.Outcome)
       (safe: RingObligations.Safe(p, before))
       (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, before), RingPrimitives.Outcome.ran(mid)))
       (tail: Audit(rest, mid, out)): Audit(List.cons(p, rest), before, out)
   | blocked (p: RingPrimitives.Primitive)(rest: List(RingPrimitives.Primitive))(before: RingPrimitives.World)
       (safe: RingObligations.Safe(p, before))
       (actual: Eq(RingPrimitives.Outcome, RingPrimitives.step(p, before), RingPrimitives.Outcome.blocked))
       : Audit(List.cons(p, rest), before, RingPrimitives.Outcome.blocked)
  // One reusable specification for a compound source operation. Its statement
  // includes both the actual primitive implementation and independent safety;
  // neither component is a premise of local typing or primitive execution.
  def CorrectMacro (bytes: Nat)(action: Concurrent.Action)(s: Concurrent.State): Prop :=
    And(Eq(RingPrimitives.Outcome,
      RingPrimitives.run(RingPrimitives.implementation(bytes, action, s), RingPrimitives.world(bytes, s)),
      RingPrimitives.modelResult(bytes, Concurrent.step(action, s))),
    Audit(RingPrimitives.implementation(bytes, action, s), RingPrimitives.world(bytes, s),
      RingPrimitives.modelResult(bytes, Concurrent.step(action, s))))
  // A scheduler history keeps blocked attempts as separate prefixes so another
  // actor can run while a wait is suspended. It records each actual source
  // outcome and the corresponding primitive refinement/audit, with no local
  // typing or joint invariant assumed as a field of this safety conclusion.
  inductive History (bytes: Nat) indices (actions: List(Concurrent.Action))(before: Concurrent.State)(after: Concurrent.State): Prop
   | done (s: Concurrent.State): History(bytes, List.nil(Concurrent.Action), s, s)
   | advance (action: Concurrent.Action)(rest: List(Concurrent.Action))(before: Concurrent.State)(mid: Concurrent.State)(after: Concurrent.State)
       (actual: Eq(Concurrent.Outcome, Concurrent.step(action, before), Concurrent.Outcome.ran(mid)))
       (primitive: RingObligations.CorrectMacro(bytes, action, before))(tail: History(bytes, rest, mid, after))
       : History(bytes, List.cons(action, rest), before, after)
   | blocked (action: Concurrent.Action)(rest: List(Concurrent.Action))(before: Concurrent.State)(after: Concurrent.State)
       (actual: Eq(Concurrent.Outcome, Concurrent.step(action, before), Concurrent.Outcome.blocked))
       (primitive: RingObligations.CorrectMacro(bytes, action, before))(tail: History(bytes, rest, before, after))
       : History(bytes, List.cons(action, rest), before, after)
}
