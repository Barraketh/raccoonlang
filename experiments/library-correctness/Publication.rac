import Outputs

namespace Publication {
  // Unlike output ownership, publication cannot discard an unwritten chunk.
  inductive Writes indices (budget: Nat)(writes: List(Nat))(before: List(Nat))(after: List(Nat)): Prop
   | skip (available: List(Nat)): Writes(0, List.nil(Nat), available, available)
   | next (budget: Nat)(address: Nat)(rest: List(Nat))(before: List(Nat))(mid: List(Nat))(after: List(Nat))
       (consumed: Outputs.Erase(address, before, mid))(tail: Writes(budget, rest, mid, after)): Writes(Nat.succ(budget), List.cons(address, rest), before, after)
  def eraseConserves (address: Nat)(before: List(Nat))(after: List(Nat))(erased: Outputs.Erase(address, before, after))
      (other: Nat)(member: Spec.Mem(Nat, other, before)): Or(Eq(Nat, other, address), Spec.Mem(Nat, other, after)) decreases structural(before) := {
    match erased returning Or(Eq(Nat, other, address), Spec.Mem(Nat, other, after)) with
    | Outputs.Erase.here rest => {
      match member returning Or(Eq(Nat, other, address), Spec.Mem(Nat, other, after)) with
      | Spec.Mem.here tail => Or.inl(Spec.Mem(Nat, address, rest), Eq.refl(address))
      | Spec.Mem.there head tail there => Or.inr(Eq(Nat, other, address), there)
    }
    | Outputs.Erase.there head before after tail => {
      match member returning Or(Eq(Nat, other, address), Spec.Mem(Nat, other, List.cons(head, after))) with
      | Spec.Mem.here rest => Or.inr(Eq(Nat, head, address), Spec.Mem.here(head, after))
      | Spec.Mem.there head rest there => {
        match Publication.eraseConserves(address, before, after, tail, other, there) returning Or(Eq(Nat, other, address), Spec.Mem(Nat, other, List.cons(head, after))) with
        | Or.inl same => Or.inl(Spec.Mem(Nat, other, List.cons(head, after)), same)
        | Or.inr later => Or.inr(Eq(Nat, other, address), Spec.Mem.there(head, after, later))
      }
    }
  }
  def conserved (budget: Nat)(writes: List(Nat))(before: List(Nat))(after: List(Nat))(valid: Writes(budget, writes, before, after))
      (address: Nat)(member: Spec.Mem(Nat, address, before)): Or(Spec.Mem(Nat, address, writes), Spec.Mem(Nat, address, after)) decreases structural(budget) := {
    match valid returning Or(Spec.Mem(Nat, address, writes), Spec.Mem(Nat, address, after)) with
    | Writes.skip available => Or.inr(Spec.Mem(Nat, address, List.nil(Nat)), member)
    | Writes.next k head rest before mid after consumed tail => {
      match Publication.eraseConserves(head, before, mid, consumed, address, member) returning Or(Spec.Mem(Nat, address, List.cons(head, rest)), Spec.Mem(Nat, address, after)) with
      | Or.inl same => {
        match same returning Or(Spec.Mem(Nat, address, List.cons(head, rest)), Spec.Mem(Nat, address, after)) with
        | Eq.refl a => Or.inl(Spec.Mem(Nat, a, after), Spec.Mem.here(a, rest))
      }
      | Or.inr remaining => {
        match Publication.conserved(k, rest, mid, after, tail, address, remaining) returning Or(Spec.Mem(Nat, address, List.cons(head, rest)), Spec.Mem(Nat, address, after)) with
        | Or.inl written => Or.inl(Spec.Mem(Nat, address, after), Spec.Mem.there(head, rest, written))
        | Or.inr later => Or.inr(Spec.Mem(Nat, address, List.cons(head, rest)), later)
      }
    }
  }
  def asTrace (budget: Nat)(writes: List(Nat))(before: List(Nat))(after: List(Nat))(valid: Writes(budget, writes, before, after)): Outputs.Trace(budget, writes, before, after) decreases structural(budget) := {
    match valid returning Outputs.Trace(budget, writes, before, after) with
    | Writes.skip available => Outputs.Trace.skip(available)
    | Writes.next k head rest before mid after consumed tail => Outputs.Trace.write(k, head, rest, before, mid, after, consumed, Publication.asTrace(k, rest, mid, after, tail))
  }
  def complete (budget: Nat)(writes: List(Nat))(expected: List(Nat))(valid: Writes(budget, writes, expected, List.nil(Nat)))
      (address: Nat)(needed: Spec.Mem(Nat, address, expected)): Spec.Mem(Nat, address, writes) := {
    match Publication.conserved(budget, writes, expected, List.nil(Nat), valid, address, needed) returning Spec.Mem(Nat, address, writes) with
    | Or.inl written => written
    | Or.inr remaining => {
      match remaining returning Spec.Mem(Nat, address, writes) with
    }
  }
  def fill (first: Nat)(count: Nat): Writes(count, Outputs.range(first, count), Outputs.range(first, count), List.nil(Nat)) decreases structural(count) := {
    match count returning Writes(count, Outputs.range(first, count), Outputs.range(first, count), List.nil(Nat)) with
    | Nat.zero => Writes.skip(List.nil(Nat))
    | Nat.succ k => Writes.next(k, first, Outputs.range(Nat.succ(first), k), Outputs.range(first, count), Outputs.range(Nat.succ(first), k), List.nil(Nat),
        Outputs.Erase.here(first, Outputs.range(Nat.succ(first), k)), Publication.fill(Nat.succ(first), k))
  }
  sealed struct Published (count: Nat): Type
   | mk (writes: List(Nat))(valid: Writes(count, writes, Outputs.range(0, count), List.nil(Nat))): Published(count)
  def filled (count: Nat): Published(count) := Published.mk(Outputs.range(0, count), Publication.fill(0, count))
  def writes {count: Nat}(p: Published(count)): List(Nat) := p.writes
  def everyChunk {count: Nat}(p: Published(count))(address: Nat)(needed: Spec.Mem(Nat, address, Outputs.range(0, count))): Spec.Mem(Nat, address, Publication.writes(p)) := Publication.complete(count, p.writes, Outputs.range(0, count), p.valid, address, needed)
  def exactlyOnce {count: Nat}(p: Published(count)): Outputs.Unique(Publication.writes(p)) := Outputs.everyTrace(count, p.writes, Outputs.range(0, count), List.nil(Nat), Publication.asTrace(count, p.writes, Outputs.range(0, count), List.nil(Nat), p.valid), Outputs.rangeUnique(0, count))
}
