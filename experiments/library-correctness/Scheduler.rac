import EndpointEffects

namespace Scheduler {
  open Concurrent.{Phase, Action, Outcome, State}
  open Endpoints.{Role, Queue}
  def peer (role: Role): Role := {
    match role returning Role with
    | Role.producer => Role.consumer
    | Role.consumer => Role.producer
  }
  def queueAt (role: Role): Phase -> Type := fun (phase: Phase): Type => Queue(role, phase)
  struct Poll (role: Role)(before: State): Type
   | mk (state: State)(own: Queue(role, Endpoints.phase(role, state)))(other: Queue(Scheduler.peer(role), Endpoints.other(role, state)))
       (valid: Concurrent.Invariant(state))(active: Eq(Bool, state.active, Bool.true))
       (actions: List(Action))(execution: Concurrent.Execution(actions, before, state)): Poll(role, before)

  def stay (role: Role)(s: State)(own: Queue(role, Endpoints.phase(role, s)))(other: Queue(Scheduler.peer(role), Endpoints.other(role, s)))
      (valid: Concurrent.Invariant(s))(active: Eq(Bool, s.active, Bool.true)): Poll(role, s) :=
    Poll.mk(s, own, other, valid, active, List.nil(Action), Concurrent.Execution.done(s))

  // Blocked instructions stay at the queue head they cannot grant ownership.
  def poll (role: Role)(s: State)(own: Queue(role, Endpoints.phase(role, s)))(other: Queue(Scheduler.peer(role), Endpoints.other(role, s)))
      (valid: Concurrent.Invariant(s))(active: Eq(Bool, s.active, Bool.true)): Poll(role, s) := {
    match own.actions returning Poll(role, s) with
    | List.nil => Scheduler.stay(role, s, own, other, valid, active)
    | List.cons action rest => {
      let before := Endpoints.phase(role, s)
      let after := Endpoints.nextPhase(action)
      let head := Endpoints.head(role, action, rest, before, own.valid)
      let tail := Endpoints.tail(role, action, rest, before, own.valid)
      let local := Endpoints.allowed(role, action, before, after, s, head, Eq.refl(before), active)
      match actual: Concurrent.step(action, s) returning Poll(role, s) with
      | Outcome.ran next => {
        let effects := Eq.substP(actual, EndpointEffects.post(role, after, s), EndpointEffects.effects(role, action, before, after, s, head, Eq.refl(before), active))
        let nextOwn := Eq.subst(Eq.symm(effects.left), Level.zero, Scheduler.queueAt(role), Queue.mk(rest, tail))
        let nextOther := Eq.subst(Eq.symm(effects.right.left), Level.zero, Scheduler.queueAt(Scheduler.peer(role)), other)
        Poll.mk(next, nextOwn, nextOther, Concurrent.advances(action, s, next, valid, local, actual), effects.right.right,
          List.cons(action, List.nil(Action)), Concurrent.Execution.advance(action, List.nil(Action), s, next, next, local, actual, Concurrent.Execution.done(next)))
      }
      | Outcome.blocked => Poll.mk(s, own, other, valid, active, List.cons(action, List.nil(Action)),
          Concurrent.Execution.blocked(action, List.nil(Action), s, s, local, actual, Concurrent.Execution.done(s)))
      | Outcome.fault => False.elim(Eq.substP(actual, Concurrent.post(s), Concurrent.preserve(action, s, valid, local)), Poll(role, s))
    }
  }

  struct Joint (s: State): Type
   | mk (producer: Queue(Role.producer, s.producer.phase))(consumer: Queue(Role.consumer, s.consumer.phase))
       (valid: Concurrent.Invariant(s))(active: Eq(Bool, s.active, Bool.true)): Joint(s)
  struct Result (before: State): Type
   | mk (state: State)(joint: Joint(state))(actions: List(Action))(execution: Concurrent.Execution(actions, before, state)): Result(before)
  inductive Choice: Type
   | producer: Choice
   | consumer: Choice
   | completion: Choice

  def selected (role: Role)(s: State)(polled: Poll(role, s)): Result(s) := {
    match role returning Result(s) with
    | Role.producer => Result.mk(polled.state, Joint.mk(polled.own, polled.other, polled.valid, polled.active), polled.actions, polled.execution)
    | Role.consumer => Result.mk(polled.state, Joint.mk(polled.other, polled.own, polled.valid, polled.active), polled.actions, polled.execution)
  }
  def unchanged (s: State)(joint: Joint(s)): Result(s) := Result.mk(s, joint, List.nil(Action), Concurrent.Execution.done(s))
  def completionState (s: State): State := State.mk(Bool.true, s.producer, s.consumer, Concurrent.Slot.full, s.round, Bool.false)
  def completionRuns (s: State)(active: Eq(Bool, s.active, Bool.true))(pending: Eq(Concurrent.Slot, s.slot, Concurrent.Slot.pending))
      : Eq(Outcome, Concurrent.step(Action.complete, s), Outcome.ran(Scheduler.completionState(s))) := {
    match s.active returning Eq(Outcome, Concurrent.step(Action.complete, s), Outcome.ran(Scheduler.completionState(s))) with
    | Bool.false => False.elimP(Bool.falseNeTrue(active), Eq(Outcome, Concurrent.step(Action.complete, s), Outcome.ran(Scheduler.completionState(s))))
    | Bool.true => {
      match s.slot returning Eq(Outcome, Concurrent.step(Action.complete, s), Outcome.ran(Scheduler.completionState(s))) with
      | Concurrent.Slot.pending => Eq.refl(Outcome.ran(Scheduler.completionState(s)))
      | Concurrent.Slot.empty => Concurrent.emptyNotPending(pending, Eq(Outcome, Concurrent.step(Action.complete, s), Outcome.ran(Scheduler.completionState(s))))
      | Concurrent.Slot.writing => Concurrent.writingNotPending(pending, Eq(Outcome, Concurrent.step(Action.complete, s), Outcome.ran(Scheduler.completionState(s))))
      | Concurrent.Slot.full => Concurrent.fullNotPending(pending, Eq(Outcome, Concurrent.step(Action.complete, s), Outcome.ran(Scheduler.completionState(s))))
      | Concurrent.Slot.reading => Concurrent.readingNotPending(pending, Eq(Outcome, Concurrent.step(Action.complete, s), Outcome.ran(Scheduler.completionState(s))))
    }
  }
  def completion (s: State)(joint: Joint(s)): Result(s) := {
    match s.slot returning Result(s) with
    | Concurrent.Slot.pending => {
      let next := Scheduler.completionState(s)
      let local := And.intro(joint.active, Eq.refl(Concurrent.Slot.pending))
      let actual := Scheduler.completionRuns(s, joint.active, Eq.refl(Concurrent.Slot.pending))
      Result.mk(next, Joint.mk(joint.producer, joint.consumer, Concurrent.advances(Action.complete, s, next, joint.valid, local, actual), Eq.refl(Bool.true)),
        List.cons(Action.complete, List.nil(Action)), Concurrent.Execution.advance(Action.complete, List.nil(Action), s, next, next,
          local, actual, Concurrent.Execution.done(next)))
    }
    | _ => Scheduler.unchanged(s, joint)
  }
  def tick (choice: Choice)(s: State)(joint: Joint(s)): Result(s) := {
    match choice returning Result(s) with
    | Choice.producer => Scheduler.selected(Role.producer, s, Scheduler.poll(Role.producer, s, joint.producer, joint.consumer, joint.valid, joint.active))
    | Choice.consumer => Scheduler.selected(Role.consumer, s, Scheduler.poll(Role.consumer, s, joint.consumer, joint.producer, joint.valid, joint.active))
    | Choice.completion => Scheduler.completion(s, joint)
  }
  def append (a: List(Action))(b: List(Action))(s: State)(mid: State)(end: State)
      (left: Concurrent.Execution(a, s, mid))(right: Concurrent.Execution(b, mid, end))
      : Concurrent.Execution(List.append(a, b), s, end) decreases structural(a) := {
    match left returning Concurrent.Execution(List.append(a, b), s, end) with
    | Concurrent.Execution.done same => right
    | Concurrent.Execution.advance action rest s next mid local actual tail => Concurrent.Execution.advance(action, List.append(rest, b), s, next, end, local, actual, Scheduler.append(rest, b, next, mid, end, tail, right))
    | Concurrent.Execution.blocked action rest s mid local actual tail => Concurrent.Execution.blocked(action, List.append(rest, b), s, end, local, actual, Scheduler.append(rest, b, s, mid, end, tail, right))
  }
  def run (choices: List(Choice))(s: State)(joint: Joint(s)): Result(s) decreases structural(choices) := {
    match choices returning Result(s) with
    | List.nil => Scheduler.unchanged(s, joint)
    | List.cons choice rest => {
      let head := Scheduler.tick(choice, s, joint)
      let tail := Scheduler.run(rest, head.state, head.joint)
      Result.mk(tail.state, tail.joint, List.append(head.actions, tail.actions),
        Scheduler.append(head.actions, tail.actions, s, head.state, tail.state, head.execution, tail.execution))
    }
  }
  def start (producer: Endpoints.Cmd(Role.producer, Phase.ready, Phase.done))(consumer: Endpoints.Cmd(Role.consumer, Phase.ready, Phase.done))
      (pRuntime: Contracts.Runtime)(cRuntime: Contracts.Runtime): Joint(Concurrent.initial) :=
    Joint.mk(Endpoints.queue(producer, pRuntime), Endpoints.queue(consumer, cRuntime), Concurrent.Invariant.idle(0, Bool.false, Bool.false), Eq.refl(Bool.true))
  def kernel (producer: Endpoints.Cmd(Role.producer, Phase.ready, Phase.done))(consumer: Endpoints.Cmd(Role.consumer, Phase.ready, Phase.done))
      (pRuntime: Contracts.Runtime)(cRuntime: Contracts.Runtime)(choices: List(Choice)): Result(Concurrent.initial) :=
    Scheduler.run(choices, Concurrent.initial, Scheduler.start(producer, consumer, pRuntime, cRuntime))
  def everyKernel (producer: Endpoints.Cmd(Role.producer, Phase.ready, Phase.done))(consumer: Endpoints.Cmd(Role.consumer, Phase.ready, Phase.done))
      (pRuntime: Contracts.Runtime)(cRuntime: Contracts.Runtime)(choices: List(Choice))
      : Concurrent.Audit(Scheduler.kernel(producer, consumer, pRuntime, cRuntime, choices).actions, Concurrent.initial, Scheduler.kernel(producer, consumer, pRuntime, cRuntime, choices).state) := {
    let result := Scheduler.kernel(producer, consumer, pRuntime, cRuntime, choices)
    Concurrent.everyPrefix(result.actions, Concurrent.initial, result.state, result.execution, Concurrent.Invariant.idle(0, Bool.false, Bool.false))
  }

  def closedState (s: State): State := State.mk(Bool.false, s.producer, s.consumer, s.slot, s.round, s.async)
  def closeRuns (s: State)(active: Eq(Bool, s.active, Bool.true))
      (producer: Eq(Phase, s.producer.phase, Phase.done))(consumer: Eq(Phase, s.consumer.phase, Phase.done))
      : Eq(Outcome, Concurrent.step(Action.close, s), Outcome.ran(Scheduler.closedState(s))) := {
    match s.active returning Eq(Outcome, Concurrent.step(Action.close, s), Outcome.ran(Scheduler.closedState(s))) with
    | Bool.false => False.elimP(Bool.falseNeTrue(active), Eq(Outcome, Concurrent.step(Action.close, s), Outcome.ran(Scheduler.closedState(s))))
    | Bool.true => {
      match s.producer.phase returning Eq(Outcome, Concurrent.step(Action.close, s), Outcome.ran(Scheduler.closedState(s))) with
      | Phase.ready => Concurrent.readyNotDone(producer, Eq(Outcome, Concurrent.step(Action.close, s), Outcome.ran(Scheduler.closedState(s))))
      | Phase.held => Concurrent.heldNotDone(producer, Eq(Outcome, Concurrent.step(Action.close, s), Outcome.ran(Scheduler.closedState(s))))
      | Phase.done => {
        match s.consumer.phase returning Eq(Outcome, Concurrent.step(Action.close, s), Outcome.ran(Scheduler.closedState(s))) with
        | Phase.ready => Concurrent.readyNotDone(consumer, Eq(Outcome, Concurrent.step(Action.close, s), Outcome.ran(Scheduler.closedState(s))))
        | Phase.held => Concurrent.heldNotDone(consumer, Eq(Outcome, Concurrent.step(Action.close, s), Outcome.ran(Scheduler.closedState(s))))
        | Phase.done => Eq.refl(Outcome.ran(Scheduler.closedState(s)))
      }
    }
  }
  def retirement (s: State)(joint: Joint(s))
      (producerEmpty: Eq(List(Action), joint.producer.actions, List.nil(Action)))
      (consumerEmpty: Eq(List(Action), joint.consumer.actions, List.nil(Action)))
      : And(Concurrent.AccessSafe(Action.close, s), Concurrent.Invariant(Scheduler.closedState(s))) := {
    let producerDone := Endpoints.emptyDone(Role.producer, s.producer.phase, joint.producer, producerEmpty)
    let consumerDone := Endpoints.emptyDone(Role.consumer, s.consumer.phase, joint.consumer, consumerEmpty)
    let local := And.intro(joint.active, And.intro(producerDone, consumerDone))
    And.intro(Concurrent.accessSafe(Action.close, s, joint.valid, local),
      Concurrent.advances(Action.close, s, Scheduler.closedState(s), joint.valid, local, Scheduler.closeRuns(s, joint.active, producerDone, consumerDone)))
  }
}
