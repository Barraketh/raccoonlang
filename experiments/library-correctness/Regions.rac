import Arithmetic
import proofs.Lib

namespace Regions {
  struct Region: Type
   | mk (base: Nat)(bytes: Nat): Region
  def end (r: Region): Nat := Nat.add(r.base, r.bytes)
  def Contains (r: Region)(address: Nat): Prop := And(Nat.le(r.base, address), Nat.lt(address, Regions.end(r)))
  def contains (r: Region): Nat -> Prop := fun (address: Nat): Prop => Regions.Contains(r, address)
  def Separate (a: Region)(b: Region): Prop := Or(Nat.le(Regions.end(a), b.base), Nat.le(Regions.end(b), a.base))

  def noAlias (a: Region)(b: Region)(separate: Separate(a, b))(address: Nat)(left: Contains(a, address))(right: Contains(b, address)): False := {
    match separate returning False with
    | Or.inl ab => Arithmetic.strictNotReverse(address, Regions.end(a), left.right,
        Arithmetic.transitive(Regions.end(a), b.base, address, ab, right.left))
    | Or.inr ba => Arithmetic.strictNotReverse(address, Regions.end(b), right.right,
        Arithmetic.transitive(Regions.end(b), a.base, address, ba, left.left))
  }

  inductive Layout indices (regions: List(Region))(top: Nat): Prop
   | empty: Layout(List.nil(Region), 0)
   | reserve (regions: List(Region))(top: Nat)(base: Nat)(bytes: Nat)
       (previous: Layout(regions, top))(after: Nat.le(top, base))
       : Layout(List.cons(Region.mk(base, bytes), regions), Nat.add(base, bytes))

  def bounded (regions: List(Region))(top: Nat)(valid: Layout(regions, top))(r: Region)(member: Spec.Mem(Region, r, regions))
      : Nat.le(Regions.end(r), top) decreases structural(regions) := {
    match regions returning Nat.le(Regions.end(r), top) with
    | List.nil => {
      match member returning Nat.le(Regions.end(r), top) with
    }
    | List.cons fresh rest => {
      match valid returning Nat.le(Regions.end(r), top) with
      | Layout.reserve rest old base bytes previous after => {
        match member returning Nat.le(Regions.end(r), top) with
        | Spec.Mem.here tail => Arithmetic.reflexive(Nat.add(base, bytes))
        | Spec.Mem.there head tail there => Arithmetic.transitive(Regions.end(r), old, Nat.add(base, bytes),
            Regions.bounded(rest, old, previous, r, there), Arithmetic.transitive(old, base, Nat.add(base, bytes), after, Arithmetic.addBound(base, bytes)))
      }
    }
  }
  def oldSeparated (regions: List(Region))(top: Nat)(valid: Layout(regions, top))(base: Nat)(bytes: Nat)(after: Nat.le(top, base))
      (old: Region)(member: Spec.Mem(Region, old, regions)): Separate(Region.mk(base, bytes), old) :=
    Or.inr(Nat.le(Nat.add(base, bytes), old.base), Arithmetic.transitive(Regions.end(old), top, base, Regions.bounded(regions, top, valid, old, member), after))

  // Bump allocation computes evidence for the new layout. Its safety comes
  // from the old-layout induction, rather than assuming pairwise separation.
  sealed struct Arena (limit: Nat): Type
   | mk (regions: List(Region))(top: Nat)(layout: Layout(regions, top))(fits: Nat.le(top, limit)): Arena(limit)
  struct Placement (top: Nat)(limit: Nat)(bytes: Nat)(align: Nat): Type
   | mk (base: Nat)(after: Nat.le(top, base))(fits: Nat.le(Nat.add(base, bytes), limit))(aligned: Eq(Nat, Nat.mod(base, align), 0))(positive: Nat.lt(0, align)): Placement(top, limit, bytes, align)
  def empty (limit: Nat): Arena(limit) := Arena.mk(limit, List.nil(Region), 0, Layout.empty, Eq.refl(Bool.true))
  def top {limit: Nat}(a: Arena(limit)): Nat := a.top
  def regions {limit: Nat}(a: Arena(limit)): List(Region) := a.regions
  def reserve {limit: Nat}(a: Arena(limit))(bytes: Nat)(align: Nat)(place: Placement(a.top, limit, bytes, align)): Arena(limit) :=
    Arena.mk(limit, List.cons(Region.mk(place.base, bytes), a.regions), Nat.add(place.base, bytes),
      Layout.reserve(a.regions, a.top, place.base, bytes, a.layout, place.after), place.fits)
  def everyAccessInBounds {limit: Nat}(a: Arena(limit))(r: Region)(member: Spec.Mem(Region, r, a.regions))(address: Nat)(inside: Contains(r, address)): Nat.lt(address, limit) :=
    Arithmetic.transitive(Nat.succ(address), Regions.end(r), limit, inside.right,
      Arithmetic.transitive(Regions.end(r), a.top, limit, Regions.bounded(a.regions, a.top, a.layout, r, member), a.fits))
  def freshDoesNotAlias {limit: Nat}(a: Arena(limit))(bytes: Nat)(align: Nat)(place: Placement(a.top, limit, bytes, align))
      (old: Region)(member: Spec.Mem(Region, old, a.regions))(address: Nat)
      (fresh: Contains(Region.mk(place.base, bytes), address))(previous: Contains(old, address)): False :=
    Regions.noAlias(Region.mk(place.base, bytes), old, Regions.oldSeparated(a.regions, a.top, a.layout, place.base, bytes, place.after, old, member), address, fresh, previous)

  // Proof-producing placement validation; failed configurations yield no arena.
  // The caller may propose Core.alignUp(top, align), or any other offset.
  def placement (top: Nat)(limit: Nat)(bytes: Nat)(align: Nat)(base: Nat): Option(Placement(top, limit, bytes, align)) := {
    match Bool.decEq(Nat.blt(0, align), Bool.true) returning Option(Placement(top, limit, bytes, align)) with
    | Decidable.isFalse no => Option.none(Placement(top, limit, bytes, align))
    | Decidable.isTrue positive => {
      match Bool.decEq(Nat.ble(top, base), Bool.true) returning Option(Placement(top, limit, bytes, align)) with
      | Decidable.isFalse no => Option.none(Placement(top, limit, bytes, align))
      | Decidable.isTrue after => {
        match Bool.decEq(Nat.ble(Nat.add(base, bytes), limit), Bool.true) returning Option(Placement(top, limit, bytes, align)) with
        | Decidable.isFalse no => Option.none(Placement(top, limit, bytes, align))
        | Decidable.isTrue fits => {
          match Nat.decEq(Nat.mod(base, align), 0) returning Option(Placement(top, limit, bytes, align)) with
          | Decidable.isFalse no => Option.none(Placement(top, limit, bytes, align))
          | Decidable.isTrue aligned => Option.some(Placement.mk(top, limit, bytes, align, base, after, fits, aligned, positive))
        }
      }
    }
  }
}
