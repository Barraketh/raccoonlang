import Ring
import RingLibrary
import RingProofs
import RingBackendProofs
import RingParityProofs
import Coupled
import Scheduler
import Endpoints
import RingPrimitives

// Assemble the independent primitive, backend, race, participation, parity,
// checker, setup and conditional shutdown guarantees for each public Program.
namespace RingLibraryProofs {
  def setupSafe: RingLibrary.SetupSafe :=
    And.intro(RingProofs.setupResult(Ring.bytes), RingProofs.setupAudit(Ring.bytes))

  def ShutdownConclusion (result: Scheduler.Result(Concurrent.initial)): Prop :=
    And(Eq(Concurrent.Outcome, Concurrent.step(Concurrent.Action.close, result.state),
      Concurrent.Outcome.ran(Scheduler.closedState(result.state))),
      And(And(Concurrent.AccessSafe(Concurrent.Action.close, result.state), Concurrent.Invariant(Scheduler.closedState(result.state))),
        RingObligations.CorrectMacro(Ring.bytes, Concurrent.Action.close, result.state)))

  def shutdownAtResult (result: Scheduler.Result(Concurrent.initial))
      (producerEmpty: Eq(List(Concurrent.Action), result.joint.producer.actions, List.nil(Concurrent.Action)))
      (consumerEmpty: Eq(List(Concurrent.Action), result.joint.consumer.actions, List.nil(Concurrent.Action)))
      : RingLibraryProofs.ShutdownConclusion(result) := {
    let producerDone := Endpoints.emptyDone(Endpoints.Role.producer, result.state.producer.phase, result.joint.producer, producerEmpty)
    let consumerDone := Endpoints.emptyDone(Endpoints.Role.consumer, result.state.consumer.phase, result.joint.consumer, consumerEmpty)
    let rawClose := Scheduler.closeRuns(result.state, result.joint.active, producerDone, consumerDone)
    let retired := RingProofs.retirementClose(Ring.bytes, result.state, result.joint, producerEmpty, consumerEmpty, Eq.refl(Bool.true))
    And.intro(rawClose, retired)
  }

  def shutdownSafe (p: Ring.Program)(pr: Contracts.Runtime)(cr: Contracts.Runtime)(schedule: List(Scheduler.Choice))
      : RingLibrary.ShutdownSafe(p, pr, cr, schedule) := {
    let result := Ring.execute(p, pr, cr, schedule)
    fun (producerEmpty: Eq(List(Concurrent.Action), result.joint.producer.actions, List.nil(Concurrent.Action)))
        (consumerEmpty: Eq(List(Concurrent.Action), result.joint.consumer.actions, List.nil(Concurrent.Action))):
        RingLibraryProofs.ShutdownConclusion(result) =>
      RingLibraryProofs.shutdownAtResult(result, producerEmpty, consumerEmpty)
  }

  def everyProgram (p: Ring.Program)(pr: Contracts.Runtime)(cr: Contracts.Runtime)(schedule: List(Scheduler.Choice))
      : RingLibrary.Guarantees(p, pr, cr, schedule) := {
    let backend := RingBackendProofs.everyProgram(p)
    let primitives := RingProofs.everyProgram(p, pr, cr, schedule)
    let memory := Coupled.noRace(Ring.producerOf(p), Ring.consumerOf(p), pr, cr, schedule)
    let participation := RingBackendProofs.everyEndpointNoCollectives(p)
    let phase := RingParityProofs.everyKernel(Ring.producerOf(p), Ring.consumerOf(p), pr, cr, schedule)
    let checked := fun (clean: Check.WellFormed(Ring.kernel(p))): Spec.WellFormed(Ring.kernel(p)) =>
      RingBackendProofs.everyRenderedProgram(p)[clean]
    let shutdown := RingLibraryProofs.shutdownSafe(p, pr, cr, schedule)
    And.intro(backend, And.intro(primitives, And.intro(memory, And.intro(participation,
      And.intro(phase, And.intro(checked, And.intro(RingLibraryProofs.setupSafe, shutdown)))))))
  }
}
