import Ring
import RingBackend
import RingObligations
import Coupled
import RingParity

// The user-facing theorem subject is an unknown actual library Program.
// This predicate assembles separately meaningful results about its source
// execution and its actual CUDA lowering. It does not take kernel-specific
// safety certificates from clients, nor define correctness as a stored field.
namespace RingLibrary {
  def Participation (p: Ring.Program): Prop :=
    And(RingBackend.NoCollectives(Ring.compile(Endpoints.Role.producer, Endpoints.syntax(Ring.producerOf(p)), 2).block),
      RingBackend.NoCollectives(Ring.compile(Endpoints.Role.consumer, Endpoints.syntax(Ring.consumerOf(p)),
        Ring.compile(Endpoints.Role.producer, Endpoints.syntax(Ring.producerOf(p)), 2).next).block))
  def MemorySafe (p: Ring.Program)(pr: Contracts.Runtime)(cr: Contracts.Runtime)(schedule: List(Scheduler.Choice)): Prop :=
    History.RaceFree(Coupled.kernelHistory(Ring.producerOf(p), Ring.consumerOf(p), pr, cr, schedule))
  def CheckSound (p: Ring.Program): Prop := (clean: Check.WellFormed(Ring.kernel(p))) -> Spec.WellFormed(Ring.kernel(p))
  def PhaseSafe (p: Ring.Program)(pr: Contracts.Runtime)(cr: Contracts.Runtime)(schedule: List(Scheduler.Choice)): Prop :=
    Exists(RingParity.Bits, RingParity.TraceResult(Ring.execute(p, pr, cr, schedule).actions, Concurrent.initial,
      Ring.execute(p, pr, cr, schedule).state, RingParity.initial))
  def SetupSafe: Prop :=
    And(Eq(RingPrimitives.Outcome, RingPrimitives.run(RingPrimitives.setup, RingPrimitives.dead),
      RingPrimitives.Outcome.ran(RingPrimitives.world(Ring.bytes, Concurrent.initial))),
      RingObligations.Audit(RingPrimitives.setup, RingPrimitives.dead,
        RingPrimitives.Outcome.ran(RingPrimitives.world(Ring.bytes, Concurrent.initial))))
  // Finite schedules may leave either endpoint suspended. Closing becomes
  // safe when their actual queues are exhausted; clients supply no global
  // quiescence premise. This conditional belongs to the public specification.
  def ShutdownSafe (p: Ring.Program)(pr: Contracts.Runtime)(cr: Contracts.Runtime)(schedule: List(Scheduler.Choice)): Prop := {
    let result := Ring.execute(p, pr, cr, schedule)
    (producerEmpty: Eq(List(Concurrent.Action), result.joint.producer.actions, List.nil(Concurrent.Action))) ->
    (consumerEmpty: Eq(List(Concurrent.Action), result.joint.consumer.actions, List.nil(Concurrent.Action))) ->
      And(Eq(Concurrent.Outcome, Concurrent.step(Concurrent.Action.close, result.state),
        Concurrent.Outcome.ran(Scheduler.closedState(result.state))),
        And(And(Concurrent.AccessSafe(Concurrent.Action.close, result.state),
          Concurrent.Invariant(Scheduler.closedState(result.state))),
          RingObligations.CorrectMacro(Ring.bytes, Concurrent.Action.close, result.state)))
  }
  def Guarantees (p: Ring.Program)(pr: Contracts.Runtime)(cr: Contracts.Runtime)(schedule: List(Scheduler.Choice)): Prop :=
    And(RingBackend.Artifact(p),
      And(RingObligations.History(Ring.bytes, Ring.execute(p, pr, cr, schedule).actions, Concurrent.initial, Ring.execute(p, pr, cr, schedule).state),
        And(RingLibrary.MemorySafe(p, pr, cr, schedule),
          And(RingLibrary.Participation(p), And(RingLibrary.PhaseSafe(p, pr, cr, schedule),
            And(RingLibrary.CheckSound(p), And(RingLibrary.SetupSafe, RingLibrary.ShutdownSafe(p, pr, cr, schedule))))))))
}
