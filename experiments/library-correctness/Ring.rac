import Endpoints
import Scheduler
import Cuda
import Check

// A concrete, deliberately restricted API slice: one 64x64 bf16 input box,
// one stage, one producer thread and one consumer thread in a 64-thread CTA.
// Endpoints is the authoritative source typing relation; this API does not
// introduce a second state-machine judgment or accept arbitrary CUDA callbacks.
namespace Ring {
  open Concurrent.{Phase}
  open Endpoints.{Role, Cmd}
  open Cuda
  def Producer: Type := Cmd(Role.producer, Phase.ready, Phase.done)
  def Consumer: Type := Cmd(Role.consumer, Phase.ready, Phase.done)
  def ProducerStep: Type := Cmd(Role.producer, Phase.ready, Phase.ready)
  def ConsumerStep: Type := Cmd(Role.consumer, Phase.ready, Phase.ready)
  def Read: Type := Cmd(Role.consumer, Phase.held, Phase.held)
  def fill: Cmd(Role.producer, Phase.ready, Phase.ready) := Endpoints.sequence(Endpoints.acquire, Endpoints.issue)
  def read: Cmd(Role.consumer, Phase.held, Phase.held) := Endpoints.read
  def take (body: Cmd(Role.consumer, Phase.held, Phase.held)): Cmd(Role.consumer, Phase.ready, Phase.ready) :=
    Endpoints.sequence(Endpoints.await, Endpoints.sequence(body, Endpoints.release))
  def then {role: Role}{p: Phase}{q: Phase}{r: Phase}(a: Cmd(role, p, q))(b: Cmd(role, q, r)): Cmd(role, p, r) := Endpoints.sequence(a, b)
  def choose {role: Role}{p: Phase}{q: Phase}(yes: Cmd(role, p, q))(no: Cmd(role, p, q)): Cmd(role, p, q) := Endpoints.branch(yes, no)
  def repeat {role: Role}{p: Phase}(body: Cmd(role, p, p)): Cmd(role, p, p) := Endpoints.loop(body)
  def producer (body: Cmd(Role.producer, Phase.ready, Phase.ready)): Producer := Endpoints.sequence(body, Endpoints.finishProducer)
  def consumer (body: Cmd(Role.consumer, Phase.ready, Phase.ready)): Consumer := Endpoints.sequence(body, Endpoints.finishConsumer)
  sealed struct Program: Type
   | mk (producer: Producer)(consumer: Consumer): Program
  def program (producer: Producer)(consumer: Consumer): Program := Program.mk(producer, consumer)
  def producerOf (p: Program): Producer := p.producer
  def consumerOf (p: Program): Consumer := p.consumer
  def execute (p: Program)(pr: Contracts.Runtime)(cr: Contracts.Runtime)(schedule: List(Scheduler.Choice)): Scheduler.Result(Concurrent.initial) :=
    Scheduler.kernel(p.producer, p.consumer, pr, cr, schedule)
  def bytes: Nat := 8192
  def sharedBytes: Nat := 9216

  // Root-owned physical layout and launch metadata. Barriers occupy [0,16),
  // the 1024-aligned stage occupies [1024,9216); clients cannot change them.
  def fullBar: Expr := Expr.sharedAddr(0)
  def emptyBar: Expr := Expr.sharedAddr(8)
  def one (s: Stmt): Block := Block.seq(s, Block.done)
  def sequence (a: Block)(b: Block): Block := Block.seq(Stmt.scoped(a), Block.seq(Stmt.scoped(b), Block.done))
  def atThread (thread: Nat)(body: Block): Stmt := Stmt.ifElse(Expr.bin(BinOp.eq, Expr.special(Builtin.threadX), Expr.lit(thread)), body, Block.done)
  def parity (role: Role): Nat := {
    match role returning Nat with
    | Role.producer => 0
    | Role.consumer => 1
  }
  def flag (role: Role): Expr := {
    match role returning Expr with
    | Role.producer => Expr.param("Pflag")
    | Role.consumer => Expr.param("Cflag")
  }
  def count (role: Role): Expr := {
    match role returning Expr with
    | Role.producer => Expr.param("PK")
    | Role.consumer => Expr.param("CK")
  }
  def flip (role: Role): Stmt := Stmt.assign(Ring.parity(role), Expr.bin(BinOp.bxor, Expr.var(Ring.parity(role)), Expr.lit(1)))
  def wait (bar: Expr)(role: Role): Stmt := Stmt.instr(Instr.mbarWait(BarrierScope.cta, bar, Expr.var(Ring.parity(role))))
  def atom (role: Role)(action: Concurrent.Action)(fresh: Nat): Block := {
    match action returning Block with
    | Concurrent.Action.acquire => Ring.one(Ring.wait(Ring.emptyBar, role))
    | Concurrent.Action.issue => Block.seq(Stmt.instr(Instr.mbarArrive(Window.cta, Ring.fullBar, Arrival.expectTx(Expr.lit(Ring.bytes)))),
        Block.seq(Stmt.instr(Instr.tmaLoad(CtaGroup.one, Expr.sharedAddr(1024), Expr.paramAddr("I_map"), Expr.lit(0), Expr.lit(0), Ring.fullBar)),
        Block.seq(Ring.flip(role), Block.done)))
    | Concurrent.Action.await => Ring.one(Ring.wait(Ring.fullBar, role))
    | Concurrent.Action.read => Ring.one(Stmt.decl(DType.bf16, fresh, Expr.index(Expr.sharedPtr(DType.bf16, 1024), Expr.lit(0))))
    | Concurrent.Action.release => Block.seq(Stmt.instr(Instr.fenceProxyAsync),
        Block.seq(Stmt.instr(Instr.mbarArrive(Window.cta, Ring.emptyBar, Arrival.one)), Block.seq(Ring.flip(role), Block.done)))
    | Concurrent.Action.finishProducer => Ring.one(Ring.wait(Ring.emptyBar, role))
    | Concurrent.Action.finishConsumer => Block.done
    | _ => Ring.one(Stmt.error("ring: an environmental or root action occurred in an endpoint"))
  }
  struct Lowered: Type
   | mk (next: Nat)(block: Block): Lowered
  def compile (role: Role)(code: Endpoints.Code)(fresh: Nat): Lowered decreases structural(code) := {
    match code returning Lowered with
    | Endpoints.Code.skip => Lowered.mk(fresh, Block.done)
    | Endpoints.Code.atom action => Lowered.mk(Nat.succ(fresh), Ring.atom(role, action, fresh))
    | Endpoints.Code.seq a b => {
      let left := Ring.compile(role, a, fresh)
      let right := Ring.compile(role, b, left.next)
      Lowered.mk(right.next, Ring.sequence(left.block, right.block))
    }
    | Endpoints.Code.branch a b => {
      let yes := Ring.compile(role, a, fresh)
      let no := Ring.compile(role, b, yes.next)
      Lowered.mk(no.next, Ring.one(Stmt.ifElse(Ring.flag(role), yes.block, no.block)))
    }
    | Endpoints.Code.loop body => {
      let lowered := Ring.compile(role, body, Nat.succ(fresh))
      Lowered.mk(lowered.next, Ring.one(Stmt.forLoop(fresh, Expr.lit(0), Ring.count(role), lowered.block)))
    }
  }
  def setup: Block := Block.seq(Ring.atThread(0,
    Block.seq(Stmt.instr(Instr.mbarInit(Ring.fullBar, Expr.lit(1))),
    Block.seq(Stmt.instr(Instr.mbarInit(Ring.emptyBar, Expr.lit(1))),
    Block.seq(Stmt.instr(Instr.mbarArrive(Window.cta, Ring.emptyBar, Arrival.one)),
    Block.seq(Stmt.instr(Instr.fenceMbarInit), Block.done))))), Block.seq(Stmt.sync, Block.done))
  def close: Block := Block.seq(Stmt.sync, Block.seq(Ring.atThread(0,
    Block.seq(Stmt.instr(Instr.mbarInval(Ring.fullBar)), Block.seq(Stmt.instr(Instr.mbarInval(Ring.emptyBar)), Block.done))), Block.done))
  def body (p: Program): Block := {
    let producer := Ring.compile(Role.producer, Endpoints.syntax(p.producer), 2)
    let consumer := Ring.compile(Role.consumer, Endpoints.syntax(p.consumer), producer.next)
    Block.seq(Stmt.declMut(DType.u32, 0, Expr.lit(0)),
    Block.seq(Stmt.declMut(DType.u32, 1, Expr.lit(0)),
    Ring.sequence(Ring.setup, Block.seq(Ring.atThread(0, producer.block),
    Block.seq(Ring.atThread(32, consumer.block), Ring.close)))))
  }
  def params: List(Param) := List.cons(Param.tensorMap(MapUse.load, "I_map"),
    List.cons(Param.scalar(DType.u32, "PK"), List.cons(Param.scalar(DType.u32, "CK"),
    List.cons(Param.scalar(DType.bool, "Pflag"), List.cons(Param.scalar(DType.bool, "Cflag"), List.nil(Param))))))
  def launcher: Launcher := Launcher.mk(
    List.cons(Param.input(DType.bf16, "I"), List.cons(Param.scalar(DType.u32, "M"), List.cons(Param.scalar(DType.u32, "N"),
    List.cons(Param.scalar(DType.u32, "PK"), List.cons(Param.scalar(DType.u32, "CK"),
    List.cons(Param.scalar(DType.bool, "Pflag"), List.cons(Param.scalar(DType.bool, "Cflag"), List.nil(Param)))))))),
    List.nil(Expr), List.cons(MapEncoding.mk("I_map", MapUse.load, Param.input(DType.bf16, "I"), "M", "N", 64, 64), List.nil(MapEncoding)),
    Grid.blocks(Expr.lit(1), Expr.lit(1)), 64)
  def kernel (p: Program): Kernel := Kernel.mk("primitive_copy_ring", Ring.params, Ring.sharedBytes, Ring.body(p), Option.some(Ring.launcher))
  def render (p: Program)[ok: Check.WellFormed(Ring.kernel(p))]: String := Cuda.boundedKernel(Option.some((64, 1)), Ring.kernel(p))
}
