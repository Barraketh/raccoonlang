import Protocol

namespace Frame {
  inductive Step (S: Type)(E: Type)(F: Type)(step: S -> E -> S -> Prop) indices (before: Pair(S, F))(event: E)(after: Pair(S, F)) : Prop
   | lift (s: S)(event: E)(t: S)(frame: F)(edge: step(s, event, t))
       : Step(S, E, F, step, (s, frame), event, (t, frame))

  def relation (S: Type)(E: Type)(F: Type)(step: S -> E -> S -> Prop)
      : Pair(S, F) -> E -> Pair(S, F) -> Prop :=
    fun (s: Pair(S, F))(event: E)(t: Pair(S, F)): Prop => Step(S, E, F, step, s, event, t)

  def getFrame {S: Type}{F: Type}(state: Pair(S, F)): F := {
    match state returning F with
    | Pair.mk s frame => frame
  }

  def unchanged {S: Type}{E: Type}{F: Type}{step: S -> E -> S -> Prop}
      {s: Pair(S, F)}{event: E}{t: Pair(S, F)}(edge: Step(S, E, F, step, s, event, t))
      : Eq(F, Frame.getFrame(s), Frame.getFrame(t)) := {
    match edge returning Eq(F, Frame.getFrame(s), Frame.getFrame(t)) with
    | Step.lift before event after frame original => Eq.refl(frame)
  }

  def lift {S: Type}{E: Type}{a: S}{b: S}(F: Type)(step: S -> E -> S -> Prop)
      (events: List(E))(run: Protocol.Run(S, E, step, a, events, b))(frame: F)
      : Protocol.Run(Pair(S, F), E, Frame.relation(S, E, F, step), (a, frame), events, (b, frame)) decreases structural(events) := {
    match events returning Protocol.Run(Pair(S, F), E, Frame.relation(S, E, F, step), (a, frame), events, (b, frame)) with
    | List.nil => {
      match run returning Protocol.Run(Pair(S, F), E, Frame.relation(S, E, F, step), (a, frame), events, (b, frame)) with
      | Protocol.Run.done s => Protocol.Run.done(Frame.relation(S, E, F, step), (s, frame))
    }
    | List.cons event rest => {
      match run returning Protocol.Run(Pair(S, F), E, Frame.relation(S, E, F, step), (a, frame), events, (b, frame)) with
      | Protocol.Run.more s event mid end tailEvents edge tail => Protocol.Run.more((s, frame), event, (mid, frame), Step.lift(step, s, event, mid, frame, edge), Frame.lift(F, step, rest, tail, frame))
    }
  }
}
