import Protocol

namespace ActorProtocol {
  // These phases retain the peer's obligation through the leader-only branch.
  inductive State : Type
   | bothPending : State
   | leaderPendingInside : State
   | leaderDoneInside : State
   | peerPendingOutside : State
   | done : State

  inductive Event : Type
   | enterLeader : Event
   | finishLeader : Event
   | leaveLeader : Event
   | finishPeer : Event
   | finishBoth : Event

  inductive Step indices (before: State)(event: Event)(after: State) : Prop
   | enterLeader : Step(State.bothPending, Event.enterLeader, State.leaderPendingInside)
   | finishLeader : Step(State.leaderPendingInside, Event.finishLeader, State.leaderDoneInside)
   | leaveLeader : Step(State.leaderDoneInside, Event.leaveLeader, State.peerPendingOutside)
   | finishPeer : Step(State.peerPendingOutside, Event.finishPeer, State.done)
   | finishBoth : Step(State.bothPending, Event.finishBoth, State.done)

  def relation: State -> Event -> State -> Prop :=
    fun (s: State)(event: Event)(t: State): Prop => Step(s, event, t)
  def Choice (s: State)(event: Event): Type := Option(Protocol.CheckedStep(State, Event, ActorProtocol.relation, s, event))
  def reject (s: State)(event: Event): Choice(s, event) :=
    Option.none(Protocol.CheckedStep(State, Event, ActorProtocol.relation, s, event))

  def choose (s: State)(event: Event): Choice(s, event) := {
    match s returning Choice(s, event) with
    | State.bothPending => {
      match event returning Choice(s, event) with
      | Event.enterLeader => Option.some(Protocol.CheckedStep.mk(ActorProtocol.relation, s, event, State.leaderPendingInside, Step.enterLeader))
      | Event.finishBoth => Option.some(Protocol.CheckedStep.mk(ActorProtocol.relation, s, event, State.done, Step.finishBoth))
      | _ => ActorProtocol.reject(s, event)
    }
    | State.leaderPendingInside => {
      match event returning Choice(s, event) with
      | Event.finishLeader => Option.some(Protocol.CheckedStep.mk(ActorProtocol.relation, s, event, State.leaderDoneInside, Step.finishLeader))
      | _ => ActorProtocol.reject(s, event)
    }
    | State.leaderDoneInside => {
      match event returning Choice(s, event) with
      | Event.leaveLeader => Option.some(Protocol.CheckedStep.mk(ActorProtocol.relation, s, event, State.peerPendingOutside, Step.leaveLeader))
      | _ => ActorProtocol.reject(s, event)
    }
    | State.peerPendingOutside => {
      match event returning Choice(s, event) with
      | Event.finishPeer => Option.some(Protocol.CheckedStep.mk(ActorProtocol.relation, s, event, State.done, Step.finishPeer))
      | _ => ActorProtocol.reject(s, event)
    }
    | State.done => ActorProtocol.reject(s, event)
  }

  def inside (s: State): Bool := {
    match s returning Bool with
    | State.leaderPendingInside => Bool.true
    | State.leaderDoneInside => Bool.true
    | _ => Bool.false
  }

  def peerPending (s: State): Bool := {
    match s returning Bool with
    | State.done => Bool.false
    | _ => Bool.true
  }

  // An actor-specific frame theorem: executing inside the leader branch cannot
  // discharge the peer's obligation.
  def framed (s: State)(t: State): Prop := {
    match ActorProtocol.inside(s) returning Prop with
    | Bool.true => Eq(Bool, ActorProtocol.peerPending(t), Bool.true)
    | Bool.false => True
  }

  def peerFrame {s: State}{event: Event}{t: State}(edge: Step(s, event, t))
      : ActorProtocol.framed(s, t) := {
    match edge returning ActorProtocol.framed(s, t) with
    | Step.enterLeader => True.intro
    | Step.finishLeader => Eq.refl(Bool.true)
    | Step.leaveLeader => Eq.refl(Bool.true)
    | Step.finishPeer => True.intro
    | Step.finishBoth => True.intro
  }
}
