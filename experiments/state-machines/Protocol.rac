// A computation is an immutable description with checked transition evidence.
// Copying this description does not copy the authority required to execute it.
namespace Protocol {
  inductive Run (S: Type)(E: Type)(step: S -> E -> S -> Prop) indices (before: S)(events: List(E))(after: S) : Prop
   | done (s: S) : Run(S, E, step, s, List.nil(E), s)
   | more (s: S)(event: E)(mid: S){after: S}{rest: List(E)}
       (edge: step(s, event, mid))(tail: Run(S, E, step, mid, rest, after))
       : Run(S, E, step, s, List.cons(event, rest), after)

  struct Command (S: Type)(E: Type)(step: S -> E -> S -> Prop)(before: S)(after: S) : Type
   | mk (events: List(E))(valid: Run(S, E, step, before, events, after)) : Command(S, E, step, before, after)

  struct CheckedStep (S: Type)(E: Type)(step: S -> E -> S -> Prop)(before: S)(event: E) : Type
   | mk (after: S)(valid: step(before, event, after)) : CheckedStep(S, E, step, before, event)

  struct Inferred (S: Type)(E: Type)(step: S -> E -> S -> Prop)(before: S)(events: List(E)) : Type
   | mk (after: S)(valid: Run(S, E, step, before, events, after)) : Inferred(S, E, step, before, events)

  // A reference algorithm for a native transition judgement. Every selected
  // edge carries evidence checked against the authoritative Step relation.
  def infer {S: Type}{E: Type}(step: S -> E -> S -> Prop)
      (choose: (s: S) -> (event: E) -> Option(CheckedStep(S, E, step, s, event)))
      (before: S)(events: List(E)): Option(Inferred(S, E, step, before, events)) decreases structural(events) := {
    match events returning Option(Inferred(S, E, step, before, events)) with
    | List.nil => Option.some(Inferred.mk(before, Run.done(step, before)))
    | List.cons event rest => {
      match choose(before, event) returning Option(Inferred(S, E, step, before, events)) with
      | Option.none => Option.none(Inferred(S, E, step, before, events))
      | Option.some edge => {
        match Protocol.infer(step, choose, edge.after, rest) returning Option(Inferred(S, E, step, before, events)) with
        | Option.none => Option.none(Inferred(S, E, step, before, events))
        | Option.some tail => Option.some(Inferred.mk(tail.after, Run.more(before, event, edge.after, edge.valid, tail.valid)))
      }
    }
  }

  def endpoint {S: Type}{E: Type}{step: S -> E -> S -> Prop}{before: S}{events: List(E)}
      (result: Option(Inferred(S, E, step, before, events))): Option(S) := {
    match result returning Option(S) with
    | Option.none => Option.none(S)
    | Option.some inferred => Option.some(inferred.after)
  }

  def require {S: Type}{E: Type}{step: S -> E -> S -> Prop}{before: S}{events: List(E)}
      (result: Option(Inferred(S, E, step, before, events)))(goal: S)
      (accepted: Eq(Option(S), Protocol.endpoint(result), Option.some(goal))): Command(S, E, step, before, goal) := {
    match result returning Command(S, E, step, before, goal) with
    | Option.none => {
      match accepted returning Command(S, E, step, before, goal) with
    }
    | Option.some inferred => {
      match inferred returning Command(S, E, step, before, goal) with
      | Inferred.mk after valid => {
        match accepted returning Command(S, E, step, before, goal) with
        | Eq.refl same => Command.mk(events, valid)
      }
    }
  }

  def append {S: Type}{E: Type}{step: S -> E -> S -> Prop}{a: S}{b: S}{c: S}{ys: List(E)}
      (xs: List(E))(first: Run(S, E, step, a, xs, b))(second: Run(S, E, step, b, ys, c))
      : Run(S, E, step, a, List.append(xs, ys), c) decreases structural(xs) := {
    match xs returning Run(S, E, step, a, List.append(xs, ys), c) with
    | List.nil => {
      match first returning Run(S, E, step, a, List.append(xs, ys), c) with
      | Run.done s => second
    }
    | List.cons event rest => {
      match first returning Run(S, E, step, a, List.append(xs, ys), c) with
      | Run.more s event mid end tailEvents edge tail => Run.more(s, event, mid, edge, Protocol.append(rest, tail, second))
    }
  }

  def preserves {S: Type}{E: Type}{step: S -> E -> S -> Prop}{a: S}{b: S}
      (invariant: S -> Prop)
      (one: (s: S) -> (event: E) -> (t: S) -> step(s, event, t) -> invariant(s) -> invariant(t))
      (events: List(E))(run: Run(S, E, step, a, events, b))(initial: invariant(a))
      : invariant(b) decreases structural(events) := {
    match events returning invariant(b) with
    | List.nil => {
      match run returning invariant(b) with
      | Run.done s => initial
    }
    | List.cons event rest => {
      match run returning invariant(b) with
      | Run.more s event mid end tailEvents edge tail => Protocol.preserves(invariant, one, rest, tail, one(s, event, mid, edge, initial))
    }
  }
}
