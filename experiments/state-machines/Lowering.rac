import Examples
import encoding.Core
import Cuda

namespace Lowering {
  open Cuda

  def groupGuard (group: Nat): Expr :=
    Expr.bin(BinOp.eq, Expr.bin(BinOp.div, Expr.special(Builtin.warp), Expr.lit(4)), Expr.lit(group))

  // Concrete specification for A3b's restoration (192,192,72,56) -> 128.
  // It states the instructions independently of Core.setMaxRegs.
  def specifiedGroup (group: Nat)(change: RegChange): Stmt :=
    Stmt.ifElse(Lowering.groupGuard(group), Block.seq(Stmt.instr(Instr.setMaxNReg(change, 128)), Block.done), Block.done)

  def expected: Block := Block.seq(Lowering.specifiedGroup(0, RegChange.dec),
    Block.seq(Lowering.specifiedGroup(1, RegChange.dec), Block.seq(Lowering.specifiedGroup(2, RegChange.inc),
      Block.seq(Lowering.specifiedGroup(3, RegChange.inc), Block.seq(Stmt.sync, Block.done)))))

  def emittedGroup (group: Nat)(count: Nat): Stmt :=
    Stmt.ifElse(Lowering.groupGuard(group), Core.toBlock(Core.setMaxRegs(count, RegisterProtocol.budget(Examples.cfg)), Block.done), Block.done)

  def withoutBarrier: List(Stmt) := List.cons(Lowering.emittedGroup(0, 192),
    List.cons(Lowering.emittedGroup(1, 192), List.cons(Lowering.emittedGroup(2, 72),
      List.cons(Lowering.emittedGroup(3, 56), List.nil(Stmt)))))

  def emitted: List(Stmt) := List.append(Lowering.withoutBarrier, List.cons(Stmt.sync, List.nil(Stmt)))

  // The public code list is in execution order; Core.toBlock consumes the
  // generation buffer in the opposite order.
  def blockOf (code: List(Stmt)): Block := Core.toBlock(List.reverse(code), Block.done)

  // Two independent obligations: a valid abstract history and correspondence
  // to its concrete emission contract. History alone cannot certify emission.
  struct Restoration: Type
   | mk (command: Protocol.Command(RegisterProtocol.State, RegisterProtocol.Event, Examples.regRelation,
          RegisterProtocol.State.split(Examples.counts), RegisterProtocol.State.uniform))
        (history: Eq(List(RegisterProtocol.Event), command.events, Examples.backEvents))
        (code: List(Stmt))(correspondence: Eq(Block, Lowering.blockOf(code), Lowering.expected)): Restoration

  def correct: Restoration := Restoration.mk(Examples.back, Eq.refl(Examples.backEvents), Lowering.emitted, Eq.refl(Lowering.expected))
}
