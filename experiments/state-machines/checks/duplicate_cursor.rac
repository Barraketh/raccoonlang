// expect: LinearReused
import Examples
import Authority
import RegisterProtocol
namespace Rejected {
  def twice: Unit := Authority.withKernel(Examples.cfg, Unit,
    fun (l: Lifetime)(cursor: Authority.Cursor(l, Examples.cfg, RegisterProtocol.State.fresh)): Unit => {
      let first := Authority.execute(cursor, Examples.initialize)
      let second := Authority.execute(cursor, Examples.initialize)
      let u := Authority.finish(first)
      Authority.finish(second)
    })
}
