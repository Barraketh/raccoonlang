// expect: TypeMismatch
import Lowering
import Examples
import Cuda
namespace Rejected {
  def badCode: List(Cuda.Stmt) := List.cons(Lowering.specifiedGroup(0, Cuda.RegChange.inc),
    List.cons(Lowering.specifiedGroup(1, Cuda.RegChange.dec), List.cons(Lowering.specifiedGroup(2, Cuda.RegChange.inc),
      List.cons(Lowering.specifiedGroup(3, Cuda.RegChange.inc), List.cons(Cuda.Stmt.sync, List.nil(Cuda.Stmt))))))
  def bad: Lowering.Restoration := Lowering.Restoration.mk(Examples.back, Eq.refl(Examples.backEvents),
    Rejected.badCode, Eq.refl(Lowering.expected))
}
