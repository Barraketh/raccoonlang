// expect: MissingCase
// The current exclusion checker conservatively retains Step.split here.
// RegisterProtocol.incomingLaw proves the same backlink with a total predicate.
import RegisterProtocol
namespace Rejected {
  def backlink {cfg: RegisterProtocol.Config}{s: RegisterProtocol.State}{event: RegisterProtocol.Event}
      (edge: RegisterProtocol.Step(cfg, s, event, RegisterProtocol.State.uniform)): RegisterProtocol.UniformPredecessor(s) := {
    match edge returning RegisterProtocol.UniformPredecessor(s) with
    | RegisterProtocol.Step.initialize kernel budget ok => RegisterProtocol.UniformPredecessor.initial
    | RegisterProtocol.Step.barrier cs => RegisterProtocol.UniformPredecessor.restoring(cs)
  }
}
