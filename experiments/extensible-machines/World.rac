import Contracts
import proofs.Lib

namespace World {
  def Cells (S: Type): Type := (id: Nat) -> S
  def always (S: Type): S -> Prop := fun (s: S): Prop => True
  def select {S: Type}(flag: Bool)(new: S)(old: S): S := {
    match flag returning S with
    | Bool.true => new
    | Bool.false => old
  }
  def updated {S: Type}(cells: Nat -> S)(id: Nat)(value: S): Nat -> S :=
    fun (peer: Nat): S => World.select(Nat.beq(peer, id), value, cells(peer))
  def different (a: Nat)(b: Nat)(distinct: Not(Eq(Nat, a, b))): Eq(Bool, Nat.beq(a, b), Bool.false) := {
    match tested : Nat.beq(a, b) returning Eq(Bool, Nat.beq(a, b), Bool.false) with
    | Bool.false => tested
    | Bool.true => False.elimP(distinct(Lib.beqSound(a, b, tested)), Eq(Bool, Nat.beq(a, b), Bool.false))
  }
  def selectFalse {S: Type}(flag: Bool)(new: S)(old: S)(false: Eq(Bool, flag, Bool.false)): Eq(S, World.select(flag, new, old), old) := {
    match false returning Eq(S, World.select(flag, new, old), old) with
    | Eq.refl same => Eq.refl(old)
  }
  def frame {S: Type}(cells: Nat -> S)(id: Nat)(value: S)(peer: Nat)(distinct: Not(Eq(Nat, peer, id)))
      : Eq(S, World.updated(cells, id, value)(peer), cells(peer)) :=
    World.selectFalse(Nat.beq(peer, id), value, cells(peer), World.different(peer, id, distinct))

  def apply {S: Type}(cells: Nat -> S)(id: Nat)(result: Contracts.Outcome(S)): Contracts.Outcome(World.Cells(S)) := {
    match result returning Contracts.Outcome(World.Cells(S)) with
    | Contracts.Outcome.fault => Contracts.Outcome.fault(World.Cells(S))
    | Contracts.Outcome.ok value => Contracts.Outcome.ok(World.updated(cells, id, value))
  }
  def unchanged {S: Type}(cells: Nat -> S)(peer: Nat): (Nat -> S) -> Prop :=
    fun (after: Nat -> S): Prop => Eq(S, after(peer), cells(peer))
  def frameOutcome {S: Type}(cells: Nat -> S)(id: Nat)(result: Contracts.Outcome(S))(peer: Nat)(distinct: Not(Eq(Nat, peer, id)))
      (safe: Contracts.Post(World.always(S), result)): Contracts.Post(World.unchanged(cells, peer), World.apply(cells, id, result)) := {
    match result returning Contracts.Post(World.unchanged(cells, peer), World.apply(cells, id, result)) with
    | Contracts.Outcome.fault => False.elimP(safe, Contracts.Post(World.unchanged(cells, peer), World.apply(cells, id, result)))
    | Contracts.Outcome.ok value => World.frame(cells, id, value, peer, distinct)
  }
  def forgetPost {S: Type}(Q: S -> Prop)(result: Contracts.Outcome(S))(safe: Contracts.Post(Q, result))
      : Contracts.Post(World.always(S), result) := {
    match result returning Contracts.Post(World.always(S), result) with
    | Contracts.Outcome.fault => safe
    | Contracts.Outcome.ok value => True.intro
  }
  def frameRun {S: Type}(run: Contracts.Runtime -> S -> Contracts.Outcome(S))(P: S -> Prop)(Q: S -> Prop)
      (safe: Contracts.Safe(run, P, Q))(r: Contracts.Runtime)(cells: Nat -> S)(id: Nat)(peer: Nat)
      (distinct: Not(Eq(Nat, peer, id)))(initial: P(cells(id)))
      : Contracts.Post(World.unchanged(cells, peer), World.apply(cells, id, run(r, cells(id)))) :=
    World.frameOutcome(cells, id, run(r, cells(id)), peer, distinct, World.forgetPost(Q, run(r, cells(id)), safe(r, cells(id), initial)))
}
