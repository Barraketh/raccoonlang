import Bridge
import World
import RegisterMachine

namespace Demo {
  def initial: Pair(Pipeline.State, Pipeline.State) :=
    Pair.mk(Pipeline.State.mk(Pipeline.empty, 0, 0, 0), Pipeline.State.mk(Pipeline.empty, 0, 0, 0))
  def initialProof: Client.invariant(0, Demo.initial) :=
    And.intro(And.intro(Eq.refl(Pipeline.empty), Eq.refl(0)), And.intro(Eq.refl(Pipeline.empty), Eq.refl(0)))
  def everyCount (r: Contracts.Runtime): Contracts.Post(Progress.stage(Client.invariant, r.count), Contracts.repeat(Client.run(Bridge.plan), r, Demo.initial)) :=
    Eq.substP(Progress.addZeroLeft(r.count),
      fun (g: Nat): Prop => Contracts.Post(Progress.stage(Client.invariant, g), Contracts.repeat(Client.run(Bridge.plan), r, Demo.initial)),
      Progress.repeat(Client.run(Bridge.plan), Client.invariant, Client.advanced(Bridge.plan), r, 0, Demo.initial, Demo.initialProof))
  def three: Eq(Contracts.Outcome(Pair(Pipeline.State, Pipeline.State)), Contracts.repeat(Client.run(Bridge.plan), Contracts.Runtime.mk(3, Bool.false, 0), Demo.initial),
      Contracts.Outcome.ok(Pair.mk(Pipeline.State.mk(Pipeline.empty, 3, 12, 3), Pipeline.State.mk(Pipeline.empty, 3, 12, 3)))) :=
    Eq.refl(Contracts.Outcome.ok(Pair.mk(Pipeline.State.mk(Pipeline.empty, 3, 12, 3), Pipeline.State.mk(Pipeline.empty, 3, 12, 3))))
  def genericAllocationFrame (n: Nat)(cells: World.Cells(Pipeline.State))(new: Pipeline.State)
      : Eq(Pipeline.State, World.updated(cells, n, new)(Nat.succ(n)), cells(Nat.succ(n))) :=
    World.frame(cells, n, new, Nat.succ(n), fun (same: Eq(Nat, Nat.succ(n), n)): False => Allocation.successorDisjoint(n)(Eq.symm(same)))
  def cycleFramesPeer (id: Nat)(peer: Nat)(g: Nat)(r: Contracts.Runtime)(cells: World.Cells(Pipeline.State))
      (distinct: Not(Eq(Nat, peer, id)))(initial: Pipeline.invariant(g, cells(id)))
      : Contracts.Post(World.unchanged(cells, peer), World.apply(cells, id, Pipeline.cycle(id).run(r, cells(id)))) :=
    World.frameRun(Pipeline.cycle(id).run, Progress.stage(Pipeline.invariant, g), Progress.stage(Pipeline.invariant, Nat.succ(g)),
      Pipeline.advances(id)(g), r, cells, id, peer, distinct, initial)
  def registers: Machine.Cmd(RegisterMachine.State, RegisterMachine.Op, RegisterMachine.spec(WholeModel.Counts.mk(192, 192, 72, 56)),
      RegisterMachine.at(RegisterMachine.State.uniform), RegisterMachine.at(RegisterMachine.State.uniform)) :=
    Machine.loop(RegisterMachine.cycle(WholeModel.Counts.mk(192, 192, 72, 56), Eq.refl(Bool.true)))
  def registerLowering: Machine.Lowered(RegisterMachine.State, RegisterMachine.Op, RegisterMachine.spec(WholeModel.Counts.mk(192, 192, 72, 56)), Demo.registers.code, Option.none(Nat), 0) :=
    Machine.lower(RegisterMachine.spec(WholeModel.Counts.mk(192, 192, 72, 56)), Demo.registers.code, Option.none(Nat), 0)
}
