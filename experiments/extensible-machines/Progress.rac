import Contracts

namespace Progress {
  def stage {S: Type}(I: Nat -> S -> Prop)(generation: Nat): S -> Prop := fun (s: S): Prop => I(generation, s)
  def Advances {S: Type}(run: Contracts.Runtime -> S -> Contracts.Outcome(S))(I: Nat -> S -> Prop): Prop :=
    (g: Nat) -> Contracts.Safe(run, Progress.stage(I, g), Progress.stage(I, Nat.succ(g)))

  def addSuccLeft (g: Nat)(n: Nat): Eq(Nat, Nat.add(Nat.succ(g), n), Nat.succ(Nat.add(g, n))) decreases structural(n) := {
    match n returning Eq(Nat, Nat.add(Nat.succ(g), n), Nat.succ(Nat.add(g, n))) with
    | Nat.zero => Eq.refl(Nat.succ(g))
    | Nat.succ rest => Progress.addSuccLeft(Nat.succ(g), rest)
  }
  def addZeroLeft (n: Nat): Eq(Nat, Nat.add(0, n), n) decreases structural(n) := {
    match n returning Eq(Nat, Nat.add(0, n), n) with
    | Nat.zero => Eq.refl(0)
    | Nat.succ rest => Eq.trans(Progress.addSuccLeft(0, rest), congrArg(Progress.addZeroLeft(rest), Nat, Nat.succ))
  }

  // The body is a single structured program, certified for every generation.
  // No representative generation is run to obtain its code.
  def iterate {S: Type}(run: Contracts.Runtime -> S -> Contracts.Outcome(S))(I: Nat -> S -> Prop)(advanced: Progress.Advances(run, I))
      (r: Contracts.Runtime)(count: Nat)(index: Nat)(g: Nat)(s: S)(initial: I(g, s))
      : Contracts.Post(Progress.stage(I, Nat.add(g, count)), Contracts.iterate(run, r, count, index, s)) decreases structural(count) := {
    match count returning Contracts.Post(Progress.stage(I, Nat.add(g, count)), Contracts.iterate(run, r, count, index, s)) with
    | Nat.zero => initial
    | Nat.succ rest => Contracts.continueSafe(run(Contracts.Runtime.mk(r.count, r.flag, index), s),
        Progress.stage(I, Nat.succ(g)), Progress.stage(I, Nat.add(g, Nat.succ(rest))),
        fun (mid: S): Contracts.Outcome(S) => Contracts.iterate(run, r, rest, Nat.succ(index), mid),
        fun (mid: S)(h: I(Nat.succ(g), mid)): Contracts.Post(Progress.stage(I, Nat.add(g, Nat.succ(rest))), Contracts.iterate(run, r, rest, Nat.succ(index), mid)) =>
          Progress.iterate(run, I, advanced, r, rest, Nat.succ(index), Nat.succ(g), mid, h),
        advanced(g)(Contracts.Runtime.mk(r.count, r.flag, index), s, initial))
    }

  def repeat {S: Type}(run: Contracts.Runtime -> S -> Contracts.Outcome(S))(I: Nat -> S -> Prop)(advanced: Progress.Advances(run, I))
      (r: Contracts.Runtime)(g: Nat)(s: S)(initial: I(g, s)): Contracts.Post(Progress.stage(I, Nat.add(g, r.count)), Contracts.repeat(run, r, s)) :=
    Progress.iterate(run, I, advanced, r, r.count, 0, g, s, initial)
}
