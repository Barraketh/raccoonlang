import Allocation
import Pipeline

namespace Source {
  sealed struct Reader (root: Lifetime)(allocation: Lifetime)(loan: Lifetime)(id: Nat)(g: Nat): Type { scope = Lifetime.union(Lifetime.union(root, allocation), loan) }
   | mk: Reader(root, allocation, loan, id, g)
  sealed struct Borrowed (root: Lifetime)(allocation: Lifetime)(loan: Lifetime)(id: Nat)(g: Nat): Type { scope = Lifetime.union(Lifetime.union(root, allocation), loan) }
   | mk (command: Machine.Cmd(Pipeline.State, Pipeline.Op, Pipeline.spec(id), Pipeline.atGeneration(Pipeline.before(Pipeline.Op.read0), g), Pipeline.atGeneration(Pipeline.before(Pipeline.Op.read0), g))): Borrowed(root, allocation, loan, id, g)

  def read0 {root: Lifetime}{a: Lifetime}{loan: Lifetime}{id: Nat}{g: Nat}{width: Nat}
      (buffer: Allocation.Ref(root, a, id, width))(reader: Reader(root, a, loan, id, g)): Borrowed(root, a, loan, id, g) :=
    Borrowed.mk(root, a, loan, id, g, Pipeline.precise(id, Pipeline.Op.read0, g))
  def read1 {root: Lifetime}{a: Lifetime}{loan: Lifetime}{id: Nat}{g: Nat}{width: Nat}
      (buffer: Allocation.Ref(root, a, id, width))(reader: Reader(root, a, loan, id, g)): Borrowed(root, a, loan, id, g) :=
    Borrowed.mk(root, a, loan, id, g, Pipeline.precise(id, Pipeline.Op.read1, g))
  def sequence {root: Lifetime}{a: Lifetime}{loan: Lifetime}{id: Nat}{g: Nat}
      (first: Borrowed(root, a, loan, id, g))(second: Borrowed(root, a, loan, id, g)): Borrowed(root, a, loan, id, g) :=
    Borrowed.mk(root, a, loan, id, g, Machine.sequence(first.command, second.command))
  def reads {root: Lifetime}{a: Lifetime}{id: Nat}{width: Nat}{Sf: Lifetime}(buffer: Allocation.Ref(root, a, id, width))(g: Nat)
      (body: { scope = Sf } (loan: Lifetime) -> Reader(root, a, loan, id, g) -> Borrowed(root, a, loan, id, g))
      : Machine.Cmd(Pipeline.State, Pipeline.Op, Pipeline.spec(id), Pipeline.atGeneration(Pipeline.before(Pipeline.Op.open0), g), Pipeline.atGeneration(Pipeline.after(Pipeline.Op.close1), g)) := scope loan => {
    let command := body(loan, Reader.mk(root, a, loan, id, g))
    Machine.sequence(Pipeline.precise(id, Pipeline.Op.open0, g), Machine.sequence(Pipeline.precise(id, Pipeline.Op.open1, g),
      Machine.sequence(command.command, Machine.sequence(Pipeline.precise(id, Pipeline.Op.close0, g), Pipeline.precise(id, Pipeline.Op.close1, g)))))
  }
  def cycleAt {root: Lifetime}{a: Lifetime}{id: Nat}{width: Nat}(buffer: Allocation.Ref(root, a, id, width))(g: Nat)
      : Machine.Cmd(Pipeline.State, Pipeline.Op, Pipeline.spec(id), Pipeline.atGeneration(Pipeline.empty, g), Pipeline.atGeneration(Pipeline.empty, Nat.succ(g))) := {
    let readers := Source.reads(buffer, g, fun (loan: Lifetime)(reader: Reader(root, a, loan, id, g)): Borrowed(root, a, loan, id, g) =>
      Source.sequence(Source.read0(buffer, reader), Source.read1(buffer, reader)))
    Machine.sequence(Pipeline.precise(id, Pipeline.Op.store, g), Machine.sequence(Pipeline.precise(id, Pipeline.Op.publish, g),
      Machine.sequence(readers, Pipeline.precise(id, Pipeline.Op.recycle, g))))
  }
  def cycleSyntax {root: Lifetime}{a: Lifetime}{id: Nat}{width: Nat}(buffer: Allocation.Ref(root, a, id, width))(g: Nat)
      : Eq(Machine.Code(Pipeline.Op), Source.cycleAt(buffer, g).code, Pipeline.cycle(id).code) := Eq.refl(Pipeline.cycle(id).code)

  // User callbacks can return their own command with proofs; this certifier
  // introduces no new transition or target assumption.
  sealed struct Body (root: Lifetime)(allocation: Lifetime)(id: Nat): Type { scope = Lifetime.union(root, allocation) }
   | mk (command: Machine.Cmd(Pipeline.State, Pipeline.Op, Pipeline.spec(id), Pipeline.at(Pipeline.empty), Pipeline.at(Pipeline.empty)))
        (advanced: Progress.Advances(command.run, Pipeline.invariant)): Body(root, allocation, id)
  def certify {root: Lifetime}{a: Lifetime}{id: Nat}{width: Nat}(buffer: Allocation.Ref(root, a, id, width))
      (command: Machine.Cmd(Pipeline.State, Pipeline.Op, Pipeline.spec(id), Pipeline.at(Pipeline.empty), Pipeline.at(Pipeline.empty)))
      (advanced: Progress.Advances(command.run, Pipeline.invariant)): Body(root, a, id) := Body.mk(root, a, id, command, advanced)
  def standard {root: Lifetime}{a: Lifetime}{id: Nat}{width: Nat}(buffer: Allocation.Ref(root, a, id, width)): Body(root, a, id) :=
    Source.certify(buffer, Pipeline.cycle(id), Pipeline.advances(id))
  def command {root: Lifetime}{a: Lifetime}{id: Nat}(body: Body(root, a, id))
      : Machine.Cmd(Pipeline.State, Pipeline.Op, Pipeline.spec(id), Pipeline.at(Pipeline.empty), Pipeline.at(Pipeline.empty)) := body.command
  def advanced {root: Lifetime}{a: Lifetime}{id: Nat}(body: Body(root, a, id)): Progress.Advances(Source.command(body).run, Pipeline.invariant) := body.advanced
}
