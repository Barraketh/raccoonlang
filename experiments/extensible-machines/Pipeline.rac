import Machine
import Progress

namespace Pipeline {
  inductive Phase: Type
   | empty: Phase
   | written: Phase
   | ready: Phase
   | reading: Phase
  struct Mode: Type
   | mk (phase: Phase)(reader0: Bool)(reader1: Bool): Mode
  struct State: Type
   | mk (mode: Mode)(generation: Nat)(payload: Nat)(value: Nat): State
  inductive Op: Type
   | store: Op
   | publish: Op
   | open0: Op
   | open1: Op
   | read0: Op
   | read1: Op
   | close0: Op
   | close1: Op
   | recycle: Op

  def empty: Mode := Mode.mk(Phase.empty, Bool.false, Bool.false)
  def before (op: Op): Mode := {
    match op returning Mode with
    | Op.store => Pipeline.empty
    | Op.publish => Mode.mk(Phase.written, Bool.false, Bool.false)
    | Op.open0 => Mode.mk(Phase.ready, Bool.false, Bool.false)
    | Op.open1 => Mode.mk(Phase.reading, Bool.true, Bool.false)
    | Op.read0 => Mode.mk(Phase.reading, Bool.true, Bool.true)
    | Op.read1 => Mode.mk(Phase.reading, Bool.true, Bool.true)
    | Op.close0 => Mode.mk(Phase.reading, Bool.true, Bool.true)
    | Op.close1 => Mode.mk(Phase.reading, Bool.false, Bool.true)
    | Op.recycle => Mode.mk(Phase.reading, Bool.false, Bool.false)
  }
  def after (op: Op): Mode := {
    match op returning Mode with
    | Op.store => Pipeline.before(Op.publish)
    | Op.publish => Pipeline.before(Op.open0)
    | Op.open0 => Pipeline.before(Op.open1)
    | Op.open1 => Pipeline.before(Op.read0)
    | Op.read0 => Pipeline.before(Op.read0)
    | Op.read1 => Pipeline.before(Op.read0)
    | Op.close0 => Pipeline.before(Op.close1)
    | Op.close1 => Pipeline.before(Op.recycle)
    | Op.recycle => Pipeline.empty
  }
  def phaseEq (a: Phase)(b: Phase): Bool := {
    match a returning Bool with
    | Phase.empty => {
      match b returning Bool with
      | Phase.empty => Bool.true
      | _ => Bool.false
    }
    | Phase.written => {
      match b returning Bool with
      | Phase.written => Bool.true
      | _ => Bool.false
    }
    | Phase.ready => {
      match b returning Bool with
      | Phase.ready => Bool.true
      | _ => Bool.false
    }
    | Phase.reading => {
      match b returning Bool with
      | Phase.reading => Bool.true
      | _ => Bool.false
    }
  }
  def modeEq (a: Mode)(b: Mode): Bool := Bool.and(Pipeline.phaseEq(a.phase, b.phase),
    Bool.and(Bool.beq(a.reader0, b.reader0), Bool.beq(a.reader1, b.reader1)))
  def nextGeneration (op: Op)(g: Nat): Nat := {
    match op returning Nat with
    | Op.recycle => Nat.succ(g)
    | _ => g
  }
  def changed (op: Op)(r: Contracts.Runtime)(state: State): State := {
    match op returning State with
    | Op.store => State.mk(Pipeline.after(op), state.generation, state.payload, Nat.succ(r.index))
    | Op.read0 => State.mk(Pipeline.after(op), state.generation, Nat.mod(Nat.add(state.payload, state.value), Cuda.u32Limit), state.value)
    | Op.read1 => State.mk(Pipeline.after(op), state.generation, Nat.mod(Nat.add(state.payload, state.value), Cuda.u32Limit), state.value)
    | _ => State.mk(Pipeline.after(op), Pipeline.nextGeneration(op, state.generation), state.payload, state.value)
  }
  def step (op: Op)(r: Contracts.Runtime)(s: State): Contracts.Outcome(State) := {
    match Pipeline.modeEq(s.mode, Pipeline.before(op)) returning Contracts.Outcome(State) with
    | Bool.true => Contracts.Outcome.ok(Pipeline.changed(op, r, s))
    | Bool.false => Contracts.Outcome.fault(State)
  }
  def at (mode: Mode): State -> Prop := fun (s: State): Prop => Eq(Mode, s.mode, mode)
  def atGeneration (mode: Mode)(g: Nat): State -> Prop :=
    fun (s: State): Prop => And(Eq(Mode, s.mode, mode), Eq(Nat, s.generation, g))
  def invariant (g: Nat)(s: State): Prop := Pipeline.atGeneration(Pipeline.empty, g)(s)

  def index: Cuda.Expr := Cuda.Expr.bin(Cuda.BinOp.rem,
    Cuda.Expr.bin(Cuda.BinOp.add, Cuda.Expr.bin(Cuda.BinOp.mul, Cuda.Expr.bin(Cuda.BinOp.div, Cuda.Expr.special(Cuda.Builtin.threadX), Cuda.Expr.lit(8)), Cuda.Expr.lit(8)),
      Cuda.Expr.bin(Cuda.BinOp.rem, Cuda.Expr.special(Cuda.Builtin.threadX), Cuda.Expr.lit(8))), Cuda.Expr.lit(64))
  def load (id: Nat)(temporary: Nat): Cuda.Block :=
    Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.u32, temporary, Cuda.Expr.index(Cuda.Expr.var(id), Pipeline.index)),
      Cuda.Block.seq(Cuda.Stmt.decl(Cuda.DType.u32, Nat.succ(temporary), Cuda.Expr.var(Nat.add(id, 2))),
        Cuda.Block.seq(Cuda.Stmt.assign(Nat.add(id, 2), Cuda.Expr.bin(Cuda.BinOp.add, Cuda.Expr.var(Nat.succ(temporary)), Cuda.Expr.var(temporary))), Cuda.Block.done)))
  def block (id: Nat)(op: Op)(current: Option(Nat))(start: Nat): Cuda.Block := {
    match op returning Cuda.Block with
    | Op.store => Cuda.Block.seq(Cuda.Stmt.store(Cuda.Expr.var(id), Cuda.Expr.special(Cuda.Builtin.threadX),
        Cuda.Expr.bin(Cuda.BinOp.add, Emission.currentIndex(current), Cuda.Expr.lit(1))), Cuda.Block.done)
    | Op.publish => Cuda.Block.seq(Cuda.Stmt.sync, Cuda.Block.done)
    | Op.read0 => Pipeline.load(id, start)
    | Op.read1 => Pipeline.load(id, start)
    | Op.recycle => Cuda.Block.seq(Cuda.Stmt.sync, Cuda.Block.done)
    | _ => Cuda.Block.done
  }
  def emit (id: Nat)(op: Op)(current: Option(Nat))(start: Nat): Machine.Target := {
    match op returning Machine.Target with
    | Op.read0 => Machine.Target.mk(Pipeline.block(id, op, current, start), Nat.add(start, 2))
    | Op.read1 => Machine.Target.mk(Pipeline.block(id, op, current, start), Nat.add(start, 2))
    | _ => Machine.Target.mk(Pipeline.block(id, op, current, start), start)
  }
  def emitter (id: Nat): Op -> Option(Nat) -> Nat -> Machine.Target :=
    fun (op: Op)(current: Option(Nat))(start: Nat): Machine.Target => Pipeline.emit(id, op, current, start)
  def spec (id: Nat): Machine.Spec(State, Op) := Machine.Spec.mk(Pipeline.step, Pipeline.emitter(id))
  def primitiveSafe (op: Op): Contracts.Safe(Machine.operation(Pipeline.spec(0), op), Pipeline.at(Pipeline.before(op)), Pipeline.at(Pipeline.after(op))) :=
    fun (r: Contracts.Runtime)(s: State)(initial: Eq(Mode, s.mode, Pipeline.before(op))): Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) => {
      match s returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
      | State.mk mode generation payload value => {
        match op returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
        | Op.store => {
          match initial returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
          | Eq.refl same => Eq.refl(Pipeline.after(op))
        }
        | Op.publish => {
          match initial returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
          | Eq.refl same => Eq.refl(Pipeline.after(op))
        }
        | Op.open0 => {
          match initial returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
          | Eq.refl same => Eq.refl(Pipeline.after(op))
        }
        | Op.open1 => {
          match initial returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
          | Eq.refl same => Eq.refl(Pipeline.after(op))
        }
        | Op.read0 => {
          match initial returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
          | Eq.refl same => Eq.refl(Pipeline.after(op))
        }
        | Op.read1 => {
          match initial returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
          | Eq.refl same => Eq.refl(Pipeline.after(op))
        }
        | Op.close0 => {
          match initial returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
          | Eq.refl same => Eq.refl(Pipeline.after(op))
        }
        | Op.close1 => {
          match initial returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
          | Eq.refl same => Eq.refl(Pipeline.after(op))
        }
        | Op.recycle => {
          match initial returning Contracts.Post(Pipeline.at(Pipeline.after(op)), Pipeline.step(op, r, s)) with
          | Eq.refl same => Eq.refl(Pipeline.after(op))
        }
      }
    }
  def primitive (id: Nat)(op: Op): Machine.Cmd(State, Op, Pipeline.spec(id), Pipeline.at(Pipeline.before(op)), Pipeline.at(Pipeline.after(op))) :=
    Machine.primitive(Pipeline.spec(id), op, Pipeline.at(Pipeline.before(op)), Pipeline.at(Pipeline.after(op)), Pipeline.primitiveSafe(op))

  def preciseSafe (op: Op)(g: Nat): Contracts.Safe(Machine.operation(Pipeline.spec(0), op), Pipeline.atGeneration(Pipeline.before(op), g), Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g))) :=
    fun (r: Contracts.Runtime)(s: State)(initial: Pipeline.atGeneration(Pipeline.before(op), g)(s))
        : Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) => {
      match s returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
      | State.mk mode generation payload value => {
        match op returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
        | Op.store => {
          match initial.left returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
          | Eq.refl same => {
            match initial.right returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
            | Eq.refl same => And.intro(Eq.refl(Pipeline.after(op)), Eq.refl(Pipeline.nextGeneration(op, g)))
          }
        }
        | Op.publish => {
          match initial.left returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
          | Eq.refl same => {
            match initial.right returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
            | Eq.refl same => And.intro(Eq.refl(Pipeline.after(op)), Eq.refl(Pipeline.nextGeneration(op, g)))
          }
        }
        | Op.open0 => {
          match initial.left returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
          | Eq.refl same => {
            match initial.right returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
            | Eq.refl same => And.intro(Eq.refl(Pipeline.after(op)), Eq.refl(Pipeline.nextGeneration(op, g)))
          }
        }
        | Op.open1 => {
          match initial.left returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
          | Eq.refl same => {
            match initial.right returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
            | Eq.refl same => And.intro(Eq.refl(Pipeline.after(op)), Eq.refl(Pipeline.nextGeneration(op, g)))
          }
        }
        | Op.read0 => {
          match initial.left returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
          | Eq.refl same => {
            match initial.right returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
            | Eq.refl same => And.intro(Eq.refl(Pipeline.after(op)), Eq.refl(Pipeline.nextGeneration(op, g)))
          }
        }
        | Op.read1 => {
          match initial.left returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
          | Eq.refl same => {
            match initial.right returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
            | Eq.refl same => And.intro(Eq.refl(Pipeline.after(op)), Eq.refl(Pipeline.nextGeneration(op, g)))
          }
        }
        | Op.close0 => {
          match initial.left returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
          | Eq.refl same => {
            match initial.right returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
            | Eq.refl same => And.intro(Eq.refl(Pipeline.after(op)), Eq.refl(Pipeline.nextGeneration(op, g)))
          }
        }
        | Op.close1 => {
          match initial.left returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
          | Eq.refl same => {
            match initial.right returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
            | Eq.refl same => And.intro(Eq.refl(Pipeline.after(op)), Eq.refl(Pipeline.nextGeneration(op, g)))
          }
        }
        | Op.recycle => {
          match initial.left returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
          | Eq.refl same => {
            match initial.right returning Contracts.Post(Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.step(op, r, s)) with
            | Eq.refl same => And.intro(Eq.refl(Pipeline.after(op)), Eq.refl(Pipeline.nextGeneration(op, g)))
          }
        }
      }
    }
  def precise (id: Nat)(op: Op)(g: Nat): Machine.Cmd(State, Op, Pipeline.spec(id), Pipeline.atGeneration(Pipeline.before(op), g), Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g))) :=
    Machine.primitive(Pipeline.spec(id), op, Pipeline.atGeneration(Pipeline.before(op), g), Pipeline.atGeneration(Pipeline.after(op), Pipeline.nextGeneration(op, g)), Pipeline.preciseSafe(op, g))

  def cycle (id: Nat): Machine.Cmd(State, Op, Pipeline.spec(id), Pipeline.at(Pipeline.empty), Pipeline.at(Pipeline.empty)) := {
    let readers := Machine.sequence(Pipeline.primitive(id, Op.open0), Machine.sequence(Pipeline.primitive(id, Op.open1),
      Machine.sequence(Machine.sequence(Pipeline.primitive(id, Op.read0), Pipeline.primitive(id, Op.read1)),
        Machine.sequence(Pipeline.primitive(id, Op.close0), Pipeline.primitive(id, Op.close1)))))
    Machine.sequence(Pipeline.primitive(id, Op.store), Machine.sequence(Pipeline.primitive(id, Op.publish),
      Machine.sequence(readers, Pipeline.primitive(id, Op.recycle))))
  }

  def advances (id: Nat): Progress.Advances(Pipeline.cycle(id).run, Pipeline.invariant) :=
    fun (g: Nat): Contracts.Safe(Pipeline.cycle(id).run, Progress.stage(Pipeline.invariant, g), Progress.stage(Pipeline.invariant, Nat.succ(g))) =>
    fun (r: Contracts.Runtime)(s: State)(initial: Pipeline.invariant(g, s))
        : Contracts.Post(Progress.stage(Pipeline.invariant, Nat.succ(g)), Pipeline.cycle(id).run(r, s)) => {
      match s returning Contracts.Post(Progress.stage(Pipeline.invariant, Nat.succ(g)), Pipeline.cycle(id).run(r, s)) with
      | State.mk mode generation payload value => {
        match initial.left returning Contracts.Post(Progress.stage(Pipeline.invariant, Nat.succ(g)), Pipeline.cycle(id).run(r, s)) with
        | Eq.refl same => {
          match initial.right returning Contracts.Post(Progress.stage(Pipeline.invariant, Nat.succ(g)), Pipeline.cycle(id).run(r, s)) with
          | Eq.refl same => And.intro(Eq.refl(Pipeline.empty), Eq.refl(Nat.succ(g)))
        }
      }
    }

}
