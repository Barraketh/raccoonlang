import Protocol.Logic

// List support beyond the prelude's permutation laws, membership and `flatMap`: subsets, `Every`, `Pairwise`, a
// unary-plus-pair invariant with its framed-step lemma, duplicate-freedom, and the singleton and composite maps. Ported from Track A (lemur-raccoon
// experiments/protocols-clean).
//
// As in the prelude, everything is universe-polymorphic, and an element type is captured from the first argument that
// determines it, a list, a `Perm`, a `Mem` or an element (`List($A in Sort($u))`, `$A in Sort($u)`). Element types are
// copyable, since permutations, membership and equations of lists are over copyable data; a plain `List($A)` would
// capture an element type of any kind (docs/kernel.md, "Kinds"). An element type that first appears in a function
// argument, such as a predicate `f: A -> Prop`, is an explicit `(A: Sort($u))`. As across
// `lib/Protocol`, laws are named in snake case, like the prelude's `List.append_assoc`, and other definitions in camel
// case, like its `Option.getD`.
namespace List {
  // ---------------------------------------------------------------- Subset

  def Subset (xs: List($A in Sort($u)))(ys: List(A)): Prop := (a: A) -> Mem(A, a, xs) -> Mem(A, a, ys)

  // ---------------------------------------------------------------- Every and Pairwise

  // Named predicates, which statements could also write as lambdas (docs/kernel.md, "Lambdas in types").
  def andP (A: Sort($u))(f: A -> Prop)(g: A -> Prop): A -> Prop := fun (x: A): Prop => And(f(x), g(x))

  def trueP (A: Sort($u)): A -> Prop := fun (x: A): Prop => True

  // `R(x, ·)` and `R(·, y)`.
  def from (A: Sort($u))(R: A -> A -> Prop)(x: A): A -> Prop := fun (y: A): Prop => R(x, y)

  def into (A: Sort($u))(R: A -> A -> Prop)(y: A): A -> Prop := fun (x: A): Prop => R(x, y)

  def Every (xs: List($A in Sort($u)))(f: A -> Prop): Prop decreases structural(xs) := {
    match xs returning Prop with
    | List.nil => True
    | List.cons x rest => And(f(x), Every(rest, f))
  }

  def Pairwise (xs: List($A in Sort($u)))(R: A -> A -> Prop): Prop decreases structural(xs) := {
    match xs returning Prop with
    | List.nil => True
    | List.cons x rest => And(Every(rest, List.from(A, R, x)), Pairwise(rest, R))
  }

  // Every element of `xs` relates to `y`.
  def allInto (xs: List($A in Sort($u)))(R: A -> A -> Prop): A -> Prop := fun (y: A): Prop => Every(xs, List.into(A, R, y))

  namespace Every {
    def of_forall (A: Sort($u))(f: A -> Prop)(all: (x: A) -> f(x))(xs: List(A)): Every(xs, f) decreases structural(xs) := {
      match xs returning Every(xs, f) with
      | List.nil => True.intro
      | List.cons x rest => Logic.both(all(x), Every.of_forall(A, f, all, rest))
    }

    def map (A: Sort($u))(f: A -> Prop)(g: A -> Prop)(step: (x: A) -> f(x) -> g(x))(xs: List(A))(h: Every(xs, f)): Every(xs, g) decreases structural(xs) := {
      match xs returning Every(xs, g) with
      | List.nil => True.intro
      | List.cons x rest => Logic.both(step(x, h.left), Every.map(A, f, g, step, rest, h.right))
    }

    def zip (A: Sort($u))(f: A -> Prop)(g: A -> Prop)(xs: List(A))(hf: Every(xs, f))(hg: Every(xs, g)): Every(xs, List.andP(A, f, g)) decreases structural(xs) := {
      match xs returning Every(xs, List.andP(A, f, g)) with
      | List.nil => True.intro
      | List.cons x rest => Logic.both(Logic.both(hf.left, hg.left), Every.zip(A, f, g, rest, hf.right, hg.right))
    }

    def unzip_left (A: Sort($u))(f: A -> Prop)(g: A -> Prop)(xs: List(A))(h: Every(xs, List.andP(A, f, g))): Every(xs, f) :=
      Every.map(A, List.andP(A, f, g), f, fun (x: A)(p: And(f(x), g(x))): f(x) => p.left, xs, h)

    def unzip_right (A: Sort($u))(f: A -> Prop)(g: A -> Prop)(xs: List(A))(h: Every(xs, List.andP(A, f, g))): Every(xs, g) :=
      Every.map(A, List.andP(A, f, g), g, fun (x: A)(p: And(f(x), g(x))): g(x) => p.right, xs, h)

    def at (A: Sort($u))(f: A -> Prop)(xs: List(A))(h: Every(xs, f))(a: A)(m: Mem(A, a, xs)): f(a) decreases structural(m) := {
      match m returning f(a) with
      | .head y ys => h.left
      | .tail y z zs old => Every.at(A, f, zs, h.right, y, old)
    }

    def append (A: Sort($u))(f: A -> Prop)(xs: List(A))(ys: List(A))(hx: Every(xs, f))(hy: Every(ys, f)): Every(List.append(xs, ys), f) decreases structural(xs) := {
      match xs returning Every(List.append(xs, ys), f) with
      | List.nil => hy
      | List.cons x rest => Logic.both(hx.left, Every.append(A, f, rest, ys, hx.right, hy))
    }

    def split (A: Sort($u))(f: A -> Prop)(xs: List(A))(ys: List(A))(h: Every(List.append(xs, ys), f)): And(Every(xs, f), Every(ys, f)) decreases structural(xs) := {
      match xs returning And(Every(xs, f), Every(ys, f)) with
      | List.nil => Logic.both(True.intro, h)
      | List.cons x rest => {
        let tail := Every.split(A, f, rest, ys, h.right)
        Logic.both(Logic.both(h.left, tail.left), tail.right)
      }
    }

    def perm (A: Sort($u))(f: A -> Prop)(xs: List(A))(ys: List(A))(p: Perm(A, xs, ys))(h: Every(xs, f)): Every(ys, f) decreases structural(p) := {
      match p returning Every(ys, f) with
      | .nil => h
      | .cons x l1 l2 q => Logic.both(h.left, Every.perm(A, f, l1, l2, q, h.right))
      | .swap x y l => Logic.both(h.right.left, Logic.both(h.left, h.right.right))
      | .trans l1 l2 l3 q1 q2 => Every.perm(A, f, l2, l3, q2, Every.perm(A, f, l1, l2, q1, h))
    }
  }

  // `Cross(xs, ys, R)`: every element of `xs` relates to every element of `ys`,
  // indexed by the right-hand element, which is how frames are consumed.
  def Cross (xs: List($A in Sort($u)))(ys: List(A))(R: A -> A -> Prop): Prop := Every(ys, List.allInto(xs, R))

  namespace Pairwise {
    def split (A: Sort($u))(R: A -> A -> Prop)(xs: List(A))(ys: List(A))(h: Pairwise(List.append(xs, ys), R)):
        And(Pairwise(xs, R), And(Pairwise(ys, R), Cross(xs, ys, R))) decreases structural(xs) := {
      match xs returning And(Pairwise(xs, R), And(Pairwise(ys, R), Cross(xs, ys, R))) with
      | List.nil => Logic.both(True.intro, Logic.both(h, Every.of_forall(A, List.trueP(A), fun (y: A): True => True.intro, ys)))
      | List.cons x rest => {
        let head := Every.split(A, List.from(A, R, x), rest, ys, h.left)
        let tail := Pairwise.split(A, R, rest, ys, h.right)
        Logic.both(Logic.both(head.left, tail.left), Logic.both(tail.right.left,
          Every.zip(A, List.from(A, R, x), List.allInto(rest, R), ys, head.right, tail.right.right)))
      }
    }

    def append (A: Sort($u))(R: A -> A -> Prop)(xs: List(A))(ys: List(A))(hx: Pairwise(xs, R))(hy: Pairwise(ys, R))(c: Cross(xs, ys, R)):
        Pairwise(List.append(xs, ys), R) decreases structural(xs) := {
      match xs returning Pairwise(List.append(xs, ys), R) with
      | List.nil => hy
      | List.cons x rest => {
        let here := Every.unzip_left(A, List.from(A, R, x), List.allInto(rest, R), ys, c)
        let later := Every.unzip_right(A, List.from(A, R, x), List.allInto(rest, R), ys, c)
        Logic.both(Every.append(A, List.from(A, R, x), rest, ys, hx.left, here), Pairwise.append(A, R, rest, ys, hx.right, hy, later))
      }
    }

    def perm (A: Sort($u))(R: A -> A -> Prop)(sym: (x: A) -> (y: A) -> R(x, y) -> R(y, x))(xs: List(A))(ys: List(A))(p: Perm(A, xs, ys))(h: Pairwise(xs, R)):
        Pairwise(ys, R) decreases structural(p) := {
      match p returning Pairwise(ys, R) with
      | .nil => h
      | .cons x l1 l2 q => Logic.both(Every.perm(A, List.from(A, R, x), l1, l2, q, h.left), Pairwise.perm(A, R, sym, l1, l2, q, h.right))
      | .swap x y l => Logic.both(Logic.both(sym(y, x, h.left.left), h.right.left), Logic.both(h.left.right, h.right.right))
      | .trans l1 l2 l3 q1 q2 => Pairwise.perm(A, R, sym, l2, l3, q2, Pairwise.perm(A, R, sym, l1, l2, q1, h))
    }
  }

  // An invariant made of a unary part and a symmetric pair part.
  def Inv (xs: List($A in Sort($u)))(U: A -> Prop)(R: A -> A -> Prop): Prop := And(Every(xs, U), Pairwise(xs, R))

  namespace Inv {
    def perm (A: Sort($u))(U: A -> Prop)(R: A -> A -> Prop)(sym: (x: A) -> (y: A) -> R(x, y) -> R(y, x))
        (xs: List(A))(ys: List(A))(p: Perm(A, xs, ys))(h: Inv(xs, U, R)): Inv(ys, U, R) :=
      Logic.both(Every.perm(A, U, xs, ys, p, h.left), Pairwise.perm(A, R, sym, xs, ys, p, h.right))

    // A framed step: the outputs must satisfy the invariant among themselves
    // (`together`), and must stand in the pair relation to any frame element the
    // inputs stood in it to (`cross`). The rest of the frame is untouched.
    def framed (A: Sort($u))(U: A -> Prop)(R: A -> A -> Prop)(xs: List(A))(ys: List(A))(F: List(A))
        (ih: Inv(List.append(xs, F), U, R))
        (together: (Inv(xs, U, R) -> Inv(ys, U, R)))
        (cross: (Inv(xs, U, R) -> (y: A) -> Every(xs, List.into(A, R, y)) -> Every(ys, List.into(A, R, y)))):
        Inv(List.append(ys, F), U, R) := {
      let units := Every.split(A, U, xs, F, ih.left)
      let pairs := Pairwise.split(A, R, xs, F, ih.right)
      let before := Logic.both(units.left, pairs.left)
      let after := together(before)
      let frame := Every.map(A, List.allInto(xs, R), List.allInto(ys, R),
        fun (y: A)(e: Every(xs, List.into(A, R, y))): Every(ys, List.into(A, R, y)) => cross(before, y, e), F, pairs.right.right)
      Logic.both(Every.append(A, U, ys, F, after.left, units.right), Pairwise.append(A, R, ys, F, after.right, pairs.right.left, frame))
    }

    def left (A: Sort($u))(U: A -> Prop)(R: A -> A -> Prop)(xs: List(A))(ys: List(A))(h: Inv(List.append(xs, ys), U, R)): Inv(xs, U, R) :=
      Logic.both(Every.split(A, U, xs, ys, h.left).left, Pairwise.split(A, R, xs, ys, h.right).left)
  }

  // ---------------------------------------------------------------- Nodup

  def Ne (A: Sort($u)): A -> A -> Prop := fun (x: A)(y: A): Prop => Not(Eq(A, x, y))

  def Nodup (xs: List($A in Sort($u))): Prop := Pairwise(xs, List.Ne(A))

  namespace Nodup {
    def ne_symm (x: $A in Sort($u))(y: A)(h: Not(Eq(A, x, y))): Not(Eq(A, y, x)) :=
      fun (e: Eq(A, y, x)): False => h(Eq.symm(e))

    def perm (xs: List($A in Sort($u)))(ys: List(A))(p: Perm(A, xs, ys))(h: Nodup(xs)): Nodup(ys) :=
      Pairwise.perm(A, List.Ne(A), fun (x: A)(y: A)(n: Not(Eq(A, x, y))): Not(Eq(A, y, x)) => Nodup.ne_symm(x, y, n), xs, ys, p, h)

    // Disjointness of the two halves of a duplicate-free list.
    def disjoint (xs: List($A in Sort($u)))(ys: List(A))(h: Nodup(List.append(xs, ys)))(a: A)(left: Mem(A, a, xs))(right: Mem(A, a, ys)): False := {
      let cross := Pairwise.split(A, List.Ne(A), xs, ys, h).right.right
      Every.at(A, List.into(A, List.Ne(A), a), xs, Every.at(A, List.allInto(xs, List.Ne(A)), ys, cross, a, right), a, left)(Eq.refl(a))
    }
  }

  // ---------------------------------------------------------------- flatMap maps

  // The maps of the prelude's `flatMap` laws: the singleton and the composite, which morphisms name.
  def single (A: Sort($u)): A -> List(A) := fun (a: A): List(A) => List.cons(a, List.nil(A))

  def compose (A: Sort($u))(B: Sort($v))(C: Sort($w))(f: A -> List(B))(g: B -> List(C)): A -> List(C) :=
    fun (a: A): List(C) => flatMap(f(a), C, g)
}
