namespace Level {
  def succ (l: Level): Level := builtin

  def max (l1: Level)(l2: Level): Level := builtin
}

def id (x: $A in Sort($u)): A := x

def const (x: $A in Sort($u))(y: $B in Sort($v)): A := x

inductive Eq (A: Sort($u)) indices (x: A)(y: A) : Prop
 | refl (x: $A in Sort($u)) : Eq(A, x, x)

namespace Eq {
  def symm (p: Eq($A, $x, $y)): Eq(A, y, x) := {
    match p returning Eq(A, y, x) with
    | Eq.refl z => Eq.refl(z)
  }

  def trans (p: Eq($A, $x, $y))(q: Eq(A, y, $z)): Eq(A, x, z) := {
    match p returning Eq(A, x, z) with
    | Eq.refl w => q
  }

  // Transport along an equation, into a motive of any kind, such as a packet along an equation of its atom lists.
  def subst (p: Eq($A, $x, $y))(k: Kind)(v: Level)(motive: A -> Univ(k, v))(h: motive(x)): motive(y) := {
    match p returning motive(y) with
    | Eq.refl z => h
  }

  def substProp (p: Eq($A, $x, $y))(motive: A -> Prop)(h: motive(x)): motive(y) := {
    match p returning motive(y) with
    | Eq.refl z => h
  }

  def mp (p: Eq(Prop, $a, $b))(h: a): b := Eq.substProp(p, fun (x: Prop): Prop => x, h)

  def mpr (p: Eq(Prop, $a, $b))(h: b): a := Eq.mp(Eq.symm(p), h)
}

def congrArg (p: Eq($A, $x, $y))(B: Sort($v))(f: A -> B): Eq(B, f(x), f(y)) := {
  match p returning Eq(B, f(x), f(y)) with
  | Eq.refl z => Eq.refl(f(z))
}

def congrFun (A: Sort($u))(B: Sort($v))(f: A -> B)(g: A -> B)(p: Eq((x: A) -> B, f, g))(x: A): Eq(B, f(x), g(x)) := {
  match p returning Eq(B, f(x), g(x)) with
  | Eq.refl h => Eq.refl(h(x))
}

// Laws of the native arithmetic beyond the normal forms (docs/nat-normal-forms.md).
namespace Nat {
  // Distributivity is not definitional; every other semiring identity follows from this axiom and conversion, such as
  // right distributivity `Nat.mul_add(c, a, b)` and `a * (b + 1) = a * b + a`.
  axiom mul_add (a: Nat)(b: Nat)(c: Nat): Eq(Nat, Nat.mul(a, Nat.add(b, c)), Nat.add(Nat.mul(a, b), Nat.mul(a, c)))

  // The successor equation of power, `x^(a + 1) = x^a * x`, is definitional, so the exponent laws left out of the
  // normal forms are theorems by induction on the exponent.
  def mul_pow (x: Nat)(y: Nat)(a: Nat): Eq(Nat, Nat.pow(Nat.mul(x, y), a), Nat.mul(Nat.pow(x, a), Nat.pow(y, a))) decreases structural(a) := {
    match a returning Eq(Nat, Nat.pow(Nat.mul(x, y), a), Nat.mul(Nat.pow(x, a), Nat.pow(y, a))) with
    | Nat.zero => Eq.refl(1)
    | Nat.succ k => congrArg(Nat.mul_pow(x, y, k), Nat, fun (n: Nat): Nat => Nat.mul(n, Nat.mul(x, y)))
  }

  // The step rewrites `x^(a*k) * x^a = x^(a*k + a)` by the product law, then `a*k + a` to `a * (k + 1)` by `mul_add`.
  def pow_mul (x: Nat)(a: Nat)(b: Nat): Eq(Nat, Nat.pow(Nat.pow(x, a), b), Nat.pow(x, Nat.mul(a, b))) decreases structural(b) := {
    match b returning Eq(Nat, Nat.pow(Nat.pow(x, a), b), Nat.pow(x, Nat.mul(a, b))) with
    | Nat.zero => Eq.refl(1)
    | Nat.succ k =>
      Eq.trans(
        congrArg(Nat.pow_mul(x, a, k), Nat, fun (n: Nat): Nat => Nat.mul(n, Nat.pow(x, a))),
        Eq.symm(congrArg(Nat.mul_add(a, k, 1), Nat, fun (n: Nat): Nat => Nat.pow(x, n)))
      )
  }
}

inductive False : Prop

namespace False {
  def elim (h: False)(C: Sort($u)): C := {
    match h returning C with
  }

  // `elim` into a proposition, which no `Sort(u)` holds.
  def elimProp (h: False)(C: Prop): C := {
    match h returning C with
  }
}

inductive True : Prop
 | intro : True

def Not (a: Prop): Prop := (h: a) -> False

def falseElim (h: False)(C: Sort($u)): C := False.elim(h, C)

def notFalse : Not(False) := fun (h: False): False => h

def absurd (h: $a in Prop)(hn: Not(a))(C: Sort($u)): C := False.elim(hn(h), C)

inductive And (a: Prop)(b: Prop) : Prop
 | intro {a: Prop}{b: Prop} (left: a)(right: b) : And(a, b)

inductive Or (a: Prop)(b: Prop) : Prop
 | inl {b: Prop} (left: $a in Prop) : Or(a, b)
 | inr {a: Prop} (right: $b in Prop) : Or(a, b)

namespace Or {
  def elim (h: Or($a, $b))(C: Prop)(left: a -> C)(right: b -> C): C := {
    match h returning C with
    | Or.inl ha => left(ha)
    | Or.inr hb => right(hb)
  }
}

inductive Iff (a: Prop)(b: Prop) : Prop
 | intro {a: Prop}{b: Prop} (mp: a -> b)(mpr: b -> a) : Iff(a, b)

inductive Empty : Type

namespace Empty {
  def elim (h: Empty)(C: Sort($u)): C := {
    match h returning C with
  }
}

def emptyElim (h: Empty)(C: Sort($u)): C := Empty.elim(h, C)

inductive Unit : Type
 | unit : Unit

namespace Bool {
  def cond (c: Bool)(A: Sort($u))(t: A)(f: A): A := {
    match c returning A with
    | Bool.true => t
    | Bool.false => f
  }

  def not (b: Bool): Bool := {
    match b returning Bool with
    | Bool.true => Bool.false
    | Bool.false => Bool.true
  }

  def and (a: Bool)(b: Bool): Bool := {
    match a returning Bool with
    | Bool.true => b
    | Bool.false => Bool.false
  }

  def or (a: Bool)(b: Bool): Bool := {
    match a returning Bool with
    | Bool.true => Bool.true
    | Bool.false => b
  }

  def beq (a: Bool)(b: Bool): Bool := {
    match a returning Bool with
    | Bool.true => b
    | Bool.false => Bool.not(b)
  }

  def xor (a: Bool)(b: Bool): Bool := {
    match a returning Bool with
    | Bool.true => Bool.not(b)
    | Bool.false => b
  }
}

inductive Decidable (p: Prop) : Type
 | isFalse {p: Prop} (h: Not(p)) : Decidable(p)
 | isTrue (h: $p in Prop) : Decidable(p)

namespace Decidable {
  def toBool (d: Decidable($p)): Bool := {
    match d returning Bool with
    | Decidable.isFalse h => Bool.false
    | Decidable.isTrue h => Bool.true
  }

  def ite (d: Decidable($p))(A: Sort($u))(t: A)(f: A): A := {
    match d returning A with
    | Decidable.isFalse h => f
    | Decidable.isTrue h => t
  }

  def casesOn (d: Decidable($p))(A: Sort($u))(isFalse: (Not(p) -> A))(isTrue: p -> A): A := {
    match d returning A with
    | Decidable.isFalse h => isFalse(h)
    | Decidable.isTrue h => isTrue(h)
  }

  def not (d: Decidable($p)): Decidable(Not(p)) := {
    match d returning Decidable(Not(p)) with
    | Decidable.isFalse h => Decidable.isTrue(h)
    | Decidable.isTrue h => Decidable.isFalse(Not(p), fun (hn: Not(p)): False => hn(h))
  }
}

def decide [d: Decidable($p)]: Bool := Decidable.toBool(d)

def ite (d: Decidable($p))(A: Sort($u))(t: A)(f: A): A := Decidable.ite(d, A, t, f)

def instance trueDecidable : Decidable(True) := Decidable.isTrue(True.intro)

def instance falseDecidable : Decidable(False) := Decidable.isFalse(False, notFalse)

namespace Nat {
  def le (a: Nat)(b: Nat): Prop := Eq(Bool, Nat.ble(a, b), Bool.true)

  def lt (a: Nat)(b: Nat): Prop := Nat.le(Nat.succ(a), b)

  def max (a: Nat)(b: Nat): Nat := Bool.cond(Nat.ble(a, b), Nat, b, a)

  // Order laws. The native comparison cancels common terms, so `le(n, n)` and closed instances are definitional, and a
  // comparison that computes to `false` is refuted by an empty match; the general laws are short recursions.
  def lt_irrefl (n: Nat)(h: Nat.lt(n, n)): False := {
    match h returning False with
  }

  def lt_ne (a: Nat)(b: Nat)(h: Nat.lt(a, b)): Not(Eq(Nat, a, b)) :=
    fun (e: Eq(Nat, a, b)): False => Nat.lt_irrefl(b, Eq.substProp(e, fun (x: Nat): Prop => Nat.lt(x, b), h))

  def lt_zero (g: Nat)(h: Nat.lt(g, 0))(C: Prop): C := {
    match h returning C with
  }

  def le_succ (a: Nat)(b: Nat)(h: Nat.le(a, b)): Nat.le(a, Nat.succ(b)) decreases structural(a) := {
    match a returning Nat.le(a, Nat.succ(b)) with
    | Nat.zero => Eq.refl(Bool.true)
    | Nat.succ a0 => {
      match b returning Nat.le(Nat.succ(a0), Nat.succ(b)) with
      | Nat.zero => {
        match h returning Nat.le(Nat.succ(a0), 1) with
      }
      | Nat.succ b0 => Nat.le_succ(a0, b0, h)
    }
  }

  def le_trans (a: Nat)(b: Nat)(c: Nat)(h1: Nat.le(a, b))(h2: Nat.le(b, c)): Nat.le(a, c) decreases structural(a) := {
    match a returning Nat.le(a, c) with
    | Nat.zero => Eq.refl(Bool.true)
    | Nat.succ a0 => {
      match b returning Nat.le(Nat.succ(a0), c) with
      | Nat.zero => {
        match h1 returning Nat.le(Nat.succ(a0), c) with
      }
      | Nat.succ b0 => {
        match c returning Nat.le(Nat.succ(a0), c) with
        | Nat.zero => {
          match h2 returning Nat.le(Nat.succ(a0), 0) with
        }
        | Nat.succ c0 => Nat.le_trans(a0, b0, c0, h1, h2)
      }
    }
  }

  def lt_le (g: Nat)(n: Nat)(w: Nat)(lt: Nat.lt(g, n))(le: Nat.le(n, w)): Nat.lt(g, w) := Nat.le_trans(Nat.succ(g), n, w, lt, le)

  // Totality: `not (a <= b)` gives `b <= a`.
  def ble_flip (a: Nat)(b: Nat)(h: Eq(Bool, Nat.ble(a, b), Bool.false)): Nat.le(b, a) decreases structural(a) := {
    match a returning Nat.le(b, a) with
    | Nat.zero => {
      match h returning Nat.le(b, 0) with
    }
    | Nat.succ a0 => {
      match b returning Nat.le(b, Nat.succ(a0)) with
      | Nat.zero => Eq.refl(Bool.true)
      | Nat.succ b0 => Nat.ble_flip(a0, b0, h)
    }
  }

  // `max` by the comparison it makes, read off an equation for it.
  def le_max_left (a: Nat)(b: Nat): Nat.le(a, Nat.max(a, b)) :=
    (fun (c: Bool)(e: Eq(Bool, Nat.ble(a, b), c)): Nat.le(a, Bool.cond(c, Nat, b, a)) => match c returning Nat.le(a, Bool.cond(c, Nat, b, a)) with
      | Bool.true => e
      | Bool.false => Eq.refl(Bool.true)
    )(Nat.ble(a, b), Eq.refl(Nat.ble(a, b)))

  def le_max_right (a: Nat)(b: Nat): Nat.le(b, Nat.max(a, b)) :=
    (fun (c: Bool)(e: Eq(Bool, Nat.ble(a, b), c)): Nat.le(b, Bool.cond(c, Nat, b, a)) => match c returning Nat.le(b, Bool.cond(c, Nat, b, a)) with
      | Bool.true => Eq.refl(Bool.true)
      | Bool.false => Nat.ble_flip(a, b, e)
    )(Nat.ble(a, b), Eq.refl(Nat.ble(a, b)))
}

inductive Option (A: Univ($k, $u)) : Univ(k, u)
 | none {A: Univ($k, $u)} : Option(A)
 | some (val: $A in Univ($k, $u)) : Option(A)

namespace Option {
  def elim (x: Option($A))(B: Sort($v))(none: B)(some: A -> B): B := {
    match x returning B with
    | Option.none => none
    | Option.some val => some(val)
  }

  def getD (x: Option($A))(fallback: A): A := {
    match x returning A with
    | Option.none => fallback
    | Option.some val => val
  }

  def map (x: Option($A))(B: Sort($v))(f: A -> B): Option(B) := {
    match x returning Option(B) with
    | Option.none => Option.none(B)
    | Option.some val => Option.some(f(val))
  }

  def bind (x: Option($A))(B: Sort($v))(f: A -> Option(B)): Option(B) := {
    match x returning Option(B) with
    | Option.none => Option.none(B)
    | Option.some val => f(val)
  }

  def isSome (x: Option($A)): Bool := {
    match x returning Bool with
    | Option.none => Bool.false
    | Option.some val => Bool.true
  }

  def isNone (x: Option($A)): Bool := Bool.not(Option.isSome(x))
}

inductive Sum (A: Univ($k1, $u))(B: Univ($k2, $v)) : Univ(Kind.join(k1, k2), Level.max(u, v))
 | inl {B: Univ($k2, $v)} (val: $A in Univ($k1, $u)) : Sum(A, B)
 | inr {A: Univ($k1, $u)} (val: $B in Univ($k2, $v)) : Sum(A, B)

namespace Sum {
  def elim (x: Sum($A, $B))(C: Sort($w))(left: A -> C)(right: B -> C): C := {
    match x returning C with
    | Sum.inl val => left(val)
    | Sum.inr val => right(val)
  }
}

namespace List {
  // The native append computes `[] ++ ys = ys`, `cons(a, xs) ++ ys = cons(a, xs ++ ys)` and `xs ++ [] = xs`, but leaves
  // `x ++ ys` stuck for a stuck `x`, so associativity is not definitional; it is a theorem by induction on the first list.
  def append_assoc (a: List($A in Sort($u)))(b: List(A))(c: List(A)): Eq(List(A), List.append(List.append(a, b), c), List.append(a, List.append(b, c))) decreases structural(a) := {
    match a returning Eq(List(A), List.append(List.append(a, b), c), List.append(a, List.append(b, c))) with
    | List.nil => Eq.refl(List.append(b, c))
    | List.cons head tail => congrArg(List.append_assoc(tail, b, c), List(A), fun (l: List(A)): List(A) => List.cons(head, l))
  }

  def foldr (xs: List($A))(B: Sort($v))(nil: B)(cons: A -> B -> B): B decreases structural(xs) := {
    match xs returning B with
    | List.nil => nil
    | List.cons head tail => cons(head, List.foldr(tail, B, nil, cons))
  }

  def foldl (xs: List($A))(B: Sort($v))(init: B)(f: B -> A -> B): B decreases structural(xs) := {
    match xs returning B with
    | List.nil => init
    | List.cons head tail => List.foldl(tail, B, f(init, head), f)
  }

  def map (xs: List($A))(B: Sort($v))(f: A -> B): List(B) decreases structural(xs) := {
    match xs returning List(B) with
    | List.nil => List.nil(B)
    | List.cons head tail => List.cons(f(head), List.map(tail, B, f))
  }

  def reverse (xs: List($A)): List(A) decreases structural(xs) := {
    match xs returning List(A) with
    | List.nil => List.nil(A)
    | List.cons head tail => List.append(List.reverse(tail), List.cons(head, List.nil(A)))
  }

  def any (xs: List($A))(p: A -> Bool): Bool decreases structural(xs) := {
    match xs returning Bool with
    | List.nil => Bool.false
    | List.cons head tail => Bool.or(p(head), List.any(tail, p))
  }

  def all (xs: List($A))(p: A -> Bool): Bool decreases structural(xs) := {
    match xs returning Bool with
    | List.nil => Bool.true
    | List.cons head tail => Bool.and(p(head), List.all(tail, p))
  }

  // `filter` copies each kept element into the result after testing it, so its elements are copyable.
  def filter (xs: List($A in Sort($u)))(p: A -> Bool): List(A) decreases structural(xs) := {
    match xs returning List(A) with
    | List.nil => List.nil(A)
    | List.cons head tail => {
      let rest := List.filter(tail, p)
      Bool.cond(p(head), List(A), List.cons(head, rest), rest)
    }
  }
}

// Permutations, membership and `flatMap`. As above, everything is universe-polymorphic, and an element type is captured
// from the first argument that determines it, a list, a `Perm`, a `Mem` or an element (`List($A in Sort($u))`,
// `$A in Sort($u)`). Element types are copyable, since permutations, membership and equations of lists are over copyable
// data; an element type that first appears in a function argument is an explicit `(A: Sort($u))`.
namespace List {
  // Laws of the kernel's `List.Perm`.
  namespace Perm {
    def refl (xs: List($A in Sort($u))): Perm(A, xs, xs) decreases structural(xs) := {
      match xs returning Perm(A, xs, xs) with
      | List.nil => Perm.nil(A)
      | List.cons x rest => Perm.cons(A, x, rest, rest, Perm.refl(rest))
    }

    def of_eq (xs: List($A in Sort($u)))(ys: List(A))(e: Eq(List(A), xs, ys)): Perm(A, xs, ys) :=
      Eq.substProp(e, fun (zs: List(A)): Prop => Perm(A, xs, zs), Perm.refl(xs))

    def symm (xs: List($A in Sort($u)))(ys: List(A))(p: Perm(A, xs, ys)): Perm(A, ys, xs) decreases structural(p) := {
      match p returning Perm(A, ys, xs) with
      | .nil => Perm.nil(A)
      | .cons x l1 l2 q => Perm.cons(A, x, l2, l1, Perm.symm(l1, l2, q))
      | .swap x y l => Perm.swap(A, y, x, l)
      | .trans l1 l2 l3 q1 q2 => Perm.trans(A, l3, l2, l1, Perm.symm(l2, l3, q2), Perm.symm(l1, l2, q1))
    }

    def append_right (xs: List($A in Sort($u)))(ys: List(A))(F: List(A))(p: Perm(A, xs, ys)):
        Perm(A, List.append(xs, F), List.append(ys, F)) decreases structural(p) := {
      match p returning Perm(A, List.append(xs, F), List.append(ys, F)) with
      | .nil => Perm.refl(F)
      | .cons x l1 l2 q => Perm.cons(A, x, List.append(l1, F), List.append(l2, F), Perm.append_right(l1, l2, F, q))
      | .swap x y l => Perm.swap(A, x, y, List.append(l, F))
      | .trans l1 l2 l3 q1 q2 => Perm.trans(A, List.append(l1, F), List.append(l2, F), List.append(l3, F),
          Perm.append_right(l1, l2, F, q1), Perm.append_right(l2, l3, F, q2))
    }

    def append_left (F: List($A in Sort($u)))(xs: List(A))(ys: List(A))(p: Perm(A, xs, ys)):
        Perm(A, List.append(F, xs), List.append(F, ys)) decreases structural(F) := {
      match F returning Perm(A, List.append(F, xs), List.append(F, ys)) with
      | List.nil => p
      | List.cons f rest => Perm.cons(A, f, List.append(rest, xs), List.append(rest, ys), Perm.append_left(rest, xs, ys, p))
    }

    // `a :: (xs ++ ys) ~ xs ++ (a :: ys)`.
    def middle (a: $A in Sort($u))(xs: List(A))(ys: List(A)):
        Perm(A, List.cons(a, List.append(xs, ys)), List.append(xs, List.cons(a, ys))) decreases structural(xs) := {
      match xs returning Perm(A, List.cons(a, List.append(xs, ys)), List.append(xs, List.cons(a, ys))) with
      | List.nil => Perm.refl(List.cons(a, ys))
      | List.cons x rest => Perm.trans(A, List.cons(a, List.cons(x, List.append(rest, ys))), List.cons(x, List.cons(a, List.append(rest, ys))),
          List.cons(x, List.append(rest, List.cons(a, ys))),
          Perm.swap(A, x, a, List.append(rest, ys)), Perm.cons(A, x, List.cons(a, List.append(rest, ys)), List.append(rest, List.cons(a, ys)), Perm.middle(a, rest, ys)))
    }

    def append_comm (xs: List($A in Sort($u)))(ys: List(A)): Perm(A, List.append(xs, ys), List.append(ys, xs)) decreases structural(xs) := {
      match xs returning Perm(A, List.append(xs, ys), List.append(ys, xs)) with
      | List.nil => Perm.refl(ys)
      | List.cons x rest => Perm.trans(A, List.cons(x, List.append(rest, ys)), List.cons(x, List.append(ys, rest)), List.append(ys, List.cons(x, rest)),
          Perm.cons(A, x, List.append(rest, ys), List.append(ys, rest), Perm.append_comm(rest, ys)), Perm.middle(x, ys, rest))
    }

    // `ys ++ (xs ++ F) ~ xs ++ (ys ++ F)`.
    def swap_front (xs: List($A in Sort($u)))(ys: List(A))(F: List(A)):
        Perm(A, List.append(ys, List.append(xs, F)), List.append(xs, List.append(ys, F))) := {
      let left := List.append_assoc(ys, xs, F)
      let right := List.append_assoc(xs, ys, F)
      let mid := Perm.append_right(List.append(ys, xs), List.append(xs, ys), F, Perm.append_comm(ys, xs))
      Eq.substProp(right, fun (zs: List(A)): Prop => Perm(A, List.append(ys, List.append(xs, F)), zs),
        Eq.substProp(left, fun (zs: List(A)): Prop => Perm(A, zs, List.append(List.append(xs, ys), F)), mid))
    }
  }

  // `Mem(A, a, xs)`: `a` is an element of `xs`.
  inductive Mem (A: Sort($u)) indices (a: A)(xs: List(A)) : Prop
   | head (a: $A in Sort($u))(xs: List(A)) : Mem(A, a, List.cons(a, xs))
   | tail (a: $A in Sort($u))(x: A)(xs: List(A))(m: Mem(A, a, xs)) : Mem(A, a, List.cons(x, xs))

  namespace Mem {
    def nil_absurd (a: $A in Sort($u))(m: Mem(A, a, List.nil(A)))(C: Prop): C := {
      match m returning C with
    }

    // One position of a cons cell: the head, or a member of the tail.
    def cons_cases (a: $A in Sort($u))(x: A)(xs: List(A))(m: Mem(A, a, List.cons(x, xs))): Or(Eq(A, a, x), Mem(A, a, xs)) := {
      match m returning Or(Eq(A, a, x), Mem(A, a, xs)) with
      | .head y ys => Or.inl(Mem(A, y, ys), Eq.refl(y))
      | .tail y z zs old => Or.inr(Eq(A, y, z), old)
    }

    def append_left (a: $A in Sort($u))(xs: List(A))(ys: List(A))(m: Mem(A, a, xs)): Mem(A, a, List.append(xs, ys)) decreases structural(m) := {
      match m returning Mem(A, a, List.append(xs, ys)) with
      | .head y zs => Mem.head(y, List.append(zs, ys))
      | .tail y z zs old => Mem.tail(y, z, List.append(zs, ys), Mem.append_left(y, zs, ys, old))
    }

    def append_right (a: $A in Sort($u))(xs: List(A))(ys: List(A))(m: Mem(A, a, ys)): Mem(A, a, List.append(xs, ys)) decreases structural(xs) := {
      match xs returning Mem(A, a, List.append(xs, ys)) with
      | List.nil => m
      | List.cons x rest => Mem.tail(a, x, List.append(rest, ys), Mem.append_right(a, rest, ys, m))
    }

    def perm (a: $A in Sort($u))(xs: List(A))(ys: List(A))(p: Perm(A, xs, ys))(m: Mem(A, a, xs)): Mem(A, a, ys) decreases structural(p) := {
      match p returning Mem(A, a, ys) with
      | .nil => m
      | .cons x l1 l2 q => {
        match Mem.cons_cases(a, x, l1, m) returning Mem(A, a, List.cons(x, l2)) with
        | Or.inl e => Eq.substProp(Eq.symm(e), fun (z: A): Prop => Mem(A, z, List.cons(x, l2)), Mem.head(x, l2))
        | Or.inr old => Mem.tail(a, x, l2, Mem.perm(a, l1, l2, q, old))
      }
      | .swap x y l => {
        match Mem.cons_cases(a, y, List.cons(x, l), m) returning Mem(A, a, List.cons(x, List.cons(y, l))) with
        | Or.inl e => Eq.substProp(Eq.symm(e), fun (z: A): Prop => Mem(A, z, List.cons(x, List.cons(y, l))), Mem.tail(y, x, List.cons(y, l), Mem.head(y, l)))
        | Or.inr rest => {
          match Mem.cons_cases(a, x, l, rest) returning Mem(A, a, List.cons(x, List.cons(y, l))) with
          | Or.inl e => Eq.substProp(Eq.symm(e), fun (z: A): Prop => Mem(A, z, List.cons(x, List.cons(y, l))), Mem.head(x, List.cons(y, l)))
          | Or.inr old => Mem.tail(a, x, List.cons(y, l), Mem.tail(a, y, l, old))
        }
      }
      | .trans l1 l2 l3 q1 q2 => Mem.perm(a, l2, l3, q2, Mem.perm(a, l1, l2, q1, m))
    }
  }

  // `flatMap(xs, B, f)`: `f` of each element, concatenated.
  def flatMap (xs: List($A in Sort($u)))(B: Sort($v))(f: A -> List(B)): List(B) decreases structural(xs) := {
    match xs returning List(B) with
    | List.nil => List.nil(B)
    | List.cons x rest => List.append(f(x), flatMap(rest, B, f))
  }

  namespace flatMap {
    def append (A: Sort($u))(B: Sort($v))(f: A -> List(B))(xs: List(A))(ys: List(A)):
        Eq(List(B), flatMap(List.append(xs, ys), B, f), List.append(flatMap(xs, B, f), flatMap(ys, B, f))) decreases structural(xs) := {
      match xs returning Eq(List(B), flatMap(List.append(xs, ys), B, f), List.append(flatMap(xs, B, f), flatMap(ys, B, f))) with
      | List.nil => Eq.refl(flatMap(ys, B, f))
      | List.cons x rest => Eq.trans(congrArg(flatMap.append(A, B, f, rest, ys), List(B), fun (zs: List(B)): List(B) => List.append(f(x), zs)),
          Eq.symm(List.append_assoc(f(x), flatMap(rest, B, f), flatMap(ys, B, f))))
    }

    def perm (A: Sort($u))(B: Sort($v))(f: A -> List(B))(xs: List(A))(ys: List(A))(p: Perm(A, xs, ys)):
        Perm(B, flatMap(xs, B, f), flatMap(ys, B, f)) decreases structural(p) := {
      match p returning Perm(B, flatMap(xs, B, f), flatMap(ys, B, f)) with
      | .nil => Perm.nil(B)
      | .cons x l1 l2 q => Perm.append_left(f(x), flatMap(l1, B, f), flatMap(l2, B, f), flatMap.perm(A, B, f, l1, l2, q))
      | .swap x y l => Perm.swap_front(f(x), f(y), flatMap(l, B, f))
      | .trans l1 l2 l3 q1 q2 => Perm.trans(B, flatMap(l1, B, f), flatMap(l2, B, f), flatMap(l3, B, f), flatMap.perm(A, B, f, l1, l2, q1), flatMap.perm(A, B, f, l2, l3, q2))
    }

    def assoc (A: Sort($u))(B: Sort($v))(C: Sort($w))(f: A -> List(B))(g: B -> List(C))(xs: List(A)):
        Eq(List(C), flatMap(flatMap(xs, B, f), C, g), flatMap(xs, C, fun (a: A): List(C) => flatMap(f(a), C, g))) decreases structural(xs) := {
      match xs returning Eq(List(C), flatMap(flatMap(xs, B, f), C, g), flatMap(xs, C, fun (a: A): List(C) => flatMap(f(a), C, g))) with
      | List.nil => Eq.refl(List.nil(C))
      | List.cons x rest => Eq.trans(flatMap.append(B, C, g, f(x), flatMap(rest, B, f)),
          congrArg(flatMap.assoc(A, B, C, f, g, rest), List(C), fun (zs: List(C)): List(C) => List.append(flatMap(f(x), C, g), zs)))
    }

    def singleton (xs: List($A in Sort($u))): Eq(List(A), flatMap(xs, A, fun (a: A): List(A) => List.cons(a, List.nil(A))), xs) decreases structural(xs) := {
      match xs returning Eq(List(A), flatMap(xs, A, fun (a: A): List(A) => List.cons(a, List.nil(A))), xs) with
      | List.nil => Eq.refl(List.nil(A))
      | List.cons x rest => congrArg(flatMap.singleton(rest), List(A), fun (zs: List(A)): List(A) => List.cons(x, zs))
    }

    def mem (A: Sort($u))(B: Sort($v))(f: A -> List(B))(xs: List(A))(a: A)(b: B)(inside: Mem(A, a, xs))(here: Mem(B, b, f(a))):
        Mem(B, b, flatMap(xs, B, f)) decreases structural(inside) := {
      match inside returning Mem(B, b, flatMap(xs, B, f)) with
      | .head y ys => Mem.append_left(b, f(y), flatMap(ys, B, f), here)
      | .tail y z zs old => Mem.append_right(b, f(z), flatMap(zs, B, f), flatMap.mem(A, B, f, zs, y, b, old, here))
    }
  }
}

// A kernel String is `String.mk` of its characters; each operation is one call of a List native, not one per character.
namespace String {
  def append (a: String)(b: String): String := String.mk(List.append(a.data, b.data))

  def length (s: String): Nat := List.length(s.data)
}

// A pair of any kinds: linear when either component is (docs/kernel.md, "Kinds"). Its selectors consume a linear pair
// and drop the other component.
inductive Prod (A: Univ($k1, $u))(B: Univ($k2, $v)) : Univ(Kind.join(k1, k2), Level.max(u, v))
 | mk {A: Univ($k1, $u)}{B: Univ($k2, $v)} (fst: A)(snd: B) : Prod(A, B)

// A proof as data, so a fact can travel in a `Prod` with the tokens it is about.
inductive Fact (p: Prop) : Type
 | mk (proof: $p in Prop) : Fact(p)

// The first component may be of any kind; the second is copyable, since its family `B` is into `Sort(v)`.
inductive Sigma (A: Univ($k, $u))(v: Level)(B: A -> Sort(v)) : Univ(k, Level.max(u, v))
 | mk {A: Univ($k, $u)}{v: Level}{B: A -> Sort(v)} (fst: A)(snd: B(fst)) : Sigma(A, v, B)

inductive Subtype (A: Univ($k, $u))(p: A -> Prop) : Univ(k, u)
 | mk {A: Univ($k, $u)}{p: A -> Prop} (val: A)(property: p(val)) : Subtype(A, p)

inductive Exists (A: Sort($u))(p: A -> Prop) : Prop
 | intro {A: Sort($u)}{p: A -> Prop} (witness: A)(proof: p(witness)) : Exists(A, p)

inductive Nonempty (A: Sort($u)) : Prop
 | intro (val: $A in Sort($u)) : Nonempty(A)

inductive Inhabited (A: Sort($u)) : Sort(u)
 | mk {A: Sort($u)} (default: A) : Inhabited(A)

def instance unitInhabited : Inhabited(Unit) := Inhabited.mk(Unit, Unit.unit)

def instance boolInhabited : Inhabited(Bool) := Inhabited.mk(Bool, Bool.false)

def instance natInhabited : Inhabited(Nat) := Inhabited.mk(Nat, 0)

inductive BEq (A: Sort($u)) : Sort(Level.max(Level.one, u))
 | mk {A: Sort($u)} (beq: A -> A -> Bool) : BEq(A)

def beq [self: BEq($A)](a: A)(b: A): Bool := BEq.beq(self)(a, b)

def instance unitBEq : BEq(Unit) := BEq.mk(Unit, fun (a: Unit)(b: Unit): Bool => Bool.true)

def instance boolBEq : BEq(Bool) := BEq.mk(Bool, Bool.beq)

def instance natBEq : BEq(Nat) := BEq.mk(Nat, Nat.beq)

namespace Option {
  def beq [beqA: BEq($A)](x: Option(A))(y: Option(A)): Bool := {
    match x returning Bool with
    | Option.none => Option.isNone(y)
    | Option.some xVal => {
      match y returning Bool with
      | Option.none => Bool.false
      | Option.some yVal => BEq.beq(beqA)(xVal, yVal)
    }
  }
}

def instance optionBEq [beqA: BEq($A)]: BEq(Option(A)) :=
  BEq.mk(
    Option(A),
    fun (x: Option(A))(y: Option(A)): Bool =>
      Option.beq(beqA, x, y)
  )

namespace List {
  def beq [beqA: BEq($A)](xs: List(A))(ys: List(A)): Bool decreases structural(xs) := {
    match xs returning Bool with
    | List.nil => {
      match ys returning Bool with
      | List.nil => Bool.true
      | List.cons head tail => Bool.false
    }
    | List.cons x xsTail => {
      match ys returning Bool with
      | List.nil => Bool.false
      | List.cons y ysTail => Bool.and(BEq.beq(beqA)(x, y), List.beq(beqA, xsTail, ysTail))
    }
  }
}

def instance listBEq [beqA: BEq($A)]: BEq(List(A)) :=
  BEq.mk(
    List(A),
    fun (xs: List(A))(ys: List(A)): Bool =>
      List.beq(beqA, xs, ys)
  )

namespace Prod {
  def beq [beqA: BEq($A)][beqB: BEq($B)](x: Prod(A, B))(y: Prod(A, B)): Bool :=
    Bool.and(
      BEq.beq(beqA)(Prod.fst(x), Prod.fst(y)),
      BEq.beq(beqB)(Prod.snd(x), Prod.snd(y))
    )
}

def instance prodBEq [beqA: BEq($A)][beqB: BEq($B)]: BEq(Prod(A, B)) :=
  BEq.mk(
    Prod(A, B),
    fun (x: Prod(A, B))(y: Prod(A, B)): Bool =>
      Prod.beq(beqA, beqB, x, y)
  )

inductive DecidableEq (A: Sort($u)) : Sort(Level.max(Level.one, u))
 | mk {A: Sort($u)} (decEq: (a: A) -> (b: A) -> Decidable(Eq(A, a, b))) : DecidableEq(A)

namespace DecidableEq {
  def toBEq [self: DecidableEq($A)]: BEq(A) := BEq.mk(A, fun (a: A)(b: A): Bool => Decidable.toBool(DecidableEq.decEq(self)(a, b)))
}

def decEq [self: DecidableEq($A)](a: A)(b: A): Decidable(Eq(A, a, b)) := DecidableEq.decEq(self)(a, b)

namespace Unit {
  def decEq (a: Unit)(b: Unit): Decidable(Eq(Unit, a, b)) := {
    match a returning Decidable(Eq(Unit, a, b)) with
    | Unit.unit => {
      match b returning Decidable(Eq(Unit, Unit.unit, b)) with
      | Unit.unit => Decidable.isTrue(Eq.refl(Unit.unit))
    }
  }
}

def instance unitDecidableEq : DecidableEq(Unit) := DecidableEq.mk(Unit, Unit.decEq)

namespace Bool {
  def falseNeTrue (h: Eq(Bool, Bool.false, Bool.true)): False := {
    match h returning False with
  }

  def trueNeFalse (h: Eq(Bool, Bool.true, Bool.false)): False := {
    match h returning False with
  }

  def decEq (a: Bool)(b: Bool): Decidable(Eq(Bool, a, b)) := {
    match a returning Decidable(Eq(Bool, a, b)) with
    | Bool.false => {
      match b returning Decidable(Eq(Bool, Bool.false, b)) with
      | Bool.false => Decidable.isTrue(Eq.refl(Bool.false))
      | Bool.true => Decidable.isFalse(Eq(Bool, Bool.false, Bool.true), Bool.falseNeTrue)
    }
    | Bool.true => {
      match b returning Decidable(Eq(Bool, Bool.true, b)) with
      | Bool.false => Decidable.isFalse(Eq(Bool, Bool.true, Bool.false), Bool.trueNeFalse)
      | Bool.true => Decidable.isTrue(Eq.refl(Bool.true))
    }
  }
}

def instance boolDecidableEq : DecidableEq(Bool) := DecidableEq.mk(Bool, Bool.decEq)

namespace Nat {
  def zeroNeSucc (n: Nat)(h: Eq(Nat, Nat.zero, Nat.succ(n))): False := {
    match h returning False with
  }

  def succNeZero (n: Nat)(h: Eq(Nat, Nat.succ(n), Nat.zero)): False := {
    match h returning False with
  }

  def succInj (h: Eq(Nat, Nat.succ($a), Nat.succ($b))): Eq(Nat, a, b) := {
    match h returning Eq(Nat, Nat.pred(Nat.succ(a)), Nat.pred(Nat.succ(b))) with
    | Eq.refl z => Eq.refl(Nat.pred(z))
  }

  def decEq (a: Nat)(b: Nat): Decidable(Eq(Nat, a, b)) decreases structural(a) := {
    match a returning Decidable(Eq(Nat, a, b)) with
    | Nat.zero => {
      match b returning Decidable(Eq(Nat, Nat.zero, b)) with
      | Nat.zero => Decidable.isTrue(Eq.refl(Nat.zero))
      | Nat.succ bTail => Decidable.isFalse(Eq(Nat, Nat.zero, Nat.succ(bTail)), fun (h: Eq(Nat, Nat.zero, Nat.succ(bTail))): False => Nat.zeroNeSucc(bTail, h))
    }
    | Nat.succ aTail => {
      match b returning Decidable(Eq(Nat, Nat.succ(aTail), b)) with
      | Nat.zero => Decidable.isFalse(Eq(Nat, Nat.succ(aTail), Nat.zero), fun (h: Eq(Nat, Nat.succ(aTail), Nat.zero)): False => Nat.succNeZero(aTail, h))
      | Nat.succ bTail => {
        match Nat.decEq(aTail, bTail) returning Decidable(Eq(Nat, Nat.succ(aTail), Nat.succ(bTail))) with
        | Decidable.isTrue h => Decidable.isTrue(congrArg(h, Nat, Nat.succ))
        | Decidable.isFalse h => Decidable.isFalse(Eq(Nat, Nat.succ(aTail), Nat.succ(bTail)), fun (p: Eq(Nat, Nat.succ(aTail), Nat.succ(bTail))): False => h(Nat.succInj(p)))
      }
    }
  }
}

def instance natDecidableEq : DecidableEq(Nat) := DecidableEq.mk(Nat, Nat.decEq)

inductive LE (A: Sort($u)) : Sort(Level.max(Level.one, u))
 | mk {A: Sort($u)} (le: A -> A -> Prop) : LE(A)

def le [self: LE($A)](a: A)(b: A): Prop := LE.le(self)(a, b)

inductive LT (A: Sort($u)) : Sort(Level.max(Level.one, u))
 | mk {A: Sort($u)} (lt: A -> A -> Prop) : LT(A)

def lt [self: LT($A)](a: A)(b: A): Prop := LT.lt(self)(a, b)

def instance natLE : LE(Nat) := LE.mk(Nat, Nat.le)

def instance natLT : LT(Nat) := LT.mk(Nat, Nat.lt)

inductive Subsingleton (A: Sort($u)) : Prop
 | intro {A: Sort($u)} (elim: (a: A) -> (b: A) -> Eq(A, a, b)) : Subsingleton(A)
