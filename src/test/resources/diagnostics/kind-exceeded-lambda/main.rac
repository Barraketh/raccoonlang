inductive Tok (l: Lifetime) : Type { kind = lin, scope = l }
 | mk : Tok(l)

def eat {l: Lifetime}(t: Tok(l)): Nat := match t returning Nat with
 | Tok.mk => 0

def delay (l: Lifetime)(t: Tok(l)): { kind = lin, scope = l } Unit -> Nat :=
  fun { kind = unr, scope = l } (u: Unit): Nat => eat(t)

{ Nat.zero }
