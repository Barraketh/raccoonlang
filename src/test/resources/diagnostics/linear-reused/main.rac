inductive Tok (l: Lifetime) : Type { kind = lin, scope = l }
 | mk : Tok(l)

def eat {l: Lifetime}(t: Tok(l)): Nat := match t returning Nat with
 | Tok.mk => 0

def twice {l: Lifetime}(t: Tok(l)): Nat := {
  let delayed := fun (u: Unit): Nat => eat(t)
  Nat.add(delayed(Unit.unit), delayed(Unit.unit))
}

{ Nat.zero }
